{
  "name": "libdatahike-cljs",
  "version": "0.0.1",
  "description": "Pod-side CLJS + datahike spike — Phase CLJS chunks of spec-01-agent-runtime",
  "private": true,
  "scripts": {
    "spike": "shadow-cljs compile spike && node out/spike.js",
    "spike-fs": "shadow-cljs compile spike-fs && node out/spike-fs.js",
    "spike-idb": "shadow-cljs compile spike-idb && node out/spike-idb.js",
