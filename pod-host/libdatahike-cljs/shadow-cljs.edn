;; shadow-cljs build config for pod-side CLJS spike (Phase CLJS chunks).
;; One build target per "what we're testing":
;;   :spike — :memory smoke test (CLJS-1)
;;   :spike-fs — konserve.node-filestore persistence (CLJS-2a)
;;   :spike-idb — konserve.indexeddb + fake-indexeddb polyfill (CLJS-2b)
;;   :bench — head-to-head benchmark across :memory + :file + :indexeddb (CLJS-2.5)
{:deps {:aliases [:cljs]}

 :builds
 {:spike
  {:target :node-script
   :output-to "out/spike.js"
   :main seon.podhost.libdatahike.cljs-spike/main
   :compiler-options {:warnings-as-errors false
                      :warnings {:fn-deprecated false
                                 :protocol-multiple-impls false}}}

  :spike-fs
  {:target :node-script
   :output-to "out/spike-fs.js"
   :main seon.podhost.libdatahike.cljs-spike-fs/main
   :compiler-options {:warnings-as-errors false
                      :warnings {:fn-deprecated false
                                 :protocol-multiple-impls false}}}

  :spike-idb
  {:target :node-script
   :output-to "out/spike-idb.js"
   :main seon.podhost.libdatahike.cljs-spike-idb/main
   ;; fake-indexeddb global polyfill must run before any IDB code touches globalThis.indexedDB
   :prepend-js "require('fake-indexeddb/auto');"
   :compiler-options {:warnings-as-errors false
                      :warnings {:fn-deprecated false
                                 :protocol-multiple-impls false}}}

  :bench
  {:target :node-script
   :output-to "out/bench.js"
   :main seon.podhost.libdatahike.bench/main
   :prepend-js "require('fake-indexeddb/auto');"
   :compiler-options {:warnings-as-errors false
                      :warnings {:fn-deprecated false
                                 :protocol-multiple-impls false}}}}}
