{:paths ["src"]

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 ;; Pin konserve newer than konserve-jdbc requests; datahike 0.8.1671 needs 0.9.x.
 :deps {org.clojure/clojure       {:mvn/version "1.12.0"}
        org.replikativ/konserve   {:mvn/version "0.9.346"}
        org.replikativ/datahike   {:mvn/version "0.8.1671"}
        io.replikativ/konserve-jdbc {:mvn/version "0.2.91"
                                     :exclusions [io.replikativ/konserve]}
        org.xerial/sqlite-jdbc    {:mvn/version "3.46.1.0"}

        ;; CBOR codec — jackson cbor (available on JVM, no native deps).
        com.fasterxml.jackson.dataformat/jackson-dataformat-cbor {:mvn/version "2.18.2"}

        ;; nREPL for inspection while it runs (optional)
        nrepl/nrepl               {:mvn/version "1.3.0"}

        ;; Logging (datahike pulls slf4j; provide a backend so we see errors)
        ch.qos.logback/logback-classic {:mvn/version "1.5.6"}}

 :aliases
 {:writer {:main-opts ["-m" "seon.sidecar.writer"]
           :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}
  :client {:main-opts ["-m" "seon.sidecar.client"]}

  ;; Integration tests against a running writer. Tests spawn their own
  ;; writer subprocess and clean up after themselves.
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"
                       "-d" "test"]
         :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}}}
