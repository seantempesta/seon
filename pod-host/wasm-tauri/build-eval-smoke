#!/usr/bin/env bash
# build-eval-smoke — M2 build orchestrator for the self-hosted CLJS
# smoke test.
#
# Pipeline:
#   1. Build the seon eval-smoke CLJS bundle if missing/stale.
#      (clj -M:cljs release eval-smoke → out/eval-smoke/main.js,
#      2.1MB self-contained :simple bundle)
#   2. Generate the wasm-rquickjs wrapper crate from eval-smoke.mjs
#      + src-wit-eval-smoke/.
#   3. Build to wasm32-wasip2 (release).
#   4. Run wasmtime with out/bootstrap mounted as a preopen and invoke
#      init-bootstrap then a couple of canned eval-form calls.
#
# Output:
#   eval-smoke-build/target/wasm32-wasip2/release/seon_eval_smoke.wasm

set -euo pipefail

cd "$(dirname "$0")"
ROOT="$(pwd)"
SEON_ROOT="$ROOT/../.."

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/pod-build/target}"

WANT_RUN=true
for arg in "$@"; do
  case "$arg" in
    --no-run) WANT_RUN=false ;;
    --help|-h)
      cat <<EOF
Usage: ./build-eval-smoke [--no-run]

  --no-run  Stop after building the .wasm; don't invoke wasmtime.

Outputs:
  eval-smoke-build/                                         — wrapper crate
  pod-build/target/wasm32-wasip2/release/seon_eval_smoke.wasm
EOF
      exit 0 ;;
    *) echo "✗ unknown arg: $arg" >&2; exit 2 ;;
  esac
done

# ----- 1. CLJS bundle ------------------------------------------------------
if [[ ! -f "$SEON_ROOT/out/eval-smoke/main.js" ]]; then
  echo "▸ Building seon CLJS eval-smoke bundle (clj -M:cljs release eval-smoke)…"
  (cd "$SEON_ROOT" && clj -M:cljs release eval-smoke)
fi
test -f "$SEON_ROOT/out/eval-smoke/main.js" \
  || { echo "✗ eval-smoke bundle missing at $SEON_ROOT/out/eval-smoke/main.js"; exit 1; }

# Bootstrap analysis cache + per-ns JS the loader reads at runtime.
if [[ ! -f "$SEON_ROOT/out/bootstrap/index.transit.json" ]]; then
  echo "▸ Building bootstrap artifacts (clj -M:cljs compile bootstrap)…"
  (cd "$SEON_ROOT" && clj -M:cljs compile bootstrap)
fi
test -f "$SEON_ROOT/out/bootstrap/index.transit.json" \
  || { echo "✗ bootstrap artifacts missing at $SEON_ROOT/out/bootstrap/"; exit 1; }

# ----- 2. wasm-rquickjs wrapper crate --------------------------------------
echo "▸ Generating wasm-rquickjs wrapper crate at eval-smoke-build/…"
rm -rf eval-smoke-build
# `--js-modules seon/main=<bundle>` embeds the 2.1MB seon CLJS bundle
# into the generated crate as a named virtual module. The shim
# (eval-smoke.mjs) imports it as `seon/main`. Avoids relying on WASI
# preopens being mounted at the original absolute path of main.js —
# the bundle ships inside the .wasm itself.
wasm-rquickjs generate-wrapper-crate \
  --js-modules "bundle/script_module=$ROOT/eval-smoke.mjs" \
  --js-modules "seon/prelude=$ROOT/seon-prelude.mjs" \
  --js-modules "seon/main=$SEON_ROOT/out/eval-smoke/main.js" \
  --wit        "$ROOT/src-wit-eval-smoke" \
  --output     "$ROOT/eval-smoke-build" \
  --world      eval-smoke

# ----- 3. cargo wasm32-wasip2 release --------------------------------------
# `--no-default-features` plus a hand-picked feature set is load-bearing.
# The default `normal` tier includes `logging` (→ imports
# `wasi:logging/logging`) and `fetch` (→ pulls `wasi:http/types`).
# Stock wasmtime CLI doesn't provide a `wasi:logging` impl with the
# signature wasm-rquickjs expects, and wasi:http needs `-S http=y` at
# run time. Building without `logging` silences console.* (acceptable
# for the smoke — see src-wit-eval-smoke/eval-smoke.wit) and lets the
# component instantiate cleanly under wasmtime CLI.
echo "▸ Compiling to wasm32-wasip2 (release)…"
(cd eval-smoke-build && cargo build --release --target wasm32-wasip2 \
  --no-default-features \
  --features="lite,node-http,crypto,zlib,encoding")

POD_WASM="pod-build/target/wasm32-wasip2/release/seon_eval_smoke.wasm"
test -f "$POD_WASM" \
  || { echo "✗ seon_eval_smoke.wasm not produced at $POD_WASM"; exit 1; }
echo "✓ eval-smoke wasm built: $POD_WASM"

# ----- 4. wasmtime smoke run -----------------------------------------------
if [[ "$WANT_RUN" == "false" ]]; then
  echo "▸ Skipping wasmtime run (--no-run)."
  exit 0
fi

# Mount out/bootstrap/ as preopen "bootstrap" so the loader's
# (path/resolve :path ...) where :path = "bootstrap" finds files.
PREOPEN="$SEON_ROOT/out/bootstrap::bootstrap"

# `-S http=y` enables wasmtime's wasi-http impl. Necessary even though
# we built with --no-default-features (which excluded the `fetch`
# feature) because `node-http` still pulls a thin wasi:http types
# import. Cheap to enable; wasmtime exits 0 if nothing uses it.
WASMTIME_FLAGS=(-S http=y --dir "$PREOPEN")

echo "▸ wasmtime --invoke init-bootstrap…"
wasmtime run "${WASMTIME_FLAGS[@]}" \
  --invoke 'init-bootstrap()' \
  "$POD_WASM"

echo "▸ wasmtime --invoke eval-form(\"(+ 1 2)\")…"
wasmtime run "${WASMTIME_FLAGS[@]}" \
  --invoke 'eval-form("(+ 1 2)")' \
  "$POD_WASM"
