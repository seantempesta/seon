// seon-pod.wit — the WIT world for the V0.5 pod.
//
// Versioned at 0.1.0. SemVer rules apply: additive imports/exports = minor bump,
// breaking change = major bump. The pod and host MUST agree on the major
// version; mismatch crashes loudly on instantiation.
//
// Authoritative source: specifications/spec-05-tauri-pod-shell.md §5. If this
// file and the spec drift, fix in lock-step.

package seon:pod@0.1.0;

// ============================================================
// Type definitions used across the interfaces
// ============================================================

interface types {
  // The MCP-as-REPL surface returns these.
  variant eval-error {
    reader-error(string),
    runtime-error(string),
    interrupted,
  }

  record eval-result {
    eval-id:    string,        // 10-char base62, matches seon.agent/new-id!
    ok:         bool,          // (was `ok?` in draft — WIT identifiers can't use `?`)
    value-edn:  option<string>,
    error:      option<eval-error>,
  }

  variant db-error {
    invalid-query(string),
    runtime-error(string),
  }

  record query-result {
    rows-edn: string,           // pr-str of the Datalog result
  }

  variant run-error {
    no-session(string),
    deepseek-error(string),
    interrupted,
    runtime-error(string),
  }

  record turn-report {
    turn-n:    u32,
    forms:     u32,
    eval-ids:  list<string>,
  }

  enum message-role {
    user,
    assistant,
    system,
  }

  enum agent-state {
    idle,
    running,
  }

  record agent-snapshot {
    agent-id:      string,
    turn-count:    u32,
    state:         agent-state,
    cancelled:     bool,
    rendered-ctx:  string,        // output of the agent's :seon.render/ai fn per spec §15
  }
}

// ============================================================
// Host-mediated capabilities (default-deny; host prompts user)
// ============================================================

interface fs {
  variant fs-error {
    not-found,
    permission-denied,
    io(string),
  }

  read-file:  func(path: string) -> result<list<u8>, fs-error>;
  write-file: func(path: string, data: list<u8>) -> result<_, fs-error>;
  list-dir:   func(path: string) -> result<list<string>, fs-error>;
  exists:     func(path: string) -> bool;
  // Pre-opened paths (~/.seon/db/, ~/seon-dev-share/) are reachable
  // without prompting via wasi:filesystem/preopens. This interface is
  // for paths OUTSIDE those mounts; impl always invokes
  // capability-prompt before satisfying.
}

interface mcp {
  variant mcp-error {
    spawn-failed(string),
    closed,
    io(string),
  }

  record mcp-spec {
    name:    string,
    command: string,
    args:    list<string>,
    env:     list<tuple<string, string>>,
  }

  resource handle {
    constructor(spec: mcp-spec);
    send:  func(request: string) -> result<string, mcp-error>;
    close: func();
  }
}

interface capability-prompt {
  enum decision {
    allow,
    deny,
    allow-remember,  // V0.5 impl returns only allow/deny; reserved for V0.6+
  }

  // V0.5 threat model: SINGLE LOCAL TRUSTED USER. The agent is the user's
  // tool; they're not adversaries. The prompt's job is to *show* the user
  // what the agent wants, not to lock the agent out. See spec §5 / §14
  // discussion for the lifted-vs-strict mode breakdown.
  variant request {
    read-file(prompt-args),
    write-file(prompt-args),
    list-dir(prompt-args),
    fetch-url(prompt-args),
    spawn-mcp(mcp-prompt-args),
    network-host(prompt-args),
  }

  record prompt-args {
    target: string,            // path / url / host:port — clearly labeled
    reason: option<string>,    // agent's explanation; informational
  }

  record mcp-prompt-args {
    name:    string,
    command: string,
    args:    list<string>,
    reason:  option<string>,
  }

  ask: func(req: request) -> decision;
}

// ============================================================
// The world the pod runs in
// ============================================================

world seon-pod {
  // ---- WASI standard imports ----
  //
  // Track 0.2.3 — latest stable wasi-preview-2 (the wasi:http/filesystem/etc.
  // packages we vendor at deps/ ship 0.2.3 as of 2026-05-19). wasi:logging is
  // intentionally unversioned (still draft upstream); the published 0.1.0-draft
  // tag is not what wit-bindgen sees in the vendored deps.
  //
  // wasi:http is NOT declared here — wasm-rquickjs's bundled fetch
  // implementation imports it from inside the produced WASM regardless of
  // our WIT contract, and our Rust host satisfies it via
  // `wasmtime_wasi_http::p2::add_only_http_to_linker_async`. Declaring it
  // in this world would route through the wasmtime bindgen path, which (as
  // of wasmtime 44 / bindgen 44) generates a 2-arg call to
  // `wasi:http/types::add_to_linker` but the wasi-http crate's signature
  // wants 3 args (the interface's LinkOptions). We dodge the mismatch by
  // letting wasi-http own its own linker wiring outside the bindgen tree.
  import wasi:filesystem/preopens@0.2.3;          // konserve store + share dir
  import wasi:filesystem/types@0.2.3;
  import wasi:sockets/tcp@0.2.3;                  // in-pod node:http.createServer
  import wasi:sockets/instance-network@0.2.3;
  import wasi:logging/logging;                    // console.* via wasi:logging
  import wasi:clocks/wall-clock@0.2.3;
  import wasi:random/random@0.2.3;

  // ---- Host-mediated capabilities (this spec) ----
  // Use bare interface names for in-package references; including the
  // package name + version on a `use` inside the same package's world
  // fails to resolve under wit-bindgen 0.57.x.
  use types.{eval-result, eval-error, query-result, db-error,
             run-error, turn-report, message-role, agent-snapshot};
  import fs;
  import mcp;
  import capability-prompt;

  // Boot — returns the loopback port the WebView should navigate to.
  // Idempotent; safe to call repeatedly during host-side bring-up.
  export get-ui-port:    func() -> u16;

  // The MCP-as-REPL surface (consumed by mcp-server-seon). All
  // agent-addressable exports take agent-id so a single pod can host
  // many agents.
  //
  // `eval-form` (not `eval`) because ES modules are strict mode where
  // `export const eval = ...` is a SyntaxError, and wasm-rquickjs exports
  // each WIT function as a top-level ESM binding with the same name.
  export eval-form:      func(agent-id: string, form: string, ns: string) -> result<eval-result, string>;
  export query:          func(agent-id: string, datalog: string) -> result<query-result, db-error>;
  export trigger-turn:   func(agent-id: string) -> result<turn-report, run-error>;
  export inject-message: func(agent-id: string, content: string, role: message-role) -> result<string, string>;
  export inspect-agent:  func(agent-id: string) -> result<agent-snapshot, string>;
  export interrupt:      func(agent-id: string) -> result<_, string>;

  export shutdown:       func();
}
