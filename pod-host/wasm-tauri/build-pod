#!/usr/bin/env bash
# bin/build-pod — Lane B's pod build orchestrator (spec-05 §6).
#
# Pipeline:
#   1. (B-5+) Build seon's CLJS release bundle if seon/ is present.
#   2. (B-5+) Emit out/client/main.mjs (ESM shim importing the CJS bundle).
#   3. Generate the wasm-rquickjs wrapper crate from --js / --wit (B-2..).
#   4. Build to wasm32-wasip2 (release mode).
#   5. Smoke-test the resulting .wasm via wasmtime --invoke get-ui-port.
#   6. Optional: --tauri builds the full Tauri app on top.
#
# Until Lane A reaches A-9, this script falls back to placeholder.mjs so the
# Lane B chain (wasm-rquickjs → cargo wasm32-wasip2 → wasmtime) can be
# validated end-to-end without Lane A's bundle.

set -euo pipefail

cd "$(dirname "$0")"
ROOT="$(pwd)"

# Share Cargo's target dir across builds (placeholder vs smoke vs real pod).
# Cold builds pull ~120 deps (rquickjs + WASI bindings + crypto stack) =
# ~8 minutes. With a shared target/, incremental rebuilds drop to ~15-20s
# because the deps are already compiled.
#
# Default to pod-build/target/ so all wasm32-wasip2 artifacts land in one
# place. Honor an externally-set CARGO_TARGET_DIR (devs may override).
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/pod-build/target}"

WANT_TAURI=false
FORCE_PLACEHOLDER=false
for arg in "$@"; do
  case "$arg" in
    --tauri)        WANT_TAURI=true ;;
    --placeholder)  FORCE_PLACEHOLDER=true ;;
    --help|-h)
      cat <<EOF
Usage: bin/build-pod [--placeholder] [--tauri]

  --placeholder   Skip the seon CLJS build; feed placeholder.mjs to wasm-rquickjs.
                  (Default when seon/out/client/main.js is absent.)
  --tauri         After the pod build, also run `cargo tauri build` for the
                  full desktop bundle.

Outputs:
  pod-build/                                         — generated wrapper crate
  pod-build/target/wasm32-wasip2/release/seon_pod.wasm  — the WASM component
EOF
      exit 0 ;;
    *) echo "✗ unknown arg: $arg" >&2; exit 2 ;;
  esac
done

# ---------------------------------------------------------------------------
# Step 1+2 (Lane A bundle, when available) ; otherwise fall back to placeholder.
# ---------------------------------------------------------------------------
JS_ENTRY=""
if [[ "$FORCE_PLACEHOLDER" == "true" ]] || [[ ! -f seon/out/client/main.js ]]; then
  echo "▸ Using placeholder.mjs (seon bundle not present or --placeholder)"
  JS_ENTRY="$ROOT/placeholder.mjs"
else
  echo "▸ Building seon CLJS release bundle…"
  (cd seon && clj -M:cljs release client)
  test -f seon/out/client/main.js \
    || { echo "✗ CLJS bundle not produced"; exit 1; }

  echo "▸ Emitting ESM shim seon/out/client/main.mjs…"
  cat > seon/out/client/main.mjs <<'MJS'
// Auto-generated by bin/build-pod. Do not edit by hand.
// wasm-rquickjs wraps THIS file (--js); the actual bundle is main.js (CJS).
import './main.js';
export const getUiPort     = (...a) => globalThis.seon.getUiPort(...a);
export const evalForm      = (...a) => globalThis.seon.evalForm(...a);
export const query         = (...a) => globalThis.seon.query(...a);
export const triggerTurn   = (...a) => globalThis.seon.triggerTurn(...a);
export const injectMessage = (...a) => globalThis.seon.injectMessage(...a);
export const inspectAgent  = (...a) => globalThis.seon.inspectAgent(...a);
export const interrupt     = (...a) => globalThis.seon.interrupt(...a);
export const shutdown      = (...a) => globalThis.seon.shutdown(...a);
MJS
  JS_ENTRY="$ROOT/seon/out/client/main.mjs"
fi

# ---------------------------------------------------------------------------
# Step 3: generate the wasm-rquickjs wrapper crate.
# Regenerated fresh on every build — pod-build/ is gitignored.
# ---------------------------------------------------------------------------
echo "▸ Generating wasm-rquickjs wrapper crate at pod-build/…"
rm -rf pod-build
wasm-rquickjs generate-wrapper-crate \
  --js     "$JS_ENTRY" \
  --wit    src-wit/ \
  --output pod-build \
  --world  seon-pod

# ---------------------------------------------------------------------------
# Step 4: cargo build wasm32-wasip2 release.
# Per wasm-rquickjs README, `http` + `logging` are part of the default `normal`
# tier. `sqlite` is opt-in (full tier); we don't need it for V0.5.
# ---------------------------------------------------------------------------
echo "▸ Compiling to wasm32-wasip2 (release)…"
(cd pod-build && cargo build --release --target wasm32-wasip2)

POD_WASM="pod-build/target/wasm32-wasip2/release/seon_pod.wasm"
test -f "$POD_WASM" \
  || { echo "✗ seon_pod.wasm not produced at $POD_WASM"; exit 1; }

# ---------------------------------------------------------------------------
# Step 5: smoke-test via `wasmtime compile`.
# Validates the WASM is well-formed: parses, resolves component-model
# structure, runs Cranelift over every function. If wasm-rquickjs emits a
# bad WIT binding, this catches it. We can't use `wasmtime --invoke
# get-ui-port` for the smoke — `seon-pod` imports seon:pod/{fs,mcp,
# capability-prompt}, which the wasmtime CLI has no host impl for; real
# instantiation needs a Rust host with stub impls (B-3 owns this via
# src-tauri/src/pod.rs's unit test).
# ---------------------------------------------------------------------------
echo "▸ Smoke-testing pod via wasmtime compile…"
SMOKE_OUT="$(wasmtime compile "$POD_WASM" -o /tmp/seon_pod.cwasm 2>&1)" \
  || { echo "✗ wasmtime compile failed:"; echo "$SMOKE_OUT"; exit 1; }
test -f /tmp/seon_pod.cwasm \
  || { echo "✗ compiled artifact missing at /tmp/seon_pod.cwasm"; exit 1; }
rm -f /tmp/seon_pod.cwasm

echo "✓ Pod build green: $POD_WASM"

# ---------------------------------------------------------------------------
# Step 6 (optional): build the full Tauri app.
# ---------------------------------------------------------------------------
if [[ "$WANT_TAURI" == "true" ]]; then
  echo "▸ Building Tauri app (cargo tauri build)…"
  (cd src-tauri && cargo tauri build)
fi
