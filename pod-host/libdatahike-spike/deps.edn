{:deps {clj.native-image/clj.native-image
          {:git/url "https://github.com/taylorwood/clj.native-image.git"
           :sha "4604ae76855e09cdabc0a2ecc5a7de2cc5b775d6"}
        ;; Published datahike from clojars; avoids :local/root dev-only deps.
        io.replikativ/datahike {:mvn/version "0.7.1624"}
        ;; Scans target/classes/ for AOT'd Clojure classes and registers them
        ;; for --initialize-at-build-time via SVM Feature API.  Replaces blanket
        ;; --initialize-at-build-time=clojure (which under svm-wasm trips on
        ;; @Delete-method validation due to broader analysis).
        com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}}
 :paths ["src"]
 :aliases
 {:build
  ;; Pre-AOT bootstrap-loaded Clojure namespaces (clojure.core,
  ;; clojure.core.server, clojure.spec.alpha, ...) into classes/ by
  ;; extracting them from their owning jars -- because `(compile 'ns)` is a
  ;; no-op for namespaces that the build JVM has already loaded, so the
  ;; standard clj.native-image AOT pass misses them.  Then invoke
  ;; native-image with the same flags as :native-image.  Run with:
  ;;
  ;;     clojure -X:build build
  ;;
  ;; See build.clj for the full rationale.
  {:extra-paths ["."]
   :exec-fn build/build
   :exec-args {}
   :jvm-opts ["-Dclojure.compiler.direct-linking=true"
              "-Dclojure.spec.skip-macros=true"]}

  :native-image
  ;; --tool:svm-wasm MUST be the FIRST native-image argument per Web Image
  ;; docs.  Per the Web Image team's own demos (graalvm-demos/web-image/{javac,
  ;; spring-shell}), the right philosophy under svm-wasm is to let WebImage's
  ;; automatic feature registration handle initialization — NO blanket
  ;; --initialize-at-build-time.  Past attempts at narrow-init whack-a-mole
  ;; either trip on @Delete-method-callee assertions during universe building
  ;; OR run cleanly but fail at runtime if -H:IncludeResources doesn't include
  ;; .class files (Clojure's RT.load looks for clojure/core__init.class at
  ;; runtime; without it, FileNotFoundException).
  ;;
  ;; The Guava stubs + jdk.unsupported reads patch the three GraalVM 25
  ;; svm-wasm-guava.jar packaging defects we've found.
  {:main-opts ["-m" "clj.native-image" "seon.podhost.libdatahike.wasm-shim"
               "--tool:svm-wasm"
               "--features=clj_easy.graal_build_time.InitClojureClasses"
               "--no-fallback"
               "--emit" "build-report" "-Os"
               "-H:IncludeLocales=en"
               ;; Include BOTH .properties (default Roman pattern) AND .class
               ;; files so AOT-compiled Clojure namespaces are accessible to
               ;; RT.load at runtime.
               ;; Drop .clj/.cljc from resources — including them tempts the
               ;; Clojure runtime to compile source at WASM runtime which SVM
               ;; forbids (dynamic class definition).  Only .class and .properties.
               "-H:IncludeResources=.*\\.(properties|class)$"
               "-H:Name=core"
               "-H:+AllowDeprecatedBuilderClassesOnImageClasspath"
               ;; (Replaced by graal-build-time Feature above which scans
               ;; target/classes/ and registers actual AOT'd Clojure classes
               ;; for build-time init.  Blanket --initialize-at-build-time=clojure
               ;; trips @Delete-method validation under svm-wasm.)
               ;; Patch the shadowed-Guava module packaging defects:
               ;; (1) Inject InternalFutureFailureAccess + InternalFutures
               ;;     classes that are missing from svm-wasm-guava.jar.
               ;; (2) Add jdk.unsupported reads for AbstractFutureState$UnsafeAtomicHelper.
               "-J--patch-module=org.graalvm.wrapped.google.guava=stub-classes"
               "-J--add-reads=org.graalvm.wrapped.google.guava=jdk.unsupported"]
   :jvm-opts ["-Dclojure.compiler.direct-linking=true"
              "-Dclojure.spec.skip-macros=true"]}}}
