#!/usr/bin/env bash
# JVM database-server gate with adaptive retained test discovery.

set -euo pipefail
cd "$(dirname "$0")/.."

source bin/_java-home-resolver

case "${1:-}" in
  --help|-h)
    echo "Usage: bin/test-writer [namespace ...]"
    echo "Discovers retained database tests dynamically; selectors override."
    exit 0
    ;;
esac

bb --config bb.edn --deps-root . -e \
  '(require (quote seon.dev.artifact) (quote seon.dev.config))
   (seon.dev.artifact/prepare-dependencies!
     (seon.dev.config/load! (System/getProperty "user.dir"))
     [:writer])
   nil'

WRITER_TEST_LIST=$(IFS=,; echo "$*")

RUNNER='(let [log-fn-var (requiring-resolve (quote taoensso.trove/*log-fn*))
              get-log-fn (requiring-resolve (quote taoensso.trove.console/get-log-fn))
              base-log-fn (get-log-fn)]
          ;; Expected transaction conflicts are asserted as values by the
          ;; retained tests. Suppress only the full Datahike write-error payload
          ;; for those cases; every other library log and the clojure.test
          ;; verdict remain visible.
          (alter-var-root
            log-fn-var
            (constantly
              (fn [ns* coords level id payload]
                (when-not (and (= "datahike.writer" ns*)
                               (= :datahike/write-error id))
                  (base-log-fn ns* coords level id payload)))))
          (let [requested (some-> (System/getenv "SEON_WRITER_TEST_NAMESPACES")
                                  not-empty
                                  (.split ",")
                                  (->> (mapv symbol)))
                namespaces (or requested
                               ((requiring-resolve
                                  (quote seon.dev.test-roots/writer-test-namespaces))
                                (System/getProperty "user.dir")))
                run-tests (requiring-resolve (quote clojure.test/run-tests))]
            (doseq [test-ns namespaces] (require test-ns))
            (let [{:keys [fail error]} (apply run-tests namespaces)
                  exit-code (if (zero? (+ fail error)) 0 1)]
              (shutdown-agents)
              (System/exit exit-code))))'

SEON_WRITER_TEST_NAMESPACES="$WRITER_TEST_LIST" \
  clojure -M:writer:writer-test -e "$RUNNER"
