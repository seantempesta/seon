#!/usr/bin/env bash
# Focused JVM writer gate. Loads only retained writer test namespaces.

set -euo pipefail
cd "$(dirname "$0")/.."

source bin/_java-home-resolver

WRITER_TESTS=(
  seon.db.id-test
  seon.db.datahike.schema-test
  seon.embed-writer-test
  seon.db.generated-id-transaction-test
  seon.db.writer-integration-test
  seon.db.registry-routing-test
  seon.db.registry-test
  seon.db.backend-test
  seon.db.replay-test
  seon.db.request-receipt-test
  seon.db.transport-uds-test
)

case "${1:-}" in
  --help|-h)
    echo "Usage: bin/test-writer [namespace ...]"
    echo "Runs the retained JVM writer gate without discovering paused tests."
    exit 0
    ;;
esac

if (( $# > 0 )); then
  WRITER_TESTS=("$@")
fi

WRITER_TEST_LIST=$(IFS=,; echo "${WRITER_TESTS[*]}")

RUNNER='(let [namespaces (mapv symbol (.split (System/getenv "SEON_WRITER_TEST_NAMESPACES") ","))
              run-tests (requiring-resolve (quote clojure.test/run-tests))]
          (doseq [test-ns namespaces] (require test-ns))
          (let [{:keys [fail error]} (apply run-tests namespaces)
                exit-code (if (zero? (+ fail error)) 0 1)]
            (shutdown-agents)
            (System/exit exit-code)))'

SEON_WRITER_TEST_NAMESPACES="$WRITER_TEST_LIST" \
  clojure -M:writer:writer-test -e "$RUNNER"
