#!/usr/bin/env bash
# Persistent fresh-system dev-loop REPL host until full bin/seon start lands.
# Agents reach this cluster instance through the MCP eval_clj tool.

set -euo pipefail
cd "$(dirname "$0")/.."

cluster="${1:-default}"
if [[ ! "$cluster" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "bin/repl: invalid cluster name: $cluster" >&2
  exit 2
fi

exec clojure -M:dev -e \
  "(do
     (require 'seon.cluster 'seon.config 'seon.instrument)
     (let [instance (seon.cluster/start! {:seon.boot/cluster-name \"$cluster\"})
           dials (seon.config/effective
                  @(:seon.boot/cluster-connection instance)
                  \"$cluster\")
           ;; THE DEV LOOP is where instrumentation belongs: a human is
           ;; watching, the dial says :panic, and a contract violation
           ;; should stop the call it happens in. Re-run
           ;; (seon.instrument/apply! {:seon.config/on-core-error :panic})
           ;; after re-evaluating anything — a re-defn silently strips
           ;; the wrapper and nothing warns.
           applied (seon.instrument/apply!
                    {:seon.config/on-core-error
                     (:seon.config/on-core-error dials)
                     :seon.sci.admit/caps
                     (select-keys dials [:seon.config.eval.result/max-depth
                                         :seon.config.eval.result/max-collection
                                         :seon.config.eval.result/max-string
                                         :seon.config.eval.result/max-nodes])})]
       ;; the banner DERIVES from the started instance, so it cannot say
       ;; something the system does not; the instrumented count is the
       ;; one field boot does not own, and it is assoc'd rather than
       ;; re-derived
       (println (seon.cluster/banner
                 (assoc (seon.cluster/readiness instance)
                        :seon.instrument/instrumented
                        (:seon.instrument/instrumented applied)))))
     @(promise))"
