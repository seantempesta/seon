#!/usr/bin/env bash
# bin/acme — boot a fully ISOLATED "Acme" third-party cluster alongside the
# live seon dev cluster, then delegate to bin/seon. Acme is the codename for a
# downstream consumer; NEVER put a real product name in this repo.
#
# This wrapper is pure env composition — ZERO seon-src edits. It gives Acme its
# own ports, sockets, store, supervisor pid/lock namespace, and logs, plus the
# downstream overlay (SEON_EXTRA_*) and branding (SEON_BRAND_*) wiring.
#
#   bin/acme up                    # build + start wire-server + pod + status
#   bin/acme down                  # stop the whole cluster
#   bin/acme build                 # one-off compile -> out-acme/client/main.js
#   bin/acme start wire-server     # JVM writer on Acme's store + sockets (REPL 7981)
#   bin/acme start pod             # Node pod on :7980, acme.* compiled in
#   bin/acme status                # PIDs (from tmp/proc-acme)
#   bin/acme tail pod              # logs/acme/pod.log
#   bin/acme restart pod
#   bin/acme stop                  # stop the whole cluster (or `stop pod`)
#   bin/acme cluster reset default # wipes data/clusters/acme/store, bounces both
#
# To reproduce BUG B (silent invisibility), comment out the (reset! …) in
# acme/src/acme/pod.cljs and restart the pod: acme.* indexes ZERO rows.
set -euo pipefail
SEON_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# --- persisted local config: a gitignored .env at the repo root holds the LLM
#     provider/key/model + debug-capture vars so a plain `bin/acme …` picks them
#     up without inline env on every command. `set -a` exports each VAR=value so
#     the pod + wire-server inherit them. Keep MACHINE overrides (ports) OUT of
#     .env — those use ${:-} below and a shell-set value still wins. ---
if [ -f "$SEON_ROOT/.env.acme" ]; then set -a; . "$SEON_ROOT/.env.acme"; set +a; fi

# --- isolation: distinct from the live default (7890/7891, data/clusters/default,
#     tmp/seon-cluster-default-*.sock, tmp/proc, logs/). Ports use ${...:-} so a
#     shell override (SEON_PORT=… SEON_WRITER_REPL_PORT=… bin/acme …) can dodge a
#     MACHINE-level collision without editing this file. Acme defaults are
#     7980/7981 — verified free on this machine (7990/7991 collided with an
#     unrelated downstream deployment already holding those ports). ---
export SEON_PORT="${SEON_PORT:-7980}"
export SEON_WRITER_REPL_PORT="${SEON_WRITER_REPL_PORT:-7981}"
export SEON_CLUSTER_DIR=data/clusters/acme
export SEON_REQ_SOCK=tmp/acme-cluster-req.sock
export SEON_PUB_SOCK=tmp/acme-cluster-pub.sock
export SEON_PROC_DIR=tmp/proc-acme          # own supervisor pid/lock namespace
export SEON_LOG_DIR=logs/acme               # own logs (bin/acme tail reads here)
export SEON_PORT_FILE=tmp/seon-port-acme    # own pod port file (the live default
                                            # writes tmp/seon-port; a single shared
                                            # file would cross-talk in status/ready)

# --- embeddings: default OFF (opt-in; owner-disabled in our configs
#     2026-07-02 — .env.acme carries SEON_EMBED=0). Export GEMINI_API_KEY for
#     KNN when enabled. SEON_EMBED is a
#     PRESENCE gate in code (any value — even ""/"0" — counts as ON), so
#     empty/"0" is translated to UNSET here; bin/seon repeats the same
#     translation after sourcing the main .env. ---
case "${SEON_EMBED:-}" in
  ""|0) unset SEON_EMBED ;;
  *)    export SEON_EMBED ;;
esac

# --- capability grants (agent tools) — the DOWNSTREAM-consumer path: plain
#     host env on the launcher, zero src/seon edits. Code defaults stay
#     deny-when-unset; this harness (a legit bench pod AND the downstream-usage
#     proof) grants shell + web like any consumer's launcher would. Any value
#     but "0" grants; deny via .env.acme or the shell (SEON_SHELL=0 bin/acme
#     restart pod). Narrowing knobs (SEON_WEB_DOMAINS / SEON_WEB_LOCK /
#     SEON_FS_LOCK) pass through from .env.acme when set.
#     Full gate table: docs/seon/components/capability-gates.md ---
export SEON_SHELL="${SEON_SHELL:-1}"   # seon.agent.shell/run + py-run
export SEON_WEB="${SEON_WEB:-1}"       # seon.agent.web/fetch (SSRF guard always-on)

# --- the third-party overlay (Path B — docs/seon/components/extra-src.md) ---
export SEON_EXTRA_SRC="$SEON_ROOT/acme"
export SEON_EXTRA_PRELOAD=acme.pod

# --- acme's OWN pod bundle: the :acme-client shadow build writes
#     out-acme/client/main.js; SEON_CLIENT_OUT makes bin/seon's pod run THAT
#     bundle instead of the live cluster's out/client/main.js. ---
export SEON_CLIENT_OUT=out-acme/client/main.js

# --- config seam: acme reads its OWN manifest (per-cluster loadout/routes/
#     skills) — the same SEON_CONFIG seam bin/seon exposes, pointed at acme's
#     file so acme curates independently of the default cluster with no src
#     edit. A shell-set SEON_CONFIG still wins (e.g. SEON_CONFIG=config/test.edn
#     bin/acme restart pod to prove retract-on-drop). ---
export SEON_CONFIG="${SEON_CONFIG:-config/acme.edn}"

# --- branding / CSS control (existing seon seams; no fork) ---
export SEON_BRAND_NAME="${SEON_BRAND_NAME:-Acme}"
export SEON_BRAND_TAGLINE="${SEON_BRAND_TAGLINE:-Acme — the third-party harness}"
export SEON_BRAND_CSS="$SEON_ROOT/acme/branding/acme.css"

# --- build/compile: a ONE-OFF acme compile (NOT a second watch — two shadow
#     watch servers would collide on nREPL :7889). Injects SEON_EXTRA_SRC +
#     SEON_EXTRA_PRELOAD exactly as bin/seon's cljs-watch does for :client,
#     but targets :acme-client → out-acme/client/main.js. Run this once before
#     `bin/acme start pod`; re-run after editing acme/src. ---
case "${1:-}" in
  build|compile)
    cd "$SEON_ROOT"
    echo "▶ compiling acme-client (SEON_EXTRA_SRC=$SEON_EXTRA_SRC, preload=$SEON_EXTRA_PRELOAD)"
    clj -Sdeps "{:deps {seon.extra/src {:local/root \"$SEON_EXTRA_SRC\"}}}" \
        -M:cljs compile acme-client \
        --config-merge "{:devtools {:preloads [$SEON_EXTRA_PRELOAD]}}"
    echo "● built $SEON_ROOT/$SEON_CLIENT_OUT (acme.* baked in)"
    exit 0
    ;;
  up)
    # build + boot the whole isolated cluster: wire-server FIRST (sole writer;
    # pod boot is gated on its socket), then the pod. Recurse through "$0" so
    # each step gets the full Acme env block above.
    "$0" build
    "$0" start wire-server
    "$0" start pod
    "$0" status
    exit 0
    ;;
  down)
    # stop the whole cluster (pod first, then the writer).
    "$SEON_ROOT/bin/seon" stop pod || true
    "$SEON_ROOT/bin/seon" stop wire-server || true
    exit 0
    ;;
  stop)
    # `bin/acme stop` with NO process name stops the whole cluster (bin/seon
    # alone errors "stop requires a process name"). `bin/acme stop pod` still
    # delegates to the named form below.
    if [ -z "${2:-}" ]; then
      "$SEON_ROOT/bin/seon" stop pod || true
      "$SEON_ROOT/bin/seon" stop wire-server || true
      exit 0
    fi
    ;;
  gym-diffusion)
    # Score a CONSUMER-OWNED diffusion-gym scenario (acme/gym/scenarios/*.edn)
    # through seon's CO-LOCATED ORACLE (bin/oracle-server parse-raw + the
    # worker-oracle-eval bundle) and emit a scorecard. HERMETIC + OFFLINE (CPU):
    # no pod, no wire-server, no GPU — the oracle is a pure fn reached by PATH,
    # so this is ZERO src/seon edits and never touches a live store. SEON_ROOT is
    # exported for the driver to locate the oracle binaries. A bare scenario name
    # resolves under acme/gym/scenarios/; a path passes through.
    #   bin/acme gym-diffusion celsius-killgate.edn --assert
    #   bin/acme gym-diffusion pure-mean.edn --eval --assert
    shift
    ARGS=()
    for a in "$@"; do
      case "$a" in
        --*) ARGS+=("$a") ;;
        /*)  ARGS+=("$a") ;;
        */*) ARGS+=("$SEON_ROOT/$a") ;;
        *)   ARGS+=("$SEON_ROOT/acme/gym/scenarios/$a") ;;
      esac
    done
    exec env SEON_ROOT="$SEON_ROOT" bb "$SEON_ROOT/acme/gym/diffusion_gym.bb" "${ARGS[@]}"
    ;;
  cluster)
    # Owner rule (2026-07-02): REBUILD before every reset. The acme bundle is
    # NOT watched — a reset on a stale bundle boots yesterday's core, or dies
    # outright when the seed expects a namespace the bundle predates (the
    # my.plan boot race). Build here, then FALL THROUGH to bin/seon's
    # race-safe cluster_reset unchanged (do NOT replace it with `down && up`:
    # after a store wipe the wire-server's cold mint outlasts the pod's ~10s
    # ping window and the fresh pod dies).
    if [ "${2:-}" = "reset" ]; then
      "$0" build
    fi
    ;;
  start|restart)
    # Same staleness rule for start/restart pod: rebuild first when any core
    # or overlay source is newer than the bundle (compile is ~20s and
    # idempotent; running stale code costs far more).
    if [ "${2:-}" = "pod" ]; then
      BUNDLE="$SEON_ROOT/$SEON_CLIENT_OUT"
      # Stale when any core/overlay source OR a dependency/build config
      # (deps.edn, shadow-cljs.edn, acme/deps.edn — e.g. a datahike fork sha
      # bump) is newer than the bundle: a dep change requires a re-compile
      # just as much as a src change does.
      if [ ! -f "$BUNDLE" ] \
         || [ -n "$(find "$SEON_ROOT/src" "$SEON_ROOT/$SEON_EXTRA_SRC" \( -name '*.cljs' -o -name '*.cljc' \) -newer "$BUNDLE" -print -quit 2>/dev/null)" ] \
         || [ -n "$(find "$SEON_ROOT/deps.edn" "$SEON_ROOT/shadow-cljs.edn" "$SEON_ROOT/$SEON_EXTRA_SRC/deps.edn" -newer "$BUNDLE" -print -quit 2>/dev/null)" ]; then
        echo "▶ acme bundle is stale vs core/overlay source — rebuilding first"
        "$0" build
      fi
    fi
    ;;
esac

exec "$SEON_ROOT/bin/seon" "$@"
