#!/usr/bin/env bash
# bin/acme — operate the explicit `acme` cluster in an isolated operator root.
set -euo pipefail

SEON_SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
ACME_OPERATOR_ROOT="${SEON_ACME_ROOT:-$SEON_SOURCE_ROOT/tmp/acme-operator-root}"
ACME_CLUSTER_NAME="acme"

if [[ "${1:-}" == "--root" ]]; then
  if [[ -z "${2:-}" ]]; then
    echo "✗ bin/acme --root requires an existing isolated operator root." >&2
    exit 1
  fi
  ACME_OPERATOR_ROOT="$2"
  shift 2
else
  mkdir -p "$ACME_OPERATOR_ROOT"
fi

usage() {
  cat <<'EOF'
Usage: bin/acme [--root PATH] COMMAND

Operate the `acme` cluster in an isolated fresh-system operator root.

  start [--config PATH]     start the acme cluster
  config apply PATH         reconcile acme from a sparse config manifest
  init                      publish current source in this operator root
  init --changed PATH...    publish safe changed source files
  init acme [--force]       fork or destructively refork the acme cluster
  status                    list this isolated operator root
  open                      open the acme namespace page
  stop [--force]            stop the acme cluster
  down [--force]            stop every JVM in this isolated operator root
  logs                      show the acme cluster log
EOF
}

command="${1:-help}"
shift || true

case "$command" in
  start)
    exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" \
      start "$ACME_CLUSTER_NAME" "$@"
    ;;
  config)
    if [[ "${1:-}" != "apply" || "$#" -ne 2 ]]; then
      echo "✗ use: bin/acme [--root PATH] config apply PATH" >&2
      exit 1
    fi
    exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" \
      config apply "$ACME_CLUSTER_NAME" "$2"
    ;;
  init)
    case "${1:-}" in
      ""|--changed)
        exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" \
          init "$@"
        ;;
      "$ACME_CLUSTER_NAME")
        exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" \
          init "$@"
        ;;
      *)
        echo "✗ use: bin/acme [--root PATH] init [--changed PATH...|acme [--force]]" >&2
        exit 1
        ;;
    esac
    ;;
  status)
    if [[ "$#" -ne 0 ]]; then
      echo "✗ use: bin/acme [--root PATH] status" >&2
      exit 1
    fi
    exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" status
    ;;
  open|logs)
    if [[ "$#" -ne 0 ]]; then
      echo "✗ use: bin/acme [--root PATH] $command" >&2
      exit 1
    fi
    exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" \
      "$command" "$ACME_CLUSTER_NAME"
    ;;
  stop)
    if [[ "$#" -gt 1 || ( "$#" -eq 1 && "$1" != "--force" ) ]]; then
      echo "✗ use: bin/acme [--root PATH] stop [--force]" >&2
      exit 1
    fi
    exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" \
      stop "$@" "$ACME_CLUSTER_NAME"
    ;;
  down)
    if [[ "$#" -gt 1 || ( "$#" -eq 1 && "$1" != "--force" ) ]]; then
      echo "✗ use: bin/acme [--root PATH] down [--force]" >&2
      exit 1
    fi
    exec "$SEON_SOURCE_ROOT/bin/seon" --root "$ACME_OPERATOR_ROOT" down "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "✗ unknown ACME command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
