#!/bin/zsh
# bin/tree [DIR] — the tree DIR (default: this checkout) is as git names it: HEAD's tree (none before
# a first commit) with every changed and untracked unignored file added, in an index of its own
# (the repository's untouched; a copy of it, with its mtime, when it is HEAD's tree with no skipped entry). bin/build records it beside the binary (target/seon.tree);
# bin/check compares it with that record before it runs the binary. seon.fx/tree-id computes the
# same in Clojure. Top-level paths :seon.config.source/tree-excludes names (claude_scratch/: no read and no
# build reads them) are left out, read from the shipped resources/seon/config/default.edn.
# bin/tree DIR REV names the tree of the commit REV the same way (its tree, the excluded paths left out), reading no
# file of DIR: what bin/land gives root for a landing, so a landed main and a binary built from it name one tree.
# Prints nothing and exits 1 when git cannot name it.
# git reads the repository's own config and no other: a tree's id never depends on whose HOME runs it (seon.fx/git-run's rule)
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
ROOT=${1:-$(cd "$(dirname "$0")/.." && pwd)}
REV=${2:-}
CFG=$(dirname "$0")/../resources/seon/config/default.edn
EX=(); [[ -f $CFG ]] && EX=($(sed -nE 's#^ :seon\.config\.source/tree-excludes \[(.*)\].*#\1#p' "$CFG" | tr -d '"'))
idx=$(mktemp -u)
trap 'rm -f "$idx"' EXIT
real=$(git -C "$ROOT" rev-parse --path-format=absolute --git-path index)
if [[ -n $REV ]]; then GIT_INDEX_FILE=$idx git -C "$ROOT" read-tree "$REV" || exit 1
elif git -C "$ROOT" rev-parse --verify --quiet HEAD > /dev/null; then
  if [[ -f $real ]] && git -C "$ROOT" diff-index --cached --quiet HEAD && ! git -C "$ROOT" ls-files -v | grep -qv '^H '; then cp -p "$real" "$idx" || exit 1
  else GIT_INDEX_FILE=$idx git -C "$ROOT" read-tree HEAD || exit 1; fi
fi
[[ -n $REV ]] || GIT_INDEX_FILE=$idx git -C "$ROOT" add -A || exit 1
(( $#EX )) && { GIT_INDEX_FILE=$idx git -C "$ROOT" rm -r --cached -q --ignore-unmatch -- ${^EX/#/:(top)} || exit 1 }
GIT_INDEX_FILE=$idx git -C "$ROOT" write-tree
