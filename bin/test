#!/bin/zsh
# bin/test [--all] [NS|NS/TEST ...] — (--all, the one flag, first; a flag it does not know, or a name that is no
# test namespace or deftest, is TEST FAILED) test/'s deftests (every *_test namespace, the ones named,
# or one deftest by its qualified name, as bin/prove prints the ones it leaves out) with
# no green result at their reach digest, the rest reused from the results directory every
# checkout shares (bin/prove's tests; seon.proofs/plan). --all runs every one, green or not (the
# full run). The selected tests are dealt, a namespace at a time, into :seon.config.proofs/jobs
# shards, each run at once in a process of its own (logs and shard files in the run's directory,
# target/prove/<run-id>, which the run's first line names: no two runs share one);
# each result is stored at its digest, after target/seon is built from this tree when anything
# runs. Ends on TEST OK / TEST FAILED and its exit status.
# With bin/prove (both or checks), the check steps to run go beside the shards (bin/check --steps).
# bin/test --plan|--shard|--store-steps|--health ... are test/test_runner.clj's parts (bin/prove's; --health is bin/check's health step).
# On the runtime bin/build made (target/jolt/jolt), with dependencies cached in target/home.
# background jobs (shards, the check steps) keep the run's own nice: zsh's BG_NICE renices each, which a niced run
# may not do ("nice(5) failed: operation not permitted" on every job)
setopt NO_BG_NICE
ROOT=$(cd "$(dirname "$0")/.." && pwd)
"$ROOT/bin/ports" --write   # the port keys under their current names (bin/ports)
JOLT=$ROOT/target/jolt/jolt
[[ -x $JOLT ]] || { echo "test: no target/jolt/jolt; run bin/build jolt first" >&2; exit 1 }
. "$ROOT/bin/env"
cd "$ROOT"
# a root a test boots listens on no dashboard port
export SEON_WEB_PORT=${SEON_WEB_PORT:-0}
# every test root has a store of its own: its wiki's baseline from git (4 s) is not what a test asks
export SEON_WIKI_BASELINE=${SEON_WIKI_BASELINE:-false}
# agents' turns are the scripted provider's (a test fixture; a root with no profile has no model provider):
# the runner is given --profile scripted on its command line (seon.config reads it there)
# a test's root embeds no text (:seon.config.vector/texts 0): none searches what it holds, and each would
# load the 0.9 GB model (docs/vector.md); seon.vector's tests use made vectors
export SEON_EMBED_TEXTS=${SEON_EMBED_TEXTS:-0}
runner() { HOME=$ROOT/target/home JOLT_PWD=$ROOT "$JOLT" -A:test run -m test-runner "$@" --profile scripted }
# the full run measures each cost proof at the sizes it states (:seon.config.proofs/cost-max-n)
[[ " $* " == *" --all "* ]] && export SEON_COST_MAX_N=100000
# and draws every randomized property test's seeds (:seon.config.proofs/seeds)
[[ " $* " == *" --all "* ]] && export SEON_SEEDS=5
OWN=0
case ${1:-} in
  --plan|--shard|--store-steps|--health) runner "$@"; exit $? ;;
  --prove) WHAT=$2 OUT=$3; shift 3 ;;
  *) WHAT=tests OWN=1 OUT=$ROOT/target/prove/$(date +%Y%m%dT%H%M%S)-$$; echo "test: run ${OUT:t}, logs in $OUT" ;;
esac
mkdir -p "$OUT"; rm -f $OUT/shard-*(N)
# this run's shards (:seon.config.proofs/jobs, at most; the plan deals what the work is worth, seon.proofs/worth-shards) are
# as many as the machine's free memory holds (seon.proofs/memory-jobs: each shard's footprint, :seon.config.proofs/shard-mb,
# above a floor kept free, :seon.config.proofs/free-floor-mb), never fewer for the load average: load counts other sessions'
# niced work, so a rule on it dealt one shard at load 12 on 18 cores and a gate of 234 process tests ran 763 s in series.
# The owner, 2026-11-08: "Why are we doing so much sharding?", when a shard booted a root per test group (now one per
# shard, slowfix); 2026-11-10: "I have 18 cores and load is 8" (heavy runs judged by cores and free memory, AGENTS.md §8),
# "allocate whatever resources we need" and "I'm more upset about the wasted time not processing". The plan writes the
# count it took to out/jobs, which the check steps take too. SEON_PROOF_JOBS, when set, is the ceiling instead.
runner --plan $WHAT "$OUT" "$@" || { echo "TEST FAILED (the plan)"; exit 1 }
jobs=$(<$OUT/jobs)
# a test or step that reaches a process of its own (a root, an agent, the binary) runs target/seon,
# which its digest does not cover: that binary is built from this tree first (a no-op build costs
# ~30-45 s) unless it is current for this tree, what differs reaching nothing root runs from its binary
# (seon.root/binary-current, the plan's out/build). The plan names what it selected that reaches one (out/binary); nothing, no build
F=($OUT/shard-*.edn(N))
# laws and health read the tree and answer in seconds, before any build: a run of their own beside the rest, whose red ends the run, shards and
# steps, as no later result can make that tree mergeable and a red is reported as it stands (docs/merging.md#a-merge-runs-what-the-change-reaches)
FAST=(); if [[ ${WHAT:-} != tests && -s $OUT/steps ]]; then
  ALL=$(<$OUT/steps); for s in laws health; do [[ " $ALL " == *" $s "* ]] && FAST+=($s); done
  if (( ${#FAST} )); then
    mkdir -p "$OUT/fast"; print -r -- "$FAST" > "$OUT/fast/steps"; : > "$OUT/fast/steps-binary"
    REST=(${${=ALL}:|FAST}); print -r -- "$REST" > "$OUT/steps"
    ( "$ROOT/bin/check" --steps "$OUT/fast" > "$OUT/fast.log" 2>&1 || { : > "$OUT/stopped"; [[ -s $OUT/shards.pid ]] && kill $(<$OUT/shards.pid) 2>/dev/null; [[ -s $OUT/check.pid ]] && kill $(<$OUT/check.pid) 2>/dev/null } ) & A=$!
  fi
fi
# built only when the binary is not current for this tree (the plan's out/build: seon.root/binary-current names what differs)
if [[ -s $OUT/binary && -s $OUT/build ]]; then
  nice -n 15 "$ROOT/bin/build" seon > "$OUT/build.log" 2>&1 || { tail -5 "$OUT/build.log"; echo "TEST FAILED (bin/build seon: $OUT/build.log)"; exit 1 }
fi
# the process tests' store gets this tree's program and wiki on :db (the plan made the store), so a root
# whose main is a branch of it imports nothing (seon.root/seed-program!)
if [[ -s $OUT/process-store ]]; then
  nice -n 15 "$ROOT/bin/root" seed "$(<$OUT/process-store)" > "$OUT/seed.log" 2>&1 || { tail -5 "$OUT/seed.log"; echo "TEST FAILED (bin/root seed: $OUT/seed.log)"; exit 1 }
fi
st=0 P=()
[[ -e $OUT/stopped ]] && { F=(); : > "$OUT/steps" }
# told to stop (a timeout's TERM), its shards get TERM: each stores the greens of the tests that ended (its shutdown hook) and never a red, since a
# test cut short reads a root the stop ended, and its red would turn flaky beside the next run's greens. A shard that dies with no hook stores nothing
trap 'kill $P 2>/dev/null; exit 143' TERM INT HUP
# each shard a process of its own; its tests' ms are in their cached verdicts (:ms, seon.fx/typical-ms)
# (exec: the pid is the shard's, so a kill reaches it, not a shell that leaves it running)
for f in $F; do ( HOME=$ROOT/target/home JOLT_PWD=$ROOT exec "$JOLT" -A:test run -m test-runner --shard "$f" --profile scripted ) > "${f%.edn}.log" 2>&1 & P+=($!); done
print -r -- "$P" > "$OUT/shards.pid"; [[ -e $OUT/stopped && -n $P ]] && kill $P 2>/dev/null
# bin/prove's check steps (the plan's out/steps) run beside the shards, not after them: they share no
# store, port or checkout state with a test's roots (each step takes an APFS clone of the one seeded store,
# bin/check), so the run takes as long as the longer of the two, not their sum (docs/merging.md). Their
# output is kept in out/check.log and printed after the shards'.
C=
if [[ ${WHAT:-} != tests && -s $OUT/steps ]]; then SEON_PROOF_JOBS=$jobs "$ROOT/bin/check" --steps "$OUT" > "$OUT/check.log" 2>&1 & C=$!; fi
print -r -- "$C" > "$OUT/check.pid"; [[ -n $C && -e $OUT/stopped ]] && kill $C 2>/dev/null
# a stalled test is named, never ended: a running shard quiet since its last "started" line past
# that test's bound (k times its own last run, the plan's out/stall-bounds; the floor and a test
# with no record: :seon.config.agent/stall-ms, out/stall-ms, 0: none) is printed and recorded as
# STALLED (bin/stalls; an observation: docs/clocks.md)
STALL_MS=$(<$OUT/stall-ms) W=
S=(); for (( i = 1; i <= ${#F}; i++ )); do S+=("${F[$i]%.edn}.log:$P[$i]"); done
(( STALL_MS > 0 )) && { "$ROOT/bin/stalls" $STALL_MS "$OUT/stall-bounds" $S & W=$! }
for (( i = 1; i <= ${#F}; i++ )); do
  f=$F[$i] log=${F[$i]%.edn}.log
  wait $P[$i]; s=$?
  grep -E "^RED|^SHARD" "$log"
  if (( s != 0 )); then
    st=1
    [[ -e $OUT/stopped ]] || grep -q "^SHARD" "$log" || echo "FAILED shard $f: exit $s, $(grep '^started' "$log" | tail -1) ($log)"
  fi
done
[[ -n $W ]] && kill $W 2>/dev/null
if [[ -n $C ]]; then wait $C || st=1; [[ -e $OUT/stopped ]] || cat "$OUT/check.log"; fi
if (( ${#FAST} )); then
  wait $A; cat "$OUT/fast.log"; [[ -e $OUT/stopped ]] && { st=1; echo "stopped: a red in ${FAST} ended the run's other tests and steps" }
  # what the two runs found green, and the steps as the plan named them, for bin/prove's store of them
  [[ -s $OUT/fast/green ]] && cat "$OUT/fast/green" >> "$OUT/green"
  print -r -- "$ALL" > "$OUT/steps"
fi
# a test green and red at its digest (the plan's out/flaky) is red, though nothing ran it
[[ -s $OUT/flaky ]] && { cat "$OUT/flaky"; st=1 }
# the full run's outcome, beside the verdict cache, so a store erase keeps it (docs/merging.md#the-full-run-is-the-net): the commit it
# ran, green or red with each red test, and when it ended; written whole (temp + rename), green or red. A run that died writes
# nothing, so the file still names the last run that ended: bin/land says how many landings main is past it
if [[ " $* " == *" --all "* && -n ${SEON_RESULTS_DIR:-} ]]; then
  reds=(${(f)"$(for f in $F; do grep -h "^RED " "${f%.edn}.log"; done | awk '{print $2}' | sort -u)"})
  { print -r -- "{:commit \"$(git -C "$ROOT" rev-parse HEAD)\" :status $( (( st == 0 )) && print :green || print :red)"
    print -r -- " :reds [${reds[*]}]"
    print -r -- " :ended \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" :logs \"$OUT\"}" } > "$SEON_RESULTS_DIR/.full-run.edn.$$" &&
    mv "$SEON_RESULTS_DIR/.full-run.edn.$$" "$SEON_RESULTS_DIR/full-run.edn"
fi
# a green run's logs are read by no one: the directory a plain run made is reclaimed with it (a red run's stays)
if (( st == 0 )); then echo "TEST OK"; (( OWN )) && rm -rf "$OUT"; else echo "TEST FAILED (logs: $OUT)"; fi
exit $st
