#!/usr/bin/env bash
# The system test gate. Tiered, à la carte, with smart defaults.
#
#   bin/test                        # platform tier, then tests reaching
#                                   #   code changed since the last GREEN basis
#   bin/test --all                  # platform tier, then every non-long test
#   bin/test --full                 # platform tier, then every test
#   bin/test --platform             # the moving-part regressions alone
#   bin/test --changed PATH [...]   # platform tier, then tests reaching PATHs
#   bin/test seon.turn-test  # run exactly these namespaces, every test
#   bin/test --result-cluster scratch [namespaces...]
#
# Every tiered invocation runs the declared `:seon.test/platform` moving-part
# regressions FIRST and stops there when they are red: a broken platform fails
# in seconds instead of poisoning the bulk. The bare default then runs only the
# tests that reach changed code, derived from `:seon.fn/calls` edges in the one
# program-graph manifest — never a file modification time or a filename
# convention. The checkout-local green-basis file remains the temporary
# selection input; every completed canonical gate also replaces the
# per-test facts of the tests it ran on the `:current-src` branch.
#
# Each invocation owns one isolated operator root below `tmp/test-runs`, copies
# the first-party checkout into it, and deletes it on success. Exit code is the
# suite verdict. Explicit result clusters remain opt-in and refuse the owner's
# `default` cluster.

set -euo pipefail

# Bash may continue reading an executing script from disk. A 36-minute gate
# proved that an in-place edit can therefore splice new bytes into the old
# invocation after its JVM exits. Re-exec one complete in-memory command string
# so this invocation's operator-root lifecycle is frozen with its launch bytes.
if [ "${SEON_TEST_SCRIPT_SNAPSHOT-}" != "1" ]; then
  export SEON_TEST_SCRIPT_SNAPSHOT=1
  exec /bin/bash -c "$(command cat -- "$0")" "$0" "$@"
fi
unset SEON_TEST_SCRIPT_SNAPSHOT

cd "$(dirname "$0")/.."
source_root=$PWD

# ---------------------------------------------------------------------------
# Declared bounds. §2.3: every execution surface carries its bound at the seam
# that admits the work, and a bound firing is a bug report naming what never
# arrived — never a silent retry, never a hang.
#
# The test phase has the suite liveness watchdog (SEON_TEST_SILENCE_SECONDS,
# `seon.test.runner/silence-seconds`). The PREPARATION phases had none: on
# 2026-09-17 every gate refused inside `dependency-cache-and-classpath` for
# about an hour while four invocations sat at `phase=snapshot`, and the slot
# wait's own bound made the wedge read as an ordinary queue
# (docs/seon/issues/dev-cache-tool-classpath-omits-the-selectors-dependencies.md).
# Each bound below names the observable it stands in for, measured in
# docs/prds/steward-platform/research/test-preparation-costs-2026-09-16.md and
# the retained `tmp/test-runs/*/test-run.txt` ledgers of 2026-09-16. A bound of
# 0 declares that this phase's bound is owned elsewhere.

# Copying HEAD plus the overlaid working bytes into the run root: measured 3-6 s
# warm, 21 s with five gates competing for the disk.
snapshot_phase_seconds=${SEON_TEST_SNAPSHOT_SECONDS:-300}
# Waiting for a test JVM slot: bin/_test-slot declares and reports that wait
# itself. This backstop only catches a slot loop that stops looping.
test_slot_phase_seconds=${SEON_TEST_SLOT_PHASE_SECONDS:-$((${SEON_TEST_SLOT_WAIT_SECONDS:-1800} + 60))}
# The -T:dev-cache tool JVM plus classpath reads: 3-6 s against a warm
# dependency closure, 57 s for the one cold immutable rebuild a deps.edn change
# forces (issue note above).
dependency_cache_phase_seconds=${SEON_TEST_DEPENDENCY_CACHE_SECONDS:-300}
# Copy-on-write worker checkouts: measured 2-5 s.
worker_checkouts_phase_seconds=${SEON_TEST_WORKER_CHECKOUTS_SECONDS:-300}
# Publishing or reusing the shared test base: 0 s on an exact cache hit,
# 107-131 s cold, 171 s cold under concurrent gates. A 60 s bound would fail
# every cold publication; this one stands for a publication that never returns.
published_base_phase_seconds=${SEON_TEST_PUBLISHED_BASE_SECONDS:-600}
# The coordinator and its workers: bounded by the suite liveness watchdog and
# the runner's own declared exchange bounds, not from out here.
coordinator_phase_seconds=${SEON_TEST_COORDINATOR_PHASE_SECONDS:-0}
# How long a signalled runner has to exit before it is forced.
runner_reap_backstop_seconds=${SEON_TEST_RUNNER_REAP_SECONDS:-10}
# ---------------------------------------------------------------------------

usage() {
  cat <<'USAGE'
Usage: bin/test [--all|--full|--platform|--changed PATH]...
                [--result-cluster NAME] [--result-root PATH] [namespaces...]

  (bare)          platform tier, then the tests reaching code changed since
                  the last recorded green basis
  --all           platform tier, then every non-long test
  --full          platform tier, then every test (SEON_TEST_FULL=1 too)
  --platform      the declared moving-part regressions alone
  --paths FILE... snapshot HEAD plus these working-tree files; use -- before namespaces
  --changed PATH  platform tier, then the tests reaching PATH (repeatable)
  --confirm       diagnostic isolation of named failing tests (ns/test ...)

An explicit namespace selection always runs every test in those namespaces
and records no green basis.
USAGE
}

if [ ! -L seon-skills ] || [ ! -L .claude/skills ]; then
  echo "bin/test: skill paths must be links to the one .agents/skills tree" >&2
  echo "bin/test: restore the tracked links; edit skills only under .agents/skills" >&2
  exit 1
fi

skills_root=$(cd .agents/skills && pwd -P)
runtime_skills_root=$(cd seon-skills && pwd -P)
claude_skills_root=$(cd .claude/skills && pwd -P)
if [ "$skills_root" != "$runtime_skills_root" ] ||
   [ "$skills_root" != "$claude_skills_root" ]; then
  echo "bin/test: skill paths resolve to different directories" >&2
  echo "bin/test: .agents/skills, seon-skills, and .claude/skills must share one tree" >&2
  exit 1
fi

result_cluster=${SEON_TEST_RESULT_CLUSTER:-}
result_root=${SEON_TEST_RESULT_ROOT:-}
requested_mode=
explicit_selection=0
namespaces=()
changed_paths=()
snapshot_paths=()
fast_iteration=0
confirm=0

set_mode() {
  if [ -n "$requested_mode" ] && [ "$requested_mode" != "$1" ]; then
    echo "bin/test: --$requested_mode and --$1 select different tiers" >&2
    exit 64
  fi
  requested_mode=$1
}

case "${SEON_TEST_FULL:-0}" in
  0) ;;
  1) set_mode full ;;
  *)
    echo "bin/test: SEON_TEST_FULL must be 0 or 1" >&2
    exit 64
    ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --full)
      set_mode full
      shift
      ;;
    --all)
      set_mode all
      shift
      ;;
    --platform)
      set_mode platform
      shift
      ;;
    --fast)
      fast_iteration=1
      shift
      ;;
    --confirm)
      confirm=1
      shift
      ;;
    --paths)
      shift
      count_before=${#snapshot_paths[@]}
      while [ $# -gt 0 ] && [[ "$1" != --* ]]; do
        case "$1" in
          /*|..|../*|*/../*|*/..|./*|*/./*|.git|.git/*|reference-code|reference-code/*)
            echo "bin/test: --paths requires literal repository-relative first-party files: $1" >&2
            exit 64 ;;
        esac
        if [ -d "$1" ] || { [ ! -e "$1" ] && [ ! -L "$1" ] &&
          ! GIT_LITERAL_PATHSPECS=1 git ls-files --error-unmatch -- "$1" >/dev/null 2>&1; }; then
          echo "bin/test: --paths requires an existing file or tracked deletion: $1" >&2
          exit 64
        fi
        snapshot_paths+=("$1")
        shift
      done
      if [ ${#snapshot_paths[@]} -eq "$count_before" ]; then
        echo "bin/test: --paths requires at least one file" >&2
        exit 64
      fi
      ;;
    --changed)
      if [ $# -lt 2 ]; then
        echo "bin/test: --changed requires a repository-relative path" >&2
        exit 2
      fi
      set_mode changed
      changed_paths+=("$2")
      shift 2
      ;;
    --result-cluster)
      if [ $# -lt 2 ]; then
        echo "bin/test: --result-cluster requires a name" >&2
        exit 2
      fi
      result_cluster=$2
      shift 2
      ;;
    --result-root)
      if [ $# -lt 2 ]; then
        echo "bin/test: --result-root requires a path" >&2
        exit 2
      fi
      result_root=$2
      shift 2
      ;;
    --)
      shift
      namespaces+=("$@")
      if [ $# -gt 0 ]; then
        explicit_selection=1
      fi
      break
      ;;
    --*)
      echo "bin/test: unknown option: $1" >&2
      usage >&2
      exit 64
      ;;
    *)
      namespaces+=("$1")
      explicit_selection=1
      shift
      ;;
  esac
done

if [ -n "${SEON_CODEX_LANE:-}" ] && [ "$fast_iteration" -ne 1 ]; then
  printf 'bin/test: refusing gate from Codex lane %s; use bin/test-fast --paths <your files> -- <namespaces>; the orchestrator owns the cold gate.\n' "$SEON_CODEX_LANE" >&2
  exit 64
fi

confirm_symbols=
if [ "$confirm" -eq 1 ]; then
  if [ ${#namespaces[@]} -eq 0 ] || [ -n "$requested_mode" ] || [ "$fast_iteration" -eq 1 ]; then
    echo 'bin/test: --confirm requires named failing tests: ns/test ...' >&2
    exit 64
  fi
  confirm_namespaces=()
  for test_symbol in "${namespaces[@]}"; do
    case "$test_symbol" in
      */*)
        if [ -z "${test_symbol%/*}" ] || [ -z "${test_symbol##*/}" ]; then
          echo 'bin/test: --confirm requires qualified test names' >&2
          exit 64
        fi
        confirm_namespaces+=("${test_symbol%/*}") ;;
      *) echo 'bin/test: --confirm requires qualified test names' >&2; exit 64 ;;
    esac
  done
  confirm_symbols=$(printf '%s\n' "${namespaces[@]}")
  namespaces=($(printf '%s\n' "${confirm_namespaces[@]}" | sort -u))
fi

if [ "$fast_iteration" -eq 1 ] &&
   { [ ${#snapshot_paths[@]} -eq 0 ] || [ "$explicit_selection" -ne 1 ]; }; then
  echo 'bin/test: --fast requires --paths FILE... -- NAMESPACE...' >&2
  exit 64
fi

if [ "$explicit_selection" -eq 1 ]; then
  if [ -n "$requested_mode" ]; then
    echo "bin/test: an explicit namespace selection takes no tier flag" >&2
    exit 64
  fi
  selection_mode=explicit
  selection="${namespaces[*]}"
else
  selection_mode=${requested_mode:-changed}
  case "$selection_mode" in
    changed)
      if [ ${#changed_paths[@]} -gt 0 ]; then
        selection="changed tier (${#changed_paths[@]} named path(s))"
      else
        selection="changed tier (since the green basis)"
      fi
      ;;
    all) selection="platform tier plus every non-long test" ;;
    full) selection="full suite" ;;
    platform) selection="platform tier" ;;
  esac
fi

if [ "$result_cluster" = "default" ]; then
  echo "bin/test: refusing to write result facts into the default cluster" >&2
  exit 2
fi

source bin/_test-slot
source bin/_java-home-resolver

git_sha=$(git rev-parse HEAD)

# Every canonical gate records exactly the tests it ran, including explicit
# namespaces and platform-only selections. An explicit cluster overrides the
# current-src destination. The fast iteration path does not persist evidence.
persistent_results_root=
if [ -z "$result_cluster" ]; then
  persistent_results_root="$source_root"
fi

# A suite is a complete isolated operator root and working directory. Fresh
# first-party roots are copy-on-write clones so canonical-path analysis sees a
# real checkout, not paths escaping through symlinks. Large dependencies and
# documentation are projected read-only in practice; every relative mutable
# root is private to this invocation. Only the separate :dev-cache alias writes
# the shared dependency class cache.
run_parent=${SEON_TEST_RUN_PARENT:-$source_root/tmp/test-runs}
mkdir -p "$run_parent"
run_parent=$(cd "$run_parent" && pwd -P)

# Retain every live invocation plus the three newest inactive roots younger
# than 24 hours. Reap anything older, and bound recent failed/interrupted
# evidence to three roots. seon.fs owns the no-follow deletion walk: a symlink
# inside a run root is deleted as a leaf and its referent is never traversed.
bb --config "$source_root/bb.edn" -e '
  (require (quote [clojure.java.io :as io])
           (quote [babashka.process :as process])
           (quote [seon.fs :as fs]))
  (import (quote [java.io FileNotFoundException])
          (quote [java.nio.file Files LinkOption NoSuchFileException])
          (quote [java.time Duration Instant]))
  (let [run-parent (first *command-line-args*)
        no-follow (into-array LinkOption [LinkOption/NOFOLLOW_LINKS])
        pid-of (fn [root]
                 (try
                   (let [record (io/file root "test-run.txt")]
                     (when (.isFile record)
                       (with-open [reader (io/reader record)]
                         (let [tokens (java.util.StringTokenizer.
                                       (or (.readLine reader) ""))]
                           (loop []
                             (when (.hasMoreTokens tokens)
                               (let [token (.nextToken tokens)]
                                 (if (.startsWith token "pid=")
                                   (try
                                     (Long/parseLong (.substring token 4))
                                     (catch NumberFormatException _ nil))
                                   (recur)))))))))
                   (catch FileNotFoundException _ nil)
                   (catch NoSuchFileException _ nil)))
        active-pid? (fn [pid]
                      (zero?
                       (:exit
                        (process/shell
                         {:continue true :out :string :err :string}
                         "/bin/kill" "-0" (str pid)))))
        modified-at (fn [root]
                      (try
                        (.toInstant
                         (Files/getLastModifiedTime (.toPath root) no-follow))
                        (catch NoSuchFileException _ nil)))
        ;; A directory with no readable claim stays outside sweep policy long
        ;; enough for its creating shell to return from mktemp and publish the
        ;; claim. A dead claimed pid is immediately eligible for retention.
        now (Instant/now)
        claim-cutoff (.minus now (Duration/ofSeconds 30))
        cutoff (.minus now (Duration/ofHours 24))
        candidates (->> (.listFiles (io/file run-parent))
                        (filter (fn [entry]
                                  (let [path (.toPath entry)]
                                    (and (.startsWith (.getName entry) "run.")
                                         (Files/isDirectory path no-follow)))))
                        (keep (fn [root]
                                (when-let [observed-at (modified-at root)]
                                  (let [pid (pid-of root)]
                                    (when-not (and (nil? pid)
                                                   (.isAfter observed-at
                                                             claim-cutoff))
                                      {:root root
                                       :modified-at observed-at
                                       :active? (boolean
                                                 (and pid
                                                      (active-pid? pid)))}))))))
        inactive (sort-by :modified-at #(compare %2 %1)
                          (remove :active? candidates))]
    (doseq [[rank {:keys [root modified-at]}] (map-indexed vector inactive)
            :when (or (not (.isAfter modified-at cutoff))
                      (>= rank 3))]
      (fs/delete-recursively! run-parent (.getPath root))
      (binding [*out* *err*]
        (println "bin/test: reaped retained isolated operator root"
                 (.getPath root)))))
  nil' "$run_parent"

process_start=$(ps -p "$$" -o lstart= | sed 's/^[[:space:]]*//')
suite_start=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
run_root=$(mktemp -d "$run_parent/run.XXXXXX")
printf 'pid=%s process-start=%s suite-start=%s git=%s selection=%s\n' \
  "$$" \
  "$process_start" \
  "$suite_start" \
  "$git_sha" \
  "$selection" >"$run_root/test-run.txt"

remove_run_root() {
  case "$run_root" in
    "$run_parent"/run.*)
      bb --config "$source_root/bb.edn" -e \
        '(require (quote [seon.fs :as fs]))
         (apply fs/delete-recursively! *command-line-args*)' \
        "$run_parent" "$run_root"
      ;;
    *) echo "bin/test: refusing unexpected run-root cleanup: $run_root" >&2; return 70 ;;
  esac
}

suite_pid=

reap_runner() {
  local requested_signal=$1
  local runner_pid runner_exit reap_watchdog_pid
  if [ -z "$suite_pid" ]; then
    return 0
  fi

  runner_pid=$suite_pid
  suite_pid=
  if kill -0 "$runner_pid" 2>/dev/null; then
    kill -"$requested_signal" "$runner_pid" 2>/dev/null || true
    (
      sleep "$runner_reap_backstop_seconds"
      if kill -0 "$runner_pid" 2>/dev/null; then
        echo "bin/test: RUNNER REAP BACKSTOP fired for pid=$runner_pid; forcing exit" >&2
        kill -KILL "$runner_pid" 2>/dev/null || true
      fi
    ) &
    reap_watchdog_pid=$!
  else
    reap_watchdog_pid=
  fi

  if wait "$runner_pid"; then
    runner_exit=0
  else
    runner_exit=$?
  fi
  if [ -n "$reap_watchdog_pid" ]; then
    kill "$reap_watchdog_pid" 2>/dev/null || true
    wait "$reap_watchdog_pid" 2>/dev/null || true
  fi
  printf 'runner-exit=%s runner-reaped-at=%s\n' \
    "$runner_exit" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    >>"$run_root/test-run.txt"
}

launch_runner() {
  # Test JVMs run at low priority (inherited by the coordinator's worker and
  # confirmation JVMs): the owner's cluster, editor, and shell keep the CPU
  # when a gate saturates it (owner, 2026-09-15: "faster, but don't saturate").
  nice -n 15 "$@" &
  suite_pid=$!
  printf 'runner-pid=%s runner-started-at=%s\n' \
    "$suite_pid" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    >>"$run_root/test-run.txt"
}

await_runner() {
  local runner_pid=$suite_pid runner_exit
  if wait "$runner_pid"; then
    runner_exit=0
  else
    runner_exit=$?
  fi
  printf 'runner-exit=%s runner-reaped-at=%s\n' \
    "$runner_exit" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    >>"$run_root/test-run.txt"
  suite_pid=
  return "$runner_exit"
}

retain_run_root() {
  local caught_signal=$1
  local status=$2
  trap - HUP INT TERM
  end_phase_watchdog
  reap_runner TERM
  release_test_slot
  if [ -f "${phase_bound_marker:-/nonexistent}" ]; then
    printf 'retained-reason=phase-bound-exceeded\n' >>"$run_root/test-run.txt"
    echo "bin/test: preparation bound fired; retained isolated operator root $run_root" >&2
    exit 70
  fi
  printf 'retained-reason=signal-%s\n' "$caught_signal" >>"$run_root/test-run.txt"
  if [ "$fast_iteration" -eq 1 ]; then
    echo "bin/test-fast: interrupted by $caught_signal; removing snapshot $run_root" >&2
  else
    echo "bin/test: interrupted by $caught_signal; retained isolated operator root $run_root" >&2
  fi
  exit "$status"
}

reap_runner_on_launcher_exit() {
  local status=$?
  trap - EXIT HUP INT TERM
  end_phase_watchdog
  if [ -n "$suite_pid" ]; then
    reap_runner TERM
    printf 'retained-reason=launcher-exit-%s\n' "$status" \
      >>"$run_root/test-run.txt"
  fi
  release_test_slot
  if [ "$fast_iteration" -eq 1 ]; then
    cd "$source_root"
    remove_run_root
  fi
  exit "$status"
}

trap 'retain_run_root HUP 129' HUP
trap 'retain_run_root INT 130' INT
trap 'retain_run_root TERM 143' TERM
trap reap_runner_on_launcher_exit EXIT

phase_started=$SECONDS
phase_watchdog_pid=
phase_bound_marker="$run_root/logs/phase-bound-exceeded"
current_phase=

# A bound stands in for a child that never returns. A child that RETURNS
# non-zero must be reported the instant it does, never at the bound: "waiting
# minutes to find out a problem we should know immediately is a bug" (owner,
# 2026-09-17). Every explicit refusal below calls `announce_phase_failure`
# directly; this trap covers the rest, because `set -euo pipefail` otherwise
# ends the gate with whatever the failing command happened to print and no
# phase named. It stays out of the way wherever errexit is deliberately off.
phase_failed_on_error() {
  local status=$?
  case $- in
    *e*) ;;
    *) return 0 ;;
  esac
  trap - ERR
  if [ -n "$current_phase" ]; then
    announce_phase_failure "$current_phase" \
      "a command in this phase exited $status at bin/test line ${BASH_LINENO[0]:-unknown}"
  fi
  exit "$status"
}
trap phase_failed_on_error ERR

# Where a phase's own output landed, so the one loud line tells a human and an
# orchestrator tailing a file the same thing.
phase_output_location() {
  case "$1" in
    dependency-cache-and-classpath)
      printf '%s\n' "$run_root/logs/dependency-cache-and-classpath.log" ;;
    *) printf '%s\n' "$run_root/test-run.txt" ;;
  esac
}

# A phase blocked in a foreground child does not run a pending trap until that
# child returns, so the watchdog terminates the launcher's descendants before
# signalling the launcher itself. `pgrep -P` walks recorded parentage; it never
# matches this script's own command line.
phase_bound_seconds() {
  case "$1" in
    snapshot) printf '%s\n' "$snapshot_phase_seconds" ;;
    test-slot) printf '%s\n' "$test_slot_phase_seconds" ;;
    dependency-cache-and-classpath) printf '%s\n' "$dependency_cache_phase_seconds" ;;
    worker-checkouts) printf '%s\n' "$worker_checkouts_phase_seconds" ;;
    published-base) printf '%s\n' "$published_base_phase_seconds" ;;
    coordinator-and-tests) printf '%s\n' "$coordinator_phase_seconds" ;;
    *) printf '0\n' ;;
  esac
}

begin_phase() {
  local phase=$1 bound launcher=$$ started output
  bound=$(phase_bound_seconds "$phase")
  phase_started=$SECONDS
  phase_watchdog_pid=
  current_phase=$phase
  if [ "$bound" -le 0 ]; then
    return 0
  fi
  output=$(phase_output_location "$phase")
  started=$(date +%s)
  (
    # The timer is a background child waited on, never a foreground one: `wait`
    # is interruptible by a trap, so ending this watchdog ends its timer too. A
    # foreground `sleep` outlives the subshell that is killed above it, is
    # reparented to init, and keeps the launcher's inherited stdout pipe open —
    # a reader slurping that pipe then blocks for the whole bound after the
    # gate has exited (observed as a 300 s suite-liveness kill on 2026-09-17).
    trap 'kill $timer_pid 2>/dev/null; exit 0' TERM INT HUP
    sleep "$bound" &
    timer_pid=$!
    wait "$timer_pid" || exit 0
    # This machine's /usr/bin/env bash is 3.2, which has no BASHPID. A
    # command substitution that `exec`s its command makes that child's PPID
    # this subshell's own pid, which is the portable equivalent and needs no
    # file, no publication, and no race with the launcher.
    watchdog=$(exec sh -c 'echo $PPID')
    printf 'bin/test: PHASE %s EXCEEDED ITS BOUND: elapsed-seconds=%s bound-seconds=%s output=%s\n' \
      "$phase" "$(( $(date +%s) - started ))" "$bound" "$output" >&2
    printf 'phase=%s exceeded-bound-seconds=%s\n' "$phase" "$bound" \
      >>"$run_root/test-run.txt" 2>/dev/null || true
    mkdir -p "$(dirname "$phase_bound_marker")" 2>/dev/null || true
    printf '%s\n' "$phase" >"$phase_bound_marker" 2>/dev/null || true
    # A phase blocked in a foreground child does not run a pending trap until
    # that child returns, so the launcher's descendants go first and the
    # launcher itself last. `pgrep -P` walks recorded parentage; it never
    # matches this script's own command line.
    terminate_descendants() {
      local parent=$1 child
      for child in $(pgrep -P "$parent" 2>/dev/null || true); do
        if [ "$child" = "$watchdog" ]; then
          continue
        fi
        terminate_descendants "$child"
        kill -TERM "$child" 2>/dev/null || true
      done
    }
    terminate_descendants "$launcher"
    kill -TERM "$launcher" 2>/dev/null || true
  ) &
  phase_watchdog_pid=$!
}

end_phase_watchdog() {
  if [ -n "$phase_watchdog_pid" ]; then
    kill "$phase_watchdog_pid" 2>/dev/null || true
    wait "$phase_watchdog_pid" 2>/dev/null || true
    phase_watchdog_pid=
  fi
}

record_phase() {
  local phase=$1
  local elapsed=$((SECONDS - phase_started))
  end_phase_watchdog
  current_phase=
  printf 'bin/test: PHASE %s elapsed-seconds=%s\n' "$phase" "$elapsed"
  printf 'phase=%s elapsed-seconds=%s\n' "$phase" "$elapsed" >>"$run_root/test-run.txt"
  phase_started=$SECONDS
}

# A phase that refuses names itself to the caller's stderr, not only to its log:
# an hour of gate-wide refusals was invisible because the child's first line was
# written into a file nobody was reading.
announce_phase_failure() {
  local phase=$1 detail=$2 line printed=0
  while IFS= read -r line; do
    case "$line" in
      ''|[[:space:]]*'') continue ;;
    esac
    printf 'bin/test: PHASE %s FAILED: %s\n' "$phase" "$line" >&2
    printed=$((printed + 1))
    if [ "$printed" -ge 5 ]; then
      break
    fi
  done <<<"$detail"
  if [ "$printed" -eq 0 ]; then
    printf 'bin/test: PHASE %s FAILED\n' "$phase" >&2
  fi
  printf 'bin/test: PHASE %s output: %s\n' "$phase" "$(phase_output_location "$phase")" >&2
  printf 'phase=%s failed=true\n' "$phase" >>"$run_root/test-run.txt" 2>/dev/null || true
}

populate_checkout_root() {
  local target_root=$1 entry entries
  local -a sources=()
  mkdir -p "$target_root/data" "$target_root/logs" \
    "$target_root/target" "$target_root/tmp"
  entries=$({
    git -C "$source_root" ls-files
    if [ ${#overlay_paths[@]} -gt 0 ]; then
      printf '%s\n' "${overlay_paths[@]}"
    fi
  } | awk -F/ 'NF {print $1}' | sort -u)
  while IFS= read -r entry; do
    if [ ! -e "$source_root/$entry" ] && [ ! -L "$source_root/$entry" ]; then
      continue
    fi
    case "$entry" in
      data|logs|target|tmp|workers) ;;
      reference-code) ln -s "$source_root/$entry" "$target_root/$entry" ;;
      *) sources+=("$source_root/$entry") ;;
    esac
  done <<< "$entries"
  if [ ${#sources[@]} -gt 0 ]; then
    case "$(uname -s)" in
      Darwin) cp -cRP "${sources[@]}" "$target_root/" ;;
      Linux) cp -a --reflink=auto "${sources[@]}" "$target_root/" ;;
      *) cp -pRP "${sources[@]}" "$target_root/" ;;
    esac
  fi

  ln -s "$source_root/.git" "$target_root/.git"
  if [ -e "$source_root/.env" ]; then
    ln -s "$source_root/.env" "$target_root/.env"
  fi
}

begin_phase snapshot

# One snapshot mechanism: HEAD plus the selected working bytes. Without
# --paths, overlay every tracked change and every non-ignored new file.
git archive "$git_sha" | tar -x -C "$run_root"
rm -rf "$run_root/reference-code"
ln -s "$source_root/reference-code" "$run_root/reference-code"
overlay_paths=()
if [ ${#snapshot_paths[@]} -gt 0 ]; then
  overlay_paths=("${snapshot_paths[@]}")
else
  git diff --no-renames --name-only -z "$git_sha" -- . ':!reference-code' >"$run_root/.snapshot-paths"
  git ls-files --others --exclude-standard -z -- . ':!workers' >>"$run_root/.snapshot-paths"
  while IFS= read -r -d '' entry; do
    overlay_paths+=("$entry")
  done <"$run_root/.snapshot-paths"
  rm "$run_root/.snapshot-paths"
fi
if [ ${#overlay_paths[@]} -gt 0 ]; then
  for entry in "${overlay_paths[@]}"; do
    parent=$(dirname "$entry")
    while [ "$parent" != . ]; do
      if [ -L "$run_root/$parent" ]; then
        echo "bin/test: overlay parent is a symlink: $entry" >&2
        exit 64
      fi
      parent=$(dirname "$parent")
    done
    rm -rf "$run_root/$entry"
    if [ -e "$source_root/$entry" ] || [ -L "$source_root/$entry" ]; then
      mkdir -p "$run_root/$(dirname "$entry")"
      cp -Pp "$source_root/$entry" "$run_root/$entry"
    fi
  done
fi
ln -s "$source_root/.git" "$run_root/.git"
if [ -e "$source_root/.env" ] && [ ! -e "$run_root/.env" ]; then
  ln -s "$source_root/.env" "$run_root/.env"
fi
mkdir -p "$run_root/data" "$run_root/logs" "$run_root/target" "$run_root/tmp"

# Compare the bytes actually copied, including untracked files, against HEAD.
echo "bin/test: snapshot differences from HEAD $git_sha:"
git -C "$source_root" --work-tree="$run_root" diff --name-status "$git_sha" -- \
  . ':!reference-code' | while IFS= read -r entry; do
    printf 'bin/test:   %s\n' "$entry"
  done
git -C "$source_root" --work-tree="$run_root" ls-files --others --exclude-standard -- \
  . ':!data' ':!logs' ':!target' ':!tmp' ':!workers' ':!reference-code' ':!test-run.txt' | while IFS= read -r entry; do
    printf 'bin/test:   A %s\n' "$entry"
  done
echo "bin/test: end snapshot differences"
record_phase snapshot

begin_phase test-slot
if ! acquire_test_slot; then
  announce_phase_failure test-slot "no test JVM slot free within its declared wait"
  exit 75
fi
record_phase test-slot

# test-fast shares this exact snapshot and child lifecycle, but stops before
# dependency-cache preparation, worker copies, and base publication.
if [ "$fast_iteration" -eq 1 ]; then
  echo "bin/test-fast: selected snapshot $run_root"
  cd "$run_root"
  launch_runner clojure -M:test -m seon.test.fast ${namespaces[@]+"${namespaces[@]}"}
  if await_runner; then status=0; else status=$?; fi
  exit "$status"
fi

# The dependency preparation and all workers consume this same snapshot.
begin_phase dependency-cache-and-classpath
rmdir "$run_root/target"
mkdir -p "$source_root/target"
ln -s "$source_root/target" "$run_root/target"
cd "$run_root"
mkdir -p "$run_root/logs"
dependency_cache_log=$(phase_output_location dependency-cache-and-classpath)
if ! dev_cache_output=$(clojure -T:dev-cache ensure-cache :test? true :pid "$$" 2>&1); then
  printf '%s\n' "$dev_cache_output" >"$dependency_cache_log"
  announce_phase_failure dependency-cache-and-classpath "$dev_cache_output"
  exit 1
fi
printf '%s\n' "$dev_cache_output" >"$dependency_cache_log"
printf '%s\n' "$dev_cache_output"
dev_cache_result=$(printf '%s\n' "$dev_cache_output" | tail -n 1)
if ! dev_cache_digest=$(bb -e \
  '(require (quote [clojure.edn :as edn]))
   (print (:seon.dev-cache/digest
           (edn/read-string (first *command-line-args*))))' \
  "$dev_cache_result") ||
   ! dev_cache_path=$(bb -e \
  '(require (quote [clojure.edn :as edn]))
   (print (:seon.dev-cache/path
           (edn/read-string (first *command-line-args*))))' \
  "$dev_cache_result"); then
  announce_phase_failure dependency-cache-and-classpath \
    "the dependency cache returned no readable selection: $dev_cache_result"
  exit 1
fi
if ! [[ "$dev_cache_digest" =~ ^[0-9a-f]{64}$ ]] ||
   [ ! -d "$dev_cache_path" ] ||
   [ "${dev_cache_path##*/}" != "$dev_cache_digest" ]; then
  announce_phase_failure dependency-cache-and-classpath \
    "dependency cache digest mismatch: digest=$dev_cache_digest path=$dev_cache_path"
  exit 1
fi

test_classpath_file=$(bb -e '
  (require (quote [clojure.edn :as edn]))
  (print (or (:seon.dev-cache/test-classpath-file
              (edn/read-string (first *command-line-args*))) ""))' "$dev_cache_result")
snapshot_digest=
if [ -n "$test_classpath_file" ]; then
  test_classpath=$(bb -e '(require (quote [clojure.edn :as edn]))
    (print (edn/read-string (slurp (first *command-line-args*))))' "$test_classpath_file")
  snapshot_digest=$(bb -e '
    (require (quote [clojure.edn :as edn]))
    (print (:seon.dev-cache/test-digest (edn/read-string (first *command-line-args*))))' "$dev_cache_result")
  if [ -z "$test_classpath" ] || [ ${#snapshot_digest} -ne 64 ]; then
    announce_phase_failure dependency-cache-and-classpath \
      "the test cache returned no classpath or snapshot digest"
    exit 1
  fi
else
  # A --paths snapshot can predate this launcher's cache protocol. Its own
  # runner and dependency producer remain authoritative for that invocation.
  echo "bin/test: snapshot predates cached classpaths; using its test classpath"
  test_classpath=$(clojure -Spath -M:test)
fi
printf 'snapshot-digest=%s\n' "$snapshot_digest" >>"$run_root/test-run.txt"

printf 'dev-cache-digest=%s\n' "$dev_cache_digest" >>"$run_root/test-run.txt"
populate_cache_links() {
  local checkout=$1 cache_name
  if [ -n "$snapshot_digest" ]; then
    # Nested gates use the same cache authority, not a cache directory
    # accidentally nested inside an immutable selected classes directory.
    for cache_name in dev-dependency-classes dev-dependency-cache-processes test-classpaths test-published-bases; do
      mkdir -p "$source_root/target/$cache_name"
      ln -s "$source_root/target/$cache_name" "$checkout/target/$cache_name"
    done
    ln -s "$source_root/target/dev-dependency-cache.lock" \
      "$checkout/target/dev-dependency-cache.lock"
  else
    ln -s "$dev_cache_path" "$checkout/target/dev-dependency-classes"
  fi
}
rm "$run_root/target"
mkdir "$run_root/target"
populate_cache_links "$run_root"
# A bare gate names no namespace: the coordinator derives its membership from
# the published program manifest (`:seon.ns/name` rows under the declared test
# source root, minus namespaces declaring `:seon.test/fixture`). The filename
# munge that stood here missed macro-generated test namespaces and would have
# admitted the deliberate-failure fixtures; both are facts now, not suffixes.
cd "$source_root"

if [ "$explicit_selection" -eq 1 ] && [ ${#namespaces[@]} -eq 0 ]; then
  announce_phase_failure dependency-cache-and-classpath "no test namespaces selected"
  exit 1
fi

record_phase dependency-cache-and-classpath

begin_phase worker-checkouts
logical_processors=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
if ! [[ "$logical_processors" =~ ^[1-9][0-9]*$ ]]; then
  logical_processors=2
fi
worker_count=$((logical_processors / 2))
# Never more than three worker JVMs per gate: each loads the whole program
# (about a gigabyte, 100%+ CPU while running), the confirmation phase reruns
# failures in fresh JVMs up to this same count in parallel, and the owner's
# cluster shares the machine (2026-09-15: one gate at cores/2 reached load
# average 75 on 18 cores). Set SEON_TEST_WORKERS to override deliberately.
if [ "$worker_count" -gt 3 ]; then
  worker_count=3
fi
if [ "$worker_count" -lt 1 ]; then
  worker_count=1
fi
# A pool no larger than the selection: an explicit one-namespace gate boots
# one worker, not half the machine. Several lanes gate at once (2026-09-08:
# five lanes, 45 JVMs); the pool is sized to the work, never to the host.
if [ "$explicit_selection" -eq 1 ] && [ ${#namespaces[@]} -lt "$worker_count" ]; then
  worker_count=${#namespaces[@]}
fi
if [ -n "${SEON_TEST_WORKERS-}" ] && [[ "$SEON_TEST_WORKERS" =~ ^[1-9][0-9]*$ ]]; then
  worker_count=$SEON_TEST_WORKERS
fi
original_source_root=$source_root
source_root=$run_root
worker_parent="$run_root/workers"
mkdir -p "$worker_parent"
for worker_number in $(seq 1 "$worker_count"); do
  populate_checkout_root "$worker_parent/pool-$worker_number"
done
source_root=$original_source_root
for worker_root in "$worker_parent/"*; do
  populate_cache_links "$worker_root"
done
if [ -n "$snapshot_digest" ]; then
  shared_published_base="$source_root/target/test-published-bases/$snapshot_digest/base"
else
  shared_published_base="$run_root/shared-published-base"
fi
record_phase worker-checkouts

if [ -z "$result_root" ]; then
  result_root="$run_root/data/clusters"
elif [[ "$result_root" != /* ]]; then
  result_root="$source_root/$result_root"
fi
coordinator_operator_root=$run_root
if [ -n "$result_cluster" ]; then
  coordinator_operator_root=${result_root%/}
  case "$coordinator_operator_root" in
    */data/clusters) coordinator_operator_root=${coordinator_operator_root%/data/clusters} ;;
  esac
fi

echo "bin/test: isolated operator root $run_root pid=$$ selection=$selection"
cd "$run_root"
set +e
changed_paths_file="$run_root/changed-paths.txt"
if [ ${#changed_paths[@]} -gt 0 ]; then
  printf '%s\n' "${changed_paths[@]}" >"$changed_paths_file"
else
  : >"$changed_paths_file"
fi

begin_phase published-base
echo "bin/test: preparing or reusing published test base $snapshot_digest"
if [ -n "$snapshot_digest" ]; then
  launch_runner bb --config "$run_root/bb.edn" -m seon.test.cache \
    "$source_root" "$run_root" "$snapshot_digest" "$test_classpath" "$$"
else
  launch_runner clojure -Scp "$test_classpath" \
    "-J-Dseon.operator.root=$shared_published_base" \
    "-J-Dseon.test.root=$run_root" \
    "-J-Dseon.test.source-root=$source_root" \
    -M:test -m seon.test.runner --prepare-base "$shared_published_base"
fi
if await_runner; then
  base_status=0
else
  base_status=$?
fi
if [ "$base_status" -ne 0 ]; then
  status=$base_status
  cd "$source_root"
  announce_phase_failure published-base \
    "the shared published base child exited $base_status; retained isolated operator root $run_root"
  exit "$status"
fi

record_phase published-base

begin_phase coordinator-and-tests
coordinator_jvm_arguments=(
  "-J-Dseon.test.confirm=$confirm_symbols"
  "-J-Dseon.operator.root=$coordinator_operator_root"
  "-J-Dseon.test.root=$run_root"
  "-J-Dseon.test.source-root=$source_root"
  "-J-Dseon.test.changed-paths-file=$changed_paths_file"
  "-J-Dseon.test.worker-parent=$worker_parent"
  "-J-Dseon.test.worker-count=$worker_count"
  "-J-Dseon.test.published-base=$shared_published_base"
)
if [ -n "$persistent_results_root" ]; then
  coordinator_jvm_arguments+=(
    "-J-Dseon.test.persistent-results-root=$persistent_results_root"
  )
fi

launch_runner clojure -Scp "$test_classpath" \
  "${coordinator_jvm_arguments[@]}" \
  -M:test -m seon.test.runner \
  "${result_cluster:--}" "$result_root" "$git_sha" "$selection_mode" \
  ${namespaces[@]+"${namespaces[@]}"}
if await_runner; then
  status=0
else
  status=$?
fi
set -e
record_phase coordinator-and-tests
cd "$source_root"

if [ "$status" -eq 0 ]; then
  remove_run_root
  echo "bin/test: removed successful isolated operator root $run_root"
else
  echo "bin/test: retained failed isolated operator root $run_root" >&2
fi

release_test_slot
trap - EXIT HUP INT TERM
exit "$status"
