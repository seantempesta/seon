#!/usr/bin/env bash
# bin/test — CLI test runner (cold JVM, use REPL for fast iteration)
#
# Usage:
#   bin/test seon.graph.query-test        # Focused: one namespace
#   bin/test seon.graph.query-test seon.db-test  # Focused: multiple
#   bin/test --unit                       # All unit tests (~2min cold JVM)
#   bin/test --all                        # All tests including integration
#
# Exit codes: 0 = pass, 1 = fail

set -uo pipefail
cd "$(dirname "$0")/.."

MODE=""
FOCUS_NS=()

for arg in "$@"; do
  case "$arg" in
    --unit) MODE="unit" ;;
    --all)  MODE="all" ;;
    --help|-h)
      echo "Usage: bin/test [--unit|--all] [namespace ...]"
      echo ""
      echo "  bin/test seon.graph.query-test  Focused namespace(s)"
      echo "  bin/test --unit                 All unit tests (~2min, cold JVM)"
      echo "  bin/test --all                  All tests including integration"
      exit 0
      ;;
    *) FOCUS_NS+=("$arg") ;;
  esac
done

# No args = guide to REPL instead of burning 2min on a cold JVM
if [ -z "$MODE" ] && [ ${#FOCUS_NS[@]} -eq 0 ]; then
  cat <<'EOF'
bin/test launches a cold JVM (~2min). The REPL is already warm:

  (user/run-tests 'seon.foo-test)   ; one namespace, seconds
  (user/run-tests)                  ; full suite, warm JVM
  (:failures *1)                    ; inspect without re-running

Results auto-save. See AGENT.md § "Test via REPL".
To run the full CLI suite anyway:  bin/test --unit
EOF
  exit 1
fi

# Build kaocha args
KAOCHA_ARGS=()

if [ ${#FOCUS_NS[@]} -gt 0 ]; then
  for ns in "${FOCUS_NS[@]}"; do
    KAOCHA_ARGS+=(--focus "$ns")
  done
  KAOCHA_ARGS+=(unit)
elif [ "$MODE" = "all" ]; then
  :
else
  KAOCHA_ARGS+=(unit)
fi

# Run kaocha, capture output to persistent log (concurrent-safe)
mkdir -p tmp
TMPOUT="tmp/test-$(date +%Y%m%d-%H%M%S)-$$.log"

START=$(date +%s)

clojure -M:simd:fork-deps:test -m kaocha.runner \
  --reporter kaocha.report/dots \
  --no-capture-output \
  "${KAOCHA_ARGS[@]}" 2>&1 | tee "$TMPOUT"

EXIT_CODE=${PIPESTATUS[0]}
END=$(date +%s)
ELAPSED=$((END - START))

echo ""
echo "========================================"
if [ $EXIT_CODE -eq 0 ]; then
  echo "PASS (${ELAPSED}s)"
else
  echo "FAIL (${ELAPSED}s)"
  echo ""
  echo "Failing tests:"
  grep -E "^(FAIL|ERROR) in" "$TMPOUT" || true
  echo ""
  grep -A 5 -E "^(FAIL|ERROR) in" "$TMPOUT" | grep -v "^--$" || true
fi
echo "========================================"

ln -sf "$(basename "$TMPOUT")" tmp/test-latest.log
echo "Full output: $TMPOUT (or tmp/test-latest.log)"

if [ $ELAPSED -gt 30 ]; then
  echo "Took ${ELAPSED}s. REPL runs the same tests in seconds: (user/run-tests 'seon.foo-test)"
fi

exit $EXIT_CODE
