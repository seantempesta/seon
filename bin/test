#!/bin/zsh
# bin/test [--all] [NS ...] — test/'s deftests (every *_test namespace, or the ones named) with
# no green result at their reach digest, the rest reused from the results directory every
# checkout shares (bin/prove's tests; seon.proofs/plan). --all runs every one, green or not (the
# full run). The selected tests are dealt, a namespace at a time, into :seon.config.proofs/jobs
# shards, each run at once in a process of its own (logs and shard files in target/prove/);
# each result is stored at its digest. Ends on TEST OK / TEST FAILED and its exit status.
# bin/test --plan|--shard|--store-steps ... are test/test_runner.clj's parts (bin/prove's).
# On the runtime bin/build made (target/jolt/jolt), with dependencies cached in target/home.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
JOLT=$ROOT/target/jolt/jolt
[[ -x $JOLT ]] || { echo "test: no target/jolt/jolt; run bin/build jolt first" >&2; exit 1 }
. "$ROOT/bin/env"
cd "$ROOT"
# a root a test boots listens on no dashboard port
export SEON_WEB_PORT=${SEON_WEB_PORT:-0}
runner() { HOME=$ROOT/target/home JOLT_PWD=$ROOT "$JOLT" -A:test run -m test-runner "$@" }
case ${1:-} in
  --plan|--shard|--store-steps) runner "$@"; exit $? ;;
  --prove) WHAT=$2 OUT=$3; shift 3 ;;
  *) WHAT=tests OUT=$ROOT/target/prove/tests ;;
esac
runner --plan $WHAT "$OUT" "$@" || { echo "TEST FAILED (the plan)"; exit 1 }
st=0 P=() F=($OUT/shard-*.edn(N))
for f in $F; do runner --shard "$f" > "${f%.edn}.log" 2>&1 & P+=($!); done
for i in {1..${#F}}; do
  f=$F[$i] log=${F[$i]%.edn}.log
  wait $P[$i]; s=$?
  grep -E "^RED|^SHARD" "$log"
  if (( s != 0 )); then
    st=1
    grep -q "^SHARD" "$log" || echo "FAILED shard $f: exit $s, $(grep '^started' "$log" | tail -1) ($log)"
  fi
done
if (( st == 0 )); then echo "TEST OK"; else echo "TEST FAILED (logs: $OUT)"; fi
exit $st
