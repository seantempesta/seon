#!/usr/bin/env bash
# One test request, always seon.test/run (src/seon/test.clj), never a worker pool.
#
#   bin/test [CLUSTER] [bin/test-check options...]
#       The ordinary tier: one request on the running cluster over its prepl
#       (default cluster `default`); no JVM starts. Options are bin/test-check's:
#       --test NS/TEST, --ns NS, --changed NS/SYM, --policy P, --include-long,
#       --time-limit-ms N. Each member runs on its own branch of the cluster.
#   bin/test --platform
#       The isolated host: boot the checkout under a fresh operator root
#       (tmp/test-runs/platform-*), run the declared platform rows, the members
#       reaching a :seon.fn/destroys owner and the file-backed fixtures there as
#       ONE request, then stop that JVM. The root is deleted when green and kept
#       as evidence when red. Exit status is the request's :seon.test/passed?.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1-}" != --platform ]; then
  exec bin/test-check "$@"
fi
shift
if [ "$#" -ne 0 ]; then
  echo "Usage: bin/test --platform" >&2
  exit 64
fi

root="tmp/test-runs/platform-$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir -p "$root"
root=$(cd "$root" && pwd -P)
stop_host() {
  bin/seon --root "$root" down >/dev/null 2>&1 || true
}
trap stop_host EXIT HUP INT TERM

started=$(date +%s)
echo "bin/test --platform: booting the isolated host under $root" >&2
if ! bin/seon --root "$root" reset --force >"$root/boot.log" 2>&1; then
  echo "bin/test --platform: the isolated host did not boot; evidence kept in $root/boot.log" >&2
  tail -n 20 "$root/boot.log" >&2
  exit 1
fi
booted=$(date +%s)
echo "bin/test --platform: host ready in $((booted - started)) s" >&2

status=0
bin/test-check --root "$root" default --isolated --include-long || status=$?
finished=$(date +%s)
echo "bin/test --platform: request $((finished - booted)) s; total $((finished - started)) s" >&2

stop_host
trap - EXIT HUP INT TERM
if [ "$status" -eq 0 ]; then
  # A root holds data only; rm never follows a symlink it deletes.
  rm -rf -- "$root"
else
  echo "bin/test --platform: red; evidence kept in $root" >&2
fi
exit "$status"
