#!/bin/sh
# bin/test [NS ...] — runs test/'s deftests (every *_test namespace, or the ones named)
# on the runtime bin/build made (target/jolt/jolt), with dependencies cached in target/home.
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
"$ROOT/bin/ports" --write   # the port keys under their current names (bin/ports)
JOLT=$ROOT/target/jolt/jolt
[ -x "$JOLT" ] || { echo "test: no target/jolt/jolt; run bin/build jolt first" >&2; exit 1; }
. "$ROOT/bin/env"
cd "$ROOT"
# a root a test boots listens on no dashboard port
SEON_WEB_PORT=${SEON_WEB_PORT:-0}; export SEON_WEB_PORT
# agents' turns are the scripted provider's (a test fixture; a root with no profile has no model provider)
SEON_PROFILE=${SEON_PROFILE:-scripted}; export SEON_PROFILE
HOME=$ROOT/target/home JOLT_PWD=$ROOT exec "$JOLT" -A:test run -m test-runner "$@"
