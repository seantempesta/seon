#!/usr/bin/env bash
# The system test gate. Tiered, à la carte, with smart defaults.
#
#   bin/test                        # platform tier, then tests reaching
#                                   #   code changed since the last GREEN basis
#   bin/test --all                  # platform tier, then every non-long test
#   bin/test --full                 # platform tier, then every test
#   bin/test --platform             # the moving-part regressions alone
#   bin/test --changed PATH [...]   # platform tier, then tests reaching PATHs
#   bin/test seon.cluster.run-test  # run exactly these namespaces, every test
#   bin/test --result-cluster scratch [namespaces...]
#
# Every tiered invocation runs the declared `:seon.test/platform` moving-part
# regressions FIRST and stops there when they are red: a broken platform fails
# in seconds instead of poisoning the bulk. The bare default then runs only the
# tests that reach changed code, derived from `:seon.fn/calls` edges in the one
# program-graph manifest — never a file modification time or a filename
# convention. The green basis is a recorded artifact under
# `tmp/test-basis/green-basis.edn`; a green tiered run rewrites it.
#
# Each invocation owns one isolated operator root below `tmp/test-runs`, copies
# the first-party checkout into it, and deletes it on success. Exit code is the
# suite verdict. Result facts are opt-in only and refuse the owner's `default`
# cluster.

set -euo pipefail

# Bash may continue reading an executing script from disk. A 36-minute gate
# proved that an in-place edit can therefore splice new bytes into the old
# invocation after its JVM exits. Re-exec one complete in-memory command string
# so this invocation's operator-root lifecycle is frozen with its launch bytes.
if [ "${SEON_TEST_SCRIPT_SNAPSHOT-}" != "1" ]; then
  export SEON_TEST_SCRIPT_SNAPSHOT=1
  exec /bin/bash -c "$(command cat -- "$0")" "$0" "$@"
fi
unset SEON_TEST_SCRIPT_SNAPSHOT

cd "$(dirname "$0")/.."
source_root=$PWD

source bin/_java-home-resolver

usage() {
  cat <<'USAGE'
Usage: bin/test [--all|--full|--platform|--changed PATH]...
                [--result-cluster NAME] [--result-root PATH] [namespaces...]

  (bare)          platform tier, then the tests reaching code changed since
                  the last recorded green basis
  --all           platform tier, then every non-long test
  --full          platform tier, then every test (SEON_TEST_FULL=1 too)
  --platform      the declared moving-part regressions alone
  --changed PATH  platform tier, then the tests reaching PATH (repeatable)

An explicit namespace selection always runs every test in those namespaces
and records no green basis.
USAGE
}

if [ ! -L seon-skills ] || [ ! -L .claude/skills ]; then
  echo "bin/test: skill paths must be links to the one .agents/skills tree" >&2
  echo "bin/test: restore the tracked links; edit skills only under .agents/skills" >&2
  exit 1
fi

skills_root=$(cd .agents/skills && pwd -P)
runtime_skills_root=$(cd seon-skills && pwd -P)
claude_skills_root=$(cd .claude/skills && pwd -P)
if [ "$skills_root" != "$runtime_skills_root" ] ||
   [ "$skills_root" != "$claude_skills_root" ]; then
  echo "bin/test: skill paths resolve to different directories" >&2
  echo "bin/test: .agents/skills, seon-skills, and .claude/skills must share one tree" >&2
  exit 1
fi

result_cluster=${SEON_TEST_RESULT_CLUSTER:-}
result_root=${SEON_TEST_RESULT_ROOT:-}
requested_mode=
explicit_selection=0
namespaces=()
changed_paths=()

set_mode() {
  if [ -n "$requested_mode" ] && [ "$requested_mode" != "$1" ]; then
    echo "bin/test: --$requested_mode and --$1 select different tiers" >&2
    exit 64
  fi
  requested_mode=$1
}

case "${SEON_TEST_FULL:-0}" in
  0) ;;
  1) set_mode full ;;
  *)
    echo "bin/test: SEON_TEST_FULL must be 0 or 1" >&2
    exit 64
    ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --full)
      set_mode full
      shift
      ;;
    --all)
      set_mode all
      shift
      ;;
    --platform)
      set_mode platform
      shift
      ;;
    --changed)
      if [ $# -lt 2 ]; then
        echo "bin/test: --changed requires a repository-relative path" >&2
        exit 2
      fi
      set_mode changed
      changed_paths+=("$2")
      shift 2
      ;;
    --result-cluster)
      if [ $# -lt 2 ]; then
        echo "bin/test: --result-cluster requires a name" >&2
        exit 2
      fi
      result_cluster=$2
      shift 2
      ;;
    --result-root)
      if [ $# -lt 2 ]; then
        echo "bin/test: --result-root requires a path" >&2
        exit 2
      fi
      result_root=$2
      shift 2
      ;;
    --)
      shift
      namespaces+=("$@")
      if [ $# -gt 0 ]; then
        explicit_selection=1
      fi
      break
      ;;
    --*)
      echo "bin/test: unknown option: $1" >&2
      usage >&2
      exit 64
      ;;
    *)
      namespaces+=("$1")
      explicit_selection=1
      shift
      ;;
  esac
done

if [ ${#namespaces[@]} -gt 0 ]; then
  :
else
  while IFS= read -r file; do
    ns=${file#test/}
    ns=${ns%.clj}
    ns=${ns%.cljc}
    ns=${ns//\//.}
    ns=${ns//_/-}
    namespaces+=("$ns")
  done < <(find test -type f \( -name '*_test.clj' -o -name '*_test.cljc' \) | sort)
fi

if [ "$explicit_selection" -eq 1 ]; then
  if [ -n "$requested_mode" ]; then
    echo "bin/test: an explicit namespace selection takes no tier flag" >&2
    exit 64
  fi
  selection_mode=explicit
  selection="${namespaces[*]}"
else
  selection_mode=${requested_mode:-changed}
  case "$selection_mode" in
    changed)
      if [ ${#changed_paths[@]} -gt 0 ]; then
        selection="changed tier (${#changed_paths[@]} named path(s))"
      else
        selection="changed tier (since the green basis)"
      fi
      ;;
    all) selection="platform tier plus every non-long test" ;;
    full) selection="full suite" ;;
    platform) selection="platform tier" ;;
  esac
fi

if [ ${#namespaces[@]} -eq 0 ]; then
  echo "bin/test: no test namespaces found under test/" >&2
  exit 1
fi

if [ "$result_cluster" = "default" ]; then
  echo "bin/test: refusing to write result facts into the default cluster" >&2
  exit 2
fi

git_sha=$(git rev-parse HEAD)

# A suite is a complete isolated operator root and working directory. Fresh
# first-party roots are copy-on-write clones so canonical-path analysis sees a
# real checkout, not paths escaping through symlinks. Large dependencies and
# documentation are projected read-only in practice; every relative mutable
# root is private to this invocation. Only the separate :dev-cache alias writes
# the shared dependency class cache.
run_parent=${SEON_TEST_RUN_PARENT:-$source_root/tmp/test-runs}
mkdir -p "$run_parent"
run_parent=$(cd "$run_parent" && pwd -P)

# Retain every live invocation plus the three newest inactive roots younger
# than 24 hours. Reap anything older, and bound recent failed/interrupted
# evidence to three roots. seon.fs owns the no-follow deletion walk: a symlink
# inside a run root is deleted as a leaf and its referent is never traversed.
bb --config "$source_root/bb.edn" -e '
  (require (quote [clojure.java.io :as io])
           (quote [babashka.process :as process])
           (quote [seon.fs :as fs]))
  (import (quote [java.nio.file Files LinkOption])
          (quote [java.time Duration Instant]))
  (let [run-parent (first *command-line-args*)
        no-follow (into-array LinkOption [LinkOption/NOFOLLOW_LINKS])
        pid-of (fn [root]
                 (let [record (io/file root "test-run.txt")]
                   (when (.isFile record)
                     (with-open [reader (io/reader record)]
                       (let [tokens (java.util.StringTokenizer.
                                     (or (.readLine reader) ""))]
                         (loop []
                           (when (.hasMoreTokens tokens)
                             (let [token (.nextToken tokens)]
                               (if (.startsWith token "pid=")
                                 (try
                                   (Long/parseLong (.substring token 4))
                                   (catch NumberFormatException _ nil))
                                 (recur))))))))))
        active? (fn [root]
                  (when-let [pid (pid-of root)]
                    (zero?
                     (:exit
                      (process/shell
                       {:continue true :out :string :err :string}
                       "/bin/kill" "-0" (str pid))))))
        modified-at (fn [root]
                      (.toInstant
                       (Files/getLastModifiedTime (.toPath root) no-follow)))
        cutoff (.minus (Instant/now) (Duration/ofHours 24))
        candidates (->> (.listFiles (io/file run-parent))
                        (filter (fn [entry]
                                  (let [path (.toPath entry)]
                                    (and (.startsWith (.getName entry) "run.")
                                         (Files/isDirectory path no-follow)))))
                        (map (fn [root]
                               {:root root
                                :modified-at (modified-at root)
                                :active? (boolean (active? root))})))
        inactive (sort-by :modified-at #(compare %2 %1)
                          (remove :active? candidates))]
    (doseq [[rank {:keys [root modified-at]}] (map-indexed vector inactive)
            :when (or (not (.isAfter modified-at cutoff))
                      (>= rank 3))]
      (fs/delete-recursively! run-parent (.getPath root))
      (binding [*out* *err*]
        (println "bin/test: reaped retained isolated operator root"
                 (.getPath root)))))
  nil' "$run_parent"

run_root=$(mktemp -d "$run_parent/run.XXXXXX")

populate_checkout_root() {
  local target_root=$1 entry
  mkdir -p "$target_root/data" "$target_root/logs" \
    "$target_root/target" "$target_root/tmp"
  while IFS= read -r entry; do
    case "$entry" in
      data|logs|target|tmp) ;;
      .clj-kondo|bin|config|resources|script|src|test)
        case "$(uname -s)" in
          Darwin) cp -cR "$source_root/$entry" "$target_root/$entry" ;;
          Linux) cp -a --reflink=auto "$source_root/$entry" "$target_root/$entry" ;;
          *) cp -pR "$source_root/$entry" "$target_root/$entry" ;;
        esac
        ;;
      *) ln -s "$source_root/$entry" "$target_root/$entry" ;;
    esac
  done < <(git -C "$source_root" ls-files | awk -F/ '{print $1}' | sort -u)

  ln -s "$source_root/.git" "$target_root/.git"
  if [ -e "$source_root/.env" ]; then
    ln -s "$source_root/.env" "$target_root/.env"
  fi
  if [ -d "$source_root/target/dev-dependency-classes" ]; then
    ln -s "$source_root/target/dev-dependency-classes" \
      "$target_root/target/dev-dependency-classes"
  fi
}

populate_checkout_root "$run_root"

logical_processors=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
if ! [[ "$logical_processors" =~ ^[1-9][0-9]*$ ]]; then
  logical_processors=2
fi
worker_count=$((logical_processors / 2))
if [ "$worker_count" -lt 1 ]; then
  worker_count=1
fi
worker_parent="$run_root/workers"
mkdir -p "$worker_parent"
for worker_number in $(seq 1 "$worker_count"); do
  populate_checkout_root "$worker_parent/pool-$worker_number"
done
populate_checkout_root "$worker_parent/serial"
populate_checkout_root "$worker_parent/confirmation"
shared_published_base="$run_root/shared-published-base"

if [ -z "$result_root" ]; then
  result_root="$run_root/data/clusters"
fi

printf 'pid=%s process-start=%s suite-start=%s git=%s selection=%s\n' \
  "$$" \
  "$(ps -p "$$" -o lstart= | sed 's/^[[:space:]]*//')" \
  "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
  "$git_sha" \
  "$selection" >"$run_root/test-run.txt"

suite_pid=
runner_reap_backstop_seconds=10

reap_runner() {
  local requested_signal=$1
  local runner_pid runner_exit reap_watchdog_pid
  if [ -z "$suite_pid" ]; then
    return 0
  fi

  runner_pid=$suite_pid
  suite_pid=
  if kill -0 "$runner_pid" 2>/dev/null; then
    kill -"$requested_signal" "$runner_pid" 2>/dev/null || true
    (
      sleep "$runner_reap_backstop_seconds"
      if kill -0 "$runner_pid" 2>/dev/null; then
        echo "bin/test: RUNNER REAP BACKSTOP fired for pid=$runner_pid; forcing exit" >&2
        kill -KILL "$runner_pid" 2>/dev/null || true
      fi
    ) &
    reap_watchdog_pid=$!
  else
    reap_watchdog_pid=
  fi

  if wait "$runner_pid"; then
    runner_exit=0
  else
    runner_exit=$?
  fi
  if [ -n "$reap_watchdog_pid" ]; then
    kill "$reap_watchdog_pid" 2>/dev/null || true
    wait "$reap_watchdog_pid" 2>/dev/null || true
  fi
  printf 'runner-exit=%s runner-reaped-at=%s\n' \
    "$runner_exit" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    >>"$run_root/test-run.txt"
}

launch_runner() {
  "$@" &
  suite_pid=$!
  printf 'runner-pid=%s runner-started-at=%s\n' \
    "$suite_pid" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    >>"$run_root/test-run.txt"
}

await_runner() {
  local runner_pid=$suite_pid runner_exit
  if wait "$runner_pid"; then
    runner_exit=0
  else
    runner_exit=$?
  fi
  printf 'runner-exit=%s runner-reaped-at=%s\n' \
    "$runner_exit" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    >>"$run_root/test-run.txt"
  suite_pid=
  return "$runner_exit"
}

retain_run_root() {
  local caught_signal=$1
  local status=$2
  trap - HUP INT TERM
  reap_runner TERM
  printf 'retained-reason=signal-%s\n' "$caught_signal" >>"$run_root/test-run.txt"
  echo "bin/test: interrupted by $caught_signal; retained isolated operator root $run_root" >&2
  exit "$status"
}

reap_runner_on_launcher_exit() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$suite_pid" ]; then
    reap_runner TERM
    printf 'retained-reason=launcher-exit-%s\n' "$status" \
      >>"$run_root/test-run.txt"
  fi
  exit "$status"
}

trap 'retain_run_root HUP 129' HUP
trap 'retain_run_root INT 130' INT
trap 'retain_run_root TERM 143' TERM
trap reap_runner_on_launcher_exit EXIT

echo "bin/test: isolated operator root $run_root pid=$$ selection=$selection"
cd "$run_root"
set +e
changed_paths_file="$run_root/changed-paths.txt"
if [ ${#changed_paths[@]} -gt 0 ]; then
  printf '%s\n' "${changed_paths[@]}" >"$changed_paths_file"
else
  : >"$changed_paths_file"
fi

echo "bin/test: preparing one shared published test base"
launch_runner clojure \
  "-J-Dseon.operator.root=$run_root" \
  "-J-Dseon.test.root=$run_root" \
  "-J-Dseon.test.source-root=$source_root" \
  -M:test -m seon.test.runner --prepare-base "$shared_published_base"
if await_runner; then
  base_status=0
else
  base_status=$?
fi
if [ "$base_status" -ne 0 ]; then
  status=$base_status
  cd "$source_root"
  echo "bin/test: shared published base preparation failed; retained isolated operator root $run_root" >&2
  exit "$status"
fi

launch_runner clojure \
  "-J-Dseon.operator.root=$run_root" \
  "-J-Dseon.test.root=$run_root" \
  "-J-Dseon.test.source-root=$source_root" \
  "-J-Dseon.test.changed-paths-file=$changed_paths_file" \
  "-J-Dseon.test.worker-parent=$worker_parent" \
  "-J-Dseon.test.published-base=$shared_published_base" \
  -M:test -m seon.test.runner \
  "${result_cluster:--}" "$result_root" "$git_sha" "$selection_mode" \
  "${namespaces[@]}"
if await_runner; then
  status=0
else
  status=$?
fi
set -e
cd "$source_root"

if [ "$status" -eq 0 ]; then
  case "$run_root" in
    "$run_parent"/run.*)
      bb --config "$source_root/bb.edn" -e \
        '(require (quote [seon.fs :as fs]))
         (apply fs/delete-recursively! *command-line-args*)' \
        "$run_parent" "$run_root"
      echo "bin/test: removed successful isolated operator root $run_root"
      ;;
    *)
      echo "bin/test: refusing unexpected run-root cleanup: $run_root" >&2
      exit 70
      ;;
  esac
else
  echo "bin/test: retained failed isolated operator root $run_root" >&2
fi

trap - EXIT HUP INT TERM
exit "$status"
