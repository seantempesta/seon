# shellcheck shell=bash
# bin/_java-home-resolver — SOURCE this (don't exec it) to pin every JVM
# process in the Seon dev stack to one JDK. Single source of truth for the
# Java version; kills the per-script hardcoded-JDK drift.
#
#   source "$(dirname "$0")/_java-home-resolver"
#
# Selects SEON_JAVA_VERSION (below), exports JAVA_HOME + JAVA_CMD and
# prepends $JAVA_HOME/bin to PATH (the `clojure` CLI resolves the JVM from
# `java` on PATH, not from JAVA_HOME). Honors an already-matching JAVA_HOME
# first. Falls back to whatever `java` is on PATH with a loud WARNING if no
# matching JDK is found. A missing runtime fails immediately with one install
# instruction instead of reaching a later compiler or database error.
#
# Why 26: current JDK that runs the datahike fork + proximum (HNSW secondary
# index, class-file v66, Foreign Memory + Vector APIs) and the full test
# suite. One supported runtime keeps compiler flags and production behavior
# identical across the writer, watcher, tests, and packaged image.

SEON_JAVA_VERSION="26"

# True iff $1 is an executable java whose -version major == SEON_JAVA_VERSION.
_seon_java_is_pinned() {
  [ -x "$1" ] && "$1" -version 2>&1 | grep -qE "\"${SEON_JAVA_VERSION}[.+\"]"
}

if ! _seon_java_is_pinned "${JAVA_HOME:-}/bin/java"; then
  _seon_jh=""

  # macOS: java_home knows where JDKs live.
  if command -v /usr/libexec/java_home >/dev/null 2>&1; then
    _seon_jh="$(/usr/libexec/java_home -v "$SEON_JAVA_VERSION" 2>/dev/null || true)"
  fi

  # Linux / WSL: scan common JDK install roots + SDKMAN.
  if ! _seon_java_is_pinned "${_seon_jh:-}/bin/java"; then
    _seon_jh=""
    for _seon_c in \
        /usr/lib/jvm/*"${SEON_JAVA_VERSION}"*/bin/java \
        "$HOME"/.sdkman/candidates/java/*"${SEON_JAVA_VERSION}"*/bin/java \
        /usr/lib/jvm/*/bin/java \
        "$HOME"/.sdkman/candidates/java/*/bin/java \
        /opt/*/bin/java; do
      if _seon_java_is_pinned "$_seon_c"; then
        _seon_jh="$(cd "$(dirname "$_seon_c")/.." && pwd)"; break
      fi
    done
  fi

  if [ -n "${_seon_jh:-}" ]; then
    export JAVA_HOME="$_seon_jh"
  else
    echo "ERROR: Seon requires JDK ${SEON_JAVA_VERSION}; no matching runtime was found." >&2
    echo "  Install JDK ${SEON_JAVA_VERSION}. macOS: brew install openjdk@${SEON_JAVA_VERSION} ·" >&2
    echo "  Debian/Ubuntu/WSL: apt install openjdk-${SEON_JAVA_VERSION}-jdk · or SDKMAN: sdk install java ${SEON_JAVA_VERSION}-open" >&2
    return 1 2>/dev/null || exit 1
  fi
  unset _seon_jh _seon_c
fi

# Homebrew exposes JAVA_HOME through a stable symlink while the running JVM
# reports its resolved Cellar path. Canonicalize once so tools that compare
# environment and system-property values do not report a false overwrite.
if [ -n "${JAVA_HOME:-}" ] && [ -d "$JAVA_HOME" ]; then
  export JAVA_HOME="$(cd "$JAVA_HOME" && pwd -P)"
fi

# Prepend $JAVA_HOME/bin to PATH (and export JAVA_CMD belt-and-braces) so the
# `clojure`/`clj` CLI launches under the selected JVM.
if [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
  export PATH="${JAVA_HOME}/bin:${PATH}"
  export JAVA_CMD="${JAVA_HOME}/bin/java"
fi
