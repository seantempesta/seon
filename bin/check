#!/bin/zsh
# bin/check [N] — the platform's end-to-end checks on target/seon (bin/build seon), each a
# mode of seon.check: dragons, contracts, census, fx, system, mcp, threads, admit, record,
# problems, smoke, program, robust, lifecycle, backpressure, hotreload, drain, orphan,
# durable, window, swarm N, e2e tasks and scenarios, resume, scale N (default N = 100).
# bin/check MODE [ARGS] runs one mode.
#
# Every step's exit status counts (a mode answers 0 only when its own proof holds), its
# whole output is kept in target/check/<time>/<step>.log, and the script ends with the
# failed steps named and exits non-zero when any failed.
#
# One store, many branches, as in production (owner, 2026-10-21): the run seeds one store,
# target/check/<time>/store, and every root a step boots works on a branch of it named for
# the step (SEON_RUN: <step>-<time>-<id>); the recovery steps (durable, window, resume) kill
# and reopen that same store on the same branch. The store is kept, every branch with it.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# a check's roots listen on no dashboard port (the owner's 7777 and every lane's stay theirs)
export SEON_WEB_PORT=${SEON_WEB_PORT:-0}
# one full check at a time on this machine, every lane's (each boots ~34 roots and up to 100
# agents): a full run takes the check lock and runs niced; a single mode does not
if [[ -z ${SEON_CHECK_LOCKED:-} && ( -z ${1:-} || ${1} =~ ^[0-9]+$ ) ]]; then
  SEON_CHECK_LOCKED=1 exec nice -n 15 /usr/bin/lockf -k "$ROOT/../check.lock" "$0" "$@"
fi
. "$ROOT/bin/env"
# a check's roots serve no dashboard: system.edn's :web :port 7777 is the owner's, and a
# step's root that found it free took it (the owner's browser then showed a throwaway check
# root). A run that wants one names its port: SEON_WEB_PORT=7790 bin/check web
export SEON_WEB_PORT=${SEON_WEB_PORT:-0}
S=$ROOT/target/seon
[[ -x $S ]] || { echo "check: no target/seon; run bin/build seon" >&2; exit 1 }
run() { (cd "$ROOT/target" && ./seon "$@" 2>&1) }
if [[ -n ${1:-} && ! ${1} =~ ^[0-9]+$ ]]; then run "$@"; exit $?; fi
N=${1:-100}
OUT=$ROOT/target/check/$(date +%Y%m%dT%H%M%S)
mkdir -p "$OUT"
# the one store of this run: every step's root works on a branch of its seed
export SEON_STORE=$OUT/store
FAILED=()

# step NAME FILTER CMD...: run CMD, keep its output, show the lines FILTER (a grep -E
# pattern; empty: the last line) selects, and record NAME as failed when CMD's exit status
# is not the expected one: 0, or EXPECT for a step that ends by design otherwise (a root
# that SIGKILLs itself, 137, so the next step can prove the store recovered).
step() {
  local name=$1 filter=$2; shift 2
  local log=$OUT/$name.log expect=${EXPECT:-0}
  SEON_RUN=$name "$@" > "$log" 2>&1
  local st=$?
  if [[ -n $filter ]]; then grep -E "$filter" "$log"; else tail -1 "$log"; fi
  if (( st != expect )); then FAILED+=("$name (exit $st, expected $expect, $log)"); echo "FAILED $name (exit $st, expected $expect)"; fi
  return 0
}

echo "== seed (the one store every step branches from)"; step seed "" run seed 2000
echo "== dragons"; step dragons "" "$ROOT/bin/dragons"
echo "== contracts"; step contracts ":contracted|:uncontracted|:result" run contracts
echo "== census (no [:fn] without :gen; mg/check on every pure contract, in the release binary)"
# in K shards at once, each a process checking every Kth contracted var (seon.check/census);
# each shard's exit status counts. K = 4 until the config file holds it (lane CONFIG).
K=4; CP=()
for i in $(seq 0 $((K-1))); do run census $i/$K > "$OUT/census-$i.log" 2>&1 & CP+=($!); done
for i in $(seq 0 $((K-1))); do
  wait ${CP[$((i+1))]}; st=$?
  grep -E ":generated|:failed \[\]|:result" "$OUT/census-$i.log"
  (( st == 0 )) || { FAILED+=("census-$i (exit $st, expected 0, $OUT/census-$i.log)"); echo "FAILED census-$i (exit $st, expected 0)"; }
done
echo "== fx (an effect from an agent through its owner proc)"; step fx ":unknown|:test-fork|^FX " run fx 200
echo "== system (root's procs from resources/seon/system.edn; apply! touches only what changed)"; step system "" run system
echo "== mcp (an outside MCP client evals in an agent and as root; both recorded :outside)"; step mcp "" run mcp-proof
echo "== threads (the fork server, an agent and its clone stay single-threaded: no GC sweepers where we fork)"; step threads "" run threads
echo "== admit"; step admit "" run admit
echo "== record"; step record "" run record
echo "== problems (each class provoked, then read back from main by my.root/problems)"; step problems "" env SEON_STALL_MS=1000 zsh -c "cd '$ROOT/target' && ./seon problems"
echo "== smoke"; step smoke "^merge|^killed|spawned|ready|^SMOKE " run smoke
echo "== program"; step program "" run program
echo "== robust"; step robust "" run robust
echo "== lifecycle (start!/stop! x10 in one process; pause/resume)"; step lifecycle "LIFECYCLE" run lifecycle 10
echo "== backpressure"; step backpressure "" run backpressure 200
echo "== hotreload"; step hotreload "" run hotreload
echo "== drain"; step drain "" run drain 32

echo "== orphan (root dies under busy agents, a clone and a test child)"
SEON_RUN=orphan run orphan > "$OUT/orphan.log" 2>&1
(( $? == 0 )) || { echo "FAILED orphan (no test child)"; FAILED+=("orphan (no test child, $OUT/orphan.log)") }
PIDS=$(sed -n 's/^PIDS //p' "$OUT/orphan.log")
# the orphans are given until their parent's death reaches them: each is asked once a
# second for up to 5 s, and a survivor past that is the failure
LEFT=$PIDS
for i in 1 2 3 4 5; do
  LEFT=$(for p in ${=PIDS}; do kill -0 $p 2>/dev/null && echo $p; done)
  [[ -z $LEFT ]] && break
  sleep 1
done
if [[ -z $PIDS ]]; then echo "FAIL no pids"; FAILED+=("orphan (no pids, $OUT/orphan.log)")
elif [[ -n $LEFT ]]; then echo "FAIL left running: $LEFT"; kill -9 ${=LEFT}; FAILED+=("orphan (left running: $LEFT)")
else echo "PASS none of $PIDS outlived root"; fi

# the recovery steps kill root and reopen the one store on the branch it worked on
echo "== durable (root writes its branch and SIGKILLs itself; a new root reopens the store and recovers it)"
EXPECT=137 step durable-write "" run durable-write durable; step durable-read "" run durable-read durable
echo "== window (SEON_FLUSH_MS=1000: answered unflushed, flushed within the window; :flush? waits)"
EXPECT=137 step window-write "" env SEON_FLUSH_MS=1000 zsh -c "cd '$ROOT/target' && ./seon window-write window"
step window-read "" env SEON_FLUSH_MS=1000 zsh -c "cd '$ROOT/target' && ./seon window-read window"
echo "== lease (SEON_EID_LEASE=50: an agent past its block of entity ids is refused, typed; the next agent's ids are never minted)"
step lease "" env SEON_EID_LEASE=50 zsh -c "cd '$ROOT/target' && ./seon lease"
echo "== swarm $N"; step swarm ":merged|:tasks-done|:fresh" run swarm $N
echo "== tasks: calc (6-task graph, cancel), scenarios (conflict, semantic, hairy, newns, sibling), swarm 20 over 5 shared vars"
step e2e-calc "" run e2e calc
for k in conflict semantic hairy newns sibling; do step e2e-$k "" run e2e scenario $k; done
step e2e-swarm "" run e2e swarm 20 8
echo "== stuck (add always wrong: refinement chains until its budget is spent, then a stuck fact naming what it blocks; the run ends on quiescence)"; step e2e-stuck ":stuck|quiet-after" run e2e stuck
echo "== resume (root SIGKILLed mid-graph; a new root finishes it)"
SEON_RUN=resume1 run e2e resume resume > "$OUT/resume1.log" 2>&1; step resume "" run e2e resume2 resume
echo "== scale $N"; step scale ":all-ok|:spawn->all|:end-to-end|:control-real-mb|:all-killed|^SCALE " run scale $N

echo
echo "store: $(du -sk "$OUT/store" | cut -f1) KB, one seed and $(ls "$OUT/store-agents" | wc -l | tr -d ' ') roots' mains"
if (( ${#FAILED} )); then
  echo "CHECK FAILED: ${#FAILED} step(s)"; for f in $FAILED; do echo "  $f"; done
  echo "outputs: $OUT"
  exit 1
fi
echo "CHECK OK (outputs: $OUT)"
