#!/bin/zsh
# bin/check [N] — the platform's end-to-end checks on target/seon (bin/build seon), each a
# mode of seon.check (laws is bin/laws and health bin/test --health, neither on the binary): contracts, mg-check, fx, config, system, mcp, agent-checks, threads, instrument, record,
# smoke, lifecycle, hotreload, idle, orphan,
# window, e2e tasks and scenarios,
# resume, scale-work N [no-search], spawn-phases N (N = 10 agents that work: evals and a prove of ~60 tests each; a single mode, not in a full run). A run's steps run at once, :seon.config.proofs/jobs at a
# time, the longest first, each on a clone of the one seeded store.
# bin/check MODE [ARGS] runs one mode. bin/check with no argument is bin/prove --checks: only
# the steps whose reach digest has no green result run (seon.proofs/check-steps); a number is
# the full run. bin/check --steps DIR (bin/prove's) runs only the steps DIR/steps names, of a
# full run, and writes the green ones to DIR/green (check-<step> ...). A full run takes its step
# names from the binary (./seon steps: seon.proofs/check-steps, the one list): a step this script
# runs that the list does not name is FAILED, so the two cannot drift.
#
# Every step's exit status counts (a mode answers 0 only when its own proof holds, and ends
# on the one verdict line NAME OK / NAME FAILED: seon.check/run-check), its
# whole output is kept in target/check/<time>/<step>.log, and the script ends with the
# failed steps named and exits non-zero when any failed.
#
# One store, many branches, as in production (owner, 2026-10-21 and 2026-10-22: "The
# branches are supposed to be light. I'm guessing making a new store every time isn't"): a
# run takes the one store it is given: the checks' own, target/check-store (SEON_STORE names
# another), never the checkout's runs/store, which is its standing or worktree root's, made
# without the example program the steps work on (steps failed falsely on it). It is seeded
# only when missing, by a full run's seed step and before a single mode, and every root a step boots
# works on a branch of it, the step's own main check-<step> (SEON_MAIN), never the store's
# main. The recovery steps (window, resume, orphan) kill their root and reopen the
# same store on the same branch. What a step made is deleted by the run (bin/check's drop:
# seon.db/delete-main!): a green step's branches when the run ends, a failed step's at that
# step's next run. Only logs stay, in target/check/<time>/.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# health reads the program store's kept trees, no binary and no store branch (bin/test --health)
[[ ${1:-} == health ]] && exec "$ROOT/bin/test" --health "${@:2}"
"$ROOT/bin/ports" --write   # the port keys under their current names (bin/ports)
[[ -z ${1:-} ]] && exec "$ROOT/bin/prove" --checks
# a full run is niced; full runs from different worktrees run in parallel (no lock: each
# uses its own stores under its run directory and kernel-assigned ports; owner, 2026-10-21)
if [[ -z ${SEON_CHECK_NICED:-} && ( ${1:-} =~ ^[0-9]+$ || ${1:-} == --steps ) ]]; then
  SEON_CHECK_NICED=1 exec nice -n 15 "$0" "$@"
fi
# the run is niced once (above, or by its caller): its background steps (the mg-check shards)
# keep that priority. zsh's BG_NICE renices each by 5 more, which at the ceiling (a niced
# caller of the re-exec: 15 + 15) prints "nice(5) failed: operation not permitted"
unsetopt BG_NICE
. "$ROOT/bin/env"
export SEON_STORE=${SEON_STORE:-$ROOT/target/check-store}
# a check's fixture tests (app.*) keep their verdicts in this invocation's own cache, removed at exit:
# in the main tree's shared one a fixture's verdict was reused by the next check run, so the run judged
# nothing (fx's test fork; docs/merging.md#verdicts-are-a-cache)
mkdir -p "$ROOT/target/tmp"
CHECK_RESULTS=$(mktemp -d "$ROOT/target/tmp/check-results.XXXXXX")
export SEON_RESULTS_DIR=$CHECK_RESULTS
trap 'rm -rf "$CHECK_RESULTS"' EXIT
# a check's roots serve no dashboard: system.edn's :web :port 7777 is the owner's, and a
# step's root that found it free took it (the owner's browser then showed a throwaway check
# root), whatever port the environment names: a check that the standing system's :prove service ran inherited its
# SEON_WEB_PORT=7777, and smoke's root failed on the port in use (2026-11-12). A step that serves one names its own (idle).
export SEON_WEB_PORT=0
# every check root has a store of its own: its wiki's baseline from git (4 s) is not what a check asks
export SEON_WIKI_BASELINE=${SEON_WIKI_BASELINE:-false}
# idle watches a tab on its root's dashboard, so its root serves one: on this run's own port, in a
# full run and a single mode alike
IDLE_WEB_PORT=$((20000 + $$ % 20000))
# agents' turns are the scripted provider's (a test fixture; a root with no profile has no model
# provider): every process of the binary below is given --profile scripted on its command line
# (seon.config reads it there; no environment variable selects a profile)
# a step's root embeds no text (:seon.config.vector/texts 0), but the vectors step's (run-embedding, and
# bin/check vectors alone): none other searches, and each would load the 0.9 GB model (docs/vector.md)
[[ ${1:-} == vectors ]] || export SEON_EMBED_TEXTS=${SEON_EMBED_TEXTS:-0}
# --steps DIR: a full run of the steps DIR/steps names, its greens written to DIR/green
# and DIR/config.edn, when there, a config layer every ./seon of the run is given (--config): what seon.fx/run-item writes
# for a step item, the program store of that item alone (:seon.config.proofs/program-store, a clone), so steps at once
# share no store they write
SEL=
[[ ${1:-} == --steps ]] && { SEL=$2; shift 2; set -- 100 }
S=$ROOT/target/seon
# NEEDS: does this run use the binary? Yes, unless its plan says none: a selected run whose
# DIR/steps-binary is there and empty (laws, lmdb-kill, lmdb-lock, lmdb-crash: bin/prove's plan writes it) seeds no store,
# starts no root and wants no build. No steps-binary is unknown, never none: the run seeds and uses
# the binary (a steps file written by hand ran window on an empty store)
NEEDS=1; [[ -n $SEL && -e $SEL/steps-binary && ! -s $SEL/steps-binary ]] && NEEDS=
(( NEEDS )) && { [[ -x $S ]] || { echo "check: no target/seon; run bin/build seon" >&2; exit 1 } }
# VERDICT: the line a refused run ends on, its mode's (CONFIG FAILED) or the run's (CHECK FAILED)
VERDICT=CHECK; [[ -n ${1:-} && ! ${1} =~ ^[0-9]+$ ]] && VERDICT=${(U)1}
# a binary not current for this tree checks another program (and may refuse this tree's config before it says anything).
# Current is seon.system/binary-current's answer, the one rule the plan's build asked: the binary's own tree (bin/build
# records it, target/seon.tree), or the answer the plan kept for the binary's tree and this one
# (target/binary-current/FROM-TO.edn, {:answer nil} when current). With neither (no plan judged these two trees: a
# checkout of its own, seon.check-test/a-stale-binary-is-refused) it is refused: bin/test or bin/build seon judges it.
# docs/source.md#the-binary-records-its-program
if (( NEEDS )); then
  BUILT=$(cat "$ROOT/target/seon.tree" 2>/dev/null) HERE=$("$ROOT/bin/tree" "$ROOT")
  JUDGED=$ROOT/target/binary-current/$BUILT-$HERE.edn
  if [[ -z $BUILT || ( $BUILT != $HERE && $(cat "$JUDGED" 2>/dev/null) != "{:answer nil}" ) ]]; then
    echo "check: target/seon was built from tree ${BUILT:-unknown}; this checkout is tree ${HERE:-unknown}: run bin/build seon"
    echo "$VERDICT FAILED (stale binary)"; exit 1
  fi
fi
# what this run starts ends with it (bin/held): a fifo of its own, held open read-write while
# bin/check lives, named to every step; its EOF, bin/check gone however it ended, ends them
STARTER=$ROOT/target/tmp/check-starter-$$.fifo
mkdir -p "$ROOT/target/tmp"; "$ROOT/bin/held" --reclaim "$ROOT/target/tmp"
rm -f "$STARTER"; mkfifo "$STARTER"; exec 7<>"$STARTER"
export SEON_STARTER_FIFO=$STARTER
# gone with this run, however it ends but SIGKILL (which no handler sees: bin/held --reclaim removes it)
trap 'rm -f "$STARTER"; rm -rf "$CHECK_RESULTS"' EXIT
trap 'exit 143' TERM INT HUP
# (fd 7, the fifo's write end, stays bin/check's own: a child holding it would keep the fifo open)
# a check's roots index task files of their own (none), as a test root's are (seon.test-store/start-root!): a fresh main is
# seeded with its tasks dir's (docs/source.md#indexing-a-tree), and the checkout's are no check's subject. Exported, so
# every process a step starts takes it, not only those run starts (idle, orphan and lifecycle's cycles seeded the
# checkout's task files onto an example program, whose cites name vars it does not hold: refused, 2026-11-10)
export SEON_TASKS=$ROOT/target/check/tasks; mkdir -p "$SEON_TASKS"
# a step runs the binary only through run: a selection whose plan said none of its steps needs it (NEEDS empty: no build
# checked, no store seeded) refuses the step that does, by name, rather than run it on no seeded store (a steps file
# written by hand ran window on an empty store, and it failed two phases later: task
# seon.check/a-selection-derives-what-it-needs-from-its-steps)
run() {
  (( NEEDS )) || { echo "check: $1 runs target/seon on the seeded store, but this selection's steps-binary ($SEL/steps-binary) says none of its steps needs them: no store was seeded; select by bin/prove's plan, or name $1 in steps-binary"; return 70 }
  local layer=(); [[ -n $SEL && -f $SEL/config.edn ]] && layer=(--config "$SEL/config.edn")
  (cd "$ROOT/target" && "$ROOT/bin/held" ./seon "$@" $layer --profile scripted 2>&1 7>&- 3>&-)
}
run-embedding() { SEON_EMBED_TEXTS=64 run "$@" }
# a single mode: on its own branch check-<mode> of the given store, deleted when it is green
if [[ -n ${1:-} && ! ${1} =~ ^[0-9]+$ ]]; then
  M=check-$1
  # quiet when it works; a seed or a drop that fails prints its own output and the mode's verdict
  # line (docs/checks.md#modes: a step never ends without one)
  quiet() { local what=$1 o; shift; o=$("$@") || { print -r -- "$o"; echo "$VERDICT FAILED ($what)"; exit 1 } }
  [[ $1 == seed ]] || quiet seed run seed 2000
  quiet drop run drop $M
  if [[ $1 == idle ]]; then SEON_WEB_PORT=$IDLE_WEB_PORT SEON_MAIN=$M run "$@"; st=$?
  else SEON_MAIN=$M run "$@"; st=$?; fi
  (( st == 0 )) && quiet drop run drop $M
  exit $st
fi
N=${1:-100}
TIMEFMT='real %E user %U sys %S'
OUT=$ROOT/target/check/$(date +%Y%m%dT%H%M%S)-$$
mkdir -p "$OUT/stores"
: > "$OUT/failed"; : > "$OUT/green"; [[ -z $SEL ]] && : > "$OUT/full"
# want STEP: is STEP one this run runs? A step seon.proofs/check-steps does not name is FAILED.
# (a selected run's steps were named by the plan from the same table: no binary asked)
KNOWN= ONLY=
# the selection's names split on any whitespace, one a line or several on one (one a line ran none and said OK, 2026-11-10)
if [[ -n $SEL ]]; then ONLY=${(j: :)${=$(<"$SEL/steps")}}; else KNOWN=" $(run steps) "; fi
# failed WHY / green STEP / is-green STEP: the run's record, one line each in OUT/failed and
# OUT/green, appended by the steps running at once (a line is one write)
failed() { print -r -- "$*" >> "$OUT/failed" }
green() { print -r -- "check-$1" >> "$OUT/green" }
is-green() { grep -qx "check-$1" "$OUT/green" }
want() {
  [[ -n $SEL || $KNOWN == *" $1 "* ]] || { failed "$1 (not a step of seon.proofs/check-steps)"; echo "FAILED $1 (not in seon.proofs/check-steps)"; return 1 }
  [[ -z $SEL || " $ONLY " == *" $1 "* ]]
}

# step NAME FILTER CMD...: run CMD, keep its output, show the lines FILTER (a grep -E
# pattern; empty: the last line) selects, and record NAME as failed when CMD's exit status
# is not the expected one: 0, or EXPECT for a step that ends by design otherwise (a root
# that SIGKILLs itself, 137, so the next step can prove the store recovered).
step() {
  local name=$1 filter=$2; shift 2
  local log=$OUT/$name.log expect=${EXPECT:-0}
  [[ $name == seed ]] || want ${${name%-write}%-read} || return 0
  # a unit past its bound (bounded, below) runs no more of its steps: bounded reports it, STEP-OVERRAN
  [[ -n ${UNIT:-} && -e $OUT/$UNIT.overran ]] && return 0
  # its wall and CPU seconds kept beside its log (NAME.time: zsh's time, which keeps the exit
  # status); fd 7 (the starter fifo) and fd 3 (the run's token pool) stay bin/check's own
  { time (SEON_MAIN=check-$name "$@" > "$log" 2>&1 7>&- 3>&-) } 2> "$OUT/$name.time" 7>&- 3>&- & local sp=$!
  wait $sp; local st=$?
  local r=$(sed -n 's/^real \([0-9.]*\).*/\1/p' "$OUT/$name.time" | head -1)
  [[ -n $SEL && -n $r ]] && printf "%s %.0f\n" "$name" $(( r * 1000 )) >> "$SEL/step-ms"
  # a red's message first, on its FAILED line and in the run's failed list: the log's first line that says what went wrong
  # (an unhandled exception, a FAILED or ERROR verdict), else its first line; never its last, which for a throw is a trace
  # frame (the rename's health red was read from its trace lines and misdiagnosed for 1.5 h, 2026-11-11)
  local msg=
  [[ -n ${UNIT:-} && -e $OUT/$UNIT.overran ]] && return 0
  if (( st != expect )); then
    msg=$(grep -m1 -E 'Unhandled exception|Exception|FAILED|FAIL |ERROR|[Ee]rror:' "$log" 2>/dev/null)
    [[ -n $msg ]] || msg=$(head -1 "$log" 2>/dev/null)
    msg=${msg:0:300}
    echo "FAILED $name: $msg (exit $st, expected $expect, $log)"
  fi
  if [[ -n $filter ]]; then grep -E "$filter" "$log"; else tail -1 "$log"; fi
  if (( st != expect )); then failed "$name: $msg (exit $st, expected $expect, $log)"
  else green $name; fi
  return 0
}

# bounded NAME CMD...: CMD (a unit, every step and phase it runs) under NAME's bound (bin/prove's plan, SEL/step-bounds: the
# step-end factor times its median measured ms; a step never measured takes the largest median, seon.proofs/step-bounds). Past
# it, its evidence is captured (bin/evidence, with its root's stall state from the port its root wrote beside its store), what
# it runs is ended, and it FAILED, STEP-OVERRAN: a step past its bound is a bug, recorded as an error and fixed (the owner,
# 2026-11-12: "A test killed for running too long is a bug and it should be recorded as an error and fixed"; the owner's
# fourth clock exception, 2026-11-10: docs/clocks.md#time-decides-the-owners-exceptions). The bound is the unit's, not one
# step()'s: a phase a unit runs outside step() (orphan's held --drain, resume's first root) had none, and two of them
# waited 75 min in a landing's prove, 2026-11-12.
bounded() {
  local name=$1 bound= W=; shift
  [[ -n $SEL && -s $SEL/step-bounds ]] && bound=$(awk -v k="$name" '$1 == k { print $2 }' "$SEL/step-bounds")
  rm -f "$OUT/$name.overran"
  # timed whole (NAME.unit-time, zsh's time): an overran unit's wall and CPU seconds are kept, as a finished step's are
  { time ( UNIT=$name; "$@" ) } 2> "$OUT/$name.unit-time" & local up=$!
  if [[ -n $bound ]]; then
    ( trap 'kill $S 2>/dev/null; exit 0' TERM; sleep $(( bound / 1000.0 )) 7>&- 3>&- & S=$!; wait $S || exit 0
      "$ROOT/bin/evidence" "$OUT/$name-overran" $up "$(cat "${SEON_STORE:-/nonexistent}/root.port" 2>/dev/null)" > /dev/null 2>&1
      print -r -- "$bound" > "$OUT/$name.overran"
      "$ROOT/bin/end-tree" $up ) 7>&- 3>&- & W=$!
  fi
  wait $up
  [[ -n $W ]] && { kill $W 2>/dev/null; wait $W 2>/dev/null }
  if [[ -e $OUT/$name.overran ]]; then
    # its store is kept, as any failed step's; its CPU seconds (user + sys) beside its wall bound and the load say whether it
    # was working or waiting on the machine; its time is kept for its verdict, as a green step's is
    local cpu=$(awk '{for (i = 1; i < NF; i++) { if ($i == "user") u = $(i+1); if ($i == "sys") y = $(i+1) }} END {sub(/s$/, "", u); sub(/s$/, "", y); printf "%.1f", u + y}' "$OUT/$name.unit-time" 2>/dev/null)
    local r=$(sed -n 's/^real \([0-9.]*\).*/\1/p' "$OUT/$name.unit-time" | head -1)
    [[ -n $SEL && -n $r ]] && printf "%s %.0f\n" "$name" $(( r * 1000 )) >> "$SEL/step-ms"
    local msg="STEP-OVERRAN, ran past its bound of $(<$OUT/$name.overran) ms (:seon.config.check/step-end-factor times its median; CPU ${cpu:-?} s, load $(sysctl -n vm.loadavg | awk '{print $3}')); evidence in $OUT/$name-overran"
    echo "FAILED $name: $msg"
    failed "$name: $msg"
  fi
  return 0
}

if (( NEEDS )); then
echo "== seed (the one store every step branches from: made when missing)"; bounded seed step seed "" run seed 2000
# the store's path, size and branches: `seon store`'s own line, from stdout alone (a log line on stderr once read as the
# path: konserve's deprecation warning, 2026-11-10, and every unit then seeded a store of its own instead of copying)
store-line() { (cd "$ROOT/target" && "$ROOT/bin/held" ./seon store --profile scripted 2>/dev/null 7>&- 3>&-) | tail -1 }
read -r STORE KB0 BR0 <<< "$(store-line)"
[[ -f $STORE/data.mdb ]] || { failed "seed (no seeded store at '$STORE': seon store answered no path holding data.mdb)"; print "FAILED seed: no seeded store at '$STORE'" }
# the steps' own mains: what a failed earlier run left is deleted before this run's step
STEPS=(seed fx config system mcp agent-checks threads instrument record smoke lifecycle hotreload idle
       orphan window ids vectors e2e-calc e2e-conflict e2e-semantic e2e-hairy e2e-newns e2e-sibling e2e-loop e2e-held resume)
run drop ${STEPS/#/check-} > "$OUT/drop-before.log" 2>&1 || failed "drop-before ($OUT/drop-before.log)"
fi

# ---- the steps, each a unit u-NAME: what it runs, in order, on its own store ----
u-laws() { echo "== laws (every law's sites: catch, clocks, measures, resolution)"; step laws "OK \(|FAILED" "$ROOT/bin/laws" }
# lmdb-kill, lmdb-lock and lmdb-crash run below Datahike, on LMDB envs of their own under one
# directory each: a raw put has no branch to take, and the store's env is konserve's key space (a raw
# key or a named sub-db there is a key konserve reads). Each directory is deleted when its step is green.
u-lmdb-kill() {
  echo "== lmdb-kill (a writer SIGKILLed inside a txn, a dead reader table lock, fork with the writer lock held, killed readers past the table's size, a killed reader's pages, a kill after a sync: the next writes commit and nothing is held or lost)"
  step lmdb-kill "" "$ROOT/target/lmdb-kill" "$OUT/lmdb-kill"
  is-green lmdb-kill && "$ROOT/bin/remove-tree" "$OUT/lmdb-kill"
}
u-lmdb-lock() {
  echo "== lmdb-lock (no semaphore, 16 processes on one store, 8 threads over 2 envs of one store, 50 stores in one process, no lock left after a killed writer, a second env's close keeps the first's locks, a deleted store leaves nothing, another lock format refused)"
  step lmdb-lock "" "$ROOT/target/lmdb-lock" "$OUT/lmdb-lock"
  is-green lmdb-lock && "$ROOT/bin/remove-tree" "$OUT/lmdb-lock"
}
u-lmdb-crash() {
  echo "== lmdb-crash (an OS crash at every write point of 40 commits, any subset of the unflushed writes landing torn at 4 KB: the store opens at its last synced commit, key for key, and commits after)"
  step lmdb-crash "" "$ROOT/target/lmdb-crash" "$OUT/lmdb-crash"
  is-green lmdb-crash && "$ROOT/bin/remove-tree" "$OUT/lmdb-crash"
}
# forks: the forks' own suites on Jolt, a process a unit (bin/forks), against test/forks/baseline.edn
u-forks() { echo "== forks (Datahike's and konserve's own tests on Jolt, each unit's counts against its baseline)"; step forks "FAILED|^FORKS " "$ROOT/bin/forks" }
u-health() { echo "== health (the program's and the wiki's derived problems: dead citations, unnamed sites, stale sections, orphan pages, unlinked classes)"; step health "" "$ROOT/bin/test" --health }
u-contracts() { echo "== contracts"; step contracts ":contracted|:uncontracted|^CONTRACTS " run contracts }
u-test-inputs() { echo "== test-inputs (every test read of a clock, random, environment, sleep or deadline is named with its reason)"; step test-inputs ":unnamed|:named-not-read|^TEST-INPUTS " run test-inputs }
u-mg-check() {
  echo "== mg-check (no [:fn] without :gen; mg/check on every pure contract, in the release binary)"
  want mg-check || return 0
  # bin/prove runs the generative check's keys in bin/test's shards beside the tests (no binary: seon.proofs/mg-run);
  # this step is the whole set in the binary, in K shards at once, each a process checking every Kth
  # contracted var (seon.check/mg-check, the same mg-run); each shard's exit status counts. Seeds are of the
  # binary's tree. bin/check mg-check FN ... checks just those functions.
  local K=$JOBS CP=() ok=1 i st base
  base=$(cat "$ROOT/target/seon.tree")
  # its K shards take K of the run's JOBS tokens: one is the unit's own, the others are waited for
  for i in $(seq 2 $K); do read -u 3 tok; done
  for i in $(seq 0 $((K-1))); do { time (run mg-check $i/$K $base > "$OUT/mg-check-$i.log" 2>&1) } 2> "$OUT/mg-check-$i.time" & CP+=($!); done
  for i in $(seq 0 $((K-1))); do
    wait ${CP[$((i+1))]}; st=$?
    grep -E ":generated|^MG-CHECK " "$OUT/mg-check-$i.log"
    (( st == 0 )) || { ok=0; failed "mg-check-$i (exit $st, expected 0, $OUT/mg-check-$i.log)"; echo "FAILED mg-check-$i (exit $st, expected 0)"; }
  done
  for i in $(seq 2 $K); do print -u 3 x; done
  (( ok )) && green mg-check
}
u-fx() { echo "== fx (an effect from an agent through its owner proc)"; step fx ":unknown|:test-fork|^FX " run fx 20 }
u-config() { echo "== config (the config in force as facts on main; an agent reads them from its branch)"; step config "" run config }
u-system() { echo "== system (root's procs from resources/seon/system.edn; apply! touches only what changed)"; step system "" run system }
u-agent-checks() { echo "== agent-checks (bin/agent-checks on this step's root: an agent's breaks prove red, every proof named, again after a resume)"; step agent-checks "" run agent-checks }
u-mcp() { echo "== mcp (an outside MCP client evals in an agent and as root; each recorded by who ran it)"; step mcp "" run mcp-proof }
u-threads() { echo "== threads (the fork server, an agent and its clone stay single-threaded: no GC sweepers where we fork)"; step threads "" run threads }
u-instrument() { echo "== instrument"; step instrument "" run instrument }
u-record() { echo "== record"; step record "" run record }
u-smoke() { echo "== smoke"; step smoke "^merge|^killed|spawned|ready|^SMOKE " run smoke }
# no web listener: the adapter's acceptor and sweeper outlive stop! (task seon.web.edn
# web-server-threads-are-joined-at-stop), so root's exact thread count is checked without it
u-lifecycle() { echo "== lifecycle (start!/stop! x10 in one process, root's threads exactly as declared; pause/resume)"; step lifecycle "LIFECYCLE" env SEON_WEB_PORT=0 zsh -c "cd '$ROOT/target' && '$ROOT/bin/held' ./seon lifecycle 10 --profile scripted" }
u-hotreload() { echo "== hotreload"; step hotreload "" run hotreload }
u-idle() {
  echo "== idle (no beat: an idle root with a tab open steps nothing; a spawn and a commit still reach the tab)"
  step idle ":steps-at-idle|:bytes-at-idle|reached-tab|^IDLE " env SEON_WEB_PORT=$IDLE_WEB_PORT zsh -c "cd '$ROOT/target' && '$ROOT/bin/held' ./seon idle 2000 --profile scripted"
}
u-orphan() {
  want orphan || return 0
  echo "== orphan (root dies under busy agents, a clone and a test child)"
  local PIDS LEFT
  # held --drain returns once root and every process it started has ended (bin/held's lifeline pipe,
  # which each inherits): the orphans' end is the event this waits on, not a count of seconds. An
  # orphan that never ends holds this step open: no clock calls it dead, so that verdict is the
  # harness's (docs/failure-points.md)
  (cd "$ROOT/target" && SEON_MAIN=check-orphan "$ROOT/bin/held" --drain ./seon orphan --profile scripted 7>&- 3>&-) > "$OUT/orphan.log" 2>&1
  (( $? == 0 )) || { echo "FAILED orphan (no test child)"; failed "orphan (no test child, $OUT/orphan.log)"; return 0 }
  PIDS=$(sed -n 's/^PIDS //p' "$OUT/orphan.log")
  # every process of the tree has ended by now (the drain above); any pid that can still run is a survivor. A pid that
  # can run nothing more (stat Z or E, its parent not this script: an orphan launchd reaps) has ended: the rule of
  # seon.check/ran-nothing-more?, which lifecycle uses, here in ps's words
  # (seon.check/left?: a pid ps lists no more is left only if kill -0 finds it again)
  LEFT=$(for p in ${=PIDS}; do kill -0 $p 2>/dev/null || continue; read -r st pp <<< "$(ps -o stat=,ppid= -p $p 2>/dev/null)"
         if [[ -z $st ]]; then kill -0 $p 2>/dev/null && echo $p; continue; fi
         [[ $st == *[ZE]* && $pp != $$ ]] || echo $p; done)
  if [[ -z $PIDS ]]; then echo "FAIL no pids"; failed "orphan (no pids, $OUT/orphan.log)"
  elif [[ -n $LEFT ]]; then echo "FAIL left running: $LEFT"; kill -9 ${=LEFT}; failed "orphan (left running: $LEFT)"
  else echo "PASS none of $PIDS outlived root"; green orphan; fi
}
# the recovery steps kill root and reopen the one store on the branch it worked on
u-window() {
  echo "== window (continuous group commit: answered unflushed while the flusher is paused; :flush? waits for its sync)"
  EXPECT=137 step window-write "" run window-write check-window
  step window-read "" run window-read check-window
  is-green window-write && is-green window-read && green window
}
u-vectors() { echo "== vectors (the checkout's forms and wiki embedded by the model in root, then the pyramid's top 10 against an exact search of every vector)"; step vectors "" run-embedding vectors }
u-ids() { echo "== ids (two agents' processes issue every entity id and transaction id once: the store's one page of ids)"; step ids "" run ids }
u-e2e-calc() { echo "== tasks: calc (6-task graph, cancel)"; step e2e-calc "" run e2e calc }
for k in conflict semantic hairy newns sibling; do functions[u-e2e-$k]="echo '== tasks: scenario $k'; step e2e-$k '' run e2e scenario $k"; done
u-e2e-loop() { echo "== loop (Seon's own source is main's program: a task changes seon.generation/generation, its merge is written back, committed on a clone's jolt/seon-merges, and live in root and in an agent forked after it, nothing built)"; step e2e-loop ":source|:commits|:live|LOOP" run e2e loop "$OUT/loop" }
u-e2e-held() { echo "== held (add always wrong: it ends at its cap, held, named the root cause of what it waits on, its refine written once after it with the review held; the owner raises its agent's budget and releases it: it runs again from its branch's head under the same agent key, its turns going on, and ends at the raised cap, held again)"; step e2e-held ":root-causes|:release" run e2e held }
u-resume() {
  echo "== resume (root SIGKILLed mid-graph; a new root finishes it)"
  want resume && run e2e resume check-resume > "$OUT/resume1.log" 2>&1; step resume "" run e2e resume2 check-resume
}

# ---- the steps at once: JOBS at a time, the longest first ----
# One root per store (two roots branching at once can drop a branch from the store's roster,
# task seon.db/two-processes-branch-one-store-at-once; root collects only as the store's only
# writer, docs/storage.md#collection), so a unit running
# beside others takes a store of its own: an APFS clone of the one
# seeded store (its data file; LMDB makes its lock file), the same content as a branch of it,
# deleted when the unit is green.
if (( NEEDS )); then JOBS=$(run jobs); else JOBS=2; fi
UNITS=(laws lmdb-kill lmdb-lock lmdb-crash forks health contracts test-inputs mg-check fx config system mcp agent-checks threads instrument record smoke lifecycle
       hotreload idle orphan window ids e2e-calc e2e-conflict e2e-semantic e2e-hairy e2e-newns
       e2e-sibling e2e-loop e2e-held resume vectors)
# the longest first, by the last full run's measured wall seconds (a unit not measured yet first):
# what orders the queue, never what a step proves
# a selection that names a step this script has no unit for, or that names none, ran nothing it was asked for: CHECK FAILED, naming it
if [[ -n $SEL ]]; then
  [[ -z $ONLY ]] && { failed "the selection $SEL/steps names no step"; echo "FAILED: the selection names no step" }
  for n in ${=ONLY}; do
    (( $+functions[u-$n] )) || { failed "$n (no step of that name: nothing ran it)"; echo "FAILED $n: no step of that name in bin/check" }
  done
fi
# the last full run: the latest with a `full` mark (a selected run's times cover only its steps)
PREVS=("$ROOT"/target/check/2*/full(N)); PREVS=(${PREVS:h}); PREVS=(${PREVS:#$OUT}); PREV=${PREVS[-1]:-}
secs() { local f r t=0 seen=0; for f in "$PREV/$1".time(N) "$PREV/$1"-*.time(N); do seen=1; r=$(sed -n 's/^real \([0-9.]*\).*/\1/p' "$f" | head -1); t=$(( t + ${r:-0} )); done; (( seen )) && print $t || print 1e9 }
[[ -n $PREV ]] && UNITS=(${(f)"$(for u in $UNITS; do print "$(secs $u) $u"; done | sort -k1,1 -g -r -s | awk '{print $2}')"})
unit() {
  # a unit this run does not select takes no store and shows nothing
  [[ -n $SEL && " $ONLY " != *" $1 "* ]] && return 0
  export SEON_STORE=$OUT/stores/$1
  # a unit that cannot take its copy of the seeded store fails here, loudly: it never runs on a store its own root seeded
  (( NEEDS )) && { mkdir -p "$SEON_STORE" && cp -c "$STORE/data.mdb" "$SEON_STORE/data.mdb" || { failed "$1 (no copy of the seeded store $STORE)"; print "FAILED $1: no copy of the seeded store $STORE"; return 1 } }
  bounded $1 u-$1 > "$OUT/$1.shown" 2>&1
  # a failed step's store stays to be read: failed's lines are "NAME: why", "NAME (why)" or "NAME-i ..." (it wanted "NAME " or
  # "NAME-" alone, so every red step's store was removed: Deep fixes, 2026-11-12)
  grep -q "^$1[ :-]" "$OUT/failed" || "$ROOT/bin/remove-tree" "$SEON_STORE"
  cat "$OUT/$1.shown"
}
mkfifo "$OUT/pool"; exec 3<>"$OUT/pool"; rm "$OUT/pool"
for i in $(seq 1 $JOBS); do print -u 3 x; done
# what the run's steps are doing at the owner's checkpoint, once ("10m is my main wtf is going on checkpoint", 2026-11-06), while they live: a limit's stop
# signals the whole group, so nothing can be read of a stuck step after it. An observation of time, never an end (docs/clocks.md)
# the timer ends its own sleep when the run ends it: killing the subshell alone left its sleep orphaned under init in the
# checkout for up to ten minutes, which kept bin/land from removing the worktree (2026-11-08)
( trap 'kill $S 2>/dev/null; exit 0' TERM; sleep ${SEON_CHECK_EVIDENCE_AFTER_S:-600} & S=$!; wait $S && "$ROOT/bin/evidence" "$OUT/at-checkpoint" $$ ) & W=$!
P=(); for u in $UNITS; do read -u 3 tok; { unit $u; print -u 3 x } & P+=($!); done
wait $P
kill $W 2>/dev/null; wait $W 2>/dev/null
exec 3>&-

# what the green steps made is deleted; a failed step's branches stay until its next run
GREEN=(${(f)"$(<$OUT/green)"})
(( NEEDS )) && { run drop $GREEN > "$OUT/drop-after.log" 2>&1 || failed "drop-after ($OUT/drop-after.log)" }
FAILED=(${(f)"$(<$OUT/failed)"})
(( NEEDS )) && read -r _ KB1 BR1 <<< "$(store-line)"
[[ -n $SEL ]] && print -r -- "${GREEN[@]}" > "$SEL/green"
echo
(( NEEDS )) && echo "store $STORE: ${KB0} KB and ${BR0} branches before the run, ${KB1} KB and ${BR1} after; run directory $(du -sk "$OUT" | cut -f1) KB"
if (( ${#FAILED} )); then
  echo "CHECK FAILED: ${#FAILED} step(s)"; for f in $FAILED; do echo "  $f"; done
  echo "outputs: $OUT"
  exit 1
fi
echo "CHECK OK (outputs: $OUT)"
