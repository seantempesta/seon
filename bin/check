#!/bin/zsh
# bin/check [N] — the platform's end-to-end checks on target/seon (bin/build seon), each a
# mode of seon.check (proto/flow f2-final's smoke.sh): smoke, program, robust, lifecycle,
# backpressure, hotreload, drain, orphan, durable, swarm N, scale N (default N = 100).
# bin/check MODE [ARGS] runs one mode.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/bin/env"
S=$ROOT/target/seon
[[ -x $S ]] || { echo "check: no target/seon; run bin/build seon" >&2; exit 1 }
run() { (cd "$ROOT/target" && ./seon "$@" 2>&1) }
if [[ -n ${1:-} && ! ${1} =~ ^[0-9]+$ ]]; then run "$@"; exit $?; fi
N=${1:-100}
echo "== dragons"; "$ROOT/bin/dragons" | tail -1
echo "== contracts"; run contracts | grep -E ":contracted|:uncontracted|:result"
# the census runs from source: test.check's generators fail in a release build on Jolt
# ("bit operation not supported for: class clojure.lang.BigInt", a runtime finding)
echo "== census (no [:fn] without :gen; mg/check on every pure contract)"
(cd "$ROOT" && HOME=$ROOT/target/home JOLT_PWD=$ROOT "$ROOT/target/jolt/jolt" -m seon.check census 2>&1 | grep -E ":generated|:failed \[\]|:result")
echo "== fx (an effect from an agent through its owner proc)"; run fx 200 | grep -E ":unknown|:test-fork"
echo "== admit"; run admit | tail -1
echo "== record"; run record | tail -1
echo "== smoke";  run smoke | grep -E "^merge|^killed|spawned|ready"
echo "== program"; run program | tail -1
echo "== robust"; run robust | tail -1
echo "== lifecycle (start!/stop! x10 in one process; pause/resume)"; run lifecycle 10 | grep -E ":threads |false|LIFECYCLE" | tr -s " \n" " "; echo
echo "== backpressure"; run backpressure 200 | tail -1
echo "== hotreload"; run hotreload | tail -1
echo "== drain"; run drain 32 | tail -1
echo "== orphan (root dies under busy agents, a clone and a test child)"
PIDS=$(run orphan | sed -n 's/^PIDS //p'); sleep 1
LEFT=$(for p in ${=PIDS}; do kill -0 $p 2>/dev/null && echo $p; done)
if [[ -z $PIDS ]]; then echo "FAIL no pids"; elif [[ -n $LEFT ]]; then echo "FAIL left running: $LEFT"; kill -9 ${=LEFT}; else echo "PASS none of $PIDS outlived root"; fi
echo "== durable (root writes a store and SIGKILLs itself; a new root recovers it)"
D=$(mktemp -d /tmp/seon-durable.XXXXXX)
run durable-write $D/store | tail -1; run durable-read $D/store | tail -1; rm -rf "$D"
echo "== window (SEON_FLUSH_MS=1000: answered unflushed, flushed within the window; :flush? waits)"
D=$(mktemp -d /tmp/seon-window.XXXXXX)
(export SEON_FLUSH_MS=1000; run window-write $D/store | tail -2; run window-read $D/store | tail -1); rm -rf "$D"
echo "== swarm $N"; run swarm $N | grep -E ":merged|:tasks-done|:fresh"
echo "== tasks: calc (6-task graph, cancel), scenarios (conflict, semantic, hairy), swarm 20 over 5 shared vars"
run e2e calc | tail -1
for k in conflict semantic hairy; do run e2e scenario $k | tail -1; done
run e2e swarm 20 8 | tail -1
D=$(mktemp -d /tmp/seon-resume.XXXXXX)
echo "== resume (root SIGKILLed mid-graph; a new root finishes it)"; run e2e resume $D/s > /dev/null; run e2e resume2 $D/s | tail -1; rm -rf "$D"
echo "== scale $N"; run scale $N | grep -E ":all-ok|:spawn->all|:end-to-end|:control-real-mb|:all-killed"
