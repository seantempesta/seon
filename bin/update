#!/bin/zsh
# bin/update [ARGS]   bring the standing root up to date with main, from the main tree, in one go:
# bin/update --merges-only DIR   step 1's merge alone on the write-back tree DIR (no build, no restart): what
#   seon.source-test/an-update-never-says-ok-on-a-merge-that-did-nothing drives
#   1. bring main into the write-back tree (jolt/merges: what the standing root's merges committed in the tree that
#      config/local.edn's :seon.config.source/root names) and move both trees' submodules to main's pins (bin/worktree
#      --sync for it). Nothing of jolt/merges enters main here: a merged task's files reach main by the reviewed sync
#      (my.root/sync! onto a branch a session reviews and lands; docs/source.md#a-merged-task-reaches-mains-files),
#      and until then the task is an :unsynced problem;
#   2. build (bin/build: each step skips what is up to date);
#   3. restart the standing root on its store (bin/root stop, start): it boots on main's build and resumes its
#      main, catching up the files its checkout changed since main last indexed it (docs/source.md#a-boot-catches-up-with-its-checkout).
# ARGS go to the restarted root (bin/root start ARGS): the standing root's profile is one of them
#   (bin/update --profile deepseek), as it is on every root's command line (docs/config.md#layers).
# bin/land runs it after it moves main (docs/merging.md#a-branch-lands-with-binland); the owner runs it by hand too.
# Every step's exit status counts; the last line is UPDATE OK or UPDATE FAILED (UPDATE FAILED: ROOT STALE BINARY ... when the
# restarted root's binary is another program than its store's main: it runs, forks no agent, and the line names the acts).
setopt pipefail
MAIN=$(cd "$(dirname "$0")/.." && pwd)
fail() { print -u2 "update: $*"; print "UPDATE FAILED"; exit 1 }
# main brought into the write-back tree $1. Its index and files must agree with its HEAD before the merge: a change staged
# there (a ref moved under a checked-out branch leaves its index behind: task seon.fx/a-write-back-moves-the-checked-out-trees-files)
# is refused by git's merge, and a merge that did not bring main in is no update. After it, HEAD contains main, or it failed:
# eight updates on 2026-11-11 said UPDATE OK while the write-back tree stayed at batch 24
merges_catch_up() {
  local M=$1
  # the index is refreshed first: a file whose stat alone moved reads as changed to
  # git diff, which refused the first update after a merge and passed the next, once git status had refreshed it
  git -C "$M" update-index -q --refresh --ignore-submodules || true
  git -C "$M" diff --quiet --ignore-submodules || fail "$M has uncommitted changes: $(git -C "$M" status --short --ignore-submodules | tr '\n' ' ')"
  git -C "$M" diff --cached --quiet --ignore-submodules || fail "$M has staged changes its HEAD does not hold: $(git -C "$M" status --short --ignore-submodules | tr '\n' ' ')"
  # its branch may hold the standing root's merges main does not (unsynced tasks): main is merged into it, never it into main
  git -C "$M" merge -q --no-edit main || fail "merging main into $M (a merged task's files and main's differ: sync or resolve it there)"
  git -C "$M" merge-base --is-ancestor main HEAD || fail "the merge of main into $M did not bring main in: its HEAD is $(git -C "$M" rev-parse --short HEAD)"
}
if [[ ${1:-} == --merges-only ]]; then
  [[ -d ${2:-} ]] || fail "--merges-only takes the write-back tree's path"
  merges_catch_up "${2:A}"; print "UPDATE OK"; exit 0
fi
cd "$MAIN" || fail "no main tree"
# the merges tree is the one the standing root writes back into: its path comes from one place, the main tree's
# config/local.edn (:seon.config.source/root, #seon/checkout "rel/path" or an absolute string), before and after the cutover
src=$(sed -nE 's|^[[:space:]]*:seon\.config\.source/root[[:space:]]+(#seon/checkout[[:space:]]+)?"([^"]+)".*|\2|p' config/local.edn 2>/dev/null | head -1)
[[ -n $src ]] || fail "config/local.edn names no :seon.config.source/root: the standing root has no write-back tree to update"
MERGES=${src:A}; [[ $src == /* ]] || MERGES=$MAIN/$src; MERGES=${MERGES:A}
[[ -d $MERGES ]] || fail "the write-back tree $MERGES (:seon.config.source/root) does not exist: make it with bin/worktree merges, or fix config/local.edn"
[[ $(git branch --show-current) == main ]] || fail "the main tree is not on main"
# bin/land moves main by its ref alone (no checkout): the main tree's index and files follow it here, a two-tree
# merge from what the index holds to main, which refuses a file someone changed in the main tree
idx=$(git write-tree) || fail "the main tree's index has unmerged entries"
[[ $idx == $(git rev-parse 'HEAD^{tree}') ]] || git read-tree -m -u "$idx" HEAD || fail "bringing the main tree's files to main (a file changed there: the main tree stays clean)"
# submodules are left out: a merge that bumps a pin leaves the checkout behind it, and the
# submodule step below moves every submodule to main's pins
git diff --quiet --ignore-submodules && git diff --cached --quiet --ignore-submodules || fail "the main tree has uncommitted changes"
if [[ -d $MERGES ]]; then
  # main is brought into the write-back tree here: a boot reads no tree
  # a submodule behind main's new pin is not a change: --sync moves it, and names one that has changes
  # refused, it names the files (merges_catch_up). --sync then moves to the pins its HEAD records, so the write-back
  # tree holds main's pins before the build
  merges_catch_up "$MERGES"
  "$MAIN/bin/worktree" --sync "$MERGES" >/dev/null || fail "syncing $MERGES's submodules"
fi
git -c protocol.file.allow=always submodule update --init -q || fail "main's submodules"
nice -n 15 bin/build > target/update-build.log 2>&1 || { tail -5 target/update-build.log >&2; fail "build (target/update-build.log)" }
print "built $(ls -l target/seon | awk '{print $6, $7, $8}')"
bin/root stop >/dev/null 2>&1
out=$(bin/root start "$@") || fail "the standing root did not start (runs/root.log)"
# a root whose binary is another program than its main's forks no agent: the update's last line says so, with its acts
stale=$(print -r -- "$out" | grep -m1 '^ROOT STALE BINARY')
[[ -n $stale ]] || print -r -- "${out##*$'\n'}"
# what the verdict cache shows slow is work: root files a held task per slow test (docs/merging.md#a-slow-test-runs-last)
printf '{:op :eval :agent "root" :code "(my.root/file-slow-tests! sys)"}\n' | bin/ask "${$(bin/ports)%% *}" >/dev/null || print "filing the slow tests' tasks failed: run (my.root/file-slow-tests! sys) at root"
[[ -z $stale ]] || { print -r -- "UPDATE FAILED: $stale"; exit 1 }
print "UPDATE OK"
