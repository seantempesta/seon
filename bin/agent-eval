#!/usr/bin/env bb

;; Agent eval script - evaluates Clojure code in an agent session
;;
;; Usage: agent-eval <session-id> '<clojure-code>'
;;
;; This script:
;; 1. Queries the orchestrator for session-id -> port mapping
;; 2. Evaluates code on the agent's namespace nREPL
;; 3. Returns the result
;;
;; Examples:
;;   agent-eval acdb234f '(+ 1 2)'
;;   agent-eval acdb234f '(swap! *ctx* assoc :seon.trading/signals [...])'
;;   agent-eval acdb234f '(:seon.trading/signals @*ctx*)'

(require '[bencode.core :as b]
         '[clojure.string :as str])

(def orchestrator-port 7888)

;;; ---------------------------------------------------------------------------
;;; nREPL Communication (bencode)
;;; ---------------------------------------------------------------------------

(defn bytes->str
  "Convert bencode byte array to string."
  [x]
  (if (bytes? x)
    (String. ^bytes x "UTF-8")
    x))

(defn decode-msg
  "Decode bencode message, converting byte arrays to strings."
  [msg]
  (into {}
        (map (fn [[k v]]
               [(bytes->str k)
                (if (coll? v)
                  (mapv bytes->str v)
                  (bytes->str v))]))
        msg))

(defn nrepl-eval
  "Evaluate code via nREPL using bencode. Returns {:value ... :err ... :out ...}"
  [port code]
  (try
    (with-open [sock (java.net.Socket. "localhost" port)]
      (let [out (java.io.BufferedOutputStream. (.getOutputStream sock))
            in (java.io.PushbackInputStream. (.getInputStream sock))
            id (str (random-uuid))]
        ;; Send eval request
        (b/write-bencode out {"op" "eval" "code" code "id" id})
        (.flush out)
        ;; Read responses until done
        (loop [result {:value nil :err nil :out nil}]
          (let [msg (decode-msg (b/read-bencode in))
                status (get msg "status")
                value (get msg "value")
                err (get msg "err")
                stdout (get msg "out")]
            (let [result' (cond-> result
                            value (assoc :value value)
                            err (update :err str err)
                            stdout (update :out str stdout))]
              (if (and status (some #{"done"} status))
                result'
                (recur result')))))))
    (catch java.net.ConnectException e
      {:err (str "Connection failed to port " port ": " (.getMessage e))})
    (catch Exception e
      {:err (str "Error: " (.getMessage e))})))

;;; ---------------------------------------------------------------------------
;;; Session Port Lookup
;;; ---------------------------------------------------------------------------

(defn get-session-port
  "Query orchestrator for the nREPL port of a session."
  [session-id]
  (let [code (format "(do (require 'seon.orchestrator.session)
                          (:seon.orchestrator.session/nrepl-port
                            (seon.orchestrator.session/get-session-port
                              {:seon.orchestrator.session/node (user/xtdb-node)
                               :seon.orchestrator.session/id \"%s\"})))"
                     session-id)
        result (nrepl-eval orchestrator-port code)]
    (when-let [value (:value result)]
      (when (and value (not= "nil" value))
        (parse-long value)))))

;;; ---------------------------------------------------------------------------
;;; Main
;;; ---------------------------------------------------------------------------

(defn usage []
  (println "Usage: agent-eval <session-id> '<clojure-code>'")
  (println "")
  (println "Examples:")
  (println "  agent-eval acdb234f '(+ 1 2)'")
  (println "  agent-eval acdb234f '(swap! *ctx* assoc :seon.trading/signals [...])'")
  (println "  agent-eval acdb234f '(@*ctx*)'")
  (System/exit 1))

(defn -main [& args]
  (when (< (count args) 2)
    (usage))

  (let [session-id (first args)
        code (str/join " " (rest args))]

    ;; Validate session ID format (8 hex chars)
    (when-not (re-matches #"[a-f0-9]{8}" session-id)
      (binding [*out* *err*]
        (println (str "Invalid session ID: " session-id))
        (println "Session ID must be 8 lowercase hex characters"))
      (System/exit 1))

    ;; Look up session port
    (let [port (get-session-port session-id)]
      (when-not port
        (binding [*out* *err*]
          (println (str "Session not found or not running: " session-id))
          (println "")
          (println "Possible causes:")
          (println "  - Session was stopped")
          (println "  - Session ID is incorrect")
          (println "  - Orchestrator is not running"))
        (System/exit 1))

      ;; Evaluate on the agent's nREPL
      (let [result (nrepl-eval port code)]
        ;; Print stdout if any
        (when-let [stdout (:out result)]
          (print stdout))
        ;; Print stderr if any
        (when-let [stderr (:err result)]
          (binding [*out* *err*]
            (print stderr)))
        ;; Print value
        (when-let [value (:value result)]
          (println value))
        ;; Exit with error if there was an error
        (when (:err result)
          (System/exit 1))))))

(apply -main *command-line-args*)
