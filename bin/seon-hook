#!/usr/bin/env bb

;; Direct Babashka hook for Clojure and Markdown edits.
;;
;; This script:
;; 1. Receives hook events from Codex or Claude Code (JSON on stdin)
;; 2. Loads configuration from .claude/seon-hook.edn
;; 3. Validates prospective Clojure syntax before an edit
;; 4. Runs the canonical Markdown/docstring linters after an edit
;; 5. Runs the live core-fault gate
;;
;; It has no running Seon-process dependency. Pure linter namespaces load
;; directly into Babashka only for the file type that needs them.

(require '[babashka.deps :as deps]
         '[babashka.process :as process]
         '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str]

         '[edamame.core :as edamame])

;;; ---------------------------------------------------------------------------
;;; Paths
;;; ---------------------------------------------------------------------------

;; This script's location is the authority. Environment cwd/project variables
;; describe the caller and may point at another checkout when a globally
;; installed hook fires; they must never redirect Seon's checks or artifacts.
(def repo-root
  (some-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getPath))

(defn- root-file
  "A java.io.File for `parts` resolved from the repo root."
  ^java.io.File [& parts]
  (apply io/file repo-root parts))

(def config-path (root-file ".claude/seon-hook.edn"))

;;; ---------------------------------------------------------------------------
;;; Logging
;;; ---------------------------------------------------------------------------

(def hook-log-path (root-file "logs/hook-debug.log"))
(def hook-log-cap (* 1024 1024))

(defn- log!
  "Append one line to the bounded hook diagnostic log. Never throws."
  [& parts]
  (try
    (let [log-dir (root-file "logs")
          obsolete (root-file "logs/hook-debug.log.1")
          line (.getBytes
                (str (java.util.Date.) " | " (str/join " | " parts) "\n")
                "UTF-8")]
      (when-not (.exists log-dir) (.mkdirs log-dir))
      (when (.exists obsolete) (.delete obsolete))
      (with-open [raf (java.io.RandomAccessFile. hook-log-path "rw")
                  channel (.getChannel raf)
                  lock (.lock channel)]
        (when (> (.size channel) hook-log-cap)
          (.truncate channel 0))
        (.position channel (.size channel))
        (.write channel (java.nio.ByteBuffer/wrap line))))
    (catch Exception _ nil)))

;;; ---------------------------------------------------------------------------
;;; Configuration
;;; ---------------------------------------------------------------------------

(defn- load-config []
  (let [f (io/file config-path)]
    (if (.exists f)
      (try (edn/read-string (slurp f)) (catch Exception _ {}))
      {})))

(defn- output! [response]
  (when (seq response)
    (println (json/generate-string response))))

;;; ---------------------------------------------------------------------------
;;; File Type Detection
;;; ---------------------------------------------------------------------------

(defn- clojure-file? [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (some #(clojure.string/ends-with? lower-path %)
            [".clj" ".cljs" ".cljc" ".bb" ".edn"]))))

(defn- claude-file-path [event]
  (or (get-in event [:tool_input :file_path])
      (get-in event [:tool_input :filePath])))

(defn- patch-file-paths
  "Return every source and destination path named by a Codex patch."
  [patch]
  (when (string? patch)
    (->> (concat
           (map second
                (re-seq
                  #"(?m)^\*\*\* (?:Add|Update|Delete) File: (.+?)\r?$"
                  patch))
           (map second
                (re-seq #"(?m)^\*\*\* Move to: (.+?)\r?$" patch)))
         (map str/trim)
         (remove str/blank?)
         distinct
         vec)))

(defn- event-file-paths
  "Normalize the complete path set from Codex and Claude edit payloads."
  [event]
  (if (= "apply_patch" (:tool_name event))
    (patch-file-paths (get-in event [:tool_input :command]))
    (some-> (claude-file-path event) vector)))

(defn- get-file-path [event]
  (or (:seon.hook/file-path event)
      (first (event-file-paths event))))

(defn- absolute-file-path [file-path]
  (try
    (when file-path
      (let [file (io/file file-path)]
        (.getPath (.getCanonicalFile
                    (if (.isAbsolute file) file (root-file file-path))))))
    (catch Exception _ nil)))

(defn- repository-file?
  "True when the canonical event path is inside this script's checkout."
  [file-path]
  (when-let [path (absolute-file-path file-path)]
    (let [prefix (str repo-root java.io.File/separator)]
      (or (= path repo-root) (str/starts-with? path prefix)))))

;;; ---------------------------------------------------------------------------
;;; Syntax Validation
;;; ---------------------------------------------------------------------------

(defn- validate-clojure-syntax [code-string]
  ;; Use edamame with permissive options to validate syntax without requiring
  ;; runtime context (namespace aliases, reader tags like #env, #profile, etc.)
  (try
    (edamame/parse-string-all
     code-string
     {:all true                              ; Parse all forms
      :read-cond :allow                      ; Allow reader conditionals
      :features #{:clj :cljs}                ; Support both Clojure and ClojureScript
      :auto-resolve (fn [alias] (if alias (symbol (str "ns." alias)) 'user))  ; Unique ns per alias
      :readers (fn [_tag] identity)})        ; Accept any reader tag
    {:valid true}
    (catch Exception e
      {:valid false :error (.getMessage e)})))

(defn- reconstruct-file-content [event]
  (let [tool-name (:tool_name event)
        tool-input (:tool_input event)
        file-path (get-file-path event)]
    (cond
      (= tool-name "Write")
      (:content tool-input)

      (= tool-name "Edit")
      (let [old-string (:old_string tool-input)
            new-string (:new_string tool-input)]
        (when (and file-path old-string)
          (try
            (let [current (slurp (absolute-file-path file-path))]
              (if (:replace_all tool-input)
                (clojure.string/replace current old-string new-string)
                (clojure.string/replace-first current old-string new-string)))
            (catch Exception _ nil))))

      :else nil)))

;;; ---------------------------------------------------------------------------
;;; Validation Functions (return block response or nil)
;;; ---------------------------------------------------------------------------

(defn- validate-clojure-edit
  "Validate syntax for ANY Clojure file edit. Returns block response or nil."
  [event]
  (let [file-path (get-file-path event)]
    (when (and (= (:hook_event_name event) "PreToolUse")
               (clojure-file? file-path))
      (when-let [new-content (reconstruct-file-content event)]
        (let [validation (validate-clojure-syntax new-content)]
          (when-not (:valid validation)
            {:decision "block"
             :reason (str "BLOCKED: Invalid Clojure syntax.\n\n"
                          "Error: " (:error validation) "\n\n"
                          "Your edit would create broken code. Check:\n"
                          "1. Balanced delimiters (parens, brackets, braces)\n"
                          "2. old_string matches file content exactly\n"
                          "3. new_string is complete, valid Clojure\n\n"
                          "TIP: If struggling, try Write to replace the entire function.")}))))))

(defn- clojure-syntax-feedback
  "Report invalid syntax in an edited file after the tool has written it."
  [event]
  (let [file-path (get-file-path event)
        absolute-path (absolute-file-path file-path)]
    (when (and (= (:hook_event_name event) "PostToolUse")
               (clojure-file? file-path)
               absolute-path
               (.isFile (io/file absolute-path)))
      (try
        (let [validation (validate-clojure-syntax (slurp absolute-path))]
          (when-not (:valid validation)
            (str "Invalid Clojure syntax after editing " file-path ": "
                 (:error validation))))
        (catch Exception e
          (str "Could not validate " file-path ": " (.getMessage e)))))))

;;; ---------------------------------------------------------------------------
;;; Markdown File Detection
;;; ---------------------------------------------------------------------------

(defn- docs-markdown-file?
  "Returns true if file-path is a .md file under docs/."
  [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (and (clojure.string/ends-with? lower-path ".md")
           (or (clojure.string/starts-with? lower-path "docs/")
               (clojure.string/includes? lower-path "/docs/"))))))

(defn- clojure-source-file? [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (some #(str/ends-with? lower %) [".clj" ".cljs" ".cljc"]))))

(defn- load-direct-check! [namespace]
  ;; The hook itself stays a fast, dependency-free bb script. Malli is needed
  ;; only because the canonical pure linters carry their public schemas.
  (deps/add-deps
   {:deps {'seon/hook-source {:local/root repo-root}}})
  (require namespace))

(defn- markdown-feedback [event config]
  (when (and (= (:hook_event_name event) "PostToolUse")
             (get-in config [:markdown-lint :enabled] true)
             (docs-markdown-file? (get-file-path event)))
    (try
      (load-direct-check! 'seon.dev.markdown)
      (let [file-path (absolute-file-path (get-file-path event))
            validate-file (requiring-resolve 'seon.dev.markdown/validate-file)
            fix (requiring-resolve 'seon.dev.markdown/fix)
            format-violations (requiring-resolve 'seon.dev.markdown/format-violations)
            request {:seon.dev.markdown/file-path file-path
                     :seon.dev.markdown/vault-root (str (root-file "docs"))}
            initial (validate-file request)
            _ (when-not (:seon.dev.markdown/valid? initial)
                (let [fixed (fix {:seon.dev.markdown/content (slurp file-path)})]
                  (when (pos? (:seon.dev.markdown/fixed-count fixed))
                    (spit file-path (:seon.dev.markdown/content fixed)))))
            final (if (:seon.dev.markdown/valid? initial)
                    initial
                    (validate-file request))]
        (when-not (:seon.dev.markdown/valid? final)
          (:seon.dev.markdown/formatted
           (format-violations
            {:seon.dev.markdown/violations (:seon.dev.markdown/violations final)
             :seon.dev.markdown/max-length (get-in config [:feedback :max-length] 1000)}))))
      (catch Exception e
        (log! "MARKDOWN_LINT_ERROR" (.getMessage e))
        nil))))

(defn- docstring-feedback [event config]
  (when (and (= (:hook_event_name event) "PostToolUse")
             (get-in config [:docstring-lint :enabled] true)
             (clojure-source-file? (get-file-path event)))
    (try
      (load-direct-check! 'seon.dev.docstring)
      (let [check-file (requiring-resolve 'seon.dev.docstring/check-file)
            format-findings (requiring-resolve 'seon.dev.docstring/format-findings)
            result (check-file
                    {:seon.dev.docstring/file-path
                     (absolute-file-path (get-file-path event))})]
        (when-not (:seon.dev.docstring/clean? result)
          (:seon.dev.docstring/formatted
           (format-findings
            {:seon.dev.docstring/findings (:seon.dev.docstring/findings result)
             :seon.dev.docstring/max-length (get-in config [:feedback :max-length] 1000)}))))
      (catch Exception e
        (log! "DOCSTRING_LINT_ERROR" (.getMessage e))
        nil))))

(defn- cljs-test-path? [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (or (str/ends-with? lower ".cljs")
          (str/ends-with? lower ".cljc")))))

(defn- changed-test-feedback [event config]
  (let [paths (->> (event-file-paths event)
                   (filter cljs-test-path?)
                   vec)
        invalid-source?
        (some (fn [path]
                (let [absolute (absolute-file-path path)]
                  (and absolute
                       (.isFile (io/file absolute))
                       (not (:valid
                              (validate-clojure-syntax (slurp absolute)))))))
              paths)]
    (when (and (= (:hook_event_name event) "PostToolUse")
               (get-in config [:changed-tests :enabled] true)
               (seq paths)
               (not invalid-source?))
      (try
        (let [argv (into [(str (root-file "bin/seon")) "test" "changed"]
                         (mapcat #(vector "--path" %) paths))
              result (process/sh {:cmd argv
                                  :dir repo-root
                                  :env (into {} (System/getenv))
                                  :out :string
                                  :err :string
                                  :continue true})
              output (str/trim (str (:out result) (:err result)))]
          (str "ADVISORY — the edit was accepted; tests never gate refactoring.\n"
               (if (str/blank? output)
                 (str "Changed-test operation exited " (:exit result)
                      " without output.")
                 output)))
        (catch Exception error
          (str "ADVISORY — changed-test feedback could not run: "
               (.getMessage error)))))))


;;; ---------------------------------------------------------------------------
;;; Core-fault strict gate (error-blame-strict-gate, RULED 2026-07-04).
;;; seon.error/record! prints one `SEON-CORE-FAULT …` line into logs/pod.log
;;; per :seon.error/fault :core error (CORE bugs only — :agent faults never
;;; mark, never gate). This bb-direct check brackets "the run" as the pod-log
;;; bytes appended since the LAST hook check (offset in tmp/.core-fault-offset)
;;; and BLOCKS the edit under the manifest dial :seon.config/on-core-error
;;; :gate/:crash (the default is :gate); :log disables it. First run arms the
;;; offset silently (no ancient backlog); a truncated/rotated log rescans from
;;; the top (every line is new).
;;; ---------------------------------------------------------------------------

(def core-fault-offset-path (root-file "tmp/.core-fault-offset"))
(def pod-log-path (root-file "logs/pod.log"))

(defn- core-fault-dial []
  (let [configured (or (System/getenv "SEON_CONFIG") "config/system.edn")
        configured-file (io/file configured)
        manifest (if (.isAbsolute configured-file)
                   configured-file
                   (io/file repo-root configured))]
    (or (when (.exists manifest)
          (second (re-find #":seon\.config/on-core-error\s+(:[a-z]+)"
                           (slurp manifest))))
        ":gate")))

(defn- core-fault-gate!
  "Block-response when NEW SEON-CORE-FAULT markers landed in logs/pod.log
   since the last check; nil otherwise (and on any internal error)."
  [event]
  (try
    (when (and (= (:hook_event_name event) "PostToolUse")
               (clojure-file? (get-file-path event))
               (not= ":log" (core-fault-dial))
               (.exists pod-log-path))
      (let [size   (.length pod-log-path)
            stored (try (Long/parseLong (str/trim (slurp core-fault-offset-path)))
                        (catch Exception _ nil))
            start  (cond
                     (nil? stored)   size ; first run: arm only
                     (> stored size) 0    ; log truncated/rotated: all new
                     :else           stored)
            _ (do (io/make-parents core-fault-offset-path)
                  (spit core-fault-offset-path (str size)))
            new-text (when (< start size)
                       (with-open [raf (java.io.RandomAccessFile. pod-log-path "r")]
                         (.seek raf start)
                         (let [buf (byte-array (int (min (- size start) (* 4 1024 1024))))]
                           (.readFully raf buf)
                           (String. buf "UTF-8"))))
            markers (when new-text
                      (->> (str/split-lines new-text)
                           (filter #(str/includes? % "SEON-CORE-FAULT"))
                           (take 10)
                           (map #(subs % 0 (min (count %) 300)))))]
        (when (seq markers)
          (log! "CORE_FAULT_GATE" (str (count markers) " new marker(s)"))
          {:decision "block"
           :reason (str "CORE-FAULT GATE (:seon.config/on-core-error "
                        (core-fault-dial) "): the live pod recorded NEW "
                        ":seon.error/fault :core error(s) since the last hook "
                        "check — CORE bugs (our machinery), never agent errors. "
                        "Inspect + fix before continuing. Query the datoms: "
                        "'[:find ?e :where [?e :seon.error/fault :core]] ; "
                        "freeze the db one saw: (seon.db/as-of <:seon.error/at>). "
                        "Markers:\n"
                        (str/join "\n" markers))})))
    (catch Exception e
      (log! "CORE_FAULT_GATE_ERROR" (.getMessage e))
      nil)))

(defn- feedback-response [feedback]
  (let [messages (vec (remove str/blank? feedback))]
    (if (seq messages)
      {:continue true
       :hookSpecificOutput
       {:hookEventName "PostToolUse"
        :additionalContext (str/join "\n\n" messages)}}
      {:continue true})))

;;; ---------------------------------------------------------------------------
;;; Main Entry Point
;;; ---------------------------------------------------------------------------

(defn -main []
  (let [event (try
                (json/parse-string (slurp *in*) true)
                (catch Exception _ nil))
        file-paths (event-file-paths event)
        event-name (:hook_event_name event)
        tool-name (:tool_name event)
        edit-event? (and (#{"PreToolUse" "PostToolUse"} event-name)
                         (#{"apply_patch" "Edit" "Write"} tool-name))
        local-paths (filterv repository-file? file-paths)
        mixed-scope? (and (seq local-paths)
                          (not= (count local-paths) (count file-paths)))
        local-edit? (and edit-event?
                         (seq file-paths)
                         (= (count local-paths) (count file-paths)))]
    (if mixed-scope?
      (output! {:decision "block"
                :reason "BLOCKED: one edit cannot mix Seon files with paths outside this checkout."})
      (if-not local-edit?
      (output! {:continue true})
      (try
        (let [config (load-config)]
          (log! event-name
                (str "tool=" tool-name)
                (str "session=" (or (:session_id event) "orchestrator"))
                (str "files=" (str/join "," file-paths)))
          (if (= event-name "PreToolUse")
            (if (get-in config [:lint :enabled] true)
              (let [blocked (some validate-clojure-edit
                                  (map #(assoc event :seon.hook/file-path %)
                                       file-paths))]
                (if blocked
                  (do
                    (log! "CLOJURE_BLOCK" (:reason blocked))
                    (output! blocked))
                  (output! {:continue true})))
              (output! {:continue true}))
            (let [path-events (map #(assoc event :seon.hook/file-path %)
                                   file-paths)
                  feedback (mapcat
                             (fn [path-event]
                               [(clojure-syntax-feedback path-event)
                                (markdown-feedback path-event config)
                                (docstring-feedback path-event config)])
                             path-events)
                  feedback (conj (vec feedback)
                                 (changed-test-feedback event config))
                  clojure-event (some #(when (clojure-file? (get-file-path %)) %)
                                      path-events)
                  gate (when clojure-event (core-fault-gate! clojure-event))]
              (output! (or gate (feedback-response feedback))))))
        (catch Exception e
          (log! "ERROR" (.getMessage e))
          (binding [*out* *err*]
            (println "HOOK ERROR:" (.getMessage e)))
          (output! {:continue true})))))))

(-main)
