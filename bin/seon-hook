#!/usr/bin/env bb

;; Thin Babashka hook for Claude Code
;;
;; This script:
;; 1. Receives hook events from Claude Code (JSON on stdin)
;; 2. Loads configuration from .claude/seon-hook.edn
;; 3. Communicates with running Seon server via nREPL (bencode)
;; 4. Calls seon.dev.hook/process-hook-event! with the event
;; 5. Returns the response as JSON to stdout
;;
;; All logic lives in seon.dev.hook - this is just the communication layer.

(require '[bencode.core :as b]
         '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str]
         '[babashka.process :as process]

         '[edamame.core :as edamame])

;;; ---------------------------------------------------------------------------
;;; Constants
;;; ---------------------------------------------------------------------------

(def orchestrator-port 7888)

;; Hooks run with cwd set to wherever the session happens to be (often the
;; edited file's tree), so EVERY artifact path must resolve from the repo
;; root, never from user.dir. CLAUDE_PROJECT_DIR is set by the Claude Code
;; hook harness (settings.json already uses it for the command path); the
;; fallback is this script's own location (bin/seon-hook -> repo root).
;; NOTE: `git rev-parse --show-toplevel` would be WRONG here — inside a
;; reference-code/ submodule it returns the submodule root.
(def repo-root
  (or (System/getenv "CLAUDE_PROJECT_DIR")
      (some-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getPath)
      (System/getProperty "user.dir")))

(defn- root-file
  "A java.io.File for `parts` resolved from the repo root."
  ^java.io.File [& parts]
  (apply io/file repo-root parts))

(def config-path (root-file ".claude/seon-hook.edn"))
(def backup-dir (root-file "tmp/hook-backup"))

;; bb-direct Gemini review (runtime-independent — needs no JVM, no pod):
;; the conventions rubric + a file-based rate-limit timestamp.
(def conventions-path (root-file "docs/conventions.md"))
(def last-review-path (root-file "tmp/.last-review"))
;; Batch accumulator: absolute file-paths edited since the last review, one per
;; line, deduped. A review covers this whole batch then clears it. bb is a fresh
;; process per invocation, so this lives on disk (no in-memory atom possible).
(def pending-review-path (root-file "tmp/.pending-review"))
;; Hard cap so a permanently-failing agy call can't grow the batch unbounded:
;; when the pending list exceeds this, the oldest entries are dropped.
(def max-pending-files 50)

(def protected-files
  "Files that are critical to the hook system."
  #{"src/seon/dev/hook.clj" "bin/seon-hook"})

;;; ---------------------------------------------------------------------------
;;; Logging
;;; ---------------------------------------------------------------------------

(defn- log!
  "Append a log line to logs/hook-debug.log."
  [& parts]
  (let [log-dir (root-file "logs")]
    (when-not (.exists log-dir) (.mkdirs log-dir))
    (spit (io/file log-dir "hook-debug.log")
          (str (java.util.Date.) " | " (clojure.string/join " | " parts) "\n")
          :append true)))

(defn- log-agent!
  "Write to agent-specific log file if this is an agent session."
  [seon-session-id tool-name file-path decision feedback]
  (when (and seon-session-id (re-matches #"[A-Za-z0-9]{4,6}" seon-session-id))
    (let [agent-log-file (root-file "logs" "agents" (str seon-session-id ".log"))
          timestamp (.format (java.time.format.DateTimeFormatter/ofPattern "yyyy-MM-dd'T'HH:mm:ss'Z'")
                             (.atOffset (java.time.Instant/now) java.time.ZoneOffset/UTC))
          file-name (when file-path (last (clojure.string/split file-path #"/")))
          details (if feedback (str decision " | " feedback) decision)
          log-line (str timestamp " | HOOK     | " (or tool-name "unknown")
                        " | " (or file-name "unknown") " | " details "\n")]
      (when (.exists (.getParentFile agent-log-file))
        (spit agent-log-file log-line :append true)))))

;;; ---------------------------------------------------------------------------
;;; Configuration
;;; ---------------------------------------------------------------------------

(defn- load-config []
  (let [f (io/file config-path)]
    (if (.exists f)
      (try (edn/read-string (slurp f)) (catch Exception _ {}))
      {})))

;;; ---------------------------------------------------------------------------
;;; nREPL Communication
;;; ---------------------------------------------------------------------------

(defn- bytes->str [x]
  (if (bytes? x) (String. ^bytes x "UTF-8") x))

(defn- decode-msg [msg]
  (into {}
        (map (fn [[k v]]
               [(bytes->str k)
                (if (coll? v) (mapv bytes->str v) (bytes->str v))]))
        msg))

(defn- nrepl-eval [port code]
  (try
    (with-open [sock (java.net.Socket. "localhost" port)]
      (let [out (java.io.BufferedOutputStream. (.getOutputStream sock))
            in (java.io.PushbackInputStream. (.getInputStream sock))
            id (str (random-uuid))]
        (b/write-bencode out {"op" "eval" "code" code "id" id})
        (.flush out)
        (loop [result nil]
          (let [msg (decode-msg (b/read-bencode in))
                status (get msg "status")
                err (get msg "err")]
            (when err (binding [*out* *err*] (println "NREPL ERROR:" err)))
            (if (and status (some #{"done"} status))
              result
              (recur (or (get msg "value") result)))))))
    (catch java.net.ConnectException e
      (binding [*out* *err*] (println "NREPL CONNECT ERROR:" (.getMessage e)))
      nil)
    (catch Exception e
      (binding [*out* *err*] (println "NREPL EXCEPTION:" (.getMessage e)))
      nil)))

;;; ---------------------------------------------------------------------------
;;; Session Resolution
;;; ---------------------------------------------------------------------------

(defn- lookup-seon-session [session-id]
  (if (and session-id (> (count session-id) 8))
    (let [map-file (root-file "logs" "session-map.edn")]
      (if (.exists map-file)
        (try
          (get (edn/read-string (slurp map-file)) session-id session-id)
          (catch Exception _ session-id))
        session-id))
    session-id))

(defn- get-port-for-session [_session-id]
  ;; All sessions route to the single Seon nREPL. The per-session multi-port
  ;; routing (seon.orchestrator.session/get-session-port) was XTDB-era
  ;; JVM-orchestrator machinery and has been retired — there is one nREPL.
  orchestrator-port)

;;; ---------------------------------------------------------------------------
;;; Response Formatting
;;; ---------------------------------------------------------------------------

(defn- format-response [result]
  (when result
    (let [continue? (get result :seon.dev.hook/continue)
          decision (get result :seon.dev.hook/decision)
          reason (get result :seon.dev.hook/reason)
          feedback (get result :seon.dev.hook/feedback)]
      (cond
        (= decision "block")
        {:decision "block" :reason (or reason "Blocked by hook")}

        (seq feedback)
        {:continue true
         :hookSpecificOutput {:hookEventName "PostToolUse"
                              :additionalContext (clojure.string/join "\n" feedback)}}

        continue? {:continue true}
        :else {:continue true}))))

(defn- output! [response]
  (when (seq response)
    (println (json/generate-string response))))

(defn- block! [reason]
  (output! {:decision "block" :reason reason}))

(defn- continue! []
  (output! {:continue true}))

;;; ---------------------------------------------------------------------------
;;; File Type Detection
;;; ---------------------------------------------------------------------------

(defn- clojure-file? [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (some #(clojure.string/ends-with? lower-path %)
            [".clj" ".cljs" ".cljc" ".bb" ".edn"]))))

(defn- critical-file? [file-path]
  (when file-path
    (some #(clojure.string/ends-with? file-path %) protected-files)))

(defn- get-file-path [event]
  (or (get-in event [:tool_input :file_path])
      (get-in event [:tool_input :filePath])))

;;; ---------------------------------------------------------------------------
;;; Syntax Validation
;;; ---------------------------------------------------------------------------

(defn- validate-clojure-syntax [code-string]
  ;; Use edamame with permissive options to validate syntax without requiring
  ;; runtime context (namespace aliases, reader tags like #env, #profile, etc.)
  (try
    (edamame/parse-string-all
     code-string
     {:all true                              ; Parse all forms
      :read-cond :allow                      ; Allow reader conditionals
      :features #{:clj :cljs}                ; Support both Clojure and ClojureScript
      :auto-resolve (fn [alias] (if alias (symbol (str "ns." alias)) 'user))  ; Unique ns per alias
      :readers (fn [_tag] identity)})        ; Accept any reader tag
    {:valid true}
    (catch Exception e
      {:valid false :error (.getMessage e)})))

(defn- reconstruct-file-content [event]
  (let [tool-name (:tool_name event)
        tool-input (:tool_input event)
        file-path (get-file-path event)]
    (cond
      (= tool-name "Write")
      (:content tool-input)

      (= tool-name "Edit")
      (let [old-string (:old_string tool-input)
            new-string (:new_string tool-input)]
        (when (and file-path old-string)
          (try
            (let [current (slurp file-path)]
              (if (:replace_all tool-input)
                (clojure.string/replace current old-string new-string)
                (clojure.string/replace-first current old-string new-string)))
            (catch Exception _ nil))))

      :else nil)))

;;; ---------------------------------------------------------------------------
;;; Validation Functions (return block response or nil)
;;; ---------------------------------------------------------------------------

(defn- validate-clojure-edit
  "Validate syntax for ANY Clojure file edit. Returns block response or nil."
  [event]
  (let [file-path (get-file-path event)]
    (when (and (= (:hook_event_name event) "PreToolUse")
               (clojure-file? file-path))
      (when-let [new-content (reconstruct-file-content event)]
        (let [validation (validate-clojure-syntax new-content)]
          (when-not (:valid validation)
            {:decision "block"
             :reason (str "BLOCKED: Invalid Clojure syntax.\n\n"
                          "Error: " (:error validation) "\n\n"
                          "Your edit would create broken code. Check:\n"
                          "1. Balanced delimiters (parens, brackets, braces)\n"
                          "2. old_string matches file content exactly\n"
                          "3. new_string is complete, valid Clojure\n\n"
                          "TIP: If struggling, try Write to replace the entire function.")}))))))

(defn- validate-critical-edit
  "Extra validation for critical hook files. Returns block response or nil."
  [event]
  (let [file-path (get-file-path event)]
    (when (and (= (:hook_event_name event) "PreToolUse")
               (critical-file? file-path)
               (clojure.string/ends-with? file-path ".clj"))
      (when-let [new-content (reconstruct-file-content event)]
        (let [validation (validate-clojure-syntax new-content)]
          (when-not (:valid validation)
            {:decision "block"
             :reason (str "BLOCKED: Syntax error in critical hook file.\n\n"
                          "Error: " (:error validation) "\n\n"
                          "This edit would break the hook system.")}))))))

;;; ---------------------------------------------------------------------------
;;; Backup/Restore for Critical Files
;;; ---------------------------------------------------------------------------

(defn- backup-critical-files! []
  (let [backup-dir-file backup-dir]
    (when-not (.exists backup-dir-file) (.mkdirs backup-dir-file))
    (doseq [file-path protected-files]
      (let [file (root-file file-path)]
        (when (.exists file)
          (let [content (slurp file)
                validation (validate-clojure-syntax content)]
            (when (:valid validation)
              (let [filename (last (clojure.string/split file-path #"/"))]
                (spit (io/file backup-dir filename) content)))))))))

(defn- restore-from-backup-if-needed! []
  (doseq [file-path protected-files]
    (let [file (root-file file-path)]
      (when (.exists file)
        (let [content (slurp file)
              validation (validate-clojure-syntax content)]
          (when-not (:valid validation)
            (let [filename (last (clojure.string/split file-path #"/"))
                  backup-file (io/file backup-dir filename)]
              (when (.exists backup-file)
                (spit file (slurp backup-file))
                (log! "RESTORED" file-path "Error was:" (:error validation))))))))))

;;; ---------------------------------------------------------------------------
;;; Markdown File Detection
;;; ---------------------------------------------------------------------------

(defn- docs-markdown-file?
  "Returns true if file-path is a .md file under docs/."
  [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (and (clojure.string/ends-with? lower-path ".md")
           (or (clojure.string/starts-with? lower-path "docs/")
               (clojure.string/includes? lower-path "/docs/"))))))


;;; ---------------------------------------------------------------------------
;;; bb-direct Gemini review (runtime-independent)
;;; ---------------------------------------------------------------------------
;;;
;;; A code review is an LLM call over the edited source + the conventions
;;; rubric. It needs NO Clojure REPL and NO JVM. We shell to the project's
;;; `agy` Gemini CLI directly from bb, so the review fires for .clj, .cljs,
;;; .cljc, .bb, .edn AND .md uniformly — including when the JVM nREPL (port
;;; 7888) is down, which is the normal state on the CLJS-pod track.
;;;
;;; Double-review avoidance: the JVM PostToolUse pipeline (process-via-nrepl!)
;;; ALSO runs a Gemini review, but ONLY for JVM-loadable .clj/.cljc files AND
;;; ONLY when the JVM nREPL is actually reachable. So we skip the bb review for
;;; a .clj/.cljc file when the JVM is up (let the in-JVM path own it); for
;;; everything else (.cljs/.md, or .clj with the JVM down) the bb review runs.

(defn- reviewable-file?
  "True for source/test/markdown files worth an AI review."
  [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (or (clojure-file? file-path)
          (str/ends-with? lower ".md")))))

(defn- jvm-clj-file?
  "True for .clj/.cljc files the JVM nREPL pipeline can itself review."
  [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (or (str/ends-with? lower ".clj")
          (str/ends-with? lower ".cljc")))))

(defn- jvm-reachable?
  "Quick socket probe of the JVM nREPL. Used only to avoid double-reviewing
   .clj/.cljc files when the in-JVM review pipeline is alive."
  []
  (try
    (with-open [sock (java.net.Socket.)]
      (.connect sock (java.net.InetSocketAddress. "localhost" ^int orchestrator-port) 300)
      true)
    (catch Exception _ false)))

(defn- review-rate-limited?
  "File-based interval gate. bb is a fresh process per invocation, so the
   last-review timestamp lives on disk (tmp/.last-review). Returns true if a
   review happened within interval-seconds."
  [interval-seconds]
  (let [f (io/file last-review-path)]
    (and (.exists f)
         (try
           (let [last-ms (Long/parseLong (str/trim (slurp f)))
                 elapsed (- (System/currentTimeMillis) last-ms)]
             (< elapsed (* 1000 interval-seconds)))
           (catch Exception _ false)))))

(defn- touch-last-review! []
  (try
    (let [f (io/file last-review-path)]
      (when-not (.exists (.getParentFile f)) (.mkdirs (.getParentFile f)))
      (spit f (str (System/currentTimeMillis))))
    (catch Exception _ nil)))

(defn- read-pending
  "Read the pending-review accumulator as a vector of absolute paths (in edit
   order, deduped on write). Never throws — returns [] on any problem."
  []
  (try
    (let [f (io/file pending-review-path)]
      (if (.exists f)
        (->> (str/split-lines (slurp f))
             (map str/trim)
             (remove str/blank?)
             (vec))
        []))
    (catch Exception _ [])))

(defn- write-pending!
  "Overwrite the accumulator with `paths` (already deduped/ordered)."
  [paths]
  (try
    (let [f (io/file pending-review-path)]
      (when-not (.exists (.getParentFile f)) (.mkdirs (.getParentFile f)))
      (spit f (str (str/join "\n" paths) (when (seq paths) "\n"))))
    (catch Exception _ nil)))

(defn- accumulate-pending!
  "Append `file-path` to the pending-review accumulator, deduped, preserving
   edit order (an existing path moves to the most-recent position so the latest
   edit isn't the one dropped under the cap). Drops oldest entries beyond
   max-pending-files. Wrapped so a failure here NEVER blocks the edit."
  [file-path]
  (try
    (when (seq file-path)
      (let [current (vec (remove #(= % file-path) (read-pending)))
            appended (conj current file-path)
            capped (if (> (count appended) max-pending-files)
                     (let [dropped (- (count appended) max-pending-files)]
                       (log! "REVIEW_PENDING_CAP" (str "dropped=" dropped))
                       (vec (drop dropped appended)))
                     appended)]
        (write-pending! capped)))
    (catch Exception e
      (log! "REVIEW_PENDING_ERROR" (.getMessage e))
      nil)))

(defn- clear-pending! []
  (try
    (let [f (io/file pending-review-path)]
      (when (.exists f) (.delete f)))
    (catch Exception _ nil)))

(defn- load-conventions
  "Load the conventions rubric, truncated."
  [max-len]
  (let [f (io/file conventions-path)]
    (when (.exists f)
      (let [s (slurp f)]
        (if (> (count s) max-len)
          (str (subs s 0 max-len) "\n[truncated]")
          s)))))

(defn- file-lang
  [file-path]
  (if (str/ends-with? (str/lower-case file-path) ".md") "markdown" "clojure"))

(defn- render-file-block
  "Render one delimited, fenced file block for the review prompt, truncating the
   content to `max-code-length`."
  [{:keys [path content]} max-code-length]
  (let [code (if (> (count content) max-code-length)
               (str (subs content 0 max-code-length) "\n[truncated]")
               content)]
    (str "=== EDITED FILE: " path " ===\n"
         "```" (file-lang path) "\n" code "\n```\n")))

(defn- build-review-prompt
  "Build the Gemini review prompt: instruction + conventions rubric (once) + one
   delimited, fenced block per edited file. `files` is a seq of {:path :content}.
   The conventions rubric is emitted once at the top; each file is truncated to
   max-code-length, and the whole batch is bounded to roughly max-code-length
   total — once the running total is exceeded, remaining (oldest-first) files are
   dropped with a log line so the batch can't blow the context.

   Single-file arity [path content opts] delegates to the batch arity."
  ([file-path content opts]
   (build-review-prompt [{:path file-path :content content}] opts))
  ([files {:keys [max-code-length max-conventions-length]
           ;; The conventions rubric is the STANDARD being checked — the review
           ;; must see ALL of it (a conformance check on 13% of the rules is
           ;; useless). gemini-3.5-flash has a huge context window, so send the
           ;; whole doc; the cap is pure safety headroom over its current ~30K.
           :or {max-code-length 12000 max-conventions-length 60000}}]
   (let [conventions (load-conventions max-conventions-length)
         files (vec files)
         ;; Keep the most-recent files (tail) when the batch overflows the total
         ;; cap; drop oldest. Walk newest-first; once the running total would
         ;; exceed max-code-length, stop and count the rest as dropped. Always
         ;; keep at least the newest block.
         {:keys [kept]}
         (reduce (fn [{:keys [kept total]} f]
                   (let [block-len (count (render-file-block f max-code-length))]
                     (if (or (empty? kept) (<= (+ total block-len) max-code-length))
                       {:kept (conj kept f) :total (+ total block-len)}
                       (reduced {:kept kept :total total}))))
                 {:kept [] :total 0}
                 (reverse files))
         dropped (- (count files) (count kept))
         ordered (reverse kept)]
     (when (pos? dropped)
       (log! "REVIEW_BATCH_TRUNCATED" (str "dropped-oldest=" dropped)))
     (str "You are a code reviewer for the Seon project. Review the edited "
          "file(s) below for CORRECTNESS and CONVENTION CONFORMANCE. Be terse "
          "and high-signal: point out only real issues (bugs, schema/spec gaps, "
          "convention violations), not style preferences. Review each file "
          "separately, naming it. If a file is fine, say so in one line.\n\n"
          (when conventions
            (str "=== PROJECT CONVENTIONS (rubric) ===\n" conventions "\n\n"))
          (str/join "\n" (map #(render-file-block % max-code-length) ordered))))))

(defn- call-agy
  "Shell to the `agy` Gemini CLI, prompt via stdin. Bounded by timeout-ms;
   returns review text on success, nil on failure/timeout. NEVER throws."
  [prompt timeout-ms]
  (try
    (let [proc (process/process ["agy" "-p" ""]
                                {:in prompt :out :string :err :string})
          finished (deref proc timeout-ms ::timeout)]
      (if (= finished ::timeout)
        (do (process/destroy-tree proc)
            (log! "REVIEW_TIMEOUT" (str timeout-ms "ms"))
            nil)
        (let [{:keys [exit out]} finished]
          (if (and (zero? exit) (seq (str/trim (or out ""))))
            (str/trim out)
            (do (log! "REVIEW_AGY_FAIL" (str "exit=" exit)) nil)))))
    (catch Exception e
      (log! "REVIEW_AGY_EXCEPTION" (.getMessage e))
      nil)))

(defn- bb-review!
  "bb-direct Gemini review (PostToolUse). Accumulates the just-edited file into
   the pending-review batch, then — if not rate-limited — reviews the WHOLE batch
   (every reviewable file edited since the last review) in ONE agy call.

   Batch semantics: every reviewable edit appends to tmp/.pending-review (deduped,
   bounded by max-pending-files). When the interval has elapsed, the pending list
   is re-slurped (latest content) and reviewed as one prompt; on a SUCCESSFUL
   review the accumulator is cleared. Rate-limited edits stay pending. A
   timeout/failure leaves the batch pending (retried next interval) so no edit is
   lost; the max-pending-files cap prevents a permatimeout from growing it
   unbounded.

   Honors :review config (enabled, interval-seconds, max lengths) and the
   :feedback :max-length cap. Returns a feedback string or nil. Advisory — never
   blocks the edit, never throws out."
  [event config]
  (try
    (let [review-cfg (:review config)
          file-path (get-file-path event)]
      (when (and (= (:hook_event_name event) "PostToolUse")
                 (get review-cfg :enabled true)
                 (reviewable-file? file-path)
                 ;; let the in-JVM pipeline own .clj/.cljc review when it's live
                 (not (and (jvm-clj-file? file-path) (jvm-reachable?))))
        ;; 1. Accumulate BEFORE the rate-limit check — never lose an edit.
        (accumulate-pending! file-path)
        (let [interval (get review-cfg :interval-seconds 60)]
          (if (review-rate-limited? interval)
            (do (log! "REVIEW_RATE_LIMITED"
                      (str "interval=" interval "s")
                      (str "pending=" (count (read-pending))))
                nil)
            ;; 2. Not rate-limited → review the whole accumulated batch.
            (let [pending (read-pending)
                  files (->> pending
                             (keep (fn [p]
                                     (when-let [c (try (slurp p) (catch Exception _ nil))]
                                       (when (seq c) {:path p :content c}))))
                             (vec))]
              (when (seq files)
                (let [max-code (get review-cfg :max-code-length 12000)
                      max-out (get-in config [:feedback :max-length] 1000)
                      timeout-ms 60000
                      prompt (build-review-prompt files {:max-code-length max-code})]
                  (log! "REVIEW_BATCH"
                        (str "count=" (count files))
                        (str "files=" (str/join "," (map #(last (str/split (:path %) #"/")) files))))
                  ;; Stamp BEFORE the (slow) call so concurrent edits within the
                  ;; interval don't all fire reviews (they accumulate instead).
                  (touch-last-review!)
                  (let [text (call-agy prompt timeout-ms)]
                    (if (seq text)
                      (do
                        ;; Clear ONLY on a successful review.
                        (clear-pending!)
                        (let [capped (if (> (count text) max-out)
                                       (str (subs text 0 max-out) "\n[truncated]")
                                       text)
                              names (str/join ", " (map #(last (str/split (:path %) #"/")) files))]
                          (str "Gemini review (" names "):\n" capped)))
                      nil)))))))))
    (catch Exception e
      (log! "REVIEW_ERROR" (.getMessage e))
      nil)))

;;; ---------------------------------------------------------------------------
;;; Fast Path (skip nREPL for non-Clojure files)
;;; ---------------------------------------------------------------------------

(defn- should-skip-nrepl?
  "Returns true if we can skip nREPL entirely (non-Clojure, non-docs-markdown edits)."
  [event]
  (let [hook-event (:hook_event_name event)
        tool-name (:tool_name event)
        file-path (get-file-path event)]
    (and (or (= hook-event "PreToolUse") (= hook-event "PostToolUse"))
         (or (= tool-name "Edit") (= tool-name "Write"))
         (not (clojure-file? file-path))
         (not (docs-markdown-file? file-path)))))

;;; ---------------------------------------------------------------------------
;;; nREPL Processing
;;; ---------------------------------------------------------------------------

(defn- process-via-nrepl!
  "Send event to Seon server via nREPL for full processing.
   Returns the response map (does NOT output) so the caller can merge in
   bb-direct review feedback before emitting a single JSON object."
  [event]
  (let [config (load-config)
        claude-session-id (:session_id event)
        seon-session-id (lookup-seon-session claude-session-id)
        target-port (get-port-for-session claude-session-id)
        file-path (get-file-path event)]

    (log! "PORT_RESOLVED"
          (str "claude=" (or claude-session-id "nil"))
          (str "seon=" (or seon-session-id "nil"))
          (str "port=" target-port))

    (let [code (format
                "(do (require 'seon.dev.hook)
                     (seon.dev.hook/process-hook-event!
                       {:seon.dev.hook/event %s
                        :seon.dev.hook/config %s}))"
                (pr-str event)
                (pr-str config))
          result-str (nrepl-eval target-port code)
          result (when result-str
                   (try (edn/read-string result-str) (catch Exception _ nil)))
          response (format-response result)]

      (log! "COMPLETE"
            (str "session=" (or claude-session-id "orchestrator"))
            (str "decision=" (or (:decision response) "continue"))
            (str "has-feedback=" (boolean (get-in response [:hookSpecificOutput :additionalContext]))))

      (log-agent! seon-session-id
                  (:tool_name event)
                  file-path
                  (or (:decision response) "continue")
                  (get-in response [:hookSpecificOutput :additionalContext]))

      response)))

(defn- merge-review-feedback
  "Merge a bb-direct review string into the (possibly nil) JVM response.
   If the JVM blocked, leave the block untouched (review is advisory).
   Otherwise append the review to additionalContext."
  [response review-text]
  (cond
    (nil? review-text) (or response {:continue true})
    (= (:decision response) "block") response
    :else
    (let [existing (get-in response [:hookSpecificOutput :additionalContext])
          combined (if (seq existing) (str existing "\n\n" review-text) review-text)]
      {:continue true
       :hookSpecificOutput {:hookEventName "PostToolUse"
                            :additionalContext combined}})))

;;; ---------------------------------------------------------------------------
;;; Main Entry Point
;;; ---------------------------------------------------------------------------

(defn -main []
  ;; Initialize logging
  (log! "HOOK INVOKED" (str "cwd=" (System/getProperty "user.dir")))

  ;; Backup/restore critical files
  (try
    (restore-from-backup-if-needed!)
    (backup-critical-files!)
    (catch Exception e
      (log! "BACKUP_ERROR" (.getMessage e))))

  ;; Main processing
  (try
    (let [event (try
                  (json/parse-string (slurp *in*) true)
                  (catch Exception _ nil))
          file-path (get-file-path event)]

      ;; Log the event
      (log! (:hook_event_name event)
            (str "tool=" (:tool_name event))
            (str "session=" (or (:session_id event) "orchestrator"))
            (str "file=" (or file-path "unknown")))

      (let [config (load-config)]
        ;; Fast path: skip nREPL for non-Clojure, non-docs-markdown files.
        ;; The bb-direct review is runtime-independent, so it STILL fires here
        ;; for reviewable files (e.g. a non-docs .md like SOUL.md/README).
        (if (should-skip-nrepl? event)
          (do
            (log! "SKIP_NON_CLJ" (or file-path "unknown"))
            (let [review (bb-review! event config)]
              (output! (merge-review-feedback nil review))))

          ;; Clojure file: validate syntax before allowing edit
          (if-let [block-response (or (validate-clojure-edit event)
                                      (validate-critical-edit event))]
            (do
              (log! "CLOJURE_BLOCK" (:reason block-response))
              (output! block-response))

            ;; Valid edit: JVM pipeline (reload/test for .clj/.cljc; no-op for
            ;; .cljs/.md when the JVM is down) + bb-direct Gemini review, merged
            ;; into a single response.
            (let [response (process-via-nrepl! event)
                  review (bb-review! event config)]
              (output! (merge-review-feedback response review)))))))

    (catch Exception e
      (log! "ERROR" (.getMessage e))
      (binding [*out* *err*]
        (println "HOOK ERROR:" (.getMessage e))))))

(-main)
