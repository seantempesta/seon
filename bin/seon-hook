#!/usr/bin/env bb

;; Direct Babashka hook for Clojure and Markdown edits.
;;
;; This script:
;; 1. Receives hook events from Codex or Claude Code (JSON on stdin)
;; 2. Loads configuration from .claude/seon-hook.edn
;; 3. Runs clj-kondo before and after Clojure edits
;; 4. Runs the canonical Markdown/docstring linters after an edit
;; 5. Publishes current source, checks core faults, and schedules one bounded
;;    asynchronous Gemini review batch
;;
;; It has no running Seon-process dependency. Pure linter namespaces load
;; directly into Babashka only for the file type that needs them.

(require '[babashka.classpath :as classpath]
         '[babashka.process :as process]
         '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str]
         '[cognitect.transit :as transit])

;;; ---------------------------------------------------------------------------
;;; Paths
;;; ---------------------------------------------------------------------------

;; This script's location is the authority. Environment cwd/project variables
;; describe the caller and may point at another checkout when a globally
;; installed hook fires; they must never redirect Seon's checks or artifacts.
(def repo-root
  (some-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getPath))

(defn- root-file
  "A java.io.File for `parts` resolved from the repo root."
  ^java.io.File [& parts]
  (apply io/file repo-root parts))

(classpath/add-classpath
 (str (root-file "script") java.io.File/pathSeparator
      (root-file "src") java.io.File/pathSeparator
      (root-file "resources")))
(require '[seon.dev.clj-kondo :as dev.kondo]
         '[seon.operator :as operator]
         '[seon.cluster.process :as operator.process])

(def config-path
  (or (System/getenv "SEON_HOOK_CONFIG")
      (str (root-file ".claude/seon-hook.edn"))))

(def skills-path (root-file ".agents/skills"))
(def review-state-root
  (io/file (or (System/getenv "SEON_HOOK_STATE_DIR")
               (str (root-file "tmp")))))
(def pending-review-path (io/file review-state-root ".pending-review"))
(def pending-review-lock-path (io/file review-state-root ".pending-review.lock"))
(def review-worker-path (io/file review-state-root ".review-worker.edn"))
(def reviews-path (io/file review-state-root "reviews"))
(def max-pending-files 50)

;;; ---------------------------------------------------------------------------
;;; Logging
;;; ---------------------------------------------------------------------------

(def hook-log-path (root-file "logs/hook-debug.log"))
(def hook-log-cap (* 1024 1024))

(defn- log!
  "Append one line to the bounded hook diagnostic log. Never throws."
  [& parts]
  (try
    (let [log-dir (root-file "logs")
          obsolete (root-file "logs/hook-debug.log.1")
          line (.getBytes
                (str (java.time.Instant/now) " | " (str/join " | " parts) "\n")
                "UTF-8")]
      (when-not (.exists log-dir) (.mkdirs log-dir))
      (when (.exists obsolete) (.delete obsolete))
      (with-open [raf (java.io.RandomAccessFile. hook-log-path "rw")
                  channel (.getChannel raf)
                  lock (.lock channel)]
        (when (> (.size channel) hook-log-cap)
          (.truncate channel 0))
        (.position channel (.size channel))
        (.write channel (java.nio.ByteBuffer/wrap line))))
    (catch Exception _ nil)))

;;; ---------------------------------------------------------------------------
;;; Configuration
;;; ---------------------------------------------------------------------------

(defn- load-config []
  (edn/read-string (slurp config-path)))

(defn- required-positive-config [config path]
  (let [value (get-in config path)]
    (when-not (pos-int? value)
      (throw (ex-info "Hook configuration requires a positive integer."
                      {:seon.hook/config-path path
                       :seon.hook/config-file config-path
                       :seon.hook/config-value value})))
    value))

(defn- output! [response]
  (when (seq response)
    (println (json/generate-string response))))

(defn- refuse!
  "Emit one refusal in every shape a harness is known to read, then exit 2.

  Exit 2 blocks unconditionally and takes precedence over any JSON
  (`docs/seon/reference/claude-code-hooks-2026-09-17.md` §2), with the
  reason read from stderr. Codex surfaces a PreToolUse block from the JSON
  but was proven on 2026-09-17T02:26:41Z to surface NOTHING from a
  PostToolUse `decision: block` — the probe lane wrote a broken form
  through its shell tool, the hook blocked, and the lane reported
  \"NO FEEDBACK\" and carried on. The exit code is the one channel a
  harness cannot silently drop."
  [response reason]
  (output! response)
  (binding [*out* *err*] (println reason))
  (flush)
  (System/exit 2))

;;; ---------------------------------------------------------------------------
;;; File Type Detection
;;; ---------------------------------------------------------------------------

(defn- clojure-file? [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (some #(clojure.string/ends-with? lower-path %)
            [".clj" ".cljs" ".cljc" ".bb" ".edn"]))))

(defn- claude-file-path [event]
  (or (get-in event [:tool_input :file_path])
      (get-in event [:tool_input :filePath])))

;; The four headers apply_patch writes, exactly as it writes them. Prefix
;; matching, not a pattern: the header grammar is fixed text, and a pattern
;; over it was the seam that let a patch body decide what the hook believed
;; it was checking.
(def ^:private patch-directives
  [["*** Add File: " :seon.patch/add]
   ["*** Update File: " :seon.patch/update]
   ["*** Delete File: " :seon.patch/delete]
   ["*** Move to: " :seon.patch/move]])

(defn- patch-directive
  "`[operation path]` when `line` is an apply_patch file header."
  [line]
  (some (fn [[prefix operation]]
          (when (str/starts-with? line prefix)
            [operation (str/trim (str/replace (subs line (count prefix))
                                              "\r" ""))]))
        patch-directives))

(defn- parse-patch
  "The ordered file operations a Codex apply_patch payload declares.

  Each operation carries its declared `:seon.patch/path`, the optional
  `:seon.patch/destination` a `*** Move to:` header names, and the body
  lines between its header and the next one."
  [patch]
  (when (string? patch)
    (reduce
     (fn [operations line]
       (let [line (str/replace line "\r" "")]
         (if-let [[operation path] (patch-directive line)]
           (if (= :seon.patch/move operation)
             ;; a move renames the operation immediately above it; an
             ;; orphaned move names no operation and stays unrepresented,
             ;; which the caller reports as an unreconstructable path
             (if-let [current (peek operations)]
               (conj (pop operations)
                     (assoc current :seon.patch/destination path))
               operations)
             (conj operations {:seon.patch/operation operation
                               :seon.patch/path path
                               :seon.patch/lines []}))
           (if-let [current (peek operations)]
             (if (str/starts-with? line "*** End Patch")
               operations
               (conj (pop operations)
                     (update current :seon.patch/lines conj line)))
             operations))))
     []
     (str/split-lines patch))))

(defn- patch-file-paths
  "Return every source and destination path named by a Codex patch."
  [patch]
  (->> (parse-patch patch)
       (mapcat (juxt :seon.patch/path :seon.patch/destination))
       (remove nil?)
       (map str/trim)
       (remove str/blank?)
       distinct
       vec))

(defn- event-file-paths
  "Normalize the complete path set from Codex and Claude edit payloads."
  [event]
  (if (= "apply_patch" (:tool_name event))
    (patch-file-paths (get-in event [:tool_input :command]))
    (some-> (claude-file-path event) vector)))

(defn- get-file-path [event]
  (or (:seon.hook/file-path event)
      (first (event-file-paths event))))

(defn- absolute-file-path [file-path]
  (try
    (when file-path
      (let [file (io/file file-path)]
        (.getPath (.getCanonicalFile
                    (if (.isAbsolute file) file (root-file file-path))))))
    (catch Exception _ nil)))

(defn- repository-file?
  "True when the canonical event path is inside this script's checkout."
  [file-path]
  (when-let [path (absolute-file-path file-path)]
    (let [prefix (str repo-root java.io.File/separator)]
      (or (= path repo-root) (str/starts-with? path prefix)))))

;;; ---------------------------------------------------------------------------
;;; Static Analysis
;;; ---------------------------------------------------------------------------

(def ^:private clj-kondo-definition-output-config
  (str "{:output {:format :edn} "
       ":analysis {:var-usages true :var-definitions true}}"))

(def ^:private shared-kondo-cache-v1-directory
  (root-file ".clj-kondo/.cache/v1"))

(defn- display-path [file-path]
  (try
    (let [root (.toPath (.getCanonicalFile (io/file repo-root)))
          file (.toPath (.getCanonicalFile (io/file file-path)))]
      (if (.startsWith file root)
        (str (.relativize root file))
        (str file)))
    (catch Exception _ (str file-path))))

(defn- run-clj-kondo
  "Analyze files, or one prospective source string, with project config."
  [{:seon.hook/keys [file-paths prospective-content]}]
  (try
    (let [absolute-paths (mapv absolute-file-path file-paths)
          argv (if prospective-content
                 ;; a prospective buffer must never write the shared cache:
                 ;; a partial definition replaces the namespace's cache entry
                 ;; and every later lint of its consumers reports unresolved
                 ;; vars, vetoing all edits (poisoning reproduced 2026-08-29)
                 ["clj-kondo" "--lint" "-"
                  "--filename" (first absolute-paths)
                  "--cache" "false"
                  "--config" dev.kondo/clj-kondo-output-config]
                 ;; the post-edit single-file lint is also a partial view;
                 ;; complete source publication owns first-party cache
                 ;; refresh — the hook never persists analysis
                 (into ["clj-kondo" "--lint"]
                       (concat absolute-paths
                               ["--cache" "false"
                                "--config" dev.kondo/clj-kondo-output-config])))
          result (process/sh {:cmd argv
                              :dir repo-root
                              :in (or prospective-content "")
                              :out :string
                              :err :string
                              :continue true})
          parsed (try (edn/read-string (:out result))
                      (catch Exception _ nil))]
      (if (and (map? parsed) (vector? (:findings parsed)))
        {:seon.hook.analysis/status :available
         :seon.hook.analysis/findings (:findings parsed)
         :seon.hook.analysis/var-usages
         (vec (get-in parsed [:analysis :var-usages]))}
        {:seon.hook.analysis/status :unavailable
         :seon.hook.analysis/reason
         (str "clj-kondo returned no findings result"
              (when-not (str/blank? (:err result))
                (str ": " (str/trim (:err result)))))}))
    (catch Exception error
      {:seon.hook.analysis/status :unavailable
       :seon.hook.analysis/reason (.getMessage error)})))

(defn- format-clj-kondo-findings [findings]
  (str/join
   "\n"
   (map (fn [{:keys [filename row col level type message]}]
          (str (display-path filename) ":" (or row "?") ":" (or col "?")
               " [" (name (or level :unknown)) "/"
               (if (= :seon.hook/cache-entry-missing-var type)
                 (str type)
                 (name (or type :unknown)))
               "] " message))
        findings)))

(defn- finding-var-usage
  "The structured var usage at an unresolved-var finding's location."
  [analysis finding]
  (some
   (fn [usage]
     (when (and (= (:filename finding) (:filename usage))
                (= (:row finding) (:row usage))
                (= (:col finding) (:col usage))
                (symbol? (:to usage))
                (symbol? (:name usage)))
       usage))
   (:seon.hook.analysis/var-usages analysis)))

(defn- cache-languages
  "Cache language directories that may define a usage from `filename`."
  [filename usage]
  (if-let [language (:lang usage)]
    [language]
    (let [lower (str/lower-case (str filename))]
      (cond
        (str/ends-with? lower ".cljs") [:cljs :cljc]
        (str/ends-with? lower ".cljc") [:clj :cljs :cljc]
        :else [:clj :cljc]))))

(defn- cache-entry-files
  [cache-v1-directory finding usage]
  (map
   #(io/file cache-v1-directory
             (name %)
             (str (:to usage) ".transit.json"))
   (cache-languages (:filename finding) usage)))

(defn- read-transit-entry
  "A readable Transit cache map, or nil."
  [^java.io.File file]
  (try
    (when (.isFile file)
      (with-open [input (io/input-stream file)]
        (let [entry (transit/read (transit/reader input :json))]
          (when (map? entry) entry))))
    (catch Exception _ nil)))

(defn- readable-recorded-source
  [recorded-source]
  (when (string? recorded-source)
    (let [source (io/file recorded-source)
          source (if (.isAbsolute source)
                   source
                   (root-file recorded-source))]
      (when (and (.isFile source) (.canRead source)) source))))

(defn- uncached-definition-analysis
  "Structured kondo data from one source path or synthesized source string."
  [{:seon.hook/keys [file-path prospective-content]}]
  (try
    (let [argv (if prospective-content
                 ["clj-kondo" "--lint" "-"
                  "--filename" file-path
                  "--cache" "false"
                  "--config" clj-kondo-definition-output-config]
                 ["clj-kondo" "--lint" file-path
                  "--cache" "false"
                  "--config" clj-kondo-definition-output-config])
          result (process/sh {:cmd argv
                              :dir repo-root
                              :in (or prospective-content "")
                              :out :string
                              :err :string
                              :continue true})
          parsed (try (edn/read-string (:out result))
                      (catch Exception _ nil))]
      (when (map? parsed) parsed))
    (catch Exception _ nil)))

(defn- source-defines-target?
  [^java.io.File source target-namespace target-var]
  (let [analysis
        (uncached-definition-analysis
         {:seon.hook/file-path (.getPath source)})]
    (some
     #(and (= target-namespace (:ns %))
           (= target-var (:name %)))
     (get-in analysis [:analysis :var-definitions]))))

(def ^:private builtin-resolution-keys
  [:private :macro :fixed-arities :varargs-min-arity :deprecated])

(defn- packaged-builtin-defines-target?
  "True when uncached analysis carries definition metadata for a builtin."
  [target-namespace target-var]
  (let [probe-namespace 'seon.hook.cache-probe
        probe-alias 'target
        source (str "(ns " probe-namespace " (:require ["
                    target-namespace " :as " probe-alias "]))\n"
                    "(def observed " probe-alias "/" target-var ")\n")
        analysis
        (uncached-definition-analysis
         {:seon.hook/file-path "seon_hook_cache_probe.clj"
          :seon.hook/prospective-content source})]
    (some
     (fn [usage]
       (when (and (= target-namespace (:to usage))
                  (= target-var (:name usage))
                  (some #(contains? usage %) builtin-resolution-keys))
         true))
     (get-in analysis [:analysis :var-usages]))))

(defn- cache-entry-missing-var-diagnostic
  [cache-v1-directory analysis finding]
  (when-let [usage (finding-var-usage analysis finding)]
    (let [target-namespace (:to usage)
          target-var (:name usage)
          target-symbol (symbol (str target-namespace) (str target-var))]
      (some
       (fn [^java.io.File cache-file]
         (when-let [entry (read-transit-entry cache-file)]
           (let [recorded-source (:filename entry)
                 source (readable-recorded-source recorded-source)]
             (when (and (not (contains? entry target-var))
                        (if source
                          (source-defines-target?
                           source target-namespace target-var)
                          (packaged-builtin-defines-target?
                           target-namespace target-var)))
               (assoc
                finding
                :type :seon.hook/cache-entry-missing-var
                :message
                (str
                 "Shared clj-kondo cache entry omits a definition present "
                 "under uncached analysis: "
                 (pr-str
                  {:seon.hook/cache-path (display-path (.getPath cache-file))
                   :seon.hook/target-symbol target-symbol
                   :seon.hook/recorded-source recorded-source
                   :seon.hook/cache-byte-size (.length cache-file)
                   :seon.hook/cache-mtime
                   (str (java.time.Instant/ofEpochMilli
                         (.lastModified cache-file)))})))))))
       (cache-entry-files cache-v1-directory finding usage)))))

(defn- diagnose-blocking-findings
  "Replace proven cache corruption; preserve every other finding exactly."
  [cache-v1-directory analysis findings]
  (mapv
   (fn [finding]
     (or (when (= :unresolved-var (:type finding))
           (cache-entry-missing-var-diagnostic
            cache-v1-directory analysis finding))
         finding))
   findings))

(defn- analysis-error [analysis]
  (when (= :unavailable (:seon.hook.analysis/status analysis))
    (str "clj-kondo analysis failed: "
     (:seon.hook.analysis/reason analysis))))

(defn- throwable-message
  "The first non-blank message in a throwable's cause chain."
  [error]
  (loop [throwable error]
    (if throwable
      (let [message (.getMessage throwable)]
        (if (str/blank? message)
          (recur (.getCause throwable))
          message))
      (str (class error)))))

(defn- schema-resource-path?
  "True for one flat split-registry EDN resource."
  [file-path]
  (when-let [absolute (absolute-file-path file-path)]
    (let [file (io/file absolute)
          schema-directory (.getCanonicalFile
                            (root-file "resources/seon/schemas"))]
      (and (str/ends-with? (str/lower-case (.getName file)) ".edn")
           (= schema-directory (.getCanonicalFile (.getParentFile file)))))))

(defn- run-schema-admission
  "Run schema admission in the live JVM, or a bounded child when no host runs."
  [{:seon.hook/keys [file-paths prospective-content]}]
  (if-not (get-in (load-config) [:schema-admission :enabled] true)
    {:seon.hook.analysis/findings []
     :seon.hook.schema-admission/skipped "schema admission disabled by hook config"}
  (try
    (let [absolute-paths (mapv absolute-file-path file-paths)
          request
          (cond-> {:seon.schema.admission/paths absolute-paths}
            prospective-content
            (assoc :seon.schema.admission/sources
                   {(first absolute-paths) prospective-content}))
          live (operator/live-root-value!
                (str (root-file (get-in (load-config) [:current-source :root] ".")))
                (pr-str `((requiring-resolve 'seon.schema.admission/admit) ~request)))
          result
          (when-not (:seon.operator/live-process? live)
            (operator.process/run-process!
             {:seon.operator.subprocess/argv
              ["clojure" "-M:dev" "-m" "seon.schema.admission"]
              :seon.operator.subprocess/directory repo-root
              :seon.operator.subprocess/input (pr-str request)
              :seon.operator.subprocess/deadline-ms
              (operator/operator-silence-backstop-ms {})}))
          findings
          (if (:seon.operator/live-process? live)
            (:seon.operator/value live)
            (when (zero? (:seon.operator.subprocess/exit result))
              (try (some->> (:seon.operator.subprocess/output result)
                            str/split-lines
                            (remove str/blank?)
                            last
                            edn/read-string)
                   (catch Exception _ nil))))]
      (if (vector? findings)
        {:seon.hook.analysis/status :available
         :seon.hook.analysis/findings findings}
        {:seon.hook.analysis/status :unavailable
         :seon.hook.analysis/reason
         (str "schema admission returned no findings result"
              (when-not (str/blank? (:seon.operator.subprocess/error-output result))
                (str ": " (str/trim (:seon.operator.subprocess/error-output result)))))}))
    (catch Exception error
      {:seon.hook.analysis/status :unavailable
       :seon.hook.analysis/reason (.getMessage error)}))))

(defn- schema-admission-error
  [analysis]
  (when (= :unavailable (:seon.hook.analysis/status analysis))
    (str "schema admission failed: "
         (:seon.hook.analysis/reason analysis))))

(declare clip-feedback load-direct-check!)

(defn- reconstruct-exact-edit
  [current tool-input]
  (let [old-string (:old_string tool-input)]
    (when (seq old-string)
      (try
        (load-direct-check! 'seon.edit)
        (let [transformed
              ((requiring-resolve 'seon.edit/exact)
               current
               {:my.edit/path "hook-prospective"
                :my.edit/expected-digest (apply str (repeat 64 "0"))
                :my.edit/old-string old-string
                :my.edit/new-string (or (:new_string tool-input) "")
                :my.edit/replace-all? (true? (:replace_all tool-input))}
               1)]
          (if-let [source (:seon.edit/source transformed)]
            {:seon.hook.reconstruction/status :available
             :seon.hook.reconstruction/source source}
            {:seon.hook.reconstruction/status :refused
             :seon.hook.reconstruction/reason
             (:seon.error/message transformed)}))
        (catch Exception error
          (let [message (throwable-message error)]
            (log! "EXACT_RECONSTRUCTION_ERROR" message)
            {:seon.hook.reconstruction/status :unavailable
             :seon.hook.reconstruction/reason message}))))))

(defn- content-lines
  "File content as lines, keeping the trailing empty line a final newline makes."
  [content]
  (vec (str/split (str/replace (str content) "\r\n" "\n") #"\n" -1)))

(defn- hunk-sections
  "An Update operation's body split into hunks at each `@@` marker."
  [lines]
  (let [sections
        (reduce (fn [hunks line]
                  (if (str/starts-with? line "@@")
                    (conj hunks {:seon.patch/anchor (str/trim (subs line 2))
                                 :seon.patch/lines []})
                    (if-let [current (peek hunks)]
                      (conj (pop hunks) (update current :seon.patch/lines conj line))
                      hunks)))
                []
                lines)]
    ;; a patch may open its first hunk with context instead of `@@`; the body
    ;; before any marker is that hunk, never silently discarded
    (if (and (empty? sections) (seq lines))
      [{:seon.patch/anchor "" :seon.patch/lines (vec lines)}]
      sections)))

(defn- hunk-lines
  "The lines a hunk expects to find and the lines it leaves behind."
  [lines]
  (reduce
   (fn [acc line]
     (cond
       (str/starts-with? line "*** End of File") acc
       (str/starts-with? line "+") (update acc :seon.patch/new conj (subs line 1))
       (str/starts-with? line "-") (update acc :seon.patch/old conj (subs line 1))
       (str/starts-with? line " ") (-> acc
                                       (update :seon.patch/old conj (subs line 1))
                                       (update :seon.patch/new conj (subs line 1)))
       ;; apply_patch tolerates an empty context line written without its
       ;; leading space; every other leading character is unknown grammar
       (str/blank? line) (-> acc
                             (update :seon.patch/old conj "")
                             (update :seon.patch/new conj ""))
       :else (assoc acc :seon.patch/unexpected line)))
   {:seon.patch/old [] :seon.patch/new []}
   lines))

(defn- sublist-index
  "The first index at or after `from` where `old` occurs in `lines`."
  [lines old from]
  (let [total (count lines)
        length (count old)]
    (loop [index (max 0 from)]
      (cond
        (> (+ index length) total) nil
        (= old (subvec lines index (+ index length))) index
        :else (recur (inc index))))))

(defn- trailing-blank-tolerant-index
  "`sublist-index` comparing lines without their trailing whitespace."
  [lines old from]
  (sublist-index (mapv str/trimr lines) (mapv str/trimr old) from))

(defn- apply-patch-hunks
  "Apply one Update operation's hunks to `current`, or say why it cannot."
  [current operation]
  (loop [lines (content-lines current)
         cursor 0
         hunks (hunk-sections (:seon.patch/lines operation))]
    (if-let [hunk (first hunks)]
      (let [{:seon.patch/keys [old new unexpected]} (hunk-lines (:seon.patch/lines hunk))
            anchor (:seon.patch/anchor hunk)
            anchored (when-not (str/blank? anchor)
                       (sublist-index lines [anchor] cursor))
            from (or anchored cursor)
            ;; hunks usually advance through the file, so the cursor is the
            ;; cheap first guess — but a patch may order them any way it
            ;; likes, and refusing an out-of-order hunk is a veto the tool
            ;; itself would not have issued (one such refusal reached a lane
            ;; on 2026-09-17T01:39:12Z)
            at (or (sublist-index lines old from)
                   (trailing-blank-tolerant-index lines old from)
                   (sublist-index lines old 0)
                   (trailing-blank-tolerant-index lines old 0))]
        (cond
          unexpected
          {:seon.hook.reconstruction/status :unavailable
           :seon.hook.reconstruction/reason
           (str "the patch carries a line the hook cannot classify: "
                (pr-str unexpected))}

          (nil? at)
          {:seon.hook.reconstruction/status :unavailable
           :seon.hook.reconstruction/reason
           (str "a hunk's context is not present in the file: "
                (pr-str (first old)))}

          :else
          (recur (into (into (subvec lines 0 at) new)
                       (subvec lines (+ at (count old))))
                 (+ at (count new))
                 (rest hunks))))
      {:seon.hook.reconstruction/status :available
       :seon.hook.reconstruction/source (str/join "\n" lines)})))

(defn- patch-operation
  "The operation in `operations` whose source or destination is `file-path`."
  [operations file-path]
  (let [target (absolute-file-path file-path)]
    (first
     (filter (fn [operation]
               (contains?
                (into #{} (remove nil?)
                      [(absolute-file-path (:seon.patch/path operation))
                       (some-> (:seon.patch/destination operation)
                               absolute-file-path)])
                target))
             operations))))

(defn- reconstruct-patched-file
  "The prospective content of `file-path` after a Codex patch, or why not.

  Every outcome is typed. A path the patch does not name, a path whose file
  is absent, and an unapplicable hunk are each `:unavailable` — the hook
  cannot lint what it cannot build, and it says so instead of passing."
  [patch file-path]
  (if-not (string? patch)
    {:seon.hook.reconstruction/status :unavailable
     :seon.hook.reconstruction/reason
     (str "the apply_patch payload carries no patch text: " (pr-str patch))}
    (let [operations (parse-patch patch)
          operation (patch-operation operations file-path)
          absolute (absolute-file-path file-path)
          file (some-> absolute io/file)
          ;; an Update whose Move to renames the file still reads its hunks
          ;; against the file on disk under the OLD name
          source (some-> (:seon.patch/path operation) absolute-file-path io/file)
          moved-away? (and operation
                           (:seon.patch/destination operation)
                           (= absolute (absolute-file-path
                                        (:seon.patch/path operation))))]
      (cond
        (nil? operation)
        {:seon.hook.reconstruction/status :unavailable
         :seon.hook.reconstruction/reason
         (str "the patch declares no file operation for " (display-path file-path))}

        (or moved-away? (= :seon.patch/delete (:seon.patch/operation operation)))
        {:seon.hook.reconstruction/status :deleted}

        (= :seon.patch/add (:seon.patch/operation operation))
        (if (and file (.exists file))
          {:seon.hook.reconstruction/status :unavailable
           :seon.hook.reconstruction/reason
           (str "the patch adds a file that already exists: "
                (display-path file-path))}
          (let [{:seon.patch/keys [new unexpected]}
                (hunk-lines (remove #(str/starts-with? % "@@")
                                    (:seon.patch/lines operation)))]
            (if unexpected
              {:seon.hook.reconstruction/status :unavailable
               :seon.hook.reconstruction/reason
               (str "the patch carries a line the hook cannot classify: "
                    (pr-str unexpected))}
              {:seon.hook.reconstruction/status :available
               :seon.hook.reconstruction/source (str (str/join "\n" new) "\n")})))

        (not (and source (.isFile source)))
        {:seon.hook.reconstruction/status :unavailable
         :seon.hook.reconstruction/reason
         (str "the patch updates a path that does not exist: "
              (or (some-> source .getPath) absolute file-path))}

        :else
        (try
          (apply-patch-hunks (slurp source) operation)
          (catch Exception error
            {:seon.hook.reconstruction/status :unavailable
             :seon.hook.reconstruction/reason (throwable-message error)}))))))

(defn- reconstruct-file-content [event]
  (let [tool-name (:tool_name event)
        tool-input (:tool_input event)
        file-path (get-file-path event)]
    (cond
      (= tool-name "apply_patch")
      (reconstruct-patched-file (:command tool-input) file-path)

      (= tool-name "Write")
      {:seon.hook.reconstruction/status :available
       :seon.hook.reconstruction/source (:content tool-input)}

      (= tool-name "Edit")
      (if-not (and file-path (:old_string tool-input))
        {:seon.hook.reconstruction/status :unavailable
         :seon.hook.reconstruction/reason
         "the Edit payload names no file path and replaced text"}
        (try
          (reconstruct-exact-edit
           (slurp (absolute-file-path file-path)) tool-input)
          (catch Exception error
            {:seon.hook.reconstruction/status :unavailable
             :seon.hook.reconstruction/reason (throwable-message error)})))

      ;; an edit tool the hook has no reconstruction for is a file it cannot
      ;; lint; naming that is the whole point of the check
      :else
      {:seon.hook.reconstruction/status :unavailable
       :seon.hook.reconstruction/reason
       (str "the hook reconstructs no prospective content for tool "
            (pr-str tool-name))})))

;;; ---------------------------------------------------------------------------
;;; Validation Functions (return block response or nil)
;;; ---------------------------------------------------------------------------

(defn- validate-clojure-edit
  "Block a reconstructed edit when clj-kondo reports errors or cannot run."
  [event]
  (let [file-path (get-file-path event)]
    (when (and (= (:hook_event_name event) "PreToolUse")
               (clojure-file? file-path))
      (let [reconstruction
            (or (reconstruct-file-content event)
                {:seon.hook.reconstruction/status :unavailable
                 :seon.hook.reconstruction/reason
                 "the hook built no prospective content for this edit"})]
        (if (= :unavailable (:seon.hook.reconstruction/status reconstruction))
          {:decision "block"
           :reason (str "BLOCKED: edit reconstruction failed: "
                        (:seon.hook.reconstruction/reason reconstruction))}
          (when (= :available (:seon.hook.reconstruction/status reconstruction))
            (let [analysis (run-clj-kondo
                            {:seon.hook/file-paths [file-path]
                             :seon.hook/prospective-content
                             (:seon.hook.reconstruction/source reconstruction)})
                  errors (filterv #(= :error (:level %))
                                  (:seon.hook.analysis/findings analysis))
                  errors (diagnose-blocking-findings
                          shared-kondo-cache-v1-directory analysis errors)]
              (cond
                (analysis-error analysis)
                {:decision "block"
                 :reason (str "BLOCKED: " (analysis-error analysis))}

                (seq errors)
                {:decision "block"
                 :reason (str "BLOCKED: clj-kondo found error-level issues in the "
                              "prospective Clojure edit:\n"
                              (format-clj-kondo-findings errors))}

                :else nil))))))))

(defn- validate-schema-edit
  "Block a reconstructed split-schema edit on admission errors."
  [event]
  (let [file-path (get-file-path event)]
    (when (and (= (:hook_event_name event) "PreToolUse")
               (schema-resource-path? file-path))
      (let [reconstruction
            (or (reconstruct-file-content event)
                {:seon.hook.reconstruction/status :unavailable
                 :seon.hook.reconstruction/reason
                 "the hook built no prospective content for this edit"})]
        (if (= :unavailable (:seon.hook.reconstruction/status reconstruction))
          {:decision "block"
           :reason (str "BLOCKED: edit reconstruction failed: "
                        (:seon.hook.reconstruction/reason reconstruction))}
          (when (= :available (:seon.hook.reconstruction/status reconstruction))
            (let [analysis
                  (run-schema-admission
                   {:seon.hook/file-paths [file-path]
                    :seon.hook/prospective-content
                    (:seon.hook.reconstruction/source reconstruction)})
                  errors (filterv #(= :error (:level %))
                                  (:seon.hook.analysis/findings analysis))]
              (cond
                (schema-admission-error analysis)
                {:decision "block"
                 :reason (str "BLOCKED: " (schema-admission-error analysis))}

                (seq errors)
                {:decision "block"
                 :reason
                 (str "BLOCKED: schema admission found error-level issues in the "
                      "prospective schema edit:\n"
                      (format-clj-kondo-findings errors))}

                :else nil))))))))

(defn- findings-feedback
  "Format blocking findings first and cap the advisory finding tail."
  [config heading findings]
  (let [errors (filterv #(= :error (:level %)) findings)
        advisories (filterv #(not= :error (:level %)) findings)
        advisory-limit (max 0 (get-in config
                                      [:feedback :max-advisory-findings]
                                      20))
        shown-advisories (subvec advisories 0 (min advisory-limit
                                                   (count advisories)))
        omitted (- (count advisories) (count shown-advisories))]
    (clip-feedback
     config
     (str heading "\n"
          (format-clj-kondo-findings (into errors shown-advisories))
          (when (pos? omitted)
            (str "\n… " omitted " advisory finding(s) omitted."))))))

(defn- schema-admission-feedback
  "Return the post-edit split-schema findings and whether publication may run."
  [event config]
  (let [paths (->> (event-file-paths event)
                   (filter schema-resource-path?)
                   (filter #(some-> % absolute-file-path io/file .isFile))
                   vec)]
    (when (and (= (:hook_event_name event) "PostToolUse") (seq paths))
      (let [analysis (run-schema-admission {:seon.hook/file-paths paths})
            findings (:seon.hook.analysis/findings analysis)
            errors? (or (schema-admission-error analysis)
                        (some #(= :error (:level %)) findings))]
        {:seon.hook.schema-admission/errors? (boolean errors?)
         :seon.hook.schema-admission/feedback
         (cond
           (schema-admission-error analysis)
           (str "ADVISORY — " (schema-admission-error analysis))

           (seq findings)
           (findings-feedback config "schema admission findings:" findings)

           :else nil)}))))

(defn- patch-deleted-paths
  "The paths this event's patch removes, which are absent by design."
  [event]
  (if (= "apply_patch" (:tool_name event))
    (->> (parse-patch (get-in event [:tool_input :command]))
         (mapcat (fn [operation]
                   (cond
                     (= :seon.patch/delete (:seon.patch/operation operation))
                     [(:seon.patch/path operation)]

                     (:seon.patch/destination operation)
                     [(:seon.patch/path operation)]

                     :else nil)))
         (keep absolute-file-path)
         set)
    #{}))

(defn- clj-kondo-feedback
  "Findings for the resulting edited files, with any syntax refusal named.

  A Clojure path the event claims to have written but that is absent
  afterwards is reported, never dropped: the whole failure this check
  exists for reads absence as health."
  [event config]
  (when (= (:hook_event_name event) "PostToolUse")
    (let [named (->> (event-file-paths event) (filter clojure-file?) vec)
          deleted (patch-deleted-paths event)
          present (filterv #(some-> % absolute-file-path io/file .isFile) named)
          absent (->> named
                      (remove (set present))
                      (remove #(contains? deleted (absolute-file-path %)))
                      vec)
          analysis (when (seq present)
                     (run-clj-kondo {:seon.hook/file-paths present}))
          findings (:seon.hook.analysis/findings analysis)
          syntax-errors (filterv #(and (= :error (:level %))
                                       (= :syntax (:type %)))
                                 findings)]
      {:seon.hook.lint/refusal
       (cond
         (seq syntax-errors)
         (str "REFUSED: the edit left unreadable Clojure on disk. "
              "Repair it in the next edit — the file loads for nothing "
              "until then:\n"
              (format-clj-kondo-findings syntax-errors))

         (seq absent)
         (str "REFUSED: this edit named " (count absent)
              " Clojure path(s) that do not exist afterwards, so the hook "
              "checked nothing for them: "
              (str/join ", " (map #(str (or (absolute-file-path %) %)) absent))))

       :seon.hook.lint/feedback
       (cond
         (and (seq present) (analysis-error analysis))
         (str "ADVISORY — " (analysis-error analysis))

         (seq findings)
         (findings-feedback config "clj-kondo findings:" findings)

         :else nil)})))

;;; ---------------------------------------------------------------------------
;;; Markdown File Detection
;;; ---------------------------------------------------------------------------

(defn- authority-markdown-file?
  "Returns true for Markdown under docs or the curated skills tree."
  [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (and (clojure.string/ends-with? lower-path ".md")
           (or (clojure.string/starts-with? lower-path "docs/")
               (clojure.string/includes? lower-path "/docs/")
               (clojure.string/starts-with? lower-path ".agents/skills/")
               (clojure.string/includes? lower-path "/.agents/skills/"))))))

(defn- clojure-source-file? [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (some #(str/ends-with? lower %) [".clj" ".cljs" ".cljc"]))))

(defn- load-direct-check! [namespace]
  ;; Resolve from this script's checkout even when a global hook fires from
  ;; another cwd. Babashka already supplies clj-kondo's SCI dependency; the
  ;; root's JVM analyzer coordinate would otherwise conflict with it.
  (classpath/add-classpath
   (str (root-file "src") java.io.File/pathSeparator (root-file "script")))
  (require namespace))

(defn- clip-feedback [config message]
  ;; clip-str died in the clip-ripout (94116765e); a nil requiring-resolve
  ;; then NPE'd here on EVERY post-edit for fifteen days, silently killing
  ;; all advisory feedback — resolve loudly, bound through the token owner,
  ;; and elide with a counted line, never a bare truncation
  (load-direct-check! 'seon.ai.tokens)
  (let [resolve-loudly!
        (fn [sym]
          (or (requiring-resolve sym)
              (throw (ex-info (str "The feedback sizer is missing: " sym)
                              {:seon.hook/missing-var sym}))))
        estimate (resolve-loudly! 'seon.ai.tokens/estimate)
        estimate-chars (resolve-loudly! 'seon.ai.tokens/estimate-chars)
        max-tokens (get-in config [:feedback :max-tokens] 300)
        total (estimate message)]
    (if (<= total max-tokens)
      message
      (str (subs message 0 (min (long (estimate-chars max-tokens))
                                (count message)))
           "\n… feedback elided (approximately " (- total max-tokens)
           " tokens over the " max-tokens "-token budget)."))))

(defn- markdown-feedback [event config]
  (when (and (= (:hook_event_name event) "PostToolUse")
             (get-in config [:markdown-lint :enabled] true)
             (authority-markdown-file? (get-file-path event)))
    (try
      (load-direct-check! 'seon.dev.markdown)
      (let [file-path (absolute-file-path (get-file-path event))
            validate-file (requiring-resolve 'seon.dev.markdown/validate-file)
            validate-repository-pins
            (requiring-resolve 'seon.dev.markdown/validate-repository-pins)
            fix (requiring-resolve 'seon.dev.markdown/fix)
            format-violations (requiring-resolve 'seon.dev.markdown/format-violations)
            request {:seon.dev.markdown/file-path file-path
                     :seon.dev.markdown/vault-root (str (root-file "docs"))}
            initial (validate-file request)
            _ (when-not (:seon.dev.markdown/valid? initial)
                (let [fixed (fix {:seon.dev.markdown/content (slurp file-path)})]
                  (when (pos? (:seon.dev.markdown/fixed-count fixed))
                    (spit file-path (:seon.dev.markdown/content fixed)))))
            final-file (if (:seon.dev.markdown/valid? initial)
                         initial
                         (validate-file request))
            pin-result
            (validate-repository-pins
             {:seon.dev.markdown/repository-root repo-root})
            violations
            (into (:seon.dev.markdown/violations final-file)
                  (:seon.dev.markdown/violations pin-result))]
        (when (seq violations)
          (clip-feedback
           config
           (:seon.dev.markdown/formatted
            (format-violations
             {:seon.dev.markdown/violations violations
              :seon.dev.markdown/max-length Long/MAX_VALUE})))))
      (catch Exception e
        (log! "MARKDOWN_LINT_ERROR" (.getMessage e))
        nil))))

(defn- docstring-feedback [event config]
  (when (and (= (:hook_event_name event) "PostToolUse")
             (get-in config [:docstring-lint :enabled] true)
             (clojure-source-file? (get-file-path event)))
    (try
      (load-direct-check! 'seon.dev.docstring)
      (let [check-file (requiring-resolve 'seon.dev.docstring/check-file)
            format-findings (requiring-resolve 'seon.dev.docstring/format-findings)
            result (check-file
                    {:seon.dev.docstring/file-path
                     (absolute-file-path (get-file-path event))})]
        (when-not (:seon.dev.docstring/clean? result)
          (clip-feedback
           config
           (:seon.dev.docstring/formatted
            (format-findings
             {:seon.dev.docstring/findings (:seon.dev.docstring/findings result)
              :seon.dev.docstring/max-length Long/MAX_VALUE})))))
      (catch Exception e
        (log! "DOCSTRING_LINT_ERROR" (.getMessage e))
        nil))))

;;; ---------------------------------------------------------------------------
;;; Rate-limited Gemini review
;;; ---------------------------------------------------------------------------

(defn- reviewable-file?
  "True for source, configuration, and Markdown files worth an AI review."
  [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (or (clojure-file? file-path)
          (str/ends-with? lower ".md")))))

(defn- with-pending-lock
  "Run one pending-review state transition under an exclusive file lock."
  [transition]
  (try
    (io/make-parents pending-review-path)
    (with-open [file (java.io.RandomAccessFile. pending-review-lock-path "rw")
                channel (.getChannel file)]
      (let [_lock (.lock channel)]
        ;; Closing the channel releases the lock; Babashka does not expose
        ;; FileLock.close through SCI.
        (transition)))
    (catch Exception error
      (log! "REVIEW_PENDING_LOCK_ERROR" (.getMessage error))
      nil)))

(defn- parse-pending-entry [line]
  (let [[id path] (str/split line #"\t" 2)
        legacy? (nil? path)
        path (if legacy? id path)]
    (when (seq path)
      {:seon.review.pending/id (if legacy? (str "legacy:" path) id)
       :seon.review.pending/path path})))

(defn- read-pending-unlocked
  "Pending review entries in edit order, or an empty vector."
  []
  (try
    (let [file (io/file pending-review-path)]
      (if (.exists file)
        (->> (str/split-lines (slurp file))
             (map str/trim)
             (remove str/blank?)
             (keep parse-pending-entry)
             vec)
        []))
    (catch Exception _ [])))

(defn- read-pending []
  (or (with-pending-lock read-pending-unlocked) []))

(defn- write-pending-unlocked! [entries]
  (spit pending-review-path
        (str
         (str/join
          "\n"
          (map
           (fn [{:seon.review.pending/keys [id path]}]
             (str id "\t" path))
           entries))
         (when (seq entries) "\n"))))

(defn- accumulate-pending-unlocked!
  "Append paths with newest-kept deduplication and a fixed file cap."
  [file-paths]
  (let [entries
        (reduce
         (fn [current file-path]
           (conj
            (vec
             (remove
              #(= file-path (:seon.review.pending/path %))
              current))
            {:seon.review.pending/id (str (java.util.UUID/randomUUID))
             :seon.review.pending/path file-path}))
         (read-pending-unlocked)
         file-paths)
        dropped (max 0 (- (count entries) max-pending-files))
        capped (vec (drop dropped entries))]
    (when (pos? dropped)
      (log! "REVIEW_PENDING_CAP" (str "dropped=" dropped)))
    (write-pending-unlocked! capped)))

(defn- clear-reviewed-pending!
  "Remove only drained entries, preserving edits appended during review."
  [reviewed-entries]
  (try
    (with-pending-lock
      (fn []
        (let [reviewed-ids
              (into #{} (map :seon.review.pending/id) reviewed-entries)]
          (write-pending-unlocked!
           (remove
            #(contains? reviewed-ids (:seon.review.pending/id %))
            (read-pending-unlocked))))))
    (catch Exception _ nil)))

(def ^:private truncation-notice
  (str "REVIEW TRUNCATION — the prompt cut this text here. The real file "
       "CONTINUES past this point and is NOT incomplete. Do NOT report a "
       "syntax error, an unbalanced form, a missing closing paren, a cut-off "
       "function, or any other incompleteness at or after this marker."))

(defn- truncation-marker
  "One unmissable in-band marker naming the prompt as the cause of the cut."
  [language]
  (if (= language "markdown")
    (str "\n\n<!-- ===== " truncation-notice " ===== -->\n")
    (str "\n\n;; ===== " truncation-notice " =====\n")))

(defn- clip-with-marker
  "`content` capped at `max-length`, marked in `language`'s comment syntax."
  [content max-length language]
  (if (> (count content) max-length)
    (str (subs content 0 max-length) (truncation-marker language))
    content))

(defn- load-rubric
  "Load one standing rubric document, capped and marked. Nil when absent."
  [^java.io.File file max-length]
  (try
    (when (.exists file)
      (let [content (slurp file)]
        (when (seq content)
          (clip-with-marker content max-length "markdown"))))
    (catch Exception error
      (log! "REVIEW_RUBRIC_UNREADABLE" (.getPath file) (.getMessage error))
      nil)))

(defn- load-skills
  "Load the configured skills' current SKILL.md text, in configured order.

   The files are read at review time, so an edited skill reaches the very
   next review with no rebuild. A missing or unreadable skill is one log
   line and is skipped — a review never fails over its rubric."
  [skill-names max-length]
  (->> skill-names
       (keep
        (fn [skill-name]
          (let [file (io/file skills-path (str skill-name) "SKILL.md")]
            (if-let [content (load-rubric file max-length)]
              {:name (str skill-name) :content content}
              (do (log! "REVIEW_SKILL_MISSING" (str skill-name))
                  nil)))))
       vec))

(defn- file-language [file-path]
  (if (str/ends-with? (str/lower-case file-path) ".md")
    "markdown"
    "clojure"))

(defn- render-file-block
  "Render one fenced review block, truncating its source when necessary."
  [{:keys [path content]} max-code-length]
  (let [language (file-language path)]
    (str "=== EDITED FILE: " path " ===\n"
         "```" language "\n"
         (clip-with-marker content max-code-length language)
         "\n```\n")))

(defn- build-review-prompt
  "Build one bounded batch prompt with the standing rubric included once.

   The rubric is the configured skills, re-read on every review."
  [files {:keys [skills] :as config}]
  (let [max-code-length (required-positive-config config [:max-code-length])
        max-batch-length (required-positive-config config [:max-batch-length])
        max-rubric-length (required-positive-config config [:max-rubric-length])
        loaded-skills (load-skills skills max-rubric-length)
        files (vec files)
        {:keys [kept]}
        (reduce
         (fn [{:keys [kept total]} file]
           (let [block-length
                 (count (render-file-block file max-code-length))]
             (if (or (empty? kept)
                     (<= (+ total block-length) max-batch-length))
               {:kept (conj kept file)
                :total (+ total block-length)}
               (reduced {:kept kept :total total}))))
         {:kept [] :total 0}
         (reverse files))
        dropped (- (count files) (count kept))
        ordered (reverse kept)]
    (when (pos? dropped)
      (log! "REVIEW_BATCH_TRUNCATED" (str "dropped-oldest=" dropped)))
    (log! "REVIEW_RUBRIC"
          (str "skills=" (str/join "," (map :name loaded-skills))))
    (str
     "Do not call tools or inspect the filesystem. Review only the supplied "
     "rubric and file blocks.\n\n"
     "You are a code reviewer for the Seon project. Review the edited "
     "file(s) below. Find REAL DEFECTS first: correctness bugs, concurrency "
     "hazards, and silent failure paths. Then check project-convention "
     "conformance using the rubric below. Be terse and high-signal; report "
     "only actionable issues, not style preferences. Review each file "
     "separately and name it. If a file is fine, say so in one line.\n\n"
     "Two current source-grounded rulings override any conflicting general "
     "rubric text:\n"
     "1. `[:maybe]` is allowed in in-memory function RETURN contracts "
     "(stored attributes stay nil-free — the bridge forces absence there). "
     "Do not flag an in-memory return contract merely for using `[:maybe]`; "
     "flag stored nil or `[:maybe]` on a stored attribute.\n"
     "2. `datahike.api/transact` accepts BOTH the arg-map "
     "`{:tx-data [...] :tx-meta {...}}` and raw vector/sequence forms. "
     "Do not claim the arg-map form is passed as entity data; only a map "
     "missing `:tx-data` is invalid.\n\n"
     "A file block may be a PARTIAL VIEW: the prompt has a size budget, so "
     "long text is cut and the cut is labelled in-band with a "
     "`REVIEW TRUNCATION` marker. Everything before such a marker is exact. "
     "Never report incompleteness, an unbalanced form, or a syntax error "
     "that is explained by a truncation marker — review only what you can "
     "see.\n\n"
     (str/join
      ""
      (map (fn [{:keys [name content]}]
             (str "=== SEON SKILL: " name " (rubric) ===\n" content "\n\n"))
           loaded-skills))
     (str/join
      "\n"
      (map #(render-file-block % max-code-length) ordered)))))

(defn- call-agy
  "Call `agy` with the bounded prompt argument, bounded by `timeout-ms`."
  [prompt timeout-ms]
  (try
    (let [child (process/process ["agy" "-p" prompt]
                                 {:out :string :err :string})
          finished (deref child timeout-ms ::timeout)]
      (if (= finished ::timeout)
        (do
          (process/destroy-tree child)
          (log! "REVIEW_TIMEOUT" (str timeout-ms "ms"))
          nil)
        (let [{:keys [exit out]} finished
              review (str/trim (or out ""))]
          (if (and (zero? exit) (seq review))
            review
            (do
              (log! "REVIEW_AGY_FAIL" (str "exit=" exit))
              nil)))))
    (catch java.io.IOException _
      (log! "REVIEW_AGY_UNAVAILABLE")
      nil)
    (catch Exception error
      (log! "REVIEW_AGY_EXCEPTION" (.getMessage error))
      nil)))

(defn- utc-review-path []
  (let [formatter
        (java.time.format.DateTimeFormatter/ofPattern
         "yyyyMMdd'T'HHmmss.SSS'Z'")]
    (io/file
     reviews-path
     (str (.format formatter
                   (.atZone (java.time.Instant/now)
                            java.time.ZoneOffset/UTC))
          ".md"))))

(defn- write-full-review!
  "Write the complete Gemini response to a UTC-named Markdown file."
  [review]
  (try
    (when-not (.exists reviews-path)
      (.mkdirs reviews-path))
    (let [path (utc-review-path)]
      (spit path (str review "\n"))
      (.getPath path))
    (catch Exception error
      (log! "REVIEW_WRITE_ERROR" (.getMessage error))
      nil)))

(defn- process-alive?
  [pid]
  (try
    (let [process (java.lang.ProcessHandle/of (long pid))]
      (and (.isPresent process) (.isAlive (.get process))))
    (catch Exception _ false)))

(defn- read-review-worker-unlocked []
  (try
    (let [file (io/file review-worker-path)]
      (when (.exists file) (edn/read-string (slurp file))))
    (catch Exception _ nil)))

(defn- launch-hook-worker!
  "Start one detached hook worker; admission and state remain under the pending lock."
  [arguments]
  (.start
   (doto (ProcessBuilder.
          ^java.util.List (into [(str (root-file "bin/seon-hook"))] arguments))
     (.directory (io/file repo-root))
     (.redirectOutput java.lang.ProcessBuilder$Redirect/DISCARD)
     (.redirectError java.lang.ProcessBuilder$Redirect/DISCARD))))

(defn- launch-review-worker-unlocked!
  "Launch and record one detached worker. Caller owns the pending lock."
  [interval-seconds]
  (try
    (let [child (launch-hook-worker! ["--review-worker" (str interval-seconds)])
          state {:seon.review.worker/pid (.pid child)
                 :seon.review.worker/window-start-ms
                 (System/currentTimeMillis)
                 :seon.review.worker/interval-seconds interval-seconds}]
      (spit review-worker-path (pr-str state))
      (log! "REVIEW_WORKER_STARTED"
            (str "pid=" (.pid child))
            (str "interval=" interval-seconds "s"))
      true)
    (catch Exception error
      (log! "REVIEW_WORKER_START_FAILED" (.getMessage error))
      false)))

(defn- ensure-review-worker-unlocked! [interval-seconds]
  (let [worker (read-review-worker-unlocked)]
    (when-not (process-alive? (:seon.review.worker/pid worker))
      (launch-review-worker-unlocked! interval-seconds))))

(defn- schedule-gemini-review!
  "Coalesce paths and ensure one asynchronous review window exists."
  [event config]
  (try
    (let [review-config (:review config)
          review-paths
          (->> (event-file-paths event)
               (map absolute-file-path)
               (filter reviewable-file?)
               vec)]
      (when (and (= (:hook_event_name event) "PostToolUse")
                 (get review-config :enabled false)
                 (seq review-paths))
        (with-pending-lock
          (fn []
            (accumulate-pending-unlocked! review-paths)
            (ensure-review-worker-unlocked!
             (get review-config :interval-seconds 120))))))
    (catch Exception error
      (log! "REVIEW_SCHEDULE_ERROR" (.getMessage error))))
  nil)

(defn- pending-files [pending]
  (->> pending
       (keep
        (fn [{:seon.review.pending/keys [path] :as entry}]
          (when-let [content
                     (try (slurp path) (catch Exception _ nil))]
            (when (seq content)
              (assoc entry :path path :content content)))))
       vec))

(defn- run-review-worker!
  "Wait for one window, review its snapshot once, then exit or hand off.

   Provider failures drop this snapshot. Edits arriving during the call are
   preserved and get one new worker window; reviews never retry themselves."
  [interval-seconds]
  (try
    (Thread/sleep (* 1000 (max 0 interval-seconds)))
    (let [config (load-config)
          review-config (:review config)
          pending (read-pending)
          files (pending-files pending)]
      (when (and (get review-config :enabled false) (seq files))
        (let [prompt
              (build-review-prompt
               files
               review-config)
              _ (log! "REVIEW_BATCH"
                      (str "count=" (count files))
                      (str "files="
                           (str/join "," (map #(-> % :path io/file .getName)
                                               files))))
              review (call-agy
                      prompt
                      (* 1000 (required-positive-config
                               review-config [:call-timeout-seconds])))]
          (when (seq review)
            (write-full-review! review))))
      ;; This batch is consumed even if Gemini is unavailable. Entries added
      ;; during the call have different ids and survive `clear-reviewed`.
      (clear-reviewed-pending! pending)
      (with-pending-lock
        (fn []
          (let [current (read-pending-unlocked)]
            (if (seq current)
              (launch-review-worker-unlocked! interval-seconds)
              (.delete (io/file review-worker-path)))))))
    (catch Exception error
      ;; Advisory means silent to the editor. Remove this worker admission so
      ;; a later edit can open a fresh window; never self-retry a failed batch.
      (log! "REVIEW_WORKER_ERROR" (.getMessage error))
      (try (.delete (io/file review-worker-path)) (catch Exception _ nil))))
  nil)

(defn- beneath?
  [parent child]
  (let [parent (str (.getCanonicalPath (io/file parent)) java.io.File/separator)
        child (absolute-file-path child)]
    (and child (str/starts-with? child parent))))

(defn- source-index-path?
  "True for first-party files admitted to the current-src publication."
  [file-path]
  ;; Only program inputs publish: first-party Clojure under src/ and test/, the
  ;; shipped config manifest, and schema resources. A path outside the program
  ;; graph (docs, tmp, logs) is a gate-selection question for bin/test, never
  ;; a publication: on 2026-09-19 every markdown edit ran a complete
  ;; publication and adoption of default through the retired widening clause.
  (let [lower (some-> file-path str/lower-case)]
    (or (and (or (str/ends-with? lower ".clj")
                 (str/ends-with? lower ".cljc"))
             (or (beneath? (root-file "src") file-path)
                 (beneath? (root-file "test") file-path)))
        (= (absolute-file-path (root-file "config/default.edn"))
           (absolute-file-path file-path))
        (schema-resource-path? file-path))))

(defn- publish-source-paths
  "Send one publication request and return its terminal feedback."
  {:malli/schema [:=> [:cat [:vector :string] :map] :string]}
  [paths config]
  (try
    (let [timeout-ms (* 1000 (required-positive-config config [:current-source :timeout-seconds]))
          root (operator/canonical-root (absolute-file-path (get-in config [:current-source :root] ".")))
          cluster (get-in config [:current-source :cluster])
          endpoint (operator/advertisement root cluster)
          _ (when-not endpoint
              (throw (ex-info "No live publication endpoint; start the selected root."
                              {:seon.operator/root root :seon.boot/cluster-name cluster})))
          form (pr-str
                `(do
                   (~'seon.cluster/project-next-prepl-value!
                    {:seon.dev.mcp/read-only? false :seon.dev.mcp/project? false})
                   (try
                     (~'seon.cluster/refresh-source! ~root ~paths ~cluster)
                     (catch Throwable failure#
                       (merge {:seon.error/at (java.util.Date.)
                               :seon.error/layer :seon.cluster/publication
                               :seon.error/operation '~'seon.cluster/refresh-source!
                               :seon.error/message (ex-message failure#)}
                              (ex-data failure#))))))
          result (operator/prepl-value! endpoint form timeout-ms
                                       (fn [output] (binding [*out* *err*] (print output) (flush)))
                                       timeout-ms)]
      (cond
        (:seon.error/message result) (str "refused: " (pr-str result))
        (and (:seon.source/commit-id result)
             (vector? (:seon.source/reloaded-namespaces result))
             (set? (:seon.source/arming-identities result)))
        (str "accepted: " (pr-str result))
        :else (str "degraded: " (pr-str (operator/diagnostic
                                        "Publication returned no complete terminal evidence."
                                        {:seon.operator/reply result} :client-failed)))))
    (catch Exception failure
      (str "degraded: " (pr-str (operator/diagnostic
                                (ex-message failure) (or (ex-data failure) {}) :client-failed))))))

(defn- current-source-feedback
  "Publish the admitted named and derived paths synchronously in one request."
  {:malli/schema [:=> [:cat :map :map [:vector :string]] [:maybe :string]]}
  [event config derived-paths]
  (let [paths (->> (concat (event-file-paths event) derived-paths)
                   (filter source-index-path?)
                   (map absolute-file-path) distinct vec)]
    (when (and (= (:hook_event_name event) "PostToolUse")
               (get-in config [:current-source :enabled] true)
               (seq paths))
      (publish-source-paths paths config))))


;;; ---------------------------------------------------------------------------
;;; Writes no tool payload names
;;; ---------------------------------------------------------------------------

;; A tool whose payload names no file still writes files: `apply_patch` from
;; a heredoc, `python`, `sed`, `cat >`. Those tools carry no path for the
;; hook to check, so the changed files are DERIVED — every declared root is
;; walked and each Clojure file's content digest compared with the digest
;; recorded at this session's previous PostToolUse. Never a modification
;; time: a write that restores an old mtime, or two writes inside one clock
;; tick, are exactly the cases a digest still sees.
;;
;; Measured in this checkout, 2026-09-17: walking the five declared roots and
;; digesting all 553 Clojure files (9 MB) is 112 ms, inside a 212 ms bb
;; process. `git status --porcelain` — the cheaper-sounding option — is 2.7 s
;; warm and 9.6 s cold here, because the working tree carries tmp/ run roots
;; and the reference-code submodules. The complete scan is 25x cheaper than
;; scoping by git status, so the scan is complete.

(def ^:private session-digest-root (io/file review-state-root "session-digests"))
(def ^:private session-digest-lifetime-ms (* 24 60 60 1000))

(defn- content-digest
  "The SHA-256 of a file's exact bytes."
  [^java.io.File file]
  (let [digest (java.security.MessageDigest/getInstance "SHA-256")]
    (apply str (map #(format "%02x" %)
                    (.digest digest
                             (java.nio.file.Files/readAllBytes (.toPath file)))))))

(defn- scan-roots
  "The declared roots, or nil when this config declares no derived scan.

  A config that declares `:shell-writes` must declare its roots — there is
  no literal fallback. A config that omits the key entirely is a fixture
  that is not exercising this check; the checked-in development config
  declares it, and `the-development-hook-config-keeps-the-derived-scan`
  is the regression that says so."
  [config]
  (when-let [settings (:shell-writes config)]
    (when (get settings :enabled true)
      (let [roots (:roots settings)]
        (when-not (and (vector? roots) (seq roots) (every? string? roots))
          (throw (ex-info "Hook configuration requires shell-write scan roots."
                          {:seon.hook/config-path [:shell-writes :roots]
                           :seon.hook/config-file config-path
                           :seon.hook/config-value roots})))
        roots))))

(defn- tree-digests
  "Every Clojure file under the declared roots, keyed by its repository path."
  [roots]
  (into {}
        (comp (mapcat #(file-seq (root-file %)))
              (filter #(.isFile ^java.io.File %))
              (map #(.getPath ^java.io.File %))
              (filter clojure-file?)
              (map (juxt display-path #(content-digest (io/file %)))))
        roots))

(defn- session-key
  "A file-safe name for one session's recorded digests."
  [session]
  (let [allowed (set "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")
        text (apply str (filter allowed (str session)))]
    (if (str/blank? text) "orchestrator" (subs text 0 (min 64 (count text))))))

(defn- session-digest-path [session]
  (io/file session-digest-root (str (session-key session) ".edn")))

(defn- prune-session-digests! []
  (doseq [^java.io.File file (or (.listFiles session-digest-root) [])]
    (when (> (- (System/currentTimeMillis) (.lastModified file))
             session-digest-lifetime-ms)
      (.delete file))))

(defn- recorded-digests
  "The digests this session recorded at its previous event, or nil."
  [session]
  (try
    (let [file (session-digest-path session)]
      (when (.isFile file)
        (let [recorded (edn/read-string (slurp file))]
          (when (map? recorded) (:seon.hook/digests recorded)))))
    (catch Exception _ nil)))

(defn- event-agent
  "The subagent identity a payload carries, when one made this tool call.

  A subagent's tool calls fire its PARENT session's hooks, so `agent_id` is
  the only thing in the payload that distinguishes them
  (`docs/seon/reference/claude-code-hooks-2026-09-17.md`)."
  [event]
  (let [agent (cond-> {}
                (:agent_id event) (assoc :seon.hook/agent-id (:agent_id event))
                (:agent_type event) (assoc :seon.hook/agent-type
                                           (:agent_type event)))]
    (when (seq agent) agent)))

(defn- record-digests! [session event digests]
  (let [file (session-digest-path session)]
    (io/make-parents file)
    (spit file (pr-str (cond-> {:seon.hook/digests digests
                                :seon.hook/session session
                                :seon.hook/recorded-at (str (java.time.Instant/now))}
                         (event-agent event) (merge (event-agent event)))))
    (prune-session-digests!)))

(defn- derived-write-feedback
  "Refuse when a write the payload never named left unreadable Clojure.

  The bytes are already written — a shell write has no payload to check
  before it lands — so the refusal fires the moment the tool returns and
  names the path and the tool that wrote it. It runs on EVERY PostToolUse,
  including a payload-named edit: a codex lane fires this hook only for
  `apply_patch`, so its next patch is the first moment an earlier shell
  write of its own can be reported to it at all. Paths the payload named
  are left to the payload's own check, which already ran."
  {:malli/schema [:=> [:cat :map :map]
                  [:maybe [:map
                           [:seon.hook/paths [:vector :string]]
                           [:seon.hook/refusal [:maybe :string]]]]]}
  [event config]
  (when (and (= "PostToolUse" (:hook_event_name event))
             (get-in config [:shell-writes :enabled] true))
    (when-let [roots (scan-roots config)]
     (let [session (or (:session_id event) "orchestrator")
          previous (recorded-digests session)
          digests (tree-digests roots)
          named (into #{} (map display-path) (event-file-paths event))
          changed (when previous
                    (vec (sort (keep (fn [[path digest]]
                                       (when (and (not= digest (get previous path))
                                                  (not (contains? named path)))
                                         path))
                                     digests))))]
      (record-digests! session event digests)
      (when (seq changed)
        (let [analysis (run-clj-kondo {:seon.hook/file-paths changed})
              syntax-errors (filterv #(and (= :error (:level %))
                                           (= :syntax (:type %)))
                                     (:seon.hook.analysis/findings analysis))]
          (log! "DERIVED_WRITE" (str "tool=" (:tool_name event))
                (str "session=" session)
                (str "agent=" (pr-str (event-agent event)))
                (str "changed=" (pr-str changed)))
          {:seon.hook/paths changed
           :seon.hook/refusal
           (cond
            (analysis-error analysis)
            (str "BLOCKED: " (:tool_name event) " changed "
                 (count changed) " Clojure file(s) and the hook could not "
                 "check them: " (analysis-error analysis))

            (seq syntax-errors)
            (str "BLOCKED: " (:tool_name event)
                 " left unreadable Clojure on disk. The bytes are already "
                 "written — repair them before anything else loads them:\n"
                 (format-clj-kondo-findings syntax-errors)))}))))))

(defn- refuse-with
  "Refuse with a response built by `refusal-response`."
  [response]
  (refuse! response (:reason response)))

(defn- refusal-response
  "One PreToolUse refusal, in both shapes a harness may read.

  Claude Code's current form is `hookSpecificOutput.permissionDecision:
  \"deny\"` with `permissionDecisionReason`
  (`docs/seon/reference/claude-code-hooks-2026-09-17.md`); the top-level
  `decision`/`reason` pair is what codex honours today, proven live at
  2026-09-17T01:39:12Z when a lane received \"Command blocked by PreToolUse
  hook: BLOCKED: …\". Both carry the SAME text, because the reason is the
  thing the agent has to act on."
  [blocked]
  (let [reason (:reason blocked)]
    {:decision "block"
     :reason reason
     :hookSpecificOutput {:hookEventName "PreToolUse"
                          :permissionDecision "deny"
                          :permissionDecisionReason reason}}))

(defn- feedback-response
  "One PostToolUse response: advisory context, and a refusal when one stands.

  A refusal is a decision, not a paragraph in the advisory tail: the edit
  already wrote its bytes, so the only honest thing left is to say loudly
  that the result is broken and must be repaired now."
  [feedback refusal]
  (let [messages (vec (remove str/blank? feedback))]
    (cond-> (if (seq messages)
              {:continue true
               :hookSpecificOutput
               {:hookEventName "PostToolUse"
                :additionalContext (str/join "\n\n" messages)}}
              {:continue true})
      (not (str/blank? refusal))
      (assoc :decision "block" :reason refusal))))

;;; ---------------------------------------------------------------------------
;;; Main Entry Point
;;; ---------------------------------------------------------------------------

(defn -main []
  (let [event (try
                (json/parse-string (slurp *in*) true)
                (catch Exception _ nil))
        file-paths (event-file-paths event)
        event-name (:hook_event_name event)
        tool-name (:tool_name event)
        edit-event? (and (#{"PreToolUse" "PostToolUse"} event-name)
                         (#{"apply_patch" "Edit" "Write"} tool-name))
        local-paths (filterv repository-file? file-paths)
        mixed-scope? (and (seq local-paths)
                          (not= (count local-paths) (count file-paths)))
        ;; an edit whose payload names no path at all is an edit the hook
        ;; cannot check: it is refused, never waved through as "nothing here"
        pathless-edit? (and edit-event? (empty? file-paths))
        local-edit? (and edit-event?
                         (seq file-paths)
                         (= (count local-paths) (count file-paths)))]
    (cond
      pathless-edit?
      (do (log! "PATHLESS_EDIT" (str "tool=" tool-name)
                (str "input=" (pr-str (:tool_input event))))
          (refuse-with
           (refusal-response
            {:reason (str "BLOCKED: the hook found no file path in this "
                         tool-name
                         " payload, so it cannot check what the edit writes. "
                         "Reissue the edit naming its file explicitly.")})))

      mixed-scope?
      (refuse-with
       (refusal-response
        {:reason (str "BLOCKED: one edit cannot mix Seon files with paths "
                      "outside this checkout.")}))

      ;; a tool whose payload names no path can still have written one:
      ;; derive the change from the tree instead of reading "no path named"
      ;; as "nothing was written"
      (not local-edit?)
      (try
        (let [config (load-config)
              derived (when (#{"PreToolUse" "PostToolUse"} event-name)
                        (derived-write-feedback event config))
              refusal (:seon.hook/refusal derived)]
          (if refusal
            (do (log! "DERIVED_BLOCK" (str "tool=" tool-name) refusal)
                (refuse! {:decision "block" :reason refusal} refusal))
            (output! (feedback-response
                      [(current-source-feedback event config (vec (:seon.hook/paths derived)))] nil))))
        ;; a derived scan that throws has checked nothing; saying so is the
        ;; only honest answer, because silence here is what let a shell write
        ;; break the tree in the first place
        (catch Exception e
          (let [message (throwable-message e)]
            (log! "DERIVED_SCAN_FAILED" (str "tool=" tool-name) message)
            (output!
             {:decision "block"
              :reason (str "BLOCKED: the hook could not tell whether this "
                           tool-name " wrote Clojure source: " message)}))))

      :else
      (try
        (let [config (load-config)]
          (log! event-name
                (str "tool=" tool-name)
                (str "session=" (or (:session_id event) "orchestrator"))
                (str "agent=" (pr-str (event-agent event)))
                (str "files=" (str/join "," file-paths)))
          (if (= event-name "PreToolUse")
            (let [path-events (map #(assoc event :seon.hook/file-path %)
                                   file-paths)
                  schema-blocked (some validate-schema-edit path-events)
                  lint-blocked
                  (when (get-in config [:lint :enabled] true)
                    (some validate-clojure-edit path-events))
                  blocked (or schema-blocked lint-blocked)]
              (if blocked
                (do
                  (log! "CLOJURE_BLOCK" (:reason blocked))
                  (refuse! (refusal-response blocked) (:reason blocked)))
                (output! {:continue true})))
            (let [path-events (map #(assoc event :seon.hook/file-path %)
                                   file-paths)
                  schema-admission (schema-admission-feedback event config)
                  feedback (mapcat
                             (fn [path-event]
                               [(markdown-feedback path-event config)
                                (docstring-feedback path-event config)])
                             path-events)
                  lint (clj-kondo-feedback event config)
                  feedback
                  (into [(:seon.hook.lint/feedback lint)
                         (:seon.hook.schema-admission/feedback
                          schema-admission)]
                        feedback)
                  _ (schedule-gemini-review! event config)
                  derived (derived-write-feedback event config)
                  refusal (or (:seon.hook.lint/refusal lint) (:seon.hook/refusal derived))
                  feedback
                  (cond-> (vec feedback)
                    (and (str/blank? refusal)
                         (not (:seon.hook.schema-admission/errors? schema-admission)))
                    (conj (current-source-feedback event config (vec (:seon.hook/paths derived)))))
                  feedback (vec feedback)]
              (when-not (str/blank? refusal) (log! "CLOJURE_REFUSAL" refusal))
              (if (str/blank? refusal)
                (output! (feedback-response feedback refusal))
                (refuse! (feedback-response feedback refusal) refusal)))))
        (catch Exception e
          (let [message (throwable-message e)
                stack (with-out-str
                        (binding [*err* *out*]
                          (.printStackTrace e (java.io.PrintWriter. *out* true))))]
            ;; the class name alone hid an all-afternoon feedback outage;
            ;; the stack is the diagnosis, log it every time
            (log! "ERROR" message (str/replace stack "\n" " | "))
            (binding [*out* *err*]
              (println "HOOK ERROR:" message))
            (output! {:continue true})))))))

(cond
  (= "--review-worker" (first *command-line-args*))
  (run-review-worker!
   (or (some-> (second *command-line-args*) parse-long) 120))
  :else (-main))
