#!/usr/bin/env bb

;; Direct Babashka hook for Clojure and Markdown edits.
;;
;; This script:
;; 1. Receives hook events from Codex or Claude Code (JSON on stdin)
;; 2. Loads configuration from .claude/seon-hook.edn
;; 3. Validates prospective Clojure syntax before an edit
;; 4. Runs the canonical Markdown/docstring linters after an edit
;; 5. Runs the bounded, rate-limited Gemini review and live core-fault gate
;;
;; It has no running Seon-process dependency. Pure linter namespaces load
;; directly into Babashka only for the file type that needs them.

(require '[babashka.deps :as deps]
         '[babashka.process :as process]
         '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str]

         '[edamame.core :as edamame])

;;; ---------------------------------------------------------------------------
;;; Paths
;;; ---------------------------------------------------------------------------

;; This script's location is the authority. Environment cwd/project variables
;; describe the caller and may point at another checkout when a globally
;; installed hook fires; they must never redirect Seon's checks or artifacts.
(def repo-root
  (some-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getPath))

(defn- root-file
  "A java.io.File for `parts` resolved from the repo root."
  ^java.io.File [& parts]
  (apply io/file repo-root parts))

(def config-path
  (or (System/getenv "SEON_HOOK_CONFIG")
      (str (root-file ".claude/seon-hook.edn"))))

(def conventions-path (root-file "docs/conventions.md"))
(def skills-path (root-file ".agents/skills"))
(def last-review-path (root-file "tmp/.last-review"))
(def pending-review-path (root-file "tmp/.pending-review"))
(def pending-review-lock-path (root-file "tmp/.pending-review.lock"))
(def reviews-path (root-file "tmp/reviews"))
(def max-pending-files 50)

;;; ---------------------------------------------------------------------------
;;; Logging
;;; ---------------------------------------------------------------------------

(def hook-log-path (root-file "logs/hook-debug.log"))
(def hook-log-cap (* 1024 1024))

(defn- log!
  "Append one line to the bounded hook diagnostic log. Never throws."
  [& parts]
  (try
    (let [log-dir (root-file "logs")
          obsolete (root-file "logs/hook-debug.log.1")
          line (.getBytes
                (str (java.util.Date.) " | " (str/join " | " parts) "\n")
                "UTF-8")]
      (when-not (.exists log-dir) (.mkdirs log-dir))
      (when (.exists obsolete) (.delete obsolete))
      (with-open [raf (java.io.RandomAccessFile. hook-log-path "rw")
                  channel (.getChannel raf)
                  lock (.lock channel)]
        (when (> (.size channel) hook-log-cap)
          (.truncate channel 0))
        (.position channel (.size channel))
        (.write channel (java.nio.ByteBuffer/wrap line))))
    (catch Exception _ nil)))

;;; ---------------------------------------------------------------------------
;;; Configuration
;;; ---------------------------------------------------------------------------

(defn- load-config []
  (let [f (io/file config-path)]
    (if (.exists f)
      (try (edn/read-string (slurp f)) (catch Exception _ {}))
      {})))

(defn- output! [response]
  (when (seq response)
    (println (json/generate-string response))))

;;; ---------------------------------------------------------------------------
;;; File Type Detection
;;; ---------------------------------------------------------------------------

(defn- clojure-file? [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (some #(clojure.string/ends-with? lower-path %)
            [".clj" ".cljs" ".cljc" ".bb" ".edn"]))))

(defn- claude-file-path [event]
  (or (get-in event [:tool_input :file_path])
      (get-in event [:tool_input :filePath])))

(defn- patch-file-paths
  "Return every source and destination path named by a Codex patch."
  [patch]
  (when (string? patch)
    (->> (concat
           (map second
                (re-seq
                  #"(?m)^\*\*\* (?:Add|Update|Delete) File: (.+?)\r?$"
                  patch))
           (map second
                (re-seq #"(?m)^\*\*\* Move to: (.+?)\r?$" patch)))
         (map str/trim)
         (remove str/blank?)
         distinct
         vec)))

(defn- event-file-paths
  "Normalize the complete path set from Codex and Claude edit payloads."
  [event]
  (if (= "apply_patch" (:tool_name event))
    (patch-file-paths (get-in event [:tool_input :command]))
    (some-> (claude-file-path event) vector)))

(defn- get-file-path [event]
  (or (:seon.hook/file-path event)
      (first (event-file-paths event))))

(defn- absolute-file-path [file-path]
  (try
    (when file-path
      (let [file (io/file file-path)]
        (.getPath (.getCanonicalFile
                    (if (.isAbsolute file) file (root-file file-path))))))
    (catch Exception _ nil)))

(defn- repository-file?
  "True when the canonical event path is inside this script's checkout."
  [file-path]
  (when-let [path (absolute-file-path file-path)]
    (let [prefix (str repo-root java.io.File/separator)]
      (or (= path repo-root) (str/starts-with? path prefix)))))

;;; ---------------------------------------------------------------------------
;;; Syntax Validation
;;; ---------------------------------------------------------------------------

(defn- validate-clojure-syntax [code-string]
  ;; Use edamame with permissive options to validate syntax without requiring
  ;; runtime context (namespace aliases, reader tags like #env, #profile, etc.)
  (try
    (edamame/parse-string-all
     code-string
     {:all true                              ; Parse all forms
      :read-cond :allow                      ; Allow reader conditionals
      :features #{:clj :cljs}                ; Support both Clojure and ClojureScript
      :auto-resolve (fn [alias] (if alias (symbol (str "ns." alias)) 'user))  ; Unique ns per alias
      :readers (fn [_tag] identity)})        ; Accept any reader tag
    {:valid true}
    (catch Exception e
      {:valid false :error (.getMessage e)})))

(defn- reconstruct-file-content [event]
  (let [tool-name (:tool_name event)
        tool-input (:tool_input event)
        file-path (get-file-path event)]
    (cond
      (= tool-name "Write")
      (:content tool-input)

      (= tool-name "Edit")
      (let [old-string (:old_string tool-input)
            new-string (:new_string tool-input)]
        (when (and file-path old-string)
          (try
            (let [current (slurp (absolute-file-path file-path))]
              (if (:replace_all tool-input)
                (clojure.string/replace current old-string new-string)
                (clojure.string/replace-first current old-string new-string)))
            (catch Exception _ nil))))

      :else nil)))

;;; ---------------------------------------------------------------------------
;;; Validation Functions (return block response or nil)
;;; ---------------------------------------------------------------------------

(defn- validate-clojure-edit
  "Validate syntax for ANY Clojure file edit. Returns block response or nil."
  [event]
  (let [file-path (get-file-path event)]
    (when (and (= (:hook_event_name event) "PreToolUse")
               (clojure-file? file-path))
      (when-let [new-content (reconstruct-file-content event)]
        (let [validation (validate-clojure-syntax new-content)]
          (when-not (:valid validation)
            {:decision "block"
             :reason (str "BLOCKED: Invalid Clojure syntax.\n\n"
                          "Error: " (:error validation) "\n\n"
                          "Your edit would create broken code. Check:\n"
                          "1. Balanced delimiters (parens, brackets, braces)\n"
                          "2. old_string matches file content exactly\n"
                          "3. new_string is complete, valid Clojure\n\n"
                          "TIP: If struggling, try Write to replace the entire function.")}))))))

(defn- clojure-syntax-feedback
  "Report invalid syntax in an edited file after the tool has written it."
  [event]
  (let [file-path (get-file-path event)
        absolute-path (absolute-file-path file-path)]
    (when (and (= (:hook_event_name event) "PostToolUse")
               (clojure-file? file-path)
               absolute-path
               (.isFile (io/file absolute-path)))
      (try
        (let [validation (validate-clojure-syntax (slurp absolute-path))]
          (when-not (:valid validation)
            (str "Invalid Clojure syntax after editing " file-path ": "
                 (:error validation))))
        (catch Exception e
          (str "Could not validate " file-path ": " (.getMessage e)))))))

;;; ---------------------------------------------------------------------------
;;; Markdown File Detection
;;; ---------------------------------------------------------------------------

(defn- docs-markdown-file?
  "Returns true if file-path is a .md file under docs/."
  [file-path]
  (when file-path
    (let [lower-path (clojure.string/lower-case file-path)]
      (and (clojure.string/ends-with? lower-path ".md")
           (or (clojure.string/starts-with? lower-path "docs/")
               (clojure.string/includes? lower-path "/docs/"))))))

(defn- clojure-source-file? [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (some #(str/ends-with? lower %) [".clj" ".cljs" ".cljc"]))))

(defn- load-direct-check! [namespace]
  ;; The hook itself stays a fast, dependency-free bb script. Malli is needed
  ;; only because the canonical pure linters carry their public schemas.
  (deps/add-deps
   {:deps {'seon/hook-source {:local/root repo-root}}})
  (require namespace))

(defn- clip-feedback [config message]
  (load-direct-check! 'seon.ai.tokens)
  ((requiring-resolve 'seon.ai.tokens/clip-str)
   message
   (get-in config [:feedback :max-tokens] 300)))

(defn- markdown-feedback [event config]
  (when (and (= (:hook_event_name event) "PostToolUse")
             (get-in config [:markdown-lint :enabled] true)
             (docs-markdown-file? (get-file-path event)))
    (try
      (load-direct-check! 'seon.dev.markdown)
      (let [file-path (absolute-file-path (get-file-path event))
            validate-file (requiring-resolve 'seon.dev.markdown/validate-file)
            fix (requiring-resolve 'seon.dev.markdown/fix)
            format-violations (requiring-resolve 'seon.dev.markdown/format-violations)
            request {:seon.dev.markdown/file-path file-path
                     :seon.dev.markdown/vault-root (str (root-file "docs"))}
            initial (validate-file request)
            _ (when-not (:seon.dev.markdown/valid? initial)
                (let [fixed (fix {:seon.dev.markdown/content (slurp file-path)})]
                  (when (pos? (:seon.dev.markdown/fixed-count fixed))
                    (spit file-path (:seon.dev.markdown/content fixed)))))
            final (if (:seon.dev.markdown/valid? initial)
                    initial
                    (validate-file request))]
        (when-not (:seon.dev.markdown/valid? final)
          (clip-feedback
           config
           (:seon.dev.markdown/formatted
            (format-violations
             {:seon.dev.markdown/violations (:seon.dev.markdown/violations final)
              :seon.dev.markdown/max-length Long/MAX_VALUE})))))
      (catch Exception e
        (log! "MARKDOWN_LINT_ERROR" (.getMessage e))
        nil))))

(defn- docstring-feedback [event config]
  (when (and (= (:hook_event_name event) "PostToolUse")
             (get-in config [:docstring-lint :enabled] true)
             (clojure-source-file? (get-file-path event)))
    (try
      (load-direct-check! 'seon.dev.docstring)
      (let [check-file (requiring-resolve 'seon.dev.docstring/check-file)
            format-findings (requiring-resolve 'seon.dev.docstring/format-findings)
            result (check-file
                    {:seon.dev.docstring/file-path
                     (absolute-file-path (get-file-path event))})]
        (when-not (:seon.dev.docstring/clean? result)
          (clip-feedback
           config
           (:seon.dev.docstring/formatted
            (format-findings
             {:seon.dev.docstring/findings (:seon.dev.docstring/findings result)
              :seon.dev.docstring/max-length Long/MAX_VALUE})))))
      (catch Exception e
        (log! "DOCSTRING_LINT_ERROR" (.getMessage e))
        nil))))

;;; ---------------------------------------------------------------------------
;;; Rate-limited Gemini review
;;; ---------------------------------------------------------------------------

(defn- reviewable-file?
  "True for source, configuration, and Markdown files worth an AI review."
  [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)]
      (or (clojure-file? file-path)
          (str/ends-with? lower ".md")))))

(defn- review-rate-limited?
  "True when the last Gemini review is newer than `interval-seconds`."
  [interval-seconds]
  (let [file (io/file last-review-path)]
    (and (.exists file)
         (try
           (let [last-ms (Long/parseLong (str/trim (slurp file)))
                 elapsed-ms (- (System/currentTimeMillis) last-ms)]
             (< elapsed-ms (* 1000 interval-seconds)))
           (catch Exception _ false)))))

(defn- touch-last-review! []
  (try
    (io/make-parents last-review-path)
    (spit last-review-path (str (System/currentTimeMillis)))
    (catch Exception _ nil)))

(defn- with-pending-lock
  "Run one pending-review state transition under an exclusive file lock."
  [transition]
  (try
    (io/make-parents pending-review-path)
    (with-open [file (java.io.RandomAccessFile. pending-review-lock-path "rw")
                channel (.getChannel file)]
      (let [_lock (.lock channel)]
        ;; Closing the channel releases the lock; Babashka does not expose
        ;; FileLock.close through SCI.
        (transition)))
    (catch Exception error
      (log! "REVIEW_PENDING_LOCK_ERROR" (.getMessage error))
      nil)))

(defn- parse-pending-entry [line]
  (let [[id path] (str/split line #"\t" 2)
        legacy? (nil? path)
        path (if legacy? id path)]
    (when (seq path)
      {:seon.review.pending/id (if legacy? (str "legacy:" path) id)
       :seon.review.pending/path path})))

(defn- read-pending-unlocked
  "Pending review entries in edit order, or an empty vector."
  []
  (try
    (let [file (io/file pending-review-path)]
      (if (.exists file)
        (->> (str/split-lines (slurp file))
             (map str/trim)
             (remove str/blank?)
             (keep parse-pending-entry)
             vec)
        []))
    (catch Exception _ [])))

(defn- read-pending []
  (or (with-pending-lock read-pending-unlocked) []))

(defn- write-pending-unlocked! [entries]
  (spit pending-review-path
        (str
         (str/join
          "\n"
          (map
           (fn [{:seon.review.pending/keys [id path]}]
             (str id "\t" path))
           entries))
         (when (seq entries) "\n"))))

(defn- accumulate-pending!
  "Append a path with newest-kept deduplication and a fixed file cap."
  [file-path]
  (try
    (when (seq file-path)
      (with-pending-lock
        (fn []
          (let [current
                (vec
                 (remove
                  #(= file-path (:seon.review.pending/path %))
                  (read-pending-unlocked)))
                appended
                (conj current
                      {:seon.review.pending/id
                       (str (java.util.UUID/randomUUID))
                       :seon.review.pending/path file-path})
                dropped (max 0 (- (count appended) max-pending-files))
                capped (vec (drop dropped appended))]
            (when (pos? dropped)
              (log! "REVIEW_PENDING_CAP" (str "dropped=" dropped)))
            (write-pending-unlocked! capped)))))
    (catch Exception error
      (log! "REVIEW_PENDING_ERROR" (.getMessage error))
      nil)))

(defn- clear-reviewed-pending!
  "Remove only drained entries, preserving edits appended during review."
  [reviewed-entries]
  (try
    (with-pending-lock
      (fn []
        (let [reviewed-ids
              (into #{} (map :seon.review.pending/id) reviewed-entries)]
          (write-pending-unlocked!
           (remove
            #(contains? reviewed-ids (:seon.review.pending/id %))
            (read-pending-unlocked))))))
    (catch Exception _ nil)))

(def ^:private truncation-notice
  (str "REVIEW TRUNCATION — the prompt cut this text here. The real file "
       "CONTINUES past this point and is NOT incomplete. Do NOT report a "
       "syntax error, an unbalanced form, a missing closing paren, a cut-off "
       "function, or any other incompleteness at or after this marker."))

(defn- truncation-marker
  "One unmissable in-band marker naming the prompt as the cause of the cut."
  [language]
  (if (= language "markdown")
    (str "\n\n<!-- ===== " truncation-notice " ===== -->\n")
    (str "\n\n;; ===== " truncation-notice " =====\n")))

(defn- clip-with-marker
  "`content` capped at `max-length`, marked in `language`'s comment syntax."
  [content max-length language]
  (if (> (count content) max-length)
    (str (subs content 0 max-length) (truncation-marker language))
    content))

(defn- load-rubric
  "Load one standing rubric document, capped and marked. Nil when absent."
  [^java.io.File file max-length]
  (try
    (when (.exists file)
      (let [content (slurp file)]
        (when (seq content)
          (clip-with-marker content max-length "markdown"))))
    (catch Exception error
      (log! "REVIEW_RUBRIC_UNREADABLE" (.getPath file) (.getMessage error))
      nil)))

(defn- load-skills
  "Load the configured skills' current SKILL.md text, in configured order.

   The files are read at review time, so an edited skill reaches the very
   next review with no rebuild. A missing or unreadable skill is one log
   line and is skipped — a review never fails over its rubric."
  [skill-names max-length]
  (->> skill-names
       (keep
        (fn [skill-name]
          (let [file (io/file skills-path (str skill-name) "SKILL.md")]
            (if-let [content (load-rubric file max-length)]
              {:name (str skill-name) :content content}
              (do (log! "REVIEW_SKILL_MISSING" (str skill-name))
                  nil)))))
       vec))

(defn- file-language [file-path]
  (if (str/ends-with? (str/lower-case file-path) ".md")
    "markdown"
    "clojure"))

(defn- render-file-block
  "Render one fenced review block, truncating its source when necessary."
  [{:keys [path content]} max-code-length]
  (let [language (file-language path)]
    (str "=== EDITED FILE: " path " ===\n"
         "```" language "\n"
         (clip-with-marker content max-code-length language)
         "\n```\n")))

(defn- build-review-prompt
  "Build one bounded batch prompt with the standing rubric included once.

   The rubric is the configured skills followed by `docs/conventions.md`,
   both re-read on every review."
  [files {:keys [skills max-code-length max-batch-length max-rubric-length]
          :or {skills []
               max-code-length 40000
               max-batch-length 200000
               max-rubric-length 60000}}]
  (let [loaded-skills (load-skills skills max-rubric-length)
        conventions (load-rubric (io/file conventions-path) max-rubric-length)
        files (vec files)
        {:keys [kept]}
        (reduce
         (fn [{:keys [kept total]} file]
           (let [block-length
                 (count (render-file-block file max-code-length))]
             (if (or (empty? kept)
                     (<= (+ total block-length) max-batch-length))
               {:kept (conj kept file)
                :total (+ total block-length)}
               (reduced {:kept kept :total total}))))
         {:kept [] :total 0}
         (reverse files))
        dropped (- (count files) (count kept))
        ordered (reverse kept)]
    (when (pos? dropped)
      (log! "REVIEW_BATCH_TRUNCATED" (str "dropped-oldest=" dropped)))
    (log! "REVIEW_RUBRIC"
          (str "skills=" (str/join "," (map :name loaded-skills)))
          (str "conventions=" (boolean conventions)))
    (str
     "Do not call tools or inspect the filesystem. Review only the supplied "
     "rubric and file blocks.\n\n"
     "You are a code reviewer for the Seon project. Review the edited "
     "file(s) below. Find REAL DEFECTS first: correctness bugs, concurrency "
     "hazards, and silent failure paths. Then check project-convention "
     "conformance using the rubric below. Be terse and high-signal; report "
     "only actionable issues, not style preferences. Review each file "
     "separately and name it. If a file is fine, say so in one line.\n\n"
     "Two current source-grounded rulings override any conflicting general "
     "rubric text:\n"
     "1. `[:maybe]` is allowed in in-memory function RETURN contracts "
     "(stored attributes stay nil-free — the bridge forces absence there). "
     "Do not flag an in-memory return contract merely for using `[:maybe]`; "
     "flag stored nil or `[:maybe]` on a stored attribute.\n"
     "2. `datahike.api/transact` accepts BOTH the arg-map "
     "`{:tx-data [...] :tx-meta {...}}` and raw vector/sequence forms. "
     "Do not claim the arg-map form is passed as entity data; only a map "
     "missing `:tx-data` is invalid.\n\n"
     "A file block may be a PARTIAL VIEW: the prompt has a size budget, so "
     "long text is cut and the cut is labelled in-band with a "
     "`REVIEW TRUNCATION` marker. Everything before such a marker is exact. "
     "Never report incompleteness, an unbalanced form, or a syntax error "
     "that is explained by a truncation marker — review only what you can "
     "see.\n\n"
     (str/join
      ""
      (map (fn [{:keys [name content]}]
             (str "=== SEON SKILL: " name " (rubric) ===\n" content "\n\n"))
           loaded-skills))
     (when conventions
       (str "=== PROJECT CONVENTIONS (rubric) ===\n"
            conventions
            "\n\n"))
     (str/join
      "\n"
      (map #(render-file-block % max-code-length) ordered)))))

(defn- call-agy
  "Call `agy` with the bounded prompt argument, bounded by `timeout-ms`."
  [prompt timeout-ms]
  (try
    (let [child (process/process ["agy" "-p" prompt]
                                 {:out :string :err :string})
          finished (deref child timeout-ms ::timeout)]
      (if (= finished ::timeout)
        (do
          (process/destroy-tree child)
          (log! "REVIEW_TIMEOUT" (str timeout-ms "ms"))
          nil)
        (let [{:keys [exit out]} finished
              review (str/trim (or out ""))]
          (if (and (zero? exit) (seq review))
            review
            (do
              (log! "REVIEW_AGY_FAIL" (str "exit=" exit))
              nil)))))
    (catch java.io.IOException _
      (log! "REVIEW_AGY_UNAVAILABLE")
      nil)
    (catch Exception error
      (log! "REVIEW_AGY_EXCEPTION" (.getMessage error))
      nil)))

(defn- utc-review-path []
  (let [formatter
        (java.time.format.DateTimeFormatter/ofPattern
         "yyyyMMdd'T'HHmmss.SSS'Z'")]
    (io/file
     reviews-path
     (str (.format formatter
                   (.atZone (java.time.Instant/now)
                            java.time.ZoneOffset/UTC))
          ".md"))))

(defn- write-full-review!
  "Write the complete Gemini response to a UTC-named Markdown file."
  [review]
  (try
    (when-not (.exists reviews-path)
      (.mkdirs reviews-path))
    (let [path (utc-review-path)]
      (spit path (str review "\n"))
      (.getPath path))
    (catch Exception error
      (log! "REVIEW_WRITE_ERROR" (.getMessage error))
      nil)))

(defn- clip-review-feedback
  "Conservatively cap review feedback below the configured token budget.

   One retained character per configured token is deliberately stricter than
   Seon's token estimator. The full response is preserved in `tmp/reviews/`."
  [config message]
  (let [limit (max 0 (get-in config [:feedback :max-tokens] 300))
        marker "\n[truncated]"]
    (if (<= (count message) limit)
      message
      (if (<= limit (count marker))
        (subs message 0 limit)
        (str (subs message 0 (- limit (count marker))) marker)))))

(defn- gemini-review-feedback
  "Accumulate reviewable edits and synchronously review one due batch."
  [event config]
  (try
    (let [review-config (:review config)
          review-paths
          (->> (event-file-paths event)
               (map absolute-file-path)
               (filter reviewable-file?)
               vec)]
      (when (and (= (:hook_event_name event) "PostToolUse")
                 (get review-config :enabled false)
                 (seq review-paths))
        (doseq [path review-paths]
          (accumulate-pending! path))
        (let [interval-seconds
              (get review-config :interval-seconds 120)]
          (if (review-rate-limited? interval-seconds)
            (do
              (log! "REVIEW_RATE_LIMITED"
                    (str "interval=" interval-seconds "s")
                    (str "pending=" (count (read-pending))))
              nil)
            (let [pending (read-pending)
                  files
                  (->> pending
                       (keep
                        (fn [{:seon.review.pending/keys [path] :as entry}]
                          (when-let [content
                                     (try
                                       (slurp path)
                                       (catch Exception _ nil))]
                            (when (seq content)
                              (assoc entry :path path :content content)))))
                       vec)]
              (when (seq files)
                (let [prompt
                      (build-review-prompt
                       files
                       {:skills (get review-config :skills [])
                        :max-code-length
                        (get review-config :max-code-length 40000)
                        :max-batch-length
                        (get review-config :max-batch-length 200000)
                        :max-rubric-length
                        (get review-config :max-rubric-length 60000)})
                      _ (log! "REVIEW_BATCH"
                              (str "count=" (count files))
                              (str "files="
                                   (str/join
                                    ","
                                    (map #(-> % :path io/file .getName)
                                         files))))
                      review (call-agy prompt 60000)]
                  (touch-last-review!)
                  (when (seq review)
                    (let [artifact (write-full-review! review)
                          names (str/join
                                 ", "
                                 (map #(-> % :path io/file .getName) files))]
                      (when artifact
                        (clear-reviewed-pending! files))
                      (clip-review-feedback
                       config
                       (str "Gemini review (" names ")"
                            (when artifact (str " — " artifact))
                            ":\n"
                            review)))))))))))
    (catch Exception error
      (log! "REVIEW_ERROR" (.getMessage error))
      nil)))

(def ^:private changed-test-build-inputs
  #{"deps.edn" "shadow-cljs.edn" "package.json" "bun.lock" "bb.edn"})

(defn- changed-test-path? [file-path]
  (when file-path
    (let [lower (str/lower-case file-path)
          name (.getName (io/file lower))]
      (or (str/ends-with? lower ".clj")
          (str/ends-with? lower ".cljs")
          (str/ends-with? lower ".cljc")
          (contains? changed-test-build-inputs name)))))

(defn- changed-test-feedback [event config]
  (let [paths (->> (event-file-paths event)
                   (filter changed-test-path?)
                   vec)
        invalid-source-paths
        (->> paths
             (filter clojure-source-file?)
             (keep (fn [path]
                     (let [absolute (absolute-file-path path)]
                       (when (and absolute (.isFile (io/file absolute)))
                         (try
                           (when-not (:valid
                                      (validate-clojure-syntax
                                       (slurp absolute)))
                             path)
                           (catch Exception _ path))))))
             vec)]
    (when (and (= (:hook_event_name event) "PostToolUse")
               (get-in config [:changed-tests :enabled] true)
               (seq paths))
      (if (seq invalid-source-paths)
        (str "ADVISORY — the edit was accepted, but changed tests were not "
             "queued because these resulting Clojure files do not parse:\n"
             (str/join "\n" (map #(str "- " %) invalid-source-paths)))
        (try
          (require 'seon.dev.changed-test)
          (let [configuration
                ((requiring-resolve 'seon.dev.changed-test/configuration)
                 repo-root)
                request
                ((requiring-resolve 'seon.dev.changed-test/enqueue-hook!)
                 configuration paths)
                message
                (str "ADVISORY — the edit was accepted; tests never gate refactoring.\n"
                     "Changed tests queued as generation "
                     (:seon.dev.changed-test/generation request)
                     " for " (count (:seon.dev.changed-test/paths request))
                     " coalesced path(s). The result will be published to "
                     (root-file "tmp/test-changed/latest.report.edn")
                     "; that path is mutable and may later describe another generation.")]
            message)
          (catch Exception error
            (str "ADVISORY — changed-test feedback could not run: "
                 (.getMessage error))))))))


;;; ---------------------------------------------------------------------------
;;; Core-fault strict gate (error-blame-strict-gate, RULED 2026-07-04).
;;; seon.error/record! prints one `SEON-CORE-FAULT …` line into logs/pod.log
;;; per :seon.error/fault :core error (CORE bugs only — :agent faults never
;;; mark, never gate). This bb-direct check brackets "the run" as the pod-log
;;; bytes appended since the LAST hook check (offset in tmp/.core-fault-offset)
;;; and BLOCKS the edit under the manifest dial :seon.config/on-core-error
;;; :gate/:crash (the default is :gate); :log disables it. First run arms the
;;; offset silently (no ancient backlog); a truncated/rotated log rescans from
;;; the top (every line is new).
;;; ---------------------------------------------------------------------------

(def core-fault-offset-path (root-file "tmp/.core-fault-offset"))
(def pod-log-path (root-file "logs/pod.log"))

(defn- core-fault-dial []
  (let [configured (or (System/getenv "SEON_CONFIG") "config/system.edn")
        configured-file (io/file configured)
        manifest (if (.isAbsolute configured-file)
                   configured-file
                   (io/file repo-root configured))]
    (or (when (.exists manifest)
          (second (re-find #":seon\.config/on-core-error\s+(:[a-z]+)"
                           (slurp manifest))))
        ":gate")))

(defn- core-fault-gate!
  "Block-response when NEW SEON-CORE-FAULT markers landed in logs/pod.log
   since the last check; nil otherwise (and on any internal error)."
  [event]
  (try
    (when (and (= (:hook_event_name event) "PostToolUse")
               (clojure-file? (get-file-path event))
               (not= ":log" (core-fault-dial))
               (.exists pod-log-path))
      (let [size   (.length pod-log-path)
            stored (try (Long/parseLong (str/trim (slurp core-fault-offset-path)))
                        (catch Exception _ nil))
            start  (cond
                     (nil? stored)   size ; first run: arm only
                     (> stored size) 0    ; log truncated/rotated: all new
                     :else           stored)
            _ (do (io/make-parents core-fault-offset-path)
                  (spit core-fault-offset-path (str size)))
            new-text (when (< start size)
                       (with-open [raf (java.io.RandomAccessFile. pod-log-path "r")]
                         (.seek raf start)
                         (let [buf (byte-array (int (min (- size start) (* 4 1024 1024))))]
                           (.readFully raf buf)
                           (String. buf "UTF-8"))))
            markers (when new-text
                      (->> (str/split-lines new-text)
                           (filter #(str/includes? % "SEON-CORE-FAULT"))
                           (take 10)
                           (map #(subs % 0 (min (count %) 300)))))]
        (when (seq markers)
          (log! "CORE_FAULT_GATE" (str (count markers) " new marker(s)"))
          {:decision "block"
           :reason (str "CORE-FAULT GATE (:seon.config/on-core-error "
                        (core-fault-dial) "): the live pod recorded NEW "
                        ":seon.error/fault :core error(s) since the last hook "
                        "check — CORE bugs (our machinery), never agent errors. "
                        "Inspect + fix before continuing. Query the datoms: "
                        "'[:find ?e :where [?e :seon.error/fault :core]] ; "
                        "freeze the db one saw: (seon.db/as-of <:seon.error/at>). "
                        "Markers:\n"
                        (str/join "\n" markers))})))
    (catch Exception e
      (log! "CORE_FAULT_GATE_ERROR" (.getMessage e))
      nil)))

(defn- feedback-response [feedback]
  (let [messages (vec (remove str/blank? feedback))]
    (if (seq messages)
      {:continue true
       :hookSpecificOutput
       {:hookEventName "PostToolUse"
        :additionalContext (str/join "\n\n" messages)}}
      {:continue true})))

;;; ---------------------------------------------------------------------------
;;; Main Entry Point
;;; ---------------------------------------------------------------------------

(defn -main []
  (let [event (try
                (json/parse-string (slurp *in*) true)
                (catch Exception _ nil))
        file-paths (event-file-paths event)
        event-name (:hook_event_name event)
        tool-name (:tool_name event)
        edit-event? (and (#{"PreToolUse" "PostToolUse"} event-name)
                         (#{"apply_patch" "Edit" "Write"} tool-name))
        local-paths (filterv repository-file? file-paths)
        mixed-scope? (and (seq local-paths)
                          (not= (count local-paths) (count file-paths)))
        local-edit? (and edit-event?
                         (seq file-paths)
                         (= (count local-paths) (count file-paths)))]
    (if mixed-scope?
      (output! {:decision "block"
                :reason "BLOCKED: one edit cannot mix Seon files with paths outside this checkout."})
      (if-not local-edit?
      (output! {:continue true})
      (try
        (let [config (load-config)]
          (log! event-name
                (str "tool=" tool-name)
                (str "session=" (or (:session_id event) "orchestrator"))
                (str "files=" (str/join "," file-paths)))
          (if (= event-name "PreToolUse")
            (if (get-in config [:lint :enabled] true)
              (let [blocked (some validate-clojure-edit
                                  (map #(assoc event :seon.hook/file-path %)
                                       file-paths))]
                (if blocked
                  (do
                    (log! "CLOJURE_BLOCK" (:reason blocked))
                    (output! blocked))
                  (output! {:continue true})))
              (output! {:continue true}))
            (let [path-events (map #(assoc event :seon.hook/file-path %)
                                   file-paths)
                  feedback (mapcat
                             (fn [path-event]
                               [(clojure-syntax-feedback path-event)
                                (markdown-feedback path-event config)
                                (docstring-feedback path-event config)])
                             path-events)
                  feedback (conj (vec feedback)
                                 (changed-test-feedback event config)
                                 (gemini-review-feedback event config))
                  clojure-event (some #(when (clojure-file? (get-file-path %)) %)
                                      path-events)
                  gate (when clojure-event (core-fault-gate! clojure-event))]
              (output! (or gate (feedback-response feedback))))))
        (catch Exception e
          (log! "ERROR" (.getMessage e))
          (binding [*out* *err*]
            (println "HOOK ERROR:" (.getMessage e)))
          (output! {:continue true})))))))

(-main)
