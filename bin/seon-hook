#!/usr/bin/env bb

;; Thin Babashka hook for Claude Code
;;
;; This script:
;; 1. Receives hook events from Claude Code (JSON on stdin)
;; 2. Loads configuration from .claude/seon-hook.edn
;; 3. Communicates with running Seon server via nREPL (bencode)
;; 4. Calls seon.dev.hook/process-hook-event! with the event
;; 5. Returns the response as JSON to stdout
;;
;; All logic lives in seon.dev.hook - this is just the communication layer.

(require '[bencode.core :as b]
         '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io])

(def orchestrator-port 7888)
(def config-path ".claude/seon-hook.edn")

;;; ---------------------------------------------------------------------------
;;; Configuration
;;; ---------------------------------------------------------------------------

(defn load-config
  "Load configuration from .claude/seon-hook.edn, or empty map if not found."
  []
  (let [f (io/file config-path)]
    (if (.exists f)
      (try
        (edn/read-string (slurp f))
        (catch Exception _
          {}))
      {})))

;;; ---------------------------------------------------------------------------
;;; nREPL Communication (bencode)
;;; ---------------------------------------------------------------------------

(defn bytes->str
  "Convert bencode byte array to string."
  [x]
  (if (bytes? x)
    (String. ^bytes x "UTF-8")
    x))

(defn decode-msg
  "Decode bencode message, converting byte arrays to strings."
  [msg]
  (into {}
        (map (fn [[k v]]
               [(bytes->str k)
                (if (coll? v)
                  (mapv bytes->str v)
                  (bytes->str v))]))
        msg))

(defn nrepl-eval
  "Evaluate code via nREPL using bencode. Returns result value or nil on error."
  [port code]
  (try
    (with-open [sock (java.net.Socket. "localhost" port)]
      (let [out (java.io.BufferedOutputStream. (.getOutputStream sock))
            in (java.io.PushbackInputStream. (.getInputStream sock))
            id (str (random-uuid))]
        ;; Send eval request
        (b/write-bencode out {"op" "eval" "code" code "id" id})
        (.flush out)
        ;; Read responses until done
        (loop [result nil]
          (let [msg (decode-msg (b/read-bencode in))
                status (get msg "status")
                err (get msg "err")]
            ;; Debug: print errors to stderr
            (when err
              (binding [*out* *err*]
                (println "NREPL ERROR:" err)))
            (if (and status (some #{"done"} status))
              result
              (recur (or (get msg "value") result)))))))
    (catch java.net.ConnectException e
      ;; nREPL not running - return nil (will result in continue response)
      (binding [*out* *err*]
        (println "NREPL CONNECT ERROR:" (.getMessage e)))
      nil)
    (catch Exception e
      (binding [*out* *err*]
        (println "NREPL EXCEPTION:" (.getMessage e)))
      nil)))

;;; ---------------------------------------------------------------------------
;;; Session Port Resolution
;;; ---------------------------------------------------------------------------

(defn- lookup-seon-session
  "Look up Seon session_id from Claude's UUID via mapping file.
   Returns the original session-id if not a UUID or not found in mapping."
  [session-id]
  (if (and session-id
           (> (count session-id) 8))  ; UUIDs are 36 chars, our IDs are 4
    ;; Looks like a UUID - check mapping file
    (let [map-file (io/file "logs" "session-map.edn")]
      (if (.exists map-file)
        (try
          (let [mapping (edn/read-string (slurp map-file))]
            (get mapping session-id session-id))
          (catch Exception _
            session-id))
        session-id))
    session-id))

(defn get-port-for-session
  "Query orchestrator for the nREPL port of a session.
   Returns orchestrator-port (7888) if session_id is nil, 'orchestrator', or not found.
   For agent sessions (4-char hex IDs), queries the session registry.
   Also handles Claude's UUID session_ids by looking up the mapping."
  [session-id]
  ;; First, resolve UUID to Seon session_id if needed
  (let [seon-session-id (lookup-seon-session session-id)]
    (if (or (nil? seon-session-id)
            (= seon-session-id "orchestrator")
            (= seon-session-id ""))
      orchestrator-port
      ;; Query orchestrator for session's port
      (let [code (format
                  "(do (require 'seon.orchestrator.session)
                       (:seon.orchestrator.session/nrepl-port
                         (seon.orchestrator.session/get-session-port
                           {:seon.orchestrator.session/node (user/xtdb-node)
                            :seon.orchestrator.session/id %s})))"
                  (pr-str seon-session-id))
            result (nrepl-eval orchestrator-port code)]
        (or (when result
              (try
                (edn/read-string result)
                (catch Exception _
                  nil)))
            orchestrator-port)))))

;;; ---------------------------------------------------------------------------
;;; Response Formatting
;;; ---------------------------------------------------------------------------

(defn format-response
  "Format the hook result for Claude Code JSON output.

   Takes the result map from process-hook-event! and converts to Claude Code format:
   - ::decision \"block\" -> {:decision \"block\" :reason \"...\"}
   - ::continue true with feedback -> additionalContext (visible to Claude)
   - ::continue true -> {:continue true}"
  [result]
  (when result
    (let [continue? (get result :seon.dev.hook/continue)
          decision (get result :seon.dev.hook/decision)
          reason (get result :seon.dev.hook/reason)
          feedback (get result :seon.dev.hook/feedback)]
      (cond
        ;; Blocking response
        (= decision "block")
        {:decision "block"
         :reason (or reason "Blocked by hook")}

        ;; Success with feedback - additionalContext for Claude
        (seq feedback)
        {:continue true
         :hookSpecificOutput
         {:hookEventName "PostToolUse"
          :additionalContext (clojure.string/join "\n" feedback)}}

        ;; Plain success
        continue?
        {:continue true}

        ;; Default to continue (graceful degradation)
        :else
        {:continue true}))))

;;; ---------------------------------------------------------------------------
;;; Self-Edit Protection (Phase 7)
;;; ---------------------------------------------------------------------------

(def protected-files
  "Files that are critical to the hook system. Syntax errors in these files
   can brick the hook system, creating a chicken-and-egg problem."
  #{"src/seon/dev/hook.clj"
    "bin/seon-hook"})

(defn- critical-file?
  "Check if a file path is a critical hook infrastructure file."
  [file-path]
  (when file-path
    (some #(clojure.string/ends-with? file-path %) protected-files)))

(defn- validate-clojure-syntax
  "Validate Clojure syntax by attempting to read all forms.
   Returns {:valid true} or {:valid false :error \"message\"}."
  [code-string]
  (try
    ;; Read all forms from the string to validate syntax
    (let [reader (java.io.PushbackReader. (java.io.StringReader. code-string))]
      (loop []
        (let [form (try
                     (clojure.core/read {:eof ::eof} reader)
                     (catch Exception e
                       (throw (ex-info "Syntax error" {:error (.getMessage e)}))))]
          (when (not= form ::eof)
            (recur)))))
    {:valid true}
    (catch clojure.lang.ExceptionInfo e
      {:valid false :error (-> e ex-data :error)})
    (catch Exception e
      {:valid false :error (.getMessage e)})))

(defn- reconstruct-file-content
  "Reconstruct the file content after an Edit operation.
   For Write, this is just the new content.
   For Edit, we need to apply the replacement to the current file."
  [event]
  (let [tool-name (:tool_name event)
        tool-input (:tool_input event)
        file-path (or (:file_path tool-input) (:filePath tool-input))]
    (cond
      ;; Write: new_content is the full file
      (= tool-name "Write")
      (:content tool-input)

      ;; Edit: apply old_string -> new_string replacement
      (= tool-name "Edit")
      (let [old-string (:old_string tool-input)
            new-string (:new_string tool-input)]
        (when (and file-path old-string)
          (try
            (let [current-content (slurp file-path)
                  new-content (if (:replace_all tool-input)
                                (clojure.string/replace current-content old-string new-string)
                                (clojure.string/replace-first current-content old-string new-string))]
              new-content)
            (catch Exception _
              nil))))

      :else nil)))

(defn- validate-critical-edit
  "For PreToolUse on critical files, validate syntax before allowing the edit.
   Returns nil if valid (continue), or a block response if invalid."
  [event]
  (let [hook-event (:hook_event_name event)
        tool-input (:tool_input event)
        file-path (or (:file_path tool-input) (:filePath tool-input))]
    ;; Only validate PreToolUse on critical Clojure files
    (when (and (= hook-event "PreToolUse")
               (critical-file? file-path)
               (clojure.string/ends-with? file-path ".clj"))
      (let [new-content (reconstruct-file-content event)]
        (when new-content
          (let [validation (validate-clojure-syntax new-content)]
            (when-not (:valid validation)
              ;; Block the edit with clear error message
              {:decision "block"
               :reason (str "Syntax error in critical hook file. "
                           "This edit would break the hook system. "
                           "Error: " (:error validation))})))))))

;;; ---------------------------------------------------------------------------
;;; Main
;;; ---------------------------------------------------------------------------

(defn -main []
  ;; HOOK INVOCATION LOGGING - detect if hooks are being called at all
  ;; Write to logs/ directory (gitignored, project-local)
  (let [log-dir (io/file "logs")
        _ (when-not (.exists log-dir) (.mkdirs log-dir))
        log-file (io/file log-dir "hook-debug.log")]
    (spit log-file (str (java.util.Date.) " | HOOK INVOKED | cwd=" (System/getProperty "user.dir") "\n") :append true))
  (try
    (let [;; Read input from stdin
          input-json (slurp *in*)
          event (try
                  (json/parse-string input-json true)
                  (catch Exception _
                    nil))

          ;; Log event details to file (more reliable than stderr for spawned processes)
          _ (let [log-file (io/file "logs" "hook-debug.log")
                  file-path (or (get-in event [:tool_input :file_path])
                                (get-in event [:tool_input :filePath])
                                "unknown")]
              (spit log-file
                    (str (java.util.Date.)
                         " | " (:hook_event_name event)
                         " | tool=" (:tool_name event)
                         " | session=" (or (:session_id event) "orchestrator")
                         " | file=" file-path
                         "\n")
                    :append true))

          ;; Phase 7: Check for syntax errors in critical hook infrastructure files
          ;; This runs BEFORE nREPL call to catch errors that would brick the hook system
          critical-block (validate-critical-edit event)
          _ (when critical-block
              (spit (io/file "logs" "hook-debug.log")
                    (str (java.util.Date.)
                         " | CRITICAL_BLOCK | " (:reason critical-block)
                         "\n")
                    :append true))]

      ;; Short-circuit if critical file validation failed
      (if critical-block
        (println (json/generate-string critical-block))

        (let [;; Load config
          config (load-config)

          ;; Resolve target nREPL port based on session_id
          ;; Claude Code passes its UUID, which we map to our 4-char Seon session_id
          claude-session-id (:session_id event)
          seon-session-id (lookup-seon-session claude-session-id)
          target-port (get-port-for-session claude-session-id)

          ;; Log port resolution (show both Claude UUID and resolved Seon session)
          _ (spit (io/file "logs" "hook-debug.log")
                  (str (java.util.Date.)
                       " | PORT_RESOLVED"
                       " | claude=" (or claude-session-id "nil")
                       " | seon=" (or seon-session-id "nil")
                       " | port=" target-port
                       "\n")
                  :append true)

          ;; Build the expression to evaluate
          ;; Note: We need to pass the XTDB node from the running system
          ;; Require the namespace first to ensure it's loaded
          code (format
                "(do (require 'seon.dev.hook)
                     (seon.dev.hook/process-hook-event!
                       {:seon.dev.hook/xtdb-node (user/xtdb-node)
                        :seon.dev.hook/event %s
                        :seon.dev.hook/config %s}))"
                (pr-str event)
                (pr-str config))

          ;; Evaluate via nREPL on the resolved target port
          result-str (nrepl-eval target-port code)

          ;; Parse the result (it's an EDN string)
          result (when result-str
                   (try
                     (edn/read-string result-str)
                     (catch Exception _
                       nil)))

          ;; Format for Claude Code
          response (format-response result)

          ;; Log completion to debug log
          _ (spit (io/file "logs" "hook-debug.log")
                  (str (java.util.Date.)
                       " | COMPLETE | session=" (or claude-session-id "orchestrator")
                       " | decision=" (or (:decision response) "continue")
                       " | has-feedback=" (boolean (get-in response [:hookSpecificOutput :additionalContext]))
                       "\n")
                  :append true)

          ;; Write to agent log file (if this is an agent session)
          ;; Format: timestamp | HOOK | tool | file | full feedback (no truncation)
          ;; The UI handles display with expand/collapse, so we log everything
          _ (when (and seon-session-id (re-matches #"[a-f0-9]{4}" seon-session-id))
              (let [agent-log-file (io/file "logs" "agents" (str seon-session-id ".log"))
                    timestamp (.format (java.time.format.DateTimeFormatter/ofPattern "yyyy-MM-dd'T'HH:mm:ss'Z'")
                                       (.atOffset (java.time.Instant/now) java.time.ZoneOffset/UTC))
                    tool-name (:tool_name event)
                    file-name (when-let [fp (or (get-in event [:tool_input :file_path])
                                                (get-in event [:tool_input :filePath]))]
                                (last (clojure.string/split fp #"/")))
                    decision (or (:decision response) "continue")
                    feedback (get-in response [:hookSpecificOutput :additionalContext])
                    ;; Build details: decision + full feedback (UI handles truncation/expand)
                    details (if feedback
                              (str decision " | " feedback)
                              decision)
                    log-line (str timestamp " | HOOK     | " (or tool-name "unknown")
                                  " | " (or file-name "unknown") " | " details "\n")]
                (when (.exists (.getParentFile agent-log-file))
                  (spit agent-log-file log-line :append true))))]

      ;; Output JSON response
      (when (seq response)
        (println (json/generate-string response))))))

    (catch Exception e
      ;; Log exceptions to file and stderr
      (spit (io/file "logs" "hook-debug.log")
            (str (java.util.Date.) " | ERROR | " (.getMessage e) "\n")
            :append true)
      (binding [*out* *err*]
        (println "HOOK ERROR:" (.getMessage e)))
      nil)))

(-main)
