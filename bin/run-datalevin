#!/usr/bin/env bash
# Start Datalevin as a standalone server process.
# Survives Seon JVM restarts. Managed by Integrant (seon.db.datalevin/server).
#
# Usage: ./bin/run-datalevin
#        DATALEVIN_PORT=8899 ./bin/run-datalevin
#
# DEAD/LEGACY: Datalevin was removed from the project — there is no datalevin
# dep on the classpath and no src references, so this script will fail to find
# `datalevin.main`. Kept (and JDK-aligned for consistency) as archaeology; safe
# to delete.

set -euo pipefail

# Pin the JDK via the shared resolver (single source of truth).
source "$(dirname "$0")/_java-home-resolver"

PORT=${DATALEVIN_PORT:-8898}
ROOT=${DATALEVIN_ROOT:-data/datalevin}

# Ensure root directory exists
mkdir -p "$ROOT"

echo "Starting Datalevin server on port $PORT (root: $ROOT)"
exec clj -M:dev -m datalevin.main -p "$PORT" -r "$ROOT" serv
