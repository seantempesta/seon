#!/usr/bin/env bash
# bin/lane — file claims and proven commits for parallel lanes on one shared tree.
#
#   bin/lane claim   LANE PATH...        claim files (or dir/ prefixes) before editing them
#   bin/lane add     LANE PATH...        claim more
#   bin/lane commit  LANE -m MSG [--test NS]... [--include-long] PATH...
#                                        lint and check the candidate, then commit exactly PATH...
#   bin/lane release LANE                drop the lane's claims
#   bin/lane status                      every live claim
#   LANE_ADOPT=1 bin/lane claim ...      root only: record a claim for a lane already editing those files
#
# The candidate is HEAD plus exactly the committed paths (a tree written through a
# temporary index; HEAD, the shared index and the working tree are untouched).
# clj-kondo lints a `git archive` of that tree, never the working tree, so another
# lane's half-finished edit refuses nobody else; a commit touching none of
# those roots skips it (the candidate lints as HEAD). `bin/seon check` (publication,
# adoption, --test) runs alongside it, except for a documentation-only commit
# (docs/, AGENTS.md, CLAUDE.md or skill Markdown, no --test): documentation is no program input.
# The commit itself (staged-index check, new-file add, git commit, verification)
# holds .git/lane-commit.lock: git commit shares .git/COMMIT_EDITMSG, the index and
# HEAD between processes, and two concurrent commits once crossed (649829332
# carried lane commit-validation's paths under lane heap-retained's message).
#
# Refusals (exit 2) name the rule they enforce:
#   - a path claimed by another lane, or already dirty in the tree (someone else's work in progress);
#   - a commit path the lane never claimed;
#   - anything staged in the index beyond the commit's paths;
#   - `bin/seon check PATHS [--test NS...]` or clj-kondo reporting an error on the candidate.
# A landed commit whose paths or message differ from the request exits 3 (LANE COMMIT MISMATCH);
# history is never rewritten, root fixes forward.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
claims="$root/tmp/orchestrator/lanes"
mkdir -p "$claims"
cd "$root"

refuse() { echo "LANE REFUSED: $*" >&2; exit 2; }

valid_lane() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || refuse "lane name '$1' must be lowercase letters, digits and dashes"; }

# A path is checkout-relative and literal: claims, the docs/ and lint-root
# classification and git's pathspec must name the same files, so a `..` or `.`
# component (docs/../src/x.clj passed as documentation), an absolute path, or
# pathspec magic and glob characters (src/* sweeping other lanes' files) refuse.
valid_path() {
  local path="$1"
  case "$path" in
    ''|/*|:*|..|../*|*/..|*/../*|.|*/.|*/./*|*'*'*|*'?'*|*'['*|*\\*|*//*)
      refuse "path '$path' must be a literal checkout-relative path: no ., .. or empty components, no leading / or :, no * ? [ or \\" ;;
  esac
}

# A claim entry covers a path when equal, or when the entry ends with / and prefixes it.
covers() {
  local entry="$1" path="$2"
  [[ "$entry" == "$path" ]] && return 0
  [[ "$entry" == */ && "$path" == "$entry"* ]] && return 0
  [[ "$path" == */ && "$entry" == "$path"* ]] && return 0
  return 1
}

owner_of() {
  local path="$1" file lane entry
  for file in "$claims"/*.paths; do
    [[ -e "$file" ]] || continue
    lane="$(basename "$file" .paths)"
    while IFS= read -r entry; do
      [[ -z "$entry" ]] && continue
      if covers "$entry" "$path"; then echo "$lane"; return 0; fi
    done < "$file"
  done
  return 1
}

dirty() { [[ -n "$(git status --porcelain -- "$1")" ]]; }

claim() {
  local lane="$1"; shift
  valid_lane "$lane"
  [[ $# -gt 0 ]] || refuse "claim needs at least one path"
  local path owner
  for path in "$@"; do
    path="${path#./}"
    valid_path "$path"
    if owner="$(owner_of "$path")" && [[ "$owner" != "$lane" ]]; then
      refuse "$path is claimed by lane $owner (one file, one owner)"
    fi
    if [[ "${LANE_ADOPT:-}" != 1 ]] && dirty "$path" && ! owner_of "$path" >/dev/null; then
      refuse "$path already has uncommitted changes nobody claimed; root decides whose they are before anyone edits it"
    fi
  done
  [[ -e "$claims/$lane.base" ]] || git rev-parse HEAD > "$claims/$lane.base"
  for path in "$@"; do
    path="${path#./}"
    grep -qxF -- "$path" "$claims/$lane.paths" 2>/dev/null || echo "$path" >> "$claims/$lane.paths"
  done
  echo "lane $lane claims: $(tr '\n' ' ' < "$claims/$lane.paths")"
}


# The tree of HEAD with the named working-tree paths (deletions included), written
# through a temporary index: what `git commit --only PATHS` will commit.
candidate_tree() {
  local scratch="$1"; shift
  local index="$scratch/index"
  GIT_INDEX_FILE="$index" git read-tree HEAD
  GIT_INDEX_FILE="$index" git add -A -- "$@"
  GIT_INDEX_FILE="$index" git write-tree
}

# clj-kondo over `git archive TREE` in DIRECTORY. The analyzer's ignored
# configuration (library imports, generated configs) is linked from the checkout;
# --cache false reads and writes no cache, as the working-tree lint did.
lint_candidate() {
  local tree="$1" directory="$2" entry
  mkdir -p "$directory"
  git archive --format=tar "$tree" src script test .clj-kondo | tar -x -C "$directory"
  while IFS= read -r entry; do
    entry="${entry%/}"
    [[ "$entry" == .clj-kondo/.cache || -e "$directory/$entry" ]] && continue
    mkdir -p "$directory/$(dirname "$entry")"
    ln -s "$root/$entry" "$directory/$entry"
  done < <(git ls-files --others --ignored --exclude-standard --directory -- .clj-kondo)
  (cd "$directory" && clj-kondo --lint src script test --cache false --parallel)
}

# True when no path is a lint input: the candidate's src, script, test and
# .clj-kondo are HEAD's, which every earlier commit linted.
lints_unchanged() {
  local path
  for path in "$@"; do
    case "$path" in src/*|script/*|test/*|.clj-kondo/*|src|script|test|.clj-kondo) return 1 ;; esac
  done
}

# Documentation outside the program input roots has nothing to publish.
# Skill scripts and fixtures are deliberately not covered by the Markdown rule.
documentation_only() {
  local path
  for path in "$@"; do
    case "$path" in
      docs/*|AGENTS.md|CLAUDE.md|.agents/skills/*.md) ;;
      *) return 1 ;;
    esac
  done
}

# The message belongs to this commit: lanes have built -m from one shared
# scratch file (`-m "$(cat scratchpad/msg.txt)"`), and bd5e0e8c9 landed lane
# heap-retained's paths under the message lane error-frames had written there
# (649829332 the same way). Refused: a first line naming another live lane
# ("error frames: ..." from lane heap-retained), or one equal to the subject of
# a commit among the last 200 (a message already used). Keep messages in a
# lane-named file, never a shared one.
message_owned() {
  local lane="$1" first file other prefix subject
  first="$(printf '%s\n' "$2" | head -1)"
  first="$(printf '%s' "$first" | tr '[:upper:]' '[:lower:]')"
  echo "== lane $lane commits: $(printf '%s\n' "$2" | head -1)"
  for file in "$claims"/*.paths; do
    [[ -e "$file" ]] || continue
    other="$(basename "$file" .paths)"
    [[ "$other" == "$lane" ]] && continue
    for prefix in "$other" "${other//-/ }"; do
      case "$first" in
        "$prefix"|"$prefix:"*|"$prefix "*) refuse "the message begins with lane $other's name ('$(printf '%s\n' "$2" | head -1)'); is it that lane's message, read from a shared file? Write this lane's own message" ;;
      esac
    done
  done
  subject="$(printf '%s\n' "$2" | head -1)"
  if git log -200 --format=%s | grep -qxF -- "$subject"; then
    refuse "a commit among the last 200 already has the subject '$subject'; is this message another commit's, read from a shared or stale file?"
  fi
}

# PATH is one of the requested paths or lies under a requested directory.
requested() {
  local path="$1" entry; shift
  for entry in "$@"; do
    [[ "$path" == "$entry" || "$path" == "${entry%/}/"* ]] && return 0
  done
  return 1
}

staged_only() {
  local staged path ok
  while IFS= read -r staged; do
    [[ -z "$staged" ]] && continue
    ok=0
    for path in "$@"; do [[ "$staged" == "$path" ]] && ok=1; done
    [[ $ok == 1 ]] || refuse "$staged is staged in the shared index but not part of this commit; a commit must carry only its own paths"
  done < <(git diff --cached --name-only)
}

commit() {
  local lane="$1"; shift
  valid_lane "$lane"
  [[ -e "$claims/$lane.paths" ]] || refuse "lane $lane has no claims; run bin/lane claim first"
  local message="" tests=() paths=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m) message="$2"; shift 2 ;;
      --test) tests+=("--test" "$2"); shift 2 ;;
      --include-long) tests+=("--include-long"); shift ;;
      *) paths+=("${1#./}"); shift ;;
    esac
  done
  [[ -n "$message" ]] || refuse "commit needs -m MESSAGE"
  message_owned "$lane" "$message"
  [[ ${#paths[@]} -gt 0 ]] || refuse "commit needs the exact paths to commit"
  local path owner
  for path in "${paths[@]}"; do
    valid_path "$path"
    owner="$(owner_of "$path" || true)"
    [[ "$owner" == "$lane" ]] || refuse "$path is not claimed by lane $lane${owner:+ (lane $owner holds it)}"
  done
  # The staged-index check runs only under the lock (commit_locked): outside it,
  # another lane's in-lock `git add` of its new file reads as foreign staging.

  scratch="$(mktemp -d "${TMPDIR:-/tmp}/lane-commit.XXXXXX")"
  lint_pid=""
  # A fatal signal runs no EXIT trap unless trapped: exit through it, so the
  # scratch directory and the background lint (the subshell and its clj-kondo)
  # never outlive an interrupted commit.
  # The lint runs in its own process group (set -m below): killing the group
  # stops git archive, tar and clj-kondo alike. `|| true`: under errexit a
  # failing wait would end the trap before the rm.
  trap 'if [[ -n "$lint_pid" ]]; then kill -- "-$lint_pid" 2>/dev/null || true; wait "$lint_pid" 2>/dev/null || true; fi; rm -rf -- "$scratch"' EXIT
  trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
  local tree began
  began=$SECONDS
  tree="$(candidate_tree "$scratch" "${paths[@]}")" || refuse "the candidate tree could not be written"
  if lints_unchanged "${paths[@]}"; then
    echo "== no path under src script test .clj-kondo: the candidate lints as HEAD; clj-kondo not run"
    echo "linting took 0ms, errors: 0, (unchanged)" > "$scratch/lint.out"
  else
    echo "== clj-kondo --lint src script test --cache false --parallel (candidate tree ${tree:0:12})"
    set -m
    lint_candidate "$tree" "$scratch/candidate" > "$scratch/lint.out" 2>&1 &
    lint_pid=$!
    set +m
  fi

  if documentation_only "${paths[@]}" && [[ ${#tests[@]} -eq 0 ]]; then
    echo "== documentation only: no program input; bin/seon check not run"
  else
    echo "== bin/seon check ${paths[*]} ${tests[*]+"${tests[*]}"}"
    bin/seon check "${paths[@]}" ${tests[@]+"${tests[@]}"} || refuse "bin/seon check failed; nothing committed"
  fi
  [[ -n "$lint_pid" ]] && { wait "$lint_pid" || true; }
  lint_pid=""
  local summary
  summary="$(grep -E '^linting took' "$scratch/lint.out" | tail -1 || true)"
  echo "${summary:-$(tail -1 "$scratch/lint.out")}"
  if [[ ! "$summary" =~ errors:\ 0, ]]; then
    grep -E ': error: ' "$scratch/lint.out" | head -40 >&2 || true
    refuse "clj-kondo reports errors on the candidate (HEAD + ${paths[*]}); nothing committed"
  fi
  echo "== proved in $((SECONDS - began)) s; committing under .git/lane-commit.lock"

  printf '%s\n' "$message" > "$scratch/message"
  local git_dir
  git_dir="$(git rev-parse --absolute-git-dir)"
  # The lock descriptor is inherited (close-on-exec cleared), so the commit
  # holds the lock until it exits even if this perl dies first.
  perl -MFcntl=:flock,F_SETFD -e 'open(my $lock, ">>", shift) or die "lane-commit.lock: $!\n";
                          flock($lock, LOCK_EX) or die "lane-commit.lock: $!\n";
                          fcntl($lock, F_SETFD, 0) or die "lane-commit.lock: $!\n";
                          my $status = system(@ARGV); exit($status == -1 ? 2 : ($status >> 8) || ($status & 127 ? 2 : 0));' \
    "$git_dir/lane-commit.lock" "$root/bin/lane" _commit-locked "$lane" "$scratch/message" "$tree" "${paths[@]}"
}

# Under .git/lane-commit.lock (held by `commit`): the staged-index check, the
# new-file add, the commit and its verification, so no two lanes' commits interleave.
commit_locked() {
  local lane="$1" message_file="$2" proven="$3"; shift 3
  local paths=("$@") path added=() before after now
  staged_only "${paths[@]}"
  # The commit carries the bytes that were linted and checked: the paths'
  # candidate now (working tree over the current HEAD) must equal the proven
  # tree's. A path edited during the check refuses; another lane's commit of
  # other paths meanwhile does not (lanes own disjoint files).
  mkdir -p "$(dirname "$message_file")/locked"
  now="$(candidate_tree "$(dirname "$message_file")/locked" "${paths[@]}")" || refuse "the candidate tree could not be rewritten under the lock"
  git diff --quiet "$proven" "$now" -- "${paths[@]}" ||
    refuse "$(git diff --name-only "$proven" "$now" -- "${paths[@]}" | tr '\n' ' ')changed after the check; nothing committed, run bin/lane commit again"
  before="$(git rev-parse HEAD)"
  # Untracked files under the named paths are in the candidate (`git add -A`)
  # but `git commit --only` takes tracked files only, so they are added (alone)
  # first: a new file, or a new file inside a claimed directory that already
  # holds tracked ones. Nothing else enters the index.
  while IFS= read -r path; do
    git add -- "$path"
    added+=("$path")
  done < <(git ls-files --others --exclude-standard -- "${paths[@]}")
  if ! git commit --only --cleanup=whitespace -F "$message_file" -- "${paths[@]}"; then
    [[ ${#added[@]} -gt 0 ]] && git reset -q -- "${added[@]}"
    refuse "git commit failed; nothing committed"
  fi
  after="$(git rev-parse HEAD)"

  # The landed commit must be exactly the request: its parent, its paths, its message.
  local problems=() committed
  [[ "$(git rev-parse "$after^")" == "$before" ]] || problems+=("parent is $(git rev-parse --short "$after^"), not ${before:0:9}")
  while IFS= read -r committed; do
    requested "$committed" "${paths[@]}" || problems+=("carries $committed, which lane $lane did not request")
  done < <(git diff-tree --no-commit-id --name-only -r --no-renames "$before" "$after")
  for path in "${paths[@]}"; do
    git diff --quiet "$after" -- "$path" || problems+=("$path in the working tree differs from the commit")
  done
  if [[ "$(git stripspace < "$message_file")" != "$(git log -1 --format=%B "$after" | git stripspace)" ]]; then
    problems+=("message is \"$(git log -1 --format=%s "$after")\", requested \"$(head -1 "$message_file")\"")
  fi
  if [[ ${#problems[@]} -gt 0 ]]; then
    {
      echo "LANE COMMIT MISMATCH: lane $lane's commit $(git rev-parse --short "$after") is not what it requested:"
      printf '  - %s\n' "${problems[@]}"
      echo "  requested paths: ${paths[*]}"
      echo "  History is not rewritten; root fixes forward."
    } >&2
    exit 3
  fi
  git log --oneline -1
}

release() {
  local lane="$1"
  valid_lane "$lane"
  rm -f "$claims/$lane.paths" "$claims/$lane.base"
  echo "lane $lane released"
}

status() {
  local file lane
  shopt -s nullglob
  local any=0
  for file in "$claims"/*.paths; do
    any=1
    lane="$(basename "$file" .paths)"
    echo "$lane (since $(cut -c1-9 "$claims/$lane.base" 2>/dev/null || echo '?')): $(tr '\n' ' ' < "$file")"
  done
  [[ $any == 1 ]] || echo "no live claims"
}

command="${1:-status}"; shift || true
case "$command" in
  claim|add) claim "$@" ;;
  commit) commit "$@" ;;
  _commit-locked) commit_locked "$@" ;;
  release) release "$@" ;;
  status) status ;;
  *) sed -n '2,29p' "$0"; exit 1 ;;
esac
