#!/usr/bin/env bash
# bin/lane — file claims and proven commits for parallel lanes on one shared tree.
#
#   bin/lane claim   LANE PATH...        claim files (or dir/ prefixes) before editing them
#   bin/lane add     LANE PATH...        claim more
#   bin/lane commit  LANE -m MSG [--test NS]... [--include-long] PATH...
#                                        lint and check the candidate, then commit exactly PATH...
#   bin/lane commit  LANE -m MSG --at-candidate --test NS... PATH...
#                                        check the exact candidate archive in its own JVM (dependency changes).
#   bin/lane commit  LANE -m MSG --branch-evidence AGENT [--accept-red-before TEST]... PATH...
#                                        lint, and prove PATH... by AGENT's branch evidence on the
#                                        live root instead of a throwaway JVM (falls back to the check)
#   bin/lane commit  LANE -m MSG --test NS... --accept-red-before NS/VAR... PATH...
#                                        a red bin/seon check still commits when every red var is accepted AND red on HEAD
#                                        too (`bin/seon check --at HEAD` on those vars; trailer Check-red-before-accepted:),
#                                        or absent on HEAD (a new proof, red by design; trailer Check-new-red-proof:)
#   bin/lane commit  LANE -m MSG --restart-batch ... PATH...
#                                        root only, when it has opened a restart batch: without it a commit of deps.edn
#                                        or a reference-code/ gitlink (dependency or fork bump) is refused
#   bin/lane evidence AGENT PATH... [-- TEST...]
#                                        ask the branch-evidence question alone (exit 0 proven, 2 not, 3 unavailable);
#                                        tests after -- are accepted as red before the change
#   bin/lane release LANE [--agent AGENT] [PATH...]
#                                        drop the named claims, or all of the lane's when none is named;
#                                        with --agent, also write AGENT's end (close its admission) through the
#                                        live root, so root's next db<->flow pass deletes its branch when nothing
#                                        is unmerged (exit 3 when no live root answers; the claims are released)
#   bin/lane status [LANE]               one line per lane with its path count; a lane's paths one per line
#   bin/lane commit takes each test as its own `--test NS` (never `--test A B C`)
#   LANE_ADOPT=1 bin/lane claim ...      root only: record a claim for a lane already editing those files
#
# The candidate is HEAD plus exactly the committed paths (a tree written through a
# temporary index; HEAD, the shared index and the working tree are untouched).
# clj-kondo lints a `git archive` of that tree, never the working tree, so another
# lane's half-finished edit refuses nobody else; a commit touching none of
# those roots skips it (the candidate lints as HEAD). Changed .clj/.cljc namespace
# files lint narrowly: only those files, against the first-party analysis of HEAD
# kept at tmp/orchestrator/lint-cache (brought to HEAD by its changed files under
# lint-cache.lock). Their callers elsewhere join only when the cache entry's shape
# (vars, arities, privacy, inferred returns; no positions) changed, found by naming
# the namespace. Any other path, or more than 150 files, lints all of src script
# test with --cache false. The gate prints which it ran. `bin/seon check` (publication,
# adoption, --test) runs alongside it, except for a commit with no --test whose paths
# are all outside `seon.test.cache/gate-input?` (documentation, experiments off every deps.edn path).
# The commit itself (staged-index check, new-file add, git commit, verification)
# holds .git/lane-commit.lock: git commit shares .git/COMMIT_EDITMSG, the index and
# HEAD between processes, and two concurrent commits once crossed (649829332
# carried lane commit-validation's paths under lane heap-retained's message).
#
# A released path remembers its last holder (tmp/orchestrator/lanes/released.holders):
# only that lane may re-claim it while the file is still dirty and unclaimed. An untracked path
# no lane holds and no released holder remembers is nobody's work yet: the lane naming it claims it.
#
# --branch-evidence AGENT asks the live root one question over its prepl
# (`seon.cluster.branch-evidence/branch-evidence`): does AGENT's branch declare
# exactly the committed files' definitions, and is every test reaching what it
# changed from the cluster head green on its head? Proven, the commit skips
# `bin/seon check` and carries the branch commit, the verified tests and their
# run ids as trailers. Only src/ and test/ .clj and .cljc files qualify; any other path,
# a changed host-bound declaration, an unanalyzable file, no live root or a
# root that has not loaded the gate takes the throwaway check, saying why. A
# file differing from the branch, an unproven or unreached change, or a test
# red before the change that root did not accept (--accept-red-before) refuses.
#
# Refusals (exit 2) name the rule they enforce:
#   - a path claimed by another lane, or already dirty in the tree (someone else's work in progress);
#   - a commit path the lane never claimed;
#   - deps.edn or a reference-code/ gitlink without --restart-batch (a bump belongs to root's restart batch);
#   - anything staged in the index beyond the commit's paths;
#   - `bin/seon check PATHS [--test NS...]` or clj-kondo reporting an error on the candidate.
# A landed commit whose paths or message differ from the request exits 3 (LANE COMMIT MISMATCH);
# history is never rewritten, root fixes forward.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
claims="$root/tmp/orchestrator/lanes"
mkdir -p "$claims"
cd "$root"

refuse() { echo "LANE REFUSED: $*" >&2; exit 2; }

valid_lane() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || refuse "lane name '$1' must be lowercase letters, digits and dashes"; }

# A path is checkout-relative and literal: claims, the docs/ and lint-root
# classification and git's pathspec must name the same files, so a `..` or `.`
# component (docs/../src/x.clj passed as documentation), an absolute path, or
# pathspec magic and glob characters (src/* sweeping other lanes' files) refuse.
valid_path() {
  local path="$1"
  case "$path" in
    ''|/*|:*|..|../*|*/..|*/../*|.|*/.|*/./*|*'*'*|*'?'*|*'['*|*\\*|*//*)
      refuse "path '$path' must be a literal checkout-relative path: no ., .. or empty components, no leading / or :, no * ? [ or \\" ;;
  esac
}

# A claimed argument is one literal path: whitespace means a whole list was passed as one string.
no_whitespace() {
  case "$1" in
    *[[:space:]]*) refuse "path argument '${1//$'\n'/\\n}' contains whitespace; pass each path as its own argument" ;;
  esac
}

# A claim entry covers a path when equal, or when the entry ends with / and prefixes it.
covers() {
  local entry="$1" path="$2"
  [[ "$entry" == "$path" ]] && return 0
  [[ "$entry" == */ && "$path" == "$entry"* ]] && return 0
  [[ "$path" == */ && "$entry" == "$path"* ]] && return 0
  return 1
}

owner_of() {
  local path="$1" file lane entry
  for file in "$claims"/*.paths; do
    [[ -e "$file" ]] || continue
    lane="$(basename "$file" .paths)"
    while IFS= read -r entry; do
      [[ -z "$entry" ]] && continue
      if covers "$entry" "$path"; then echo "$lane"; return 0; fi
    done < "$file"
  done
  return 1
}

holders="$claims/released.holders"

# The lane that last released PATH, or nothing.
last_holder() { awk -F'\t' -v p="$1" '$1 == p { lane = $2 } END { if (lane != "") print lane }' "$holders" 2>/dev/null || true; }

# A path exists, is a new file in an existing directory (nobody's work yet, so
# a lane holding a sibling file never blocks it), or lies under a claimed directory.
exists_or_new_under() {
  local lane="$1" path="$2"; shift 2
  [[ -e "$path" ]] && return 0
  [[ "$path" != */ && -d "$(dirname "$path")" ]] && return 0
  local entry
  for entry in "$@" $(cat "$claims/$lane.paths" 2>/dev/null); do
    [[ "$entry" == */ && "$path" == "$entry"* && -d "$entry" ]] && return 0
  done
  return 1
}

dirty() { [[ -n "$(git status --porcelain -- "$1")" ]]; }

claim() {
  local lane="$1"; shift
  valid_lane "$lane"
  [[ $# -gt 0 ]] || refuse "claim needs at least one path"
  local path owner
  for path in "$@"; do
    no_whitespace "$path"
    path="${path#./}"
    valid_path "$path"
    exists_or_new_under "$lane" "$path" "$@" || refuse "$path does not exist and is not a new file under a claimed directory"
    if owner="$(owner_of "$path")" && [[ "$owner" != "$lane" ]]; then
      refuse "$path is claimed by lane $owner (one file, one owner)"
    fi
    if [[ "${LANE_ADOPT:-}" != 1 ]] && dirty "$path" && ! owner_of "$path" >/dev/null && [[ "$(last_holder "$path")" != "$lane" ]] \
       && { [[ -n "$(git ls-files -- "$path")" ]] || [[ -n "$(last_holder "$path")" ]]; }; then
      refuse "$path already has uncommitted changes nobody claimed; root decides whose they are before anyone edits it"
    fi
  done
  [[ -e "$claims/$lane.base" ]] || git rev-parse HEAD > "$claims/$lane.base"
  for path in "$@"; do
    path="${path#./}"
    grep -qxF -- "$path" "$claims/$lane.paths" 2>/dev/null || echo "$path" >> "$claims/$lane.paths"
    if [[ -e "$holders" ]]; then
      grep -vxF -- "$(printf '%s\t%s' "$path" "$lane")" "$holders" > "$holders.tmp" || true
      mv "$holders.tmp" "$holders"
    fi
  done
  echo "lane $lane claims: ${*#./}"
}


# The tree of HEAD with the named working-tree paths (deletions included), written
# through a temporary index: what `git commit --only PATHS` will commit.
candidate_tree() {
  local scratch="$1"; shift
  local index="$scratch/index"
  GIT_INDEX_FILE="$index" git read-tree HEAD
  GIT_INDEX_FILE="$index" git add -A -- "$@"
  GIT_INDEX_FILE="$index" git write-tree
}

# `git archive TREE` into DIRECTORY (all of src script test, or only the named
# files) with the analyzer's ignored configuration (library imports, generated
# configs) linked from the checkout.
extract_candidate() {
  local tree="$1" directory="$2" entry; shift 2
  mkdir -p "$directory"
  git archive --format=tar "$tree" .clj-kondo ${@:-src script test} | tar -x -C "$directory"
  while IFS= read -r entry; do
    entry="${entry%/}"
    [[ "$entry" == .clj-kondo/.cache || -e "$directory/$entry" ]] && continue
    mkdir -p "$directory/$(dirname "$entry")"
    ln -s "$root/$entry" "$directory/$entry"
  done < <(git ls-files --others --ignored --exclude-standard --directory -- .clj-kondo)
}

# The first-party analysis of HEAD's lint inputs, kept at tmp/orchestrator/lint-cache
# (own cache dir: never the checkout's .clj-kondo/.cache, which a booting JVM
# reads). Library namespaces are in no cache, here or under --cache false.
# `_lint-cache-sync` (under lint-cache.lock) brings it to HEAD: the files HEAD
# changed since the recorded commit are linted into it; a deletion, a
# .clj-kondo change or no record rebuilds it from the whole of HEAD.
lint_cache_sync() {
  local cache="$root/tmp/orchestrator/lint-cache" head recorded changes full="" scratch
  mkdir -p "$cache"
  head="$(git rev-parse HEAD)"
  recorded="$(cat "$cache/commit" 2>/dev/null || true)"
  [[ "$recorded" == "$head" ]] && return 0
  scratch="$(mktemp -d "${TMPDIR:-/tmp}/lint-cache.XXXXXX")"
  if [[ -n "$recorded" ]] && changes="$(git diff --name-status --no-renames "$recorded" "$head" -- src script test .clj-kondo 2>/dev/null)"; then
    if grep -qE $'^D|\t\\.clj-kondo/' <<< "$changes"; then full=1; fi
  else
    full=1
  fi
  if [[ -n "$full" ]]; then
    rm -rf -- "$cache/v1" "$cache/commit"
    extract_candidate "$head" "$scratch/tree"
    (cd "$scratch/tree" && clj-kondo --lint src script test --cache-dir "$cache" --parallel) > "$scratch/out" 2>&1 || true
  else
    local files=()
    while IFS= read -r changes; do files+=("$changes"); done < <(grep -E $'\t.*\\.clj[cs]?$' <<< "$changes" | cut -f2)
    if [[ ${#files[@]} -gt 0 ]]; then
      extract_candidate "$head" "$scratch/tree" "${files[@]}"
      (cd "$scratch/tree" && clj-kondo --lint "${files[@]}" --cache-dir "$cache" --parallel) > "$scratch/out" 2>&1 || true
    fi
  fi
  echo "$head" > "$cache/commit"
  rm -rf -- "$scratch"
}

# The namespace of each changed .clj/.cljc path of src script test (from the
# path, confirmed by the file's own ns form in TREE), one per line; fails when
# a path is no namespace file, so the caller lints the whole tree.
lint_namespaces() {
  local tree="$1" path ns; shift
  for path in "$@"; do
    case "$path" in
      src/*.clj|src/*.cljc|test/*.clj|test/*.cljc|script/*.clj|script/*.cljc) ;;
      *) return 1 ;;
    esac
    ns="${path#*/}"; ns="${ns%.*}"; ns="${ns//\//.}"; ns="${ns//_/-}"
    git show "$tree:$path" 2>/dev/null | grep -qE "^\(ns([[:space:]]|[[:space:]].*[[:space:]}])${ns//./\\.}([[:space:])]|\$)" || return 1
    echo "$ns"
  done
}

# The files of src script test that name a namespace: its direct callers.
lint_callers() {
  local tree="$1" ns
  shift
  for ns in "$@"; do
    git grep -lE -e "${ns//./\\.}([^-A-Za-z0-9._*+!?<>=]|\$)" "$tree" -- src script test | sed "s/^[^:]*://"
  done | grep -E '\.clj[cs]?$' | sort -u
}

# A cache entry's shape: what a caller of the namespace sees (vars, arities,
# macros, privacy), without positions or file names. Transit-JSON cache codes
# are resolved; `absent` for a namespace with no entry.
cache_shape() {
  python3 - "$1" <<'PY'
import json, sys
POS = {"~:row", "~:col", "~:end-row", "~:end-col", "~:name-row", "~:name-col", "~:name-end-row", "~:name-end-col", "~:filename"}
cache = []
def code(s): return ord(s[1]) - 48 if len(s) == 2 else (ord(s[1]) - 48) * 44 + ord(s[2]) - 48
def walk(x, key=False):
    if isinstance(x, str):
        if x.startswith("^") and x != "^ " and len(x) <= 3: return cache[code(x)]
        if len(x) > 3 and (key or x[:2] in ("~:", "~$", "~#")): cache.append(x)
        return x
    if isinstance(x, list):
        if x and x[0] == "^ ": return {walk(k, True): walk(v) for k, v in zip(x[1::2], x[2::2])}
        return [walk(e) for e in x]
    return x
def strip(x):
    if isinstance(x, dict): return {k: strip(v) for k, v in x.items() if k not in POS}
    return [strip(e) for e in x] if isinstance(x, list) else x
try: print(json.dumps(strip(walk(json.load(open(sys.argv[1])))), sort_keys=True))
except FileNotFoundError: print("absent")
PY
}

# Lint the candidate TREE in DIRECTORY for the changed PATHS. Bounded change
# (every path a namespace file): lint the changed files against the cached
# first-party analysis of HEAD (lint_cache_sync); a file's callers elsewhere
# see only its namespace's cache entry, so when that entry's shape is
# unchanged no caller can newly fail and the changed files are the whole lint,
# and when it changed the files naming the namespace join. Sound while every
# other file is HEAD's, which every earlier commit linted. Anything else (a
# non-namespace path, more than 150 files) lints all of src script test with
# --cache false.
lint_candidate() {
  local tree="$1" directory="$2"; shift 2
  local namespaces cache="$directory.cache" ns before changed="" callers scope=()
  if namespaces="$(lint_namespaces "$tree" "$@")"; then
    perl -MFcntl=:flock -e 'open(my $lock, ">>", shift) or die "lint-cache.lock: $!\n"; flock($lock, LOCK_EX) or die "lint-cache.lock: $!\n";
                            exit(system(@ARGV) ? 1 : 0);' \
      "$root/tmp/orchestrator/lint-cache.lock" "$root/bin/lane" _lint-cache-sync
    rm -rf -- "$cache"
    cp -R "$root/tmp/orchestrator/lint-cache" "$cache"
    extract_candidate "$tree" "$directory" "$@"
    echo "== narrow lint: ${#@} changed files against the cached analysis of HEAD"
    (cd "$directory" && clj-kondo --lint "$@" --cache-dir "$cache" --parallel) || true
    for ns in $namespaces; do
      for lang in clj cljc; do
        [[ "$(cache_shape "$cache/v1/$lang/$ns.transit.json")" == "$(cache_shape "$root/tmp/orchestrator/lint-cache/v1/$lang/$ns.transit.json")" ]] || changed="$changed $ns"
      done
    done
    [[ -z "$changed" ]] && { echo "== callers not linted: the shape of ${namespaces//$'\n'/ } is unchanged, so no caller can newly fail"; return 0; }
    while IFS= read -r ns; do scope+=("$ns"); done < <(lint_callers "$tree" $changed)
    if [[ ${#scope[@]} -le 150 ]]; then
      echo "== callers of$changed: ${#scope[@]} files linted with the changed files"
      extract_candidate "$tree" "$directory" "$@" "${scope[@]}"
      (cd "$directory" && clj-kondo --lint "$@" "${scope[@]}" --cache-dir "$cache" --parallel) || true
      return 0
    fi
  fi
  echo "== clj-kondo --lint src script test --cache false --parallel (candidate tree ${tree:0:12})"
  extract_candidate "$tree" "$directory"
  (cd "$directory" && clj-kondo --lint src script test --cache false --parallel)
}

# True when no path is a lint input: the candidate's src, script, test and
# .clj-kondo are HEAD's, which every earlier commit linted.
lints_unchanged() {
  local path
  for path in "$@"; do
    case "$path" in src/*|script/*|test/*|.clj-kondo/*|src|script|test|.clj-kondo) return 1 ;; esac
  done
}

# True when no path is a gate input (`seon.test.cache/gate-input?`): nothing
# outside the program input roots (docs, skill Markdown, experiments on no
# deps.edn path) can change what a check runs, so it has nothing to publish.
# Exit 1 from bb is "some path is an input"; any other failure refuses.
gate_inputs_absent() {
  local status=0
  bb -cp "$root/script:$root/src" -e '
(require (quote [seon.test.cache :as cache]))
(let [[root & paths] *command-line-args*
      roots (cache/input-roots root)]
  (System/exit (if (some #(cache/gate-input? roots %) paths) 1 0)))' "$root" "$@" || status=$?
  case "$status" in
    0) return 0 ;;
    1) return 1 ;;
    *) refuse "seon.test.cache/gate-input? could not classify ${*} (bb exit $status, above); nothing committed" ;;
  esac
}

# The message belongs to this commit: lanes have built -m from one shared
# scratch file (`-m "$(cat scratchpad/msg.txt)"`), and bd5e0e8c9 landed lane
# heap-retained's paths under the message lane error-frames had written there
# (649829332 the same way). Refused: a first line naming another live lane
# ("error frames: ..." from lane heap-retained), or one equal to the subject of
# a commit among the last 200 (a message already used). Keep messages in a
# lane-named file, never a shared one.
message_owned() {
  local lane="$1" first file other prefix subject
  first="$(printf '%s\n' "$2" | head -1)"
  first="$(printf '%s' "$first" | tr '[:upper:]' '[:lower:]')"
  echo "== lane $lane commits: $(printf '%s\n' "$2" | head -1)"
  for file in "$claims"/*.paths; do
    [[ -e "$file" ]] || continue
    other="$(basename "$file" .paths)"
    [[ "$other" == "$lane" ]] && continue
    for prefix in "$other" "${other//-/ }"; do
      case "$first" in
        "$prefix"|"$prefix:"*|"$prefix "*) refuse "the message begins with lane $other's name ('$(printf '%s\n' "$2" | head -1)'); is it that lane's message, read from a shared file? Write this lane's own message" ;;
      esac
    done
  done
  subject="$(printf '%s\n' "$2" | head -1)"
  if git log -200 --format=%s | grep -qxF -- "$subject"; then
    refuse "a commit among the last 200 already has the subject '$subject'; is this message another commit's, read from a shared or stale file?"
  fi
}

# PATH is one of the requested paths or lies under a requested directory.
requested() {
  local path="$1" entry; shift
  for entry in "$@"; do
    [[ "$path" == "$entry" || "$path" == "${entry%/}/"* ]] && return 0
  done
  return 1
}

staged_only() {
  local staged path ok
  while IFS= read -r staged; do
    [[ -z "$staged" ]] && continue
    ok=0
    for path in "$@"; do [[ "$staged" == "$path" ]] && ok=1; done
    [[ $ok == 1 ]] || refuse "$staged is staged in the shared index but not part of this commit; a commit must carry only its own paths"
  done < <(git diff --cached --name-only)
}

# Only source and test Clojure files (.clj, .cljc) are judged by branch evidence.
evidence_paths() {
  local path
  for path in "$@"; do
    case "$path" in
      src/*.clj|src/*.cljc|test/*.clj|test/*.cljc) ;;
      *) echo "== $path is not a src/ or test/ .clj or .cljc file: throwaway check required"; return 1 ;;
    esac
  done
}

# Ask the live root whether AGENT's branch proves PATHS (args: AGENT TRAILER PATH... -- ACCEPTED...).
# Exit 0 proven (trailer lines written), 2 refused, 3 unavailable (take the throwaway check).
branch_evidence() {
  local agent="$1" trailer="$2"; shift 2
  local paths=() accepted=()
  while [[ $# -gt 0 && "$1" != -- ]]; do paths+=("$1"); shift; done
  [[ $# -gt 0 ]] && shift
  accepted=("$@")
  evidence_paths "${paths[@]}" || return 3
  echo "== branch evidence: agent $agent, ${#paths[@]} path(s), over the live root's prepl"
  bb -cp "$root/script:$root/src" -e '
(require (quote [seon.operator :as operator]))
(let [[root agent trailer cluster paths accepted] *command-line-args*
      paths (vec (remove empty? (.split paths "\n")))
      accepted (into #{} (comp (remove empty?) (map symbol)) (.split accepted "\n"))
      form (list (quote let)
                 [(quote main) (list (quote seon.db/db) (list (quote seon.cluster.boot/connection) cluster))
                  (quote branch) (list (quote seon.db/q) (quote (quote [:find ?b . :in $ ?id :where [?a :seon.agent/id ?id] [?a :seon.agent/branch ?b]]))
                                       (quote main) agent)
                  (quote gate) (quote (try (requiring-resolve (quote seon.cluster.branch-evidence/branch-evidence)) (catch Exception _ nil)))]
                 (list (quote cond)
                       (quote (nil? branch)) {:lane/unavailable (str "agent " agent " holds no branch on cluster " cluster)}
                       (quote (nil? gate)) {:lane/unavailable "the live root has not loaded seon.cluster.branch-evidence (it runs an older commit)"}
                       :else (list (quote gate)
                                   (list (quote get-in) (quote @seon.operator.runtime/running-instances) [cluster :seon.store/store])
                                   {:seon.store/branch (quote branch) :seon.source/head (list (quote seon.cluster.branch/cluster-branch) cluster) :seon.fn/root root
                                    :seon.source/paths paths :seon.source/accepted-red-before (list (quote quote) accepted)})))
      began (System/nanoTime)
      live (try (operator/live-root-value! root (pr-str form) {})
                (catch Exception e {:seon.operator/live-process? true
                                    :seon.operator/value {:lane/unavailable (str "the prepl call failed: " (ex-message e))}}))
      answer (:seon.operator/value live)
      ms (long (/ (- (System/nanoTime) began) 1e6))
      show (fn [k] (when-let [v (seq (get answer k))] (println " " (name k) (pr-str (vec v)))))]
  (cond
    (not (:seon.operator/live-process? live)) (do (println "== no live root answers") (System/exit 3))
    (:lane/unavailable answer) (do (println "==" (:lane/unavailable answer)) (System/exit 3))
    (:seon.error/at answer) (do (println "== branch evidence refused:" (:seon.error/message answer)) (System/exit 3))
    :else
    (do (println (str "== branch evidence answered in " ms " ms: proven " (:seon.source/proven? answer)
                      ", " (count (:seon.source/changed answer)) " changed declaration(s), "
                      (count (:seon.source/verified answer)) " verified test(s)"))
        (run! show [:seon.source/changed :seon.source/differing :seon.source/unanalyzable :seon.source/host-bound
                    :seon.source/unproven :seon.source/unreached :seon.source/red-before :seon.source/verified])
        (cond
          (or (seq (:seon.source/host-bound answer)) (seq (:seon.source/unanalyzable answer)))
          (do (println "== a changed declaration is host-bound or a file does not analyze: throwaway check required") (System/exit 3))
          (:seon.source/proven? answer)
          (do (spit trailer (str "Branch-evidence: agent " agent " commit " (:seon.source/branch-commit-id answer)
                                 " over head " (:seon.source/head-commit-id answer) "\n"
                                 (when (seq (:seon.source/verified answer))
                                   (str "Branch-evidence-tests: " (clojure.string/join " " (:seon.source/verified answer)) "\n"))
                                 (when (seq (:seon.source/run-ids answer))
                                   (str "Branch-evidence-runs: " (clojure.string/join " " (:seon.source/run-ids answer)) "\n"))
                                 (when (seq (:seon.source/red-before answer))
                                   (str "Branch-evidence-red-before-accepted: " (clojure.string/join " " (:seon.source/red-before answer)) "\n"))))
              (System/exit 0))
          :else (System/exit 2)))))' "$root" "$agent" "$trailer" "${SEON_CLUSTER:-default}" "$(printf '%s\n' "${paths[@]}")" "$(printf '%s\n' ${accepted[@]+"${accepted[@]}"})"
}

# After a red `bin/seon check` (args: CHECK.edn TRAILER ACCEPTED...): exit 0 when every red var of that run is accepted
# AND red on HEAD too (the same tests run by `bin/seon check --at HEAD`: git CI semantics, a parent that is already red
# may be committed on); writes the trailer. Exit 2 otherwise: a red outside the accepted set, a failure that is no test
# red, or an accepted test that is green on HEAD.
accepted_reds_gate() {
  local result="$1" trailer="$2"; shift 2
  local reds="" red args=() head_result="${result%.edn}-head.edn"
  [[ -s "$result" ]] || { echo "== the check left no test run: its failure is no test red"; return 2; }
  reds="$(bb -e '
(let [[file & accepted] *command-line-args*
      run (clojure.edn/read-string (slurp file))
      red (->> (:seon.test/results run) (filter #(pos? (+ (or (:seon.test/fail-count %) 0) (or (:seon.test/error-count %) 0)))) (map (comp str :seon.test/sym)))
      outside (remove (set accepted) red)]
  (binding [*out* *err*] (println "== check run" (:seon.test.run/id run) "red:" (pr-str red)))
  (cond (empty? red) (System/exit 2)
        (seq outside) (do (binding [*out* *err*] (println "== red but not accepted:" (pr-str outside))) (System/exit 2))
        :else (println (clojure.string/join " " red))))' "$result" "$@")" || return 2
  for red in $reds; do args+=(--test "$red"); done
  echo "== the accepted reds must be red on HEAD: bin/seon check --at HEAD ${args[*]}"
  SEON_TEST_RESULT_FILE="$head_result" bin/seon check --at HEAD "${args[@]}" > /dev/null 2>&1 && { echo "== the accepted tests pass on HEAD: nothing to accept"; return 2; }
  # A red test HEAD does not define is a new proof, red by design (proofs are written before the body): accepted.
  bb -e '
(let [[file trailer & reds] *command-line-args*
      ;; new on HEAD = HEAD's source of the test's namespace file defines no such deftest (decided from git, not the run)
      defined-on-head? (fn [sym]
                         (let [[ns-name var-name] (clojure.string/split sym #"/")
                               path (str "test/" (-> ns-name (clojure.string/replace "." "/") (clojure.string/replace "-" "_")) ".clj")
                               src (:out (clojure.java.shell/sh "git" "show" (str "HEAD:" path)))]
                           (boolean (re-find (re-pattern (str "\\(deftest\\s+(\\^\\S+\\s+|\\^\\{[^}]*\\}\\s+)*" (java.util.regex.Pattern/quote var-name) "(\\s|\\))")) (or src "")))))
      new-proofs (remove defined-on-head? reds)
      old (filter defined-on-head? reds)
      run (when (.exists (java.io.File. file)) (clojure.edn/read-string (slurp file)))
      _ (when (and (seq old) (not (and (map? run) (:seon.test.run/id run))))
          (binding [*out* *err*] (println "== the HEAD check left no test run: the accepted reds HEAD defines cannot be judged red on HEAD")) (System/exit 2))
      results (:seon.test/results run)
      head-red (set (->> results (filter #(pos? (+ (or (:seon.test/fail-count %) 0) (or (:seon.test/error-count %) 0)))) (map (comp str :seon.test/sym))))
      green (remove head-red old)]
  (binding [*out* *err*] (println "== HEAD run" (:seon.test.run/id run) "red:" (pr-str (sort head-red)) "new proofs absent on HEAD:" (pr-str new-proofs)))
  (when (seq green) (binding [*out* *err*] (println "== not red on HEAD:" (pr-str green))) (System/exit 2))
  (spit trailer (str (when-let [old (seq (remove (set new-proofs) reds))] (str "Check-red-before-accepted: " (clojure.string/join " " old) "\n"))
                     (when (seq new-proofs) (str "Check-new-red-proof: " (clojure.string/join " " new-proofs) "\n")))))' "$head_result" "$trailer" $reds || return 2
}

commit() {
  local lane="$1"; shift
  valid_lane "$lane"
  [[ -e "$claims/$lane.paths" ]] || refuse "lane $lane has no claims; run bin/lane claim first"
  local message="" tests=() paths=() path evidence_agent="" accepted=() at_candidate="" restart_batch=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m) message="$2"; shift 2 ;;
      --branch-evidence) [[ $# -ge 2 ]] || refuse "--branch-evidence needs the agent whose branch proves the paths"; evidence_agent="$2"; shift 2 ;;
      --accept-red-before) [[ $# -ge 2 ]] || refuse "--accept-red-before needs a test symbol"; accepted+=("$2"); shift 2 ;;
      --test) [[ $# -ge 2 ]] || refuse "--test needs a test name"; tests+=("--test" "$2"); shift 2 ;;
      --include-long) tests+=("--include-long"); shift ;;
      --at-candidate) at_candidate=1; shift ;;
      --restart-batch) restart_batch=1; shift ;;
      *) paths+=("${1#./}"); shift ;;
    esac
  done
  # `--test A B C` leaves B and C as paths: a test name is no file and no tracked path.
  if [[ ${#tests[@]} -gt 0 ]]; then
    for path in ${paths[@]+"${paths[@]}"}; do
      if [[ ! -e "$path" ]] && ! git ls-files --error-unmatch -- "$path" >/dev/null 2>&1 && [[ "$path" != *.* || "$path" != */* ]]; then
        refuse "'$path' is not a path: each test needs its own --test (--test A --test B), not --test A B"
      fi
    done
  fi
  [[ -n "$message" ]] || refuse "commit needs -m MESSAGE"
  message_owned "$lane" "$message"
  [[ ${#paths[@]} -gt 0 ]] || refuse "commit needs the exact paths to commit"
  local owner
  for path in "${paths[@]}"; do
    valid_path "$path"
    owner="$(owner_of "$path" || true)"
    [[ "$owner" == "$lane" ]] || refuse "$path is not claimed by lane $lane${owner:+ (lane $owner holds it)}"
  done
  # A dependency or fork bump commits only inside a restart batch root opened (AGENTS.md "Restart in batches").
  if [[ -z "$restart_batch" ]]; then
    local mode
    for path in "${paths[@]}"; do
      mode="$(git ls-files -s -- "$path" | cut -c1-6)"
      if [[ "$path" == deps.edn ]] || [[ "$path" == reference-code/* && ( "$mode" == 160000 || -e "${path%/}/.git" ) ]]; then
        refuse "$path is a dependency or fork bump: it commits only inside a restart batch root opens (AGENTS.md, Restart in batches); write the change as a patch for root's next batch; nothing committed"
      fi
    done
  fi
  # The staged-index check runs only under the lock (commit_locked): outside it,
  # another lane's in-lock `git add` of its new file reads as foreign staging.

  scratch="$(mktemp -d "${TMPDIR:-/tmp}/lane-commit.XXXXXX")"
  lint_pid=""
  # A fatal signal runs no EXIT trap unless trapped: exit through it, so the
  # scratch directory and the background lint (the subshell and its clj-kondo)
  # never outlive an interrupted commit.
  # The lint runs in its own process group (set -m below): killing the group
  # stops git archive, tar and clj-kondo alike. `|| true`: under errexit a
  # failing wait would end the trap before the rm.
  trap 'if [[ -n "$lint_pid" ]]; then kill -- "-$lint_pid" 2>/dev/null || true; wait "$lint_pid" 2>/dev/null || true; fi; rm -rf -- "$scratch"' EXIT
  trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
  local tree began
  began=$SECONDS
  tree="$(candidate_tree "$scratch" "${paths[@]}")" || refuse "the candidate tree could not be written"
  if lints_unchanged "${paths[@]}"; then
    echo "== no path under src script test .clj-kondo: the candidate lints as HEAD; clj-kondo not run"
    echo "linting took 0ms, errors: 0, (unchanged)" > "$scratch/lint.out"
  else
    set -m
    lint_candidate "$tree" "$scratch/candidate" "${paths[@]}" > "$scratch/lint.out" 2>&1 &
    lint_pid=$!
    set +m
  fi

  local proven_by_branch="" proven_by_reds=""
  if [[ -n "$evidence_agent" ]]; then
    local evidence_status=0
    branch_evidence "$evidence_agent" "$scratch/trailer" "${paths[@]}" -- ${accepted[@]+"${accepted[@]}"} || evidence_status=$?
    case "$evidence_status" in
      0) proven_by_branch=1 ;;
      2) refuse "branch evidence does not prove ${paths[*]}; nothing committed" ;;
      *) echo "== branch evidence unavailable (above): falling back to the throwaway check" ;;
    esac
  fi
  if [[ -n "$proven_by_branch" ]]; then
    echo "== proven by agent $evidence_agent's branch evidence; bin/seon check not run"
  elif [[ ${#tests[@]} -eq 0 ]] && gate_inputs_absent "${paths[@]}"; then
    echo "== no gate input among the paths (seon.test.cache/gate-input?); bin/seon check not run"
  else
    [[ ${#tests[@]} -gt 0 ]] || refuse "the throwaway check names no test: pass each reaching test as --test NS/VAR (a check that runs no test proves nothing); nothing committed"
    local check_args=("${paths[@]}")
    if [[ -n "$at_candidate" ]]; then
      local revision
      revision="$(git commit-tree "$tree" -p HEAD -m "$message")"
      check_args=(--at "$revision")
    fi
    echo "== bin/seon check ${check_args[*]} ${tests[*]+"${tests[*]}"}"
    if [[ ${#accepted[@]} -gt 0 ]]; then
      SEON_TEST_RESULT_FILE="$scratch/check.edn" bin/seon check "${check_args[@]}" ${tests[@]+"${tests[@]}"} && rm -f "$scratch/check.edn" ||
        { accepted_reds_gate "$scratch/check.edn" "$scratch/trailer" "${accepted[@]}" || refuse "bin/seon check failed beyond the accepted reds; nothing committed"; proven_by_reds=1; }
    else
      bin/seon check "${check_args[@]}" ${tests[@]+"${tests[@]}"} || refuse "bin/seon check failed; nothing committed"
    fi
  fi
  [[ -n "$lint_pid" ]] && { wait "$lint_pid" || true; }
  lint_pid=""
  local summary
  summary="$(grep -E '^linting took' "$scratch/lint.out" | tail -1 || true)"
  echo "${summary:-$(tail -1 "$scratch/lint.out")}"
  if [[ ! "$summary" =~ errors:\ 0, ]]; then
    grep -E ': error: ' "$scratch/lint.out" | head -40 >&2 || true
    refuse "clj-kondo reports errors on the candidate (HEAD + ${paths[*]}); nothing committed"
  fi
  echo "== proved in $((SECONDS - began)) s; committing under .git/lane-commit.lock"

  printf '%s\n' "$message" > "$scratch/message"
  # The evidence joins the message's trailer block (Co-Authored-By ...) when it ends in one.
  if [[ -n "$proven_by_branch$proven_by_reds" ]]; then
    [[ "$(printf '%s\n' "$message" | tail -1)" =~ ^[A-Za-z-]+:\  ]] || printf '\n' >> "$scratch/message"
    cat "$scratch/trailer" >> "$scratch/message"
  fi
  local git_dir
  git_dir="$(git rev-parse --absolute-git-dir)"
  # The lock descriptor is inherited (close-on-exec cleared), so the commit
  # holds the lock until it exits even if this perl dies first.
  perl -MFcntl=:flock,F_SETFD -e 'open(my $lock, ">>", shift) or die "lane-commit.lock: $!\n";
                          flock($lock, LOCK_EX) or die "lane-commit.lock: $!\n";
                          fcntl($lock, F_SETFD, 0) or die "lane-commit.lock: $!\n";
                          my $status = system(@ARGV); exit($status == -1 ? 2 : ($status >> 8) || ($status & 127 ? 2 : 0));' \
    "$git_dir/lane-commit.lock" "$root/bin/lane" _commit-locked "$lane" "$scratch/message" "$tree" "${paths[@]}"
}

# Under .git/lane-commit.lock (held by `commit`): the staged-index check, the
# new-file add, the commit and its verification, so no two lanes' commits interleave.
commit_locked() {
  local lane="$1" message_file="$2" proven="$3"; shift 3
  local paths=("$@") path added=() before after now
  staged_only "${paths[@]}"
  # The commit carries the bytes that were linted and checked: the paths'
  # candidate now (working tree over the current HEAD) must equal the proven
  # tree's. A path edited during the check refuses; another lane's commit of
  # other paths meanwhile does not (lanes own disjoint files).
  mkdir -p "$(dirname "$message_file")/locked"
  now="$(candidate_tree "$(dirname "$message_file")/locked" "${paths[@]}")" || refuse "the candidate tree could not be rewritten under the lock"
  git diff --quiet "$proven" "$now" -- "${paths[@]}" ||
    refuse "$(git diff --name-only "$proven" "$now" -- "${paths[@]}" | tr '\n' ' ')changed after the check; nothing committed, run bin/lane commit again"
  before="$(git rev-parse HEAD)"
  # Untracked files under the named paths are in the candidate (`git add -A`)
  # but `git commit --only` takes tracked files only, so they are added (alone)
  # first: a new file, or a new file inside a claimed directory that already
  # holds tracked ones. Nothing else enters the index.
  while IFS= read -r path; do
    git add -- "$path"
    added+=("$path")
  done < <(git ls-files --others --exclude-standard -- "${paths[@]}")
  if ! git commit --only --cleanup=whitespace -F "$message_file" -- "${paths[@]}"; then
    [[ ${#added[@]} -gt 0 ]] && git reset -q -- "${added[@]}"
    refuse "git commit failed; nothing committed"
  fi
  after="$(git rev-parse HEAD)"

  # The landed commit must be exactly the request: its parent, its paths, its message.
  local problems=() committed
  [[ "$(git rev-parse "$after^")" == "$before" ]] || problems+=("parent is $(git rev-parse --short "$after^"), not ${before:0:9}")
  while IFS= read -r committed; do
    requested "$committed" "${paths[@]}" || problems+=("carries $committed, which lane $lane did not request")
  done < <(git diff-tree --no-commit-id --name-only -r --no-renames "$before" "$after")
  for path in "${paths[@]}"; do
    git diff --quiet "$after" -- "$path" || problems+=("$path in the working tree differs from the commit")
  done
  if [[ "$(git stripspace < "$message_file")" != "$(git log -1 --format=%B "$after" | git stripspace)" ]]; then
    problems+=("message is \"$(git log -1 --format=%s "$after")\", requested \"$(head -1 "$message_file")\"")
  fi
  if [[ ${#problems[@]} -gt 0 ]]; then
    {
      echo "LANE COMMIT MISMATCH: lane $lane's commit $(git rev-parse --short "$after") is not what it requested:"
      printf '  - %s\n' "${problems[@]}"
      echo "  requested paths: ${paths[*]}"
      echo "  History is not rewritten; root fixes forward."
    } >&2
    exit 3
  fi
  git log --oneline -1
}

# Ask the live root to close AGENT's admission, its end (`seon.cluster.host/close-admissions!` on the agent's
# branch), so root's next db<->flow pass deletes the branch when nothing on it is unmerged.
retire_agent() {
  local agent="$1"
  bb -cp "$root/script:$root/src" -e '
(require (quote [seon.operator :as operator]))
(let [[root agent cluster] *command-line-args*
      form (str "(let [c (seon.cluster.boot/connection " (pr-str cluster) ") b (seon.db/q (quote [:find ?b . :in $ ?id :where [?a :seon.agent/id ?id] [?a :seon.agent/branch ?b]]) (seon.db/db c) " (pr-str agent) ")] (if b (seon.cluster.host/close-admissions! c b) {:lane/unavailable \"the agent holds no branch\"}))")
      live (try (operator/live-root-value! root form {})
                (catch Exception e {:seon.operator/live-process? true
                                    :seon.operator/value {:lane/unavailable (str "the prepl call failed: " (ex-message e))}}))
      answer (:seon.operator/value live)]
  (cond
    (not (:seon.operator/live-process? live)) (do (println "== no live root answers; agent" agent "keeps its branch") (System/exit 3))
    (:lane/unavailable answer) (do (println "==" (:lane/unavailable answer)) (System/exit 3))
    (:seon.error/at answer) (do (println "== agent end refused:" (:seon.error/message answer)) (System/exit 3))
    :else (println "== agent" agent "ended (admission closed); root deletes its branch when nothing is unmerged")))' "$root" "$agent" "${SEON_CLUSTER:-default}"
}

release() {
  local lane="$1"; shift
  valid_lane "$lane"
  local agent=""
  if [[ "${1:-}" == --agent ]]; then
    [[ $# -ge 2 ]] || refuse "--agent needs the lane's agent id"
    agent="$2"; shift 2
  fi
  local file="$claims/$lane.paths" path
  if [[ ! -e "$file" ]]; then
    echo "lane $lane holds no claims"
    [[ -z "$agent" ]] || retire_agent "$agent"
    return 0
  fi
  if [[ $# -eq 0 ]]; then set -- $(cat "$file"); fi
  for path in "$@"; do
    path="${path#./}"
    grep -qxF -- "$path" "$file" || refuse "lane $lane does not hold '$path'"
  done
  for path in "$@"; do
    path="${path#./}"
    printf '%s\t%s\n' "$path" "$lane" >> "$holders"
    grep -vxF -- "$path" "$file" > "$file.tmp" || true
    mv "$file.tmp" "$file"
  done
  if [[ ! -s "$file" ]]; then rm -f "$file" "$claims/$lane.base"; fi
  echo "lane $lane released ${#} path(s)"
  [[ -z "$agent" ]] || retire_agent "$agent"
}

status() {
  if [[ $# -gt 0 ]]; then
    valid_lane "$1"
    [[ -e "$claims/$1.paths" ]] && cat "$claims/$1.paths" || echo "lane $1 holds no claims"
    return 0
  fi
  local file lane
  shopt -s nullglob
  local any=0
  for file in "$claims"/*.paths; do
    any=1
    lane="$(basename "$file" .paths)"
    echo "$lane (since $(cut -c1-9 "$claims/$lane.base" 2>/dev/null || echo '?')): $(wc -l < "$file" | tr -d ' ') paths"
  done
  [[ $any == 1 ]] || echo "no live claims"
}

command="${1:-status}"; shift || true
case "$command" in
  claim|add) claim "$@" ;;
  commit) commit "$@" ;;
  evidence)
    [[ $# -ge 2 ]] || refuse "evidence needs AGENT and at least one path"
    evidence_agent="$1"; shift
    evidence_trailer="$(mktemp "${TMPDIR:-/tmp}/lane-evidence.XXXXXX")"
    trap 'rm -f -- "$evidence_trailer"' EXIT
    branch_evidence "$evidence_agent" "$evidence_trailer" "$@" ;;
  _lint-cache-sync) lint_cache_sync ;;
  _lint-candidate) lint_candidate "$@" ;;
  _evidence-paths) evidence_paths "$@" ;;
  _commit-locked) commit_locked "$@" ;;
  release) release "$@" ;;
  status) status "$@" ;;
  *) sed -n '2,36p' "$0"; exit 1 ;;
esac
