#!/bin/zsh
# DEVIATES: reads ps, sample, lsof and fiber dumps from the shell. Not to be ported: seon.system/a-wait-past-its-bound-captures-its-own-evidence asks what a bounded Flow wait leaves to capture.
# bin/evidence DIR PID [PORT]: what PID and the processes under it are doing, into DIR, as a run is stopped: a stuck run ended at its
# bound otherwise takes its evidence with it (docs/clocks.md#time-decides-the-owners-exceptions). First, with PORT, the Seon state
# of the root serving there (seon.system/stall-state, asked of its server: root's stall check and each agent proc's, read-only), in
# DIR/seon-state.edn; then the tree (ps), each process's sample, its files, and last a fiber dump asked of each Jolt process (kill
# -INFO, on its stderr, as docs/machine.md#reading-a-hang asks, copied to DIR/dump-PID.txt where that stderr is a file), since
# that signal can free a hang. Reads only; ends in about 2 s a
# process (the state's ping waits at most :seon.config.check/ping-ms for a proc mid-step).
D=$1 ROOTP=$2 PORT=${3:-}
# PID is a process its caller started: from PID 1 (an orphan's parent) the tree is every process on the machine, each
# signalled for a dump (it was, once, 2026-11-12)
[[ $ROOTP == <2-> ]] || { print -u2 "bin/evidence: PID must be a process its caller started, not ${ROOTP:-none}"; exit 2 }
mkdir -p "$D"
[[ -n $PORT ]] && print -r -- '{:op :eval :agent "root" :code "(seon.system/stall-state sys)"}' | "${0:h}/ask" "$PORT" > "$D/seon-state.edn" 2>&1
ps -axo pid,ppid,pgid,etime,%cpu,rss,stat,command > "$D/ps.txt"
# the dump goes to each process's own stderr (a step's log, an agent's .err under its runs directory, a test child's pipe):
# where a regular file holds it, what the dump added is copied to DIR/dump-PID.txt, so the evidence holds every process's
# fibers whatever its stderr is (data's overran problems step kept samples but no dump, 2026-11-12)
typeset -A ERR AT
# the processes signalled are read again now, not from the first ps: a test child forked since (an agent's next fork) was
# left out (runtime's overrun, 2026-11-13: the shard and its agent signalled, the stuck test child never). They are the tree
# under PID and every member of each process group in it (a group's member re-parented away is still the run's), each group
# verified first (its leader is itself under PID: this run started it; AGENTS.md section 8); this run's own group (the caller's,
# bin/evidence's own) is never signalled whole: its members in the tree are signalled one by one
OWN=$(ps -o pgid= -p $$ | tr -d ' ')
ps -axo pid=,ppid=,pgid= > "$D/ps-signal.txt"
TREE=($(awk -v r="$ROOTP" '{p[$1]=$2; o[NR]=$1} END{for(i in o){x=o[i]; while(x in p){if(x==r){print o[i]; break} x=p[x]}}}' "$D/ps-signal.txt"))
# and what a process of the tree started detached: a test root under bin/held --detach is parented by launchd, in a group of
# its own, so neither the tree nor its groups hold it; its held shares the starter's fifo (SEON_STARTER_FIFO, held open by the
# starter and by every held it started), so every process holding a fifo a tree member holds is the run's, with its own tree
# (runtime's overrun, 2026-11-13: only the shard signalled, its detached roots' agents and test children never)
# (macOS's lsof names no holders of a fifo by its path, so a held is found by its own record: SEON_STARTER_FIFO in its
# environment, ps -E, the fifo named as given or as resolved)
FIFOS=($(for k in $TREE; do lsof -a -p $k -Fn 2>/dev/null | sed -n 's/^n//p'; done | sort -u | while read -r f; do [[ -p $f ]] && print -r -- $f; done))
ps -axwwE -o pid=,command= > "$D/ps-env.txt" 2>/dev/null
for f in $FIFOS; do
  for h in $(grep -F -e "SEON_STARTER_FIFO=$f" -e "SEON_STARTER_FIFO=${f#/private}" "$D/ps-env.txt" | awk '{print $1}'); do
    (( ${TREE[(Ie)$h]} )) && continue
    TREE+=($(awk -v r="$h" '{p[$1]=$2; o[NR]=$1} END{for(i in o){x=o[i]; while(x in p){if(x==r){print o[i]; break} x=p[x]}}}' "$D/ps-signal.txt"))
  done
done
GROUPS=($(for k in $TREE; do awk -v k=$k '$1==k{print $3}' "$D/ps-signal.txt"; done | sort -u))
MEMBERS=($TREE)
for g in $GROUPS; do
  [[ $g == $OWN || $g == <0-1> ]] && continue
  # verified: the group's leader is itself under PID (this run started it), never a group met by chance
  (( ${TREE[(Ie)$g]} )) || continue
  MEMBERS+=($(awk -v g=$g '$3==g{print $1}' "$D/ps-signal.txt"))
done
# each root of the run asked for its Seon state at the port it listens on, before any signal (a dump can free a hang): a root a
# shard started detached (bin/held) is the run's by its fifo, and its port is read off its own listening socket, so no caller
# names it (flow's dry run: the peer root's state was never asked, no PORT reached bin/evidence)
for k in ${(u)MEMBERS}; do
  for p in $(lsof -a -p $k -iTCP -sTCP:LISTEN -P -n -Fn 2>/dev/null | sed -n 's/^n.*:\([0-9]*\)$/\1/p' | sort -u); do
    [[ $p == $PORT ]] && continue
    print -r -- '{:op :eval :agent "root" :code "(seon.system/stall-state sys)"}' | "${0:h}/ask" "$p" > "$D/seon-state-$k.edn" 2>&1
  done
done
for k in ${(u)MEMBERS}; do
  c=$(ps -o command= -p $k 2>/dev/null)
  [[ $c == *seon* || $c == *jolt* ]] || continue
  [[ $c == *bin/* || $c == *held* || $c == *zsh* || $c == *perl* ]] && continue
  f=$(lsof -a -p $k -d 2 -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)
  [[ -f $f ]] && { ERR[$k]=$f; AT[$k]=$(stat -f %z "$f") }
  # each process signalled is sampled first, from the same set: a sample taken from the first ps alone missed the test child
  # forked after it, whose dump was then empty and its stacks never read (deps, 2026-11-14: 21833 in a 300 s overrun)
  command -v sample >/dev/null && sample $k 1 -file "$D/sample-$k.txt" >/dev/null 2>&1
  lsof -p $k > "$D/lsof-$k.txt" 2>/dev/null
  print -r -- "$k $c" >> "$D/signalled.txt"
  kill -INFO $k 2>/dev/null
done
sleep 1
for k in ${(k)ERR}; do tail -c +$(( AT[$k] + 1 )) "${ERR[$k]}" > "$D/dump-$k.txt" 2>/dev/null; done
# and the logs every process of the run writes (a shared root's root.log, which bin/held's perl writes from the root's stderr pipe,
# so the root's fiber dump is there; an agent's .err): the runs directory that holds them is
# removed when its shard ends (seon.test-store/start-shared-root!'s hook), which took the one record of the wait an overrun lost
# (deps' run14: the root's log was gone before anyone read it). Each is cloned (cp -c: APFS copy-on-write, no bytes copied).
mkdir -p "$D/logs"
for k in ${(u)MEMBERS}; do
  # the files it holds open, and the log its command or its parent's names (bin/held --log P writes a root's stderr there, a
  # write at a time; a root found by its fifo brings its own tree, never the held above it)
  { lsof -a -p $k -Fn 2>/dev/null | sed -n 's/^n//p'
    for c in $k $(ps -o ppid= -p $k 2>/dev/null); do ps -ww -o command= -p $c 2>/dev/null | sed -n 's/.*--log \([^ ]*\).*/\1/p'; done } \
    | grep -E '/runs/.*\.(log|err|out)$' | sort -u | while read -r f; do
    [[ -f $f ]] && cp -c "$f" "$D/logs/$k-${f:t}" 2>/dev/null
  done
done
