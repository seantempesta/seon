#!/bin/sh
# bin/build — the runtime from the pinned sources: Chez (our fork) -> Jolt (our fork)
# -> target/hello (a binary that requires Datahike and opens an in-memory db), then
# target/lib/libprobe.dylib (native/probe.c, native/ids.c), target/watch (native/watch.c, root's file events), target/lib/liblmdb.dylib (LMDB, robust locks),
# target/lib/liblz4.dylib and target/lib/libzstd.dylib (the store's compressors) and target/seon (the platform, -main seon.check, the check driver in test/).
#
#   bin/build            every step; chez, jolt, native, lmdb, lz4 and zstd are skipped when their stamp matches their pin
#   bin/build chez|jolt|hello|native|lmdb|lz4|zstd|seon   one step, and each step it needs whose stamp is stale
#   BUILD_FORCE=1 bin/build     every stamp removed first: each step rebuilds, once
#
# Everything is written under target/; nothing is installed outside it. Dependency
# downloads (Maven jars, git deps) go into target/home, because HOME points there
# for the Jolt steps. The submodules are never written: each source tree is copied
# into target/src first (an APFS clone on macOS, so the copy is cheap).
#
# Prerequisites (not installed by this script): a C compiler and make (on macOS the
# Xcode command line tools), git, curl, and network access to GitHub and Maven
# Central for the first run's dependencies.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
"$ROOT/bin/ports" --write   # the port keys under their current names (bin/ports)
T=$ROOT/target
RC=$ROOT/reference-code
STEP=${1:-all}
JOBS=${BUILD_JOBS:-4}   # BUILD_JOBS overrides; 4 keeps a shared machine responsive

say() { printf '%s build: %s\n' "$(date +%H:%M:%S)" "$*"; }
die() { printf 'build: %s\n' "$*" >&2; exit 1; }

for tool in cc make git; do
  command -v "$tool" >/dev/null 2>&1 || die "missing prerequisite: $tool"
done
[ -f "$RC/chez/c/thread.c" ] && [ -f "$RC/jolt/host/chez/build-jolt.ss" ] ||
  die "submodules are not checked out: git -c protocol.file.allow=always submodule update --init --recursive"
[ -n "$(ls -A "$RC/jolt/vendor/irregex" 2>/dev/null)" ] ||
  die "reference-code/jolt's own submodules are missing: git submodule update --init --recursive"

mkdir -p "$T/src" "$T/home"

# copy_tree SRC DEST: a fresh copy of a checked-out submodule, without its .git link.
copy_tree() {
  rm -rf "$2"
  if [ "$(uname)" = Darwin ]; then cp -cR "$1" "$2"; else cp -a "$1" "$2"; fi
  find "$2" -name .git -prune -exec rm -rf {} +
}

# fresh NAME PIN: true when target/NAME.stamp records PIN. A forced build removes every stamp
# once, here, so each step rebuilds once however many steps call it.
fresh() { [ -f "$T/$1.stamp" ] && [ "$(cat "$T/$1.stamp")" = "$2" ]; }
[ -z "${BUILD_FORCE:-}" ] || rm -f "$T"/chez.stamp "$T"/jolt.stamp "$T"/native.stamp "$T"/lmdb.stamp "$T"/lz4.stamp "$T"/zstd.stamp

# pin DIR: what a build reads from the checkout at DIR, by content: its HEAD when its files are
# HEAD's, else HEAD+ the tree of its files as they are (untracked ones too, in an index of its
# own), so an uncommitted edit in a submodule is built, and named (seon.fx/pin computes the same)
pin() {
  if [ -z "$(git -C "$1" status --porcelain -uall --ignore-submodules=all)" ]; then git -C "$1" rev-parse HEAD; return; fi
  i=$(mktemp -u "${TMPDIR:-/tmp}/seon-pin.XXXXXX")
  t=$(GIT_INDEX_FILE=$i git -C "$1" add -A && GIT_INDEX_FILE=$i git -C "$1" write-tree) || { rm -f "$i"; die "pin $1: git add or write-tree failed"; }
  rm -f "$i"
  echo "$(git -C "$1" rev-parse HEAD)+$t"
}
CHEZ_PIN=$(pin "$RC/chez")
JOLT_PIN=$(pin "$RC/jolt")
CHEZ=$T/chez/bin/scheme
JOLT=$T/jolt/jolt

build_chez() {
  if fresh chez "$CHEZ_PIN" && [ -x "$CHEZ" ]; then say "chez up to date ($CHEZ_PIN)"; return; fi
  say "chez: copying reference-code/chez at $CHEZ_PIN"
  copy_tree "$RC/chez" "$T/src/chez"
  say "chez: configure + make -j$JOBS + install into target/chez"
  ( cd "$T/src/chez"
    # --threads: Jolt requires a threaded Chez. -fPIC: jolt build --library folds
    # libkernel.a into a shared object (as reference-code/jolt's own provisioning does).
    ./configure --threads --disable-x11 --disable-curses --installprefix="$T/chez" CFLAGS+=-fPIC
    make -j"$JOBS"
    make install ) > "$T/chez-build.log" 2>&1 || die "chez build failed; see target/chez-build.log"
  threaded=$(printf '(write (threaded?))\n' | "$CHEZ" -q)
  [ "$threaded" = '#t' ] || die "target/chez is not threaded"
  echo "$CHEZ_PIN" > "$T/chez.stamp"
  rm -f "$T/jolt.stamp"
}

build_jolt() {
  build_chez
  if fresh jolt "$JOLT_PIN" && [ -x "$JOLT" ]; then say "jolt up to date ($JOLT_PIN)"; return; fi
  version=$(cd "$RC/jolt" && sh tools/version.sh)
  say "jolt: copying reference-code/jolt at $JOLT_PIN ($version)"
  copy_tree "$RC/jolt" "$T/src/jolt"
  say "jolt: build-jolt.ss release -> target/jolt/jolt"
  mkdir -p "$T/jolt"
  ( cd "$T/src/jolt"
    HOME=$T/home JOLT_VERSION=$version JOLT_CHEZ=$CHEZ \
      "$CHEZ" --script host/chez/build-jolt.ss release "$T/jolt/jolt" ) > "$T/jolt-build.log" 2>&1 ||
    die "jolt build failed; see target/jolt-build.log"
  echo "$JOLT_PIN" > "$T/jolt.stamp"
}

build_hello() {
  build_jolt
  # Datahike's store loads its codecs' libraries (liblz4, libzstd) at load: built first, named by bin/env
  build_lz4
  build_zstd
  . "$ROOT/bin/env"
  say "hello: jolt build -m build.hello (Datahike from reference-code/) -> target/hello"
  ( cd "$ROOT"
    HOME=$T/home JOLT_PWD=$ROOT "$JOLT" -A:hello build -m build.hello -o "$T/hello" ) > "$T/hello-build.log" 2>&1 ||
    die "hello build failed; see target/hello-build.log"
  say "hello: built; run target/hello"
}

build_native() {
  pin=$(git -C "$ROOT" hash-object native/probe.c native/ids.c native/watch.c | tr '\n' ' ')
  if fresh native "$pin" && [ -f "$T/lib/libprobe.dylib" ] && [ -x "$T/watch" ]; then say "native up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "native: native/probe.c native/ids.c -> target/lib/libprobe.dylib, native/watch.c -> target/watch"
  cc -O2 -shared -o "$T/lib/libprobe.dylib" "$ROOT/native/probe.c" "$ROOT/native/ids.c" || die "native build failed"
  cc -O2 -o "$T/watch" "$ROOT/native/watch.c" -framework CoreServices || die "native build failed (watch)"
  echo "$pin" > "$T/native.stamp"
}

# LMDB from reference-code/lmdb (the official repository as a submodule on mdb.master3, the branch konserve.jolt.lmdb-ffi binds), built
# with MDB_USE_ROBUST: on macOS LMDB otherwise locks with POSIX semaphores, and a process
# SIGKILLed inside a write txn leaves the writer lock held for every process that has the env
# open (measured 2026-10-21; docs/failure-points.md#lmdb-robust-locks). Robust, it uses SysV
# semaphores with SEM_UNDO: the kernel releases a dead holder's lock. target/lmdb-kill
# (native/lmdb_kill.c) is its proof, a bin/check step.
LMDB_SRC=$RC/lmdb/libraries/liblmdb
build_lmdb() {
  [ -f "$LMDB_SRC/mdb.c" ] || die "missing LMDB source at $LMDB_SRC (the reference-code/lmdb submodule)"
  pin="$(pin "$LMDB_SRC") robust"
  if fresh lmdb "$pin" && [ -f "$T/lib/liblmdb.dylib" ]; then say "lmdb up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "lmdb: $LMDB_SRC at $pin -> target/lib/liblmdb.dylib (MDB_USE_ROBUST)"
  cc -shared -O2 -g -pthread -DMDB_USE_ROBUST -install_name @rpath/liblmdb.dylib -o "$T/lib/liblmdb.dylib" \
    "$LMDB_SRC/mdb.c" "$LMDB_SRC/midl.c" "$LMDB_SRC/module.c" > "$T/lmdb-build.log" 2>&1 || die "lmdb build failed; see target/lmdb-build.log"
  cc -O2 -I"$LMDB_SRC" -o "$T/lmdb-kill" "$ROOT/native/lmdb_kill.c" "$T/lib/liblmdb.dylib" -Wl,-rpath,"$T/lib" ||
    die "lmdb-kill (native/lmdb_kill.c) build failed"
  echo "$pin" > "$T/lmdb.stamp"
}

# liblz4 (konserve.jolt.lz4: the store's node compressor, :seon.config.store/compressor) from
# the lz4 Chez itself vendors (reference-code/chez/lz4, Chez's pin of lz4/lz4), so the stack
# holds one lz4 and builds it from source, never a system library.
LZ4_SRC=$RC/chez/lz4/lib
build_lz4() {
  [ -f "$LZ4_SRC/lz4frame.c" ] || die "missing lz4 source at $LZ4_SRC (reference-code/chez's lz4 submodule)"
  pin="$(git -C "$RC/chez" ls-tree HEAD lz4 | awk '{print $3}')"
  if fresh lz4 "$pin" && [ -f "$T/lib/liblz4.dylib" ]; then say "lz4 up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "lz4: $LZ4_SRC at $pin -> target/lib/liblz4.dylib"
  cc -shared -O3 -install_name @rpath/liblz4.dylib -o "$T/lib/liblz4.dylib" \
    "$LZ4_SRC/lz4.c" "$LZ4_SRC/lz4hc.c" "$LZ4_SRC/lz4frame.c" "$LZ4_SRC/xxhash.c" > "$T/lz4-build.log" 2>&1 ||
    die "lz4 build failed; see target/lz4-build.log"
  echo "$pin" > "$T/lz4.stamp"
}

# libzstd (konserve.jolt.zstd: the store's compressor, :seon.config.store/compressor :zstd) from
# reference-code/zstd, the official repository pinned as a submodule (owner, 2026-10-22: zstd
# for stored values, a trained dictionary once a representative corpus exists, so dictBuilder
# is built too). Plain C, no assembly, single-threaded: one value is compressed at a time.
ZSTD_SRC=$RC/zstd/lib
build_zstd() {
  [ -f "$ZSTD_SRC/zstd.h" ] || die "missing zstd source at $ZSTD_SRC (the reference-code/zstd submodule)"
  pin="$(pin "$RC/zstd")"
  if fresh zstd "$pin" && [ -f "$T/lib/libzstd.dylib" ]; then say "zstd up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "zstd: $ZSTD_SRC at $pin -> target/lib/libzstd.dylib"
  cc -shared -O3 -DZSTD_DISABLE_ASM -I"$ZSTD_SRC" -I"$ZSTD_SRC/common" -install_name @rpath/libzstd.dylib -o "$T/lib/libzstd.dylib" \
    "$ZSTD_SRC"/common/*.c "$ZSTD_SRC"/compress/*.c "$ZSTD_SRC"/decompress/*.c "$ZSTD_SRC"/dictBuilder/*.c > "$T/zstd-build.log" 2>&1 ||
    die "zstd build failed; see target/zstd-build.log"
  echo "$pin" > "$T/zstd.stamp"
}

build_seon() {
  # each step decides by its own stamp (its sources' pin), never by its output existing: a sync
  # to a new pin rebuilds what moved (task seon.check/a-build-rebuilds-what-its-pin-moved); a
  # generation's worktree (seon.fx/build) holds its checkout's build, not ../vendor-c
  build_jolt
  build_native
  build_lmdb
  build_lz4
  build_zstd
  # the shared compile caches (bin/env): a schema file seon.contract reads, or one added to the
  # directory it lists, moves the key of every namespace compiled against it
  . "$ROOT/bin/env"
  # the tree this build reads, as git names it (seon.fx/tree-id computes the same): HEAD's tree
  # with every changed and untracked unignored file added, in an index of its own. Written
  # beside the binary once it is built, so a root records its source's inputs for its agents
  # only when its binary is built from that very tree (seon.root/import-source!)
  idx=$(mktemp -u)
  if git -C "$ROOT" rev-parse --verify --quiet HEAD > /dev/null; then GIT_INDEX_FILE=$idx git -C "$ROOT" read-tree HEAD; fi
  GIT_INDEX_FILE=$idx git -C "$ROOT" add -A && tree=$(GIT_INDEX_FILE=$idx git -C "$ROOT" write-tree) || tree=
  rm -f "$idx"
  rm -f "$T/seon.tree"
  # the check driver is the binary's main: seon.check, in test/ (outside src; task
  # seon.main/drivers-leave-src), dispatches root and ports to seon.main and every check mode
  # to itself, so the build reads test/ too (the :test alias)
  say "seon: jolt -A:test build -m seon.check -> target/seon"
  ( cd "$ROOT"
    HOME=$T/home JOLT_PWD=$ROOT "$JOLT" -A:test build -m seon.check -o "$T/seon" ) > "$T/seon-build.log" 2>&1 ||
    { tail -30 "$T/seon-build.log" >&2; die "seon build failed; see target/seon-build.log"; }
  [ -n "$tree" ] && echo "$tree" > "$T/seon.tree"
  say "seon: built target/seon (tree ${tree:-unknown})"
}

case $STEP in
  chez) build_chez ;;
  jolt) build_jolt ;;
  hello) build_hello ;;
  native) build_native ;;
  lmdb) build_lmdb ;;
  lz4) build_lz4 ;;
  zstd) build_zstd ;;
  seon) build_seon ;;
  all) build_chez; build_jolt; build_native; build_lmdb; build_lz4; build_zstd; build_hello; build_seon ;;
  *) die "unknown step $STEP (chez | jolt | hello | native | lmdb | lz4 | zstd | seon | all)" ;;
esac
