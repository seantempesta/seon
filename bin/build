#!/bin/sh
# bin/build — the runtime from the pinned sources: Chez (our fork) -> Jolt (our fork)
# -> target/hello (a binary that requires Datahike and opens an in-memory db), then
# target/lib/libprobe.dylib (native/probe.c, native/ids.c), target/watch (native/watch.c, root's file events), target/lib/liblmdb.dylib (LMDB, robust locks),
# target/lib/liblz4.dylib and target/lib/libzstd.dylib (the store's compressors), target/lib/libseon-embed.dylib
# (llama.cpp and native/embed.c, with the embedding model fetched once by its sha256), target/css/app.css (the page's
# stylesheet, Tailwind over resources/public/css/input.css) and target/seon (the platform, -main seon.main; a check mode loads the driver, test/seon/check.clj, at run time).
#
#   bin/build            every step; chez, jolt, native, lmdb, lz4, zstd, embed and css are skipped when their stamp matches their pin; hello and seon when it matches the tree and the toolchain's pins
#   bin/build chez|jolt|hello|native|lmdb|lz4|zstd|embed|css|seon   one step, and each step it needs whose stamp is stale
#   BUILD_FORCE=1 bin/build     every stamp removed first: each step rebuilds, once
#
# Everything is written under target/; nothing is installed outside it. Dependency
# downloads (Maven jars, git deps) go into target/home, because HOME points there
# for the Jolt steps. The submodules are never written: each source tree is copied
# into target/src first (an APFS clone on macOS, so the copy is cheap).
#
# Prerequisites (not installed by this script): a C compiler and make (on macOS the
# Xcode command line tools), git, curl, cmake (llama.cpp's build), and network access to GitHub,
# Maven Central and Hugging Face (the embedding model) for the first run's dependencies.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
# main's merge verification goes first (bin/env's main_first), in a subshell: bin/env's
# variables are the steps' to set, below
( . "$ROOT/bin/env"; main_first )
"$ROOT/bin/ports" --write   # the port keys under their current names (bin/ports)
T=$ROOT/target
RC=$ROOT/reference-code
STEP=${1:-all}
JOBS=${BUILD_JOBS:-4}   # BUILD_JOBS overrides; 4 keeps a shared machine responsive

say() { printf '%s build: %s\n' "$(date +%H:%M:%S)" "$*"; }
die() { printf 'build: %s\n' "$*" >&2; exit 1; }

for tool in cc make git; do
  command -v "$tool" >/dev/null 2>&1 || die "missing prerequisite: $tool"
done
[ -f "$RC/chez/c/thread.c" ] && [ -f "$RC/jolt/host/chez/build-jolt.ss" ] ||
  die "submodules are not checked out: git -c protocol.file.allow=always submodule update --init --recursive"
[ -n "$(ls -A "$RC/jolt/vendor/irregex" 2>/dev/null)" ] ||
  die "reference-code/jolt's own submodules are missing: git submodule update --init --recursive"

mkdir -p "$T/src" "$T/home"

# copy_tree SRC DEST: a fresh copy of a checked-out submodule, without its .git link.
copy_tree() {
  rm -rf "$2"
  if [ "$(uname)" = Darwin ]; then cp -cR "$1" "$2"; else cp -a "$1" "$2"; fi
  find "$2" -name .git -prune -exec rm -rf {} +
}

# fresh NAME PIN: true when target/NAME.stamp records PIN. A forced build removes every stamp
# once, here, so each step rebuilds once however many steps call it.
fresh() { [ -f "$T/$1.stamp" ] && [ "$(cat "$T/$1.stamp")" = "$2" ]; }
[ -z "${BUILD_FORCE:-}" ] || rm -f "$T"/chez.stamp "$T"/jolt.stamp "$T"/native.stamp "$T"/lmdb.stamp "$T"/lz4.stamp "$T"/zstd.stamp "$T"/embed.stamp "$T"/css.stamp "$T"/hello.stamp "$T"/seon.stamp

# pin DIR: what a build reads from the checkout at DIR, by content: its HEAD when its files are
# HEAD's, else HEAD+ the tree of its files as they are (untracked ones too, in an index of its
# own), so an uncommitted edit in a submodule is built, and named (seon.fx/pin computes the same)
pin() {
  if [ -z "$(git -C "$1" status --porcelain -uall --ignore-submodules=all)" ]; then git -C "$1" rev-parse HEAD; return; fi
  i=$(mktemp -u "${TMPDIR:-/tmp}/seon-pin.XXXXXX")
  t=$(GIT_INDEX_FILE=$i git -C "$1" add -A && GIT_INDEX_FILE=$i git -C "$1" write-tree) || { rm -f "$i"; die "pin $1: git add or write-tree failed"; }
  rm -f "$i"
  echo "$(git -C "$1" rev-parse HEAD)+$t"
}
CHEZ_PIN=$(pin "$RC/chez")
JOLT_PIN=$(pin "$RC/jolt")
CHEZ=$T/chez/bin/scheme
JOLT=$T/jolt/jolt

build_chez() {
  if fresh chez "$CHEZ_PIN" && [ -x "$CHEZ" ]; then say "chez up to date ($CHEZ_PIN)"; return; fi
  say "chez: copying reference-code/chez at $CHEZ_PIN"
  copy_tree "$RC/chez" "$T/src/chez"
  say "chez: configure + make -j$JOBS + install into target/chez"
  ( cd "$T/src/chez"
    # --threads: Jolt requires a threaded Chez. -fPIC: jolt build --library folds
    # libkernel.a into a shared object (as reference-code/jolt's own provisioning does).
    ./configure --threads --disable-x11 --disable-curses --installprefix="$T/chez" CFLAGS+=-fPIC
    make -j"$JOBS"
    make install ) > "$T/chez-build.log" 2>&1 || die "chez build failed; see target/chez-build.log"
  threaded=$(printf '(write (threaded?))\n' | "$CHEZ" -q)
  [ "$threaded" = '#t' ] || die "target/chez is not threaded"
  echo "$CHEZ_PIN" > "$T/chez.stamp"
  rm -f "$T/jolt.stamp"
}

build_jolt() {
  build_chez
  if fresh jolt "$JOLT_PIN" && [ -x "$JOLT" ]; then say "jolt up to date ($JOLT_PIN)"; return; fi
  version=$(cd "$RC/jolt" && sh tools/version.sh)
  say "jolt: copying reference-code/jolt at $JOLT_PIN ($version)"
  copy_tree "$RC/jolt" "$T/src/jolt"
  say "jolt: build-jolt.ss release -> target/jolt/jolt"
  mkdir -p "$T/jolt"
  ( cd "$T/src/jolt"
    HOME=$T/home JOLT_VERSION=$version JOLT_CHEZ=$CHEZ \
      "$CHEZ" --script host/chez/build-jolt.ss release "$T/jolt/jolt" ) > "$T/jolt-build.log" 2>&1 ||
    die "jolt build failed; see target/jolt-build.log"
  echo "$JOLT_PIN" > "$T/jolt.stamp"
}

# TREE_KEY: what hello and seon are built from: this checkout's tree as git names it (bin/tree) and
# the pins of the toolchain beneath it. Computed once, by the first of them to ask.
REFS=
tree_key() {
  [ -n "${TREE:-}" ] || TREE=$("$ROOT/bin/tree" "$ROOT") || TREE=
  # every checkout under reference-code/ by content (pin): the tree names a submodule by its commit only
  [ -n "$REFS" ] || for d in "$RC"/*/; do REFS="$REFS $(pin "${d%/}")"; done
  KEY=; [ -z "$TREE" ] || KEY="$TREE$REFS"
}

build_hello() {
  build_jolt
  # Datahike's store loads its codecs' libraries (liblz4, libzstd) at load: built first, named by bin/env
  build_lz4
  build_zstd
  . "$ROOT/bin/env"
  tree_key; key=$KEY
  if [ -n "$key" ] && fresh hello "$key" && [ -x "$T/hello" ]; then say "hello up to date (tree $TREE)"; return; fi
  rm -f "$T/hello.stamp"
  say "hello: jolt build -m build.hello (Datahike from reference-code/) -> target/hello"
  ( cd "$ROOT"
    HOME=$T/home JOLT_PWD=$ROOT "$JOLT" -A:hello build -m build.hello -o "$T/hello" ) > "$T/hello-build.log" 2>&1 ||
    die "hello build failed; see target/hello-build.log"
  [ -z "$key" ] || echo "$key" > "$T/hello.stamp"
  say "hello: built; run target/hello"
}

build_native() {
  pin=$(git -C "$ROOT" hash-object native/probe.c native/ids.c native/vector.c native/watch.c | tr '\n' ' ')
  if fresh native "$pin" && [ -f "$T/lib/libprobe.dylib" ] && [ -x "$T/watch" ]; then say "native up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "native: native/probe.c native/ids.c native/vector.c -> target/lib/libprobe.dylib, native/watch.c -> target/watch"
  cc -O2 -shared -o "$T/lib/libprobe.dylib" "$ROOT/native/probe.c" "$ROOT/native/ids.c" "$ROOT/native/vector.c" || die "native build failed"
  cc -O2 -o "$T/watch" "$ROOT/native/watch.c" -framework CoreServices || die "native build failed (watch)"
  echo "$pin" > "$T/native.stamp"
}

# LMDB from reference-code/lmdb (the official repository as a submodule on mdb.master3, the branch konserve.jolt.lmdb-ffi binds), built
# with MDB_USE_ROBUST: on macOS LMDB otherwise locks with POSIX semaphores, and a process
# SIGKILLed inside a write txn leaves the writer lock held for every process that has the env
# open (measured 2026-10-21; docs/failure-points.md#lmdb-robust-locks). Robust, it uses SysV
# semaphores with SEM_UNDO: the kernel releases a dead holder's lock. target/lmdb-kill
# (native/lmdb_kill.c) is its proof, a bin/check step; target/lmdb-sem (native/lmdb_sem.c), that
# each env has a semaphore set of its own (our fork's jolt/sysv-sem-identity), another.
LMDB_SRC=$RC/lmdb/libraries/liblmdb
build_lmdb() {
  [ -f "$LMDB_SRC/mdb.c" ] || die "missing LMDB source at $LMDB_SRC (the reference-code/lmdb submodule)"
  pin="$(pin "$LMDB_SRC") robust"
  if fresh lmdb "$pin" && [ -f "$T/lib/liblmdb.dylib" ]; then say "lmdb up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "lmdb: $LMDB_SRC at $pin -> target/lib/liblmdb.dylib (MDB_USE_ROBUST)"
  cc -shared -O2 -g -pthread -DMDB_USE_ROBUST -install_name @rpath/liblmdb.dylib -o "$T/lib/liblmdb.dylib" \
    "$LMDB_SRC/mdb.c" "$LMDB_SRC/midl.c" "$LMDB_SRC/module.c" > "$T/lmdb-build.log" 2>&1 || die "lmdb build failed; see target/lmdb-build.log"
  cc -O2 -I"$LMDB_SRC" -o "$T/lmdb-kill" "$ROOT/native/lmdb_kill.c" "$T/lib/liblmdb.dylib" -Wl,-rpath,"$T/lib" ||
    die "lmdb-kill (native/lmdb_kill.c) build failed"
  cc -O2 -I"$LMDB_SRC" -o "$T/lmdb-sem" "$ROOT/native/lmdb_sem.c" "$T/lib/liblmdb.dylib" -Wl,-rpath,"$T/lib" ||
    die "lmdb-sem (native/lmdb_sem.c) build failed"
  echo "$pin" > "$T/lmdb.stamp"
}

# liblz4 (konserve.jolt.lz4: the store's node compressor, :seon.config.store/compressor) from
# the lz4 Chez itself vendors (reference-code/chez/lz4, Chez's pin of lz4/lz4), so the stack
# holds one lz4 and builds it from source, never a system library.
LZ4_SRC=$RC/chez/lz4/lib
build_lz4() {
  [ -f "$LZ4_SRC/lz4frame.c" ] || die "missing lz4 source at $LZ4_SRC (reference-code/chez's lz4 submodule)"
  pin="$(git -C "$RC/chez" ls-tree HEAD lz4 | awk '{print $3}')"
  if fresh lz4 "$pin" && [ -f "$T/lib/liblz4.dylib" ]; then say "lz4 up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "lz4: $LZ4_SRC at $pin -> target/lib/liblz4.dylib"
  cc -shared -O3 -install_name @rpath/liblz4.dylib -o "$T/lib/liblz4.dylib" \
    "$LZ4_SRC/lz4.c" "$LZ4_SRC/lz4hc.c" "$LZ4_SRC/lz4frame.c" "$LZ4_SRC/xxhash.c" > "$T/lz4-build.log" 2>&1 ||
    die "lz4 build failed; see target/lz4-build.log"
  echo "$pin" > "$T/lz4.stamp"
}

# libzstd (konserve.jolt.zstd: the store's compressor, :seon.config.store/compressor :zstd) from
# reference-code/zstd, the official repository pinned as a submodule (owner, 2026-10-22: zstd
# for stored values, a trained dictionary once a representative corpus exists, so dictBuilder
# is built too). Plain C, no assembly, single-threaded: one value is compressed at a time.
ZSTD_SRC=$RC/zstd/lib
build_zstd() {
  [ -f "$ZSTD_SRC/zstd.h" ] || die "missing zstd source at $ZSTD_SRC (the reference-code/zstd submodule)"
  pin="$(pin "$RC/zstd")"
  if fresh zstd "$pin" && [ -f "$T/lib/libzstd.dylib" ]; then say "zstd up to date ($pin)"; return; fi
  mkdir -p "$T/lib"
  say "zstd: $ZSTD_SRC at $pin -> target/lib/libzstd.dylib"
  cc -shared -O3 -DZSTD_DISABLE_ASM -I"$ZSTD_SRC" -I"$ZSTD_SRC/common" -install_name @rpath/libzstd.dylib -o "$T/lib/libzstd.dylib" \
    "$ZSTD_SRC"/common/*.c "$ZSTD_SRC"/compress/*.c "$ZSTD_SRC"/decompress/*.c "$ZSTD_SRC"/dictBuilder/*.c > "$T/zstd-build.log" 2>&1 ||
    die "zstd build failed; see target/zstd-build.log"
  echo "$pin" > "$T/zstd.stamp"
}

# The page's stylesheet (docs/render.md#tailwind): Tailwind v4's standalone binary, pinned by version
# and checksum and fetched once into target/tailwind/, over resources/public/css/input.css (every
# directive, token, source glob and the agents' safelist) into target/css/app.css. Its pin is the
# digest of its inputs, input.css and the src/ files it scans: unchanged, nothing is regenerated.
TAILWIND_VERSION=v4.3.3
TAILWIND_SHA256=cdf646702987a743464dff4d9c60fd4480d1c1e73dd819a9a67f1078815dce9d  # tailwindcss-macos-arm64
TAILWIND=$T/tailwind/tailwindcss-$TAILWIND_VERSION
build_css() {
  pin="$TAILWIND_VERSION $( (cat "$ROOT/resources/public/css/input.css"; find "$ROOT/src" -name '*.clj' | LC_ALL=C sort | xargs cat) | shasum -a 256 | cut -c1-64)"
  if fresh css "$pin" && [ -f "$T/css/app.css" ]; then say "css up to date ($pin)"; return; fi
  if [ ! -x "$TAILWIND" ]; then
    say "css: fetching tailwindcss $TAILWIND_VERSION (macos-arm64) into target/tailwind/"
    mkdir -p "$T/tailwind"
    curl -sSfL -o "$TAILWIND.part" "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-macos-arm64" ||
      die "css: fetching tailwindcss $TAILWIND_VERSION failed"
    [ "$(shasum -a 256 "$TAILWIND.part" | cut -c1-64)" = "$TAILWIND_SHA256" ] || { rm -f "$TAILWIND.part"; die "css: tailwindcss $TAILWIND_VERSION does not match its pinned checksum"; }
    chmod +x "$TAILWIND.part" && mv "$TAILWIND.part" "$TAILWIND"
  fi
  mkdir -p "$T/css"
  say "css: resources/public/css/input.css -> target/css/app.css"
  ( cd "$ROOT" && "$TAILWIND" -i resources/public/css/input.css -o "$T/css/app.css" --minify ) > "$T/css-build.log" 2>&1 ||
    die "css build failed; see target/css-build.log"
  echo "$pin" > "$T/css.stamp"
}

# The embedding model in process (docs/vector.md#the-model): llama.cpp from reference-code/llama.cpp
# (the official repository at tag v0.7.0, the first release with EmbeddingGemma-2), built static with
# Metal and no OpenMP (nothing linked from outside target/), and native/embed.c over it, into
# target/lib/libseon-embed.dylib; root's :embed worker alone loads it (ggml starts threads). The
# model file (bin/env's SEON_EMBED_MODEL, fetched from SEON_EMBED_MODEL_URL) is one copy in the main
# tree's target/cache for every worktree, named by its sha256 and checked against it before it is kept.
LLAMA_SRC=$RC/llama.cpp
build_embed() {
  [ -f "$LLAMA_SRC/include/llama.h" ] || die "missing llama.cpp source at $LLAMA_SRC (the reference-code/llama.cpp submodule)"
  . "$ROOT/bin/env"
  if [ ! -f "$SEON_EMBED_MODEL" ]; then
    mkdir -p "$(dirname "$SEON_EMBED_MODEL")"
    say "embed: fetching the model, $SEON_EMBED_MODEL_URL -> $SEON_EMBED_MODEL"
    curl -fsSL -o "$SEON_EMBED_MODEL.part" "$SEON_EMBED_MODEL_URL" || die "embed: the model fetch failed ($SEON_EMBED_MODEL_URL)"
    got=$(shasum -a 256 "$SEON_EMBED_MODEL.part" | cut -d' ' -f1)
    [ "$got" = "$(basename "$SEON_EMBED_MODEL" .gguf)" ] || { rm -f "$SEON_EMBED_MODEL.part"; die "embed: the model's sha256 is $got, not the pinned $(basename "$SEON_EMBED_MODEL" .gguf)"; }
    mv "$SEON_EMBED_MODEL.part" "$SEON_EMBED_MODEL"
  fi
  pin="$(pin "$LLAMA_SRC") $(git -C "$ROOT" hash-object native/embed.c)"
  if fresh embed "$pin" && [ -f "$T/lib/libseon-embed.dylib" ]; then say "embed up to date ($pin)"; return; fi
  command -v cmake >/dev/null 2>&1 || die "missing prerequisite for the embedding model: cmake"
  mkdir -p "$T/lib"
  say "embed: $LLAMA_SRC at $pin -> target/lib/libseon-embed.dylib"
  copy_tree "$LLAMA_SRC" "$T/src/llama.cpp"
  B=$T/src/llama.cpp/build
  { cmake -S "$T/src/llama.cpp" -B "$B" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DGGML_METAL=ON -DGGML_METAL_EMBED_LIBRARY=ON \
      -DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DLLAMA_BUILD_COMMON=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_TOOLS=OFF \
      -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF -DLLAMA_OPENSSL=OFF &&
    cmake --build "$B" --target llama -j "$JOBS" &&
    cc -O2 -shared -install_name @rpath/libseon-embed.dylib -o "$T/lib/libseon-embed.dylib" \
      -I"$T/src/llama.cpp/include" -I"$T/src/llama.cpp/ggml/include" "$ROOT/native/embed.c" \
      "$B/src/libllama.a" "$B/ggml/src/libggml.a" "$B/ggml/src/libggml-base.a" "$B/ggml/src/libggml-cpu.a" \
      "$B/ggml/src/ggml-metal/libggml-metal.a" "$B/ggml/src/ggml-blas/libggml-blas.a" \
      -framework Metal -framework Foundation -framework MetalKit -framework Accelerate -lc++; } > "$T/embed-build.log" 2>&1 ||
    die "embed build failed; see target/embed-build.log"
  echo "$pin" > "$T/embed.stamp"
}

build_seon() {
  # each step decides by its own stamp (its sources' pin), never by its output existing: a sync
  # to a new pin rebuilds what moved (task seon.check/a-build-rebuilds-what-its-pin-moved); a
  # generation's worktree (seon.fx/build) holds its checkout's build, not a shared one
  build_jolt
  build_native
  build_lmdb
  build_lz4
  build_zstd
  build_embed
  build_css
  # the shared compile caches (bin/env): a schema file seon.contract reads, or one added to the
  # directory it lists, moves the key of every namespace compiled against it
  . "$ROOT/bin/env"
  # the tree this build reads, as git names it (bin/tree). Written beside the binary once it is
  # built, so a root records its source's inputs for its agents only when its binary is built
  # from that very tree (seon.root/import-source!), and bin/check runs no binary built from another
  tree_key; key=$KEY
  tree=${TREE:-}
  if [ -n "$key" ] && fresh seon "$key" && [ -x "$T/seon" ] && [ "$(cat "$T/seon.tree" 2>/dev/null)" = "$tree" ]; then say "seon up to date (tree $tree)"; return; fi
  rm -f "$T/seon.tree" "$T/seon.stamp"
  # the program's main: seon.main serves root and ports, and loads the check driver
  # (seon.check, in test/, outside src; task seon.main/drivers-leave-src) from the checkout's
  # source for every other mode, so the release binary holds only the program
  say "seon: jolt build -m seon.main -> target/seon"
  ( cd "$ROOT"
    HOME=$T/home JOLT_PWD=$ROOT "$JOLT" build -m seon.main -o "$T/seon" ) > "$T/seon-build.log" 2>&1 ||
    { tail -30 "$T/seon-build.log" >&2; die "seon build failed; see target/seon-build.log"; }
  [ -n "$tree" ] && echo "$tree" > "$T/seon.tree"
  [ -z "$key" ] || echo "$key" > "$T/seon.stamp"
  say "seon: built target/seon (tree ${tree:-unknown})"
}

case $STEP in
  chez) build_chez ;;
  jolt) build_jolt ;;
  hello) build_hello ;;
  native) build_native ;;
  lmdb) build_lmdb ;;
  lz4) build_lz4 ;;
  zstd) build_zstd ;;
  embed) build_embed ;;
  css) build_css ;;
  seon) build_seon ;;
  all) build_chez; build_jolt; build_native; build_lmdb; build_lz4; build_zstd; build_embed; build_css; build_hello; build_seon ;;
  *) die "unknown step $STEP (chez | jolt | hello | native | lmdb | lz4 | zstd | embed | css | seon | all)" ;;
esac
