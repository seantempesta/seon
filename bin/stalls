#!/bin/zsh
# bin/stalls MS LOG:PID ... — name a stalled test, never end it: while any PID runs, each LOG (a
# shard's, bin/test) whose last "started <test>" line is followed by no write for longer than MS
# prints and records "STALLED <test> <quiet ms> (LOG)", once per test. Exits when every PID has.
# An observation of time, named in docs/clocks.md (bin/test's stall bound, :seon.config.agent/stall-ms).
MS=$1; shift
typeset -A seen; local pair log pid t age alive
while true; do
  alive=0
  for pair in "$@"; do
    log=${pair%:*} pid=${pair##*:}
    kill -0 $pid 2>/dev/null || continue
    alive=1
    t=$(grep '^started' "$log" 2>/dev/null | tail -1); t=${t#started }
    [[ -n $t && ${seen[$log]} != $t ]] || continue
    age=$(( ($(date +%s) - $(stat -f %m "$log")) * 1000 ))
    (( age > MS )) && { seen[$log]=$t; echo "STALLED $t $age ms ($log)" | tee -a "$log" }
  done
  (( alive )) || exit 0
  sleep 1
done
