#!/bin/zsh
# bin/stalls MS END BOUNDS LOG:PID ... — name a stalled test, and end one that overran: while any PID runs, each LOG (a
# shard's, bin/test) whose last test line is "started <test>" (no "ended" since):
# - quiet (no write) for longer than that test's stall bound prints and records "STALLED <test> <quiet ms> (LOG)", once per
#   test, and nothing more: a name. The stall bound is the second word of its line in BOUNDS ("<test> <stall ms> <end ms>":
#   :seon.config.proofs/stall-factor times its own last run, the plan's out/stall-bounds), else MS (:seon.config.agent/stall-ms).
# - running for longer than its end bound (the third word of its line: :seon.config.check/step-end-factor times its own last
#   run, floored at that factor times stall-ms; else END, the floor) is ended, the owner's fourth clock exception
#   (docs/clocks.md#time-decides-the-owners-exceptions), as bin/check ends an overran step: its shard's evidence first
#   (bin/evidence PID into LOG's -overran directory), then "OVERRAN <test> <end ms> ms ..." recorded in LOG, then the shard
#   (PID and every process under it, bin/end-tree) ended with SIGKILL. bin/test stores the test red and runs the shard's rest.
# Both judge by wall time, which load can triple, so each line carries the 5-minute load. Exits when every PID has. An
# observation of time, named in docs/clocks.md.
MS=$1 END=$2 BOUNDS=$3; shift 3
HERE=${0:a:h}
typeset -A seen bound endb cur since over; local pair log pid t age alive b e line k s x now d
[[ -r $BOUNDS ]] && while read -r k s x; do bound[$k]=$s; [[ -n $x ]] && endb[$k]=$x; done < $BOUNDS
while true; do
  alive=0
  for pair in "$@"; do
    log=${pair%:*} pid=${pair##*:}
    kill -0 $pid 2>/dev/null || continue
    alive=1
    # a shard this watcher ended: dead, though bin/test has not waited it yet
    [[ -n ${over[$log]} ]] && continue
    # the shard's last test line: a test still running only after "started" (an "ended" test is done)
    t=$(grep -E '^(started|ended) ' "$log" 2>/dev/null | tail -1)
    [[ $t == started\ * ]] || continue
    t=${t#started } now=$(date +%s)
    # when this watcher first saw the test start: its running time, read to the second
    [[ ${cur[$log]} == $t ]] || { cur[$log]=$t; since[$log]=$now }
    e=${endb[$t]:-$END}
    if (( (now - since[$log]) * 1000 > e )); then
      over[$log]=1 d=${log%.log}-overran
      "$HERE/evidence" "$d" $pid > /dev/null 2>&1
      echo "OVERRAN $t $e ms (ran $(( (now - since[$log]) * 1000 )) ms, past :seon.config.check/step-end-factor times its measure; load $(sysctl -n vm.loadavg | awk '{print $3}'); evidence in $d, $log)" | tee -a "$log"
      "$HERE/end-tree" $pid; kill -KILL $pid 2>/dev/null
      continue
    fi
    [[ ${seen[$log]} != $t ]] || continue
    b=${bound[$t]:-$MS}
    age=$(( (now - $(stat -f %m "$log")) * 1000 ))
    # wall time, which load stretches: the 5-minute load is named beside it, to read the name by
    (( age > b )) && { seen[$log]=$t; echo "STALLED $t $age ms (bound $b ms, load $(sysctl -n vm.loadavg | awk '{print $3}'), $log)" | tee -a "$log" }
  done
  (( alive )) || exit 0
  sleep 1
done
