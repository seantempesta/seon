#!/bin/zsh
# bin/semsets [--remove] [DIR ...]   this user's SysV semaphore sets of the robust LMDB build, counted: the
# total, those of another user or layout, those naming an existing lock file, those kept because the last
# process to use one is alive, and the orphans (docs/failure-points.md#lmdb-robust-locks). With --remove the
# orphans are removed. A hand tool, called by nothing: a run that removed orphans would hide the leak the
# lmdb-sem step exists to show.
#
# An orphan is a set of four semaphores whose identity (semaphores 2 and 3, a hash of a lock file's inode and
# device: mdb.c's mdb_sem_ident) names no lock file found, and whose reader and writer locks were last used by
# processes that are gone. The lock files looked for are every lock.mdb and *-lock file under the main tree
# (its worktrees included), /private/tmp, /private/var/folders and each DIR given. A store held open
# elsewhere is kept by its live pid; a store elsewhere that nobody holds is not found, and its set is removed:
# safe, as LMDB's next open of that store makes a new one.
#
# The paths go through a file (thousands of them overflow argv) to target/semsets (native/semsets.c, built by
# bin/build lmdb). Prints the one line of counts; exits 1 when a removal failed.
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
MAIN=$(cd "$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
REMOVE=()
[[ ${1:-} == --remove ]] && { REMOVE=(--remove); shift }
BIN=$ROOT/target/semsets
[[ -x $BIN ]] || "$ROOT/bin/build" lmdb >&2
LIST=$(mktemp -t semsets)
trap 'rm -f "$LIST"' EXIT
for d in "$MAIN" /private/tmp /private/var/folders "$@"; do
  [[ -d $d ]] && find "$d" \( -name lock.mdb -o -name '*-lock' \) -type f -print 2>/dev/null
done >> "$LIST" || true
exec "$BIN" "$LIST" $REMOVE
