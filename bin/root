#!/bin/zsh
# bin/root [start [--reindex] [ARGS]|stop|kill|status|next]   this checkout's standing root, on this checkout's own
# ports (bin/ports): its server (reached by bin/mcp, or `printf '{:op :agents}\n' | bin/ask
# PORT`) and its dashboard. `start` (the default) runs it detached: double-forked so it
# is re-parented to PID 1, because the tool host kills a background task's whole process tree
# when the task stops or its agent exits (ISOLATION, 2026-10-21). It runs until `bin/root stop`
# closes its stdin. ARGS go to the root (`--profile deepseek`, `--set :seon.config.source/root=\"DIR\"`, ...). Its
# output: runs/root.log; its pids: runs/root.pids ("TAIL ROOT"); the server port it was started
# bound (what bin/mcp relays to; the root's ROOT LISTENING line names it): runs/root.port, while
# it runs.
# `start`'s root catches its main up with the files this checkout changed since main last indexed them (ROOT CAUGHT UP;
# docs/source.md#a-boot-catches-up-with-its-checkout); when what changed reaches the binary (ROOT STALE BINARY on main's tree,
# this checkout's), start runs bin/build seon and starts it again, once.
# `next` restarts the next generation (owner, 2026-10-21; docs/source.md#the-next-generation):
# it asks the running root for the generation main records (my.root/next-generation: the tree
# my.root/build! built from the last merges commit, and the arguments resuming this root's store
# and main), stops the root, and starts that tree's binary on them. A process never replaces
# itself: bin/root owns it. Only what cannot load in place needs a new binary (a pin, deps.edn,
# native code); a merge loads in place, and a restart catches up on main at boot.
# `start --reindex [ARGS]` is the full outside-in (docs/source.md#files-and-the-db-two-directions): refused while a
# root of this checkout runs (bin/root stop first); otherwise it erases this checkout's store (SEON_STORE, else
# <SEON_RUNS>/store, and its -agents dir) and starts, so the fresh store's first boot seeds main from the tree
# (the program, the wiki and the task files). It stops nothing and touches no other checkout's store.
# bin/root run CHECKOUT PORT WEB [ARGS]   one root of CHECKOUT's build in the foreground, until
# stdin closes (what `start` and `next` run).
#
# It runs on the one kept store, <SEON_RUNS>/store (<this tree>/runs/store), and resumes its
# main (:seon.config.root/main, "main"; SEON_MAIN=<branch> names another) at every boot, its
# agents' and tasks' branches named under it: a run's record is main's commit history.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/bin/env"
export SEON_RUNS=${SEON_RUNS:-$ROOT/runs}
# a root started here builds main from this checkout's source when its store is new (and follows it
# after): :seon.config.source/root's default; config/local.edn or --set names another tree
export SEON_SOURCE_ROOT=${SEON_SOURCE_ROOT:-$ROOT}
if [[ ${1:-} == run ]]; then
  # the tree's own build, config and caches (bin/env, read from that tree); the ports over the
  # config's (local.edn honours these)
  G=$2; P=$3; W=$4; shift 4
  # SEON_RUN_CHECKOUT: the tree a root reads its checkout's files from (docs, config) when it is
  # not the build's own (a test's: seon.test-store/start-root!)
  # the checkout's config/local.edn (its ports, the standing root's source) is this root's layer,
  # named on its command line (seon.config reads no layer implicitly); a root started under a
  # starter (SEON_STARTER_FIFO: a test's or a check step's) takes only the config it is given
  L=${SEON_RUN_CHECKOUT:-$G}/config/local.edn
  [[ -z ${SEON_STARTER_FIFO:-} && -f $L ]] && set -- --config "$L" "$@"
  # HOME is redirected below, so an agent's git has no identity of its own: the owner's, read once
  O=$(perl -e 'print((getpwuid($<))[7])')
  N=$(HOME=$O git config --global user.name 2>/dev/null); E=$(HOME=$O git config --global user.email 2>/dev/null)
  [[ -n $N ]] && export GIT_AUTHOR_NAME=${GIT_AUTHOR_NAME:-$N} GIT_COMMITTER_NAME=${GIT_COMMITTER_NAME:-$N}
  [[ -n $E ]] && export GIT_AUTHOR_EMAIL=${GIT_AUTHOR_EMAIL:-$E} GIT_COMMITTER_EMAIL=${GIT_COMMITTER_EMAIL:-$E}
  cd "$G/target" && SEON_CHECKOUT=${SEON_RUN_CHECKOUT:-$G} HOME=$G/target/home JOLT_LMDB_LIB=$G/target/lib/liblmdb.dylib \
    JOLT_LZ4_LIB=$G/target/lib/liblz4.dylib JOLT_ZSTD_LIB=$G/target/lib/libzstd.dylib \
    SEON_SERVER_PORT=$P SEON_WEB_PORT=$W exec ./seon root "$@"
fi
if [[ ${1:-} == seed ]]; then
  # bin/root seed STORE: the program and the wiki of this tree on STORE's :db (seon.root/seed-program!), so a
  # root whose main is made from it imports nothing: a test store's, made by bin/test after it builds the binary
  cd "$ROOT/target" && SEON_CHECKOUT=$ROOT HOME=$ROOT/target/home JOLT_LMDB_LIB=$ROOT/target/lib/liblmdb.dylib \
    JOLT_LZ4_LIB=$ROOT/target/lib/liblz4.dylib JOLT_ZSTD_LIB=$ROOT/target/lib/libzstd.dylib exec ./seon seed-program "${@:2}"
fi
mkdir -p "$SEON_RUNS"
PIDS=$SEON_RUNS/root.pids LOG=$SEON_RUNS/root.log PORTF=$SEON_RUNS/root.port
READY=$SEON_RUNS/root.ready DONE=$SEON_RUNS/root.done
read PORT WEB <<< "$("$ROOT/bin/ports")"
running() { [[ -f $PIDS ]] && read T R < "$PIDS" && kill -0 $R 2>/dev/null }
# launch CHECKOUT [ARGS]: `run` detached (double fork), until its listening line or its death
launch() {
  # whether target/seon is main's program is root's boot's fact (:seon.root/source :binary beside :program,
  # seon.problems/stale-binary), not a tree read here at every start (0.3 s a root, every process test's); when they
  # differ the root prints ROOT STALE BINARY (the acts that bring them into agreement) before listening, and start's
  # last line is that line (docs/source.md#files-and-the-db-two-directions)
  : > "$LOG"
  rm -f "$PIDS" "$PORTF" "$READY" "$DONE"; mkfifo "$READY" "$DONE"
  # the one holder (bin/held, detached) owns the root's stdin and output and waits on it: it
  # copies the output to the log; at the root's ROOT LISTENING line it writes "HOLDER ROOT PORT"
  # (the port the root bound) on the ready fifo this shell is reading, and at the root's death
  # before that it closes the fifo (EOF): the root's own facts end the wait, never a poll. stop
  # sends it TERM: the root's stdin closes (it stops cleanly), and held writes its exit status
  # on the done fifo (made here, held keeps it open) that bin/held --end reads. A root started with SEON_STARTER_FIFO (a test's) ends with its
  # starter. (A `tail -f /dev/null | root` holder outlived every root that crashed or was killed.)
  "$ROOT/bin/held" --detach --drain --log "$LOG" --pids "$PIDS" --ready "$READY" --done "$DONE" \
    "$ROOT/bin/root" run "$1" "$PORT" "$WEB" "${@:2}"
  read -r T R P < "$READY"
  rm -f "$READY"
  if [[ -n ${P:-} ]]; then print $P > "$PORTF"; "$ROOT/bin/root" status
    # a binary of another program than main's: the root said so before listening, and start ends on it (its last line)
    s=$(grep -m1 '^ROOT STALE BINARY' "$LOG"); [[ -z $s ]] || print -r -- "$s"
  else print -u2 "root failed to start; its log:"; tail -20 "$LOG" >&2; exit 1; fi
}
# stop: TERM to the holder (the root's stdin closes, it stops cleanly), answered at the holder's end
# with the root's exit status. bin/held --end opens the done fifo before it signals and waits on it:
# a holder that is gone or died without writing ends the wait at once ("unknown"). A root held
# before the done fifo existed has no fifo: it is told to stop and nothing is awaited.
stop() {
  read T R < "$PIDS"
  if [[ -p $DONE ]]; then
    st=$("$ROOT/bin/held" --end TERM $T "$DONE" 1)
    rm -f "$PIDS" "$PORTF" "$DONE"; print "root $R stopped (exit ${st:-unknown: its holder ended without a status})"
  else
    kill -TERM $T 2>/dev/null
    rm -f "$PIDS" "$PORTF"; print "root $R told to stop (exit unknown: its holder predates the status channel)"
  fi
}
# kill: SIGKILL the root (a crash, as a test makes one); answered when it and everything it started
# is gone (bin/held's "drained"), where stop is answered at the root's exit
kill_root() {
  read T R < "$PIDS"
  if [[ -p $DONE ]]; then
    ends=("${(@f)$("$ROOT/bin/held" --end KILL $R "$DONE" 2)}")
    rm -f "$PIDS" "$PORTF" "$DONE"; print "root $R killed (${ends[2]:-not drained})"
  else
    kill -9 $R 2>/dev/null
    rm -f "$PIDS" "$PORTF"; print "root $R killed (not drained: its holder predates the status channel)"
  fi
}
case ${1:-start} in
  status)
    NET=$("$ROOT/bin/full-run")
    if running; then read T R < "$PIDS"; print "root $R up: server $(cat "$PORTF" 2>/dev/null || print $PORT), dashboard http://127.0.0.1:$WEB/"; print "$NET"
    else print "no root running for $ROOT (ports $PORT $WEB)"; print "$NET"; exit 1; fi ;;
  stop)
    running || { print "no root running"; exit 0 }
    stop ;;
  kill)
    running || { print "no root running"; exit 0 }
    kill_root ;;
  start)
    if [[ ${2:-} == --reindex ]]; then
      # the full outside-in: this checkout's store erased and a root started on it, so main seeds from the tree
      if running; then read T R < "$PIDS"; print -u2 "a root of this checkout is running (pid $R): bin/root stop first"; exit 1; fi
      S=${SEON_STORE:-$SEON_RUNS/store}
      rm -rf "$S" "$S-agents"; print "erased $S: the root seeds it from $SEON_SOURCE_ROOT"
      launch "$ROOT" "${@:3}"; exit $?
    fi
    if running; then "$0" status; exit 0; fi
    launch "$ROOT" "${@:2}"
    # the boot caught main up with this checkout (docs/source.md#a-boot-catches-up-with-its-checkout); when what changed reaches
    # the binary's own code or a build input (seon.root/binary-current, the ROOT STALE BINARY line after a ROOT CAUGHT UP one), it
    # is built and the root started again, once: a second stale line is reported (start's last line), never built again; a root
    # that caught up nothing (a test's: no catch-up) is never built here
    # built only when main's tree is this checkout's (a root on another source tree, a test's, is never built from this one)
    mt=$(sed -nE "s/^ROOT STALE BINARY binary [^,]*, main's tree ([0-9a-f]+).*/\1/p" "$LOG" | head -1)
    if grep -q '^ROOT CAUGHT UP ' "$LOG" && [[ -n $mt && $mt == $("$ROOT/bin/tree") ]]; then
      print "building target/seon: what changed reaches the binary (bin/build seon, $SEON_RUNS/root-build.log)"
      stop >/dev/null
      nice -n 15 "$ROOT/bin/build" seon > "$SEON_RUNS/root-build.log" 2>&1 || { print -u2 "bin/build seon failed: $SEON_RUNS/root-build.log"; exit 1 }
      launch "$ROOT" "${@:2}"
    fi ;;
  next)
    running || { print -u2 "no root running: next restarts a running root's next generation"; exit 1 }
    # its answer {:items [{:printed "[\"CHECKOUT\" \"--set\" ...]"}]}: the vector's strings, NUL-separated
    gen=("${(@0)$(print -r -- '{:op :eval :agent "root" :code "(my.root/next-generation sys)"}' | "$ROOT/bin/ask" $(cat "$PORTF") |
      perl -0777 -ne 'm/:printed "((?:[^"\\]|\\.)*)"/ or exit 1; my $v = $1; $v =~ s/\\(.)/$1/g;
        while ($v =~ /"((?:[^"\\]|\\.)*)"/g) { my $s = $1; $s =~ s/\\(.)/$1/g; print "$s\0" }')}")
    gen=(${gen:#})
    (( ${#gen} )) || { print -u2 "no next generation built on the running root's main (my.root/generation)"; exit 1 }
    stop
    launch "${gen[@]}" ;;
  *) print -u2 "usage: bin/root [start [--reindex] [ARGS]|stop|kill|status|next] | bin/root run CHECKOUT PORT WEB [ARGS]"; exit 2 ;;
esac
