#!/bin/zsh
# bin/root [start [ARGS]|stop|kill|status|next]   this checkout's standing root, on this checkout's own
# ports (bin/ports): its server (reached by bin/mcp, or `printf '{:op :agents}\n' | nc -w 5
# 127.0.0.1 PORT`) and its dashboard. `start` (the default) runs it detached: double-forked so it
# is re-parented to PID 1, because the tool host kills a background task's whole process tree
# when the task stops or its agent exits (ISOLATION, 2026-10-21). It runs until `bin/root stop`
# closes its stdin. ARGS go to the root (`--set :seon.config.source/root=\"DIR\"`, ...). Its
# output: runs/root.log; its pids: runs/root.pids ("TAIL ROOT"); the server port it was started
# bound (what bin/mcp relays to; the root's ROOT LISTENING line names it): runs/root.port, while
# it runs.
# `next` restarts the next generation (owner, 2026-10-21; docs/source.md#the-next-generation):
# it asks the running root for the generation main records (my.root/next-generation: the tree
# my.root/build! built from the last merges commit, and the arguments resuming this root's store
# and main), stops the root, and starts that tree's binary on them. A process never replaces
# itself: bin/root owns it. Only what cannot load in place needs a new binary (a pin, deps.edn,
# native code); a merge loads in place, and a restart catches up on main at boot.
# bin/root run CHECKOUT PORT WEB [ARGS]   one root of CHECKOUT's build in the foreground, until
# stdin closes (what `start` and `next` run).
#
# It runs on the one kept store, <SEON_RUNS>/store (<this tree>/runs/store), and resumes its
# main (:seon.config.root/main, "main"; SEON_MAIN=<branch> names another) at every boot, its
# agents' and tasks' branches named under it: a run's record is main's commit history.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/bin/env"
export SEON_RUNS=${SEON_RUNS:-$ROOT/runs}
# a root started here builds main from this checkout's source when its store is new (and follows it
# after): :seon.config.source/root's default; config/local.edn or --set names another tree
export SEON_SOURCE_ROOT=${SEON_SOURCE_ROOT:-$ROOT}
if [[ ${1:-} == run ]]; then
  # the tree's own build, config and caches (bin/env, read from that tree); the ports over the
  # config's (local.edn honours these)
  G=$2; P=$3; W=$4; shift 4
  # SEON_RUN_CHECKOUT: the tree a root reads its checkout's files from (docs, config) when it is
  # not the build's own (a test's: seon.test-store/start-root!)
  cd "$G/target" && SEON_CHECKOUT=${SEON_RUN_CHECKOUT:-$G} HOME=$G/target/home JOLT_LMDB_LIB=$G/target/lib/liblmdb.dylib \
    JOLT_LZ4_LIB=$G/target/lib/liblz4.dylib JOLT_ZSTD_LIB=$G/target/lib/libzstd.dylib \
    SEON_ENTRANCE_PORT=$P SEON_WEB_PORT=$W exec ./seon root "$@"
fi
mkdir -p "$SEON_RUNS"
PIDS=$SEON_RUNS/root.pids LOG=$SEON_RUNS/root.log PORTF=$SEON_RUNS/root.port
READY=$SEON_RUNS/root.ready DONE=$SEON_RUNS/root.done
read PORT WEB <<< "$("$ROOT/bin/ports")"
running() { [[ -f $PIDS ]] && read T R < "$PIDS" && kill -0 $R 2>/dev/null }
# launch CHECKOUT [ARGS]: `run` detached (double fork), until its listening line or its death
launch() {
  : > "$LOG"
  rm -f "$PIDS" "$PORTF" "$READY"; mkfifo "$READY"
  # the holder (perl, below) owns the root's stdin and its output, and waits on the root. It
  # copies the root's output to the log line by line; at the root's ROOT LISTENING line it writes
  # "HOLDER ROOT PORT" (the port the root bound) on the ready fifo this shell is reading, and at
  # the root's death before that it closes the fifo (EOF): the root's own facts end the wait,
  # never a poll. stop sends it TERM: it closes the root's stdin (the root stops cleanly), reaps
  # it, and writes its exit status on the done fifo stop reads. A root that dies any other way
  # ends the holder with it (a `tail -f /dev/null | root` holder outlived every root that
  # crashed or was killed: its shell waited on a tail that never ends)
  perl -MPOSIX -MIO::Handle -e 'exit 0 if fork; POSIX::setsid(); exit 0 if fork;
    open STDIN,"<","/dev/null";
    my ($log, $pids, $ready, $done, @cmd) = @ARGV;
    open my $l, ">>", $log or die "log: $!"; $l->autoflush(1);
    open STDOUT, ">&", $l; open STDERR, ">&", $l;
    open my $r, ">", $ready or die "ready: $!"; $r->autoflush(1);
    pipe(my $in_r, my $in_w) or die "pipe: $!"; pipe(my $out_r, my $out_w) or die "pipe: $!";
    my $root = fork // die "fork: $!";
    if ($root == 0) { close $in_w; close $out_r; open STDIN, "<&", $in_r or die;
      open STDOUT, ">&", $out_w or die; open STDERR, ">&", $out_w or die; exec @cmd; die "exec: $!" }
    close $in_r; close $out_w;
    open my $f, ">", $pids or die; print $f "$$ $root\n"; close $f;
    $SIG{TERM} = sub { close $in_w };
    while (my $line = <$out_r>) {
      print $l $line;
      if ($r && $line =~ /^ROOT LISTENING (\d+)/) { print $r "$$ $root $1\n"; close $r; undef $r }
    }
    close $r if $r;
    waitpid($root, 0); my $st = $? >> 8;
    if (sysopen(my $d, $done, O_WRONLY|O_NONBLOCK)) { print $d "$st\n"; close $d }
    exit 0' "$LOG" "$PIDS" "$READY" "$DONE" "$ROOT/bin/root" run "$1" "$PORT" "$WEB" "${@:2}"
  read -r T R P < "$READY"
  rm -f "$READY"
  if [[ -n ${P:-} ]]; then print $P > "$PORTF"; "$ROOT/bin/root" status
  else print -u2 "root failed to start; its log:"; tail -20 "$LOG" >&2; exit 1; fi
}
stop() {
  read T R < "$PIDS"
  # the done fifo held open read-write before the holder is told: its write never waits on a
  # reader, and this read ends at the root's exit, which the holder reaped
  rm -f "$DONE"; mkfifo "$DONE"; exec 3<>"$DONE"
  kill -TERM $T                              # the holder: the root's stdin closes, it stops cleanly
  read -r -u 3 st; exec 3<&-
  rm -f "$PIDS" "$PORTF" "$DONE"; print "root $R stopped (exit $st)"
}
# kill: SIGKILL the root (a crash, as a test makes one); answered at its death, as stop is
kill_root() {
  read T R < "$PIDS"
  rm -f "$DONE"; mkfifo "$DONE"; exec 3<>"$DONE"
  kill -9 $R
  read -r -u 3 st; exec 3<&-
  rm -f "$PIDS" "$PORTF" "$DONE"; print "root $R killed"
}
case ${1:-start} in
  status)
    if running; then read T R < "$PIDS"; print "root $R up: server $(cat "$PORTF" 2>/dev/null || print $PORT), dashboard http://127.0.0.1:$WEB/"
    else print "no root running for $ROOT (ports $PORT $WEB)"; exit 1; fi ;;
  stop)
    running || { print "no root running"; exit 0 }
    stop ;;
  kill)
    running || { print "no root running"; exit 0 }
    kill_root ;;
  start)
    if running; then "$0" status; exit 0; fi
    launch "$ROOT" "${@:2}" ;;
  next)
    running || { print -u2 "no root running: next restarts a running root's next generation"; exit 1 }
    # its answer {:items [{:printed "[\"CHECKOUT\" \"--set\" ...]"}]}: the vector's strings, NUL-separated
    gen=("${(@0)$(print -r -- '{:op :eval :agent "root" :code "(my.root/next-generation sys)"}' | nc -w 30 127.0.0.1 $(cat "$PORTF") |
      perl -0777 -ne 'm/:printed "((?:[^"\\]|\\.)*)"/ or exit 1; my $v = $1; $v =~ s/\\(.)/$1/g;
        while ($v =~ /"((?:[^"\\]|\\.)*)"/g) { my $s = $1; $s =~ s/\\(.)/$1/g; print "$s\0" }')}")
    gen=(${gen:#})
    (( ${#gen} )) || { print -u2 "no next generation built on the running root's main (my.root/generation)"; exit 1 }
    stop
    launch "${gen[@]}" ;;
  *) print -u2 "usage: bin/root [start [ARGS]|stop|kill|status|next] | bin/root run CHECKOUT PORT WEB [ARGS]"; exit 2 ;;
esac
