#!/usr/bin/env bash
# bin/plan-state — regenerate docs/prds/sci-execution-runtime/plan/state.md
# from the LIVE tree.
#
# Why this is a script and not a prose document: a hand-written state snapshot
# is wrong within a day. This session watched it happen repeatedly — six of six
# assumptions falsified in one sitting, four of six defects in one plan row
# already fixed at HEAD, `file:line` anchors dead within 24 hours because the
# plan's own work moved them. So the state document is GENERATED, every line
# carries the command that produced it, and any agent can re-run this to find
# out what is true right now instead of trusting what was true yesterday.
#
#   bin/plan-state          # write plan/state.md
#   bin/plan-state --stdout # print instead, to diff against the committed copy
#
# Each check prints a VERDICT line. A check whose grep returns nothing is not
# silently skipped — absence is itself a fact and is reported as one.

set -uo pipefail
cd "$(dirname "$0")/.."

OUT=docs/prds/sci-execution-runtime/plan/state.md
[ "${1:-}" = "--stdout" ] && OUT=/dev/stdout

# count matches without tripping `set -e` on an empty result
n() { rg -c "$@" 2>/dev/null | awk -F: '{s+=$NF} END {print s+0}'; }
files() { rg -l "$@" 2>/dev/null | wc -l | tr -d ' '; }
lines() { [ -f "$1" ] && wc -l < "$1" | tr -d ' ' || echo 0; }

REV=$(git rev-parse --short HEAD)
BRANCH=$(git rev-parse --abbrev-ref HEAD)

{
cat <<HEADER
---
type: prd
status: active
tags: [prd, agent, architecture]
---

# Current state — generated, not written

**Do not edit this file.** Regenerate it: \`bin/plan-state\`. Every row below is
produced by the command shown, against the working tree — so a stale row is
impossible and an agent can re-verify any claim in one line.

Generated from \`$BRANCH\` at \`$REV\`, measuring the **working tree** — so a
lane with uncommitted work shows up here. Rows that can differ between committed
and working state say both. \`git status --short\` before trusting a surprising row.

Read [README.md](README.md) for what to do and [unsettled.md](unsettled.md) for
what is undecided. This file is only what is TRUE right now.

## 1. What an agent can actually do

This is the first thing to check, because every demo and every proof flows
through it.

\`\`\`
rg -A14 ':namespaces' src/seon/sci/ctx.clj
\`\`\`

HEADER

echo '```clojure'
sed -n '/:namespaces/,/:classes/p' src/seon/sci/ctx.clj 2>/dev/null
echo '```'
echo

# Bindings are COMPUTED from program facts (L17), so a literal my.* string in
# ctx.clj is a DEFECT (a hand list returned), not evidence of capability. The
# real questions: does the computed table exist, and are the effect family
# arms implemented or honest not-implemented stubs?
LITERAL=$(n 'my\.fs|my\.web|my\.db|my\.shell|my\.blob' src/seon/sci/ctx.clj)
COMPUTED=$(n 'tool-namespaces' src/seon/sci/ctx.clj)
STUBS=$(n 'not-implemented' src/seon/effect.cljc)
if [ "$LITERAL" != "0" ]; then
  echo "**VERDICT: L17 REGRESSION — $LITERAL literal my.* binding(s) in ctx.clj.**"
  echo "The binding table must be computed from program facts, never listed."
elif [ "$COMPUTED" = "0" ]; then
  echo "**VERDICT: an agent cannot act.** No computed binding table in ctx.clj"
  echo '(`rg -c tool-namespaces src/seon/sci/ctx.clj` → 0).'
elif [ "$STUBS" != "0" ]; then
  echo "**VERDICT: bindings are computed, but $STUBS effect arm(s) are honest"
  echo "not-implemented stubs** (\`rg -c not-implemented src/seon/effect.cljc\`)."
  echo "An agent can call the tools and receives error values; it cannot yet act"
  echo "on the world."
else
  echo "**VERDICT: computed bindings with zero not-implemented stubs.** Verify with"
  echo "the step-1 live falsifier before claiming the door is done."
fi
echo

cat <<'S2'
## 2. The live execution path

```
wc -l src/seon/agent/driver.clj src/seon/sci/*.clj src/seon/host.clj
```

S2
echo '```'
wc -l src/seon/agent/driver.clj src/seon/sci/interrupt.clj src/seon/sci/ctx.clj \
      src/seon/sci/eval.clj src/seon/host.clj 2>/dev/null
echo '```'
echo

GUARD=$([ -f src/seon/host/guard.cljc ] && echo present || echo gone)
echo "**Containment mechanisms:** \`seon.sci.interrupt\` present;"
echo "\`src/seon/host/guard.cljc\` **$GUARD**"
echo "(two interrupt mechanisms coexisted until \`8dc8623ad\`)."
echo

cat <<'S3'
## 3. Is the wire on the agent path?

O1 rules that agent evals are co-located with the database: a read is a pointer
into an immutable value, a write is a function call. Check whether that is true
yet.

```
rg -n 'open-session!|writer-socket-path' src/seon/db/host.clj | head -4
```

S3
echo '```'
rg -n 'uds/open-session!|writer-socket-path' src/seon/db/host.clj 2>/dev/null | head -4
echo '```'
echo
WIRE=$(n 'uds/open-session!' src/seon/db/host.clj)
if [ "$WIRE" != "0" ]; then
  echo "**VERDICT: the wire is still on the agent path.** \`writer-session\` opens a"
  echo "UDS session to a separate \`writer\` process, so every agent read and write"
  echo "crosses a socket. O1 co-location is the target, not the state."
else
  echo "**VERDICT: no UDS session in the writer path** — co-location may have landed."
  echo "Confirm by checking that the writer and host are one process."
fi
echo

cat <<'S4'
## 4. Processes and the pod

```
rg -n 'def all-process-ids' -A2 script/seon/dev/process.clj
find src -name '*.cljs' | wc -l ; find src -name '*.cljs' | xargs wc -l | tail -1
```

S4
echo '```'
rg -n 'all-process-ids' -A 2 script/seon/dev/process.clj 2>/dev/null | head -4
echo "cljs files: $(find src -name '*.cljs' | wc -l | tr -d ' ')"
find src -name '*.cljs' -print0 2>/dev/null | xargs -0 wc -l 2>/dev/null | tail -1
echo '```'
echo

cat <<'S5'
## 5. Where work is bounded, and where it is not

Backpressure is one idea with four different expressions. This is the table that
decides whether the scheduling design is needed.

S5
printf '| submission point | bound | evidence |\n|---|---|---|\n'
SEM=$(n 'Semaphore' src/seon/sci/eval.clj)
printf '| SCI eval | %s | `rg -c Semaphore src/seon/sci/eval.clj` → %s |\n' \
  "$([ "$SEM" != "0" ] && echo 'YES — semaphore' || echo 'NO')" "$SEM"
QSC=$(git grep -c -E 'transaction-queue-size|commit-queue-size|commit-wait-time' HEAD -- src config script 2>/dev/null | awk -F: '{s+=$NF} END {print s+0}')
QSW=$(n 'transaction-queue-size|commit-queue-size|commit-wait-time' src/ config/ script/)
printf '| transactions (Datahike side) | ALWAYS bounded | `create-writer :self` builds `transaction-queue` + `commit-queue`; defaults `DEFAULT_QUEUE_SIZE` / `DEFAULT_COMMIT_WAIT_TIME 0` |\n'
printf '| transactions (Seon supplies values?) | %s | committed: %s hits · working tree: %s hits |\n' \
  "$([ "$QSC" != "0" ] && echo 'YES' || echo 'NO — Datahike defaults')" "$QSC" "$QSW"
RA=$(n 'start-virtual-thread!' src/seon/agent/driver.clj)
printf '| run admission | %s | `rg -c "start-virtual-thread!" src/seon/agent/driver.clj` → %s call sites, none behind a permit |\n' \
  "$([ "$RA" != "0" ] && echo 'NO — unbounded spawn' || echo 'no spawn site found — re-read')" "$RA"
CB=$(n 'Semaphore' src/seon/db/host.clj src/seon/ai/http.clj)
printf '| agent capability calls | %s | `rg -c Semaphore src/seon/db/host.clj src/seon/ai/http.clj` → %s |\n' \
  "$([ "$CB" != "0" ] && echo 'YES' || echo 'NO')" "$CB"
echo

cat <<'S6'
## 6. The corpus round trip

Three independent things must hold for an agent's `defn` to survive: it is
written as facts, it is installed at boot, and form 2 of a reply can see form 1.

S6
TEE=$(n 'tee-tx-data' src/)
INST=$(n 'install-nursery!|rebuild!' src/)
BASECTX=$(n '::sci\.eval/base-ctx|::base-ctx' src/seon/agent/driver.clj)
printf '| property | state | evidence |\n|---|---|---|\n'
printf '| authored fn written as facts | %s | `rg -c tee-tx-data src/` → %s |\n' \
  "$([ "$TEE" != "0" ] && echo BUILT || echo '**MISSING**')" "$TEE"
printf '| corpus installed at boot | %s | `rg -c "install-nursery!|rebuild!" src/` → %s |\n' \
  "$([ "$INST" != "0" ] && echo BUILT || echo '**MISSING**')" "$INST"
printf '| form 1 visible to form 2 | %s | driver passes a base ctx → %s hits |\n' \
  "$([ "$BASECTX" != "0" ] && echo BUILT || echo '**MISSING**')" "$BASECTX"
TIER=$(n 'seon\.fn/execution-tier' src/)
printf '| `:seon.fn/execution-tier` kind stamp | %s | `rg -c` → %s |\n' \
  "$([ "$TIER" != "0" ] && echo 'still present' || echo 'gone (R-19a satisfied)')" "$TIER"
echo

cat <<'S7'
## 7. The index producer

O15: index at compile time from a JVM build only; never at runtime.

S7
SHADOW=$(n 'shadow\.build/stage' script/seon/dev/program_artifact.clj)
DERIVE=$(n 'derive-initialization-pages' src/seon/db/protocol.cljc)
PROD=$(rg -l 'db\.program/compile-tx-data|program/compile-tx-data' src/ script/ 2>/dev/null | wc -l | tr -d ' ')
printf '| fact | value | meaning |\n|---|---|---|\n'
printf '| shadow-cljs build hooks | %s | the CLJS-only compile-time indexer; dies with the pod |\n' "$SHADOW"
printf '| runtime derive branch | %s | O16 deletes this; missing pages must fail loudly |\n' "$DERIVE"
printf '| production callers of `compile-tx-data` | %s | 0 = the reconciler is orphaned |\n' "$PROD"
echo

cat <<'S8'
## 8. Can the machine prove anything?

The JVM gate needs the compiled program artifact, so it reports zero tests until
a `bin/seon up` / `bin/seon down` freeze rebuilds it. A full `bin/test-writer`
run tees its own retained evidence to `tmp/plan-evidence/test-writer-latest.log`;
dated copies in the same directory are archives.

S8
# The gate writes its own retained evidence: a FULL bin/test-writer run tees to
# test-writer-latest.log. Ad-hoc dated names are archives, never the selection
# source — name-pattern selection once reported a stale red after the green
# run landed under a different prefix.
LOG=tmp/plan-evidence/test-writer-latest.log
if [ ! -f "$LOG" ]; then
  LOG=$(ls -t tmp/plan-evidence/test-writer-*.log 2>/dev/null | head -1)
  STALE_SELECTION=1
fi
if [ -n "$LOG" ] && [ -f "$LOG" ]; then
  if [ "${STALE_SELECTION:-0}" = "1" ]; then
    echo "**WARNING: no canonical \`test-writer-latest.log\` yet** — falling back to"
    echo "newest name-matched log, which missed the true latest run once before."
    echo "Run the full \`bin/test-writer\` to establish the canonical log."
    echo
  fi
  RAN=$(rg --no-filename -o 'Ran [0-9]+ tests containing [0-9]+ assertions\.' "$LOG" 2>/dev/null | tail -1)
  RES=$(rg --no-filename -o '[0-9]+ failures, [0-9]+ errors\.' "$LOG" 2>/dev/null | tail -1)
  echo "Last retained run — \`$LOG\` ($(date -r "$LOG" +%Y-%m-%d 2>/dev/null)):"
  echo
  echo '```'
  echo "${RAN:-<no summary line>}"
  echo "${RES:-<no result line>}"
  echo '```'
  echo
  FAILED=$(rg --no-filename -o '(FAIL|ERROR) in \(([a-z0-9!?*<>=-]+)\)' -r '$1 $2' "$LOG" 2>/dev/null | sort -u)
  if [ -z "$RES" ]; then
    echo "**INCOMPLETE — do not read this as green.** The log has no"
    echo "\`N failures, N errors.\` line, so the run did not finish (still writing,"
    echo "killed, or crashed before the summary). Absence of \`FAIL in\` lines in an"
    echo "unfinished log proves nothing."
  elif [ "$RES" = "0 failures, 0 errors." ]; then
    echo "**Green** — the run completed and reported zero failures and zero errors."
  elif [ -n "$FAILED" ]; then
    echo "**Not green. Every failing test, named:**"
    echo
    echo "$FAILED" | sed 's/^/- `/; s/$/`/'
    echo
    echo "An unnamed failure count is worse than no gate — it launders red into a"
    echo "number. Each of these is either a real defect or a test pinning a deleted"
    echo "path; decide which and act, never re-baseline the count."
  else
    echo "**NOT GREEN, and the failing tests are not named in the log.**"
    echo "\`$RES\` — but no \`FAIL in\` / \`ERROR in\` line was captured, which usually"
    echo "means the output was truncated (a \`| tail\` will do it). Re-run redirecting"
    echo "the WHOLE log, not a tail."
  fi
else
  echo "**No retained run.** \`tmp/plan-evidence/\` is empty, so nothing has verified"
  echo "the JVM. Run the freeze, then the command above."
fi
echo
echo "Test source inventory (what exists, not what passes):"
echo '```'
echo "test files:           $(find test -name '*_test.clj*' 2>/dev/null | wc -l | tr -d ' ')"
echo "deftest (clj/cljc):   $(n 'deftest' test/ --glob '*.clj' --glob '*.cljc')"
echo "deftest (cljs):       $(n 'deftest' test/ --glob '*.cljs')"
echo '```'
echo

cat <<'S9'
## 9. Open blockers

S9
echo '```'
echo "open issues:    $(rg -l '^status: open' docs/seon/issues/*.md 2>/dev/null | wc -l | tr -d ' ')"
echo "blockers:       $(rg -l 'severity: blocker' docs/seon/issues/*.md 2>/dev/null | wc -l | tr -d ' ')"
echo '```'
echo
echo "Filed 2026-07-26 and not yet owned end to end by a step:"
echo
for f in run-is-unrecoverable-before-its-plan-commits \
         agent-messages-never-wake-the-jvm-driver \
         lazy-authored-values-escape-the-armed-interrupt-boundary \
         http-kit-streaming-writes-have-an-unbounded-socket-queue; do
  [ -f "docs/seon/issues/$f.md" ] && \
    echo "- [$f](../../../seon/issues/$f.md) — $(rg -m1 '^# ' "docs/seon/issues/$f.md" | sed 's/^# //')"
done
echo

cat <<'S10'
## 10. Dangling attribute references

An attribute read or written with no `schema/register!` anywhere. Each is a real
defect: the read returns nil and any sort over it is meaningless.

S10
echo '```'
for a in 'seon\.ai\.attempt' 'seon\.agent\.turn'; do
  used=$(rg -o ":$a/[a-z?-]+" src/ 2>/dev/null | sed 's/.*://' | sort -u | wc -l | tr -d ' ')
  reg=$(n "schema/register! :$a/" src/)
  echo ":$a/*  distinct used: $used   registered: $reg"
done
echo '```'
echo

cat <<'S11'
## 11. The agent entity

The owner's model: "The agent is just attributes and values in an entity with
lookups and refs to other things it cares about like it's context." Verified.

S11
echo '```'
echo "registered :seon.agent/* attributes:"
rg --no-filename -o 'schema/register! :seon\.agent/[a-z?-]+' src/ 2>/dev/null | sed 's/.*register! //' | sort -u | sed 's/^/  /'
echo
echo "registered in:"
rg -l 'schema/register! :seon\.agent/' src/ 2>/dev/null | sed 's/^/  /'
echo '```'
echo
DUP=$(rg --no-filename -o 'schema/register! (:seon\.agent/[a-z?-]+)' -r '$1' src/ 2>/dev/null | sort | uniq -d | tr '\n' ' ')
if [ -n "$DUP" ]; then
  echo "**Duplicate registrations:** \`$DUP\` — one attribute registered in two"
  echo "places. Check whether both agree, and note that a registration living in a"
  echo "\`.cljs\` file dies with the pod cut."
else
  echo "**No duplicate \`:seon.agent/*\` registrations.**"
fi
CLJSREG=$(rg -l 'schema/register! :seon\.agent/' src/ --glob '*.cljs' 2>/dev/null | wc -l | tr -d ' ')
echo
echo "\`.cljs\` files registering agent attributes: **$CLJSREG**. Every one is on the"
echo "pod deletion list, so the agent's own schema must move to a surviving owner"
echo "before that cut."
echo

cat <<'S12'
## 12. Surfaces and mechanisms not yet in place

S12
printf '| question | answer | evidence |\n|---|---|---|\n'

WR=$(rg --no-filename -o '\[:get "[^"]+"\]' src/seon/web/server.clj 2>/dev/null | tr '\n' ' ')
POD=$(n 'router/install!' src/seon/web/serve.cljs)
printf '| who serves the web UI? | web-render JVM serves only: %s · the pod serves the rest | `rg %s src/seon/web/server.clj`; pod router install sites → %s |\n' \
  "${WR:-none}" "'\[:get'" "$POD"

CAS=$(n 'datahike-server|:datahike-server' src/seon/db/ 2>/dev/null)
REFUSE=$(n 'refuse|already has a live write|second writer' src/seon/db/registry.clj 2>/dev/null)
printf '| does an unsafe two-writer configuration refuse to open? | %s | `rg -c "refuse" src/seon/db/registry.clj` → %s (O2 still unruled) |\n' \
  "$([ "$REFUSE" != "0" ] && echo 'some refusal exists — read it' || echo '**NO**')" "$REFUSE"

DISP=$(n 'core\.async|executor-for|dispatch/exec' src/seon/sci/eval.clj src/seon/agent/driver.clj 2>/dev/null)
CACHED=$(n 'newCachedThreadPool|newFixedThreadPool' src/seon/sci/eval.clj 2>/dev/null)
printf '| does agent scheduling use core.async dispatch? | %s | core.async refs → %s; hand-rolled pools → %s |\n' \
  "$([ "$DISP" != "0" ] && echo 'partly' || echo '**NO — hand-rolled**')" "$DISP" "$CACHED"

WL=$(n 'seon\.fn/workload|:seon\.capability/workload' src/ 2>/dev/null)
printf '| is workload a fact yet? | %s | `rg -c ":seon.fn/workload"` → %s |\n' \
  "$([ "$WL" != "0" ] && echo yes || echo '**NO — designed, not built**')" "$WL"

RC=$(n '#\?\(' src/ --glob '*.cljc' 2>/dev/null)
printf '| reader conditionals in `.cljc` | %s | `rg -c "#\?\(" src/ --glob "*.cljc"`; the pod cut is projected to retire most |\n' "$RC"

IG=$(n 'integrant' deps.edn 2>/dev/null)
printf '| is Integrant a dependency? | %s | `rg -c integrant deps.edn` → %s (adoption is conditional, `bd8038419`) |\n' \
  "$([ "$IG" != "0" ] && echo yes || echo 'no')" "$IG"
echo

cat <<'FOOTER'
## How to trust this file

Re-run `bin/plan-state` and diff. If a row changed, the tree changed and the
plan may be stale — that is the point. If a row disagrees with
[README.md](README.md), **this file wins** and the README needs correcting.

The history of what was tried, with commit hashes, is in
[history.md](history.md).
FOOTER
} > "$OUT"

[ "$OUT" != /dev/stdout ] && echo "wrote $OUT ($(wc -l < "$OUT" | tr -d ' ') lines)"
