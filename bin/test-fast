#!/usr/bin/env bash
# Iterate: bin/test-fast <namespace...>
# --paths FILE... -- NS... reuses bin/test’s HEAD-plus-paths snapshot.
# Plain NS... runs in the working tree; no operator root or published
# base preparation. Uses the worker's exact program loading and contract arm.
# Canonical database fixtures build their in-memory base once per JVM. Tests
# explicitly exercising file-backed boot still own their fixture publication.
# Limits: no per-worker isolation, retained run roots, or automatic platform
# tier; no persisted result facts or green basis. Gate a commit with
# bin/test --paths <files...> -- <namespaces...>; --platform before reporting.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "${1-}" = --paths ]; then
  exec bin/test --fast "$@"
fi
source bin/_java-home-resolver
if [ "$#" -eq 0 ]; then
  echo 'Usage: bin/test-fast [--paths FILE... --] <namespace...>' >&2
  exit 64
fi
for namespace in "$@"; do
  case "$namespace" in
    -*) echo "bin/test-fast: expected a namespace, got $namespace" >&2; exit 64 ;;
  esac
done
exec clojure -M:test -m seon.test.fast "$@"
