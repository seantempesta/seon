#!/usr/bin/env bash
# Iterate: bin/test-fast <namespace...>
# --paths FILE... -- NS... reuses bin/test’s HEAD-plus-paths snapshot.
# Plain NS... runs in the working tree; no operator root or published
# base preparation. Uses the worker's exact program loading and contract arm.
# Canonical database fixtures branch the exported publication. Tests
# explicitly exercising file-backed boot still own their fixture publication.
# Limits: no per-worker isolation, retained run roots, or automatic platform
# tier. Results use the cold gate's recording authority. The orchestrator gates a
# commit with bin/test --paths <files...> -- <namespaces...> and --platform.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "${1-}" = --paths ]; then
  exec bin/test --fast "$@"
fi
if [ "$#" -eq 0 ]; then
  echo 'Usage: bin/test-fast [--paths FILE... --] <namespace...>' >&2
  exit 64
fi
for namespace in "$@"; do
  case "$namespace" in
    -*) echo "bin/test-fast: expected a namespace, got $namespace" >&2; exit 64 ;;
  esac
done
source bin/_test-slot
source bin/_java-home-resolver
if ! acquire_test_slot; then
  exit 75
fi
suite_pid=
stop_fast_runner() {
  trap - EXIT HUP INT TERM
  if [ -n "$suite_pid" ] && kill -0 "$suite_pid" 2>/dev/null; then
    kill -TERM "$suite_pid" 2>/dev/null || true
    wait "$suite_pid" 2>/dev/null || true
  fi
  release_test_slot
}
trap stop_fast_runner EXIT HUP INT TERM
published_base=$(bb -e '(require (quote [seon.test.cache :as cache])) (let [base (binding [*out* *err*] (cache/newest-base "." "HEAD"))] (println (:seon.test.cache/base base)))')
nice -n 15 clojure "-J-Dseon.test.source-root=$PWD" \
  "-J-Dseon.test.published-base=$published_base" \
  "-J-Dseon.test.git-sha=$(git rev-parse HEAD)" -M:test -m seon.test.fast "$@" &
suite_pid=$!
if wait "$suite_pid"; then status=0; else status=$?; fi
suite_pid=
stop_fast_runner
exit "$status"
