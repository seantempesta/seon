#!/usr/bin/env bb
;; bin/issues-index — regenerate docs/seon/orchestrator/issues/index.md
;;
;; The index is a DERIVED projection (Seon "derive don't store"): it scans the
;; frontmatter of the OPEN issues (top-level issues/*.md, excluding README/index
;; and the archive/ subdir) and rewrites index.md. Never hand-edit index.md —
;; edit an issue's frontmatter and re-run this script.
;;
;;   bin/issues-index

(require '[clojure.string :as str]
         '[babashka.fs :as fs])

(def issues-dir
  (str (fs/file (fs/parent (fs/parent *file*))
                "docs" "seon" "orchestrator" "issues")))

(def sev-order ["blocker" "friction" "cleanup"])

;; tag -> lane label, in priority order (first matching tag wins)
(def lane-rules
  [["web" "UI"]
   ["agent" "agent"]
   ["flow" "Core"]
   ["database" "Core"]
   ["schema" "Core"]
   ["reference" "docs"]
   ["component" "docs"]])

(defn front-matter [content]
  (let [lines (str/split-lines content)]
    (when (= "---" (first lines))
      (let [end (->> (map-indexed vector (rest lines))
                     (some (fn [[i l]] (when (= "---" l) i))))]
        (->> (take end (rest lines))
             (keep (fn [l]
                     (when-let [[_ k v] (re-matches #"([^:]+):\s*(.*)" l)]
                       [(str/trim k) (str/trim v)])))
             (into {}))))))

(defn parse-tags [s]
  (-> (or s "") (str/replace #"[\[\]]" "")
      (str/split #",") (->> (map str/trim) (remove str/blank?))))

(defn lane [tags]
  (let [tagset (set tags)]
    (or (some (fn [[t label]] (when (tagset t) label)) lane-rules)
        "general")))

(defn h1-title [content fname]
  (or (some->> (str/split-lines content)
               (some (fn [l] (when (str/starts-with? l "# ") (subs l 2))))
               str/trim)
      fname))

(def issues
  (->> (fs/glob issues-dir "*.md")
       (map str)
       (remove #(#{"README.md" "index.md"} (fs/file-name %)))
       (map (fn [path]
              (let [content (slurp path)
                    fm (front-matter content)
                    fname (fs/file-name path)]
                {:file fname
                 :status (get fm "status")
                 :severity (get fm "severity" "cleanup")
                 :lane (lane (parse-tags (get fm "tags")))
                 :title (h1-title content fname)})))
       (filter #(= "open" (:status %)))
       (sort-by :title)))

(defn render []
  (let [by-sev (group-by :severity issues)]
    (str
     "---\n"
     "type: orchestrator\n"
     "status: active\n"
     "tags: [orchestrator, issue, index]\n"
     "---\n\n"
     "# Open Issues — Index\n\n"
     "GENERATED FILE — do not hand-edit. Regenerate with `bin/issues-index`.\n"
     "Lifecycle `open → resolved | superseded`; closed issues live in `archive/`.\n"
     "See `README.md` for the convention.\n\n"
     (str/join "\n"
       (for [sev sev-order
             :let [rows (sort-by :title (get by-sev sev))]
             :when (seq rows)]
         (str "## " (str/capitalize sev) " (" (count rows) ")\n\n"
              "| Issue | Severity | Lane |\n"
              "|-------|----------|------|\n"
              (str/join "\n"
                (for [{:keys [title severity lane file]} rows]
                  (str "| [" title "](" file ") | " severity " | " lane " |")))
              "\n"))))))

(let [out (str (fs/file issues-dir "index.md"))]
  (spit out (render))
  (println "Wrote" out)
  (println (count issues) "open issues indexed"))
