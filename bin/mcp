#!/bin/zsh
# bin/mcp call [--port PORT] OP [KEY=VALUE ...]   one tool call from a shell, through this checkout's relay and root (PORT's
# root with --port: a check step's own, seon.check/agent-checks),
# printing the tool's text (seon_<OP>; exit 1 on an error from the relay or the server). VALUE - reads
# stdin (code=- <<'EOF'), true/false and [...] are JSON; eval's intent= and code= on an agent are a reply of that one eval. Its client is this checkout, so the agent one call
# attaches answers the next: what a helper in a worktree uses, since the seon MCP tools of a Claude session
# are the relay of the checkout the session started in, not the helper's (docs/server.md#working-a-task-from-a-worktree).
# bin/mcp [PORT]   the MCP server (stdio JSON-RPC) for outside agents: a relay of each line to the
# root's server on 127.0.0.1:PORT, which answers MCP itself (seon.server/mcp-reply). Without
# PORT, the port this checkout's root bound: runs/root.port, which bin/system writes from the root's
# ROOT LISTENING line while it runs, read at each message, so a root restarted on
# another port is followed. Tools: seon_agents, seon_eval (an agent's own REPL, recorded
# :outside; or "root"), seon_context, seon_attach, seon_done, seon_prove (every op of
# seon.server/ops is a tool seon_<op>; seon.check/mcp-proof compares them).
#
# Stock perl, no Seon binary (a `seon mcp` per client was 722 MB each; this is about 6 MB, and
# seon.check/mcp-proof fails past :seon.config.machine/relay-mb). One connection per message, so
# a root restarted between calls (bin/system next) costs the session nothing. A message with an id
# that root does not answer (none running, not listening, it died mid-request) is answered the
# JSON-RPC error saying why: the client never hangs on it. A line that is not JSON is relayed as
# it is, and root answers its defect (docs/failure-points.md).
ROOT=$(cd "$(dirname "$0")/.." && pwd)
if [[ ${1:-} == call ]]; then
  shift
  PORT=; [[ ${1:-} == --port ]] && { PORT=$2; shift 2 }
  exec perl -MJSON::PP -MEncode -e '
    my ($mcp, $port, $root, $op, @kv) = @ARGV; @kv = map { decode_utf8($_) } @kv; my %a;
    die "usage: bin/mcp call OP [KEY=VALUE ...]\n" unless defined $op;
    for (@kv) {
      my ($k, $v) = /\A([^=]+)=(.*)\z/s or die "bin/mcp call: $_ is not KEY=VALUE\n";
      if ($v eq "-") { local $/; $v = decode_utf8(scalar <STDIN>) }
      elsif ($k ne "code" && ($v =~ /\A(true|false)\z/ || $v =~ /\A\[/)) { $v = JSON::PP->new->allow_nonref->decode($v) }
      $a{$k} = $v }
    # a reply of one eval, from a shell: its intent and code as keys of their own (root takes plain code)
    if ($op eq "eval" && ($a{agent} // "") ne "root" && exists $a{code}) { $a{evals} = [{intent => delete($a{intent}) // "", code => delete $a{code}}]; $a{"message-md"} //= "" }
    $ENV{SEON_MCP_CLIENT} = "checkout-$root";
    binmode STDOUT, ":utf8"; binmode STDERR, ":utf8";
    my $req = encode_json({jsonrpc => "2.0", id => 1, method => "tools/call", params => {name => "seon_$op", arguments => \%a}});
    open my $out, "-|", "printf \x27%s\\n\x27 \Q$req\E | \Q$mcp\E \Q$port\E" or die "bin/mcp call: $!\n";
    my $r = decode_json(join "", <$out>);
    if ($r->{error}) { print STDERR $r->{error}{message}, "\n"; exit 1 }
    print $_->{text}, "\n" for @{$r->{result}{content}};
  ' "$0" "$PORT" "$ROOT" "$@"
fi
exec perl -MIO::Socket::INET -MJSON::PP -e '
  $| = 1; my ($port, $portf) = @ARGV; my $client = $ENV{SEON_MCP_CLIENT} // "mcp-$$-" . time();
  while (my $line = <STDIN>) {
    $line .= "\n" unless $line =~ /\n\z/;
    my $msg = eval { decode_json($line) };
    my $id = ref $msg eq "HASH" ? $msg->{id} : undef;   # undef for a line that is not JSON: root answers it
    # who asks: the client id of this session on every message (seon.server/held: an agent it attached
    # answers its own requests, or ones that name the task of the agent)
    if (ref $msg eq "HASH") { $msg->{"seon/client"} = $client; $line = encode_json($msg) . "\n" }
    my $p = $port;
    if ($p eq "") { if (open my $f, "<", $portf) { chomp($p = <$f> // ""); close $f } }
    my ($s, $why) = (undef, "no root running for this checkout ($portf is missing): bin/system start");
    if ($p ne "") {
      $s = IO::Socket::INET->new(PeerAddr => "127.0.0.1", PeerPort => $p, Proto => "tcp");
      $why = $s ? "root answered nothing (it stopped mid-request?)" : "root'"'"'s server on 127.0.0.1:$p is not listening ($!): bin/system start";
    }
    my $got = 0;
    if ($s) { print $s $line; shutdown($s, 1); while (my $a = <$s>) { print $a; $got = 1 } close $s }
    print encode_json({jsonrpc => "2.0", id => $id, error => {code => -32000, message => $why}}), "\n" if !$got && defined $id;
  }' "${1:-}" "${SEON_RUNS:-$ROOT/runs}/root.port"
