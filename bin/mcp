#!/usr/bin/env python3
"""bin/mcp — Thin zero-logic stdio JSON-RPC 2.0 MCP relay into the standing Seon server (`POST /mcp`).
Every MCP tool (`seon_repl`, `seon_health`, `seon_test`, `seon_merge`, `seon_status`) runs directly
inside the standing Seon runtime on 127.0.0.1:${SEON_PORT:-9998}. Zero logic, zero extra Jolt JVM/Chez RAM."""
import json
import os
import sys
import urllib.error
import urllib.request

PORT = os.environ.get("SEON_PORT", "9998")
URL = f"http://127.0.0.1:{PORT}/mcp"

def relay(line: str) -> str | None:
    req = urllib.request.Request(
        URL,
        data=line.encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=35) as resp:
            body = resp.read().decode("utf-8").strip()
            return body if body else None
    except Exception as exc:
        try:
            msg = json.loads(line)
            mid = msg.get("id")
        except Exception:
            mid = None
        if mid is not None:
            return json.dumps({
                "jsonrpc": "2.0",
                "id": mid,
                "error": {
                    "code": -32000,
                    "message": f"Seon standing server unreachable at {URL} ({exc}). Start with SEON_BINARY=1 ./bin/seon start",
                },
            })
        return None

def main() -> None:
    for raw in sys.stdin:
        line = raw.strip()
        if not line:
            continue
        ans = relay(line)
        if ans:
            sys.stdout.write(ans + "\n")
            sys.stdout.flush()

if __name__ == "__main__":
    main()
