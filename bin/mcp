#!/bin/zsh
# bin/mcp [PORT]   the MCP server (stdio JSON-RPC) for outside agents: a relay of each line to the
# standing root's entrance on 127.0.0.1:PORT (default: this checkout's, config/local.edn, which
# bin/ports writes; start root with bin/root), which answers MCP itself (seon.entrance/mcp-reply).
# Tools: seon_agents, seon_eval (an agent's own REPL, recorded :outside; or "root"),
# seon_context, seon_attach, seon_done.
#
# Stock perl, no Seon binary (a `seon mcp` per client was 729 MB each; this is a few MB, and
# seon.check/mcp-proof fails past :seon.config.machine/relay-mb). One connection per message, so
# a root restarted between calls (bin/root next) costs the session nothing. A message with an id
# that root does not answer (not listening, or it died mid-request) is answered the JSON-RPC
# error saying why: the client never hangs on it.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
PORT=${1:-${SEON_ENTRANCE_PORT:-}}
if [[ -z $PORT ]]; then
  [[ -f $ROOT/config/local.edn ]] || "$ROOT/bin/ports" > /dev/null   # writes it once, when missing
  # the line bin/ports writes: :seon.config.root/entrance-port #long #or [#env SEON_ENTRANCE_PORT N]
  PORT=$(sed -n 's/^ *:seon.config.root\/entrance-port .*SEON_ENTRANCE_PORT \([0-9][0-9]*\)\].*/\1/p' "$ROOT/config/local.edn")
fi
[[ -n $PORT ]] || { print -u2 "bin/mcp: no entrance port: pass one, or keep bin/ports' line in $ROOT/config/local.edn"; exit 1 }
exec perl -MIO::Socket::INET -MJSON::PP -e '
  $| = 1; my $port = shift;
  while (my $line = <STDIN>) {
    $line .= "\n" unless $line =~ /\n\z/;
    my $id = eval { decode_json($line)->{id} };
    my $s = IO::Socket::INET->new(PeerAddr => "127.0.0.1", PeerPort => $port, Proto => "tcp");
    my $why = $s ? "root answered nothing (it stopped mid-request?)" : "root'"'"'s entrance on 127.0.0.1:$port is not listening ($!): bin/root start";
    my $got = 0;
    if ($s) { print $s $line; shutdown($s, 1); while (my $a = <$s>) { print $a; $got = 1 } close $s }
    print encode_json({jsonrpc => "2.0", id => $id, error => {code => -32000, message => $why}}), "\n" if !$got && defined $id;
  }' "$PORT"
