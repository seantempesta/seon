#!/bin/zsh
# bin/worktree NAME [BASE]    a worktree of the main tree on branch jolt/NAME (a new one from BASE, default
#                             main; an existing one as it is), at <root>/.worktrees/NAME (gitignored: a
#                             worktree is inside the root it belongs to)
# bin/worktree --path NAME    that path
# bin/worktree --remove NAME  remove that worktree and its submodule worktrees (the branch is kept)
# bin/worktree --at DIR COMMIT [REPO]  a detached worktree of REPO (default next/) at COMMIT in DIR, set
#                             up as below: what a generation is built in (seon.fx/build, docs/source.md)
# bin/worktree --remove-at DIR remove such a worktree and its submodule worktrees
# bin/worktree --sync NAME|DIR move that worktree's submodules to the pins its branch records (after
#                             merging main), by `git -C` on its own submodule checkouts only. Never
#                             run `git submodule` in a worktree: it rewrites the module config every
#                             checkout shares (core.worktree), and main's submodules break.
#
# A worktree session that changes shared foundations works here, so its unfinished work never breaks other
# worktree sessions' builds and runs. On Jolt this is safe: a process loads only from its own JOLT_PWD and its
# own target/ (no shared VM), so two worktrees never mix code.
#
# What it sets up, so the worktree builds and tests on its own at once:
# - each submodule of reference-code/ is a worktree of the main tree's submodule repo, detached at
#   the pinned commit: objects are shared, `git status` is clean, a pin bump on main is taken with
#   `bin/worktree --sync NAME` from the main tree (never `git submodule` in a worktree);
# - jolt's own nested submodules (vendor/*) are APFS clones of the main tree's (the build copies them);
# - target/ is an APFS clone of the main tree's (blocks shared until written; chez and jolt stay
#   fresh, so `bin/build seon` is the only build needed), without Jolt's compile caches: every
#   checkout shares main's target/cache (bin/env);
# - its stores are its own: its root's runs/store (bin/root), and a check run takes a store of its own
#   (SEON_STORE=$PWD/target/check-store bin/check ...).
# Builds run niced, in parallel (no lock). Merging: the worktree session reports and root merges its branch
# (docs/merging.md); the worktree never edits the main tree.
set -eu
MAIN=$(cd "$(dirname "$0")/.." && pwd)
die() { print -u2 "worktree: $*"; exit 1; }
# the main tree (git's common dir), whichever checkout this runs from: the worktrees and the port
# registry (bin/ports) live inside it, so the root folder holds everything and can be moved whole
MAIN_TREE=$(cd "$(git -C "$MAIN" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
MAIN=$MAIN_TREE   # submodules, target/ and git calls below are the main tree's, whichever checkout this runs from
wt_path() { print "$MAIN_TREE/.worktrees/$1"; }

if [[ ${1:-} == --path ]]; then
  [[ -n ${2:-} ]] || die "usage: bin/worktree --path NAME"
  wt_path "$2"; exit 0
fi

# setup WT: WT's submodules as worktrees of this checkout's submodule repos at the pins WT's
# commit records (read with ls-tree, never `git submodule`), and target/ cloned
setup() {
  local WT=$1
  git -C "$WT" ls-tree HEAD reference-code/ | while read -r mode type sha sub; do
    [[ $type == commit ]] || continue
    rmdir "$WT/$sub" 2>/dev/null || true
    # a submodule the main tree has not checked out yet (one a worktree session added, before root's merge
    # initializes it, docs/merging.md) or a pin it lacks: said and left out, not a half-made worktree
    if [[ ! -e $MAIN/$sub/.git ]] || ! git -C "$MAIN/$sub" cat-file -e "$sha^{commit}" 2>/dev/null; then
      print -u2 "worktree: $sub at $sha is not in the main tree's checkout; left out (root initializes it at merge)"
      continue
    fi
    git -C "$MAIN/$sub" worktree add -q --detach "$WT/$sub" "$sha"
    # nested submodules (jolt's vendor/*): clones of the main tree's checked-out copies
    if [[ -f $MAIN/$sub/.gitmodules ]]; then
      for nested in $(git -C "$MAIN/$sub" config -f .gitmodules --get-regexp 'submodule\..*\.path' | awk '{print $2}'); do
        [[ -d $MAIN/$sub/$nested ]] || continue
        rm -rf "$WT/$sub/$nested"; mkdir -p "$(dirname "$WT/$sub/$nested")"
        cp -cR "$MAIN/$sub/$nested" "$WT/$sub/$nested"
        # a plain copy for the build: its .git points at the main tree's module store by a
        # relative path that does not exist from here
        rm -rf "$WT/$sub/$nested/.git"
      done
    fi
  done
  # target/: an APFS clone (copy-on-write) of the builds, not of the runs: a cloned store opens
  # (it is named by the id it records, seon.db/store-cfg) but is the main tree's record, a
  # replica sharing its id, not a store of this worktree's; target/check/ is the source tree's record, not this one's,
  # and target/tmp/ holds tests' scratch (a generation a test builds lives there); nor of the
  # compile caches: target/cache is the one shared copy, and target/home/.jolt's caches are
  # what a checkout held before it was shared (bin/env)
  if [[ -d $MAIN/target ]]; then
    mkdir -p "$WT/target/home/.jolt"
    for e in "$MAIN"/target/*(N); do
      [[ ${e:t} == (runs|check|tmp|cache|home|results-store) ]] || cp -cR "$e" "$WT/target/"
    done
    for e in "$MAIN"/target/home/*(ND); do
      [[ ${e:t} == .jolt ]] || cp -cR "$e" "$WT/target/home/"
    done
    for e in "$MAIN"/target/home/.jolt/*(ND); do
      [[ ${e:t} == (aot-cache|build-cache|runtime-cache) ]] || cp -cR "$e" "$WT/target/home/.jolt/"
    done
  fi
}

# unsub WT: remove WT's submodule worktrees from this checkout's submodule repos
unsub() {
  for sub in $(git -C "$MAIN" config -f .gitmodules --get-regexp 'submodule\..*\.path' | awk '{print $2}'); do
    [[ -e $1/$sub/.git ]] && git -C "$MAIN/$sub" worktree remove --force "$1/$sub" 2>/dev/null || true
  done
}

if [[ ${1:-} == --at ]]; then
  WT=${2:-} SHA=${3:-} REPO=${4:-$MAIN}
  [[ -n $WT && -n $SHA ]] || die "usage: bin/worktree --at DIR COMMIT [REPO]"
  [[ ! -e $WT ]] || die "$WT exists"
  mkdir -p "${WT:h}"
  git -C "$REPO" worktree add -q --detach "$WT" "$SHA"
  setup "$WT"
  print "worktree $WT at ${SHA:0:12} of $REPO"
  exit 0
fi

if [[ ${1:-} == --remove-at ]]; then
  WT=${2:-}; [[ -d $WT ]] || die "usage: bin/worktree --remove-at DIR (no worktree at '$WT')"
  unsub "$WT"
  C=$(git -C "$WT" rev-parse --path-format=absolute --git-common-dir)
  git --git-dir="$C" worktree remove --force "$WT"
  print "removed $WT"
  exit 0
fi

if [[ ${1:-} == --sync ]]; then
  NAME=${2:-}; [[ -n $NAME ]] || die "usage: bin/worktree --sync NAME"
  if [[ $NAME == /* ]]; then WT=$NAME; else WT=$(wt_path "$NAME"); fi   # a name, or the absolute path of a worktree anywhere (bin/update: the write-back tree config names)
  [[ -d $WT ]] || die "no worktree at $WT"
  git -C "$WT" ls-tree HEAD reference-code/ | while read -r mode type sha sub; do
    [[ $type == commit ]] || continue
    [[ -e $WT/$sub/.git ]] || continue
    cur=$(git -C "$WT/$sub" rev-parse HEAD)
    [[ $cur == $sha ]] && continue
    git -C "$WT/$sub" checkout -q --detach "$sha" && print "$sub: ${cur:0:8} -> ${sha:0:8}"
  done
  exit 0
fi

if [[ ${1:-} == --remove ]]; then
  NAME=${2:-}; [[ -n $NAME ]] || die "usage: bin/worktree --remove NAME"
  WT=$(wt_path "$NAME")
  [[ -d $WT ]] || die "no worktree at $WT"
  unsub "$WT"
  git -C "$MAIN" worktree remove --force "$WT"
  # its port block (bin/ports) is free again
  REG=$MAIN_TREE/config/worktree-ports
  [[ -f $REG ]] && /usr/bin/lockf -k "$REG.lock" zsh -c 'grep -v "^$2 " "$1" > "$1.new"; mv "$1.new" "$1"' _ "$REG" "${WT:t}"
  print "removed $WT (branch jolt/$NAME kept)"
  exit 0
fi

NAME=${1:-}; BASE=${2:-main}
[[ -n $NAME && $NAME != seon* ]] || die "usage: bin/worktree NAME [BASE] (a name not starting with seon)"
WT=$(wt_path "$NAME")
BR=jolt/$NAME
[[ ! -e $WT ]] || die "$WT exists"

# a branch that exists (a worktree recreated after a move, a branch with unmerged work) is checked out
# as it is; BASE only names the start of a new one
if git -C "$MAIN" show-ref -q --verify "refs/heads/$BR"; then
  git -C "$MAIN" worktree add -q "$WT" "$BR"
else
  git -C "$MAIN" worktree add -q -b "$BR" "$WT" "$BASE"
fi

setup "$WT"

# its own ports (config/local.edn, from the one registry); the committed .mcp.json runs ./bin/mcp,
# which reaches the root on these ports, so a session started here talks to this worktree's root
PORTS=$("$WT/bin/ports")

print "worktree $WT on $BR (from $BASE)"
print "  build:  cd $WT && nice -n 15 bin/build seon"
print "  test:   bin/prove (the tests and check steps the change reaches; bin/test --all, bin/check 100: the full runs)"
print "  root:   bin/root (start | status | stop), on this worktree's own ports: $PORTS"
print "  merge:  report to root, which merges the branch (docs/merging.md)"
print "  remove: $MAIN/bin/worktree --remove $NAME"
