#!/bin/zsh
# bin/jolt-gates [GATE ...] — Jolt's own gates on this checkout's Jolt pin and this checkout's Chez: what a Jolt
# pin owes before it is handed over (docs/merging.md#conflicts-and-pins), every gate of test/forks/jolt-gates.txt
# (or the ones named): Jolt built once, then the gates in parallel, each worker a clonefile copy of the build with its own HOME and TMPDIR, niced, each gate under a timeout, its output kept in target/jolt-gates/logs/GATE.out.
# The gates run in a clone of the fork kept at target/jolt-gates/work, moved to the pinned commit, never in
# reference-code/jolt: Jolt's Makefile runs `git submodule update` for its vendored libraries, which a
# worktree's checkout must never do (bin/worktree). Verdicts go to target/jolt-gates/verdicts.tsv as they
# land (GATE, PASS|FAIL|TIMEOUT, seconds). It ends on JOLT GATES OK when the gates that are not PASS are
# exactly the ones test/forks/jolt-gates-red.txt names (each with its reason there), else JOLT GATES FAILED
# naming every gate that is red and not known, and every known-red gate that passed (remove its line).
# JOLT_GATES_JOBS sets the workers (default: cores less 2).
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# Jolt's gates judge Jolt as it ships, so they run in none of Seon's environment: a caller that had sourced bin/env
# exported JOLT_COMPILER_OPTIONS {:image-fn-forms false}, the caches and HOME, and seven gates went red on code that is
# green (fnform, stateimage, inline-body, corpus, unit, aotcachesmoke, gambitseedcheck; 2026-11-14). Every JOLT_ and
# SEON_ variable is cleared but the two this script reads.
for v in ${(k)parameters[(I)JOLT_*]} ${(k)parameters[(I)SEON_*]}; do
  [[ $v == JOLT_CHEZ || $v == JOLT_GATES_JOBS ]] || unset $v
done
J=$ROOT/reference-code/jolt; T=$ROOT/target/jolt-gates; C=$ROOT/target/chez/bin/scheme
[[ -x $C ]] || { echo "JOLT GATES FAILED (no $C; run bin/build chez first)"; exit 1 }
PIN=$(git -C "$J" rev-parse HEAD) || exit 1
mkdir -p "$T/logs" "$T/tmp" "$T/home"
[[ -d $T/work/.git ]] || git clone -q "$J" "$T/work" || { echo "JOLT GATES FAILED (cannot clone $J)"; exit 1 }
git -C "$T/work" fetch -q "$J" "$PIN" && git -C "$T/work" checkout -q --detach "$PIN" || { echo "JOLT GATES FAILED (cannot check out $PIN)"; exit 1 }
# The clone's vendored libraries first: Jolt's Makefile fetches them (its `deps` target, git
# submodule in the clone, never in a worktree) only before the gates its JOLT-TARGETS-NEEDING-DEPS
# names, and a gate run from source that is not there (siginfodump) found vendor/irregex empty.
( cd "$T/work" && HOME=$T/home JOLT_CHEZ=$C nice -n 15 make CHEZ=$C deps ) > "$T/logs/deps.out" 2>&1 < /dev/null \
  || { echo "JOLT GATES FAILED (the clone's vendored libraries: $T/logs/deps.out)"; exit 1 }
if (( $# )); then gates=("$@"); else gates=(${(f)"$(grep -v '^#' "$ROOT/test/forks/jolt-gates.txt")"}); fi
known=(${(f)"$(grep -v '^#' "$ROOT/test/forks/jolt-gates-red.txt" | cut -d' ' -f1)"})
# One build, then the gates in parallel: the built clone is copied per worker with APFS clonefile (cp -c: no bytes
# copied), each worker its own HOME and TMPDIR, the gates dealt longest first by the last run's seconds
# (target/jolt-gates/times.tsv) to the least loaded worker. JOLT_GATES_JOBS workers (default: cores less 2).
( cd "$T/work" && HOME=$T/home JOLT_CHEZ=$C nice -n 15 make CHEZ=$C testbin ) > "$T/logs/testbin.out" 2>&1 < /dev/null \
  || { echo "JOLT GATES FAILED (the build: $T/logs/testbin.out)"; exit 1 }
N=${JOLT_GATES_JOBS:-$(( $(sysctl -n hw.ncpu) - 2 ))}; (( N > ${#gates} )) && N=${#gates}
typeset -A last load; [[ -f $T/times.tsv ]] && while read -r g s; do last[$g]=$s; done < "$T/times.tsv"
for (( w = 1; w <= N; w++ )); do load[$w]=0; : > "$T/w$w.list"
  rm -rf "$T/w$w"; cp -cR "$T/work" "$T/w$w" || { echo "JOLT GATES FAILED (cannot clone the build for worker $w)"; exit 1 }
  mkdir -p "$T/w$w.home" "$T/w$w.tmp"; done
for g in ${(f)"$(for g in $gates; do print "${last[$g]:-600} $g"; done | sort -k1,1 -n -r | awk '{print $2}')"}; do
  b=1; for (( w = 2; w <= N; w++ )); do (( load[$w] < load[$b] )) && b=$w; done
  print $g >> "$T/w$b.list"; load[$b]=$(( load[$b] + ${last[$g]:-600} )); done
: > "$T/verdicts.tsv"; P=()
for (( w = 1; w <= N; w++ )); do
  ( for g in ${(f)"$(cat $T/w$w.list)"}; do t0=$SECONDS
      ( cd "$T/w$w" && HOME=$T/w$w.home JOLT_CHEZ=$C nice -n 15 timeout -k 30 1100 make CHEZ=$C TMPDIR=$T/w$w.tmp/ $g ) > "$T/logs/$g.out" 2>&1 < /dev/null
      case $? in 0) st=PASS;; 124|137) st=TIMEOUT;; *) st=FAIL;; esac
      print "$g\t$st\t$((SECONDS - t0))" >> "$T/verdicts.tsv"; print "$st $g"; done ) & P+=($!)
done
wait $P
awk -F'\t' '{print $1, $3}' "$T/verdicts.tsv" > "$T/times.tsv"
red=(${(f)"$(awk -F'\t' '$2 != "PASS" {print $1}' "$T/verdicts.tsv")"})
new=(${red:|known}); if (( $# )); then fixed=(); else fixed=(${known:|red}); fi
print "jolt-gates: $PIN, ${#gates} gates, $(( ${#gates} - ${#red} )) PASS, ${#red} not"
(( ${#new} )) && print "red and not known: $new"
(( ${#fixed} )) && print "known red and now PASS (remove from test/forks/jolt-gates-red.txt): $fixed"
if (( ${#new} + ${#fixed} )); then echo "JOLT GATES FAILED"; exit 1; fi
echo "JOLT GATES OK"
