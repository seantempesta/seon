#!/usr/bin/env bash
# Sourced by bin/test and bin/test-fast; requires $source_root and, for the
# ledger line, $run_root (may be empty).
# Machine-wide admission of test JVMs. Every bin/test and bin/test-fast
# invocation holds one slot from snapshot to exit; each invocation launches a
# program-loading JVM at 100%+ CPU (a gate: coordinator + workers + cache),
# and 2026-09-15 six lanes launched eight at once, starving the owner's
# cluster and the live agent run. The bound is declared here, enforced at the
# seam that admits the work, and a wait that never ends is reported as a
# failure naming the holders, never a silent hang. Slots are project-local
# directories whose mkdir is atomic; orphaned holders are announced and left
# for the orchestrator to reclaim. SEON_TEST_SLOTS overrides the count; SEON_TEST_SLOT_WAIT_SECONDS
# the bound; SEON_TEST_SLOT_ANNOUNCE_SECONDS the progress interval.
# Two at once, machine-wide per repository: on 2026-09-20 seven test JVMs
# (~40 GB, load 25) ran because each worktree of this repository counted its
# own slots. The slot directory now derives from Git's common directory, so
# every worktree of one repository shares one bound; a genuinely separate
# checkout (another clone) keeps its own.
test_slot_count=2
for test_override in SEON_TEST_SILENCE_SECONDS SEON_TEST_SLOTS; do
  if [ "${!test_override+x}" = x ]; then
    if [ -n "${SEON_CODEX_LANE:-}" ] || [ "${SEON_TEST_ORCHESTRATOR:-}" != 1 ]; then
      if [ "$test_override" = SEON_TEST_SLOTS ]; then
        echo "bin/test: SEON_TEST_SLOTS refused: declared slot bound is $test_slot_count; only SEON_TEST_ORCHESTRATOR=1 without lane identity may raise it." >&2
      else
        echo 'bin/test: SEON_TEST_SILENCE_SECONDS refused: declared silence bound derives from :seon.test/long with :seon.test/long-ms and measured fixture priming; only SEON_TEST_ORCHESTRATOR=1 without lane identity may override it.' >&2
      fi
      exit 64
    fi
    case "${!test_override}" in
      ''|*[!0-9]*|0) echo "bin/test: $test_override must be a positive integer." >&2; exit 64 ;;
    esac
    case "${!test_override}" in
      *[1-9]*) ;;
      *) echo "bin/test: $test_override must be a positive integer." >&2; exit 64 ;;
    esac
  fi
done
test_slot_count=${SEON_TEST_SLOTS:-$test_slot_count}
test_slot_wait_seconds=${SEON_TEST_SLOT_WAIT_SECONDS:-1800}
test_slot_announce_seconds=${SEON_TEST_SLOT_ANNOUNCE_SECONDS:-60}
test_slot_repository=$(git -C "${source_root:-$PWD}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [ -n "$test_slot_repository" ]; then
  test_slot_parent="$(dirname "$test_slot_repository")/tmp/test-slots"
else
  test_slot_parent="${source_root:-$PWD}/tmp/test-slots"
fi
held_test_slot=

test_slot_runner_pid() {
  local root line runner=
  root=$(cat "$1/run-root" 2>/dev/null || true)
  if [ -f "$root/test-run.txt" ]; then
    while IFS= read -r line; do
      case "$line" in
        runner-pid=*) runner=${line#runner-pid=}; runner=${runner%% *} ;;
      esac
    done <"$root/test-run.txt"
  fi
  printf '%s\n' "$runner"
}

# Each held slot, its holder pid, that holder's own elapsed time, and the run
# root it is working in: enough to decide whether to keep waiting or to look at
# the holder.
announce_test_slot_holders() {
  local only_orphans=${1:-0} slot holder holder_elapsed parent recorded_parent root line phase runner orphan gate_pid
  for slot in $(seq 1 "$test_slot_count"); do
    holder=$(cat "$test_slot_parent/slot-$slot/pid" 2>/dev/null || echo none)
    holder_elapsed=none
    root=$(cat "$test_slot_parent/slot-$slot/run-root" 2>/dev/null || echo none)
    phase=unknown
    runner=$(test_slot_runner_pid "$test_slot_parent/slot-$slot")
    if [ -f "$root/test-run.txt" ]; then
      while IFS= read -r line; do
        case "$line" in
          phase=*) phase=$line ;;
        esac
      done <"$root/test-run.txt"
    fi
    orphan=0
    gate_pid=$holder
    if [ "$holder" != none ]; then
      parent=$(ps -p "$holder" -o ppid= 2>/dev/null | tr -d ' ' || true)
      recorded_parent=$(cat "$test_slot_parent/slot-$slot/parent-pid" 2>/dev/null || true)
      if [ "$parent" = 1 ] ||
         { ! kill -0 "$holder" 2>/dev/null && [ -n "$runner" ] && kill -0 "$runner" 2>/dev/null; } ||
         { kill -0 "$holder" 2>/dev/null && [ -n "$recorded_parent" ] && ! kill -0 "$recorded_parent" 2>/dev/null; }; then
        orphan=1
        if ! kill -0 "$holder" 2>/dev/null && [ -n "$runner" ] && kill -0 "$runner" 2>/dev/null; then
          gate_pid=$runner
        fi
      fi
      holder_elapsed=$(ps -p "$gate_pid" -o etime= 2>/dev/null | tr -d ' ' || true)
      holder_elapsed=${holder_elapsed:-gone}
    fi
    if [ "$orphan" -eq 1 ]; then
      printf 'bin/test: orphaned gate pid %s (parent dead) holds slot-%s since %s; launcher-pid=%s run-root=%s last PHASE: %s; orchestrator must reclaim\n' \
        "$gate_pid" "$slot" "$holder_elapsed" "$holder" "$root" "$phase" >&2
    elif [ "$only_orphans" -eq 0 ]; then
      printf 'bin/test:   slot-%s pid=%s elapsed=%s run-root=%s\n' "$slot" "$holder" "$holder_elapsed" "$root" >&2
    fi
  done
}

acquire_test_slot() {
  local waited=0 slot holder runner announced=0 announced_at=0
  mkdir -p "$test_slot_parent"
  while :; do
    for slot in $(seq 1 "$test_slot_count"); do
      if mkdir "$test_slot_parent/slot-$slot" 2>/dev/null; then
        printf '%s\n' "$$" >"$test_slot_parent/slot-$slot/pid"
        ps -p "$$" -o ppid= | tr -d ' ' >"$test_slot_parent/slot-$slot/parent-pid"
        printf '%s\n' "${run_root:-$PWD}" >"$test_slot_parent/slot-$slot/run-root"
        held_test_slot="$test_slot_parent/slot-$slot"
        if [ -n "${run_root-}" ]; then
          printf 'test-slot=%s acquired-after-seconds=%s\n' "$slot" "$waited" \
            >>"$run_root/test-run.txt"
        fi
        return 0
      fi
      holder=$(cat "$test_slot_parent/slot-$slot/pid" 2>/dev/null || true)
      if [ -z "$holder" ]; then
        if [ -z "$(ls -A "$test_slot_parent/slot-$slot" 2>/dev/null)" ]; then
          echo "bin/test: reclaiming empty test slot $slot" >&2
          rm -rf "$test_slot_parent/slot-$slot"
        fi
      elif ! kill -0 "$holder" 2>/dev/null; then
        runner=$(test_slot_runner_pid "$test_slot_parent/slot-$slot")
        if [ -z "$runner" ] || ! kill -0 "$runner" 2>/dev/null; then
          echo "bin/test: reclaiming test slot $slot from dead holder pid=$holder and runner pid=${runner:-none}" >&2
          rm -rf "$test_slot_parent/slot-$slot"
        fi
      fi
    done
    if [ "$waited" -ge "$test_slot_wait_seconds" ]; then
      echo "bin/test: no test JVM slot free after ${test_slot_wait_seconds}s; holders:" >&2
      announce_test_slot_holders
      return 75
    fi
    # A wait must stay visibly a wait. A silent 25-minute block reads as a
    # hang, and on 2026-09-17 four queued gates behind a wedged phase looked
    # exactly like an ordinary queue. Announce on entry, then every
    # test_slot_announce_seconds, always naming the holders and their age.
    if [ "$announced" -eq 0 ] || [ $((waited - announced_at)) -ge "$test_slot_announce_seconds" ]; then
      if [ "$announced" -eq 0 ]; then
        echo "bin/test: all $test_slot_count test JVM slots busy; waiting up to ${test_slot_wait_seconds}s (SEON_TEST_SLOTS / SEON_TEST_SLOT_WAIT_SECONDS)" >&2
        announced=1
      else
        echo "bin/test: still waiting for a test JVM slot after ${waited}s of ${test_slot_wait_seconds}s; holders:" >&2
      fi
      announced_at=$waited
      announce_test_slot_holders
    fi
    sleep 5
    waited=$((waited + 5))
  done
}

release_test_slot() {
  if [ -n "$held_test_slot" ]; then
    rm -rf "$held_test_slot"
    held_test_slot=
  fi
}
