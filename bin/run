#!/bin/bash
# Start the Seon system
# Usage: ./bin/run [profile]
#   ./bin/run        # dev profile (default) - includes nREPL on port 7888
#   ./bin/run prod   # production profile
#
# Starts XTDB, nREPL, HTTP server, and Tailwind watcher (via Integrant).
# Ctrl+C to stop cleanly.

export JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home
export PATH="$JAVA_HOME/bin:$PATH"
exec clj -J-Xmx4g -M:dev:run "$@"
