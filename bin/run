#!/bin/bash
# Start the Seon system
# Usage: ./bin/run [profile]
#   ./bin/run        # dev profile (default) - includes nREPL on port 7888
#   ./bin/run prod   # production profile
#
# Starts Datalevin, nREPL, HTTP server, Tailwind watcher, and Caddy proxy (via Integrant).
# Ctrl+C to stop cleanly.

export JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home
export PATH="$JAVA_HOME/bin:$PATH"

# Ensure classpath is fresh (stale .cpcache causes missing-dep errors)
if [ -f .cpcache/*/classpath ]; then
    if [ deps.edn -nt .cpcache/*/classpath ]; then
        echo "deps.edn changed — refreshing classpath..."
        rm -rf .cpcache
    fi
fi

exec clj -M:fork-deps:dev:run "$@"
