# bin/env — sourced by bin/build, bin/test, bin/check, bin/root, bin/ports, bin/worktree and
# bin/cache-smoke: where the runtime finds its native libraries and its checkout, and Jolt's options.
# LMDB: konserve.jolt.lmdb-ffi loads JOLT_LMDB_LIB, the robust-lock build bin/build makes
# (bin/build lmdb). Every process on a store must load the same build: the lock scheme is
# part of the lock file's format, and another build's open is refused (MDB_VERSION_MISMATCH) while
# a process holds the store; the first open when none holds it takes the store over
# (docs/failure-points.md#lmdb-locks).
ROOT=${ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
JOLT_LMDB_LIB=${JOLT_LMDB_LIB:-$ROOT/target/lib/liblmdb.dylib}
export JOLT_LMDB_LIB
# LZ4: konserve.jolt.lz4 loads JOLT_LZ4_LIB, the store's node compressor, built from Chez's
# vendored lz4 (bin/build lz4).
JOLT_LZ4_LIB=${JOLT_LZ4_LIB:-$ROOT/target/lib/liblz4.dylib}
export JOLT_LZ4_LIB
# zstd: konserve.jolt.zstd loads JOLT_ZSTD_LIB, built from reference-code/zstd (bin/build zstd).
JOLT_ZSTD_LIB=${JOLT_ZSTD_LIB:-$ROOT/target/lib/libzstd.dylib}
export JOLT_ZSTD_LIB
# The checkout this process runs from: seon.config reads resources/seon/config/default.edn
# here and resolves its #seon/checkout paths (the probe library, system.edn, the tasks) under it.
# (not JOLT_PWD: Jolt resolves a child process's relative path, ./seon, against it)
export SEON_CHECKOUT=${SEON_CHECKOUT:-$ROOT}
# HOME (dependency downloads: .m2, gitlibs) per checkout
export HOME=$ROOT/target/home
# Jolt's compile caches are shared by every checkout and generation worktree (docs/source.md#shared-build-caches):
# - build-unit and runtime: keyed by the unit's text and the building runtime's fingerprint;
# - AOT (JOLT_CACHE_DIR): keyed by the source, its requires' keys and what its compile read, each
#   read named relative to the project root (JOLT_PWD), so a checkout hashes its own files;
#   JOLT_CACHE_GENERATIONS runtimes are kept (one per Jolt pin in use), and the whole cache is kept under JOLT_CACHE_MB,
#   least recently used first (a hit marks its artifact; Jolt's loader.ss aot-prune-to-budget!): it grew to 27 GB unbounded
#   by 2026-11-11, where one tree needs 0.07-0.28 GiB a generation.
# No key holds a checkout's path, and entries are published by temp+rename. One directory in the main
# tree's target/, found from git's common dir so a worktree anywhere (bin/worktree --at DIR too)
# names the same absolute path.
# git, the real binary: /usr/bin/git on macOS is a shim that finds the developer directory (xcrun) on every call, 11.3 ms
# a call against 5.1 ms (measured 2026-11-10, rev-parse HEAD, 30 calls each). Every git child of a script, a test, root and
# its agents pays it (seon.fx/tree-id is ~7 a call), so a directory holding only git, linked to the binary git's own
# exec path names, goes first on PATH for everything this environment starts. Where git is already the binary, nothing moves.
GIT_REAL=$(cd "$(git --exec-path)" 2>/dev/null && cd "$(dirname "$(readlink git 2>/dev/null || echo git)")" 2>/dev/null && pwd)/git
if [[ -x $GIT_REAL && $(command -v git) != $GIT_REAL ]]; then
  mkdir -p "$ROOT/target/git-bin" && ln -sf "$GIT_REAL" "$ROOT/target/git-bin/git"
  [[ :$PATH: == *:$ROOT/target/git-bin:* ]] || export PATH=$ROOT/target/git-bin:$PATH
fi
MAIN_TREE=$(cd "$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
JOLT_BUILD_CACHE_DIR=${JOLT_BUILD_CACHE_DIR:-$MAIN_TREE/target/cache/build}
JOLT_RUNTIME_CACHE_DIR=${JOLT_RUNTIME_CACHE_DIR:-$MAIN_TREE/target/cache/runtime}
JOLT_CACHE_DIR=${JOLT_CACHE_DIR:-$MAIN_TREE/target/cache/aot}
JOLT_CACHE_GENERATIONS=${JOLT_CACHE_GENERATIONS:-4}
# Its value is the config key :seon.config.build/jolt-cache-mb (resources/seon/config/default.edn), read from its one
# line as JOLT_COMPILER_OPTIONS' is below: Jolt reads it before any Seon config exists
JOLT_CACHE_MB=${JOLT_CACHE_MB:-$(sed -nE 's#^ :seon\.config\.build/jolt-cache-mb ([0-9]+)$#\1#p' "$ROOT/resources/seon/config/default.edn")}
export JOLT_BUILD_CACHE_DIR JOLT_RUNTIME_CACHE_DIR JOLT_CACHE_DIR JOLT_CACHE_GENERATIONS JOLT_CACHE_MB
# Jolt's compile options for everything a Seon process compiles (its build, the test runner,
# root's and agents' evals; Jolt reads JOLT_COMPILER_OPTIONS into *compiler-options*' root at
# start): Seon writes no state image, so its fn literals register no source for one
# (a third less allocation a compile; task jolt.backend/image-registration-is-opt-in)
# Its value is the config key :seon.config.build/jolt-compiler-options (resources/seon/config/default.edn),
# read from its one line, as bin/ports reads its ports
JOLT_COMPILER_OPTIONS=${JOLT_COMPILER_OPTIONS:-$(sed -nE 's#^ :seon\.config\.build/jolt-compiler-options "(.*)"$#\1#p' "$ROOT/resources/seon/config/default.edn")}
export JOLT_COMPILER_OPTIONS
# Test and check verdicts are a cache by digest, one directory in the main tree's target/ for every
# checkout (:seon.config.proofs/results-dir, seon.fx/write-verdicts!), published by temp+rename as the
# build caches above are
export SEON_RESULTS_DIR=${SEON_RESULTS_DIR:-$MAIN_TREE/target/results}
# The embedding model (bin/build embed, seon.vector): EmbeddingGemma-2 as ggml-org's Q8_0 GGUF, one copy
# in the main tree's target/cache for every checkout, named by its sha256 (bin/build checks it).
# :seon.config.vector/model reads SEON_EMBED_MODEL; its file name is the model's id on every vector.
SEON_EMBED_MODEL_URL=${SEON_EMBED_MODEL_URL:-https://huggingface.co/ggml-org/embeddinggemma-2-GGUF/resolve/58faf90940886df2d62be555c8765d00dac362c5/embeddinggemma-2-Q8_0.gguf}
SEON_EMBED_MODEL=${SEON_EMBED_MODEL:-$MAIN_TREE/target/cache/models/2188ac1deca4b77dffefd603c2776a9d76d9d74ec01841392982ebb840b09135.gguf}
export SEON_EMBED_MODEL_URL SEON_EMBED_MODEL
