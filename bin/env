# bin/env — sourced by bin/test, bin/check and bin/root: where the runtime finds its native
# libraries and its checkout.
# LMDB: konserve.jolt.lmdb-ffi loads JOLT_LMDB_LIB, the robust-lock build bin/build makes
# (bin/build lmdb). Every process on a store must load the same build: the lock scheme is
# part of the lock file's format.
ROOT=${ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
JOLT_LMDB_LIB=${JOLT_LMDB_LIB:-$ROOT/target/lib/liblmdb.dylib}
export JOLT_LMDB_LIB
# LZ4: konserve.jolt.lz4 loads JOLT_LZ4_LIB, the store's node compressor, built from Chez's
# vendored lz4 (bin/build lz4).
JOLT_LZ4_LIB=${JOLT_LZ4_LIB:-$ROOT/target/lib/liblz4.dylib}
export JOLT_LZ4_LIB
# zstd: konserve.jolt.zstd loads JOLT_ZSTD_LIB, built from reference-code/zstd (bin/build zstd).
JOLT_ZSTD_LIB=${JOLT_ZSTD_LIB:-$ROOT/target/lib/libzstd.dylib}
export JOLT_ZSTD_LIB
# The checkout this process runs from: seon.config reads resources/seon/config/default.edn
# here and resolves its #seon/checkout paths (the probe library, system.edn, the tasks) under it.
# (not JOLT_PWD: Jolt resolves a child process's relative path, ./seon, against it)
export SEON_CHECKOUT=${SEON_CHECKOUT:-$ROOT}
# HOME (dependency downloads: .m2, gitlibs) per checkout
export HOME=$ROOT/target/home
# Jolt's compile caches are shared by every checkout and generation worktree (docs/source.md#shared-build-caches):
# - build-unit and runtime: keyed by the unit's text and the building runtime's fingerprint;
# - AOT (JOLT_CACHE_DIR): keyed by the source, its requires' keys and what its compile read, each
#   read named relative to the project root (JOLT_PWD), so a checkout hashes its own files;
#   JOLT_CACHE_GENERATIONS runtimes are kept (one per Jolt pin in use; Seon's is 140 MB built once, more as variants accrue).
# No key holds a checkout's path, and entries are published by temp+rename. One directory in the main
# tree's target/, found from git's common dir so a worktree anywhere (bin/worktree --at DIR too)
# names the same absolute path.
MAIN_TREE=$(cd "$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)
JOLT_BUILD_CACHE_DIR=${JOLT_BUILD_CACHE_DIR:-$MAIN_TREE/target/cache/build}
JOLT_RUNTIME_CACHE_DIR=${JOLT_RUNTIME_CACHE_DIR:-$MAIN_TREE/target/cache/runtime}
JOLT_CACHE_DIR=${JOLT_CACHE_DIR:-$MAIN_TREE/target/cache/aot}
JOLT_CACHE_GENERATIONS=${JOLT_CACHE_GENERATIONS:-4}
export JOLT_BUILD_CACHE_DIR JOLT_RUNTIME_CACHE_DIR JOLT_CACHE_DIR JOLT_CACHE_GENERATIONS
# Test results by reach digest (:seon.config.source/test-results-dir) are shared the same way:
# one directory in the main tree (gitignored), the same for every worktree and generation worktree
export SEON_TEST_RESULTS=${SEON_TEST_RESULTS:-$MAIN_TREE/test-results}
