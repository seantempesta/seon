#!/bin/zsh
# bin/prove [--out DIR] [--tests | --checks] [NS ...] — run exactly what the change reaches (docs/merging.md): every test (of the named
# namespaces) and every bin/check step (seon.proofs/check-steps) whose reach digest has no green
# result in the results directory every checkout shares runs; the rest are reused. An unchanged
# tree runs nothing. Tests run in :seon.config.proofs/jobs shards at once (bin/test); the steps to run go
# through bin/check's own bodies (bin/check --steps target/prove, started by bin/test beside the shards), on target/seon built from this tree first
# (bin/test builds it only when a selected test or step reaches the binary: the plan's out/binary).
# With no namespace named it leaves nothing out, as --merge does: the tests and steps that reach a
# process of their own (a root, an agent, a fork, the binary: seon.program/graph-index's :process?)
# run too, and the slow tests last, once all else is green (owner, 2026-11-08: "Yes, run them early").
# Ends on PROVE OK / PROVE FAILED and its exit status. The full runs are explicit:
# bin/test --all, bin/check 100.
#
# Each run writes under a directory of its own, target/prove/<run-id> (the run id: a timestamp and
# the process's pid), or the DIR --out names; the run says where on its first line ("prove: run ID,
# logs in DIR"), so two runs on one checkout never overwrite each other's shard files and logs, and
# every reader takes the path from the run. A green run's directory is removed with it (red, killed and --merge
# runs keep theirs; one named by --out is its caller's). Each test's last measured ms is in its cached verdicts (seon.fx/typical-ms, their median).
#
# bin/prove --merge — a merge's verification, the one command (docs/merging.md#main-goes-first):
# runs every test and step with no green at its digest, the ones that
# reach a process too (nothing left out, none named by hand: bin/check contracts and bin/check smoke
# are steps of that same run, keyed by digest, never run again beside it); ends on MERGE OK / MERGE
# FAILED from its exit status alone, naming each red and anything that did not run; and prints its line
# for the merge commit's message: the sha, the plan's counts, the verdicts, the reds, the src delta of
# HEAD against its first parent and the keys left out against main's last merge message.
#
# bin/prove --root PORT [NS ...] — asks the root listening on PORT to prove this checkout's files
# (docs/merging.md#a-session-proves-through-root): the server's :prove with this checkout and its tree id, streamed. Each test's
# verdict prints as it lands (PASS ns/test N ms; RED ns/test and its failures; NO-VERDICT ns/test: why); the run ends on PROVE
# OK (exit 0), or PROVE FAILED (exit 1) after the reds or the typed error that ended it (no root on PORT, the connection's
# end before the answer: the socket's EOF, never a timer). The client is target/seon's prove mode (seon.main/prove-client).
# Only the in-process tests are proved there at this step: the process tests and the check steps are left to the plain
# bin/prove above (Flow step 4 moves them), and no marker is written.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# a run is a process group of its own, and a stop (TERM, INT, HUP: a timeout, a ^C, bin/land stopped) ends the
# whole group, so nothing it started outlives it (2026-11-08: a stopped landing left its prove, shards and check
# steps running). A prove started inside a run (a test's nested gate) stays in that run's group.
if [[ -z ${SEON_RUN_GROUP:-} ]]; then
  export SEON_RUN_GROUP=$$; exec perl -e 'setpgrp(0,0); exec @ARGV or die "exec: $!"' -- "$0" "$@"
fi
[[ $SEON_RUN_GROUP == $$ ]] && trap 'trap - TERM INT HUP; kill -TERM -$$ 2>/dev/null; exit 143' TERM INT HUP
# merge_verdict OUT ST: the merge's one verdict from prove's exit status alone (its steps include
# contracts and smoke), with the reds named from its log in OUT; its line printed for the merge
# commit's message (git keeps every merge's numbers). Exits 0 for MERGE OK. (bin/prove --merge-verdict OUT ST runs it alone.)
merge_verdict() {
  local out=$1 st=$2
  v() { (( $1 == 0 )) && echo OK || echo "FAILED (exit $1)"; }
  local reds=$(grep -hE "^RED |^FAILED " "$out/prove.log" 2>/dev/null | sed -E 's/ \{.*//' | sort -u | tr '\n' ';' | sed 's/;$//')
  local counts=$(grep -E "^prove: [0-9]+ keys" "$out/prove.log" 2>/dev/null | sed -E 's/^prove: //; s/; selected in.*//')
  local merged=$(grep -E "^prove: a merge's verification" "$out/prove.log" 2>/dev/null | sed -E 's/^prove: a merge.s verification: //')
  local srcd
  if git -C "$ROOT" rev-parse -q --verify HEAD^1 >/dev/null; then
    srcd=$(git -C "$ROOT" diff --shortstat HEAD^1 HEAD -- src | sed -E 's/^ *//'); srcd=${srcd:-unchanged}
  else srcd="unknown (no first parent)"; fi
  local left=$(grep -oE "[0-9]+ left out\)?$" "$out/prove.log" 2>/dev/null | tail -1 | grep -oE "[0-9]+")
  local main_left=$(git -C "$ROOT" log --first-parent -50 --format=%B HEAD^1 2>/dev/null | grep -oE "left out [0-9]+" | head -1 | grep -oE "[0-9]+")
  local verdict="MERGE FAILED"
  (( st == 0 )) && verdict="MERGE OK"
  [[ -z $reds && $verdict == "MERGE FAILED" ]] && reds="none named (see the logs in $out)"
  local line="$(git -C "$ROOT" rev-parse --short HEAD) bin/prove --merge $(date '+%Y-%m-%d %H:%M'): $verdict; prove $(v $st) (${counts:-no plan line}; ${merged:-no merge line}); reds: ${reds:-none}; src $srcd; left out ${left:-not measured} (main's last line: ${main_left:-none recorded})"
  echo "$line"
  echo "$verdict"
  [[ $verdict == "MERGE OK" ]]
}
[[ ${1:-} == --merge-verdict ]] && { merge_verdict "$2" "$3"; exit $? }
if [[ ${1:-} == --root ]]; then
  [[ -x $ROOT/target/seon ]] || { echo "prove: no target/seon; run bin/build seon"; echo "PROVE FAILED"; exit 1 }
  PORT=$2; shift 2
  # the binary's environment and its libraries (bin/env exports them), and its home, as bin/root runs it
  . "$ROOT/bin/env"
  cd "$ROOT/target" && SEON_CHECKOUT=$ROOT HOME=$ROOT/target/home exec ./seon prove "$PORT" "$ROOT" "$@"
fi
OUT=
[[ ${1:-} == --out ]] && { OUT=$2; shift 2 }
MERGE=0
[[ ${1:-} == --merge ]] && { MERGE=1; shift }
WHAT=both
[[ ${1:-} == --tests || ${1:-} == --checks ]] && { WHAT=${1#--}; shift }
(( MERGE )) && [[ $WHAT != both ]] && { echo "MERGE FAILED: --merge runs the tests and the checks both (no --$WHAT)"; exit 1 }
# no work, no run: a tree a green prove of the same kind already proved (bin/tree, its id with untracked files)
# answers at once, before any process starts; a green run below writes its marker (the verdict cache's
# dir, which every checkout shares: bin/env)
. "$ROOT/bin/env"
# a run that names its tests or steps asks for them to run, so only a bare run answers from the marker
# (seon.prove-test/two-runs-on-one-checkout-each-end-with-their-own-result named its tests, was answered
# from a marker an earlier green run of them left, said no run directory, and went red in full proves)
TREE=$( (( $# )) || "$ROOT/bin/tree" "$ROOT") || TREE=
# a bare run and a --merge run run the same keys (below), so one marker answers both: a tree a session
# proved with bin/prove is answered at once when bin/land proves it again with --merge
KEY=${TREE:+$WHAT-$TREE}
MARK=$SEON_RESULTS_DIR/proved/$KEY
if [[ -n $KEY && -f $MARK ]]; then
  echo "prove: tree $TREE proved green already ($(cat "$MARK")): nothing to run"
  if (( MERGE )); then
    echo "$(git -C "$ROOT" rev-parse --short HEAD) bin/prove --merge $(date '+%Y-%m-%d %H:%M'): MERGE OK; tree $TREE proved green already ($(cat "$MARK"))"
    echo "MERGE OK"
  else
    echo "PROVE OK"
  fi
  exit 0
fi
OWN=0
if [[ -z $OUT ]]; then
  OWN=1; OUT=$ROOT/target/prove/$(date +%Y%m%dT%H%M%S)-$$
fi
mkdir -p "$OUT"
echo "prove: run ${OUT:t}, logs in $OUT"
st=0
# a bare run leaves nothing out, as a merge's does (owner, 2026-11-08: "Yes, run them early"): the process
# tests its change reaches run in every session's prove, so a red shows before landing and the landing
# reuses the greens; a run that names its tests runs those
PLAN=(); (( MERGE )) || [[ $# == 0 && $WHAT == both ]] && PLAN=(--merge)
# a subshell: the pipeline's first part, its status the run's (tee keeps the log the merge reads)
(
nice -n 15 "$ROOT/bin/test" --prove $WHAT "$OUT" $PLAN "$@" || st=1
if [[ $WHAT != tests && -s $OUT/steps && ! -e $OUT/stopped ]]; then
  # bin/test built target/seon from this tree and ran the steps beside its shards (bin/check --steps);
  # a step's result is keyed by the source it reaches
  nice -n 15 "$ROOT/bin/test" --store-steps "$OUT" || st=1
fi
# the last tier: the slow tests with no green at their digest (the plan's out/slow), only once all else is green, so a fast red answers first and no red waits unseen behind a merge
if (( st == 0 )) && [[ -s $OUT/slow ]]; then
  echo "prove: the slow tests, last: $(<$OUT/slow)"
  nice -n 15 "$ROOT/bin/test" ${=$(<$OUT/slow)} || st=1
fi
# the proofs that pass by waiver (an :overrun in their form), counted by seon.problems/waived-proofs on the tree this run proved
[[ -s $OUT/waived ]] && echo "prove: $(<$OUT/waived) proofs pass by waiver"
if (( st == 0 )); then echo "PROVE OK"; else echo "PROVE FAILED"; fi
print $st > "$OUT/prove.st"; exit $st
) 2>&1 | tee "$OUT/prove.log" &
# waited as a job, not in the foreground: a trap runs at once only while the shell waits on a job (a foreground
# pipeline holds it until it ends); a run that ended without its status (stopped) is red
wait; st=$(<"$OUT/prove.st" 2>/dev/null) || st=1
# the marker: this tree, this kind of run, green (a red, or a tree edited during the run, writes none)
if (( st == 0 )) && [[ -n $KEY && $("$ROOT/bin/tree" "$ROOT") == $TREE ]]; then
  mkdir -p "${MARK:h}" && print -r -- "$(date '+%Y-%m-%d %H:%M') ${OUT:t}" > "$MARK.$$" && mv "$MARK.$$" "$MARK"
fi
# a green run's logs are read by no one: the directory it made is reclaimed with the run (a red or
# killed run's stays, its evidence; a --merge run's too, the merge log names it; one --out named is its caller's)
if (( ! MERGE )); then (( st == 0 && OWN )) && "$ROOT/bin/remove-tree" "$OUT"; exit $st; fi
merge_verdict "$OUT" $st
