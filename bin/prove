#!/bin/zsh
# bin/prove [--tests | --checks] [NS ...] — run exactly what the change reaches (task
# seon.proofs/prove-runs-what-a-change-reaches, docs/landing.md): every test (of the named
# namespaces) and every bin/check step (seon.proofs/check-steps) whose reach digest has no green
# result in the results directory every checkout shares runs; the rest are reused. An unchanged
# tree runs nothing. Tests run in :seon.config.proofs/jobs shards at once (bin/test); the steps to run go
# through bin/check's own bodies (SEON_CHECK_STEPS), on target/seon built from this tree first.
# Ends on PROVE OK / PROVE FAILED and its exit status. The full runs are explicit:
# bin/test --all, bin/check 100.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
WHAT=both
[[ ${1:-} == --tests || ${1:-} == --checks ]] && { WHAT=${1#--}; shift }
OUT=$ROOT/target/prove
mkdir -p "$OUT"
rm -f "$OUT/steps" "$OUT/steps.edn" "$OUT/green"
st=0
nice -n 15 "$ROOT/bin/test" --prove $WHAT "$OUT" "$@" || st=1
if [[ $WHAT != tests && -s $OUT/steps ]]; then
  # a step's result is keyed by the source it reaches, so it must run the binary built from it
  nice -n 15 "$ROOT/bin/build" seon || { echo "PROVE FAILED (bin/build seon)"; exit 1 }
  SEON_CHECK_STEPS="$(cat "$OUT/steps")" SEON_CHECK_GREEN=$OUT/green "$ROOT/bin/check" 100 || st=1
  nice -n 15 "$ROOT/bin/test" --store-steps "$OUT" || st=1
fi
if (( st == 0 )); then echo "PROVE OK"; else echo "PROVE FAILED"; fi
exit $st
