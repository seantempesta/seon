#!/bin/zsh
# bin/prove [--out DIR] [--tests | --checks] [NS ...] — run exactly what the change reaches (task
# seon.proofs/prove-runs-what-a-change-reaches, docs/merging.md): every test (of the named
# namespaces) and every bin/check step (seon.proofs/check-steps) whose reach digest has no green
# result in the results directory every checkout shares runs; the rest are reused. An unchanged
# tree runs nothing. Tests run in :seon.config.proofs/jobs shards at once (bin/test); the steps to run go
# through bin/check's own bodies (bin/check --steps target/prove), on target/seon built from this tree first
# (bin/test builds it only when a selected test or step reaches the binary: the plan's out/binary).
# With no namespace named, the tests and steps that reach a process of their own (a root, an
# agent, a fork, the binary: seon.program/reach-index's :process?) are left out; they run when
# named (bin/test NS, bin/check MODE) or in the full run (docs/merging.md).
# Ends on PROVE OK / PROVE FAILED and its exit status. The full runs are explicit:
# bin/test --all, bin/check 100.
#
# Each run writes under a directory of its own, target/prove/<run-id> (the run id: a timestamp and
# the process's pid), or the DIR --out names; the run says where on its first line ("prove: run ID,
# logs in DIR"), so two runs on one checkout never overwrite each other's shard files and logs, and
# every reader takes the path from the run. The newest :seon.config.proofs/runs-kept runs are kept
# (test-runner/prune-runs!). Each test's last measured ms is in its cached verdicts (seon.fx/last-ms).
#
# bin/prove --merge — a merge's verification, the one command (docs/merging.md#main-goes-first):
# runs every test and step with no green at its digest, the ones that
# reach a process too (nothing left out, none named by hand: bin/check contracts and bin/check smoke
# are steps of that same run, keyed by digest, never run again beside it); ends on MERGE OK / MERGE
# FAILED from its exit status alone, naming each red and anything that did not run; and prints its line
# for the merge commit's message: the sha, the plan's counts, the verdicts, the reds, the src delta of
# HEAD against its first parent and the keys left out against main's last merge message.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# merge_verdict OUT ST: the merge's one verdict from prove's exit status alone (its steps include
# contracts and smoke), with the reds named from its log in OUT; its line printed for the merge
# commit's message (git keeps every merge's numbers). Exits 0 for MERGE OK. (bin/prove --merge-verdict OUT ST runs it alone.)
merge_verdict() {
  local out=$1 st=$2
  v() { (( $1 == 0 )) && echo OK || echo "FAILED (exit $1)"; }
  local reds=$(grep -hE "^RED |^FAILED " "$out/prove.log" 2>/dev/null | sed -E 's/ \{.*//' | sort -u | tr '\n' ';' | sed 's/;$//')
  local counts=$(grep -E "^prove: [0-9]+ keys" "$out/prove.log" 2>/dev/null | sed -E 's/^prove: //; s/; selected in.*//')
  local merged=$(grep -E "^prove: a merge's verification" "$out/prove.log" 2>/dev/null | sed -E 's/^prove: a merge.s verification: //')
  local srcd
  if git -C "$ROOT" rev-parse -q --verify HEAD^1 >/dev/null; then
    srcd=$(git -C "$ROOT" diff --shortstat HEAD^1 HEAD -- src | sed -E 's/^ *//'); srcd=${srcd:-unchanged}
  else srcd="unknown (no first parent)"; fi
  local left=$(grep -oE "[0-9]+ left out\)?$" "$out/prove.log" 2>/dev/null | tail -1 | grep -oE "[0-9]+")
  local main_left=$(git -C "$ROOT" log --first-parent -50 --format=%B HEAD^1 2>/dev/null | grep -oE "left out [0-9]+" | head -1 | grep -oE "[0-9]+")
  local verdict="MERGE FAILED"
  (( st == 0 )) && verdict="MERGE OK"
  [[ -z $reds && $verdict == "MERGE FAILED" ]] && reds="none named (see the logs in $out)"
  local line="$(git -C "$ROOT" rev-parse --short HEAD) bin/prove --merge $(date '+%Y-%m-%d %H:%M'): $verdict; prove $(v $st) (${counts:-no plan line}; ${merged:-no merge line}); reds: ${reds:-none}; src $srcd; left out ${left:-not measured} (main's last line: ${main_left:-none recorded})"
  echo "$line"
  echo "$verdict"
  [[ $verdict == "MERGE OK" ]]
}
[[ ${1:-} == --merge-verdict ]] && { merge_verdict "$2" "$3"; exit $? }
OUT=
[[ ${1:-} == --out ]] && { OUT=$2; shift 2 }
MERGE=0
[[ ${1:-} == --merge ]] && { MERGE=1; shift }
WHAT=both
[[ ${1:-} == --tests || ${1:-} == --checks ]] && { WHAT=${1#--}; shift }
(( MERGE )) && [[ $WHAT != both ]] && { echo "MERGE FAILED: --merge runs the tests and the checks both (no --$WHAT)"; exit 1 }
if [[ -z $OUT ]]; then
  OUT=$ROOT/target/prove/$(date +%Y%m%dT%H%M%S)-$$
fi
mkdir -p "$OUT"
echo "prove: run ${OUT:t}, logs in $OUT"
st=0
PLAN=(); (( MERGE )) && PLAN=(--merge)
# a subshell: the pipeline's first part, its status the run's (tee keeps the log the merge reads)
(
nice -n 15 "$ROOT/bin/test" --prove $WHAT "$OUT" $PLAN "$@" || st=1
if [[ $WHAT != tests && -s $OUT/steps ]]; then
  # bin/test built target/seon from this tree: a step's result is keyed by the source it reaches
  "$ROOT/bin/check" --steps "$OUT" || st=1
  nice -n 15 "$ROOT/bin/test" --store-steps "$OUT" || st=1
fi
if (( st == 0 )); then echo "PROVE OK"; else echo "PROVE FAILED"; fi
exit $st
) 2>&1 | tee "$OUT/prove.log"
st=${pipestatus[1]}
(( MERGE )) || exit $st
merge_verdict "$OUT" $st
