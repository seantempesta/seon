#!/usr/bin/env bb

;; MCP Server for Seon Agent Evaluation
;;
;; This implements the Model Context Protocol (MCP) over stdio transport.
;; It provides tools for Claude to manage agent sessions and evaluate Clojure
;; code in isolated REPL sessions - without shell escaping issues.
;;
;; Tools:
;;   - agent_eval: Evaluate code in an agent session
;;   - create_session: Create a new agent session
;;   - stop_session: Stop an agent session
;;   - list_sessions: List active sessions
;;
;; Protocol: JSON-RPC 2.0 over stdin/stdout (line-delimited)
;;
;; Usage:
;;   claude mcp add seon-agent ./bin/mcp-server

(require '[cheshire.core :as json]
         '[bencode.core :as b]
         '[clojure.string :as str])

;;; ---------------------------------------------------------------------------
;;; Configuration
;;; ---------------------------------------------------------------------------

(def orchestrator-port 7888)

;; SEON_SESSION_ID env var enforces session isolation for agents.
;; When set, this MCP server only allows evals to that session (not orchestrator).
(def enforced-session-id (System/getenv "SEON_SESSION_ID"))

(def server-info
  {:name "seon"
   :version "0.4.0"})  ;; v0.4.0: Self-healing nREPL sessions + parent watchdog

;; Parent PID at startup - used by watchdog to detect orphaning
(def parent-pid (let [parent (.parent (java.lang.ProcessHandle/current))]
                  (when (.isPresent parent)
                    (.pid (.get parent)))))

;; Track orchestrator eval state to detect concurrent calls.
;; When non-nil, contains {:started-at <ms> :code-preview <str>}
(def orchestrator-eval-state (atom nil))

;; Persistent orchestrator nREPL session ID for interrupt support.
;; Cloned at startup so we can interrupt stuck orchestrator evals.
(def orchestrator-nrepl-session (atom nil))

;;; ---------------------------------------------------------------------------
;;; Async Request Processing (Phase 1 - MCP Resilience)
;;; ---------------------------------------------------------------------------
;;
;; The main loop must stay responsive to process interrupt requests even while
;; a long-running eval is in progress. We achieve this by:
;; 1. Processing tool calls in futures (background threads)
;; 2. Queuing responses for the main loop to send
;; 3. Using non-blocking stdin reads
;;
;; This allows interrupt_eval to be processed immediately even when another
;; eval is blocked waiting for nREPL responses.

;; Response queue - futures push responses here, main loop sends them
;; Each entry is {:id <request-id> :result <mcp-result>} or {:id <request-id> :error <msg>}
(def response-queue (atom []))

;; Currently running eval future for interrupt support
;; Contains {:future <future> :session-id <str> :request-id <id> :started-at <ms>} or nil
(def running-eval (atom nil))

;; Lock for stdout writes to prevent interleaved output from multiple threads
(def stdout-lock (Object.))

(defn log-info [& args]
  "Log info message to stderr."
  (binding [*out* *err*]
    (apply println "[INFO]" (java.time.Instant/now) args)
    (flush)))

;;; ---------------------------------------------------------------------------
;;; Tool Definitions
;;; ---------------------------------------------------------------------------

(def default-timeout-ms 30000) ;; 30 second default timeout

;; Tool definitions change based on whether session is enforced
(def tools
  [{:name "eval"
    :description (if enforced-session-id
                   ;; Agent mode: session is implicit, simpler interface
                   "Evaluate Clojure code in your isolated REPL. Returns result and namespace. Use (user/reload) to reload code, (user/search \"query\") for research."
                   ;; Orchestrator mode: requires explicit session_id
                   "Evaluate Clojure code. Use session_id='orchestrator' for the main REPL, or a 4-char hex session ID for an agent's isolated REPL. Returns result value and current namespace. Use (user/reload) to reload code, (user/search \"query\") for research.")
    :inputSchema (if enforced-session-id
                   ;; Agent mode: no session_id param - it's implicit
                   {:type "object"
                    :properties {:code {:type "string"
                                        :description "Clojure code to evaluate"}
                                 :timeout_ms {:type "integer"
                                              :description "Timeout in milliseconds (default: 30000)"}}
                    :required ["code"]}
                   ;; Orchestrator mode: session_id required
                   {:type "object"
                    :properties {:session_id {:type "string"
                                              :description "'orchestrator' for main REPL, or 4-char hex session ID (e.g., 'a1b2')"}
                                 :code {:type "string"
                                        :description "Clojure code to evaluate"}
                                 :timeout_ms {:type "integer"
                                              :description "Timeout in milliseconds (default: 30000)"}}
                    :required ["session_id" "code"]})}

   {:name "create_session"
    :description "Create a new agent session with an isolated REPL and database. Returns the session_id to use with agent_eval."
    :inputSchema {:type "object"
                  :properties {:namespace {:type "string"
                                           :description "Clojure namespace for the agent (e.g., 'seon.trading')"}}
                  :required ["namespace"]}}

   {:name "stop_session"
    :description "Stop an agent session, flushing any pending state and cleaning up resources."
    :inputSchema {:type "object"
                  :properties {:session_id {:type "string"
                                            :description "4-character hex session ID"}}
                  :required ["session_id"]}}

   {:name "interrupt_eval"
    :description "Interrupt a running evaluation in an agent session. Use when an eval is taking too long or appears hung."
    :inputSchema {:type "object"
                  :properties {:session_id {:type "string"
                                            :description "4-character hex session ID, or 'orchestrator' to interrupt a stuck orchestrator eval"}}
                  :required ["session_id"]}}

   {:name "list_sessions"
    :description "List all active agent sessions with their IDs, namespaces, and ports."
    :inputSchema {:type "object"
                  :properties {}}}

   {:name "query_graph"
    :description "Search the knowledge graph for functions, namespaces, or specs. Use this to discover existing code before writing new code."
    :inputSchema {:type "object"
                  :properties {:query {:type "string"
                                       :description "Search pattern (e.g., 'workout', 'calories', 'seon.health')"}
                               :type {:type "string"
                                      :description "What to search for: 'functions' (default), 'namespaces', or 'context'"
                                      :enum ["functions" "namespaces" "context"]}}
                  :required ["query"]}}

   {:name "namespace_health"
    :description "Get health overview of a namespace: functions, dependencies, test coverage hints."
    :inputSchema {:type "object"
                  :properties {:namespace {:type "string"
                                           :description "Namespace to inspect (e.g., 'seon.health.workout')"}}
                  :required ["namespace"]}}

   {:name "agent_status"
    :description "Get current agent pool status, running sessions, and system health."
    :inputSchema {:type "object"
                  :properties {}}}

   {:name "clojure_replace"
    :description "Edit Clojure/EDN files by matching and replacing s-expressions.
More reliable than string-based Edit - matches structurally, ignoring whitespace.

COMMENT-AWARE: Include comments in match/replace patterns to change them.
- Match without comment: existing comments PRESERVED
- Match with comment: comment must match exactly or fails
- Replace with comment: adds/replaces the comment

Example: Replace code (preserves adjacent comments):
  {\"file_path\": \"src/foo.clj\",
   \"match\": \"(if (nil? x) default x)\",
   \"replace\": \"(or x default)\"}

Example: Replace code AND comment:
  {\"match\": \";; old comment\\n(+ x 10)\",
   \"replace\": \";; new comment\\n(* x 2)\"}

IMPORTANT: If multiple matches found, the edit is REJECTED with all locations.
You must then either:
1. Be more specific (expand match to include context)
2. Use line_start/line_end to target specific occurrence
3. Use replace_all: true if all occurrences should change"
    :inputSchema {:type "object"
                  :properties {:file_path {:type "string"
                                           :description "Path to Clojure/EDN file"}
                               :match {:type "string"
                                       :description "S-expression to find (whitespace-insensitive). Include comments to match/change them."}
                               :replace {:type "string"
                                         :description "S-expression to replace with. Include comments to add/change them."}
                               :line_start {:type "integer"
                                            :description "Only match within this line range (start)"}
                               :line_end {:type "integer"
                                          :description "Only match within this line range (end)"}
                               :replace_all {:type "boolean"
                                             :description "Replace ALL occurrences (required if multiple matches)"}
                               :dry_run {:type "boolean"
                                         :description "Preview changes without writing file"}}
                  :required ["file_path" "match" "replace"]}}])

;;; ---------------------------------------------------------------------------
;;; Logging (to stderr - NEVER stdout!)
;;; ---------------------------------------------------------------------------

(def ^:dynamic *debug* (= "1" (System/getenv "DEBUG")))

(defn log-debug [& args]
  (when *debug*
    (binding [*out* *err*]
      (apply println "[DEBUG]" (java.time.Instant/now) args)
      (flush))))

(defn log-error [& args]
  (binding [*out* *err*]
    (apply println "[ERROR]" (java.time.Instant/now) args)
    (flush)))

;;; ---------------------------------------------------------------------------
;;; nREPL Communication (bencode)
;;; ---------------------------------------------------------------------------

(def connect-timeout-ms 5000) ;; 5 second connection timeout (Phase 4c)

(defn bytes->str
  "Convert bencode byte array to string."
  [x]
  (if (bytes? x)
    (String. ^bytes x "UTF-8")
    x))

(defn decode-msg
  "Decode bencode message, converting byte arrays to strings."
  [msg]
  (into {}
        (map (fn [[k v]]
               [(bytes->str k)
                (if (coll? v)
                  (mapv bytes->str v)
                  (bytes->str v))]))
        msg))

(defn- connect-with-timeout
  "Create a socket connection with explicit timeout (Phase 4c).
   Returns connected Socket or throws."
  [host port timeout-ms]
  (let [addr (java.net.InetSocketAddress. host port)
        sock (java.net.Socket.)]
    (.connect sock addr timeout-ms)
    sock))

(defn nrepl-send-recv
  "Send a message to nREPL and receive all responses until done.
   Returns vector of decoded response messages."
  [sock msg]
  (let [out (java.io.BufferedOutputStream. (.getOutputStream sock))
        in (java.io.PushbackInputStream. (.getInputStream sock))]
    (log-debug "Sending:" (pr-str msg))
    (b/write-bencode out msg)
    (.flush out)
    (loop [responses []]
      (let [resp (decode-msg (b/read-bencode in))
            status (get resp "status")]
        (log-debug "Received:" (pr-str resp))
        (if (and status (some #{"done"} status))
          (conj responses resp)
          (recur (conj responses resp)))))))

(defn nrepl-clone-session
  "Clone an nREPL session to get a persistent session ID.
   Returns the new session ID string, or nil on failure."
  [port]
  (log-debug "nrepl-clone-session port:" port)
  (try
    (with-open [sock (connect-with-timeout "localhost" port connect-timeout-ms)]
      (let [responses (nrepl-send-recv sock {"op" "clone"})
            new-session (some #(get % "new-session") responses)]
        (log-debug "Cloned session:" new-session)
        new-session))
    (catch Exception e
      (log-error "Failed to clone session on port" port ":" (.getMessage e))
      nil)))

(defn nrepl-interrupt
  "Send interrupt to an nREPL session. Returns status from response."
  [port nrepl-session-id]
  (log-debug "nrepl-interrupt port:" port "session:" nrepl-session-id)
  (try
    (with-open [sock (connect-with-timeout "localhost" port connect-timeout-ms)]
      (let [responses (nrepl-send-recv sock {"op" "interrupt" "session" nrepl-session-id})
            status (some #(get % "status") responses)]
        (log-debug "Interrupt status:" status)
        {:status status}))
    (catch Exception e
      (log-error "Failed to interrupt session:" (.getMessage e))
      {:error (.getMessage e)})))

(defn nrepl-eval
  "Evaluate code via nREPL using bencode. Returns {:value :ns :err :out :ex}
   timeout-ms controls how long to wait for responses (default: 30000ms)
   nrepl-session-id - optional persistent nREPL session ID for *1/*2/*3 support"
  ([port code] (nrepl-eval port code default-timeout-ms nil))
  ([port code timeout-ms] (nrepl-eval port code timeout-ms nil))
  ([port code timeout-ms nrepl-session-id]
   (log-debug "nrepl-eval port:" port "timeout:" timeout-ms "session:" nrepl-session-id "code:" (pr-str code))
   (let [timeout-ms (or timeout-ms default-timeout-ms)
         deadline (+ (System/currentTimeMillis) timeout-ms)]
     (try
       (with-open [sock (connect-with-timeout "localhost" port connect-timeout-ms)]
         (let [out (java.io.BufferedOutputStream. (.getOutputStream sock))
               in (java.io.PushbackInputStream. (.getInputStream sock))
               id (str (random-uuid))
               msg-to-send (cond-> {"op" "eval" "code" code "id" id}
                             nrepl-session-id (assoc "session" nrepl-session-id))]
           (log-debug "Sending:" (pr-str msg-to-send))
           (b/write-bencode out msg-to-send)
           (.flush out)
           ;; Read responses until done, tracking total elapsed time
           (loop [result {:value nil :ns nil :err nil :out nil :ex nil}]
             (let [remaining (- deadline (System/currentTimeMillis))]
               (if (<= remaining 0)
                 ;; Total timeout exceeded
                 {:err (str "Timeout after " (/ timeout-ms 1000) "s. "
                            "If you launched an agent, it's still running. "
                            "Check progress: (user/agents) and (user/agent-messages \"id\"). "
                            "Wait for completion: (user/wait-for-agent!! \"id\"). "
                            "For blocking launches, set timeout_ms=600000.")
                  :ex "timeout"}
                 (do
                   ;; Set socket timeout to remaining time (capped at 5 seconds for responsiveness)
                   (.setSoTimeout sock (int (min remaining 5000)))
                   ;; Try to read, handling socket timeout separately from other errors
                   (let [read-result (try
                                       {:msg (decode-msg (b/read-bencode in))}
                                       (catch java.net.SocketTimeoutException _e
                                         {:timeout true}))]
                     (if (:timeout read-result)
                       ;; Socket timed out but deadline not exceeded - keep waiting
                       (recur result)
                       ;; Got a message - process it
                       (let [msg (:msg read-result)
                             status (get msg "status")
                             value (get msg "value")
                             ns-val (get msg "ns")
                             err (get msg "err")
                             stdout (get msg "out")
                             ex (get msg "ex")]
                         (log-debug "Received:" (pr-str msg))
                         (let [result' (cond-> result
                                         value (assoc :value value)
                                         ns-val (assoc :ns ns-val)
                                         err (update :err str err)
                                         stdout (update :out str stdout)
                                         ex (assoc :ex ex)
                                         ;; nREPL returns "unknown-session" when session ID is stale
                                         (and status (some #{"unknown-session"} status))
                                         (assoc :ex "unknown-session"
                                                :err "nREPL session expired (server restarted?)"))]
                           (if (and status (some #{"done"} status))
                             result'
                             (recur result'))))))))))))
       (catch java.net.ConnectException e
         {:err (str "Connection failed to port " port ": " (.getMessage e))})
       (catch Exception e
         (log-debug "Exception:" (class e) (.getMessage e))
         {:err (str "Error: " (.getMessage e))})))))

;;; ---------------------------------------------------------------------------
;;; MCP Result Builders
;;; ---------------------------------------------------------------------------

(defn mcp-success
  "Build an MCP success result with text content."
  [text]
  {:content [{:type "text" :text text}]
   :isError false})

(defn mcp-error
  "Build an MCP error result with text content."
  [text]
  {:content [{:type "text" :text (str "Error: " text)}]
   :isError true})

;;; ---------------------------------------------------------------------------
;;; Session Helpers
;;; ---------------------------------------------------------------------------

(defn get-session-info
  "Query orchestrator for the nREPL port and nREPL session ID of a session.
   Returns {:port <int> :nrepl-session-id <string>} or nil."
  [session-id]
  (let [code (format "(do (require 'seon.orchestrator.session)
                          (let [result (seon.orchestrator.session/get-session-port
                                         {:seon.orchestrator.session/node (user/xtdb-node)
                                          :seon.orchestrator.session/id \"%s\"})]
                            {:port (:seon.orchestrator.session/nrepl-port result)
                             :nrepl-session-id (:seon.orchestrator.session/nrepl-session-id result)}))"
                     session-id)
        result (nrepl-eval orchestrator-port code)]
    (when-let [value (:value result)]
      (when (and value (not= "nil" value) (not= "{:port nil, :nrepl-session-id nil}" value))
        ;; Parse the simple EDN map and validate port is present
        (try
          (let [info (clojure.edn/read-string value)]
            (when (:port info)  ;; Ensure port is non-nil
              info))
          (catch Exception _ nil))))))

(defn validate-session-id! [session-id]
  (when-not (re-matches #"[a-f0-9]{4}" session-id)
    (throw (ex-info (str "Invalid session ID: " session-id ". Must be 4 lowercase hex characters.")
                    {:session_id session-id}))))

;;; ---------------------------------------------------------------------------
;;; Tool Execution
;;; ---------------------------------------------------------------------------

(defn- record-activity!
  "Record eval activity start or completion for a session (Phase 4c).
   action is :start or :complete"
  [session-id action code]
  (when (and session-id (not= session-id "orchestrator"))
    (let [fn-name (if (= action :start)
                    "record-eval-start!"
                    "record-eval-complete!")
          activity-code (if (= action :start)
                          (format "(seon.orchestrator.session/%s {:seon.orchestrator.session/id \"%s\"
                                                                   :seon.orchestrator.session/code %s})"
                                  fn-name session-id (pr-str code))
                          (format "(seon.orchestrator.session/%s {:seon.orchestrator.session/id \"%s\"})"
                                  fn-name session-id))]
      ;; Fire and forget - don't block on activity tracking
      (try
        (nrepl-eval orchestrator-port activity-code 1000)
        (catch Exception e
          (log-debug "Activity tracking failed:" (.getMessage e)))))))

(defn- truncate-code-preview
  "Truncate code to a short preview for error messages."
  [code max-len]
  (let [s (str/trim (str code))]
    (if (> (count s) max-len)
      (str (subs s 0 max-len) "...")
      s)))

(defn execute-eval
  "Execute the eval tool. Returns MCP result format.
   For agent sessions (not orchestrator), tracks activity for observability (Phase 4c).
   Uses persistent nREPL session ID for *1/*2/*3 support.

   When SEON_SESSION_ID env var is set, session_id param is ignored and the
   enforced session is used instead (agent isolation).

   For orchestrator session: detects concurrent evals to prevent lockup when
   user cancels MCP call mid-eval. Returns error if orchestrator already busy."
  [{:keys [session_id code timeout_ms]}]
  ;; Use enforced session if set, otherwise use provided session_id
  (let [effective-session (or enforced-session-id session_id)]
    (log-debug "execute-eval session:" effective-session
               "(enforced:" enforced-session-id "provided:" session_id ")"
               "timeout:" timeout_ms)

    ;; For orchestrator: atomically check-and-set eval state to prevent race conditions
    (when (= effective-session "orchestrator")
      (let [new-state {:started-at (System/currentTimeMillis)
                       :code-preview (truncate-code-preview code 50)}]
        (when-not (compare-and-set! orchestrator-eval-state nil new-state)
          ;; Failed to set - another eval is running
          (let [running @orchestrator-eval-state
                elapsed-sec (quot (- (System/currentTimeMillis) (:started-at running)) 1000)
                warning (when (> elapsed-sec 120)
                          " WARNING: Running >2min - may be stuck.")]
            (throw (ex-info (str "Orchestrator busy (running for " elapsed-sec "s)." warning "\n"
                                 "Code: `" (:code-preview running) "`\n"
                                 "Options:\n"
                                 "  1. Wait for completion\n"
                                 "  2. interrupt_eval(session_id=\"orchestrator\") to unblock\n"
                                 "  3. Restart server if interrupt fails")
                            {:busy true :elapsed-sec elapsed-sec}))))))

    (let [[port nrepl-session-id]
          (if (= effective-session "orchestrator")
            [orchestrator-port @orchestrator-nrepl-session]
            (do
              (validate-session-id! effective-session)
              (if-let [info (get-session-info effective-session)]
                [(:port info) (:nrepl-session-id info)]
                (throw (ex-info (str "Session not found or not running: " effective-session)
                                {:session_id effective-session})))))]

      (try
        ;; Record eval start for agent sessions (Phase 4c)
        (record-activity! effective-session :start code)

        (let [result (nrepl-eval port code (or timeout_ms default-timeout-ms) nrepl-session-id)]
          (log-debug "Eval result:" (pr-str result))

          ;; Auto-interrupt on timeout (Phase 0.5) - the eval thread continues running
          ;; after timeout, so we send an interrupt to kill it
          (when (and (= (:ex result) "timeout") nrepl-session-id)
            (log-debug "Timeout detected, sending interrupt to session:" nrepl-session-id)
            (nrepl-interrupt port nrepl-session-id))

          ;; Record eval complete for agent sessions (Phase 4c)
          (record-activity! effective-session :complete nil)

          (if (:ex result)
            (mcp-error (:err result))
            (mcp-success (str (when-let [out (:out result)]
                                out)
                              (or (:value result) "nil")
                              (when-let [ns (:ns result)]
                                (str "\n;; ns: " ns))))))

        (finally
          ;; Always clear orchestrator state when done
          (when (= effective-session "orchestrator")
            (reset! orchestrator-eval-state nil)))))))

(defn execute-create-session
  "Execute the create_session tool.
   After creating the session, clones an nREPL session for persistent *1/*2/*3 support
   and stores it in the session registry."
  [{:keys [namespace]}]
  (log-debug "execute-create-session namespace:" namespace)

  ;; First, create the session in Seon
  (let [code (format "(do (require 'seon.orchestrator.session)
                          (let [result (seon.orchestrator.session/start-agent-session!
                                         {:seon.orchestrator.session/node (user/xtdb-node)
                                          :seon.orchestrator.session/namespace '%s})]
                            {:session_id (:seon.orchestrator.session/id result)
                             :namespace '%s
                             :nrepl_port (:seon.orchestrator.session/nrepl-port result)
                             :status (name (:seon.orchestrator.session/status result))}))"
                     namespace namespace)
        result (nrepl-eval orchestrator-port code)]

    (log-debug "Create session result:" (pr-str result))

    (if (:ex result)
      (mcp-error (str "creating session: " (:err result)))

      ;; Session created, now clone nREPL session for persistence
      (let [session-info (try (clojure.edn/read-string (:value result)) (catch Exception _ nil))
            port (:nrepl_port session-info)
            session-id (:session_id session-info)]
        (if (and port session-id)
          ;; Clone nREPL session
          (let [nrepl-session-id (nrepl-clone-session port)]
            (log-debug "Cloned nREPL session:" nrepl-session-id "for session:" session-id)

            ;; Store the nREPL session ID in the Seon session registry
            (when nrepl-session-id
              (let [store-code (format "(seon.orchestrator.session/set-nrepl-session-id!
                                          {:seon.orchestrator.session/id \"%s\"
                                           :seon.orchestrator.session/nrepl-session-id \"%s\"})"
                                       session-id nrepl-session-id)]
                (nrepl-eval orchestrator-port store-code 5000)))

            ;; Return session info with nrepl_session_id
            (mcp-success (pr-str (assoc session-info :nrepl_session_id nrepl-session-id))))

          ;; Failed to parse session info, return original
          (mcp-success (:value result)))))))

(defn execute-stop-session
  "Execute the stop_session tool."
  [{:keys [session_id]}]
  (log-debug "execute-stop-session session:" session_id)
  (validate-session-id! session_id)

  (let [code (format "(do (require 'seon.orchestrator.session)
                          (let [result (seon.orchestrator.session/stop-agent-session!
                                         {:seon.orchestrator.session/node (user/xtdb-node)
                                          :seon.orchestrator.session/id \"%s\"})]
                            {:session_id (:seon.orchestrator.session/id result)
                             :status (name (:seon.orchestrator.session/status result))}))"
                     session_id)
        result (nrepl-eval orchestrator-port code)]

    (log-debug "Stop session result:" (pr-str result))

    (if (:ex result)
      (mcp-error (str "stopping session: " (:err result)))
      (mcp-success (:value result)))))

(defn- cancel-running-future-if!
  "Cancel the running eval future if it matches the given session."
  [session-id]
  (when-let [running @running-eval]
    (when (or (= session-id (:session-id running))
              (and (= session-id "orchestrator")
                   (= "orchestrator" (:session-id running))))
      (log-info "Cancelling running future for session:" session-id)
      (future-cancel (:future running))
      (reset! running-eval nil))))

(defn- interrupt-orchestrator
  "Interrupt the orchestrator nREPL session. Returns MCP result."
  []
  (if-let [nrepl-session-id @orchestrator-nrepl-session]
    (let [result (nrepl-interrupt orchestrator-port nrepl-session-id)]
      ;; Clear the eval state since we're interrupting
      (reset! orchestrator-eval-state nil)
      (if (:error result)
        (mcp-error (str "interrupting orchestrator: " (:error result)))
        (mcp-success (str "Orchestrator interrupt sent. Status: " (pr-str (:status result))
                          ". The REPL should be responsive now."))))
    (mcp-error "No orchestrator nREPL session available. MCP server may need restart.")))

(defn- interrupt-agent-session
  "Interrupt an agent nREPL session. Returns MCP result."
  [session-id]
  (validate-session-id! session-id)
  (if-let [info (get-session-info session-id)]
    (let [port (:port info)
          nrepl-session-id (:nrepl-session-id info)]
      (if nrepl-session-id
        (let [result (nrepl-interrupt port nrepl-session-id)]
          (if (:error result)
            (mcp-error (str "interrupting: " (:error result)))
            (mcp-success (str "Interrupt sent. Status: " (pr-str (:status result))))))
        (mcp-error "Session has no persistent nREPL session ID. Cannot interrupt ephemeral sessions.")))
    (mcp-error (str "Session not found: " session-id))))

(defn execute-interrupt-eval
  "Execute the interrupt_eval tool.
   Sends an interrupt to the nREPL session for the given Seon session.
   Also cancels any running future in the MCP server.
   Supports session_id='orchestrator' to interrupt stuck orchestrator evals."
  [{:keys [session_id]}]
  (log-debug "execute-interrupt-eval session:" session_id)
  (cancel-running-future-if! session_id)
  (if (= session_id "orchestrator")
    (interrupt-orchestrator)
    (interrupt-agent-session session_id)))

(defn execute-list-sessions
  "Execute the list_sessions tool.
   Returns session info including observability data (Phase 4c):
   - uptime_seconds: how long the session has been running
   - last_activity_at: when the last eval completed
   - eval_count: total evals in this session
   - current_eval: info about currently running eval (if any)
   - nrepl_session_id: persistent nREPL session ID for debugging"
  [_args]
  (log-debug "execute-list-sessions")

  ;; The Clojure code calculates uptime_seconds from started_at and formats dates
  (let [code "(do (require 'seon.orchestrator.session)
                  (let [now (System/currentTimeMillis)
                        sessions (seon.orchestrator.session/list-agent-sessions
                                   {:seon.orchestrator.session/node (user/xtdb-node)})]
                    (mapv (fn [s]
                            (let [started-at (:seon.orchestrator.session/started-at s)
                                  uptime-ms (when started-at
                                              (- now (.getTime ^java.util.Date started-at)))]
                              (cond-> {:session_id (:seon.orchestrator.session/id s)
                                       :namespace (str (:seon.orchestrator.session/namespace s))
                                       :nrepl_port (:seon.orchestrator.session/nrepl-port s)
                                       :status (name (:seon.orchestrator.session/status s))}
                                uptime-ms
                                (assoc :uptime_seconds (quot uptime-ms 1000))

                                (:seon.orchestrator.session/nrepl-session-id s)
                                (assoc :nrepl_session_id
                                       (:seon.orchestrator.session/nrepl-session-id s))

                                (:seon.orchestrator.session/last-activity-at s)
                                (assoc :last_activity_at
                                       (str (:seon.orchestrator.session/last-activity-at s)))

                                (:seon.orchestrator.session/eval-count s)
                                (assoc :eval_count
                                       (:seon.orchestrator.session/eval-count s))

                                (:seon.orchestrator.session/current-eval s)
                                (assoc :current_eval
                                       {:code (:seon.orchestrator.session/code
                                                (:seon.orchestrator.session/current-eval s))
                                        :started_at
                                        (str (:seon.orchestrator.session/started-at
                                               (:seon.orchestrator.session/current-eval s)))}))))
                          sessions)))"
        result (nrepl-eval orchestrator-port code)]

    (log-debug "List sessions result:" (pr-str result))

    (if (:ex result)
      (mcp-error (str "listing sessions: " (:err result)))
      (mcp-success (if (= "[]" (:value result))
                     "No active sessions"
                     (:value result))))))

(defn execute-query-graph
  "Execute the query_graph tool. Searches the knowledge graph."
  [{:keys [query type]}]
  (let [type (or type "functions")
        code (case type
               "functions"
               (format "(do (require 'seon.graph.query 'seon.db.datalevin.conn)
                            (let [mgr (:seon/connection-manager integrant.repl.state/system)
                                  conn (seon.db.datalevin.conn/get-master-conn!
                                         {:seon.db.datalevin.conn/manager mgr})]
                              (pr-str (seon.graph.query/search-functions
                                        {:seon.graph.query/conn conn
                                         :seon.graph.query/pattern %s}))))"
                       (pr-str query))

               "namespaces"
               (format "(do (require 'seon.graph.query 'seon.db.datalevin.conn)
                            (let [mgr (:seon/connection-manager integrant.repl.state/system)
                                  conn (seon.db.datalevin.conn/get-master-conn!
                                         {:seon.db.datalevin.conn/manager mgr})]
                              (pr-str {:dependents (seon.graph.query/dependents-of
                                                     {:seon.graph.query/conn conn
                                                      :seon.graph.query/ns-name %s})
                                       :dependencies (seon.graph.query/dependencies-of
                                                       {:seon.graph.query/conn conn
                                                        :seon.graph.query/ns-name %s})})))"
                       (pr-str query) (pr-str query))

               "context"
               (format "(do (require 'seon.repl.context 'seon.db.datalevin.conn)
                            (let [mgr (:seon/connection-manager integrant.repl.state/system)
                                  conn (seon.db.datalevin.conn/get-master-conn!
                                         {:seon.db.datalevin.conn/manager mgr})]
                              (seon.repl.context/for-function
                                {:seon.repl.context/conn conn
                                 :seon.repl.context/qualified-name %s})))"
                       (pr-str query)))
        result (nrepl-eval orchestrator-port code)]
    (if (:ex result)
      (mcp-error (str "query_graph failed: " (:err result)))
      (mcp-success (or (:value result) "nil")))))

(defn execute-namespace-health
  "Execute the namespace_health tool. Gets namespace overview."
  [{:keys [namespace]}]
  (let [code (format "(do (require 'seon.repl.context 'seon.graph.query 'seon.db.datalevin.conn)
                          (let [mgr (:seon/connection-manager integrant.repl.state/system)
                                conn (seon.db.datalevin.conn/get-master-conn!
                                       {:seon.db.datalevin.conn/manager mgr})
                                ctx (seon.repl.context/for-namespace
                                      {:seon.repl.context/conn conn
                                       :seon.repl.context/namespace %s})
                                fns (seon.graph.query/functions-in-ns
                                      {:seon.graph.query/conn conn
                                       :seon.graph.query/ns-name %s})
                                deps (seon.graph.query/dependencies-of
                                       {:seon.graph.query/conn conn
                                        :seon.graph.query/ns-name %s})
                                dependents (seon.graph.query/dependents-of
                                             {:seon.graph.query/conn conn
                                              :seon.graph.query/ns-name %s})]
                            (str ctx
                                 \"\\n\\n## Summary\\n\"
                                 \"Functions: \" (count fns) \"\\n\"
                                 \"Dependencies: \" (count deps) \"\\n\"
                                 \"Dependents: \" (count dependents))))"
                     (pr-str namespace) (pr-str namespace)
                     (pr-str namespace) (pr-str namespace))
        result (nrepl-eval orchestrator-port code)]
    (if (:ex result)
      (mcp-error (str "namespace_health failed: " (:err result)))
      (mcp-success (or (:value result) "nil")))))

(defn execute-agent-status
  "Execute the agent_status tool. Returns system health."
  [_args]
  (let [code "(user/status)"
        result (nrepl-eval orchestrator-port code)]
    (if (:ex result)
      (mcp-error (str "agent_status failed: " (:err result)))
      (mcp-success (or (:value result) "nil")))))

(defn- run-hook-pipeline!
  "Run the hook pipeline after a successful clojure_replace.
   Returns {:feedback [...] :blocked bool :reason str} or nil on error."
  [file-path]
  (let [code (format "(do (require 'seon.dev.hook)
                          (seon.dev.hook/process-mcp-edit!
                            #:seon.dev.hook{:file-path %s}))"
                     (pr-str file-path))
        result (nrepl-eval orchestrator-port code 60000)]
    (when-not (:ex result)
      (try
        (let [parsed (clojure.edn/read-string (:value result))]
          {:feedback (:seon.dev.hook/feedback parsed)
           :blocked (:seon.dev.hook/blocked parsed)
           :reason (:seon.dev.hook/reason parsed)})
        (catch Exception _ nil)))))

(defn execute-clojure-replace
  "Execute the clojure_replace tool via nREPL.
   Calls seon.dev.clojure-replace/replace-sexp! on the orchestrator.
   On success (non-dry-run), also runs the hook pipeline for reload/tests/review."
  [{:keys [file_path match replace line_start line_end replace_all dry_run]}]
  (log-debug "execute-clojure-replace file:" file_path "match:" match)

  (let [code (format "(do (require 'seon.dev.clojure-replace)
                          (seon.dev.clojure-replace/replace-sexp!
                            #:seon.dev.clojure-replace{:file-path %s
                                                       :match %s
                                                       :replace %s
                                                       :line-start %s
                                                       :line-end %s
                                                       :replace-all? %s
                                                       :dry-run? %s}))"
                     (pr-str file_path)
                     (pr-str match)
                     (pr-str replace)
                     (if line_start (str line_start) "nil")
                     (if line_end (str line_end) "nil")
                     (if replace_all "true" "false")
                     (if dry_run "true" "false"))
        result (nrepl-eval orchestrator-port code 30000)]

    (log-debug "Clojure replace result:" (pr-str result))

    (if (:ex result)
      (mcp-error (str "clojure_replace failed: " (:err result)))

      ;; Parse the EDN result and format appropriately
      (let [parsed (try (clojure.edn/read-string (:value result)) (catch Exception _ nil))]
        (if (and parsed (:seon.dev.clojure-replace/success parsed))
          ;; Success - run hook pipeline if not dry-run
          (let [edit-msg (str (:seon.dev.clojure-replace/message parsed)
                              "\n\n"
                              (:seon.dev.clojure-replace/diff parsed))
                hook-result (when-not dry_run
                              (run-hook-pipeline! file_path))]
            (if (and hook-result (:blocked hook-result))
              ;; Hook blocked the edit (tests failed, etc.)
              (mcp-error (str edit-msg "\n\n--- Hook Pipeline ---\n"
                              "BLOCKED: " (:reason hook-result)
                              (when-let [fb (:feedback hook-result)]
                                (str "\n" (str/join "\n" fb)))))
              ;; Success - include hook feedback
              (mcp-success (str edit-msg
                                (when-let [fb (seq (:feedback hook-result))]
                                  (str "\n\n--- Hook Pipeline ---\n"
                                       (str/join "\n" fb)))))))
          ;; Error case - include match locations if available
          (let [error-msg (:seon.dev.clojure-replace/error parsed)
                matches (:seon.dev.clojure-replace/matches parsed)]
            (if matches
              (mcp-error (str error-msg "\n\nMatches found:\n"
                              (str/join "\n"
                                        (map-indexed
                                         (fn [i m]
                                           (format "  %d. Line %d, Col %d: %s"
                                                   (inc i)
                                                   (:seon.dev.clojure-replace/line m)
                                                   (:seon.dev.clojure-replace/column m)
                                                   (:seon.dev.clojure-replace/context m)))
                                         matches))))
              (mcp-error (or error-msg "Unknown error")))))))))

;;; ---------------------------------------------------------------------------
;;; JSON-RPC Message Handling
;;; ---------------------------------------------------------------------------

(defn send-response
  "Send a JSON-RPC response to stdout.
   Thread-safe - uses stdout-lock to prevent interleaved output."
  [response]
  (let [json-str (json/generate-string response)]
    (log-debug "Sending response:" json-str)
    (locking stdout-lock
      (println json-str)
      (flush))))

(defn send-result
  "Send a successful JSON-RPC result."
  [id result]
  (send-response {:jsonrpc "2.0"
                  :id id
                  :result result}))

(defn send-error
  "Send a JSON-RPC error."
  [id code message & [data]]
  (send-response {:jsonrpc "2.0"
                  :id id
                  :error (cond-> {:code code :message message}
                           data (assoc :data data))}))

(defn handle-initialize
  "Handle the initialize request."
  [id _params]
  (log-debug "Handling initialize")
  (send-result id
               {:protocolVersion "2024-11-05"
                :capabilities {:tools {}}
                :serverInfo server-info}))

(defn handle-tools-list
  "Handle tools/list request."
  [id _params]
  (log-debug "Handling tools/list")
  (send-result id {:tools tools}))

(defn- queue-response!
  "Queue a response to be sent by the main loop."
  [id result]
  (swap! response-queue conj {:id id :result result}))

(defn- queue-error!
  "Queue an error response to be sent by the main loop."
  [id message]
  (swap! response-queue conj {:id id :error message}))

(defn- execute-tool-sync
  "Execute a tool synchronously. Returns MCP result or throws."
  [name arguments]
  (case name
    "eval" (execute-eval arguments)
    "create_session" (execute-create-session arguments)
    "stop_session" (execute-stop-session arguments)
    "interrupt_eval" (execute-interrupt-eval arguments)
    "list_sessions" (execute-list-sessions arguments)
    "clojure_replace" (execute-clojure-replace arguments)
    "query_graph" (execute-query-graph arguments)
    "namespace_health" (execute-namespace-health arguments)
    "agent_status" (execute-agent-status arguments)
    (throw (ex-info (str "Unknown tool: " name) {:tool name}))))

(defn- blocking-tool?
  "Returns true if this tool might block for a long time."
  [name]
  (contains? #{"eval" "create_session"} name))

(defn handle-tools-call
  "Handle tools/call request.
   Blocking tools (eval, create_session) run in a future so the main loop
   stays responsive for interrupt requests."
  [id {:keys [name arguments]}]
  (log-debug "Handling tools/call name:" name "arguments:" (pr-str arguments))

  (if (blocking-tool? name)
    ;; Run potentially blocking tools in a future
    (let [session-id (or (:session_id arguments) enforced-session-id "unknown")
          f (future
              (try
                (let [result (execute-tool-sync name arguments)]
                  (queue-response! id result))
                (catch clojure.lang.ExceptionInfo e
                  (queue-response! id (mcp-error (ex-message e))))
                (catch Exception e
                  (log-error "Tool execution failed:" (.getMessage e))
                  (queue-response! id (mcp-error (.getMessage e))))
                (finally
                  ;; Clear running-eval when done
                  (reset! running-eval nil))))]
      ;; Track the running eval for interrupt support
      (reset! running-eval {:future f
                            :session-id session-id
                            :request-id id
                            :started-at (System/currentTimeMillis)})
      (log-debug "Started async tool execution for" name "session:" session-id))

    ;; Run quick tools synchronously (interrupt, list, stop)
    (try
      (let [result (execute-tool-sync name arguments)]
        (send-result id result))
      (catch clojure.lang.ExceptionInfo e
        (send-result id (mcp-error (ex-message e))))
      (catch Exception e
        (log-error "Tool execution failed:" (.getMessage e))
        (send-result id (mcp-error (.getMessage e)))))))

(defn handle-notifications-initialized
  "Handle the initialized notification (no response needed)."
  [_params]
  (log-debug "Received initialized notification"))

(defn handle-request
  "Route a JSON-RPC request to the appropriate handler."
  [{:keys [jsonrpc method params id] :as request}]
  (log-debug "Received request:" (pr-str request))

  (if (not= jsonrpc "2.0")
    (when id
      (send-error id -32600 "Invalid Request: missing or invalid jsonrpc version"))
    (case method
      "initialize" (handle-initialize id params)
      "notifications/initialized" (handle-notifications-initialized params)
      "tools/list" (handle-tools-list id params)
      "tools/call" (handle-tools-call id params)
      (when id
        (send-error id -32601 (str "Method not found: " method))))))

;;; ---------------------------------------------------------------------------
;;; Main Loop
;;; ---------------------------------------------------------------------------

(defn- flush-response-queue!
  "Send all queued responses. Called from main loop."
  []
  (let [responses @response-queue]
    (when (seq responses)
      (reset! response-queue [])
      (doseq [{:keys [id result error]} responses]
        (if error
          (send-result id (mcp-error error))
          (send-result id result))))))

(defn- init-orchestrator-session!
  "Initialize connection to orchestrator and clone a persistent nREPL session.
   Returns true if successful, false otherwise."
  []
  (try
    (let [result (nrepl-eval orchestrator-port "(+ 1 1)")]
      (if (= "2" (:value result))
        (do
          (log-debug "Orchestrator connection verified")
          ;; Clone a persistent session for interrupt support
          (if-let [session-id (nrepl-clone-session orchestrator-port)]
            (do
              (reset! orchestrator-nrepl-session session-id)
              (log-debug "Cloned orchestrator nREPL session:" session-id)
              true)
            (do
              (log-error "Failed to clone orchestrator nREPL session - interrupts won't work")
              false)))
        (do
          (log-error "Orchestrator connection test failed:" result)
          false)))
    (catch Exception e
      (log-error "Cannot connect to orchestrator on port" orchestrator-port ":" (.getMessage e))
      false)))

(defn -main
  "Main entry point. Read JSON-RPC from stdin, process, write to stdout.

   Uses non-blocking reads so the main loop can:
   1. Process interrupt requests even while an eval is running
   2. Flush queued responses from background futures

   This fixes the MCP resilience issue where cancelling an eval would
   brick the entire MCP server."
  []
  (log-info "MCP Server v0.3.0 starting (async mode)...")
  (init-orchestrator-session!)

  ;; Main message loop - non-blocking to stay responsive
  (let [reader (java.io.BufferedReader. *in*)]
    (loop [iterations 0]
      ;; 1. Flush any pending responses from background futures
      (flush-response-queue!)

      ;; 2. Check for and process incoming requests (non-blocking)
      (let [has-input (.ready reader)]
        (when has-input
          (if-let [line (.readLine reader)]
            (when-not (str/blank? line)
              (try
                (let [request (json/parse-string line true)]
                  (handle-request request))
                (catch Exception e
                  (log-error "Parse error:" (.getMessage e) "line:" line)
                  (send-error nil -32700 "Parse error"))))
            ;; readLine returned nil - EOF
            (do
              (log-info "Stdin closed, shutting down")
              (System/exit 0)))))

      ;; 3. Small sleep to prevent busy-looping (10ms = 100 checks/sec)
      (Thread/sleep 10)

      ;; 4. Periodic health logging (every ~30 seconds)
      (when (and *debug* (zero? (mod iterations 3000)))
        (log-debug "Main loop healthy, iterations:" iterations
                   "running-eval:" (boolean @running-eval)
                   "queued-responses:" (count @response-queue)))

      (recur (inc iterations))))

  (log-info "MCP Server shutting down"))

(-main)
