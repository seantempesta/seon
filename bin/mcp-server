#!/usr/bin/env bb

;; MCP Server for Seon Agent Evaluation
;;
;; This implements the Model Context Protocol (MCP) over stdio transport.
;; It provides tools for Claude to manage agent sessions and evaluate Clojure
;; code in isolated REPL sessions - without shell escaping issues.
;;
;; Tools:
;;   - agent_eval: Evaluate code in an agent session
;;   - create_session: Create a new agent session
;;   - stop_session: Stop an agent session
;;   - list_sessions: List active sessions
;;
;; Protocol: JSON-RPC 2.0 over stdin/stdout (line-delimited)
;;
;; Usage:
;;   claude mcp add seon-agent ./bin/mcp-server

(require '[cheshire.core :as json]
         '[bencode.core :as b]
         '[clojure.string :as str])

;;; ---------------------------------------------------------------------------
;;; Configuration
;;; ---------------------------------------------------------------------------

(def orchestrator-port 7888)

;; SEON_SESSION_ID env var enforces session isolation for agents.
;; When set, this MCP server only allows evals to that session (not orchestrator).
(def enforced-session-id (System/getenv "SEON_SESSION_ID"))

(def server-info
  {:name "seon"
   :version "0.5.0"})  ;; v0.5.0: Auto-save REPL results to user/*repl-<session>* + truncate large output

;; Parent PID at startup - used by watchdog to detect orphaning
(def parent-pid (let [parent (.parent (java.lang.ProcessHandle/current))]
                  (when (.isPresent parent)
                    (.pid (.get parent)))))

;; Whether the orchestrator init (nREPL connectivity + session clone) has completed.
;; Tools that need the orchestrator session check this before proceeding.
(def orchestrator-init-ready? (atom false))

;; Last pre-flight error (if any) — surfaced in tool responses when the
;; orchestrator nREPL is unreachable or returned an unexpected response.
;; Wave 4a hit `FileNotFoundException: seon/orchestrator/session__init.class`
;; from sibling-worktree breakage; the original `(+ 1 1)` preflight obscured
;; that with "REPL broken" — we now capture the actual exception text.
(def preflight-error (atom nil))

;;; ---------------------------------------------------------------------------
;;; Async Request Processing (Phase 1 - MCP Resilience)
;;; ---------------------------------------------------------------------------
;;
;; The main loop must stay responsive to process interrupt requests even while
;; a long-running eval is in progress. We achieve this by:
;; 1. Processing tool calls in futures (background threads)
;; 2. Queuing responses for the main loop to send
;; 3. Using non-blocking stdin reads
;;
;; This allows interrupt_eval to be processed immediately even when another
;; eval is blocked waiting for nREPL responses.

;; Response queue - futures push responses here, main loop sends them
;; Each entry is {:id <request-id> :result <mcp-result>} or {:id <request-id> :error <msg>}
(def response-queue (atom []))

;; Currently running eval future for interrupt support
;; Contains {:future <future> :session-id <str> :request-id <id> :started-at <ms>} or nil
(def running-eval (atom nil))

;; Lock for stdout writes to prevent interleaved output from multiple threads
(def stdout-lock (Object.))

(defn log-info [& args]
  "Log info message to stderr."
  (binding [*out* *err*]
    (apply println "[INFO]" (java.time.Instant/now) args)
    (flush)))

;;; ---------------------------------------------------------------------------
;;; Tool Definitions
;;; ---------------------------------------------------------------------------

(def default-timeout-ms 30000) ;; 30 second default timeout
(def max-eval-output-chars 2000)   ;; truncate nREPL :value beyond this
(def truncated-preview-chars 1500) ;; how much to show when truncated
(def full-output-prefix "#_:full ")  ;; prefix code with this to skip truncation

;; Tool definitions change based on whether session is enforced
(def tools
  [{:name "eval"
    :description (if enforced-session-id
                   ;; Agent mode: session is implicit, simpler interface
                   "Evaluate Clojure code in your isolated REPL. Returns result and namespace. Use (user/reload) to reload code, (user/search \"query\") for research."
                   ;; Orchestrator mode: requires explicit session_id
                   "Evaluate Clojure code. Use session_id='orchestrator' for the main REPL (each eval runs in its own fresh nREPL session), or ':seon.agent/<id>' to scope the eval to a V2 agent's session conn. Returns result value and current namespace. Use (user/reload) to reload code, (user/search \"query\") for research.")
    :inputSchema (if enforced-session-id
                   ;; Agent mode: no session_id param - it's implicit
                   {:type "object"
                    :properties {:code {:type "string"
                                        :description "Clojure code to evaluate"}
                                 :timeout_ms {:type "integer"
                                              :description "Timeout in milliseconds (default: 30000)"}}
                    :required ["code"]}
                   ;; Orchestrator mode: session_id required
                   {:type "object"
                    :properties {:session_id {:type "string"
                                              :description "'orchestrator' for main REPL, or ':seon.agent/<id>' for an agent-scoped eval"}
                                 :code {:type "string"
                                        :description "Clojure code to evaluate"}
                                 :timeout_ms {:type "integer"
                                              :description "Timeout in milliseconds (default: 30000)"}}
                    :required ["session_id" "code"]})}

   {:name "create_session"
    :description "RETIRED — isolated agent-pool sessions were removed 2026-06-09. Use session_id 'orchestrator' (each eval already runs in its own fresh nREPL session) or ':seon.agent/<id>' for agent-scoped evals. This tool now returns a guiding error."
    :inputSchema {:type "object"
                  :properties {:namespace {:type "string"
                                           :description "Clojure namespace for the agent (e.g., 'seon.trading')"}}
                  :required ["namespace"]}}

   {:name "stop_session"
    :description "RETIRED — isolated agent-pool sessions were removed 2026-06-09. There is nothing to stop; this tool now returns a guiding error."
    :inputSchema {:type "object"
                  :properties {:session_id {:type "string"
                                            :description "session ID (retired)"}}
                  :required ["session_id"]}}

   {:name "interrupt_eval"
    :description "No-op for 'orchestrator'/':seon.agent/<id>' evals — each runs in its own per-eval nREPL session with a hard timeout and self-clears on expiry."
    :inputSchema {:type "object"
                  :properties {:session_id {:type "string"
                                            :description "'orchestrator' (no-op; per-eval sessions self-clear)"}}
                  :required ["session_id"]}}

   {:name "list_sessions"
    :description "List all active agent sessions with their IDs, namespaces, and ports."
    :inputSchema {:type "object"
                  :properties {}}}

   {:name "query_graph"
    :description "Search the knowledge graph for functions, namespaces, or specs. Use this to discover existing code before writing new code."
    :inputSchema {:type "object"
                  :properties {:query {:type "string"
                                       :description "Search pattern (e.g., 'workout', 'calories', 'seon.health')"}
                               :type {:type "string"
                                      :description "What to search for: 'functions' (default), 'namespaces', or 'context'"
                                      :enum ["functions" "namespaces" "context"]}}
                  :required ["query"]}}

   {:name "namespace_health"
    :description "Get health overview of a namespace: functions, dependencies, test coverage hints."
    :inputSchema {:type "object"
                  :properties {:namespace {:type "string"
                                           :description "Namespace to inspect (e.g., 'seon.health.workout')"}}
                  :required ["namespace"]}}

   {:name "agent_status"
    :description "Get current agent pool status, running sessions, and system health."
    :inputSchema {:type "object"
                  :properties {}}}

   {:name "clojure_replace"
    :description "Edit Clojure/EDN files by matching and replacing s-expressions.
More reliable than string-based Edit - matches structurally, ignoring whitespace.

COMMENT-AWARE: Include comments in match/replace patterns to change them.
- Match without comment: existing comments PRESERVED
- Match with comment: comment must match exactly or fails
- Replace with comment: adds/replaces the comment

Example: Replace code (preserves adjacent comments):
  {\"file_path\": \"src/foo.clj\",
   \"match\": \"(if (nil? x) default x)\",
   \"replace\": \"(or x default)\"}

Example: Replace code AND comment:
  {\"match\": \";; old comment\\n(+ x 10)\",
   \"replace\": \";; new comment\\n(* x 2)\"}

IMPORTANT: If multiple matches found, the edit is REJECTED with all locations.
You must then either:
1. Be more specific (expand match to include context)
2. Use line_start/line_end to target specific occurrence
3. Use replace_all: true if all occurrences should change"
    :inputSchema {:type "object"
                  :properties {:file_path {:type "string"
                                           :description "Path to Clojure/EDN file"}
                               :match {:type "string"
                                       :description "S-expression to find (whitespace-insensitive). Include comments to match/change them."}
                               :replace {:type "string"
                                         :description "S-expression to replace with. Include comments to add/change them."}
                               :line_start {:type "integer"
                                            :description "Only match within this line range (start)"}
                               :line_end {:type "integer"
                                          :description "Only match within this line range (end)"}
                               :replace_all {:type "boolean"
                                             :description "Replace ALL occurrences (required if multiple matches)"}
                               :dry_run {:type "boolean"
                                         :description "Preview changes without writing file"}}
                  :required ["file_path" "match" "replace"]}}])

;;; ---------------------------------------------------------------------------
;;; Logging (to stderr - NEVER stdout!)
;;; ---------------------------------------------------------------------------

(def ^:dynamic *debug* (= "1" (System/getenv "DEBUG")))

(defn log-debug [& args]
  (when *debug*
    (binding [*out* *err*]
      (apply println "[DEBUG]" (java.time.Instant/now) args)
      (flush))))

(defn log-error [& args]
  (binding [*out* *err*]
    (apply println "[ERROR]" (java.time.Instant/now) args)
    (flush)))

;;; ---------------------------------------------------------------------------
;;; nREPL Communication (bencode)
;;; ---------------------------------------------------------------------------

(def connect-timeout-ms 5000) ;; 5 second connection timeout (Phase 4c)

(defn bytes->str
  "Convert bencode byte array to string."
  [x]
  (if (bytes? x)
    (String. ^bytes x "UTF-8")
    x))

(defn decode-msg
  "Decode bencode message, converting byte arrays to strings."
  [msg]
  (into {}
        (map (fn [[k v]]
               [(bytes->str k)
                (if (coll? v)
                  (mapv bytes->str v)
                  (bytes->str v))]))
        msg))

(defn- connect-with-timeout
  "Create a socket connection with explicit timeout (Phase 4c).
   Returns connected Socket or throws."
  [host port timeout-ms]
  (let [addr (java.net.InetSocketAddress. host port)
        sock (java.net.Socket.)]
    (.connect sock addr timeout-ms)
    sock))

(defn nrepl-send-recv
  "Send a message to nREPL and receive all responses until done.
   Returns vector of decoded response messages."
  [sock msg]
  (let [out (java.io.BufferedOutputStream. (.getOutputStream sock))
        in (java.io.PushbackInputStream. (.getInputStream sock))]
    (log-debug "Sending:" (pr-str msg))
    (b/write-bencode out msg)
    (.flush out)
    (loop [responses []]
      (let [resp (decode-msg (b/read-bencode in))
            status (get resp "status")]
        (log-debug "Received:" (pr-str resp))
        (if (and status (some #{"done"} status))
          (conj responses resp)
          (recur (conj responses resp)))))))

(defn nrepl-clone-session
  "Clone an nREPL session to get a persistent session ID.
   Returns the new session ID string, or nil on failure."
  [port]
  (log-debug "nrepl-clone-session port:" port)
  (try
    (with-open [sock (connect-with-timeout "localhost" port connect-timeout-ms)]
      (let [responses (nrepl-send-recv sock {"op" "clone"})
            new-session (some #(get % "new-session") responses)]
        (log-debug "Cloned session:" new-session)
        new-session))
    (catch Exception e
      (log-error "Failed to clone session on port" port ":" (.getMessage e))
      nil)))

(defn nrepl-interrupt
  "Send interrupt to an nREPL session. Returns status from response."
  [port nrepl-session-id]
  (log-debug "nrepl-interrupt port:" port "session:" nrepl-session-id)
  (try
    (with-open [sock (connect-with-timeout "localhost" port connect-timeout-ms)]
      (let [responses (nrepl-send-recv sock {"op" "interrupt" "session" nrepl-session-id})
            status (some #(get % "status") responses)]
        (log-debug "Interrupt status:" status)
        {:status status}))
    (catch Exception e
      (log-error "Failed to interrupt session:" (.getMessage e))
      {:error (.getMessage e)})))

(defn nrepl-close-session
  "Close an nREPL session. Best-effort; logs failure but never throws."
  [port nrepl-session-id]
  (when nrepl-session-id
    (try
      (with-open [sock (connect-with-timeout "localhost" port connect-timeout-ms)]
        (nrepl-send-recv sock {"op" "close" "session" nrepl-session-id})
        nil)
      (catch Exception e
        (log-debug "Failed to close nREPL session" nrepl-session-id ":" (.getMessage e))
        nil))))

(defn nrepl-eval
  "Evaluate code via nREPL using bencode. Returns {:value :ns :err :out :ex}
   timeout-ms controls how long to wait for responses (default: 30000ms)
   nrepl-session-id - optional persistent nREPL session ID for *1/*2/*3 support"
  ([port code] (nrepl-eval port code default-timeout-ms nil))
  ([port code timeout-ms] (nrepl-eval port code timeout-ms nil))
  ([port code timeout-ms nrepl-session-id]
   (log-debug "nrepl-eval port:" port "timeout:" timeout-ms "session:" nrepl-session-id "code:" (pr-str code))
   (let [timeout-ms (or timeout-ms default-timeout-ms)
         deadline (+ (System/currentTimeMillis) timeout-ms)]
     (try
       (with-open [sock (connect-with-timeout "localhost" port connect-timeout-ms)]
         (let [out (java.io.BufferedOutputStream. (.getOutputStream sock))
               in (java.io.PushbackInputStream. (.getInputStream sock))
               id (str (random-uuid))
               msg-to-send (cond-> {"op" "eval" "code" code "id" id}
                             nrepl-session-id (assoc "session" nrepl-session-id))]
           (log-debug "Sending:" (pr-str msg-to-send))
           (b/write-bencode out msg-to-send)
           (.flush out)
           ;; Read responses until done, tracking total elapsed time
           (loop [result {:value nil :ns nil :err nil :out nil :ex nil}]
             (let [remaining (- deadline (System/currentTimeMillis))]
               (if (<= remaining 0)
                 ;; Total timeout exceeded
                 {:err (str "Timeout after " (/ timeout-ms 1000) "s. "
                            "If you launched an agent, it's still running. "
                            "Check progress: (user/agents) and (user/agent-messages \"id\"). "
                            "Wait for completion: (user/wait-for-agent!! \"id\"). "
                            "For blocking launches, set timeout_ms=600000.")
                  :ex "timeout"}
                 (do
                   ;; Set socket timeout to remaining time (capped at 5 seconds for responsiveness)
                   (.setSoTimeout sock (int (min remaining 5000)))
                   ;; Try to read, handling socket timeout separately from other errors
                   (let [read-result (try
                                       {:msg (decode-msg (b/read-bencode in))}
                                       (catch java.net.SocketTimeoutException _e
                                         {:timeout true}))]
                     (if (:timeout read-result)
                       ;; Socket timed out but deadline not exceeded - keep waiting
                       (recur result)
                       ;; Got a message - process it
                       (let [msg (:msg read-result)
                             status (get msg "status")
                             value (get msg "value")
                             ns-val (get msg "ns")
                             err (get msg "err")
                             stdout (get msg "out")
                             ex (get msg "ex")]
                         (log-debug "Received:" (pr-str msg))
                         (let [result' (cond-> result
                                         value (assoc :value value)
                                         ns-val (assoc :ns ns-val)
                                         err (update :err str err)
                                         stdout (update :out str stdout)
                                         ex (assoc :ex ex)
                                         ;; nREPL returns "unknown-session" when session ID is stale
                                         (and status (some #{"unknown-session"} status))
                                         (assoc :ex "unknown-session"
                                                :err "nREPL session expired (server restarted?)"))]
                           (if (and status (some #{"done"} status))
                             result'
                             (recur result'))))))))))))
       ;; ConnectException means the Seon server is down. Set :ex so callers
      ;; don't treat this as a successful eval that returned nil.
      ;; This was the root cause of silent nil responses when the server crashed
      ;; (e.g., LMDB corruption → server dies → nREPL port 7888 unreachable →
      ;; ConnectException caught here → :err set but :ex nil → execute-eval
      ;; falls through to success path → returns "nil" to user).
      (catch java.net.ConnectException _e
         {:err (str "Seon server is not running (cannot connect to nREPL on port " port ").\n"
                    "Start it with: ./bin/run\n"
                    "Check logs/startup.log for crash details (LMDB errors, port conflicts, OOM).")
          :ex "connection-refused"})
       (catch Exception e
         (log-debug "Exception:" (class e) (.getMessage e))
         {:err (str "Error: " (.getMessage e))
          :ex "error"})))))

;;; ---------------------------------------------------------------------------
;;; MCP Result Builders
;;; ---------------------------------------------------------------------------

(defn mcp-success
  "Build an MCP success result with text content."
  [text]
  {:content [{:type "text" :text text}]
   :isError false})

(defn mcp-error
  "Build an MCP error result with text content."
  [text]
  {:content [{:type "text" :text (str "Error: " text)}]
   :isError true})

;;; ---------------------------------------------------------------------------
;;; Session Helpers
;;; ---------------------------------------------------------------------------

(def retired-sessions-message
  "Guiding fail-loud message for the retired agent-pool session feature.
   The pool machinery (`:seon.flow/pool` / `:seon.orchestrator/sessions`
   Integrant keys) was DISABLED-AND-REMOVED 2026-06-09 (resources/system.edn),
   and `seon.orchestrator.session` was renamed to `seon.session` 2026-05-27 —
   pool-backed isolated sessions cannot be created or addressed anymore."
  (str "Isolated agent-pool sessions are retired (pool Integrant keys removed "
       "2026-06-09). Use session_id 'orchestrator' — each eval already runs in "
       "its own fresh per-eval nREPL session on the main JVM — or "
       "':seon.agent/<id>' to scope an eval to a V2 agent's session conn."))

;;; ---------------------------------------------------------------------------
;;; V2 agent routing (Wave 4.5 Item E)
;;;
;;; `session_id` strings starting with ":seon.agent/" address a V2 agent by
;;; id. The agent's session DB lives in the seon JVM's
;;; `seon.server.session` registry; we route to the master nREPL and wrap
;;; the user code in `(seon.session/with-agent <id> (do <code>))` so the
;;; eval runs with `*conn*` + `*current-agent-id*` bound to that agent.
;;; The orchestrator path and the legacy 4-char hex path are unchanged.
;;; ---------------------------------------------------------------------------

(def agent-session-prefix ":seon.agent/")

(defn agent-session?
  "True when `session-id` is a V2 agent reference (`:seon.agent/<id>`)."
  [session-id]
  (and (string? session-id)
       (str/starts-with? session-id agent-session-prefix)))

(defn agent-session->id
  "Strip the `:seon.agent/` prefix and return the bare agent id."
  [session-id]
  (subs session-id (count agent-session-prefix)))

(defn wrap-with-agent
  "Wrap `code` in `(seon.session/with-agent-load-string <agent-id> <code-string>)`
   so the eval runs scoped to that agent's session conn on the master REPL.

   We pass user code as a STRING (via `pr-str`) and `load-string` reads it
   form-by-form inside the binding scope. This preserves multi-form alias
   resolution — `(require '[x :as y])` then `(y/foo)` in one submission
   works because `load-string` reads + evals one form at a time. A single
   `(do ...)` wrap would analyze the whole body before evaluating, breaking
   alias resolution."
  [agent-id code]
  (str "(seon.session/with-agent-load-string \""
       (str/replace agent-id "\"" "\\\"")
       "\" " (pr-str code) ")"))

;;; ---------------------------------------------------------------------------
;;; Tool Execution
;;; ---------------------------------------------------------------------------

(defn- truncate-code-preview
  "Truncate code to a short preview for error messages."
  [code max-len]
  (let [s (str/trim (str code))]
    (if (> (count s) max-len)
      (str (subs s 0 max-len) "...")
      s)))

(defn- autosave-keys
  "Compute the autosave storage location for a given user code string and
   session. Returns {:result-key <str> :var-name <str>}.

   The result-key is hash-derived so repeated identical evals reuse the
   same slot in the per-session atom (no churn)."
  [code effective-session]
  (let [hash-val (Math/abs (hash code))
        result-key (str ":r-" (subs (str hash-val) 0 (min 4 (count (str hash-val)))))
        var-name (str "user/repl-" effective-session)]
    {:result-key result-key
     :var-name var-name}))

(defn- autosave-of-*1-code
  "Return the autosave form to send as a SECOND nREPL message on the
   same cloned session after the user code runs.

   Reads `*1` (the value of the last form from the previous eval message
   on this session — verified to persist across messages via
   `tmp/mcp-multiform-test.bb`) and stashes it in `user/repl-<session>`.

   Why a second message: collapsing user code + autosave into one
   `(do ...)` form analyzes the whole body before evaluating, which
   breaks `(require '[x :as y])` + `(y/foo)` because `y/foo` is resolved
   at analyze-time before the runtime `require` runs. Two messages let
   nREPL evaluate user forms one-at-a-time (aliases work) AND still
   capture the final value (`*1`)."
  [{:keys [result-key var-name]}]
  (str "(let [__r *1]"
       " (defonce " var-name " (atom {}))"
       " (let [__prev (get @" var-name " " result-key ")]"
       "   (when-not (= __prev __r)"
       "     (swap! " var-name " assoc " result-key " __r)))"
       " __r)"))

(defn- truncate-stdout
  "Truncate stdout to last N chars, keeping the tail (most recent output).
   Prepends a note if truncated."
  [out max-chars]
  (if (or (nil? out) (<= (count out) max-chars))
    out
    (str ";; ... stdout truncated (" (count out) " chars, showing last " max-chars ")\n"
         (subs out (- (count out) max-chars)))))

;;; ---------------------------------------------------------------------------
;;; AI Auto-Render (makes second read-only nREPL call to try AI rendering)
;;; ---------------------------------------------------------------------------

(def min-ai-render-chars 80) ;; Only attempt AI render for maps > this size

(defn- try-ai-render
  "Attempt to render a map value using a registered AI renderer.
   Makes a read-only nREPL call to seon.render/try-render.

   Arguments:
     port            - nREPL port to use
     nrepl-session-id - nREPL session ID
     val-str         - The string representation of the evaluated value

   Returns:
     {:ai-text \"...\"} if renderer found and returned a string
     {:no-renderer true :keys [...]} if no renderer exists
     nil if value is not eligible (not a map, too small, etc.)"
  [port nrepl-session-id val-str]
  (when (and val-str
             (str/starts-with? val-str "{")
             (> (count val-str) min-ai-render-chars))
    (try
      ;; Parse the value to get keys for hint message
      (let [parsed (clojure.edn/read-string val-str)
            data-keys (when (map? parsed) (keys parsed))]
        (when (and (map? parsed) (seq data-keys))
          ;; Make read-only call to try-render
          (let [render-code (str "(do (require 'seon.render)"
                                 " (seon.render/try-render "
                                 val-str
                                 " :ai))")
                result (nrepl-eval port render-code 5000 nrepl-session-id)]
            (if (and (:value result)
                     (not= "nil" (:value result))
                     (not (:ex result)))
              ;; Renderer found - value is a quoted string, need to parse it
              (let [ai-text (try
                              (clojure.edn/read-string (:value result))
                              (catch Exception _ (:value result)))]
                (when (string? ai-text)
                  {:ai-text ai-text}))
              ;; No renderer found
              {:no-renderer true
               :keys (vec (take 5 data-keys))}))))
      (catch Exception e
        (log-debug "AI render attempt failed:" (.getMessage e))
        nil))))

(defn- format-eval-output
  "Format nREPL result with truncation and storage hints.
   result-key and var-name come from autosave-keys.
   full? skips truncation (opt-in via #_:full prefix).
   ai-render-result is optional {:ai-text ...} or {:no-renderer true :keys [...]}."
  [result result-key var-name full? ai-render-result]
  (let [val-str (or (:value result) "nil")
        hint (str "\n;; stored as " result-key " in @" var-name)
        big-val? (and (not full?) (> (count val-str) max-eval-output-chars))
        out-str (if full?
                  (:out result)
                  (truncate-stdout (:out result) max-eval-output-chars))
        ;; Format AI render comment
        ai-comment (cond
                     (:ai-text ai-render-result)
                     (str ";; AI: " (:ai-text ai-render-result) "\n")

                     (:no-renderer ai-render-result)
                     nil  ;; Don't show hint inline, add at end

                     :else nil)
        ;; Format no-renderer hint (shown at end)
        no-renderer-hint (when (:no-renderer ai-render-result)
                           (str "\n;; No AI renderer for keys " (pr-str (:keys ai-render-result))
                                ".\n;; Define a render fn with matching -request/-response specs"
                                "\n;; containing :seon.render/ai to control how you see this data."))]
    (str (when out-str out-str)
         ai-comment
         (if big-val?
           (let [total (count val-str)]
             (str (subs val-str 0 truncated-preview-chars)
                  "\n;; " total " chars total, showing 0-" truncated-preview-chars
                  hint
                  "\n;; more: (subs (" result-key " @" var-name ") " truncated-preview-chars " " (min total (+ truncated-preview-chars truncated-preview-chars)) ")"))
           (str val-str hint))
         (when-let [ns (:ns result)]
           (str "\n;; ns: " ns))
         no-renderer-hint)))

(defn execute-eval
  "Execute the eval tool. Returns MCP result format.

   Session routing:
   - `orchestrator` and `:seon.agent/<id>` route to the master nREPL (port
     7888). Each eval clones a FRESH nREPL session, runs under a deadline,
     and closes the session in `finally`. `*ns*`, dynamic bindings, and any
     wedge from `(in-ns ...)` are all call-local — they cannot leak across
     evals or sticky-wedge the master REPL.
   - 4-char hex agent-pool sessions retain the legacy persistent-session
     behavior (their isolated JVM owns the session lifecycle).

   When SEON_SESSION_ID env var is set, session_id param is ignored and the
   enforced session is used instead (agent isolation).

   Timeout: defaults to `default-timeout-ms` (30s). Callers can override via
   `timeout_ms`. On timeout we send `:interrupt` to the per-eval session and
   then close it — the master REPL stays responsive."
  [{:keys [session_id code timeout_ms]}]
  ;; Detect #_:full prefix — opt-in to skip truncation
  (let [full?           (str/starts-with? (str/trim (str code)) full-output-prefix)
        code            (if full? (str/replace-first code full-output-prefix "") code)
        raw-session     (or enforced-session-id session_id)
        ;; V2 agent routing (Wave 4.5 Item E): `:seon.agent/<id>` session
        ;; ids route through the master REPL with `(seon.session/with-agent
        ;; <id> ...)` wrapping the user code. We still use the orchestrator
        ;; port (master REPL) because that's where datahike + the agent
        ;; registry live.
        agent?          (agent-session? raw-session)
        agent-id        (when agent? (agent-session->id raw-session))
        code            (if agent? (wrap-with-agent agent-id code) code)
        effective-session (if agent? "orchestrator" raw-session)
        ;; Per-eval-session routes: orchestrator + V2 agent routing. Each
        ;; eval gets a fresh clone+close. Legacy 4-char hex sessions retain
        ;; the persistent-session path.
        per-eval-route? (= effective-session "orchestrator")]
    (log-debug "execute-eval session:" effective-session
               "(enforced:" enforced-session-id "provided:" session_id
               "agent?:" agent? "agent-id:" agent-id
               "per-eval?:" per-eval-route? ")"
               "timeout:" timeout_ms)

    ;; Guard: if orchestrator init hasn't completed yet, surface the actual
    ;; pre-flight error if we have one, otherwise a generic "still
    ;; initializing" message.
    (when (and per-eval-route?
               (not @orchestrator-init-ready?))
      (throw (ex-info (or @preflight-error
                          "Seon server is still initializing, please retry in a few seconds")
                      {:initializing true
                       :preflight-error @preflight-error})))

    (let [{:keys [result-key var-name]} (autosave-keys code effective-session)
          effective-timeout (or timeout_ms default-timeout-ms)]

      (if per-eval-route?
        ;; ---- Per-eval-session path (orchestrator + V2 agents) ----
        ;;
        ;; Two nREPL messages on the same cloned session:
        ;;   1. User code (raw, or wrapped in `with-agent-load-string` for
        ;;      :seon.agent/<id> routes). nREPL reads + evaluates top-level
        ;;      forms one at a time, so `(require '[x :as y])` in form 1
        ;;      establishes the alias before form 2 is analyzed.
        ;;   2. `(let [__r *1] ...)` — reads the last form's value (verified
        ;;      to persist across messages on the same session by
        ;;      `tmp/mcp-multiform-test.bb`) and stashes it for autosave.
        ;;
        ;; Single-message `(do ...)` wrap was the b2b2681 regression: the
        ;; analyzer resolves `y/foo` before runtime `require` runs.
        (let [;; Clone a fresh session so this eval's *ns*, dynamic
              ;; bindings, and any (in-ns ...) wedge cannot leak.
              ephemeral-session (nrepl-clone-session orchestrator-port)]
          (if-not ephemeral-session
            (mcp-error
             (str "Failed to clone nREPL session on port " orchestrator-port "."
                  (when @preflight-error (str "\nPre-flight: " @preflight-error))))
            (try
              (let [;; Message 1: user code (multi-form aliases work)
                    result (nrepl-eval orchestrator-port code
                                       effective-timeout ephemeral-session)]
                ;; On timeout, interrupt before we close — closing a
                ;; session that still has a running eval can hang the
                ;; close op briefly.
                (when (= (:ex result) "timeout")
                  (log-info "Per-eval timeout after" effective-timeout
                            "ms, interrupting session" ephemeral-session)
                  (nrepl-interrupt orchestrator-port ephemeral-session))
                (if (:ex result)
                  (mcp-error (or (:err result)
                                 (str "eval failed: " (:ex result))))
                  (do
                    ;; Message 2: autosave-of-*1. Best-effort — the user
                    ;; got their value either way; autosave is a
                    ;; convenience. 5s budget is plenty for an atom swap.
                    (try
                      (nrepl-eval orchestrator-port
                                  (autosave-of-*1-code {:result-key result-key
                                                        :var-name var-name})
                                  5000 ephemeral-session)
                      (catch Exception e
                        (log-debug "Autosave failed (non-fatal):" (.getMessage e))))
                    (let [ai-render (when-not full?
                                      (try-ai-render orchestrator-port
                                                     ephemeral-session
                                                     (:value result)))]
                      (mcp-success (format-eval-output result result-key
                                                       var-name full? ai-render))))))
              (finally
                ;; Always close — the whole point of per-eval sessions.
                (nrepl-close-session orchestrator-port ephemeral-session)))))

        ;; ---- Retired 4-char hex agent-pool path: fail loud with guidance ----
        ;; The pool-backed isolated-session feature was removed 2026-06-09;
        ;; a hex session id can no longer resolve to a live nREPL port.
        (mcp-error (str "Unknown session_id '" effective-session "'. "
                        retired-sessions-message))))))

(defn execute-create-session
  "Execute the create_session tool — RETIRED. The pool machinery this
   created sessions on was removed 2026-06-09; without a pool the old
   `start-agent-session!` produced a port-less row that no eval could
   reach. Fail loud with guidance instead of minting unusable sessions."
  [{:keys [namespace]}]
  (log-debug "execute-create-session namespace:" namespace "(retired)")
  (mcp-error retired-sessions-message))

(defn execute-stop-session
  "Execute the stop_session tool — RETIRED alongside create_session."
  [{:keys [session_id]}]
  (log-debug "execute-stop-session session:" session_id "(retired)")
  (mcp-error retired-sessions-message))

(defn- cancel-running-future-if!
  "Cancel the running eval future if it matches the given session."
  [session-id]
  (when-let [running @running-eval]
    (when (or (= session-id (:session-id running))
              (and (= session-id "orchestrator")
                   (= "orchestrator" (:session-id running))))
      (log-info "Cancelling running future for session:" session-id)
      (future-cancel (:future running))
      (reset! running-eval nil))))

(defn- interrupt-orchestrator
  "Per-eval-session architecture: each orchestrator/V2-agent eval clones
   its own short-lived nREPL session that auto-times-out and is closed in
   `finally`. There is no longer a persistent orchestrator session to
   interrupt. This stub is kept so older callers don't 404; it reports
   the new behavior."
  []
  (mcp-success
   (str "interrupt_eval is a no-op for `orchestrator` / `:seon.agent/<id>` "
        "evals — each runs in its own per-eval nREPL session with a "
        "hard timeout. If a single eval is hung, it will self-clear "
        "when its deadline expires.")))

(defn execute-interrupt-eval
  "Execute the interrupt_eval tool.
   Cancels any running future in the MCP server. Per-eval sessions
   (orchestrator / :seon.agent/<id>) self-clear on their deadline; the
   retired agent-pool sessions can no longer be interrupted."
  [{:keys [session_id]}]
  (log-debug "execute-interrupt-eval session:" session_id)
  (cancel-running-future-if! session_id)
  (if (= session_id "orchestrator")
    (interrupt-orchestrator)
    (mcp-error retired-sessions-message)))

(defn execute-list-sessions
  "Execute the list_sessions tool.
   Returns session info including observability data (Phase 4c):
   - uptime_seconds: how long the session has been running
   - last_activity_at: when the last eval completed
   - eval_count: total evals in this session
   - current_eval: info about currently running eval (if any)
   - nrepl_session_id: persistent nREPL session ID for debugging"
  [_args]
  (log-debug "execute-list-sessions")

  ;; The Clojure code calculates uptime_seconds from started_at and formats dates
  (let [code "(do (require 'seon.session)
                  (let [now (System/currentTimeMillis)
                        sessions (seon.session/list-agent-sessions {})]
                    (mapv (fn [s]
                            (let [started-at (:seon.session/started-at s)
                                  uptime-ms (when started-at
                                              (- now (.getTime ^java.util.Date started-at)))]
                              (cond-> {:session_id (:seon.session/id s)
                                       :namespace (str (:seon.session/namespace s))
                                       :nrepl_port (:seon.session/nrepl-port s)
                                       :status (name (:seon.session/status s))}
                                uptime-ms
                                (assoc :uptime_seconds (quot uptime-ms 1000))

                                (:seon.session/nrepl-session-id s)
                                (assoc :nrepl_session_id
                                       (:seon.session/nrepl-session-id s))

                                (:seon.session/last-activity-at s)
                                (assoc :last_activity_at
                                       (str (:seon.session/last-activity-at s)))

                                (:seon.session/eval-count s)
                                (assoc :eval_count
                                       (:seon.session/eval-count s))

                                (:seon.session/current-eval s)
                                (assoc :current_eval
                                       {:code (:seon.session/code
                                                (:seon.session/current-eval s))
                                        :started_at
                                        (str (:seon.session/started-at
                                               (:seon.session/current-eval s)))}))))
                          sessions)))"
        result (nrepl-eval orchestrator-port code)]

    (log-debug "List sessions result:" (pr-str result))

    (if (:ex result)
      (mcp-error (str "Server connection: DOWN\n" (:err result)))
      (mcp-success (if (= "[]" (:value result))
                     "No active sessions"
                     (:value result))))))

(defn execute-query-graph
  "Execute the query_graph tool. Searches the knowledge graph."
  [{:keys [query type]}]
  (let [type (or type "functions")
        code (case type
               "functions"
               (format "(do (require 'seon.graph.query 'seon.system)
                            (let [conn (seon.system/runtime-db-conn (:seon/runtime-db integrant.repl.state/system))]
                              (pr-str (seon.graph.query/search-functions
                                        {:seon.graph.query/conn conn
                                         :seon.graph.query/pattern %s}))))"
                       (pr-str query))

               "namespaces"
               (format "(do (require 'seon.graph.query 'seon.system)
                            (let [conn (seon.system/runtime-db-conn (:seon/runtime-db integrant.repl.state/system))]
                              (pr-str {:dependents (seon.graph.query/dependents-of
                                                     {:seon.graph.query/conn conn
                                                      :seon.graph.query/ns-name %s})
                                       :dependencies (seon.graph.query/dependencies-of
                                                       {:seon.graph.query/conn conn
                                                        :seon.graph.query/ns-name %s})})))"
                       (pr-str query) (pr-str query))

               "context"
               (format "(do (require 'seon.repl.context 'seon.system)
                            (let [conn (seon.system/runtime-db-conn (:seon/runtime-db integrant.repl.state/system))]
                              (seon.repl.context/for-function
                                {:seon.repl.context/conn conn
                                 :seon.repl.context/qualified-name %s})))"
                       (pr-str query)))
        result (nrepl-eval orchestrator-port code)]
    (if (:ex result)
      (mcp-error (str "query_graph failed: " (:err result)))
      (let [val-str (or (:value result) "nil")]
        (if (> (count val-str) max-eval-output-chars)
          (mcp-success (str (subs val-str 0 truncated-preview-chars)
                            "\n;; ... truncated (" (count val-str) " chars)"
                            "\n;; Narrow your query for fewer results"))
          (mcp-success val-str))))))

(defn execute-namespace-health
  "Execute the namespace_health tool. Gets namespace overview."
  [{:keys [namespace]}]
  (let [code (format "(do (require 'seon.repl.context 'seon.graph.query 'seon.system)
                          (let [conn (seon.system/runtime-db-conn (:seon/runtime-db integrant.repl.state/system))
                                ctx (seon.repl.context/for-namespace
                                      {:seon.repl.context/conn conn
                                       :seon.repl.context/namespace %s})
                                fns (seon.graph.query/functions-in-ns
                                      {:seon.graph.query/conn conn
                                       :seon.graph.query/ns-name %s})
                                deps (seon.graph.query/dependencies-of
                                       {:seon.graph.query/conn conn
                                        :seon.graph.query/ns-name %s})
                                dependents (seon.graph.query/dependents-of
                                             {:seon.graph.query/conn conn
                                              :seon.graph.query/ns-name %s})]
                            (str ctx
                                 \"\\n\\n## Summary\\n\"
                                 \"Functions: \" (count fns) \"\\n\"
                                 \"Dependencies: \" (count deps) \"\\n\"
                                 \"Dependents: \" (count dependents))))"
                     (pr-str namespace) (pr-str namespace)
                     (pr-str namespace) (pr-str namespace))
        result (nrepl-eval orchestrator-port code)]
    (if (:ex result)
      (mcp-error (str "namespace_health failed: " (:err result)))
      (let [val-str (or (:value result) "nil")]
        (if (> (count val-str) max-eval-output-chars)
          (mcp-success (str (subs val-str 0 truncated-preview-chars)
                            "\n;; ... truncated (" (count val-str) " chars)"
                            "\n;; Narrow your query for fewer results"))
          (mcp-success val-str))))))

(defn execute-agent-status
  "Execute the agent_status tool. Returns system health.
   Reports server connection status prominently."
  [_args]
  (let [code "(user/status)"
        result (nrepl-eval orchestrator-port code)]
    (if (:ex result)
      (mcp-error (str "Server connection: DOWN\n" (:err result)))
      (mcp-success (str "Server connection: OK\n" (or (:value result) "nil"))))))

(defn- run-hook-pipeline!
  "Run the hook pipeline after a successful clojure_replace.
   Returns {:feedback [...] :blocked bool :reason str} or nil on error."
  [file-path]
  (let [code (format "(do (require 'seon.dev.hook)
                          (seon.dev.hook/process-mcp-edit!
                            #:seon.dev.hook{:file-path %s}))"
                     (pr-str file-path))
        result (nrepl-eval orchestrator-port code 60000)]
    (when-not (:ex result)
      (try
        (let [parsed (clojure.edn/read-string (:value result))]
          {:feedback (:seon.dev.hook/feedback parsed)
           :blocked (:seon.dev.hook/blocked parsed)
           :reason (:seon.dev.hook/reason parsed)})
        (catch Exception _ nil)))))

(defn execute-clojure-replace
  "Execute the clojure_replace tool via nREPL.
   Calls seon.dev.clojure-replace/replace-sexp! on the orchestrator.
   On success (non-dry-run), also runs the hook pipeline for reload/tests/review."
  [{:keys [file_path match replace line_start line_end replace_all dry_run]}]
  (log-debug "execute-clojure-replace file:" file_path "match:" match)

  (let [code (format "(do (require 'seon.dev.clojure-replace)
                          (seon.dev.clojure-replace/replace-sexp!
                            #:seon.dev.clojure-replace{:file-path %s
                                                       :match %s
                                                       :replace %s
                                                       :line-start %s
                                                       :line-end %s
                                                       :replace-all? %s
                                                       :dry-run? %s}))"
                     (pr-str file_path)
                     (pr-str match)
                     (pr-str replace)
                     (if line_start (str line_start) "nil")
                     (if line_end (str line_end) "nil")
                     (if replace_all "true" "false")
                     (if dry_run "true" "false"))
        result (nrepl-eval orchestrator-port code 30000)]

    (log-debug "Clojure replace result:" (pr-str result))

    (if (:ex result)
      (mcp-error (str "clojure_replace failed: " (:err result)))

      ;; Parse the EDN result and format appropriately
      (let [parsed (try (clojure.edn/read-string (:value result)) (catch Exception _ nil))]
        (if (and parsed (:seon.dev.clojure-replace/success parsed))
          ;; Success - run hook pipeline if not dry-run
          (let [edit-msg (str (:seon.dev.clojure-replace/message parsed)
                              "\n\n"
                              (:seon.dev.clojure-replace/diff parsed))
                hook-result (when-not dry_run
                              (run-hook-pipeline! file_path))]
            (if (and hook-result (:blocked hook-result))
              ;; Hook blocked the edit (tests failed, etc.)
              (mcp-error (str edit-msg "\n\n--- Hook Pipeline ---\n"
                              "BLOCKED: " (:reason hook-result)
                              (when-let [fb (:feedback hook-result)]
                                (str "\n" (str/join "\n" fb)))))
              ;; Success - include hook feedback
              (mcp-success (str edit-msg
                                (when-let [fb (seq (:feedback hook-result))]
                                  (str "\n\n--- Hook Pipeline ---\n"
                                       (str/join "\n" fb)))))))
          ;; Error case - include match locations if available
          (let [error-msg (:seon.dev.clojure-replace/error parsed)
                matches (:seon.dev.clojure-replace/matches parsed)]
            (if matches
              (mcp-error (str error-msg "\n\nMatches found:\n"
                              (str/join "\n"
                                        (map-indexed
                                         (fn [i m]
                                           (format "  %d. Line %d, Col %d: %s"
                                                   (inc i)
                                                   (:seon.dev.clojure-replace/line m)
                                                   (:seon.dev.clojure-replace/column m)
                                                   (:seon.dev.clojure-replace/context m)))
                                         matches))))
              (mcp-error (or error-msg "Unknown error")))))))))

;;; ---------------------------------------------------------------------------
;;; JSON-RPC Message Handling
;;; ---------------------------------------------------------------------------

(defn send-response
  "Send a JSON-RPC response to stdout.
   Thread-safe - uses stdout-lock to prevent interleaved output."
  [response]
  (let [json-str (json/generate-string response)]
    (log-debug "Sending response:" json-str)
    (locking stdout-lock
      (println json-str)
      (flush))))

(defn send-result
  "Send a successful JSON-RPC result."
  [id result]
  (send-response {:jsonrpc "2.0"
                  :id id
                  :result result}))

(defn send-error
  "Send a JSON-RPC error."
  [id code message & [data]]
  (send-response {:jsonrpc "2.0"
                  :id id
                  :error (cond-> {:code code :message message}
                           data (assoc :data data))}))

(defn handle-initialize
  "Handle the initialize request."
  [id _params]
  (log-debug "Handling initialize")
  (send-result id
               {:protocolVersion "2024-11-05"
                :capabilities {:tools {}}
                :serverInfo server-info}))

(defn handle-tools-list
  "Handle tools/list request."
  [id _params]
  (log-debug "Handling tools/list")
  (send-result id {:tools tools}))

(defn- queue-response!
  "Queue a response to be sent by the main loop."
  [id result]
  (swap! response-queue conj {:id id :result result}))

(defn- queue-error!
  "Queue an error response to be sent by the main loop."
  [id message]
  (swap! response-queue conj {:id id :error message}))

(defn- execute-tool-sync
  "Execute a tool synchronously. Returns MCP result or throws."
  [name arguments]
  (case name
    "eval" (execute-eval arguments)
    "create_session" (execute-create-session arguments)
    "stop_session" (execute-stop-session arguments)
    "interrupt_eval" (execute-interrupt-eval arguments)
    "list_sessions" (execute-list-sessions arguments)
    "clojure_replace" (execute-clojure-replace arguments)
    "query_graph" (execute-query-graph arguments)
    "namespace_health" (execute-namespace-health arguments)
    "agent_status" (execute-agent-status arguments)
    (throw (ex-info (str "Unknown tool: " name) {:tool name}))))

(defn- blocking-tool?
  "Returns true if this tool might block for a long time."
  [name]
  (contains? #{"eval" "create_session"} name))

(defn handle-tools-call
  "Handle tools/call request.
   Blocking tools (eval, create_session) run in a future so the main loop
   stays responsive for interrupt requests."
  [id {:keys [name arguments]}]
  (log-debug "Handling tools/call name:" name "arguments:" (pr-str arguments))

  (if (blocking-tool? name)
    ;; Run potentially blocking tools in a future
    (let [session-id (or (:session_id arguments) enforced-session-id "unknown")
          f (future
              (try
                (let [result (execute-tool-sync name arguments)]
                  (queue-response! id result))
                (catch clojure.lang.ExceptionInfo e
                  (queue-response! id (mcp-error (ex-message e))))
                (catch Exception e
                  (log-error "Tool execution failed:" (.getMessage e))
                  (queue-response! id (mcp-error (.getMessage e))))
                (finally
                  ;; Clear running-eval when done
                  (reset! running-eval nil))))]
      ;; Track the running eval for interrupt support
      (reset! running-eval {:future f
                            :session-id session-id
                            :request-id id
                            :started-at (System/currentTimeMillis)})
      (log-debug "Started async tool execution for" name "session:" session-id))

    ;; Run quick tools synchronously (interrupt, list, stop)
    (try
      (let [result (execute-tool-sync name arguments)]
        (send-result id result))
      (catch clojure.lang.ExceptionInfo e
        (send-result id (mcp-error (ex-message e))))
      (catch Exception e
        (log-error "Tool execution failed:" (.getMessage e))
        (send-result id (mcp-error (.getMessage e)))))))

(defn handle-notifications-initialized
  "Handle the initialized notification (no response needed)."
  [_params]
  (log-debug "Received initialized notification"))

(defn handle-request
  "Route a JSON-RPC request to the appropriate handler."
  [{:keys [jsonrpc method params id] :as request}]
  (log-debug "Received request:" (pr-str request))

  (if (not= jsonrpc "2.0")
    (when id
      (send-error id -32600 "Invalid Request: missing or invalid jsonrpc version"))
    (case method
      "initialize" (handle-initialize id params)
      "notifications/initialized" (handle-notifications-initialized params)
      "tools/list" (handle-tools-list id params)
      "tools/call" (handle-tools-call id params)
      (when id
        (send-error id -32601 (str "Method not found: " method))))))

;;; ---------------------------------------------------------------------------
;;; Main Loop
;;; ---------------------------------------------------------------------------

(defn- flush-response-queue!
  "Send all queued responses. Called from main loop."
  []
  ;; Atomically drain the queue to avoid losing responses when a future
  ;; enqueues between @response-queue and reset!.
  (let [[responses _] (swap-vals! response-queue (constantly []))]
    (when (seq responses)
      (doseq [{:keys [id result error]} responses]
        (if error
          (send-result id (mcp-error error))
          (send-result id result))))))

(defn- init-orchestrator-session!
  "Pre-flight: verify the orchestrator nREPL is reachable and responds to
   `(+ 1 1)`. Captures the actual exception/err text into `preflight-error`
   so tool responses can surface it instead of opaque \"REPL broken\". The
   per-eval-session architecture means we no longer need a persistent
   orchestrator session — `nrepl-eval` clones a fresh one per request — so
   success here is purely a health check.

   Returns true on success, false otherwise. Uses a 5s timeout."
  []
  (try
    (let [result (nrepl-eval orchestrator-port "(+ 1 1)" 5000)]
      (cond
        (= "2" (:value result))
        (do
          (reset! preflight-error nil)
          (reset! orchestrator-init-ready? true)
          (log-debug "Orchestrator connection verified")
          true)

        ;; nREPL responded but with an error — capture the actual text
        (or (:ex result) (:err result))
        (do
          (reset! preflight-error
                  (str "Pre-flight `(+ 1 1)` failed on orchestrator nREPL "
                       "(port " orchestrator-port "): "
                       (or (:err result) (:ex result))
                       (when (:value result) (str " | value=" (:value result)))))
          (log-error "Orchestrator pre-flight error:" @preflight-error)
          false)

        :else
        (do
          (reset! preflight-error
                  (str "Pre-flight `(+ 1 1)` returned unexpected value: "
                       (pr-str result)))
          (log-error @preflight-error)
          false)))
    (catch Exception e
      (reset! preflight-error
              (str "Cannot connect to orchestrator nREPL on port "
                   orchestrator-port ": " (.getMessage e)))
      (log-error @preflight-error)
      false)))

(defn- start-parent-watchdog!
  "Exit if the parent process (Claude Code) is gone.

   The MCP protocol is stdio. When Claude Code crashes / closes a session
   without clean shutdown, we orphan with stdin/stdout dangling. We capture
   the parent PID at startup; this future checks every 5 seconds whether
   that PID is still alive, and exits cleanly if not. Without this guard,
   N stale MCP servers accumulate over time and confuse fresh sessions.

   Reads `parent-pid` (top-level), checks `ProcessHandle/of pid` for
   `isAlive`. If the PID is reused by an unrelated process the worst
   case is we keep running (false positive); the typical case is the
   PID slot is free and we exit."
  []
  (when parent-pid
    (future
      (try
        (loop []
          (Thread/sleep 5000)
          (let [handle (java.lang.ProcessHandle/of parent-pid)]
            (if (and (.isPresent handle)
                     (.isAlive (.get handle)))
              (recur)
              (do
                (log-info "Parent" parent-pid "is gone — exiting to avoid orphaning.")
                (System/exit 0)))))
        (catch Exception e
          (log-error "Watchdog crashed:" (.getMessage e)))))))

(defn -main
  "Main entry point. Read JSON-RPC from stdin, process, write to stdout.

   Uses non-blocking reads so the main loop can:
   1. Process interrupt requests even while an eval is running
   2. Flush queued responses from background futures

   This fixes the MCP resilience issue where cancelling an eval would
   brick the entire MCP server."
  []
  (log-info "MCP Server v0.5.0 starting (async mode)...")

  ;; Watchdog: exit cleanly if the parent (Claude Code) process is gone.
  ;; Prevents stale MCP servers accumulating across sessions.
  (start-parent-watchdog!)

  ;; Init orchestrator session in background with retry — don't block the message loop.
  ;; handle-initialize responds without needing nREPL. Tools that need it
  ;; check orchestrator-init-ready? and return a clear error if not ready yet.
  ;; Retries with backoff because the MCP server may start before Seon's nREPL is ready.
  (future
    (try
      (loop [attempt 1
             delay-ms 1000]
        (when-not (init-orchestrator-session!)
          (if (<= attempt 30)
            (do
              (log-info "Orchestrator not ready, retry" attempt "in" delay-ms "ms...")
              (Thread/sleep delay-ms)
              (recur (inc attempt) (min 5000 (* delay-ms 2))))
            (log-error "Orchestrator init failed after 30 attempts — eval will not work"))))
      (catch Exception e
        (log-error "Background init failed:" (.getMessage e)))))

  ;; Main message loop - non-blocking to stay responsive
  (let [reader (java.io.BufferedReader. *in*)]
    (loop [iterations 0]
      ;; 1. Flush any pending responses from background futures
      (flush-response-queue!)

      ;; 2. Check for and process incoming requests (non-blocking)
      (let [has-input (.ready reader)]
        (when has-input
          (if-let [line (.readLine reader)]
            (when-not (str/blank? line)
              (try
                (let [request (json/parse-string line true)]
                  (handle-request request))
                (catch Exception e
                  (log-error "Parse error:" (.getMessage e) "line:" line)
                  (send-error nil -32700 "Parse error"))))
            ;; readLine returned nil - EOF
            (do
              (log-info "Stdin closed, shutting down")
              (System/exit 0)))))

      ;; 3. Small sleep to prevent busy-looping (10ms = 100 checks/sec)
      (Thread/sleep 10)

      ;; 4. Periodic health logging (every ~30 seconds)
      (when (and *debug* (zero? (mod iterations 3000)))
        (log-debug "Main loop healthy, iterations:" iterations
                   "running-eval:" (boolean @running-eval)
                   "queued-responses:" (count @response-queue)))

      (recur (inc iterations))))

  (log-info "MCP Server shutting down"))

(-main)
