#!/usr/bin/env bash
#
# bin/seon — process supervisor for the Seon dev stack.
#
# Multi-agent-safe: any agent can call any subcommand at any time;
# mutex-guarded so concurrent start/stop don't race. Idempotent:
# repeated `start` no-ops if already running, repeated `stop` no-ops
# if not running. Designed for the Platform↔MVP two-agent workflow
# where neither agent "owns" a process — both invoke this script.
#
# Subcommands:
#   start <name|all>   Idempotent. Spawns via nohup; logs to logs/<name>.log
#                      `all` = cljs-watch → wire-server → pod, each gated on
#                      REAL readiness before the next (jvm NOT included)
#
# Why `all` excludes the jvm (decided 2026-06-11, not an oversight):
# the jvm process hosts nREPL 7888 — the SHARED REPL that every Claude
# agent's eval, the dev hook's reload+test cycle, and the seon MCP
# bridge all run through — plus the embedded datahike (data/datahike).
# It has no dependency on the pod stack (its store is separate from
# the wire-server's data/clusters/* store), so there is no ordering
# reason to include it; and because this script is multi-agent (any
# agent may `restart all` to bounce the pod stack at any time),
# including the jvm would let one agent silently sever every other
# agent's live REPL session mid-flight. The jvm is therefore managed
# only by name: `bin/seon restart jvm` — an explicit, deliberate act.
# `start all` / `stop all` print this exclusion loudly.
#   stop <name|all>    SIGTERM, wait 2.5s, SIGKILL if still alive
#                      `all` reverses: pod → wire-server → cljs-watch
#   restart <name|all> stop + start
#   status [name]      Show one or all
#   tail <name>        tail -f logs/<name>.log
#   logs <name> [n]    Last n lines (default 200) of logs/<name>.log
#   adopt <name>       Register a manually-started process by PID
#   prep               Idempotent git-dep prep for :writer/:cljs aliases
#                      (downstream supervisors shell out to this)
#
# State per process: tmp/proc/<name>/{pid,cmd,started-at,lock/}
# Logs:              logs/<name>.log (truncated on fresh start)
#
# Stale lock recovery: if `bin/seon` is itself SIGKILLed mid-operation,
# the lock dir may persist. Remove with `rm -rf tmp/proc/<name>/lock`.

set -euo pipefail

SEON_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SEON_ROOT"

PROC_DIR="tmp/proc"
LOG_DIR="logs"
mkdir -p "$PROC_DIR" "$LOG_DIR"

# ============================================================
# Downstream parametrization — env overrides, each defaulting to
# today's baked-in value so seon's own usage is byte-identical. A
# downstream consumer shells out to bin/seon with env instead of
# forking the script:
#
#   SEON_CLUSTER_DIR        wire-server store parent dir
#                           (store at $SEON_CLUSTER_DIR/store)
#   SEON_REQ_SOCK           wire-server request UDS path
#   SEON_PUB_SOCK           wire-server publish UDS path
#   SEON_WRITER_REPL_PORT   wire-server loopback socket-REPL port
#   SEON_PORT               pod HTTP port (read by the pod itself —
#                           seon.web.serve; inherits through nohup)
#   SEON_RUNTIME_ROOT       pod artifact root (read by the pod itself —
#                           seon.platform/artifact-path; inherits)
# ============================================================

SEON_CLUSTER_DIR="${SEON_CLUSTER_DIR:-data/clusters/default}"
SEON_REQ_SOCK="${SEON_REQ_SOCK:-tmp/seon-cluster-default-req.sock}"
SEON_PUB_SOCK="${SEON_PUB_SOCK:-tmp/seon-cluster-default-pub.sock}"
SEON_WRITER_REPL_PORT="${SEON_WRITER_REPL_PORT:-7891}"

# ============================================================
# Process registry — add a process by adding one case branch.
# ============================================================

process_command() {
  case "$1" in
    # Pod gets a DURABLE read-only fs grant on the repo (demo: agents
    # read the seon source via seon.agent.fs/seon.agent.search). seon.agent.fs's
    # env-bootstrap parses these at ns load — survives pod restarts,
    # unlike a live (seon.agent.fs/configure! …). $SEON_ROOT is absolute
    # (computed at script top), so the grant is exact, not cwd-relative.
    # css:build first — resources/public/css/output.css is a build
    # artifact (not committed); the pod serves it, so every start
    # rebuilds it before boot.
    # `exec` is load-bearing: with a compound command, bash -c stays the
    # parent and the supervisor would record (and later SIGTERM) the
    # shell, orphaning node. exec replaces the shell with node after the
    # css build, so the recorded pid IS the pod.
    pod)         echo "npm run css:build && exec env SEON_FS_ROOT=\"$SEON_ROOT\" SEON_FS_READ_ONLY=1 node out/client/main.js" ;;
    cljs-watch)  echo "clj -M:cljs watch client" ;;
    jvm)         echo "./bin/run" ;;
    # V2 platform Host — JVM datahike wire-server (single-DB today).
    # Socket/path strings use "cluster" naming for the eventual multi-DB
    # layout (P1); they're CLI args, not code identifiers. The --repl-port
    # opens a loopback-only socket REPL on 127.0.0.1 for diagnostics, and
    # the chosen port is written to tmp/seon-writer-repl-port.
    wire-server) echo "clojure -M:writer --backend file --path $SEON_CLUSTER_DIR/store --req-sock $SEON_REQ_SOCK --pub-sock $SEON_PUB_SOCK --repl-port $SEON_WRITER_REPL_PORT" ;;
    *) return 1 ;;
  esac
}

process_ready_hint() {
  case "$1" in
    pod)         echo "  ready: tmp/seon-port written + HTTP answers on /agents" ;;
    cljs-watch)  echo "  ready: 'Build completed' appears in logs/cljs-watch.log" ;;
    jvm)         echo "  ready: logs/app.log shows 'Server started'" ;;
    wire-server) echo "  ready: $SEON_REQ_SOCK ACCEPTING; REPL on 127.0.0.1:$SEON_WRITER_REPL_PORT (tmp/seon-writer-repl-port)" ;;
    *) echo "" ;;
  esac
}

all_processes() { echo "pod cljs-watch jvm wire-server"; }

stack_processes() {
  # Dependency-ordered stack for `start all` (stop reverses the order):
  # cljs-watch builds out/client/main.js which the pod execs; the pod's
  # boot ping is fail-loud (bounded ~10s retry, seon.store.wire/ping!)
  # against the wire-server's socket. `jvm` is deliberately NOT in the
  # stack — it hosts the shared nREPL 7888 every agent depends on and
  # has no dependency on these processes; see the header comment.
  echo "cljs-watch wire-server pod"
}

# ============================================================
# Real readiness gates — `start all` / `restart all` / cluster reset
# gate each stage on OBSERVED readiness (socket accepting, HTTP
# answering, build completed), not just a log line.
# ============================================================

nc_supports_uds() { nc -h 2>&1 | head -1 | grep -q 'U'; }

ready_check() {
  local name="$1"
  case "$name" in
    wire-server)
      [ -S "$SEON_REQ_SOCK" ] || return 1
      [ -f tmp/seon-writer-repl-port ] || return 1
      if nc_supports_uds; then
        # A real connect with immediate EOF. NOT `nc -z -U`: macOS nc's
        # -z returns 1 even against a live, accepting UDS (verified
        # 2026-06-10). Socket accepting implies datahike is up — the
        # writer binds the socket only after "[writer] datahike ready".
        nc -U "$SEON_REQ_SOCK" -w 1 </dev/null >/dev/null 2>&1
      else
        grep -q '\[writer\] ready' "$(log_file wire-server)" 2>/dev/null
      fi
      ;;
    pod)
      [ -f tmp/seon-port ] || return 1
      curl -fsS -m 2 -o /dev/null \
        "http://127.0.0.1:$(cat tmp/seon-port)/agents" 2>/dev/null
      ;;
    cljs-watch)
      # Build artifact newer than this start, or completion line in the
      # (truncated-at-start) log. No socket exists for shadow watch.
      { [ -f out/client/main.js ] \
          && [ out/client/main.js -nt "$(started_file cljs-watch)" ]; } \
        || grep -q 'Build completed' "$(log_file cljs-watch)" 2>/dev/null
      ;;
    *) return 0 ;;
  esac
}

ready_bound() {
  case "$1" in
    wire-server) echo 180 ;;   # matches cluster reset's historical wait
    pod)         echo 120 ;;
    cljs-watch)  echo 300 ;;   # cold shadow-cljs build
    *)           echo 0 ;;
  esac
}

wait_ready() {
  # Bounded wait for ready_check. Loud on timeout or early death,
  # naming the log to read. Processes without a gate (jvm) pass through.
  local name="$1"
  local bound
  bound="$(ready_bound "$name")"
  [ "$bound" = 0 ] && return 0
  local waited=0
  printf '  waiting for %s ready (bound %ss) ' "$name" "$bound"
  until ready_check "$name"; do
    if ! is_running "$name"; then
      echo ""
      echo "✗ $name DIED while waiting for readiness — read its log:" >&2
      echo "    bin/seon logs $name   (logs/$name.log)" >&2
      return 1
    fi
    if [ "$waited" -ge "$bound" ]; then
      echo ""
      echo "✗ $name not ready after ${bound}s — read its log:" >&2
      echo "    bin/seon logs $name   (logs/$name.log)" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
    printf '.'
  done
  echo ""
  echo "  ● $name ready (${waited}s)"
}

# ============================================================
# Auto-prep on dep change. Real failure 2026-06-10: a datahike
# :git/sha bump made the first wire-server/cljs-watch start download +
# build the git dep INSIDE its ready window — boot timeouts blew, the
# pod raced the missing socket and fail-loud-exited. Detect the change
# up front (hash of deps.edn's :git/url+:git/sha lines, stored at
# tmp/proc/<name>/deps-fingerprint, plus a ~/.gitlibs presence check)
# and run the download + prep SYNCHRONOUSLY and loudly before spawning.
# ============================================================

deps_fingerprint() {
  grep -E ':git/(url|sha)' deps.edn 2>/dev/null | shasum | awk '{print $1}'
}

gitlibs_missing_sha() {
  # True if any :git/sha pinned in deps.edn has no ~/.gitlibs checkout.
  local sha
  for sha in $(grep ':git/sha' deps.edn | grep -oE '[0-9a-f]{40}' | sort -u); do
    ls -d "$HOME"/.gitlibs/libs/*/*/"$sha" >/dev/null 2>&1 || return 0
  done
  return 1
}

maybe_prep_deps() {
  local name="$1"
  local alias
  case "$name" in
    wire-server) alias="writer" ;;
    cljs-watch)  alias="cljs" ;;
    *) return 0 ;;
  esac
  local fp_file current stored
  fp_file="$(state_dir "$name")/deps-fingerprint"
  current="$(deps_fingerprint)"
  stored="$(cat "$fp_file" 2>/dev/null || true)"
  if [ "$current" = "$stored" ] && ! gitlibs_missing_sha; then
    return 0
  fi
  echo "  ▶ deps changed (or git libs unprepped) for $name — running"
  echo "    clojure -P -M:$alias && clojure -X:deps prep :aliases '[:$alias]'"
  echo "    SYNCHRONOUSLY before spawn (a fresh git dep can take minutes)"
  echo "    progress: logs/$name.log"
  {
    echo "== [bin/seon] auto-prep :$alias started $(date -u +%FT%TZ) =="
    clojure -P -M:"$alias" \
      && clojure -X:deps prep :aliases "[:$alias]" \
      && echo "== [bin/seon] auto-prep :$alias done $(date -u +%FT%TZ) =="
  } >> "$(log_file "$name")" 2>&1 || {
    echo "  ✗ deps prep for :$alias FAILED — read: bin/seon logs $name" >&2
    return 1
  }
  echo "$current" > "$fp_file"
  echo "  ● deps prepped for :$alias"
}

cmd_prep() {
  # Explicit git-dep prep verb for DOWNSTREAM supervisors (consumer ask 7):
  # after a git-dep repin, aliases that pull prep-requiring git deps
  # fail with "libs must be prepared" until
  #   clojure -X:deps prep :aliases '[:writer]'
  # runs — plain `clojure -X:deps prep` is NOT enough (the fork only
  # enters the classpath via the alias). bin/seon's auto-prep covers
  # seon's own start paths; this verb lets a downstream launcher shell
  # out (`bin/seon prep`) instead of rediscovering the incantation.
  #
  # Idempotent + fast no-op: same fingerprint scheme as auto-prep
  # (deps.edn :git/url+:git/sha hash + ~/.gitlibs presence). On a real
  # prep it also refreshes the per-process fingerprints so the next
  # `start wire-server` / `start cljs-watch` skips its own auto-prep.
  local prep_aliases="writer cljs"
  local fp_file current stored
  ensure_state prep
  fp_file="$(state_dir prep)/deps-fingerprint"
  current="$(deps_fingerprint)"
  stored="$(cat "$fp_file" 2>/dev/null || true)"
  if [ "$current" = "$stored" ] && ! gitlibs_missing_sha; then
    echo "● deps already prepped for aliases: $prep_aliases (no-op)"
    return 0
  fi
  local a
  for a in $prep_aliases; do
    echo "▶ prepping :$a — clojure -P -M:$a && clojure -X:deps prep :aliases '[:$a]'"
    if ! { clojure -P -M:"$a" && clojure -X:deps prep :aliases "[:$a]"; }; then
      echo "✗ prep for :$a FAILED" >&2
      return 1
    fi
  done
  echo "$current" > "$fp_file"
  # Keep the per-process auto-prep fingerprints in sync so the next
  # start doesn't redo the work this verb just did.
  for a in wire-server cljs-watch; do
    ensure_state "$a"
    echo "$current" > "$(state_dir "$a")/deps-fingerprint"
  done
  echo "● deps prepped for aliases: $prep_aliases"
}

# ============================================================
# State file paths.
# ============================================================

state_dir()    { echo "$PROC_DIR/$1"; }
pid_file()     { echo "$PROC_DIR/$1/pid"; }
cmd_file()     { echo "$PROC_DIR/$1/cmd"; }
started_file() { echo "$PROC_DIR/$1/started-at"; }
lock_dir()     { echo "$PROC_DIR/$1/lock"; }
log_file()     { echo "$LOG_DIR/$1.log"; }

ensure_state() { mkdir -p "$(state_dir "$1")"; }

# ============================================================
# Mutex via mkdir (atomic on POSIX, works on macOS without flock).
# Each lock dir contains an `owner` file with the holding script's PID
# so a competing acquirer can detect + reclaim stale locks (held by
# a script that died without cleanup, e.g. SIGKILL).
#
# Lock is released by `release_lock` (explicit) or by the EXIT trap as
# a backstop. Both call paths converge on the same rm -rf.
# ============================================================

acquire_lock() {
  local name="$1"
  ensure_state "$name"
  local lock
  lock="$(lock_dir "$name")"
  local tries=0
  while true; do
    if mkdir "$lock" 2>/dev/null; then
      # Got it — record our PID and arm the EXIT-trap backstop.
      echo "$$" > "$lock/owner"
      # shellcheck disable=SC2064
      trap "rm -rf '$lock' 2>/dev/null || true" EXIT INT TERM
      return 0
    fi
    # Lock exists — is the owner still alive?
    local owner_pid=""
    if [ -f "$lock/owner" ]; then
      owner_pid="$(cat "$lock/owner" 2>/dev/null || true)"
      if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
        echo "  ↻ reclaiming stale lock for $name (owner pid $owner_pid is dead)" >&2
        rm -rf "$lock"
        continue
      fi
    elif [ "$tries" -gt 5 ]; then
      # Lock exists with no owner file after 0.5s — abandoned mid-init.
      echo "  ↻ reclaiming abandoned lock for $name (no owner file)" >&2
      rm -rf "$lock"
      continue
    fi
    tries=$((tries + 1))
    if [ "$tries" -gt 100 ]; then
      echo "  ✗ could not acquire lock for $name after 10s" >&2
      echo "  held by pid ${owner_pid:-unknown};" >&2
      echo "  if confirmed stale: rm -rf $lock" >&2
      exit 1
    fi
    sleep 0.1
  done
}

release_lock() {
  # Explicit release — used by public commands so multi-step ops
  # (e.g. restart's stop+start) can chain without self-deadlocking.
  # Idempotent — the EXIT trap still fires as a backstop if release
  # is missed.
  local name="$1"
  rm -rf "$(lock_dir "$name")" 2>/dev/null || true
  trap - EXIT INT TERM
}

# ============================================================
# Aliveness check — handles both managed and adopted PIDs.
# ============================================================

is_running() {
  local name="$1"
  local pf
  pf="$(pid_file "$name")"
  [ -f "$pf" ] || return 1
  local pid
  pid="$(cat "$pf")"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

# ============================================================
# Subcommands.
#
# Public commands acquire the lock once and delegate to `_unlocked`
# workers that do the actual work. This lets `cmd_restart` hold the
# lock across stop+start without self-deadlocking (an earlier bug
# where each sub-call tried to acquire a lock its own parent already
# held).
# ============================================================

_start_unlocked() {
  local name="$1"

  if is_running "$name"; then
    echo "● $name already running (pid $(cat "$(pid_file "$name")"))"
    return 0
  fi

  local cmd
  cmd="$(process_command "$name")" || { echo "unknown process: $name" >&2; return 1; }

  # Fresh log on each start so tail isn't polluted with prior runs.
  : > "$(log_file "$name")"

  # Sha-bump guard: download + prep git deps BEFORE spawn so they never
  # build inside the process's own ready window (no-op when unchanged).
  maybe_prep_deps "$name" || return 1

  # nohup + & detaches from this shell; bash -c handles multi-word cmds.
  nohup bash -c "$cmd" >> "$(log_file "$name")" 2>&1 &
  local pid=$!

  echo "$pid"        > "$(pid_file "$name")"
  echo "$cmd"        > "$(cmd_file "$name")"
  date -u +%FT%TZ    > "$(started_file "$name")"

  echo "● $name started (pid $pid)"
  echo "  log: logs/$name.log"
  process_ready_hint "$name"
}

_stop_unlocked() {
  local name="$1"

  if ! is_running "$name"; then
    rm -f "$(pid_file "$name")"
    echo "○ $name not running"
    return 0
  fi

  local pid
  pid="$(cat "$(pid_file "$name")")"
  kill "$pid" 2>/dev/null || true

  # Give 2.5s for graceful exit.
  local i
  for i in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done

  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
    echo "○ $name killed (SIGKILL, was pid $pid)"
  else
    echo "○ $name stopped (was pid $pid)"
  fi

  rm -f "$(pid_file "$name")"
}

start_all() {
  # Dependency-ordered bring-up, each stage gated on REAL readiness
  # before the next starts. Idempotent: already-running stages no-op
  # in cmd_start and (being ready) pass their gate immediately.
  local name
  for name in $(stack_processes); do
    cmd_start "$name"
    wait_ready "$name" || {
      echo "✗ start all ABORTED at $name (later stages not started)" >&2
      exit 1
    }
  done
  echo "▶ stack up: cljs-watch → wire-server → pod"
  echo "  NOTE: the jvm is NOT part of 'all' (by design — it hosts the"
  echo "  shared nREPL 7888 that every agent's REPL/dev-hook/MCP bridge"
  echo "  runs through; bouncing it from 'all' would sever other agents'"
  echo "  live sessions). For a FULL restart run explicitly:"
  echo "    bin/seon restart jvm"
}

stop_all() {
  # Reverse dependency order: pod → wire-server → cljs-watch.
  local name reversed=""
  for name in $(stack_processes); do reversed="$name $reversed"; done
  for name in $reversed; do
    cmd_stop "$name"
  done
  echo "  NOTE: the jvm is NOT part of 'all' and was left running"
  echo "  (by design — shared nREPL 7888; see bin/seon header)."
  echo "  Stop it explicitly if you mean it: bin/seon stop jvm"
}

cmd_start() {
  local name="${1:?start requires a process name}"
  if [ "$name" = "all" ]; then start_all; return 0; fi
  acquire_lock "$name"
  _start_unlocked "$name"
  release_lock "$name"
}

cmd_stop() {
  local name="${1:?stop requires a process name}"
  if [ "$name" = "all" ]; then stop_all; return 0; fi
  acquire_lock "$name"
  _stop_unlocked "$name"
  release_lock "$name"
}

cmd_restart() {
  # One lock spans stop+start. Atomic from any other agent's POV —
  # they see "stopped" or "started" but never an intermediate state
  # where another agent could race in and start a competing instance.
  # (`restart all` is per-process atomic, not stack-atomic.)
  local name="${1:?restart requires a process name}"
  if [ "$name" = "all" ]; then stop_all; start_all; return 0; fi
  acquire_lock "$name"
  _stop_unlocked "$name"
  _start_unlocked "$name"
  release_lock "$name"
}

cmd_status() {
  local procs
  if [ "$#" -gt 0 ]; then
    procs="$*"
  else
    procs="$(all_processes)"
  fi
  for name in $procs; do
    if is_running "$name"; then
      local pid started
      pid="$(cat "$(pid_file "$name")")"
      started="$(cat "$(started_file "$name")" 2>/dev/null || echo unknown)"
      echo "● $name  pid=$pid  started=$started"
    else
      echo "○ $name  (not running)"
    fi
  done
  # Bonus: surface the pod's port if it's been written.
  if [ -f tmp/seon-port ]; then
    echo "  pod port: $(cat tmp/seon-port)  →  http://127.0.0.1:$(cat tmp/seon-port)"
  fi
}

cmd_tail() {
  local name="${1:?tail requires a process name}"
  local lf
  lf="$(log_file "$name")"
  if [ ! -f "$lf" ]; then
    echo "no log for $name — start it first (bin/seon start $name)" >&2
    exit 1
  fi
  exec tail -f "$lf"
}

cmd_logs() {
  local name="${1:?logs requires a process name}"
  local n="${2:-200}"
  local lf
  lf="$(log_file "$name")"
  if [ ! -f "$lf" ]; then
    echo "no log for $name" >&2
    exit 1
  fi
  tail -n "$n" "$lf"
}

cmd_cluster() {
  # Cluster lifecycle. Today: `reset [name]` (name defaults to
  # "default"). One command = stop pod → stop wire-server → wipe the
  # cluster's STORE DIR ONLY → start wire-server (mints a fresh DB) →
  # start pod (boot re-seeds the substrate idempotently).
  #
  # The store is the durable home of every agent/message/finding in
  # the cluster — reset is DESTRUCTIVE and deliberate; there is no
  # confirmation prompt because the caller already typed "reset".
  local sub="${1:?cluster requires a subcommand (reset)}"
  shift
  case "$sub" in
    reset) cluster_reset "${1:-default}" ;;
    *) echo "unknown cluster subcommand: $sub (try: reset [name])" >&2; exit 1 ;;
  esac
}

cluster_reset() {
  local name="$1"

  # Defensive: the name becomes a path segment under data/clusters/.
  case "$name" in
    */*|.|..|"") echo "✗ invalid cluster name: '$name'" >&2; exit 1 ;;
  esac

  # The "default" cluster lives wherever SEON_CLUSTER_DIR points (env-
  # overridable; defaults to data/clusters/default). Other names keep
  # the conventional layout.
  local store_dir
  if [ "$name" = "default" ]; then
    store_dir="$SEON_CLUSTER_DIR/store"
  else
    store_dir="data/clusters/$name/store"
  fi

  # Only the "default" cluster has registered processes today
  # (wire-server's CLI args target $SEON_CLUSTER_DIR). Other names get
  # their store wiped but no process bounce.
  local bounce=0
  [ "$name" = "default" ] && bounce=1

  echo "▶ cluster reset: $name"

  if [ "$bounce" = 1 ]; then
    cmd_stop pod
    cmd_stop wire-server
    # Stale UDS sockets from the killed server would refuse the fresh
    # one's bind; they're recreated on start.
    rm -f "$SEON_REQ_SOCK" "$SEON_PUB_SOCK"
  fi

  if [ -d "$store_dir" ]; then
    # The store dir ONLY — nothing else under data/clusters/<name>/.
    rm -rf "$store_dir"
    echo "✗ wiped $store_dir"
  else
    echo "○ no store at $store_dir (nothing to wipe)"
  fi

  if [ "$bounce" = 1 ]; then
    cmd_start wire-server
    # The pod's boot is ping-gated FAIL-LOUD against the wire socket —
    # wait for the writer to mint the fresh DB before starting it
    # (socket accepting implies datahike is up; the writer binds the
    # socket only after the DB is ready).
    wait_ready wire-server || exit 1
    cmd_start pod
    wait_ready pod || exit 1
    echo "▶ cluster $name reset complete — pod boot re-seeds the substrate"
  else
    echo "▶ cluster $name store wiped (no processes registered for it)"
  fi
}

cmd_adopt() {
  # Use case: process started manually in a terminal (e.g. node out/client/main.js
  # in a watched tab) and the supervisor should now track it.
  local name="${1:?adopt requires a process name}"
  local pid="${2:?adopt requires a PID}"
  acquire_lock "$name"
  if ! kill -0 "$pid" 2>/dev/null; then
    release_lock "$name"
    echo "✗ pid $pid not alive" >&2; exit 1
  fi
  echo "$pid"        > "$(pid_file "$name")"
  echo "(adopted)"   > "$(cmd_file "$name")"
  date -u +%FT%TZ    > "$(started_file "$name")"
  echo "● $name adopted (pid $pid)"
  echo "  (no log file managed; the foreground terminal owns stdout)"
  release_lock "$name"
}

# ============================================================
# Dispatch.
# ============================================================

case "${1:-help}" in
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status)  shift; cmd_status "$@" ;;
  tail)    shift; cmd_tail "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  adopt)   shift; cmd_adopt "$@" ;;
  prep)    shift; cmd_prep "$@" ;;
  cluster) shift; cmd_cluster "$@" ;;
  help|--help|-h|*)
    cat <<'EOF'
Usage: bin/seon <command> [process] [args...]

Commands:
  start <name|all>   Start a process (idempotent — no-op if already running)
                     `all` = cljs-watch → wire-server → pod, dependency-
                     ordered with REAL ready gates between stages (socket
                     accepting / HTTP answering / build completed).
                     jvm is NOT in `all` BY DESIGN — it hosts the shared
                     nREPL 7888 (every agent's REPL, the dev hook, the
                     MCP bridge); bouncing it inside `all` would sever
                     other agents' live sessions. Manage it by name:
                     bin/seon restart jvm. See the header comment.
  stop <name|all>    Stop a process (idempotent); `all` reverses the order
  restart <name|all> stop + start
  status [name]      Show one or all
  tail <name>        tail -f logs/<name>.log  (Ctrl-C to exit)
  logs <name> [n]    Last n lines (default 200)
  adopt <name> <pid> Register a manually-started PID under <name>
  prep               Prep git deps for the :writer and :cljs aliases
                     (clojure -P -M:<a> + clojure -X:deps prep
                     :aliases '[:<a>]'). For downstream supervisors —
                     shell out to this instead of rediscovering the
                     alias form (plain `clojure -X:deps prep` is NOT
                     enough). Idempotent; fast no-op when already
                     prepped (deps fingerprint + ~/.gitlibs check).
  cluster reset [n]  DESTRUCTIVE: stop pod+wire-server, wipe
                     data/clusters/<n>/store (default "default"),
                     restart both — fresh DB, substrate re-seeds

Processes (registered in script):
  pod          node out/client/main.js
  cljs-watch   clj -M:cljs watch client
  jvm          ./bin/run
  wire-server  clojure -M:writer ... (V2 platform Host: single-DB datahike
               wire-server; loopback REPL on 127.0.0.1:7891)

Examples:
  bin/seon start all          # whole stack, ordered + ready-gated
  bin/seon start pod && bin/seon tail pod
  bin/seon status
  bin/seon restart cljs-watch

Env overrides (downstream parametrization — defaults = today's values):
  SEON_CLUSTER_DIR        wire-server store parent (default data/clusters/default)
  SEON_REQ_SOCK           wire-server request UDS (default tmp/seon-cluster-default-req.sock)
  SEON_PUB_SOCK           wire-server publish UDS (default tmp/seon-cluster-default-pub.sock)
  SEON_WRITER_REPL_PORT   wire-server loopback REPL port (default 7891)
  SEON_PORT               pod HTTP port (default 7890; read by the pod)
  SEON_RUNTIME_ROOT       pod artifact root (read by the pod; build/source
                          artifacts resolve against it — data stays CWD-local)

Auto-prep:
  Before spawning wire-server/cljs-watch the supervisor hashes
  deps.edn's :git/url+:git/sha lines (tmp/proc/<name>/deps-fingerprint)
  and checks ~/.gitlibs; on change it runs `clojure -P -M:<alias>` +
  `clojure -X:deps prep` SYNCHRONOUSLY (logged to logs/<name>.log) so a
  sha bump never builds inside the process's ready window.

Concurrency:
  Multi-agent safe — any number of agents can invoke any command at
  any time. The supervisor uses mkdir-as-mutex per process. If a
  bin/seon invocation is killed mid-operation and leaves a stale
  lock, remove with: rm -rf tmp/proc/<name>/lock
EOF
    ;;
esac
