#!/bin/zsh
# bin/seon — Thin wrapper over the standing Seon system's `/op` EDN boundary (zero outside logic).
# Usage:
#   bin/seon start              Start standing Seon server (default http://127.0.0.1:9998)
#   bin/seon build              Build standalone native binary target/seon & verify via --self-test
#   bin/seon take-over [PORT]   Zero-downtime hand-over from running server on PORT to new binary/process
#   bin/seon self-test          Cold-boot candidate binary verifier (`--self-test`)
#   bin/seon status             System, Datahike :main, branches, tasks, and agents snapshot
#   bin/seon health             System health (derived violations, global failing tests, proc faults)
#   bin/seon test [BRANCH]      Run minimal reach-selected, fail-fast tests + seed=42 generative checks
#   bin/seon eval BRANCH CODE   Evaluate Clojure CODE inside a forked COW REPL on BRANCH
#   bin/seon var SYM            Inspect structured `:seon.code.var/*` facts, callers, callees & source
#   bin/seon schema KEY         Inspect Malli `:seon.schema/key`, derived DH attr, samples & users
#   bin/seon scope NS           Inspect co-located vars, schemas & boundary contracts for subtree NS
#   bin/seon import BRANCH PATH Import file PATH onto Datahike BRANCH
#   bin/seon diff BRANCH        Export refs/heads/seon/BRANCH (0 worktrees!) and print 3-way + git diff
#   bin/seon merge BRANCH       Generic Malli-driven 3-way merge BRANCH into Datahike :main & local Git
#   bin/seon call EDN           Send raw EDN request map to :server
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
PORT=${SEON_PORT:-9998}
URL="http://127.0.0.1:${PORT}/op"

post_edn() {
  curl -sS --noproxy '*' -X POST -H 'Content-Type: application/edn' --data-binary "$1" "$URL"
  echo
}

cmd=${1:-status}
shift || true

case "$cmd" in
  start)
    cd "$ROOT"
    source "$ROOT/bin/env"
    if [[ -x "$ROOT/target/seon" && "${SEON_BINARY:-0}" == "1" ]]; then
      exec "$ROOT/target/seon" "$@"
    else
      exec "$ROOT/target/jolt/jolt" -m seon.main "$@"
    fi
    ;;
  build)
    cd "$ROOT"
    exec "$ROOT/bin/build" seon
    ;;
  take-over)
    cd "$ROOT"
    source "$ROOT/bin/env"
    tp=${1:-$PORT}
    shift || true
    if [[ -x "$ROOT/target/seon" && "${SEON_BINARY:-0}" == "1" ]]; then
      exec "$ROOT/target/seon" --take-over "$tp" "$@"
    else
      exec "$ROOT/target/jolt/jolt" -m seon.main --take-over "$tp" "$@"
    fi
    ;;
  self-test)
    cd "$ROOT"
    source "$ROOT/bin/env"
    if [[ -x "$ROOT/target/seon" && "${SEON_BINARY:-0}" == "1" ]]; then
      exec "$ROOT/target/seon" --self-test
    else
      exec "$ROOT/target/jolt/jolt" -m seon.main --self-test
    fi
    ;;
  status)
    post_edn "{:op :status}"
    ;;
  health)
    post_edn "{:op :health}"
    ;;
  test)
    br=${1:-:main}
    post_edn "{:op :test :branch ${br}}"
    ;;
  eval)
    br=${1:?usage: bin/seon eval :branch/name '(+ 1 2)'}
    code=${2:?usage: bin/seon eval :branch/name '(+ 1 2)'}
    escaped=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$code")
    post_edn "{:op :eval :branch ${br} :code ${escaped}}"
    ;;
  var)
    sym=${1:?usage: bin/seon var seon.store/open!}
    post_edn "{:op :explore-var :var ${sym}}"
    ;;
  schema)
    kw=${1:?usage: bin/seon schema :seon.code.var/ticks-budget}
    post_edn "{:op :explore-schema :key ${kw}}"
    ;;
  import)
    br=${1:?usage: bin/seon import :branch/name src/foo.clj}
    p=${2:?usage: bin/seon import :branch/name src/foo.clj}
    escaped=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$p")
    post_edn "{:op :import-file :branch ${br} :path ${escaped}}"
    ;;
  diff)
    br=${1:?usage: bin/seon diff :branch/name}
    post_edn "{:op :diff :branch ${br}}"
    ;;
  merge)
    br=${1:?usage: bin/seon merge :branch/name}
    post_edn "{:op :merge :branch ${br}}"
    ;;
  call)
    post_edn "${1:?usage: bin/seon call '{:op :status}'}"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    exit 1
    ;;
esac
