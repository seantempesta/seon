#!/usr/bin/env bash
# bin/test-cljs — CLJS test runner via shadow-cljs :node-test target.
#
# Usage:
#   bin/test-cljs                 # compile + run all CLJS tests (~-test$ ns regexp)
#   bin/test-cljs --no-build      # skip compile; just run out/test/test.js
#   bin/test-cljs --test=seon.db-test
#                                 # compile, then run one namespace or test var
#   bin/test-cljs --no-build --test=seon.db-test/query-roundtrip
#                                 # reuse the current bundle for one test var
#   bin/test-cljs --verbose       # stream the full transcript to the terminal
#
# Config seam (per-test manifest): the node test process inherits this shell's
# env, so a run names its own manifest via SEON_CONFIG / SEON_PROFILE — the SAME
# seam bin/seon + bin/acme expose (seon.config reads them):
#   SEON_CONFIG=config/system.edn bin/test-cljs      # the dev-pod manifest
#   SEON_CONFIG=config/other.edn  bin/test-cljs      # any custom loadout
# Unset ⇒ config/test.edn (the :gate surface — see the on-core-error note
# below; an explicit SEON_CONFIG always wins).
#
# Exit codes: 0 = pass, 1 = fail, 2 = compile/build error
#
# Output: out/test/test.js (intermediate)
#         tmp/test-cljs-<timestamp>.log (full transcript, tmp/test-cljs-latest.log symlinked)
#         tmp/test-cljs-<timestamp>.report.edn (structured verdict, latest symlinked)
#
# Wave 4.5 item C — Platform track. Gates Wave 4b verification.

set -uo pipefail
cd "$(dirname "$0")/.."
source bin/_java-home-resolver

# A Ctrl-C during the final `node | tee` pipeline used to leave the Node test
# child reparented to launchd, where it kept a CPU core busy indefinitely.
# Kill every direct child while this shell still owns them; normal completion
# has no live children, so the EXIT arm is a no-op. The lock is acquired below
# and released by the same trap so compile and execution remain one bracket.
TEST_LOCK="tmp/test-cljs.lock"
LOCK_OWNED=0
cleanup() {
  local children
  children="$(pgrep -P $$ 2>/dev/null || true)"
  if [ -n "$children" ]; then
    kill $children 2>/dev/null || true
  fi
  if [ "$LOCK_OWNED" -eq 1 ]; then
    rm -rf -- "$TEST_LOCK"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Fail-loud render dial (seon.config/render-strict?): ON by default in the
# test harness so a swallowed render/converter failure SCREAMS (throws with
# the offending block + the full malli explain) the moment it happens,
# instead of hiding behind a one-line "⚠ … render failed" guard. The live
# prod pod boots WITHOUT this var → graceful guard-and-continue (a prod
# agent must not hard-crash on one bad block). Respect an explicit override.
export SEON_RENDER_STRICT="${SEON_RENDER_STRICT:-1}"

# Core-fault dial per surface (error-blame-strict-gate, RULED 2026-07-04):
# the SUITE/CI runner MUST stay :gate (a mid-run :core fault must NOT .exit
# the shared node-test runner), while the dev pod may run :crash. The
# sanctioned ONE-manifest path for a per-surface divergence is a SEPARATE
# file (no #profile, env must not shadow config): config/test.edn leaves
# :seon.config/on-core-error UNSET → the :gate default. Both the node-test
# RUNTIME (seon.error/escalate! reads config/on-core-error) and the gate
# below read this file, so they agree. An explicit SEON_CONFIG still wins.
export SEON_CONFIG="${SEON_CONFIG:-config/test.edn}"

BUILD=1
VERBOSE=0
TEST_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --no-build) BUILD=0 ;;
    --verbose) VERBOSE=1 ;;
    --test=*) TEST_ARGS+=("$arg") ;;
    --help|-h)
      sed -n '2,15p' "$0"
      exit 0
      ;;
    *) echo "Unknown arg: $arg"; exit 2 ;;
  esac
done

mkdir -p tmp out/test
TMPOUT="tmp/test-cljs-$(date +%Y%m%d-%H%M%S)-$$.log"
REPORTOUT="${TMPOUT%.log}.report.edn"

# One output bundle means one compile+run owner. Two agents compiling different
# focused namespace sets into out/test/test.js can otherwise each run the other
# agent's artifact. A mkdir lock is atomic and portable to macOS Bash 3.2.
# Never wait invisibly: an active owner is reported immediately; a dead owner's
# lock is recovered once.
acquire_test_lock() {
  if mkdir "$TEST_LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "$TEST_LOCK/pid"
    LOCK_OWNED=1
    return 0
  fi

  local owner=""
  local owner_command=""
  if [ -f "$TEST_LOCK/pid" ]; then
    owner="$(sed -n '1p' "$TEST_LOCK/pid" 2>/dev/null || true)"
  fi
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
    owner_command="$(ps -p "$owner" -o command= 2>/dev/null || true)"
    if printf '%s\n' "$owner_command" | grep -q 'test-cljs'; then
      echo "Another pod test owns $TEST_LOCK (pid $owner); not racing its bundle."
      exit 2
    fi
  fi

  rm -rf -- "$TEST_LOCK"
  if ! mkdir "$TEST_LOCK" 2>/dev/null; then
    echo "Could not acquire $TEST_LOCK after removing a stale owner."
    exit 2
  fi
  printf '%s\n' "$$" > "$TEST_LOCK/pid"
  LOCK_OWNED=1
}

acquire_test_lock

# Runtime --test selectors also define the compile graph. Shadow's node-test
# target accepts an explicit :namespaces vector (test_util.clj); using it avoids
# compiling every -test$ namespace for a focused run. A selector may name a
# namespace or one fully-qualified var. Comma-separated selectors follow
# Shadow's own CLI grammar.
SELECTED_NS=()
SELECTED_EXACT=()
if [ "${#TEST_ARGS[@]}" -gt 0 ]; then
  for test_arg in "${TEST_ARGS[@]}"; do
    selector="${test_arg#--test=}"
    old_ifs="$IFS"
    IFS=','
    for selected in $selector; do
      IFS="$old_ifs"
      ns="${selected%%/*}"
      if ! printf '%s\n' "$ns" | grep -Eq '^[A-Za-z_][A-Za-z0-9_.-]*$'; then
        echo "Invalid CLJS test namespace in selector: $selected"
        exit 2
      fi
      duplicate=0
      case " ${SELECTED_NS[*]-} " in
        *" $ns "*) duplicate=1 ;;
      esac
      [ "$duplicate" -eq 0 ] && SELECTED_NS+=("$ns")
      if [ "$selected" != "$ns" ]; then
        duplicate=0
        case " ${SELECTED_EXACT[*]-} " in
          *" $selected "*) duplicate=1 ;;
        esac
        [ "$duplicate" -eq 0 ] && SELECTED_EXACT+=("$selected")
      fi
      IFS=','
    done
    IFS="$old_ifs"
  done
fi
REQUESTED_EXACT_COUNT=${#SELECTED_EXACT[@]}

NAMESPACE_EDN=""
if [ "${#SELECTED_NS[@]}" -gt 0 ]; then
  NAMESPACE_EDN="${SELECTED_NS[*]}"
fi

# The bundle fingerprint binds --no-build to the exact namespace selection,
# source/config/dependency inputs, and downstream compile flavor that created
# it. It is intentionally content-based: timestamps do not make a build stale,
# while an edit with a preserved mtime still does. Reuse the operator's one
# streaming digest implementation rather than launching a checksum process per
# source file.
build_fingerprint() {
  local paths=(src test config deps.edn shadow-cljs.edn package.json package-lock.json bb.edn bin/test-cljs)
  if [ -n "${SEON_EXTRA_SRC:-}" ] && [ -d "$SEON_EXTRA_SRC" ]; then
    paths+=("$SEON_EXTRA_SRC/src" "$SEON_EXTRA_SRC/test"
            "$SEON_EXTRA_SRC/deps.edn" "$SEON_EXTRA_SRC/package.json"
            "$SEON_EXTRA_SRC/package-lock.json")
  fi

  local source_digest
  source_digest="$(bb --config bb.edn --deps-root . -e \
    '(require (quote seon.dev.artifact))
     (print (seon.dev.artifact/digest-paths
              (first *command-line-args*)
              (rest *command-line-args*)))' \
    -- "$PWD" "${paths[@]}")"
  {
    printf 'namespaces=%s\n' "$NAMESPACE_EDN"
    printf 'extra-src=%s\n' "${SEON_EXTRA_SRC:-}"
    printf 'extra-preload=%s\n' "${SEON_EXTRA_PRELOAD:-}"
    printf 'extra-npm=%s\n' "${SEON_EXTRA_NPM:-}"
    printf 'config=%s\n' "${SEON_CONFIG:-}"
    printf 'source=%s\n' "$source_digest"
  } | shasum -a 256 | awk '{print $1}'
}

FINGERPRINT_FILE="out/test/.seon-test-fingerprint"
EXPECTED_FINGERPRINT="$(build_fingerprint)"

# Timestamped names sort newest-first. Keep a small bounded diagnostic tail;
# the latest symlink remains the stable human/tool entrypoint.
prune_test_logs() {
  local n=0
  while IFS= read -r log; do
    n=$((n + 1))
    if [ "$n" -gt 20 ]; then
      rm -f -- "$log" "${log%.log}.report.edn"
    fi
  done < <(find tmp -maxdepth 1 -type f -name 'test-cljs-[0-9]*.log' -print | sort -r)
}

# Every invocation publishes a small EDN index beside the unabridged log. A
# human gets the compact terminal verdict; an agent can read stable structured
# counts and then open the exact full transcript without rerunning the suite.
write_test_report() {
  local status="$1"
  local phase="$2"
  local complete="$3"
  local tests="$4"
  local assertions="$5"
  local failures="$6"
  local errors="$7"
  local compile_seconds="$8"
  local node_seconds="$9"
  local namespaces="${10}"
  local node_exit="${11}"
  local core_faults="${12}"
  local requested_exact="${13:-nil}"
  local matched_exact="${14:-nil}"
  local executed_exact="${15:-nil}"
  {
    printf '{:seon.dev.test-runner/status :%s\n' "$status"
    printf ' :seon.dev.test-runner/phase :%s\n' "$phase"
    printf ' :seon.dev.test-runner/complete? %s\n' "$complete"
    printf ' :seon.dev.test-runner/tests %s\n' "$tests"
    printf ' :seon.dev.test-runner/assertions %s\n' "$assertions"
    printf ' :seon.dev.test-runner/failures %s\n' "$failures"
    printf ' :seon.dev.test-runner/errors %s\n' "$errors"
    printf ' :seon.dev.test-runner/core-faults %s\n' "$core_faults"
    printf ' :seon.dev.test-runner/requested-exact-selectors %s\n' "$requested_exact"
    printf ' :seon.dev.test-runner/matched-exact-selectors %s\n' "$matched_exact"
    printf ' :seon.dev.test-runner/executed-exact-selectors %s\n' "$executed_exact"
    printf ' :seon.dev.test-runner/namespaces %s\n' "$namespaces"
    printf ' :seon.dev.test-runner/compile-seconds %s\n' "$compile_seconds"
    printf ' :seon.dev.test-runner/node-seconds %s\n' "$node_seconds"
    printf ' :seon.dev.test-runner/node-exit %s\n' "$node_exit"
    printf ' :seon.dev.test-runner/full-log "%s"}\n' "$TMPOUT"
  } > "$REPORTOUT"
  ln -sf "$(basename "$TMPOUT")" tmp/test-cljs-latest.log
  ln -sf "$(basename "$REPORTOUT")" tmp/test-cljs-latest.report.edn
}

START=$(date +%s)
COMPILE_ELAPSED=0
COMPILE_STATUS="skipped (--no-build)"

if [ "$BUILD" = "1" ]; then
  rm -f -- "$FINGERPRINT_FILE" "$FINGERPRINT_FILE.tmp"
  COMPILE_START=$(date +%s)
  # DEV compile (not `release`): the core resolves fns by walking
  # goog.global at munged paths (seon.eval/lookup-value, malli.instrument's
  # -get-ns). Closure :simple/:advanced flatten namespaces into the bundle's
  # local scope, so a release :test build renders every context section as
  # <unresolved-section> and makes instrumentation a no-op. The pod itself
  # runs dev-compiled (`clj -M:cljs compile client`) — dev compile keeps
  # the test env faithful to the live core. (2026-06-09)
  #
  # SEON_EXTRA_SRC (task #36): when set, the downstream's deps.edn project
  # joins the classpath via -Sdeps :local/root. SEON_EXTRA_PRELOAD is appended
  # to the node-test dev preload vector so downstream registration is live for
  # tests that exercise it.
  COMPILE_CMD=(clojure)
  if [ -n "${SEON_EXTRA_SRC:-}" ]; then
    COMPILE_CMD+=(-Sdeps "{:deps {seon.extra/src {:local/root \"$SEON_EXTRA_SRC\"}}}")
  fi
  COMPILE_CMD+=(-M:cljs compile test)
  # The long-running full-graph watcher is the sole publisher of changed-test
  # artifacts. One-shot focused compiles share the build definition but must
  # never replace that authoritative manifest with their partial graph.
  CONFIG_MERGE="{:seon.dev.test-artifact/publish? false}"
  if [ -n "$NAMESPACE_EDN" ] && [ -n "${SEON_EXTRA_SRC:-}" ] && [ -n "${SEON_EXTRA_PRELOAD:-}" ]; then
    CONFIG_MERGE="{:seon.dev.test-artifact/publish? false :namespaces [$NAMESPACE_EDN] :devtools {:preloads [$SEON_EXTRA_PRELOAD]}}"
  elif [ -n "$NAMESPACE_EDN" ]; then
    CONFIG_MERGE="{:seon.dev.test-artifact/publish? false :namespaces [$NAMESPACE_EDN]}"
  elif [ -n "${SEON_EXTRA_SRC:-}" ] && [ -n "${SEON_EXTRA_PRELOAD:-}" ]; then
    CONFIG_MERGE="{:seon.dev.test-artifact/publish? false :devtools {:preloads [$SEON_EXTRA_PRELOAD]}}"
  fi
  COMPILE_CMD+=(--config-merge "$CONFIG_MERGE")
  echo "== Preparing :cljs dependencies =="
  bb --config bb.edn --deps-root . -e \
    '(require (quote seon.dev.artifact) (quote seon.dev.config))
     (seon.dev.artifact/prepare-dependencies!
       (seon.dev.config/load! (System/getProperty "user.dir"))
       [:cljs])
     nil' 2>&1 | tee "$TMPOUT"
  PREP_EXIT=${PIPESTATUS[0]}
  if [ "$PREP_EXIT" -ne 0 ]; then
    COMPILE_END=$(date +%s)
    COMPILE_ELAPSED=$((COMPILE_END - COMPILE_START))
    write_test_report error dependency-prep false nil nil nil nil \
      "$COMPILE_ELAPSED" nil nil nil nil "$REQUESTED_EXACT_COUNT" nil nil
    prune_test_logs
    echo "Dependency preparation failed; full output: $TMPOUT"
    exit 2
  fi
  echo "== Compiling :test build (shadow-cljs, dev) =="
  "${COMPILE_CMD[@]}" 2>&1 | tee -a "$TMPOUT"
  COMPILE_EXIT=${PIPESTATUS[0]}
  if [ "$COMPILE_EXIT" -ne 0 ]; then
    COMPILE_END=$(date +%s)
    COMPILE_ELAPSED=$((COMPILE_END - COMPILE_START))
    write_test_report error compile false nil nil nil nil \
      "$COMPILE_ELAPSED" nil nil nil nil "$REQUESTED_EXACT_COUNT" nil nil
    prune_test_logs
    echo ""
    echo "========================================"
    echo "COMPILE FAIL (${COMPILE_ELAPSED}s)"
    echo "Full output: $TMPOUT"
    echo "Summary report: $REPORTOUT"
    echo "========================================"
    exit 2
  fi
  printf '%s\n' "$EXPECTED_FINGERPRINT" > "$FINGERPRINT_FILE.tmp"
  mv "$FINGERPRINT_FILE.tmp" "$FINGERPRINT_FILE"
  COMPILE_END=$(date +%s)
  COMPILE_ELAPSED=$((COMPILE_END - COMPILE_START))
  COMPILE_STATUS="${COMPILE_ELAPSED}s"
else
  if [ ! -f "$FINGERPRINT_FILE" ]; then
    echo "--no-build refused: out/test/test.js has no matching build fingerprint."
    echo "Run the same command once without --no-build."
    exit 2
  fi
  ACTUAL_FINGERPRINT="$(sed -n '1p' "$FINGERPRINT_FILE")"
  if [ "$ACTUAL_FINGERPRINT" != "$EXPECTED_FINGERPRINT" ]; then
    echo "--no-build refused: source, config, dependencies, or test selection changed."
    echo "Run the same command once without --no-build."
    exit 2
  fi
fi

if [ ! -f "out/test/test.js" ]; then
  echo "out/test/test.js missing — build step skipped or failed"
  exit 2
fi

echo ""
echo "== Running tests (node out/test/test.js) =="
NODE_START=$(date +%s)
NODE_CMD=(node out/test/test.js)
if [ "${#TEST_ARGS[@]}" -gt 0 ]; then
  NODE_CMD+=("${TEST_ARGS[@]}")
fi

# The timestamped log is the complete forensic transcript. The terminal is a
# control surface: expected negative-path fixtures routinely emit multi-line
# Datahike/LLM errors and ordinary runtime info, which used to bury the one
# assertion a human needed. Default to compact progress + final cljs.test
# counts; `--verbose` remains the explicit live-transcript escape hatch.
compact_node_output() {
  awk '
    /^Testing / {
      started += 1
      if (started == 1) printf "progress: "
      printf "."
      if (started % 50 == 0) printf " %d namespaces\nprogress: ", started
      system("")
      next
    }
    /^Ran [0-9]+ tests containing/ || /^[0-9]+ failures, [0-9]+ errors\.$/ {
      if (!closed) { printf " %d namespaces\n", started; closed = 1 }
      print
      system("")
      next
    }
    /SHADOW import error/ {
      if (!closed) { printf "\n"; closed = 1 }
      print
      system("")
    }
    END {
      if (started > 0 && !closed) printf " %d namespaces\n", started
    }
  '
}

if [ "$VERBOSE" -eq 1 ]; then
  "${NODE_CMD[@]}" 2>&1 | tee -a "$TMPOUT"
  NODE_EXIT=${PIPESTATUS[0]}
else
  "${NODE_CMD[@]}" 2>&1 | tee -a "$TMPOUT" | compact_node_output
  NODE_EXIT=${PIPESTATUS[0]}
fi
NODE_END=$(date +%s)
NODE_ELAPSED=$((NODE_END - NODE_START))

# ---------------------------------------------------------------------------
# Verdict — based on EXIT CODE + SUMMARY-PRESENCE + cljs.test's own
# "FAIL in ("/"ERROR in (" reports, never a bare FAIL|ERROR log grep.
#
# WHY exit 0 alone is NOT a pass: the :node-test runner sequences EVERY test
# as one async block (cljs.test/run-block). An async test that never calls its
# `done` continuation breaks the chain — finish-test-run never runs, so the
# :summary / :end-run-tests reports never fire, `js/process.exit` is never
# called, node's event loop drains, and node exits 0. Every namespace sorted
# after the staller is then silently skipped: a FALSE GREEN (this is exactly
# how a /call RCE once shipped "green").
#
# A COMPLETE run always prints cljs.test's summary ("Ran N tests containing M
# assertions." + "F failures, E errors.") — emitted only by finish-test-run
# after the LAST block fn. Its PRESENCE proves the run reached the end; its
# ABSENCE proves the one authoritative run did not complete. Real failures are
# counted from cljs.test's own "FAIL in ("/"ERROR in (" report lines (anchored,
# so datahike log lines / inline tx-data blobs that merely contain the word
# "error" are not mistaken for failures). A failed/incomplete run is never
# retried or stitched together with output from another process.
# ---------------------------------------------------------------------------
# NOTE: `grep -c` already prints the count (0 when no match), it just exits 1
# in that case — so NO `|| echo 0` (that would print a SECOND 0, yielding the
# multi-line "0\n0" that breaks `[ "$x" -eq 0 ]`). Empty (missing file) →
# callers default with `: "${VAR:=0}"`.
parse_ran()     { grep -acE '^Testing ' "$1" 2>/dev/null; }
parse_summary() { grep -aE '^Ran [0-9]+ tests containing' "$1" | tail -1; }
parse_realfail(){ grep -acE '^(FAIL|ERROR) in \(' "$1" 2>/dev/null; }
parse_counts()  { grep -aE '^[0-9]+ failures, [0-9]+ errors\.' "$1" | tail -1; }

RAN=$(parse_ran "$TMPOUT"); : "${RAN:=0}"
SUMMARY_LINE=$(parse_summary "$TMPOUT")
COUNTS_LINE=$(parse_counts "$TMPOUT")
SELECTION_LINE=$(grep -aE '^SHADOW-TEST-SELECTION requested-exact=[0-9]+ matched-exact=[0-9]+ selected-vars=[0-9]+$' "$TMPOUT" | tail -1)
REAL_FAILS=$(parse_realfail "$TMPOUT"); : "${REAL_FAILS:=0}"

INCOMPLETE=0
[ -z "$SUMMARY_LINE" ] && INCOMPLETE=1

# A missing summary can mean either a module-load failure or an async test that
# never called its continuation. A load failure occurs before cljs.test starts
# any namespace; an invalid-schema later in an executing suite is a test/runtime
# failure, not evidence that the bundle failed to load.
LOAD_FAILED=0
if [ "$INCOMPLETE" -ne 0 ] && [ "$RAN" -eq 0 ] && \
   grep -qaE 'SHADOW import error|malli\.core/invalid-schema|register that keyword first|is not a valid Malli schema' "$TMPOUT"; then
  LOAD_FAILED=1
fi

# ---------------------------------------------------------------------------
# Core-fault strict gate (error-blame-strict-gate, RULED 2026-07-04).
# seon.error/record! prints one `SEON-CORE-FAULT …` marker line per
# :seon.error/fault :core error — a CORE bug (never an agent error; :agent
# faults never print the marker, never gate). A run can be assertion-green
# and still have accumulated one; under the manifest dial
# :seon.config/on-core-error :gate (the default) that run FAILS. :log
# disables the gate (prod/demo posture). The transcript IS the run bracket
# here — node tests use hermetic per-test in-memory conns, so datom
# counting has no stable store to bracket; the marker is the observable.
# ---------------------------------------------------------------------------
# Count SEON-CORE-FAULT markers but NOT the SEON-EXPECTED-CORE-FAULT variant
# (a deliberately-provoked fault bracketed by seon.error/expecting-core-fault!
# — datom still written, gate not counted). The two markers do not collide as
# substrings, but the -v filter makes the intent explicit and robust.
CORE_FAULTS=$(grep -a 'SEON-CORE-FAULT' "$TMPOUT" | grep -vac 'SEON-EXPECTED-CORE-FAULT')
: "${CORE_FAULTS:=0}"
CORE_MANIFEST="${SEON_CONFIG:-config/system.edn}"
CORE_DIAL=$(grep -oE ':seon\.config/on-core-error[[:space:]]+:[a-z]+' "$CORE_MANIFEST" 2>/dev/null | awk '{print $2}' | head -1)
CORE_DIAL="${CORE_DIAL:-:gate}"
CORE_GATE_TRIPPED=0
if [ "$CORE_DIAL" != ":log" ] && [ "$CORE_FAULTS" -gt 0 ]; then
  CORE_GATE_TRIPPED=1
fi

REPORTED_REQUESTED_EXACT=nil
MATCHED_EXACT_COUNT=nil
EXACT_SELECTION_INVALID=0
if [ "$REQUESTED_EXACT_COUNT" -gt 0 ]; then
  if [ -z "$SELECTION_LINE" ]; then
    EXACT_SELECTION_INVALID=1
  else
    REPORTED_REQUESTED_EXACT=$(printf '%s\n' "$SELECTION_LINE" | sed -E 's/.*requested-exact=([0-9]+).*/\1/')
    MATCHED_EXACT_COUNT=$(printf '%s\n' "$SELECTION_LINE" | sed -E 's/.*matched-exact=([0-9]+).*/\1/')
    if [ "$REPORTED_REQUESTED_EXACT" -ne "$REQUESTED_EXACT_COUNT" ] || \
       [ "$MATCHED_EXACT_COUNT" -ne "$REQUESTED_EXACT_COUNT" ]; then
      EXACT_SELECTION_INVALID=1
    fi
  fi
fi

VERDICT_FAIL=0
[ "$NODE_EXIT" -ne 0 ] && VERDICT_FAIL=1
[ "$INCOMPLETE" -ne 0 ] && VERDICT_FAIL=1
[ "$REAL_FAILS" -ne 0 ] && VERDICT_FAIL=1
[ "$CORE_GATE_TRIPPED" -ne 0 ] && VERDICT_FAIL=1
[ "$EXACT_SELECTION_INVALID" -ne 0 ] && VERDICT_FAIL=1

TEST_COUNT=$(printf '%s\n' "$SUMMARY_LINE" | awk '{print $2}')
ASSERTION_COUNT=$(printf '%s\n' "$SUMMARY_LINE" | awk '{print $5}')
FAILURE_COUNT=$(printf '%s\n' "$COUNTS_LINE" | awk '{print $1}')
ERROR_COUNT=$(printf '%s\n' "$COUNTS_LINE" | awk '{print $3}')
: "${TEST_COUNT:=nil}" "${ASSERTION_COUNT:=nil}"
: "${FAILURE_COUNT:=nil}" "${ERROR_COUNT:=nil}"
REPORT_STATUS=pass
[ "$VERDICT_FAIL" -ne 0 ] && REPORT_STATUS=fail
REPORT_COMPLETE=true
[ "$INCOMPLETE" -ne 0 ] && REPORT_COMPLETE=false
EXECUTED_EXACT_COUNT=nil
if [ "$INCOMPLETE" -eq 0 ] && [ "$MATCHED_EXACT_COUNT" != nil ]; then
  EXECUTED_EXACT_COUNT="$MATCHED_EXACT_COUNT"
elif [ "$EXACT_SELECTION_INVALID" -ne 0 ] && \
     [ "$MATCHED_EXACT_COUNT" != nil ] && [ "$NODE_EXIT" -ne 0 ]; then
  # The pinned Shadow runner rejects the unmatched request before executing
  # any selected var. Missing telemetry remains nil rather than inventing proof.
  EXECUTED_EXACT_COUNT=0
fi
write_test_report "$REPORT_STATUS" runtime "$REPORT_COMPLETE" \
  "$TEST_COUNT" "$ASSERTION_COUNT" "$FAILURE_COUNT" "$ERROR_COUNT" \
  "$COMPILE_ELAPSED" "$NODE_ELAPSED" "$RAN" "$NODE_EXIT" "$CORE_FAULTS" \
  "$REQUESTED_EXACT_COUNT" "$MATCHED_EXACT_COUNT" "$EXECUTED_EXACT_COUNT"

END=$(date +%s)
ELAPSED=$((END - START))

echo ""
echo "========================================"
echo "compile: ${COMPILE_STATUS}"
echo "node: ${NODE_ELAPSED}s; namespaces started: ${RAN}; exit: ${NODE_EXIT}"
[ "$REQUESTED_EXACT_COUNT" -gt 0 ] && \
  echo "exact selectors: requested ${REQUESTED_EXACT_COUNT}; matched ${MATCHED_EXACT_COUNT}; executed ${EXECUTED_EXACT_COUNT}"
[ -n "$SUMMARY_LINE" ] && echo "summary: ${SUMMARY_LINE}  ${COUNTS_LINE}"
if [ "$VERDICT_FAIL" -eq 0 ]; then
  echo "PASS (${ELAPSED}s total)"
else
  echo "FAIL (${ELAPSED}s total)"
  if [ "$INCOMPLETE" -ne 0 ]; then
    echo ""
    if [ "$LOAD_FAILED" -ne 0 ]; then
      echo "INCOMPLETE: the single Node run failed while loading the cold bundle;"
      echo "no final cljs.test summary was emitted. Load error:"
      grep -aE 'is not a valid Malli schema|malli\.core/invalid-schema|SHADOW import error' "$TMPOUT" \
        | head -3 | cut -c1-400 | sed 's/^/  /' || true
    else
      LAST_STARTED=$(grep -aE '^Testing ' "$TMPOUT" | tail -1 | sed -E 's/^Testing *//' || true)
      echo "INCOMPLETE: the single Node run emitted no final cljs.test summary."
      echo "An async test may have failed to call its done continuation; the run"
      echo "fails as observed and is not retried in a fresh process."
      [ -n "$LAST_STARTED" ] && echo "Last namespace started: ${LAST_STARTED}"
    fi
  fi
  if [ "$REAL_FAILS" -ne 0 ]; then
    echo ""
    echo "Failures/errors (cljs.test reports only):"
    # cut guards against MB-sized single lines (datahike tx blobs inline whole
    # tx-data). Anchored to cljs.test's own "FAIL in ("/"ERROR in (".
    grep -aE '^(FAIL|ERROR) in \(' "$TMPOUT" | cut -c1-400 | head -40 || true
  fi
  if [ "$CORE_GATE_TRIPPED" -ne 0 ]; then
    echo ""
    echo "CORE-FAULT GATE (:seon.config/on-core-error ${CORE_DIAL}): the run"
    echo "accumulated ${CORE_FAULTS} :seon.error/fault :core error(s) — CORE bugs,"
    echo "independent of the assertions above. Fix the underlying defect (each"
    echo "line below is one seon.error/record! marker):"
    grep -a 'SEON-CORE-FAULT' "$TMPOUT" | grep -v 'SEON-EXPECTED-CORE-FAULT' | cut -c1-300 | head -20 || true
  fi
  if [ "$EXACT_SELECTION_INVALID" -ne 0 ]; then
    echo ""
    echo "EXACT SELECTOR MISMATCH: requested ${REQUESTED_EXACT_COUNT}; matched ${MATCHED_EXACT_COUNT}."
    echo "A nonempty exact-var request must match every requested test."
  fi
fi
echo "========================================"

prune_test_logs
echo "Full output: $TMPOUT (or tmp/test-cljs-latest.log)"
echo "Summary report: $REPORTOUT (or tmp/test-cljs-latest.report.edn)"

if [ "$VERDICT_FAIL" -eq 0 ]; then exit 0; else exit 1; fi
