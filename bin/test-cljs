#!/usr/bin/env bash
# bin/test-cljs — CLJS test runner via shadow-cljs :node-test target.
#
# Usage:
#   bin/test-cljs                 # compile + run all CLJS tests (~-test$ ns regexp)
#   bin/test-cljs --no-build      # skip compile; just run out/test/test.js
#   bin/test-cljs --test=seon.db-test
#                                 # compile, then run one namespace or test var
#   bin/test-cljs --no-build --test=seon.db-test/query-roundtrip
#                                 # reuse the current bundle for one test var
#
# Config seam (per-test manifest): the node test process inherits this shell's
# env, so a run names its own manifest via SEON_CONFIG / SEON_PROFILE — the SAME
# seam bin/seon + bin/acme expose (seon.config reads them):
#   SEON_CONFIG=config/system.edn bin/test-cljs      # the dev-pod manifest
#   SEON_CONFIG=config/other.edn  bin/test-cljs      # any custom loadout
# Unset ⇒ config/test.edn (the :gate surface — see the on-core-error note
# below; an explicit SEON_CONFIG always wins).
#
# Exit codes: 0 = pass, 1 = fail, 2 = compile/build error
#
# Output: out/test/test.js (intermediate)
#         tmp/test-cljs-<timestamp>.log (full transcript, tmp/test-cljs-latest.log symlinked)
#
# Wave 4.5 item C — Platform track. Gates Wave 4b verification.

set -uo pipefail
cd "$(dirname "$0")/.."

# A Ctrl-C during the final `node | tee` pipeline used to leave the Node test
# child reparented to launchd, where it kept a CPU core busy indefinitely.
# Kill every direct child while this shell still owns them; normal completion
# has no live children, so the EXIT arm is a no-op.
cleanup_children() {
  local children
  children="$(pgrep -P $$ 2>/dev/null || true)"
  if [ -n "$children" ]; then
    kill $children 2>/dev/null || true
  fi
}
trap cleanup_children EXIT INT TERM

# Fail-loud render dial (seon.config/render-strict?): ON by default in the
# test harness so a swallowed render/converter failure SCREAMS (throws with
# the offending block + the full malli explain) the moment it happens,
# instead of hiding behind a one-line "⚠ … render failed" guard. The live
# prod pod boots WITHOUT this var → graceful guard-and-continue (a prod
# agent must not hard-crash on one bad block). Respect an explicit override.
export SEON_RENDER_STRICT="${SEON_RENDER_STRICT:-1}"

# Core-fault dial per surface (error-blame-strict-gate, RULED 2026-07-04):
# the SUITE/CI runner MUST stay :gate (a mid-run :core fault must NOT .exit
# the shared node-test runner), while the dev pod may run :crash. The
# sanctioned ONE-manifest path for a per-surface divergence is a SEPARATE
# file (no #profile, env must not shadow config): config/test.edn leaves
# :seon.config/on-core-error UNSET → the :gate default. Both the node-test
# RUNTIME (seon.error/escalate! reads config/on-core-error) and the gate
# below read this file, so they agree. An explicit SEON_CONFIG still wins.
export SEON_CONFIG="${SEON_CONFIG:-config/test.edn}"

BUILD=1
TEST_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --no-build) BUILD=0 ;;
    --test=*) TEST_ARGS+=("$arg") ;;
    --help|-h)
      sed -n '2,15p' "$0"
      exit 0
      ;;
    *) echo "Unknown arg: $arg"; exit 2 ;;
  esac
done

mkdir -p tmp out/test
TMPOUT="tmp/test-cljs-$(date +%Y%m%d-%H%M%S)-$$.log"

# Timestamped names sort newest-first. Keep a small bounded diagnostic tail;
# the latest symlink remains the stable human/tool entrypoint.
prune_test_logs() {
  local n=0
  while IFS= read -r log; do
    n=$((n + 1))
    if [ "$n" -gt 20 ]; then
      rm -f -- "$log"
    fi
  done < <(find tmp -maxdepth 1 -type f -name 'test-cljs-[0-9]*.log' -print | sort -r)
}

START=$(date +%s)
COMPILE_ELAPSED=0
COMPILE_STATUS="skipped (--no-build)"

if [ "$BUILD" = "1" ]; then
  COMPILE_START=$(date +%s)
  # DEV compile (not `release`): the core resolves fns by walking
  # goog.global at munged paths (seon.eval/lookup-value, malli.instrument's
  # -get-ns). Closure :simple/:advanced flatten namespaces into the bundle's
  # local scope, so a release :test build renders every context section as
  # <unresolved-section> and makes instrumentation a no-op. The pod itself
  # runs dev-compiled (`clj -M:cljs compile client`) — dev compile keeps
  # the test env faithful to the live core. (2026-06-09)
  #
  # SEON_EXTRA_SRC (task #36): when set, the downstream's deps.edn project
  # joins the classpath via -Sdeps :local/root — the :test build's
  # :ns-regexp "-test$" then sweeps THEIR tests too (feature for them).
  # The
  # SEON_EXTRA_PRELOAD entry ns is appended to :devtools :preloads via
  # --config-merge (node-test honors preloads — shadow node_test.clj:50),
  # so extra-core registration is live for tests that exercise it.
  # All vars unset = today's command byte-identical.
  COMPILE_CMD=(clojure)
  if [ -n "${SEON_EXTRA_SRC:-}" ]; then
    COMPILE_CMD+=(-Sdeps "{:deps {seon.extra/src {:local/root \"$SEON_EXTRA_SRC\"}}}")
  fi
  COMPILE_CMD+=(-M:cljs compile test)
  if [ -n "${SEON_EXTRA_SRC:-}" ] && [ -n "${SEON_EXTRA_PRELOAD:-}" ]; then
    COMPILE_CMD+=(--config-merge "{:devtools {:preloads [$SEON_EXTRA_PRELOAD]}}")
  fi
  echo "== Compiling :test build (shadow-cljs, dev) =="
  if ! "${COMPILE_CMD[@]}" 2>&1 | tee "$TMPOUT"; then
    COMPILE_END=$(date +%s)
    COMPILE_ELAPSED=$((COMPILE_END - COMPILE_START))
    echo ""
    echo "========================================"
    echo "COMPILE FAIL (${COMPILE_ELAPSED}s)"
    echo "Full output: $TMPOUT"
    echo "========================================"
    exit 2
  fi
  COMPILE_END=$(date +%s)
  COMPILE_ELAPSED=$((COMPILE_END - COMPILE_START))
  COMPILE_STATUS="${COMPILE_ELAPSED}s"
fi

if [ ! -f "out/test/test.js" ]; then
  echo "out/test/test.js missing — build step skipped or failed"
  exit 2
fi

echo ""
echo "== Running tests (node out/test/test.js) =="
NODE_START=$(date +%s)
NODE_CMD=(node out/test/test.js)
if [ "${#TEST_ARGS[@]}" -gt 0 ]; then
  NODE_CMD+=("${TEST_ARGS[@]}")
fi
"${NODE_CMD[@]}" 2>&1 | tee -a "$TMPOUT"
NODE_EXIT=${PIPESTATUS[0]}
NODE_END=$(date +%s)
NODE_ELAPSED=$((NODE_END - NODE_START))

# ---------------------------------------------------------------------------
# Verdict — based on EXIT CODE + SUMMARY-PRESENCE + cljs.test's own
# "FAIL in ("/"ERROR in (" reports, never a bare FAIL|ERROR log grep.
#
# WHY exit 0 alone is NOT a pass: the :node-test runner sequences EVERY test
# as one async block (cljs.test/run-block). An async test that never calls its
# `done` continuation breaks the chain — finish-test-run never runs, so the
# :summary / :end-run-tests reports never fire, `js/process.exit` is never
# called, node's event loop drains, and node exits 0. Every namespace sorted
# after the staller is then silently skipped: a FALSE GREEN (this is exactly
# how a /call RCE once shipped "green").
#
# A COMPLETE run always prints cljs.test's summary ("Ran N tests containing M
# assertions." + "F failures, E errors.") — emitted only by finish-test-run
# after the LAST block fn. Its PRESENCE proves the run reached the end; its
# ABSENCE proves the one authoritative run did not complete. Real failures are
# counted from cljs.test's own "FAIL in ("/"ERROR in (" report lines (anchored,
# so datahike log lines / inline tx-data blobs that merely contain the word
# "error" are not mistaken for failures). A failed/incomplete run is never
# retried or stitched together with output from another process.
# ---------------------------------------------------------------------------
# NOTE: `grep -c` already prints the count (0 when no match), it just exits 1
# in that case — so NO `|| echo 0` (that would print a SECOND 0, yielding the
# multi-line "0\n0" that breaks `[ "$x" -eq 0 ]`). Empty (missing file) →
# callers default with `: "${VAR:=0}"`.
parse_ran()     { grep -acE '^Testing ' "$1" 2>/dev/null; }
parse_summary() { grep -aE '^Ran [0-9]+ tests containing' "$1" | tail -1; }
parse_realfail(){ grep -acE '^(FAIL|ERROR) in \(' "$1" 2>/dev/null; }
parse_counts()  { grep -aE '^[0-9]+ failures, [0-9]+ errors\.' "$1" | tail -1; }

RAN=$(parse_ran "$TMPOUT"); : "${RAN:=0}"
SUMMARY_LINE=$(parse_summary "$TMPOUT")
COUNTS_LINE=$(parse_counts "$TMPOUT")
REAL_FAILS=$(parse_realfail "$TMPOUT"); : "${REAL_FAILS:=0}"

INCOMPLETE=0
[ -z "$SUMMARY_LINE" ] && INCOMPLETE=1

# A missing summary can mean either a module-load failure or an async test that
# never called its continuation. Diagnose known cold-load errors from the SAME
# run without changing the verdict or launching a second process.
LOAD_FAILED=0
if [ "$INCOMPLETE" -ne 0 ] && \
   grep -qaE 'SHADOW import error|malli\.core/invalid-schema|register that keyword first|is not a valid Malli schema' "$TMPOUT"; then
  LOAD_FAILED=1
fi

# ---------------------------------------------------------------------------
# Core-fault strict gate (error-blame-strict-gate, RULED 2026-07-04).
# seon.error/record! prints one `SEON-CORE-FAULT …` marker line per
# :seon.error/fault :core error — a CORE bug (never an agent error; :agent
# faults never print the marker, never gate). A run can be assertion-green
# and still have accumulated one; under the manifest dial
# :seon.config/on-core-error :gate (the default) that run FAILS. :log
# disables the gate (prod/demo posture). The transcript IS the run bracket
# here — node tests use hermetic per-test in-memory conns, so datom
# counting has no stable store to bracket; the marker is the observable.
# ---------------------------------------------------------------------------
# Count SEON-CORE-FAULT markers but NOT the SEON-EXPECTED-CORE-FAULT variant
# (a deliberately-provoked fault bracketed by seon.error/expecting-core-fault!
# — datom still written, gate not counted). The two markers do not collide as
# substrings, but the -v filter makes the intent explicit and robust.
CORE_FAULTS=$(grep -a 'SEON-CORE-FAULT' "$TMPOUT" | grep -vac 'SEON-EXPECTED-CORE-FAULT')
: "${CORE_FAULTS:=0}"
CORE_MANIFEST="${SEON_CONFIG:-config/system.edn}"
CORE_DIAL=$(grep -oE ':seon\.config/on-core-error[[:space:]]+:[a-z]+' "$CORE_MANIFEST" 2>/dev/null | awk '{print $2}' | head -1)
CORE_DIAL="${CORE_DIAL:-:gate}"
CORE_GATE_TRIPPED=0
if [ "$CORE_DIAL" != ":log" ] && [ "$CORE_FAULTS" -gt 0 ]; then
  CORE_GATE_TRIPPED=1
fi

VERDICT_FAIL=0
[ "$NODE_EXIT" -ne 0 ] && VERDICT_FAIL=1
[ "$INCOMPLETE" -ne 0 ] && VERDICT_FAIL=1
[ "$REAL_FAILS" -ne 0 ] && VERDICT_FAIL=1
[ "$CORE_GATE_TRIPPED" -ne 0 ] && VERDICT_FAIL=1

END=$(date +%s)
ELAPSED=$((END - START))

echo ""
echo "========================================"
echo "compile: ${COMPILE_STATUS}"
echo "node: ${NODE_ELAPSED}s; namespaces started: ${RAN}; exit: ${NODE_EXIT}"
[ -n "$SUMMARY_LINE" ] && echo "summary: ${SUMMARY_LINE}  ${COUNTS_LINE}"
if [ "$VERDICT_FAIL" -eq 0 ]; then
  echo "PASS (${ELAPSED}s total)"
else
  echo "FAIL (${ELAPSED}s total)"
  if [ "$INCOMPLETE" -ne 0 ]; then
    echo ""
    if [ "$LOAD_FAILED" -ne 0 ]; then
      echo "INCOMPLETE: the single Node run failed while loading the cold bundle;"
      echo "no final cljs.test summary was emitted. Load error:"
      grep -aE 'is not a valid Malli schema|malli\.core/invalid-schema|SHADOW import error' "$TMPOUT" \
        | head -3 | cut -c1-400 | sed 's/^/  /' || true
    else
      LAST_STARTED=$(grep -aE '^Testing ' "$TMPOUT" | tail -1 | sed -E 's/^Testing *//' || true)
      echo "INCOMPLETE: the single Node run emitted no final cljs.test summary."
      echo "An async test may have failed to call its done continuation; the run"
      echo "fails as observed and is not retried in a fresh process."
      [ -n "$LAST_STARTED" ] && echo "Last namespace started: ${LAST_STARTED}"
    fi
  fi
  if [ "$REAL_FAILS" -ne 0 ]; then
    echo ""
    echo "Failures/errors (cljs.test reports only):"
    # cut guards against MB-sized single lines (datahike tx blobs inline whole
    # tx-data). Anchored to cljs.test's own "FAIL in ("/"ERROR in (".
    grep -aE '^(FAIL|ERROR) in \(' "$TMPOUT" | cut -c1-400 | head -40 || true
  fi
  if [ "$CORE_GATE_TRIPPED" -ne 0 ]; then
    echo ""
    echo "CORE-FAULT GATE (:seon.config/on-core-error ${CORE_DIAL}): the run"
    echo "accumulated ${CORE_FAULTS} :seon.error/fault :core error(s) — CORE bugs,"
    echo "independent of the assertions above. Fix the underlying defect (each"
    echo "line below is one seon.error/record! marker):"
    grep -a 'SEON-CORE-FAULT' "$TMPOUT" | grep -v 'SEON-EXPECTED-CORE-FAULT' | cut -c1-300 | head -20 || true
  fi
fi
echo "========================================"

ln -sf "$(basename "$TMPOUT")" tmp/test-cljs-latest.log
prune_test_logs
echo "Full output: $TMPOUT (or tmp/test-cljs-latest.log)"

if [ "$VERDICT_FAIL" -eq 0 ]; then exit 0; else exit 1; fi
