#!/usr/bin/env bash
# bin/test-cljs — CLJS test runner via shadow-cljs :node-test target.
#
# Usage:
#   bin/test-cljs                 # compile + run all CLJS tests (~-test$ ns regexp)
#   bin/test-cljs --no-build      # skip compile; just run out/test/test.js
#   bin/test-cljs --watch         # shadow-cljs watch + auto-rerun (TODO: detached path)
#
# Config seam (per-test manifest): the node test process inherits this shell's
# env, so a run names its own manifest via SEON_CONFIG / SEON_PROFILE — the SAME
# seam bin/seon + bin/acme expose (seon.config reads them):
#   SEON_CONFIG=config/test.edn bin/test-cljs        # custom loadout/routes/skills
#   SEON_PROFILE=minimal        bin/test-cljs        # a #profile variant of system.edn
# Unset ⇒ config/system.edn / :default profile (today's behavior, unchanged).
#
# Exit codes: 0 = pass, 1 = fail, 2 = compile/build error
#
# Output: out/test/test.js (intermediate)
#         tmp/test-cljs-<timestamp>.log (full transcript, tmp/test-cljs-latest.log symlinked)
#
# Wave 4.5 item C — Platform track. Gates Wave 4b verification.

set -uo pipefail
cd "$(dirname "$0")/.."

# Fail-loud render dial (seon.config/render-strict?): ON by default in the
# test harness so a swallowed render/converter failure SCREAMS (throws with
# the offending block + the full malli explain) the moment it happens,
# instead of hiding behind a one-line "⚠ … render failed" guard. The live
# prod pod boots WITHOUT this var → graceful guard-and-continue (a prod
# agent must not hard-crash on one bad block). Respect an explicit override.
export SEON_RENDER_STRICT="${SEON_RENDER_STRICT:-1}"

BUILD=1

for arg in "$@"; do
  case "$arg" in
    --no-build) BUILD=0 ;;
    --help|-h)
      sed -n '2,11p' "$0"
      exit 0
      ;;
    *) echo "Unknown arg: $arg"; exit 2 ;;
  esac
done

mkdir -p tmp out/test
TMPOUT="tmp/test-cljs-$(date +%Y%m%d-%H%M%S)-$$.log"

START=$(date +%s)

if [ "$BUILD" = "1" ]; then
  # DEV compile (not `release`): the core resolves fns by walking
  # goog.global at munged paths (seon.eval/lookup-value, malli.instrument's
  # -get-ns). Closure :simple/:advanced flatten namespaces into the bundle's
  # local scope, so a release :test build renders every context section as
  # <unresolved-section> and makes instrumentation a no-op. The pod itself
  # runs dev-compiled (`clj -M:cljs compile client`) — dev compile keeps
  # the test env faithful to the live core. (2026-06-09)
  #
  # SEON_EXTRA_SRC (task #36): when set, the downstream's deps.edn project
  # joins the classpath via -Sdeps :local/root — the :test build's
  # :ns-regexp "-test$" then sweeps THEIR tests too (feature for them;
  # seon CI/gym stays env-clean — bin/gym strips these vars). The
  # SEON_EXTRA_PRELOAD entry ns is appended to :devtools :preloads via
  # --config-merge (node-test honors preloads — shadow node_test.clj:50),
  # so extra-core registration is live for tests that exercise it.
  # All vars unset = today's command byte-identical.
  COMPILE_CMD=(clojure)
  if [ -n "${SEON_EXTRA_SRC:-}" ]; then
    COMPILE_CMD+=(-Sdeps "{:deps {seon.extra/src {:local/root \"$SEON_EXTRA_SRC\"}}}")
  fi
  COMPILE_CMD+=(-M:cljs compile test)
  if [ -n "${SEON_EXTRA_SRC:-}" ] && [ -n "${SEON_EXTRA_PRELOAD:-}" ]; then
    COMPILE_CMD+=(--config-merge "{:devtools {:preloads [$SEON_EXTRA_PRELOAD]}}")
  fi
  echo "== Compiling :test build (shadow-cljs, dev) =="
  if ! "${COMPILE_CMD[@]}" 2>&1 | tee "$TMPOUT"; then
    echo ""
    echo "========================================"
    echo "COMPILE FAIL"
    echo "Full output: $TMPOUT"
    echo "========================================"
    exit 2
  fi
fi

if [ ! -f "out/test/test.js" ]; then
  echo "out/test/test.js missing — build step skipped or failed"
  exit 2
fi

# ---------------------------------------------------------------------------
# Truncation backstop, part 1 — DISCOVER how many test namespaces the runner
# will iterate. This is the runner's OWN view (`env/get-test-namespaces`, what
# `--list` prints), which is the authority because it INCLUDES probe nses that
# register `deftest`s but don't match the `-test$` discovery regexp (e.g.
# seon.test.*-probes). The compiled `_test.js` import set UNDER-counts those.
#
# `--list` never calls `js/process.exit` (shadow.test.node only exits from the
# :end-run-tests report), so it would hang — we poll until the printed count
# stabilises (~3s unchanged), then kill. A short/incomplete --list only WEAKENS
# the ran<discovered cross-check; it can never false-FAIL a good run (the
# summary-presence gate below is the hard stall detector, and an undercounted
# DISCOVERED keeps RAN >= DISCOVERED).
# ---------------------------------------------------------------------------
LISTLOG="tmp/test-cljs-list-$$.log"
: > "$LISTLOG"
node out/test/test.js --list > "$LISTLOG" 2>&1 &
LISTPID=$!
PREV=-1; STABLE=0
for _ in $(seq 1 90); do
  sleep 1
  kill -0 "$LISTPID" 2>/dev/null || break
  CUR=$(grep -acE '^Namespace:' "$LISTLOG" 2>/dev/null); : "${CUR:=0}"
  if [ "$CUR" -gt 0 ] && [ "$CUR" -eq "$PREV" ]; then
    STABLE=$((STABLE + 1)); [ "$STABLE" -ge 3 ] && break
  else
    STABLE=0
  fi
  PREV=$CUR
done
kill -9 "$LISTPID" 2>/dev/null || true
wait "$LISTPID" 2>/dev/null || true
DISCOVERED=$(grep -acE '^Namespace:' "$LISTLOG" 2>/dev/null); : "${DISCOVERED:=0}"

# ---------------------------------------------------------------------------
# COLD-BOOT LOAD GATE — a successfully-COMPILED bundle that throws at module
# load (`require`) time, before any test runs. The `--list` cold load above
# already exercised real, fresh-process registration order; if it produced
# ZERO namespaces AND emitted a load error, the bundle failed to LOAD.
#
# The dominant cause is a SCHEMA REGISTRATION-ORDER break: a
# `seon.schema/register!` whose form references another schema keyword not yet
# registered in cold-boot order — malli rejects it eagerly
# (`:malli.core/invalid-schema`, "register that keyword first"), which aborts
# the namespace's top-level load and crashes the whole bundle. The warm
# dev-hook reload MASKS this (the prior registration survives in the defonce
# `*schemas` atom), so ONLY a fresh process — this run, or a cold pod boot —
# catches it. We diagnose it HERE, crisply, instead of falling through to the
# verdict's TRUNCATED path, which assumes a hung async `done` (a STALL) and so
# misreports a load crash as an async-runner stall.
# ---------------------------------------------------------------------------
if [ "$DISCOVERED" -eq 0 ] && \
   grep -qaE 'SHADOW import error|malli\.core/invalid-schema|register that keyword first|is not a valid Malli schema' "$LISTLOG"; then
  cat "$LISTLOG" >> "$TMPOUT" 2>/dev/null || true
  echo ""
  echo "========================================"
  echo "FAIL — BUNDLE FAILED TO LOAD (cold-boot schema registration order)"
  echo ""
  echo "The compiled test bundle threw at module load (require), before any"
  echo "test ran — so NOTHING was exercised (this is NOT an async-runner stall)."
  echo "Almost always a schema load-order break: a seon.schema/register! form"
  echo "references another schema keyword not registered yet in cold-boot order."
  echo "Register the referent FIRST (in the SAME ns, ABOVE the referrer)."
  echo ""
  echo "The warm dev-hook reload MASKS this — the prior registration survives in"
  echo "the defonce registry; only a fresh process (this run / a cold pod boot)"
  echo "exercises real registration order. Load error:"
  grep -aE 'is not a valid Malli schema|malli\.core/invalid-schema|SHADOW import error' "$LISTLOG" \
    | head -3 | cut -c1-400 | sed 's/^/  /'
  echo "========================================"
  rm -f "$LISTLOG"
  ln -sf "$(basename "$TMPOUT")" tmp/test-cljs-latest.log 2>/dev/null || true
  echo "Full output: $TMPOUT (or tmp/test-cljs-latest.log)"
  exit 1
fi

echo ""
echo "== Running tests (node out/test/test.js) =="
node out/test/test.js 2>&1 | tee -a "$TMPOUT"
NODE_EXIT=${PIPESTATUS[0]}

# ---------------------------------------------------------------------------
# Verdict — based on EXIT CODE + RAN-COUNT + SUMMARY-PRESENCE + cljs.test's own
# "FAIL in ("/"ERROR in (" reports, never a bare FAIL|ERROR log grep.
#
# WHY exit 0 alone is NOT a pass: the :node-test runner sequences EVERY test
# as one async block (cljs.test/run-block). An async test that never calls its
# `done` continuation breaks the chain — finish-test-run never runs, so the
# :summary / :end-run-tests reports never fire, `js/process.exit` is never
# called, node's event loop drains, and node exits 0. Every namespace sorted
# after the staller is then silently skipped: a FALSE GREEN (this is exactly
# how a /call RCE once shipped "green").
#
# A COMPLETE run always prints cljs.test's summary ("Ran N tests containing M
# assertions." + "F failures, E errors.") — emitted only by finish-test-run
# after the LAST block fn. Its PRESENCE proves the run reached the end; its
# ABSENCE proves truncation. We additionally require RAN == DISCOVERED. Real
# failures are counted from cljs.test's own "FAIL in ("/"ERROR in (" report
# lines (anchored, so datahike log lines / inline tx-data blobs that merely
# contain the word "error" are not mistaken for failures).
# ---------------------------------------------------------------------------
# NOTE: `grep -c` already prints the count (0 when no match), it just exits 1
# in that case — so NO `|| echo 0` (that would print a SECOND 0, yielding the
# multi-line "0\n0" that breaks `[ "$x" -eq 0 ]`). Empty (missing file) →
# callers default with `: "${VAR:=0}"`.
parse_ran()     { grep -acE '^Testing ' "$1" 2>/dev/null; }
parse_summary() { grep -aE '^Ran [0-9]+ tests containing' "$1" | tail -1; }
parse_realfail(){ grep -acE '^(FAIL|ERROR) in \(' "$1" 2>/dev/null; }
parse_counts()  { grep -aE '^[0-9]+ failures, [0-9]+ errors\.' "$1" | tail -1; }

RAN=$(parse_ran "$TMPOUT"); : "${RAN:=0}"
SUMMARY_LINE=$(parse_summary "$TMPOUT")
COUNTS_LINE=$(parse_counts "$TMPOUT")
REAL_FAILS=$(parse_realfail "$TMPOUT"); : "${REAL_FAILS:=0}"

TRUNCATED=0
[ -z "$SUMMARY_LINE" ] && TRUNCATED=1
[ "$DISCOVERED" -gt 0 ] && [ "$RAN" -lt "$DISCOVERED" ] && TRUNCATED=1

# ---------------------------------------------------------------------------
# Tail-retry — recover an INTERMITTENT async-runner stall (NOT failures).
#
# The single-process :node-test runner is fragile under load: heavyweight
# `^:async`/await tests near the END of the suite (peak event-loop pressure,
# made worse by the preceding `compile test`) intermittently wedge the shared
# run-block continuation, dropping every later namespace. The DROPPED
# namespaces pass cleanly when run on their own (no cumulative pressure), so
# when — and ONLY when — the run truncated with the clean-exit signature (node
# exit 0, no summary) and ZERO real failures so far, re-run the un-completed
# namespaces (the missing ones + the last one to start, which stalled mid-way)
# in a FRESH process and merge. A real failure is never retried away; a stall
# that re-stalls is reported. This is recovery, not green-washing — the
# backstop above still fails the build if the retry doesn't fully complete.
# ---------------------------------------------------------------------------
RESCUED=0
RETRY_NOTE=""
if [ "$TRUNCATED" -ne 0 ] && [ "$REAL_FAILS" -eq 0 ] && [ "$NODE_EXIT" -eq 0 ] && [ "$DISCOVERED" -gt 0 ]; then
  LAST_STARTED=$(grep -aE '^Testing ' "$TMPOUT" | tail -1 | sed -E 's/^Testing *//')
  MISSING=$(comm -23 \
    <(grep -aE '^Namespace:' "$LISTLOG" | sed -E 's/^Namespace: *//' | sort -u) \
    <(grep -aE '^Testing '   "$TMPOUT"  | sed -E 's/^Testing *//'   | sort -u))
  RETRY_NSES=$(printf '%s\n%s\n' "$MISSING" "$LAST_STARTED" | sed '/^$/d' | sort -u)
  RETRY_CSV=$(printf '%s' "$RETRY_NSES" | tr '\n' ',' | sed 's/,$//')
  RETRY_N=$(printf '%s\n' "$RETRY_NSES" | grep -c .)
  if [ -n "$RETRY_CSV" ]; then
    echo ""
    echo "== Truncation detected — re-running ${RETRY_N} un-completed namespace(s) in a fresh process =="
    echo "   ${RETRY_CSV}"
    RETRYLOG="tmp/test-cljs-retry-$$.log"; : > "$RETRYLOG"
    node out/test/test.js --test="$RETRY_CSV" > "$RETRYLOG" 2>&1 &
    RP=$!
    for _ in $(seq 1 180); do sleep 1; kill -0 "$RP" 2>/dev/null || break; done
    if kill -0 "$RP" 2>/dev/null; then kill -9 "$RP" 2>/dev/null; RETRY_EXIT=137; else wait "$RP"; RETRY_EXIT=$?; fi
    grep -aE '^Testing |^Ran [0-9]+ tests containing|^[0-9]+ failures, [0-9]+ errors\.|^(FAIL|ERROR) in \(' "$RETRYLOG" | cut -c1-200
    cat "$RETRYLOG" >> "$TMPOUT"
    RETRY_RAN=$(parse_ran "$RETRYLOG"); : "${RETRY_RAN:=0}"
    RETRY_SUMMARY=$(parse_summary "$RETRYLOG")
    RETRY_RF=$(parse_realfail "$RETRYLOG"); : "${RETRY_RF:=0}"
    if [ -n "$RETRY_SUMMARY" ] && [ "$RETRY_EXIT" -eq 0 ] && [ "$RETRY_RAN" -ge "$RETRY_N" ] && [ "$RETRY_RF" -eq 0 ]; then
      RESCUED=1; TRUNCATED=0
      RETRY_NOTE="recovered: ${RETRY_RAN} un-completed namespace(s) re-ran cleanly in a fresh process (intermittent :node-test runner stall)"
    else
      RETRY_NOTE="retry did NOT recover — still truncated or now failing"
      REAL_FAILS=$((REAL_FAILS + RETRY_RF))
    fi
    rm -f "$RETRYLOG"
  fi
fi

# ---------------------------------------------------------------------------
# Core-fault strict gate (error-blame-strict-gate, RULED 2026-07-04).
# seon.error/record! prints one `SEON-CORE-FAULT …` marker line per
# :seon.error/fault :core error — a CORE bug (never an agent error; :agent
# faults never print the marker, never gate). A run can be assertion-green
# and still have accumulated one; under the manifest dial
# :seon.config/on-core-error :gate (the default) that run FAILS. :log
# disables the gate (prod/demo posture). The transcript IS the run bracket
# here — the node-test world is hermetic per-test in-memory conns, so datom
# counting has no stable store to bracket; the marker is the observable.
# ---------------------------------------------------------------------------
CORE_FAULTS=$(grep -ac 'SEON-CORE-FAULT' "$TMPOUT")
: "${CORE_FAULTS:=0}"
CORE_MANIFEST="${SEON_CONFIG:-config/system.edn}"
CORE_DIAL=$(grep -oE ':seon\.config/on-core-error[[:space:]]+:[a-z]+' "$CORE_MANIFEST" 2>/dev/null | awk '{print $2}' | head -1)
CORE_DIAL="${CORE_DIAL:-:gate}"
CORE_GATE_TRIPPED=0
if [ "$CORE_DIAL" != ":log" ] && [ "$CORE_FAULTS" -gt 0 ]; then
  CORE_GATE_TRIPPED=1
fi

VERDICT_FAIL=0
[ "$NODE_EXIT" -ne 0 ] && VERDICT_FAIL=1
[ "$TRUNCATED" -ne 0 ] && VERDICT_FAIL=1
[ "$REAL_FAILS" -ne 0 ] && VERDICT_FAIL=1
[ "$CORE_GATE_TRIPPED" -ne 0 ] && VERDICT_FAIL=1

END=$(date +%s)
ELAPSED=$((END - START))

echo ""
echo "========================================"
if [ "$RESCUED" -ne 0 ]; then
  echo "namespaces: all ${DISCOVERED} ran (after tail-retry; node exit ${NODE_EXIT})"
else
  echo "namespaces: ran ${RAN} of ${DISCOVERED} discovered  (node exit ${NODE_EXIT})"
fi
[ -n "$SUMMARY_LINE" ] && echo "first pass: ${SUMMARY_LINE}  ${COUNTS_LINE}"
[ -n "$RETRY_NOTE" ] && echo "tail-retry: ${RETRY_NOTE}"
if [ "$VERDICT_FAIL" -eq 0 ]; then
  echo "PASS (${ELAPSED}s)"
else
  echo "FAIL (${ELAPSED}s)"
  if [ "$TRUNCATED" -ne 0 ]; then
    echo ""
    echo "TRUNCATED: the run did not complete every namespace (no end-of-run"
    echo "summary, or ran < discovered). A test stalled the shared async"
    echo ":node-test runner (a hung async \`done\`) and the tail-retry did not"
    echo "recover it. Namespaces that never completed:"
    comm -23 \
      <(grep -aE '^Namespace:' "$LISTLOG" | sed -E 's/^Namespace: *//' | sort -u) \
      <(grep -aE '^Testing '   "$TMPOUT"  | sed -E 's/^Testing *//'   | sort -u) \
      | sed 's/^/  - /'
  fi
  if [ "$REAL_FAILS" -ne 0 ]; then
    echo ""
    echo "Failures/errors (cljs.test reports only):"
    # cut guards against MB-sized single lines (datahike tx blobs inline whole
    # tx-data). Anchored to cljs.test's own "FAIL in ("/"ERROR in (".
    grep -aE '^(FAIL|ERROR) in \(' "$TMPOUT" | cut -c1-400 | head -40 || true
  fi
  if [ "$CORE_GATE_TRIPPED" -ne 0 ]; then
    echo ""
    echo "CORE-FAULT GATE (:seon.config/on-core-error ${CORE_DIAL}): the run"
    echo "accumulated ${CORE_FAULTS} :seon.error/fault :core error(s) — CORE bugs,"
    echo "independent of the assertions above. Fix the underlying defect (each"
    echo "line below is one seon.error/record! marker):"
    grep -a 'SEON-CORE-FAULT' "$TMPOUT" | cut -c1-300 | head -20 || true
  fi
fi
echo "========================================"

rm -f "$LISTLOG"
ln -sf "$(basename "$TMPOUT")" tmp/test-cljs-latest.log
echo "Full output: $TMPOUT (or tmp/test-cljs-latest.log)"

if [ "$VERDICT_FAIL" -eq 0 ]; then exit 0; else exit 1; fi
