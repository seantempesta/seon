#!/usr/bin/env bash
# bin/gym — run the AGENT-GYM scenario harness and surface its scorecards.
#
# The stub-tier gym scenarios execute inside the CLJS test suite
# (seon.gym.driver-test), so this is a thin wrapper around bin/test-cljs
# that greps the emitted `SEON-GYM SCORECARD` lines back out. Scorecards
# are keyed (scenario × git sha) — diff them across commits to quantify
# context iteration.
#
# Usage:
#   bin/gym                       # compile + run suite, print scorecards
#   bin/gym --no-build            # skip compile (reuse out/test/test.js)
#   bin/gym --paid=s32,s21,s12    # ALSO run the named paid-tier
#                                 # scenarios (or --paid=all). COSTS REAL
#                                 # MONEY — needs DEEPSEEK_API_KEY. Drives
#                                 # seon.gym.paid-test via SEON_GYM_PAID.
#
# Without --paid, paid-tier scenarios NEVER run (budget guard in the
# driver + env-var gate in seon.gym.paid-test).

set -uo pipefail
cd "$(dirname "$0")/.."

mkdir -p tmp
LOG="tmp/gym-latest.log"

PAID=""
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --paid=*) PAID="${arg#--paid=}" ;;
    *) ARGS+=("$arg") ;;
  esac
done

# Gym measurements run against the STOCK substrate: strip the
# SEON_EXTRA_* downstream knobs so an operator shell that exports them
# can't leak a downstream's source/preload/npm roots into what the gym
# scores (extra-src spec invariant — research doc §d; same idea as
# paid_test's SEON_AI_* load-time snapshot, applied at COMPILE time
# because SEON_EXTRA_SRC acts on the shadow classpath, not the runtime).
SEON_GYM_PAID="$PAID" env -u SEON_EXTRA_SRC -u SEON_EXTRA_PRELOAD -u SEON_EXTRA_NPM \
  bin/test-cljs "${ARGS[@]+"${ARGS[@]}"}" | tee "$LOG"
STATUS=${PIPESTATUS[0]}

echo ""
echo "== AGENT-GYM paid gate (gym-upgrade §3.3 — value + resolved enabled-set) =="
grep -a "SEON-GYM PAID-GATE" "$LOG" \
  || echo "WARNING: no PAID-GATE line in the log — gate observability regressed (seon.gym.paid-test)"

echo ""
echo "== AGENT-GYM scorecards (scenario × git sha × run-id) =="
grep -a "SEON-GYM SCORECARD" "$LOG" || echo "(none emitted)"

# §3.1: the same card printed twice (double-done class) shows up as a
# duplicated run-id — every run-scenario! mints a fresh uuid.
DUP_RUN_IDS=$(grep -a "SEON-GYM SCORECARD" "$LOG" \
  | grep -oE ':seon\.gym\.scorecard/run-id #uuid "[^"]+"' \
  | sort | uniq -d)
if [ -n "$DUP_RUN_IDS" ]; then
  echo ""
  echo "WARNING: duplicate scorecard run-ids — a card printed twice (async double-done class):"
  echo "$DUP_RUN_IDS"
fi

exit "$STATUS"
