#!/bin/zsh
# bin/seon-import: Claude Code's PostToolUse hook on Edit and Write (registered in .claude/settings.json): the file a
# session just wrote is imported onto its Seon agent's branch, so a session works as a Seon agent does (AGENTS.md §0).
# A thin wrapper over the standing root's import op (seon_import: seon.server's op-answer :import, my.branch/import! on the
# session's agent: the checkout's branch jolt/<area> names session/<area>, my.root/branch-agent). Reads the hook's JSON on stdin (tool_input.file_path); a file
# outside a checkout or no standing root imports nothing and says why on stderr; the hook never blocks the edit (exit 0).
# See docs/server.md#working-a-task-from-a-worktree.
emulate -L zsh; setopt pipefail
f=$(perl -MJSON::PP -0777 -e 'my $j = eval { decode_json(<STDIN>) } || {}; print(($j->{tool_input} // {})->{file_path} // "")')
[[ -n $f && -f $f ]] || exit 0
root=$(git -C ${f:h} rev-parse --show-toplevel 2>/dev/null) || exit 0
# the standing root: the main checkout's (a worktree's git dir names it)
main=${$(git -C $root rev-parse --path-format=absolute --git-common-dir):h}
port=$(<$main/runs/root.port 2>/dev/null) || { print -u2 "seon-import: no standing root ($main/runs/root.port): ${f#$root/} not imported"; exit 0 }
print -u2 -r -- "seon-import ${f#$root/}: $(SEON_MCP_CLIENT=checkout-$root $root/bin/mcp call --port $port import path=$f 2>&1)"
exit 0
