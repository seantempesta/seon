# Seon — example environment / config surface
#
# Copy to .env (and/or `export` these in your shell). This file IS Seon's
# entire config surface: Seon has NO config file — every knob is an env var,
# read at boot (and most re-read live). Values below are the real defaults
# and accepted values, sourced from the code read-sites. Replace placeholder
# secrets (sk-...) with real keys; never commit your real .env.
#
# Process layout: a cluster = one JVM database server (sole Datahike writer) +
# one Node pod (agent loop + web UI). bin/seon supervises both.

# =============================================================================
# CONFIG MANIFEST / SKILLS  (optional — shape context + skill loadout, no code)
# =============================================================================
# Override path of the consolidated manifest — a per-cluster variant is a
# SEPARATE edn file (config/acme.edn, config/test.edn). Default:
# config/system.edn. (SEON_PROFILE is INERT in the pod config path — variants
# are separate files, not #profile.)
# SEON_CONFIG=/abs/path/to/system.edn
# Skill corpus directory scanned for the agent skill catalog. Default:
# .claude/skills (the standard Claude-Code layout humans edit too).
# SEON_SKILLS_DIR=.claude/skills

# =============================================================================
# LLM PROVIDER  (required to actually drive agents)
# =============================================================================
# Which LLM adapter the agent turn loop talks to. The provider + non-secret
# config seed a DB-owned :seon.ai/config row at first boot; later DB edits
# (model/provider switch) persist and win. Secrets are NEVER stored — always
# read live from the env var below.

# Accepted values: deepseek | anthropic | openai-compat | diffusiongemma
#   deepseek       — OpenAI-compatible DeepSeek endpoint (the shipped pod default)
#   anthropic      — Anthropic SDK (Claude models)
#   openai-compat  — any OpenAI-compatible chat-completions gateway; requires SEON_AI_BASE_URL
#   diffusiongemma — the DiffusionGemma model on a RunPod serverless endpoint
#                    (see the DIFFUSIONGEMMA block below). When unconfigured
#                    (no endpoint/key) or the endpoint is down, the agent loop
#                    gets a graceful :seon.ai/error value — never a crash.
# Default (unset): deepseek
SEON_AI_PROVIDER=deepseek

# --- API keys (set the one matching your provider) ---
# anthropic provider reads ONLY this var (the Anthropic bearer key):
ANTHROPIC_API_KEY=sk-ant-...
# deepseek provider's shipped default key var:
DEEPSEEK_API_KEY=sk-...
# Conventional fallback key, used by openai-compat / deepseek when the
# specific var above is absent:
SEON_AI_API_KEY=sk-...
# Name of the env var that HOLDS the key (openai-compat enterprise gateways
# that use a non-standard key var). When set, the adapter reads the key from
# the var you name here. Default (unset): provider's own resolution order.
# SEON_AI_API_KEY_ENV=MY_GATEWAY_TOKEN

# --- Model + generation tuning (all optional; adapter defaults apply if unset) ---
# Model id. Defaults: deepseek -> "deepseek-v4-pro"; anthropic -> "claude-opus-4-8"
# (anthropic also accepts claude-sonnet-4-6 / claude-haiku-4-5 / claude-fable-5).
# SEON_AI_MODEL=claude-opus-4-8
# Required ONLY for openai-compat (the chat-completions root URL; no shipped
# default). For deepseek it defaults to https://api.deepseek.com/v1.
# SEON_AI_BASE_URL=https://gateway.example.com/v1
# Max output tokens. Default: 4096.
# SEON_AI_MAX_TOKENS=4096
# Sampling temperature (double). DeepSeek default: 0.7. OpenAI-compatible
# gateways omit it unless explicitly configured; some models fix sampling and
# reject any supplied value.
# SEON_AI_TEMPERATURE=0.7
# Reasoning/thinking effort. "false" (off — default) | "true" | a level like
# "high"/"max". Stored as a string; parsed per-adapter.
# SEON_AI_THINKING=false
# Per-call wall-clock timeout in ms. Default: 60000.
# SEON_AI_TIMEOUT_MS=60000
# Extra request-body fields as an EDN MAP string (e.g. vendor-specific knobs).
# Must read as a map or it is ignored.
# SEON_AI_EXTRA_BODY={:chat_template_kwargs {:enable_thinking false}}

# Kimi K3 (Moonshot; OpenAI-compatible). The official key variable is
# MOONSHOT_API_KEY. K3 always thinks and currently supports only max effort, so
# leave SEON_AI_THINKING unset/false; the adapter then omits reasoning_effort
# and Kimi applies its required default. Do not set SEON_AI_TEMPERATURE.
# SEON_AI_PROVIDER=openai-compat
# SEON_AI_BASE_URL=https://api.moonshot.ai/v1
# SEON_AI_MODEL=kimi-k3
# SEON_AI_API_KEY_ENV=MOONSHOT_API_KEY
# Max LLM retry attempts on a TRANSIENT provider error (429/5xx/transport);
# exponential jittered backoff, total-duration capped. Default: 4.
# SEON_AI_MAX_RETRIES=4

# =============================================================================
# DIFFUSIONGEMMA  (provider :diffusiongemma — RunPod serverless GPU worker)
# =============================================================================
# Used ONLY when SEON_AI_PROVIDER=diffusiongemma. One provider, two backends
# (SEON_DG_BACKEND): :control = the transformers RunPod worker that keeps the
# per-step LogitsProcessor seam (seon.ai.diffusiongemma; the async /run + poll
# transport); :vllm = an OpenAI-compatible serving endpoint (reuses the
# openai-compat adapter — set SEON_AI_BASE_URL + key instead of the vars here).
# Default backend (unset): control.
# SEON_DG_BACKEND=control
#
# --- :control backend config (the per-step worker) ---
# RunPod endpoint id for the DiffusionGemma worker (the short id from the
# RunPod console, e.g. "u50y7khhos5t7o"). REQUIRED for the :control backend;
# unset/blank → a graceful "endpoint not configured" :seon.ai/error value.
# Falls back to DIFFGEMMA_EP (the diffusion experiment driver's var) so ONE
# endpoint id set in .env serves both the Python driver and this provider.
# A full http(s) URL here is used AS the worker base instead — that's how a
# LOCAL worker speaking the same wire contract plugs in (e.g. the dg_mlx MLX
# worker on Apple Silicon: `uv run python -m dg_mlx.worker` in its repo).
# SEON_DG_ENDPOINT=u50y7khhos5t7o
# SEON_DG_ENDPOINT=http://127.0.0.1:17860
# DIFFGEMMA_EP=u50y7khhos5t7o          # the experiment driver's var; also read here
# Name of the env var holding the RunPod bearer key. Default: RUNPOD_API_KEY.
# (The key VALUE is read from process.env at call time — NEVER stored/logged.)
# SEON_DG_API_KEY_ENV=RUNPOD_API_KEY
# The RunPod bearer key itself (also used by the diffusion experiments).
# RUNPOD_API_KEY=...
#
# Output cap (SEON_AI_MAX_TOKENS above) is honored as the worker's
# max_new_tokens, like every other provider. To go live: deploy the worker,
# set SEON_DG_ENDPOINT + RUNPOD_API_KEY, set SEON_AI_PROVIDER=diffusiongemma.

# =============================================================================
# EMBEDDINGS  (optional — semantic fn/kb retrieval)
# =============================================================================
# PRESENCE toggle in code: if SEON_EMBED reaches the process set to ANY value
# (even empty), the embedding-retrieval feature is ON for both pod and
# database server. The bin/seon + bin/acme supervisors normalize the operator
# convention for you: empty or "0" is translated to UNSET (feature OFF, the
# default), anything else is exported (ON). Without Vertex/Gemini creds an
# enabled gate is a graceful no-op (embedding writes are lazy/no-op).
# SEON_EMBED=1
# Google Gemini key for embedding generation (KNN). Without it, embedding
# writes are lazy/no-op. Required only when SEON_EMBED is on and you want KNN.
# GEMINI_API_KEY=...

# Serper (google.serper.dev) API key — real Google SERP results for the
# seon.agent.web/search verb (backend :serper in config/system.edn's
# :seon.config/web). 2,500 free searches/mo, then ~$0.30-1/1k. Read live
# from env; SEON_WEB must also be granted for web verbs to run.
# SERPER_API_KEY=...

# =============================================================================
# BRANDING / CUSTOMIZATION  (config-style; live-editable, env seeds the default)
# =============================================================================
# Product name shown in the web UI. Default: "seon".
# SEON_BRAND_NAME=Acme
# Mission-control subtitle line. Default: the shipped seon tagline.
# SEON_BRAND_TAGLINE=Acme — your product on a shared core
# UI theme (data-theme attribute). Default: "phosphor".
# SEON_BRAND_THEME=phosphor
# Path to a CSS file inlined into the UI (token/color overrides). No default.
# SEON_BRAND_CSS=/abs/path/to/brand.css

# =============================================================================
# CODE OVERLAY  (compile your own namespaces into the pod / override seon fns)
# =============================================================================
# Path to YOUR deps.edn project; its src/ is injected onto the pod build
# classpath so your namespaces compile INTO the pod bundle. Unset = none.
# SEON_EXTRA_SRC=/abs/path/to/your-overlay
# Your ENTRY namespace, loaded at pod preload — it registers your namespaces
# and fires override side effects (e.g. set! of a seon var). Unset = none.
# SEON_EXTRA_PRELOAD=acme.pod
# Downstream node_modules dir (added to NODE_PATH for the pod). Unset = none.
# SEON_EXTRA_NPM=/abs/path/to/node_modules
# When the pod runs from a downstream project root, point this at the seon
# checkout that owns the COMPILED ARTIFACTS (bootstrap output, src roots, web
# assets). Unset = artifacts resolve CWD-relative (seon's own usage).
# SEON_RUNTIME_ROOT=/abs/path/to/seon-checkout

# =============================================================================
# IDENTITY
# =============================================================================
# Path to the agent's primary identity file (read before AGENTS.md, etc.).
# Default: SOUL.md in the working dir.
# SEON_SOUL_FILE=/abs/path/to/SOUL.md

# =============================================================================
# AGENT FILESYSTEM GRANTS  (what the agent may read/write on the host)
# =============================================================================
# Allowed filesystem root(s) for agent file ops. Supports MULTIPLE roots split
# on the path-list delimiter (":" POSIX, ";" Windows), like $PATH. Unset = no
# host filesystem access granted. (bin/seon's pod sets this to the repo root.)
# SEON_FS_ROOT=/abs/path/one:/abs/path/two
# "1" makes the granted roots READ-ONLY (write-file refuses). Default: writable.
# SEON_FS_READ_ONLY=1
# "1" LOCKS the env-granted roots immutable — the agent cannot widen the grant
# at runtime via configure!. Default: unlocked.
# SEON_FS_LOCK=1

# =============================================================================
# AGENT SHELL / WEB GRANTS  (host-owned capability gates, read live per call)
# =============================================================================
# CODE default for both gates: DENY when unset — nothing inside the pod can
# grant them. The bin/seon and bin/acme dev supervisors grant BOTH by default
# (export ...:-1); set "0" here or in your shell to deny per-cluster. A
# downstream deployment that does not use bin/seon gets the code's default-deny
# until its launcher sets these. Table: docs/seon/components/capability-gates.md
# Shell access (seon.agent.shell/run + py-run). Any value but "0" grants.
# Commands still run only in an fs-allowlisted cwd (SEON_FS_ROOT).
# SEON_SHELL=1
# Web fetch (seon.agent.web/fetch). Any value but "0" grants. The SSRF guard
# (private/loopback/link-local block) is ALWAYS on and not configurable.
# SEON_WEB=1
# Comma-separated domain allowlist for web fetch. Unset/empty = all domains
# allowed when SEON_WEB is granted. Subdomains of a listed domain match.
# SEON_WEB_DOMAINS=example.com,clojure.org
# "1" LOCKS the web domain allowlist — runtime (seon.agent.web/configure! ...)
# becomes a legible no-op error. Default: unlocked.
# SEON_WEB_LOCK=1

# =============================================================================
# CANVAS / DEBUG
# =============================================================================
# Canvas SCI bounding is ON unless this is "0" (agent canvas fns then use the
# compiled path). Default: on.
# SEON_CANVAS_SCI=0

# =============================================================================
# RENDER / OUTPUT CAPS  (read-time, LLM-facing display truncation — token economy)
# =============================================================================
# All caps below are read through seon.config (the ONE typed env surface) and
# bound how much of an eval/render lands in the agent's context. The byte
# values are char budgets; the token figure (≈ chars/4) is what actually
# matters for the context window.
# Citable `;;=> <value>` result body. Default: 16384 chars (≈4k tokens).
# SEON_RENDER_RESULT_CAP=16384
# Echoed source + captured stdout of one eval row. Default: 1500 (≈375 tokens).
# SEON_RENDER_EVAL_CAP=1500
# Per inbound transcript message line. Default: 4000 chars (≈1k tokens).
# SEON_RENDER_MESSAGE_CAP=4000
# Store-time pr-str cap for an EDN value persisted as a datom (anti-OOM
# display ceiling). Default: 16384 chars (≈4k tokens).
# SEON_RENDER_DATABASE_EDN_CAP=16384
# Transcript-section eviction budget, in TOKENS (currently OFF — clip :none).
# Default: 6000 tokens.
# SEON_RENDER_TRANSCRIPT_TOKEN_CAP=6000
# Count of live `result/<id>` vars kept per session (a COUNT, not a width).
# Default: 200.
# SEON_EVAL_RESULT_VARS_CAP=200
# --- Value-renderer skeleton bounds (internal; rarely set) ---
# Max nesting depth of the eval-value skeleton. Default: 3.
# SEON_RENDER_VALUE_MAX_DEPTH=3
# Max map keys shown per node. Default: 8.
# SEON_RENDER_VALUE_MAX_KEYS=8
# Max collection items shown per node. Default: 8.
# SEON_RENDER_VALUE_MAX_ITEMS=8
# Max chars of a string leaf before a length marker. Default: 80 (≈20 tokens).
# SEON_RENDER_VALUE_MAX_STRING=80
# Homogeneous-map elements probed for a shared key-set shape. Default: 8.
# SEON_RENDER_VALUE_SHAPE_SAMPLE=8
# Char budget under which a value prints WHOLE (REPL-style). Default: 1500.
# SEON_RENDER_VALUE_VERBATIM_CAP=1500
# Inline-vs-break width budget for the skeleton emitter. Default: 72.
# SEON_RENDER_VALUE_WIDTH=72

# =============================================================================
# AGENT LOOP / RUNTIME BOUNDS
# =============================================================================
# Default per-run turn limit (the usual work-bound stopper). Unset = the
# per-agent default / shipped default applies.
# SEON_DEFAULT_TURN_LIMIT=20
# Watchdog ticker cadence in ms (close overdue runs, fire due schedules).
# Default: 30000.
# SEON_TICK_MS=30000
# Per-test / -fixture wall-clock bound in ms (a hard ceiling on a hang).
# Default: 15000.
# SEON_TEST_TIMEOUT_MS=15000
# Runtime Malli instrumentation is ON by default; set to 0/false/off/no to
# disable every input/output validator wrapper (escape hatch only).
# SEON_INSTRUMENT=0

# =============================================================================
# DEPLOYMENT LAYOUT / PORTS  (override to run multiple clusters side-by-side)
# =============================================================================
# Pod web UI port. Default: 7890. Set to 0 for an ephemeral port.
# SEON_PORT=7890
# Pod HTTP bind address. Default: loopback only.
# SEON_BIND=127.0.0.1
# Datastar response compression. Default: identity for low-latency local
# debugging. Set gzip for remote deployments; clients still negotiate through
# Accept-Encoding and identity remains available.
# SEON_FEED_COMPRESSION=gzip
# Database-server io-prepl port. Default: 0 (publish an available loopback port).
# SEON_WRITER_REPL_PORT=0
# Durable cluster data directory. The database is its `db/` child.
# Default: data/clusters/default.
# SEON_CLUSTER_DIR=data/clusters/acme
# Unix socket the Bun processes use for persistent database sessions.
# Default: tmp/seon-cluster-default-req.sock.
# SEON_REQ_SOCK=tmp/acme-cluster-req.sock
# Log dir (bin/seon tail reads here). Default: logs.
# SEON_LOG_DIR=logs/acme
# Supervisor pid/lock namespace dir. Default: tmp/proc.
# SEON_PROC_DIR=tmp/proc-acme
# Process directory that owns the one JVM writer. Defaults to SEON_PROC_DIR;
# downstream Bun runtimes point this at the default operator.
# SEON_WRITER_PROC_DIR=tmp/seon-operator
# Pod bundle the supervisor runs. Default: out/client/main.js.
# SEON_CLIENT_OUT=out-acme/client/main.js

# =============================================================================
# ADVANCED / INTERNAL  (rarely set by a consumer; here for completeness)
# =============================================================================
# Skip the pod's auto-boot of the V0 agent + HTTP server (set to any value).
# SEON_NO_AUTO_BOOT=1
# File the pod writes its actually-bound port to. Default: tmp/seon-port.
# SEON_PORT_FILE=tmp/seon-port
# Pin the agent / session id (otherwise generated). Internal.
# SEON_AGENT_ID=
# SEON_SESSION_ID=
# Error-tracking internal flags (set by the runtime, not by operators).
# SEON_ERRORS=
# SEON_ERROR_TRACKING_INSTALLED=
# Seon checkout root (set by bin/seon; rarely overridden by hand).
# SEON_ROOT=
