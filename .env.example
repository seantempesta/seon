# Seon reads secrets from the process environment. Runtime settings live in
# config/default.edn and optional sparse overlays reconciled into database
# facts; credentials themselves never become datoms.

# Shipped DeepSeek credential.
# DEEPSEEK_API_KEY=sk-...

# Optional provider credentials selected by a config overlay.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# RUNPOD_API_KEY=...
# GEMINI_API_KEY=...

# Web search for my.web/search (owner-ruled 2026-08-03: Serper, a config
# fact behind one schema). Create the key at https://serper.dev — the free
# tier is 2,500 queries. The implementing lane re-verifies pricing/terms
# before first paid use.
# SERPER_API_KEY=...
