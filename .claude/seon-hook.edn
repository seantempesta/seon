;; Direct development-hook configuration.
;;
;; bin/seon-hook runs entirely in Babashka. It does not require a running
;; Seon process: syntax validation happens before an edit; the canonical
;; Markdown and docstring linters run after it; review and the live-pod
;; core-fault gate are advisory/targeted as described below.

{:lint
 {:enabled true}

 :markdown-lint
 {:enabled true}

 :docstring-lint
 {:enabled true}

 ;; Optional direct Gemini review. Reviewable edits accumulate while the
 ;; interval gate is closed, then one bounded call reviews the pending batch.
 ;; A failed review never blocks an edit and remains pending for a later retry.
 :review
 {:enabled true
  :interval-seconds 60
  :max-code-length 12000}

 :feedback
 {:max-length 1000}}
