;; Unified development hook configuration
;;
;; Controls the behavior of bin/seon-hook for:
;; - Syntax repair (delimiter fix, cljfmt)
;; - Unit test execution
;; - Generative testing (Malli schema validation)
;; - AI-assisted code review (Gemini with bounded window model)
;;
;; All state (functions, errors, edit history) is stored in XTDB.

{;; Syntax repair via seon.dev.repair
 ;; Key is :repair (not :syntax-repair) to match what hook.clj expects
 :repair {:enabled true
          :cljfmt true
          :revert-on-fail true}

 ;; Test execution
 ;; NOTE: generative block-on-fail temporarily disabled due to pre-existing issue where
 ;; ::xtdb-node schema generates nil, causing all context.clj functions to fail.
 ;; TODO: Fix by adding proper generator for ::xtdb-node or skipping DB-dependent fns
 :tests {:unit {:enabled true
                :block-on-fail true}
         :generative {:enabled true
                      :num-tests 10
                      :block-on-fail false}}

 ;; Gemini AI review with bounded window model
 ;; - Edits are recorded as immutable facts (never deleted)
 ;; - A singleton tracks when last review completed
 ;; - Query only looks at recent edits (bounded by lookback-minutes)
 ;; - Safety: Even if reviews stop, we only process bounded window
 :gemini {:enabled true
          :on-new-function true
          :on-gen-fail true
          ;; Wait for user to stop typing before reviewing
          :debounce-seconds 5
          ;; Minimum time between reviews (prevents review spam)
          :cooldown-seconds 10
          ;; Max edit history to consider (bounds accumulation)
          :lookback-minutes 5}

 ;; Convention compliance checking
 ;; - Runs after reload, before tests
 ;; - Currently non-blocking (feedback only)
 :compliance {:enabled true
              :block false}

 ;; Feedback formatting
 :feedback {:dense true
            :max-length 1000}}
