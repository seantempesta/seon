;; Direct development-hook configuration.
;;
;; bin/seon-hook runs in Babashka. Syntax validation (clj-kondo over the
;; reconstructed buffer) happens before an edit; clj-kondo, the canonical
;; Markdown and docstring linters run after it. The one live-JVM call is
;; the contract compile check (`:contract-compile`, on unless declared
;; off): a src/ or test/ Clojure edit asks the running root at
;; `:current-source` to compile its contracts, and reports it unavailable
;; when no root answers. The hook never publishes: every JVM runs a
;; committed archive, so program changes reach default only as commits, by
;; `bin/seon start --head` (owner 2026-09-26). The only automatic fix is
;; Markdown formatting (whitespace, blank lines, final newline), which the
;; hook rewrites in place and reports; Clojure is refused, never repaired.
;; `:feedback :max-tokens` (per message) still carries a literal fallback
;; in bin/seon-hook.
;; SEON_HOOK_CONFIG selects a complete fixture config.

{:lint
 {:enabled true}

 :markdown-lint
 {:enabled true}

 :docstring-lint
 {:enabled true}

 ;; Writes no tool payload names. A shell tool — `apply_patch` from a
 ;; heredoc, `python`, `sed`, `cat >` — hands the hook no path, so the
 ;; changed files are derived: every root below is walked after the tool
 ;; returns and each Clojure file's content digest is compared with the
 ;; digest this session's agent recorded before the tool ran. A syntax
 ;; error left on disk blocks immediately, naming the path and the tool.
 ;; Measured 2026-09-25: the walk plus digests is 60 ms over 693 files,
 ;; where scoping by `git status --porcelain` cost 2.7 s warm (2026-09-17).
 :shell-writes
 {:enabled true
  :roots ["src" "test" "resources" "script" "bin"]}

 ;; These two keys select the live root and cluster that schema/contract
 ;; lint queries; the hook publishes nothing into it.
 :current-source
 {:root "."
  :cluster "default"}

 ;; 2026-09-20 (owner): schema admission spawned a full clojure -M:dev JVM per
 ;; schema resource edit; OFF until it runs through the live JVM or Babashka.
 :schema-admission
 {:enabled false}

 ;; The edit hook is the lane's REPL entrance: after a clean lint of a src/ or
 ;; test/ Clojure file, the changed top-level definitions are evaluated on the
 ;; lane's branch in the live root (`SEON_LANE`, else the lane claiming the
 ;; file) and the reaching tests run. `:timeout-ms` bounds each root call; no
 ;; root, no lane or a root not ready is "lint only".
 :repl-entrance
 {:enabled true
  :timeout-ms 60000}

 :feedback
 {:max-tokens 300}}
