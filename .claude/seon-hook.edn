;; Unified development hook configuration
;;
;; Controls the behavior of bin/seon-hook for:
;; - Syntax repair (delimiter fix, cljfmt)
;; - Unit test execution
;; - Generative testing (Malli schema validation)
;; - AI-assisted code review (Gemini with debouncing)
;;
;; All state (functions, errors, edit history) is stored in XTDB.

{;; Syntax repair via clj-paren-repair-claude-hook
 :syntax-repair {:enabled true
                 :cljfmt true
                 :stats true
                 :revert-on-fail true}

 ;; Unit test execution
 :unit-tests {:enabled true
              :block-on-fail true}

 ;; Generative testing with Malli
 :generative-tests {:enabled true
                    :num-tests 10
                    :block-on-fail true}

 ;; Gemini AI review with debouncing
 ;; - Edits are tracked in XTDB as pending
 ;; - After debounce-seconds of inactivity, triggers batch review
 ;; - Uses structured output for consistent verdict/confidence
 ;; - Blocks only on :verdict :block with :confidence :high
 :gemini {:enabled true
          :on-new-function true
          :on-gen-fail true
          :debounce-seconds 5}}  ;; Temporarily reduced for testing
