;; Direct development-hook configuration.
;;
;; bin/seon-hook runs entirely in Babashka. It does not require a running
;; Seon process: syntax validation happens before an edit; the canonical
;; Markdown and docstring linters run after it; current source publication
;; uses the live operator JVM when one exists. After convergence the same JVM
;; checks tests reaching the recorded adoption; widened edits only name a gate.
;; Gemini review is one asynchronous, coalesced batch per two-minute window;
;; it never delays edit feedback or creates parallel review workers.
;; Every numeric bound this hook enforces is declared here and nowhere else:
;; the publication timeout, the review size limits, and the review call's own
;; bound. The hook has no numeric fallback — an absent or non-positive value
;; refuses by exact key path rather than substituting a literal.
;; SEON_HOOK_CONFIG selects a complete fixture config.

{:lint
 {:enabled true}

 :markdown-lint
 {:enabled true}

 :docstring-lint
 {:enabled true}

 ;; Writes no tool payload names. A shell tool — `apply_patch` from a
 ;; heredoc, `python`, `sed`, `cat >` — hands the hook no path, so the
 ;; changed files are derived: every root below is walked after the tool
 ;; returns and each Clojure file's content digest is compared with the
 ;; digest recorded at this session's previous event. A syntax error left
 ;; on disk blocks immediately, naming the path and the tool. Measured
 ;; 2026-09-17: the complete walk plus digests is 112 ms over 553 files,
 ;; where scoping by `git status --porcelain` would cost 2.7 s warm.
 :shell-writes
 {:enabled true
  :roots ["src" "test" "resources" "script" "bin"]}

 ;; THE DEFAULT CLUSTER IS THE DEVELOPMENT ENVIRONMENT (owner, 2026-09-08):
 ;; the main operator root, cluster `default`. Every admitted edit publishes
 ;; to current-src and `default` adopts it in place. No side root, no
 ;; special name; fixtures (Juniper) are data seeded into it.
 ;; 2026-09-20 (orchestrator): publication DISABLED for the wave-1 error cut.
 ;; Three lanes edit src concurrently; every edit queued a complete
 ;; publication + adoption of default (60–150 s under the lifecycle lock),
 ;; and every one of the last dozen was refused (lock-hold-timeout /
 ;; prepl-response-silent), burning the default JVM for nothing. Re-enable
 ;; at the wave-1 reset, when adoption is fast and the tree is quiet.
 :current-source
 {:enabled false
  :root "."
  :cluster "default"
  :check-tests true
  :timeout-seconds 180}

 ;; The standing review rubric is DATA: `:skills` names skill directories
 ;; under `.agents/skills/`, each of whose `SKILL.md` is read fresh on every
 ;; review (edit a skill and the next review sees it — nothing is baked in),
 ;; review. The selection is the subset with real catch-power for a reviewer
 ;; of the current JVM/Clojure tree; the pod-era
 ;; skills (clojurescript, datastar-web-ui, ui-canvas, seon-context-config)
 ;; and the agent-REPL skill are deliberately absent.
 :review
 {:enabled true
  :interval-seconds 120
  :skills ["data-oriented-clojure" "data-modeling" "datahike" "clojure-testing"]
  ;; Per-document caps. Clojure sources under `:max-code-length` arrive
  ;; WHOLE, which is what stops a reviewer reading a cut as a syntax error;
  ;; anything longer is cut with an in-band truncation marker.
  :max-code-length 40000
  :max-batch-length 200000
  :max-rubric-length 60000
  ;; The provider call's own declared bound. One review window waits at most
  ;; this long; a fired bound drops the snapshot and is logged, never retried.
  :call-timeout-seconds 60}

 :feedback
 {:max-tokens 300}}
