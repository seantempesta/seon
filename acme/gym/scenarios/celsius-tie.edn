;; ACME-OWNED diffusion-gym scenario — the kill-gate, "guided ties" case.
;;
;; The OTHER direction of the decision rule: here the clamped frame buys nothing
;; (the model fills vacuous specs even when guided), so arm1 ~= arm3 and the
;; verdict fires KILL. Proves the rule genuinely DISCRIMINATES — it is not rigged
;; to always EARNS. Same predicate set as celsius-killgate; only the arm pools
;; differ.
{:acme.gym.scenario/id   :celsius-tie
 :acme.gym.scenario/doc  "Guided buys nothing — arm1 ~= arm3 -> KILL."

 :acme.gym.scenario/predicates
 [{:acme.gym.predicate/id :parses      :acme.gym.predicate/kind :oracle-parse :acme.gym.predicate/expect :clean}
  {:acme.gym.predicate/id :registers   :acme.gym.predicate/kind :contains     :acme.gym.predicate/needle "schema/register!"}
  {:acme.gym.predicate/id :has-malli   :acme.gym.predicate/kind :contains     :acme.gym.predicate/needle ":malli/schema"}
  {:acme.gym.predicate/id :no-clj-spec :acme.gym.predicate/kind :absent       :acme.gym.predicate/needle "s/def"}
  {:acme.gym.predicate/id :not-vacuous :acme.gym.predicate/kind :not-vacuous}]

 :acme.gym.scenario/faithful-when [:parses :registers :has-malli :no-clj-spec :not-vacuous]

