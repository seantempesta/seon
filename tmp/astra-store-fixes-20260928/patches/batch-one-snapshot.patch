+++ b/test/seon/batch_snapshot_test.clj
@@ -0,0 +1,41 @@
+(ns seon.batch-snapshot-test
+  (:require [clojure.test :refer [deftest is]]
+            [seon.batch :as batch]
+            [seon.db :as db]
+            [seon.sci.eval :as eval]
+            [seon.sci.observe :as observe]
+            [seon.test-support :as support]
+            [seon.turn :as turn]
+            [seon.turn.batch :as turn.batch]
+            [seon.turn.world :as world]))
+
+(deftest one-evidence-snapshot-at-one-ten-and-one-hundred-executed-definitions
+  (support/with-database
+   (fn [connection]
+     (support/seed-cluster! connection "default")
+     (let [w (world/agent-world {:seon.db/connection connection :seon.cluster/name "default"
+                                  :seon.sci.eval/base-ctx (eval/base-ctx (db/db connection))}
+                                {:seon.agent/id "snapshot-probe"})
+           request (dissoc (turn.batch/code-request
+                             {:seon.batch/world w :seon.batch/observe observe/observe
+                              :seon.turn.batch/row-tx @#'turn/row-tx
+                              :seon.batch/start-ns 'snapshot.probe
+                              :seon.batch/text "(defn chosen {:malli/schema [:=> [:cat] :int]} [] 1)"})
+                           :seon.batch/settle)
+           result (batch/evaluate-batch request)
+           observed (:seon.batch/sink w)]
+       (is (empty? (:seon.batch/diagnostics result)))
+       (doseq [n [1 10 100]]
+         (let [s (batch/sink) counted (batch/sink)
+               _ (.putAll ^java.util.concurrent.ConcurrentHashMap s (into {} (take n observed)))
+               b (assoc result :seon.batch/form-world
+                         {:seon.batch/form-sink s :seon.batch/reads (atom [])
+                          :seon.batch/in-flight (java.util.concurrent.atomic.AtomicLong. 0)})
+               frozen (binding [batch/*world* {:seon.batch/sink counted}]
+                        (#'batch/freeze-step (assoc-in request [:seon.batch/world :seon.batch/sink] (batch/sink)) b))
+               entry (peek (:seon.batch/entries frozen))]
+           (is (= n (.size ^java.util.concurrent.ConcurrentHashMap s)))
+           (is (= 1 (get (batch/calls counted) 'seon.batch/counters))
+               "the evidence and call profile share one snapshot")
+           (is (= (reduce + (vals (:seon.batch/executed entry)))
+                  (get-in entry [:seon.batch/call-profile :seon.batch/call-count])))))))))
