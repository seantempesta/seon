+(defn reply-face
+  "The small data a reply's `:error` carries for one error value: what an
+  agent acts on, as data (owner 2026-09-27: return data, not comments; render
+  functions still select). The failure's own message (its first cause link's,
+  not the clojure.main wrapper that repeats class and location), its class,
+  the agent's own frames, and for a refusal the member, expected shape and
+  fix. The whole error stays retrievable through the evaluation's result
+  handle."
+  {:malli/schema [:=> [:cat :map] :map]}
+  [error]
+  (let [cause (first (:seon.error/chain error))]
+    (cond-> (select-keys error [:seon.error/exception-class :seon.sci.eval/stacktrace
+                                :seon.error/member :seon.error/expected :seon.error/fix])
+      (or (:seon.error/message cause) (:seon.error/message error))
+      (assoc :seon.error/message (or (:seon.error/message cause) (:seon.error/message error))))))
+
 (defn render-ai
   "Render the flat error value, preserving its recorded diagnostic data."
   {:malli/schema [:=> [:cat :seon.render/unit] [:string {:min 1}]]}
