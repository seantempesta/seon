+                            ::inherits [:and ::base [:map [::x ::x]]]
+                            ::arm [:and ::base [:map {:seon.render/ai 'probe.render/arm-ai} [::x ::x]]]
+                            ::alias ::arm
+                            ::plain [:map [::x ::x]]}))
+        faces #(select-keys (schema.datahike/storable-properties-in projection %)
+                            [:seon.render/ai :seon.render/html :seon.render/form])]
+    (is (= {:seon.render/ai (ai 'probe.render/base-ai) :seon.render/html (ai 'probe.render/base-html)}
+           (faces ::inherits)))
+    (is (= {:seon.render/ai (ai 'probe.render/arm-ai) :seon.render/html (ai 'probe.render/base-html)}
+           (faces ::arm) (faces ::alias))
+        "the later :and arm wins per face; an alias reads its target")
+    (is (= {} (faces ::plain)))))
