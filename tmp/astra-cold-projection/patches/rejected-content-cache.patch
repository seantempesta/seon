+(defn- storage-content
+  "The storage fold's immutable input, with scoped references resolved.
+
+   Malli retains this key on its compiled schema. Equal schemas in different
+   registries share it by value; neither the key nor the central cache holds
+   a compiled schema or its registry. A changed reference target changes the
+   key even when the attribute's authored form stays the same."
+  {:malli/schema [:=> [:cat [:fn malli.core/schema?]] [:tuple [:vector :seon.schema/value] [:int {:min 1}]]]}
+  [compiled]
+  (m/-cached
+   compiled ::storage-content
+   (fn [root]
+     (letfn [(content [node active]
+               (m/walk
+                node
+                (fn [node _ children _]
+                  (let [reference (when (m/-ref-schema? node) (m/-ref node))
+                        scope [(:registry (m/options node)) reference]]
+                    [(m/type node) (m/properties node) reference
+                     (if reference
+                       (when-not (or (= :seon.db/ref reference) (contains? active scope))
+                         (content (m/deref node) (conj active scope)))
+                       children)]))))]
+       (let [content-key (content root #{})]
+         ;; Charge the retained key and result using the content's size once,
+         ;; never walk either on a hit. Cache entry overhead is charged centrally.
+         [content-key (+ 512 (* 4 (count (id/printed content-key))))])))))
+
 (defn- compiled-storage
-  "Fold compiled value nodes; reference identity precedes logical dereference."
+  "Fold compiled value nodes once per storage content in the bounded cache.
+   Reference identity precedes logical dereference. Hits cost one retained
+   Malli key read and one central lookup, independent of projection size."
   {:malli/schema [:=> [:cat [:fn malli.core/schema?]] :map]}
   [compiled]
   (letfn [(fold [compiled active]
@@ -150,7 +180,9 @@
              (= 'inst? t) {::value-type :db.type/instant}
              :else {::value-type (malli-type->datahike-type t)})]
        (merge {::cardinality :db.cardinality/one ::properties properties} result))))) ]
-    (fold compiled #{})))
+    (let [[content estimated-bytes] (storage-content compiled)]
+      (seon.cache/lookup ::compiled-storage content (constantly estimated-bytes)
+                         #(fold compiled #{})))))
 
