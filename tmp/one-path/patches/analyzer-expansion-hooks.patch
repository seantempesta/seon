+(defn expansion-hooks
+  "clj-kondo `:analyze-call` hooks carrying the macro expansions an
+  evaluation observed (the SCI fork's expansion observer): for each expanded
+  macro, a hook answering the recorded expansion for the call node at exactly
+  an observed occurrence and leaving every other call as written. An
+  occurrence's call span is authored (line 1 is the form's first line); the
+  form sits at `first-row` of the analyzed text. Nil when none was observed."
+  {:malli/schema [:=> [:cat [:sequential [:map [:seon.batch/macro :qualified-symbol]
+                                          [:seon.batch/call-span [:tuple pos-int? pos-int? pos-int? pos-int?]]
+                                          [:seon.batch/expansion :seon.batch/form]]]
+                       pos-int?]
+                  [:maybe :map]]}
+  [expansions first-row]
+  (let [by-macro (group-by :seon.batch/macro expansions)]
+    (when (seq by-macro)
+      {:__dangerously-allow-string-hooks__ true
+       :analyze-call
+       (into {} (for [[macro events] by-macro
+                      :let [at (into {} (for [{[l c] :seon.batch/call-span e :seon.batch/expansion} events]
+                                          [[(+ l (dec first-row)) c] e]))]]
+                  [macro (str "(require '[clj-kondo.hooks-api :as api])\n"
+                              "(let [at '" (pr-str at) "]\n"
+                              "  (fn [{:keys [node]}] (let [{:keys [row col]} (meta node)]"
+                              " (when-some [e (get at [row col])] {:node (api/coerce e)}))))")]))})))
+
 (defn- present-values
   [entry selected-keys]
