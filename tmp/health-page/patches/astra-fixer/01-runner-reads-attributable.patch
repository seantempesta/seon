+(defn- report-selector
+  "Every member `:seon.test.report/report` declares, from the database's
+  projection: never `*`, whose read depends on every attribute, so a reader
+  retaining failed tests by the attributes they read (`seon.health/derived`)
+  re-derived them on every commit. Equal to `*` on default's 400 reports
+  (2026-09-28)."
+  {:malli/schema [:=> [:cat :seon.db/database-value] :seon.db/pull-selector]}
+  [database]
+  (let [projection (db/carried-projection database)]
+    (schema/projection-cache-value
+     projection ::report-selector
+     #(into [:db/id] (map first)
+            (m/entries (m/deref-all (m/schema :seon.test.report/report
+                                              {:registry (:seon.schema.projection/registry projection)})))))))
+
