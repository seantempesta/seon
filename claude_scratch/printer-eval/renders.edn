l,\n :form \"(println (slurp \\\"runs/root.log\\\"))\",\n :out\n   \":program {:ok true, :datoms 73}\n:program {:ok true, :datoms 175}\n:create {:ok true, :datoms 12}\n:cancel-neg {:ok true}\n:quiescent {:t 536870989, :stuck [{:task calc/neg, :cause cancelled, :blocks [calc/abs calc/abs-merge calc/neg-merge]}]}\n:task calc/abs {:execution :running, :done false, :blocked-by #{calc/neg-merge}, :attempts []}\n:task calc/abs-merge {:execution :running, :done false, :blocked-by #{calc/abs}, :attempts []}\n:task calc/add {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/add#1 :done :green 1 2432]]}\n:task calc/add-merge {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/add-merge#1 :merged :green 0 0]]}\n:task calc/neg {:execution :cancelled, :done false, :blocked-by #{}, :attempts [[calc/neg#1 :killed nil nil nil]]}\n:task calc/neg-merge {:execution :running, :done false, :blocked-by #{calc/neg}, :attempts []}\n:task calc/square {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/square#1 :done :green 2 5151]]}\n:task calc/square-merge {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/square-merge#1 :merged :green 0 0]]}\n:task calc/sum-sq {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/sum-sq#1 :done :green 1 2691]]}\n:task calc/sum-sq-merge {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/sum-sq-merge#1 :merged :green 0 0]]}\n:task calc/twice {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/twice#1 :done :green 1 2504]]}\n:task calc/twice-merge {:execution :running, :done true, :blocked-by #{}, :attempts [[calc/twice-merge#1 :merged :green 0 0]]}\n:agents-reused [] :merges {:merge-attempts {:merged 4}, :behind-reattempts 0, :conflicts-measured 0, :attached-tasks 0, :model-calls-in-merges 0} :fresh-agent [25 0]\n:checks {:done-all? true, :abs-blocked-by #{calc/neg-merge}, :square-turns 2, :square-read-its-failure? true, :square-splits [{:context