{; ONE PROVIDER, ONE ATTEMPT, ONE DEADLINE. The seam to B2 is exactly
 ; three facts — endpoint, model, and the NAME of the environment
 ; variable holding the credential. The credential itself is read at
 ; the leaf and never becomes a datom.
 :seon.ai/api-key-variable [:string {:min 1}]
 :seon.ai/endpoint [:string {:min 1}]
 :seon.ai/model [:string {:min 1}]
 :seon.ai/prompt [:string {:min 1}]
 :seon.ai/system [:string {:min 1}]
 ; The one legitimate deadline in the rung: a remote HTTP call is
 ; genuinely unobservable external state. Its firing is an ordinary
 ; error value, never a bug report.
 :seon.ai/timeout-ms [:int {:min 1}]
 :seon.ai/text [:string {:min 1}]
 :seon.ai/request [:map {:closed true} [:seon.ai/endpoint :seon.ai/endpoint] [:seon.ai/model :seon.ai/model] [:seon.ai/api-key-variable :seon.ai/api-key-variable] [:seon.ai/system {:optional true} :seon.ai/system] [:seon.ai/prompt :seon.ai/prompt] [:seon.ai/timeout-ms :seon.ai/timeout-ms]]
 :seon.ai/completion [:or [:map {:closed true} [:seon.ai/text :seon.ai/text]] :seon.error/value]

 ; ---------------------------------------------------------------------
 ; THE DESCRIPTOR ROW. A target is one callable model: the four wire
 ; facts and nothing else. A `:seon.ai/request` IS a target plus what to
 ; say, which is why `complete` takes `(assoc target :seon.ai/prompt …)`
 ; and no adapter sits between them.
 ; The two ROLES are registered in their own right so every key in
 ; `:seon.ai/targets` resolves through the registry like every other
 ; key here. Neither carries a persistence facet, so neither becomes a
 ; database attribute — the roles are a shape, not a row.
 :seon.ai/primary :seon.ai/target
 :seon.ai/backup :seon.ai/target
 :seon.ai/target [:map {:closed true} [:seon.ai/endpoint :seon.ai/endpoint] [:seon.ai/model :seon.ai/model] [:seon.ai/api-key-variable :seon.ai/api-key-variable] [:seon.ai/timeout-ms :seon.ai/timeout-ms]]
 ; TWO ROLES, and the backup is ABSENT rather than nil when there is
 ; none — absence is the state, and `:seon.ai/backup?` downstream is
 ; literally `(contains? targets :seon.ai/backup)`.
 :seon.ai/targets [:map {:closed true} [:seon.ai/primary :seon.ai/target] [:seon.ai/backup {:optional true} :seon.ai/target]]

 ; ---------------------------------------------------------------------
 ; THE BACKOFF STRATEGY, as data. Composed the way `again` composes it
 ; (multiplicative → randomize → clamp → max-retries → max-duration),
 ; but DERIVED rather than executed: `seon.ai/delays` turns these six
 ; facts plus injected randomness into a finite vector of waits, so the
 ; whole schedule is one value a seeded property can pin.
 :seon.ai.retry/base-delay-ms [:int {:min 1}]
 :seon.ai.retry/multiplier [:double {:min 1.0}]
 :seon.ai.retry/jitter-fraction [:double {:min 0.0 :max 1.0}]
 :seon.ai.retry/maximum-delay-ms [:int {:min 1}]
 ; zero retries is a legitimate configuration: it turns `:backoff` into
 ; `:fail` by data rather than by a code branch.
 :seon.ai.retry/maximum-retries [:int {:min 0}]
 :seon.ai.retry/maximum-total-delay-ms [:int {:min 0}]
 :seon.ai.retry/strategy [:map {:closed true} [:seon.ai.retry/base-delay-ms :seon.ai.retry/base-delay-ms] [:seon.ai.retry/multiplier :seon.ai.retry/multiplier] [:seon.ai.retry/jitter-fraction :seon.ai.retry/jitter-fraction] [:seon.ai.retry/maximum-delay-ms :seon.ai.retry/maximum-delay-ms] [:seon.ai.retry/maximum-retries :seon.ai.retry/maximum-retries] [:seon.ai.retry/maximum-total-delay-ms :seon.ai.retry/maximum-total-delay-ms]]
 :seon.ai.retry/delays [:vector [:int {:min 0}]]

 ; ---------------------------------------------------------------------
 ; THE EVIDENCE A FAILOVER DECISION NEEDS, and the reason it lives here:
 ; only the leaf knows what actually happened on the wire. The five flat
 ; kinds are unchanged and stay the agent-facing shape; these are
 ; namespaced fields inside `:seon.error/data`, never a nested envelope.
 ;
 ; `error-class` is NORMALIZED — derived from the JDK's own exception
 ; taxonomy and the HTTP status, which is the dependency's vocabulary
 ; rather than a list we invented. The three phase booleans are what
 ; make "did this cost anything?" answerable instead of guessed, and
 ; that question is the whole no-retry ruling.
 :seon.ai/error-class [:enum :credential :transport-before-send :transport-unknown :timeout :rate-limit :server :authentication :authorization :model :request :response]
 :seon.ai/http-status [:int {:min 100 :max 599}]
 ; TRANSMITTED means the request left this machine, so the provider may
 ; have done paid work. UNKNOWN counts as transmitted: the ruling is
 ; strict, and "we cannot prove it was free" is not "it was free".
 :seon.ai/request-transmitted? :boolean
 :seon.ai/response-started? :boolean
 :seon.ai/output-observed? :boolean

 ; ONE DISPOSITION, computed. Three ordinary values, and the reducer
 ; that produces them is pure over the evidence above plus whether a
 ; backup exists.
 :seon.ai/disposition [:enum :failover-now :backoff :fail]
 :seon.ai/backup? :boolean
 :seon.ai/disposition-request [:map {:closed true} [:seon.error/value :seon.error/value] [:seon.ai/backup? :seon.ai/backup?]]}
