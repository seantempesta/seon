{; A CORE FAULT: a Throwable that escaped our own code. Classification
 ; is the CHANNEL, not a predicate — `seon.sci.eval/evaluate` never
 ; throws, so an agent's mistake is a VALUE and can only become a
 ; receipt; anything arriving on ::flow/error is definitionally ours.
 ; No kind list, no ambient scope, no authorship inference.
 :seon.fault/at :inst
 :seon.fault/basis-t [:int {:min 0}]
 :seon.fault/class [:string {:min 1}]
 :seon.fault/cid :keyword
 ; the whole flow error map, through admit and printed. NEVER pr-str
 ; raw: two of flow's three shapes carry ::flow/state, which for the run
 ; loop holds a live Datahike connection and executors.
 :seon.fault/data-edn :string
 :seon.fault/id [:string {:min 1 :seon.db/identity true}]
 :seon.fault/kind :keyword
 :seon.fault/message [:string {:min 1}]
 :seon.fault/op :keyword
 :seon.fault/proc :keyword
 :seon.fault/process [:string {:min 1}]
 ; a derivation of the fault's OWN content, committed with it — never a
 ; mutable tally. Recurrence is counted by query.
 :seon.fault/signature [:re {:seon.db/index true} "^[0-9a-f]{64}$"]
 :seon.fault/agent [:and {:seon.db/index true} :seon.db/ref]
 :seon.fault/run [:and {:seon.db/index true} :seon.db/ref]

 ; The entity map is not decoration: canonical-database-attributes
 ; installs entity-map entries BY CONSTRUCTION, and a family declared
 ; only as standalone leaves installs nothing but its identity —
 ; the fixture-vs-live-boot class that cost the N3 drive two rounds.
 :seon.fault/fault
 [:map {:seon.db/entity true}
  [:seon.fault/id :seon.fault/id]
  [:seon.fault/at :seon.fault/at]
  [:seon.fault/process :seon.fault/process]
  [:seon.fault/proc :seon.fault/proc]
  [:seon.fault/class :seon.fault/class]
  [:seon.fault/message :seon.fault/message]
  [:seon.fault/signature :seon.fault/signature]
  [:seon.fault/data-edn :seon.fault/data-edn]
  ; absent for the loop-level and xform error shapes
  [:seon.fault/op {:optional true} :seon.fault/op]
  [:seon.fault/cid {:optional true} :seon.fault/cid]
  ; absent when the cause chain carries no :seon.error/kind
  [:seon.fault/kind {:optional true} :seon.fault/kind]
  [:seon.fault/basis-t {:optional true} :seon.fault/basis-t]
  ; absent when no claimed-open run existed at the fault's basis
  [:seon.fault/run {:optional true} :seon.fault/run]
  [:seon.fault/agent {:optional true} :seon.fault/agent]]

 ; WHY an agent was told. A derived clause, never boilerplate — and the
 ; reason IS the escalation rule, so the two cannot drift.
 :seon.fault/reason [:enum :your-run :no-attributable-agent :recurring]
 :seon.fault/report [:map {:closed true} [:seon.fault/fault :seon.fault/fault] [:seon.fault/reason :seon.fault/reason] [:seon.cluster.agent/id {:optional true} :seon.cluster.agent/id]]
 :seon.fault/commit-request [:map {:closed true} [:seon.store/branch-connection :seon.store/branch-connection] [:seon.fault/error :any] [:seon.fault/process :seon.fault/process] [:seon.sci.admit/caps :seon.sci.admit/caps] [:seon.config/on-core-error :seon.config/on-core-error] [:seon.config.fault/escalate-to {:optional true} :seon.config.fault/escalate-to] [:seon.config.fault/recurrence-limit {:optional true} :seon.config.fault/recurrence-limit]]
 :seon.fault/committed [:map {:closed true} [:seon.fault/id :seon.fault/id] [:seon.fault/messages [:int {:min 0}]] [:seon.fault/reason {:optional true} :seon.fault/reason]]

 ; A fault-explanation message carries a ref to what it explains. A user
 ; message has none — absence is the state, and it is what makes the
 ; storm fence computable without a flag.
 :seon.cluster.message/about :seon.db/ref}
