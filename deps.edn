;; Customized libraries are :local/root into reference-code/ (submodules on our forks'
;; jolt/main branches, see docs/forks.md); everything else is a pinned :git/sha or
;; :mvn/version. Nothing is vendored.
{:paths ["src" "resources"
         ;; persistent-sorted-set's JVM core as Jolt deftypes (E4a): an overlay over the
         ;; mvn 0.4.137 jar datahike depends on, which still supplies the other namespaces
         "reference-code/persistent-sorted-set/src"]
 :deps {;; customized (reference-code/, our forks)
        io.replikativ/datahike {:local/root "reference-code/datahike"}
        org.replikativ/konserve {:local/root "reference-code/konserve"
                                 :exclusions [org.clojure/clojurescript org.clojars.mmb90/cljs-cache
                                              com.github.pkpkpk/cljs-node-io com.github.pkpkpk/fress]}
        ;; clojure.spec.alpha and hasch.platform as .jolt overlays (Datahike needs both)
        jolt/overlay {:local/root "reference-code/jolt-overlay"}
        ;; instrument wrappers of one fixed arity (L1 jolt/instrument-arity 5a830e14)
        metosin/malli {:local/root "reference-code/malli"}
        ;; arms claim host tables only (L1 jolt/seam-claims 902196e)
        jolt-lang/crypto {:local/root "reference-code/crypto"}

        ;; unmodified, pinned
        jolt-lang/ring-chez-adapter {:git/url "https://github.com/jolt-lang/ring-chez-adapter.git"
                                     :git/sha "fa0674e3627186fab1ed81c8ea069a66007edd57"}
        jolt-lang/multipart {:git/url "https://github.com/jolt-lang/multipart.git"
                             :git/sha "ca51dd47aff27dac3cc09557682e82ec63720310"}
        jolt-lang/time {:git/url "https://github.com/jolt-lang/time.git"
                        :git/sha "a28ab100111050356957eb42b7ec89a4065de754"}
        ;; our fork: a read from a fiber parks the fiber, not its carrier (jolt/fiber-aware-read)
        jolt-lang/http-client {:git/url "https://github.com/seantempesta/http-client.git"
                               :git/sha "e866277d81f89f7278f47da1e48048610ce6feed"}
        ;; konserve and datahike require it (the same pin datahike declares); core.async is
        ;; excluded because Jolt ships its own
        org.replikativ/superv.async {:git/url "https://github.com/seantempesta/superv.async"
                                     :git/sha "6f6c8231db8f2da45c600c2b0f5a3606b83a6cb6"
                                     :exclusions [org.clojure/clojurescript org.clojure/core.async]}
        ;; the model provider's JSON (N1's P5: data.json 2.5.1 runs on Jolt with jolt-lang/time)
        org.clojure/data.json {:mvn/version "2.5.1"}
        ;; reading source as data (seon.reader: analysis, references, the forgiving reader);
        ;; the version malli already brings
        borkdude/edamame {:mvn/version "1.4.32"}
        ;; editing a schema resource entry by entry, every other byte kept (seon.source's
        ;; write-back, v1's schema-file-text; owner 2026-10-21, the SCHEMAS plan)
        rewrite-clj/rewrite-clj {:mvn/version "1.2.51"}
        org.clojure/tools.reader {:mvn/version "1.5.2"}
        ;; root's system declaration (resources/seon/system.edn): #env, #profile, #include
        aero/aero {:mvn/version "1.1.6"}
        fipp/fipp {:mvn/version "0.6.29"}
        org.clojure/core.cache {:mvn/version "1.0.225"}}
 :aliases {;; Datahike's own tests, for gating a merge onto reference-code/datahike
           :dhtest {:extra-paths ["reference-code/datahike/test"]}
           ;; bin/build's smoke binary
           :hello {:extra-paths ["test/build"]}
           ;; bin/test
           :test {:extra-paths ["test"]}
           ;; E9's read-only Fressian, for opening a JVM-written store (not on the default path)
           :fressian {:extra-deps {jolt-lang/fressian {:local/root "reference-code/jolt-fressian"}}}}}
