{:paths ["src" "resources"]

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 :deps {;; Core Clojure
        org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/core.async {:mvn/version "1.9.829-alpha2"}

        ;; Schema & Validation
        metosin/malli {:mvn/version "0.20.0"}

        ;; State Management
        integrant/integrant {:mvn/version "1.0.1"}

        ;; Python Bridge
        clj-python/libpython-clj {:mvn/version "2.025"}
        cnuernber/dtype-next {:mvn/version "10.124"}

        ;; Data Processing (Parquet support)
        techascent/tech.ml.dataset {:mvn/version "7.021"}

        ;; Utilities
        aero/aero {:mvn/version "1.1.6"}           ; Config
        com.taoensso/timbre {:mvn/version "6.5.0"} ; Logging (app code)
        ch.qos.logback/logback-classic {:mvn/version "1.5.6"} ; SLF4J provider
        tick/tick {:mvn/version "0.7.5"}           ; Time handling

        ;; HTTP & JSON
        hato/hato {:mvn/version "1.0.0"}           ; HTTP client
        cheshire/cheshire {:mvn/version "5.13.0"}  ; JSON parsing

        ;; HTTP Server (2.9.0-beta2+ required for SSE)
        http-kit/http-kit {:mvn/version "2.9.0-beta2"}

        ;; Fast serialization (used by seon.db.relay + seon.flow.harness)
        com.taoensso/nippy {:mvn/version "3.4.2"}

        ;; HTML templating (compile-time Hiccup)
        dev.onionpancakes/chassis {:mvn/version "1.0.365"}

        ;; Markdown parsing (for agent message rendering)
        markdown-clj/markdown-clj {:mvn/version "1.12.4"}

        ;; Code repair (delimiter balancing via parinfer)
        parinferish/parinferish {:mvn/version "0.8.0"}

        ;; Code parsing (for delimiter error detection)
        borkdude/edamame {:mvn/version "1.4.27"}

        ;; Code formatting
        dev.weavejester/cljfmt {:mvn/version "0.12.0"}

        ;; Code rewriting (s-expression editing)
        rewrite-clj/rewrite-clj {:mvn/version "1.2.51"}

        ;; Code analysis (clj-kondo as library for in-process linting)
        clj-kondo/clj-kondo {:mvn/version "2025.12.23"}

        ;; JSON (fast - replace cheshire)
        metosin/jsonista {:mvn/version "0.3.11"}

        ;; COMPRESSION (Streaming brotli for SSE)
        com.aayushatharva.brotli4j/brotli4j {:mvn/version "1.18.0"}
        ;; Production: assumes linux x86_64 deployment
        com.aayushatharva.brotli4j/native-linux-x86_64 {:mvn/version "1.18.0"}
        io.netty/netty-buffer {:mvn/version "4.1.119.Final"}}

 :aliases
 {:dev {:extra-paths ["env/dev/clj" "env/dev/resources" "test"]
        :extra-deps {integrant/repl {:mvn/version "0.4.0"}
                     djblue/portal {:mvn/version "0.57.3"}
                     org.clojure/tools.namespace {:mvn/version "1.5.0"}
                     io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                     nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}
                     expound/expound {:mvn/version "0.9.0"}
                     ;; Brotli native libraries for dev (macOS both architectures)
                     com.aayushatharva.brotli4j/native-osx-x86_64 {:mvn/version "1.18.0"}
                     com.aayushatharva.brotli4j/native-osx-aarch64 {:mvn/version "1.18.0"}
                     com.aayushatharva.brotli4j/native-linux-aarch64 {:mvn/version "1.18.0"}
                     ;; Datahike — Embedded Datalog on konserve; file backend
                     ;; for git time-travel. Sole database since chunk M-2.
                     org.replikativ/datahike {:mvn/version "0.8.1671"}
                     ;; Durable atom for agent *ctx* persistence
                     duratom/duratom {:mvn/version "0.5.9"}
                     ;; Small Clojure Interpreter (sandbox evaluation)
                     org.babashka/sci {:mvn/version "0.8.43"}}}

  :prod {:extra-paths ["env/prod/clj" "env/prod/resources"]}

  :test {:extra-paths ["env/dev/clj" "env/dev/resources" "test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      com.gfredericks/test.chuck {:mvn/version "0.2.14"}
                      integrant/repl {:mvn/version "0.4.0"}
                      io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                      expound/expound {:mvn/version "0.9.0"}
                      ;; nREPL for orchestrator tests
                      nrepl/nrepl {:mvn/version "1.3.0"}
                      ;; Datahike (sole database since chunk M-2)
                      org.replikativ/datahike {:mvn/version "0.8.1671"}}
         :jvm-opts []}


  ;; Standalone runner (no nREPL, just Integrant system with console logging)
  ;; Usage: clj -M:dev:run       (dev profile)
  ;;        clj -M:dev:run prod  (prod profile)
  :run {:main-opts ["-m" "seon.runner"]
        :jvm-opts ["-Xms512m"
                   "-Xmx2g"
                   "-XX:+UseG1GC"
                   "-XX:MaxGCPauseMillis=200"
                   "-XX:TieredStopAtLevel=1"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}

  ;; Linting - run via Babashka for speed
  ;; Usage: bb -M:lint src        (run Splint on src)
  ;;        bb -M:lint --autocorrect src  (auto-fix safe issues)
  ;;        clj-kondo --lint src  (system clj-kondo - already installed)
  :lint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.22.0"}}
         :main-opts ["-m" "noahtheduke.splint"]}

  ;; Development nREPL - starts nREPL on port 7888 with user namespace loaded
  ;; Usage: clj -M:dev:nrepl
  ;; Then connect and use (go) to start the Integrant system
  ;; Isolated agent JVM - minimal deps
  ;; Usage: clj -M:agent -m seon.flow.agent-runner --port 7890 --namespace seon.test.hello
  :agent {:replace-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                         org.clojure/core.async {:mvn/version "1.9.829-alpha2"}
                         metosin/malli {:mvn/version "0.20.0"}
                         nrepl/nrepl {:mvn/version "1.3.0"}
                         com.taoensso/timbre {:mvn/version "6.5.0"}
                         com.taoensso/nippy {:mvn/version "3.4.2"}
                         cheshire/cheshire {:mvn/version "5.13.0"}}
          :replace-paths ["src"]
          :main-opts ["-m" "seon.flow.agent-runner"]
          :jvm-opts ["-Xms256m"
                     "-Xmx512m"
                     "-XX:+ExitOnOutOfMemoryError"
                     "-XX:+HeapDumpOnOutOfMemoryError"
                     "-Djava.awt.headless=true"]}

  ;; CLJS build — pod side. Referenced two ways:
  ;;   1. shadow-cljs.edn pulls these deps into the build classpath via
  ;;      `{:deps {:aliases [:cljs]}}`.
  ;;   2. `clj -M:cljs <args>` invokes shadow-cljs's CLI directly
  ;;      (`shadow.cljs.devtools.cli/-main`), bypassing the npx wrapper.
  ;; Usage: `clj -M:cljs watch client`, `clj -M:cljs compile client`,
  ;;        `clj -M:cljs server`, `clj -M:cljs --help`.
  ;;
  ;; Two git/url overrides per spec-02 §5.2 — both reach for Sean's
  ;; personal forks of upstream libs while the patches are in review.
  ;; They live in :extra-deps (not :override-deps) so a direct
  ;; `clj -A:cljs:test -Stree` shows the forks resolving by :git/sha.
  ;;   - datahike: feat/cljs-promise-api — selective Promise wrap on
  ;;     the public API driven by :referentially-transparent?, plus
  ;;     a chan->promise helper and a build.clj fix so deps/prep-lib
  ;;     works cold.
  ;;   - partial-cps: fix/ioc-await-probe-safety — defensive try/catch
  ;;     around the three macro-probe sites in ioc.clj so CLJS 1.12.145's
  ;;     cljs.core/await doesn't crash the CPS transformer.
  ;; Sidecar-overlay alias — opt-in V0 namespace shadowing for the
  ;; sidecar-agent build. Adds `src-overlay/` AHEAD of `src/` so that
  ;; `seon.db` etc. resolve to the sidecar-flavored copies. NEVER
  ;; activate alongside `:client` — that build needs the real V0
  ;; `seon.db`. Use: `clj -M:cljs:cljs-sidecar release sidecar-agent`.
  :cljs-sidecar {:extra-paths ["pod-host/sidecar-poc/guest-cljs/src-overlay"]}

  :cljs {;; Phase D — sidecar-poc guest-cljs lives outside src/; add as an
         ;; extra-path so shadow-cljs's classpath picker finds
         ;; sidecar-poc.* namespaces during the :sidecar-agent build.
         ;; `test` is on shadow-cljs.edn :source-paths but must ALSO appear
         ;; here so shadow's JVM classpath actually sees the test files
         ;; — without it, `seon.test.runner-test` and friends resolve to
         ;; "not available" even though the .cljs files exist on disk.
         ;; The `seon.dev.test-preload` namespace requires the platform
         ;; CLJS tests so they're reachable from the live `:client` pod.
         :extra-paths   ["pod-host/sidecar-poc/guest-cljs/src" "test"]
         :extra-deps    {org.clojure/clojurescript            {:mvn/version "1.12.145"}
                         org.clojure/core.async               {:mvn/version "1.10.870-alpha2"}
                         thheller/shadow-cljs                 {:mvn/version "3.4.10"}
                         org.replikativ/datahike              {:mvn/version "0.8.1681"}
                         org.replikativ/persistent-sorted-set {:mvn/version "0.4.122"}}
         ;; Spec-02 §5.2 — point datahike at the patched fork (selective
         ;; Promise wrap driven by :referentially-transparent?) and
         ;; partial-cps at the cps-probe-safety patch (transitive via
         ;; persistent-sorted-set + datahike's superv.async). Both are
         ;; PR-shaped pending upstream review.
         :override-deps {org.replikativ/datahike
                         {:git/url "https://github.com/seantempesta/datahike"
                          :git/sha "01ba3f18bf08da2c093eb0972ec1f272b817f23d"}
                         org.replikativ/superv.async
                         ;; Patched simple-supervisor's stale-pending
                         ;; watchdog to be LAZY: instead of starting a
                         ;; self-rescheduling setTimeout chain at
                         ;; namespace load, the watchdog activates on
                         ;; the first -track-exception call. Namespace
                         ;; load is timer-free, which lets wasm-rquickjs
                         ;; hosts under wstd::runtime::block_on (e.g.
                         ;; wasmtime CLI's `run --invoke`) return cleanly.
                         ;; Exception surfacing semantics preserved — the
                         ;; watchdog kicks in the moment a real channel
                         ;; exception needs tracking. Branch
                         ;; `wasm/lazy-watchdog`. Upstream PR pending.
                         {:git/url "https://github.com/seantempesta/superv.async"
                          :git/sha "3e6ed755f83634c9e9bbb58707f9446420d32ce9"}
                         is.simm/partial-cps
                         {:git/url "https://github.com/seantempesta/partial-cps"
                          :git/sha "c0d941d4b591351267bc828fdfdf029be53a132f"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  :nrepl {:jvm-opts ["-Xms512m"
                     "-Xmx2g"
                     "-XX:+UseG1GC"
                     "-XX:MaxGCPauseMillis=200"]
          :main-opts ["-m" "nrepl"]}}}
