{:paths ["src" "resources"]

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 :deps {;; Core Clojure
        org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/core.async {:mvn/version "1.9.829-alpha2"}

        ;; Schema & Validation
        metosin/malli {:mvn/version "0.20.0"}

        ;; State Management
        integrant/integrant {:mvn/version "1.0.1"}

        ;; Python Bridge
        clj-python/libpython-clj {:mvn/version "2.025"}
        cnuernber/dtype-next {:mvn/version "10.124"}

        ;; Data Processing (Parquet support)
        techascent/tech.ml.dataset {:mvn/version "7.021"}

        ;; Utilities
        aero/aero {:mvn/version "1.1.6"}           ; Config
        com.taoensso/timbre {:mvn/version "6.5.0"} ; Logging (app code)
        ch.qos.logback/logback-classic {:mvn/version "1.5.6"} ; SLF4J provider
        tick/tick {:mvn/version "0.7.5"}           ; Time handling

        ;; HTTP & JSON
        hato/hato {:mvn/version "1.0.0"}           ; HTTP client
        cheshire/cheshire {:mvn/version "5.13.0"}  ; JSON parsing

        ;; HTTP Server (2.9.0-beta2+ required for SSE)
        http-kit/http-kit {:mvn/version "2.9.0-beta2"}

        ;; Fast serialization (used by seon.db.relay + seon.flow.harness)
        com.taoensso/nippy {:mvn/version "3.4.2"}

        ;; konserve-jdbc + sqlite-jdbc — backing store for the wire-server's
        ;; per-session datahike DBs. See seon.server.store.
        io.replikativ/konserve-jdbc {:mvn/version "0.2.91"
                                     :exclusions [io.replikativ/konserve]}
        org.xerial/sqlite-jdbc {:mvn/version "3.46.1.0"}

        ;; HTML templating (compile-time Hiccup)
        dev.onionpancakes/chassis {:mvn/version "1.0.365"}

        ;; Markdown parsing (for agent message rendering)
        markdown-clj/markdown-clj {:mvn/version "1.12.4"}

        ;; Code repair (delimiter balancing via parinfer)
        parinferish/parinferish {:mvn/version "0.8.0"}

        ;; Code parsing (for delimiter error detection)
        borkdude/edamame {:mvn/version "1.4.27"}

        ;; Code formatting
        dev.weavejester/cljfmt {:mvn/version "0.12.0"}

        ;; Code rewriting (s-expression editing)
        rewrite-clj/rewrite-clj {:mvn/version "1.2.51"}

        ;; Code analysis (clj-kondo as library for in-process linting)
        clj-kondo/clj-kondo {:mvn/version "2025.12.23"}

        ;; JSON (fast - replace cheshire)
        metosin/jsonista {:mvn/version "0.3.11"}

        ;; COMPRESSION (Streaming brotli for SSE)
        com.aayushatharva.brotli4j/brotli4j {:mvn/version "1.18.0"}
        ;; Production: assumes linux x86_64 deployment
        com.aayushatharva.brotli4j/native-linux-x86_64 {:mvn/version "1.18.0"}
        io.netty/netty-buffer {:mvn/version "4.1.119.Final"}}

 :aliases
 {;; ---------------------------------------------------------------------------
  ;; Shared building blocks for the datahike fork (de-dup; compose, never copy).
  ;;
  ;; :fork-deps — the {datahike fork + konserve fork} pair. datahike is the
  ;;   seantempesta/datahike@sync-upstream tip (proximum/secondary retain+restore
  ;;   + query fixes + selective-Promise CLJS api). konserve is the header-fix
  ;;   fork (CLJS meta-size BE32 + legacy 1-byte sniff), supplied via
  ;;   :override-deps so it wins over any transitive konserve. The mvn upstream
  ;;   datahike must appear NOWHERE — every JVM consumer composes :fork-deps.
  ;;   IF YOU BUMP either sha, bump the reference-code/datahike submodule to the
  ;;   matching datahike sha (src-secondary contents must stay byte-aligned).
  ;;
  ;; :simd — the launch surface proximum needs: jdk.incubator.vector + native
  ;;   access + G1GC/2g heap (proximum's SIMD distance kernels; class v66 ⇒
  ;;   JDK 22+ hard floor, builds pinned to JDK 25 via bin/_java-home-resolver),
  ;;   plus the two repo-relative paths that expose the secondary-index
  ;;   namespaces to a git/local datahike dep — src-secondary (the fork's :paths
  ;;   EXCLUDES it, so it is unreachable via normal resolution) and the
  ;;   konserve-shim (a fake META-INF pom.properties so datahike's version-check
  ;;   sees a konserve version for the non-jar git dep, nil otherwise).
  ;;
  ;; Compose: `clojure -M:simd:fork-deps:writer`, `-M:simd:fork-deps:test`, etc.
  ;; ---------------------------------------------------------------------------
  :fork-deps
  {:extra-deps {org.replikativ/datahike
                {:git/url "https://github.com/seantempesta/datahike"
                 :git/sha "5566ab13e874864dc9239870d3d79ed28b187ea8"}}
   :override-deps {org.replikativ/konserve
                   {:git/url "https://github.com/seantempesta/konserve"
                    :git/sha "32e3c59847184c3b4a3acea87797ed9c864a0ff7"}}}

  :simd
  {:jvm-opts ["--add-modules" "jdk.incubator.vector"
              "--enable-native-access=ALL-UNNAMED"
              "-XX:+UseG1GC" "-Xmx2g"]
   :extra-paths ["dev-resources/konserve-shim"
                 "reference-code/datahike/src-secondary"]}

  ;; The dev JVM (paused track) runs embedded datahike. Compose the fork:
  ;;   clj -M:fork-deps:dev:nrepl   /   clj -M:fork-deps:dev:run
  ;; konserve-shim lives here (not via :simd) so dev keeps its own heap/GC opts
  ;; and skips the JDK-25 SIMD jvm-opts (dev doesn't load the proximum index);
  ;; it gives datahike's version-check a konserve version for the non-jar fork.
  :dev {:extra-paths ["env/dev/clj" "env/dev/resources" "test"
                      "dev-resources/konserve-shim"]
        :extra-deps {integrant/repl {:mvn/version "0.4.0"}
                     djblue/portal {:mvn/version "0.57.3"}
                     org.clojure/tools.namespace {:mvn/version "1.5.0"}
                     io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                     nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}
                     expound/expound {:mvn/version "0.9.0"}
                     ;; Brotli native libraries for dev (macOS both architectures)
                     com.aayushatharva.brotli4j/native-osx-x86_64 {:mvn/version "1.18.0"}
                     com.aayushatharva.brotli4j/native-osx-aarch64 {:mvn/version "1.18.0"}
                     com.aayushatharva.brotli4j/native-linux-aarch64 {:mvn/version "1.18.0"}
                     ;; Durable atom for agent *ctx* persistence
                     duratom/duratom {:mvn/version "0.5.9"}
                     ;; Small Clojure Interpreter (sandbox evaluation)
                     org.babashka/sci {:mvn/version "0.8.43"}}}

  :prod {:extra-paths ["env/prod/clj" "env/prod/resources"]}

  ;; The kaocha suite includes the embedding/secondary-index tests, which need
  ;; the SAME fork datahike + proximum the live wire-server runs (the mvn
  ;; upstream had neither, so tests used to run against DIFFERENT code than
  ;; production). Compose the fork + native launch surface:
  ;;   clojure -M:simd:fork-deps:test -m kaocha.runner unit
  ;; :simd supplies src-secondary + konserve-shim + the JDK-25 SIMD jvm-opts;
  ;; :fork-deps supplies the datahike + konserve forks. proximum + transit + the
  ;; embeddings client are test-only here (the secondary-index nses need them).
  :test {:extra-paths ["env/dev/clj" "env/dev/resources" "test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      com.gfredericks/test.chuck {:mvn/version "0.2.14"}
                      integrant/repl {:mvn/version "0.4.0"}
                      io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                      expound/expound {:mvn/version "0.9.0"}
                      ;; nREPL for orchestrator tests
                      nrepl/nrepl {:mvn/version "1.3.0"}
                      ;; Secondary-index backing for the embedding tests
                      ;; (datahike + konserve forks come from :fork-deps).
                      org.replikativ/proximum {:mvn/version "0.1.25"}
                      com.cognitect/transit-clj {:mvn/version "1.0.333"}
                      com.google.genai/google-genai {:mvn/version "1.59.0"}}}


  ;; Standalone runner (no nREPL, just Integrant system with console logging)
  ;; Usage: clj -M:dev:run       (dev profile)
  ;;        clj -M:dev:run prod  (prod profile)
  :run {:main-opts ["-m" "seon.runner"]
        :jvm-opts ["-Xms512m"
                   "-Xmx4g"
                   "-XX:+UseG1GC"
                   "-XX:MaxGCPauseMillis=200"
                   "-XX:TieredStopAtLevel=1"
                   "-XX:+HeapDumpOnOutOfMemoryError"
                   "-XX:HeapDumpPath=logs/"]}

  ;; Platform-track (V2) JVM wire-server / datahike writer.
  ;; Launched by the Rust host (client-runtime/host/src/main.rs) as:
  ;;   clojure -M:writer --backend <b> --path <p> --req-sock <s> --pub-sock <s>
  ;; from the repo root. Boots seon.server.boot/-main, a thin glue ns that
  ;; loads BOTH seon.server.wire AND seon.server.reactive so each registers
  ;; its own on-ensure-db hook + schema at startup (wire.clj stays
  ;; reactive-free — the P1 decoupling); -main delegates to wire/-main, which
  ;; owns the single datahike connection, serves requests over a UDS req
  ;; socket, and broadcasts tx events over a UDS pub socket. Prints
  ;; `[writer] ready`. See seon.server.boot.
  ;;
  ;; The wire-server owns the single datahike connection. It COMPOSES the
  ;; shared fork + native launch surface — invoked as:
  ;;   clojure -M:simd:fork-deps:writer --backend file --path … --req-sock … …
  ;; :simd supplies the SIMD jvm-opts + src-secondary + konserve-shim paths;
  ;; :fork-deps supplies the datahike + konserve forks. Here we add only the
  ;; wire-server's OWN deps: transit-clj (Transit value payloads — the sole
  ;; control codec since the CBOR-envelope removal), proximum (HNSW vector
  ;; index backing :db.secondary/type :proximum), google-genai (embeddings
  ;; client). `src` + `resources` give the seon.server.* sources + seed
  ;; resources; konserve-jdbc / sqlite-jdbc come from the base :deps.
  :writer {:extra-deps {com.cognitect/transit-clj {:mvn/version "1.0.333"}
                        org.replikativ/proximum {:mvn/version "0.1.25"}
                        com.google.genai/google-genai {:mvn/version "1.59.0"}}
           :main-opts ["-m" "seon.server.boot"]}

  ;; The server-wire test nses load against the fork datahike + proximum via
  ;; the shared :simd + :fork-deps + :test (kaocha + proximum + transit + genai
  ;; + test paths) — there is no separate :server-wire-test alias anymore.
  ;; Usage (JDK 25+, pinned via bin/_java-home-resolver):
  ;;   clojure -M:simd:fork-deps:test -m kaocha.runner unit --focus seon.server.wire-types-test …

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}

  ;; Linting - run via Babashka for speed
  ;; Usage: bb -M:lint src        (run Splint on src)
  ;;        bb -M:lint --autocorrect src  (auto-fix safe issues)
  ;;        clj-kondo --lint src  (system clj-kondo - already installed)
  :lint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.22.0"}}
         :main-opts ["-m" "noahtheduke.splint"]}

  ;; Development nREPL - starts nREPL on port 7888 with user namespace loaded
  ;; Usage: clj -M:dev:nrepl
  ;; Then connect and use (go) to start the Integrant system
  ;;
  ;; CLJ agent JVM pool (V0/legacy) — pre-V2 pattern where each agent ran in
  ;; its own out-of-process JVM. V2 replaces this with CLJS agents in wasm
  ;; sandboxes (see :cljs alias). This pool is NOT auto-started by the
  ;; running system; only spawned explicitly when something needs an
  ;; isolated CLJ JVM. Retire entirely once V2 cutover is complete.
  ;; Usage: clj -M:agent-jvm-pool -m seon.flow.agent-runner --port 7890 --namespace seon.test.hello
  :agent-jvm-pool {:replace-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                         org.clojure/core.async {:mvn/version "1.9.829-alpha2"}
                         metosin/malli {:mvn/version "0.20.0"}
                         nrepl/nrepl {:mvn/version "1.3.0"}
                         com.taoensso/timbre {:mvn/version "6.5.0"}
                         com.taoensso/nippy {:mvn/version "3.4.2"}
                         cheshire/cheshire {:mvn/version "5.13.0"}}
          :replace-paths ["src"]
          :main-opts ["-m" "seon.flow.agent-runner"]
          :jvm-opts ["-Xms256m"
                     "-Xmx512m"
                     "-XX:+ExitOnOutOfMemoryError"
                     "-XX:+HeapDumpOnOutOfMemoryError"
                     "-Djava.awt.headless=true"]}

  ;; CLJS build — pod side. Referenced two ways:
  ;;   1. shadow-cljs.edn pulls these deps into the build classpath via
  ;;      `{:deps {:aliases [:cljs]}}`.
  ;;   2. `clj -M:cljs <args>` invokes shadow-cljs's CLI directly
  ;;      (`shadow.cljs.devtools.cli/-main`), bypassing the npx wrapper.
  ;; Usage: `clj -M:cljs watch client`, `clj -M:cljs compile client`,
  ;;        `clj -M:cljs server`, `clj -M:cljs --help`.
  ;;
  ;; Two git/url overrides per spec-02 §5.2 — both reach for Sean's
  ;; personal forks of upstream libs while the patches are in review.
  ;; They live in :extra-deps (not :override-deps) so a direct
  ;; `clj -A:cljs:test -Stree` shows the forks resolving by :git/sha.
  ;;   - datahike: feat/cljs-promise-api — selective Promise wrap on
  ;;     the public API driven by :referentially-transparent?, plus
  ;;     a chan->promise helper and a build.clj fix so deps/prep-lib
  ;;     works cold.
  ;;   - partial-cps: fix/ioc-await-probe-safety — defensive try/catch
  ;;     around the three macro-probe sites in ioc.clj so CLJS 1.12.145's
  ;;     cljs.core/await doesn't crash the CPS transformer.
  :cljs {;; `test` is on shadow-cljs.edn :source-paths but must ALSO appear
         ;; here so shadow's JVM classpath actually sees the test files
         ;; — without it, `seon.test.runner-test` and friends resolve to
         ;; "not available" even though the .cljs files exist on disk.
         ;; The `seon.dev.test-preload` namespace requires the platform
         ;; CLJS tests so they're reachable from the live `:client` pod.
         ;; dev-resources/konserve-shim: META-INF pom.properties so
         ;; datahike's version-check (macro-baked into CLJS at compile
         ;; time) sees a konserve version for the :local/root fork —
         ;; without it old 0.9.346-stamped stores refuse to open.
         :extra-paths   ["test" "dev-resources/konserve-shim"]
         :extra-deps    {org.clojure/clojurescript            {:mvn/version "1.12.145"}
                         org.clojure/core.async               {:mvn/version "1.10.870-alpha2"}
                         thheller/shadow-cljs                 {:mvn/version "3.4.10"}
                         ;; Small Clojure Interpreter — runs AGENT-authored
                         ;; live-tile fns under a wall-clock :interrupt-fn so a
                         ;; non-terminating tile (a sync (loop [] (recur)) / (while
                         ;; true)) aborts in-process instead of freezing the single
                         ;; pod thread. v0.13.53 is the release where
                         ;; sci.interrupt/interrupt! (the un-catchable interrupt)
                         ;; exists. Tile-isolation PRD Layer 1
                         ;; (docs/prds/agent-runtime/tile-isolation-prd-2026-06-21.md).
                         ;; NB distinct from the JVM-only 0.8.43 pin in :dev.
                         org.babashka/sci                     {:mvn/version "0.13.53"}
                         org.replikativ/datahike              {:mvn/version "0.8.1681"}
                         org.replikativ/persistent-sorted-set {:mvn/version "0.4.122"}
                         ;; Transit-JSON for wire value payloads
                         ;; (keywords, sets, instants, ratios) crossing the
                         ;; CLJS guest <-> JVM wire-server boundary. Mirrored by
                         ;; com.cognitect/transit-clj on the server (seon.server.transit).
                         com.cognitect/transit-cljs           {:mvn/version "0.8.280"}
                         ;; reitit — the pod's HTTP front door (seon.web.router).
                         ;; The published CLJS artifact is clean: reitit's trie
                         ;; compiler forks `#?(:cljs clojure-trie :clj java-trie)`,
                         ;; so the Node pod always gets the pure-Clojure trie and
                         ;; the :clj-only JavaSegmentRouter is never loaded. NOT
                         ;; vendored on source-paths (that would drag the Java
                         ;; trie onto the classpath). reitit-core + meta-merge come
                         ;; transitively; reitit-malli rides our malli-everything
                         ;; for future :parameters coercion.
                         metosin/reitit-ring                  {:mvn/version "0.10.1"}
                         metosin/reitit-malli                 {:mvn/version "0.10.1"}}
         ;; Spec-02 §5.2 — point datahike at the patched fork (selective
         ;; Promise wrap driven by :referentially-transparent?) and
         ;; partial-cps at the cps-probe-safety patch (transitive via
         ;; persistent-sorted-set + datahike's superv.async). Both are
         ;; PR-shaped pending upstream review.
         :override-deps {org.replikativ/datahike
                         {:git/url "https://github.com/seantempesta/datahike"
                          :git/sha "5566ab13e874864dc9239870d3d79ed28b187ea8"}
                         ;; konserve header fix (2.2d Stage A): CLJS
                         ;; meta-size BE32 at bytes 4-7 + legacy 1-byte
                         ;; sniff in parse-header, so JVM- and Node-written
                         ;; stores are mutually readable. Fork repo has no
                         ;; pushable remote (mvn 0.9.346 deployed from it)
                         ;; => :local/root until a new mvn deploy.
                         ;; Konserve repo commit: 32e3c598 (sync-only).
                         org.replikativ/konserve
                         {:git/url "https://github.com/seantempesta/konserve"
                            :git/sha "32e3c59847184c3b4a3acea87797ed9c864a0ff7"}
                         org.replikativ/superv.async
                         ;; Patched simple-supervisor's stale-pending
                         ;; watchdog to be LAZY: instead of starting a
                         ;; self-rescheduling setTimeout chain at
                         ;; namespace load, the watchdog activates on
                         ;; the first -track-exception call. Namespace
                         ;; load is timer-free, which lets wasm-rquickjs
                         ;; hosts under wstd::runtime::block_on (e.g.
                         ;; wasmtime CLI's `run --invoke`) return cleanly.
                         ;; Exception surfacing semantics preserved — the
                         ;; watchdog kicks in the moment a real channel
                         ;; exception needs tracking. Branch
                         ;; `wasm/lazy-watchdog`. Upstream PR pending.
                         {:git/url "https://github.com/seantempesta/superv.async"
                          :git/sha "3e6ed755f83634c9e9bbb58707f9446420d32ce9"}
                         is.simm/partial-cps
                         {:git/url "https://github.com/seantempesta/partial-cps"
                          :git/sha "c0d941d4b591351267bc828fdfdf029be53a132f"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  :nrepl {:jvm-opts ["-Xms512m"
                     "-Xmx4g"
                     "-XX:+UseG1GC"
                     "-XX:MaxGCPauseMillis=200"
                     "-XX:+HeapDumpOnOutOfMemoryError"
                     "-XX:HeapDumpPath=logs/"]
          :main-opts ["-m" "nrepl"]}}}
