{:paths ["src" "resources"]

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        metosin/malli {:mvn/version "0.20.0"}}

 :aliases
 {;; JVM datahike writer. This alias is the complete server contract: it
  ;; selects the maintained
  ;; Datahike/Konserve pair, exposes the optional Proximum source, and carries
  ;; the launch flags required by its SIMD implementation. Source launch,
  ;; focused tests, the Docker classpath, and writer-uber all use this basis.
  ;;
  ;; Proximum's slf4j-simple is selected explicitly as the writer's sole SLF4J
  ;; provider.
  :writer
  {:replace-paths ["src"]
   :extra-paths ["reference-code/datahike/src-secondary"]
   :replace-deps
   {org.clojure/clojure {:mvn/version "1.12.0"}
    metosin/malli {:mvn/version "0.20.0"}

    org.replikativ/datahike
    {:git/url "https://github.com/seantempesta/datahike"
     :git/sha "ea6e98812df0d9ddb3d7b089a350505e01ff8c0c"
     :exclusions [org.clojure/clojurescript
                  com.github.pkpkpk/cljs-cache]}
    org.replikativ/konserve
    {:git/url "https://github.com/seantempesta/konserve"
     :git/sha "df6818d43ea3363a808cd051c0d68917f1b987a9"
     :exclusions [org.clojure/clojurescript
                  org.clojars.mmb90/cljs-cache
                  com.github.pkpkpk/cljs-node-io
                  com.github.pkpkpk/fress]}
    org.replikativ/hasch
    {:mvn/version "0.4.100"
     :exclusions [org.clojure/clojurescript]}

    com.taoensso/timbre {:mvn/version "6.5.0"}
    com.cognitect/transit-clj {:mvn/version "1.0.333"}
    org.replikativ/proximum {:mvn/version "0.1.25"}
    com.google.genai/google-genai {:mvn/version "1.59.0"}
    com.github.kkuegler/human-readable-ids-java {:mvn/version "0.4"}
    io.github.thibaultmeyer/cuid {:mvn/version "2.0.5"}

    org.slf4j/slf4j-simple {:mvn/version "2.0.16"}}
   :jvm-opts ["--add-modules" "jdk.incubator.vector"
              "--enable-native-access=ALL-UNNAMED"
              "-XX:+UseG1GC" "-Xmx2g"]}

  ;; Focused writer tests add source only; clojure.test already rides Clojure.
  ;; bin/test-writer selects exact retained namespaces without booting the
  ;; server or discovering unrelated CLJS tests.
  :writer-test
  {:extra-paths ["test"]}

  ;; The database-writer test namespaces load against the exact :writer basis;
  ;; there is no second writer dependency graph or broad JVM test discovery.
  ;; Usage (JDK 25+, pinned via bin/_java-home-resolver):
  ;;   bin/test-writer seon.db.transport-uds-test

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}

  ;; Linting - run via Babashka for speed
  ;; Usage: bb -M:lint src        (run Splint on src)
  ;;        bb -M:lint --autocorrect src  (auto-fix safe issues)
  ;;        clj-kondo --lint src  (system clj-kondo - already installed)
  :lint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.22.0"}}
         :main-opts ["-m" "noahtheduke.splint"]}

  ;; CLJS build — pod side. Referenced two ways:
  ;;   1. shadow-cljs.edn pulls these deps into the build classpath via
  ;;      `{:deps {:aliases [:cljs]}}`.
  ;;   2. `clj -M:cljs <args>` invokes shadow-cljs's CLI directly
  ;;      (`shadow.cljs.devtools.cli/-main`), bypassing the npx wrapper.
  ;; Usage: `clj -M:cljs watch client`, `clj -M:cljs compile client`,
  ;;        `clj -M:cljs server`, `clj -M:cljs --help`.
  ;;
  ;; Two git/url overrides per spec-02 §5.2 — both reach for Sean's
  ;; personal forks of upstream libs while the patches are in review.
  ;; The direct dependency plus override makes a dependency-tree inspection
  ;; show the forks resolving by :git/sha.
  ;;   - datahike: feat/cljs-promise-api — selective Promise wrap on
  ;;     the public API driven by :referentially-transparent?, plus
  ;;     a chan->promise helper and a build.clj fix so deps/prep-lib
  ;;     works cold.
  ;;   - partial-cps: fix/ioc-await-probe-safety — defensive try/catch
  ;;     around the three macro-probe sites in ioc.clj so CLJS 1.12.145's
  ;;     cljs.core/await doesn't crash the CPS transformer.
  :cljs {;; `test` is on shadow-cljs.edn :source-paths but must ALSO appear
         ;; here so shadow's JVM classpath actually sees the test files
         ;; — without it, `seon.test.runner-test` and friends resolve to
         ;; "not available" even though the .cljs files exist on disk.
         ;; The `seon.dev.test-preload` namespace requires the platform
         ;; CLJS tests so they're reachable from the live `:client` pod.
         ;; This alias owns every CLJS compiler JVM: the long-lived client
         ;; watcher and one-shot test compilers. Host-sized JDK ergonomics on
         ;; a 128 GiB workstation otherwise commit a 2 GiB initial heap and
         ;; permit ~30 GiB per concurrent compiler. Keep one explicit bounded
         ;; policy here; do not duplicate heap flags in launch scripts.
         :jvm-opts      ["-Xms256m" "-Xmx3g"]
         :extra-paths   ["test"]
         :extra-deps    {org.clojure/clojurescript            {:mvn/version "1.12.145"}
                         org.clojure/core.async               {:mvn/version "1.10.870-alpha2"}
                         thheller/shadow-cljs                 {:mvn/version "3.4.10"}
                         aero/aero                            {:mvn/version "1.1.6"}
                         com.taoensso/timbre                  {:mvn/version "6.5.0"}
                         parinferish/parinferish              {:mvn/version "0.8.0"}
                         rewrite-clj/rewrite-clj              {:mvn/version "1.2.51"}
                         ;; Small Clojure Interpreter — runs AGENT-authored
                         ;; canvas fns under a wall-clock :interrupt-fn so a
                         ;; non-terminating tile (a sync (loop [] (recur)) / (while
                         ;; true)) aborts in-process instead of freezing the single
                         ;; pod thread. v0.13.53 is the release where
                         ;; sci.interrupt/interrupt! (the un-catchable interrupt)
                         ;; exists. Tile-isolation PRD Layer 1
                         ;; (docs/prds/agent-runtime/tile-isolation-prd-2026-06-21.md).
                         org.babashka/sci                     {:mvn/version "0.13.53"}
                         org.replikativ/datahike              {:mvn/version "0.8.1681"}
                         org.replikativ/persistent-sorted-set {:mvn/version "0.4.137"}
                         ;; Transit-JSON for protocol values
                         ;; (keywords, sets, instants, ratios) crossing the
                         ;; CLJS replica <-> JVM database-server boundary. Mirrored by
                         ;; com.cognitect/transit-clj in seon.db.transport.uds.
                         com.cognitect/transit-cljs           {:mvn/version "0.8.280"}
                         ;; reitit — the pod's HTTP front door (seon.web.router).
                         ;; The published CLJS artifact is clean: reitit's trie
                         ;; compiler forks `#?(:cljs clojure-trie :clj java-trie)`,
                         ;; so the Node pod always gets the pure-Clojure trie and
                         ;; the :clj-only JavaSegmentRouter is never loaded. NOT
                         ;; vendored on source-paths (that would drag the Java
                         ;; trie onto the classpath). reitit-core + meta-merge come
                         ;; transitively; reitit-malli rides our malli-everything
                         ;; for future :parameters coercion.
                         metosin/reitit-ring                  {:mvn/version "0.10.1"}
                         metosin/reitit-malli                 {:mvn/version "0.10.1"}}
         ;; Spec-02 §5.2 — point datahike at the patched fork (selective
         ;; Promise wrap driven by :referentially-transparent?) and
         ;; partial-cps at the cps-probe-safety patch (transitive via
         ;; persistent-sorted-set + datahike's superv.async). Both are
         ;; PR-shaped pending upstream review.
         :override-deps {org.replikativ/datahike
                         {:git/url "https://github.com/seantempesta/datahike"
                          :git/sha "ea6e98812df0d9ddb3d7b089a350505e01ff8c0c"}
                         ;; Konserve 0.9.356 plus the shared CLJ/CLJS legacy
                         ;; one-byte metadata-header reader. The fork publishes
                         ;; its own 0.9.356-seon.1 Maven resource, so no consumer
                         ;; version shim is required.
                         org.replikativ/konserve
                         {:git/url "https://github.com/seantempesta/konserve"
                          :git/sha "df6818d43ea3363a808cd051c0d68917f1b987a9"}
                         org.replikativ/superv.async
                         ;; Patched simple-supervisor's stale-pending
                         ;; watchdog to be LAZY: instead of starting a
                         ;; self-rescheduling setTimeout chain at
                         ;; namespace load, the watchdog activates on
                         ;; the first -track-exception call. Namespace
                         ;; load is timer-free, which lets wasm-rquickjs
                         ;; hosts under wstd::runtime::block_on (e.g.
                         ;; wasmtime CLI's `run --invoke`) return cleanly.
                         ;; Exception surfacing semantics preserved — the
                         ;; watchdog kicks in the moment a real channel
                         ;; exception needs tracking. Branch
                         ;; `wasm/lazy-watchdog`. Upstream PR pending.
                         {:git/url "https://github.com/seantempesta/superv.async"
                          :git/sha "3e6ed755f83634c9e9bbb58707f9446420d32ce9"}
                         is.simm/partial-cps
                         {:git/url "https://github.com/simm-is/partial-cps"
                          :git/sha "1e119b03ea908ad925b98f9ba0a26371c65441e3"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}}}
