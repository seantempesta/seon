{;; THE SYSTEM (2026-07-27 tree split): `src/` and `test/` are the
 ;; project. The old system's quarry was deleted from the tree on
 ;; 2026-08-05 — git history is the archive.
 ;; resources is the classpath authority for schema EDN and render assets
 ;; (css build products, bundled fonts once licensed).
 :paths ["src" "resources"]

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}

 ;; The system's dependency closure. Every coordinate is deliberate; the
 ;; maintained forks are vendored in reference-code/ and read, not guessed.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        juji/editscript {:local/root "reference-code/editscript"}
        metosin/malli {:local/root "reference-code/malli"}
        org.commonmark/commonmark-ext-heading-anchor {:mvn/version "0.24.0"}
        org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.24.0"}
        org.commonmark/commonmark-ext-yaml-front-matter {:mvn/version "0.24.0"}
        clj-kondo/clj-kondo
        {:local/root "reference-code/clj-kondo"
         ;; Both coordinates publish the same parser namespaces. Datahike's
         ;; maintained org.replikativ coordinate is the application owner.
         :exclusions [io.replikativ/datalog-parser]}
        ;; Flow is published from core.async's dev-flow-alpha branch under
        ;; the same artifact as core.async; alpha3 adds :ping-map-fn.
        org.clojure/core.async {:mvn/version "1.10.874-alpha3"}
        ;; seon.print lays text out with fipp's engine; the same version
        ;; malli already brings (reference-code/fipp is v0.6.29).
        fipp/fipp {:mvn/version "0.6.29"}
        ;; seon.cache: the one process cache for derived values, bounded in
        ;; estimated bytes, one derivation per key (cache-central design 2026-09-26).
        com.github.ben-manes.caffeine/caffeine {:mvn/version "3.2.4"}
        ;; Byte counting without building a byte array (Utf8/encodedLength); already
        ;; on the classpath through dependencies, declared because Seon calls it.
        com.google.guava/guava {:mvn/version "31.0.1-jre"}
        ;; HTML serialization (replaces seon.render.hiccup, AU-Q7).
        hiccup/hiccup {:mvn/version "2.0.0"}

        org.replikativ/datahike
        {:local/root "reference-code/datahike"
         :exclusions [org.clojure/clojurescript
                      com.github.pkpkpk/cljs-cache
                      org.replikativ/konserve]}
        org.replikativ/konserve
        {:git/url "https://github.com/seantempesta/konserve"
         :git/sha "a2a24792ff410235ea4c211f8434785c6e3a6576"
         :exclusions [org.clojure/clojurescript
                      org.clojars.mmb90/cljs-cache
                      com.github.pkpkpk/cljs-node-io
                      com.github.pkpkpk/fress]}
        ;; Our fork: go-try-/<?- carry every Throwable. Upstream passes an
        ;; Error as a closed channel, which konserve and Datahike read as a
        ;; successful write (docs/seon/issues/published-head-references-never-written-index-nodes.md).
        org.replikativ/superv.async
        {:git/url "https://github.com/seantempesta/superv.async"
         :git/sha "501b42945693804fd3e57276cc2a07ed4fe1d602"
         :exclusions [org.clojure/clojurescript]}
        org.replikativ/hasch
        {:mvn/version "0.4.100"
         :exclusions [org.clojure/clojurescript]}
        org.replikativ/proximum
        {:git/url "https://github.com/seantempesta/proximum"
         :git/sha "9a4edc0d5b07ea37d5059135fbb72c660348bcc9"
         :exclusions [org.replikativ/konserve]}

        ;; The one interpreter on every tier; our fork (interrupt-fn is
        ;; the ONE guard). Default classpath since N3: the run loop's
        ;; reply splitter and the value-admission gate are system code.
        org.babashka/sci {:local/root "reference-code/sci"}
        ;; Retain parser token and enclosing collection evidence for refusals.
        borkdude/edamame {:local/root "reference-code/edamame"}

        ;; The model wire's JSON codec (seon.ai) — Clojure-official,
        ;; zero-dependency. The HTTP client is JDK java.net.http (no
        ;; coordinate needed): plain synchronous, virtual threads park.
        org.clojure/data.json {:mvn/version "2.5.1"}

        ;; Retained size of a live value (GraphLayout): the cache charges a
        ;; program context what it retains. Allocation counters cannot
        ;; answer retention.
        org.openjdk.jol/jol-core {:mvn/version "0.17"}

        ;; Five-field schedule parsing and validation. Seon owns nominal
        ;; instant identity and the ZoneRules correction for repeated local
        ;; minutes; it does not carry a second cron parser.
        com.cronutils/cron-utils {:mvn/version "9.2.1"}

        ;; Derived HTML text projection over already-captured response bytes.
        org.jsoup/jsoup {:mvn/version "1.22.2"}

        ;; One per-cluster derived full-text index. The database remains truth;
        ;; bridge inspected under reference-code/datahike; 10.5.0 is the
        ;; current exact Apache release and supports this Java 26 runtime.
        org.apache.lucene/lucene-core {:mvn/version "10.5.0"}
        org.apache.lucene/lucene-analysis-common {:mvn/version "10.5.0"}
        org.apache.lucene/lucene-queryparser {:mvn/version "10.5.0"}

        ;; Generative properties are runtime evaluation material as well as
        ;; developer tests: goal grading loads them in the eval host.
        org.clojure/test.check {:mvn/version "1.1.1"}

        ;; Malli delegates regex generation to test.chuck. Schema
        ;; generatability is runtime evaluation material too.
        com.gfredericks/test.chuck {:mvn/version "0.2.15"}

        ;; Protected JVM filesystem convenience only. Seon owns roots,
        ;; no-follow traversal, bounds, preconditions, and flat errors.
        babashka/fs {:local/root "reference-code/babashka/fs"}

        ;; Foreground argv-vector subprocesses. Seon owns cwd policy,
        ;; environment overrides, stream capture, deadlines, and tree reaping.
        ;; Upstream babashka/process: dev_cache.clj compiles in load-start order,
        ;; so its pprint extension needs no AOT guard.
        babashka/process {:local/root "reference-code/babashka-process"}

        ;; Lossless structural source selection and transformation. The edit
        ;; core additionally fences rewrite-clj's normalized render against an
        ;; exact splice into the original UTF-8 source.
        rewrite-clj/rewrite-clj
        {:local/root "reference-code/rewrite-clj"}

        ;; The render pipeline's wire: Datastar SSE morphs over http-kit
        ;; (N4 — the web layer is system code; the block morph rides SSE).
        dev.data-star.clojure/sdk
        {:local/root "reference-code/datastar-clojure/libraries/sdk"}
        ;; Fork: atomic pending-byte/drain state for bounded SSE writes.
        ;; Retire this override when the http-kit #180/#474 fix merges upstream.
        http-kit/http-kit
        {:local/root "reference-code/http-kit"}
        metosin/reitit-ring {:mvn/version "0.10.1"}
        dev.data-star.clojure/http-kit
        {:local/root
         "reference-code/datastar-clojure/libraries/sdk-http-kit"}

        com.taoensso/timbre {:mvn/version "6.5.0"}
        com.cognitect/transit-clj {:mvn/version "1.0.333"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.16"}}

 :aliases
 {;; Dev REPL on the system's source classpath — no AOT, no artifact, no
  ;; operator. The JVM flags are Proximum's SIMD requirements plus the
  ;; collector; they ride every -M invocation that loads the database
  ;; closure. The heap cap is not here: the operator passes `-Xmx` from
  ;; `:seon.config.operator/heap-max-bytes` (config/default.edn).
  :dev
  {:jvm-opts ["--add-modules" "jdk.incubator.vector"
              "--enable-native-access=ALL-UNNAMED"
              "-XX:+UseG1GC"
              "-XX:G1PeriodicGCInterval=30000"
              "-XX:MinHeapFreeRatio=20" "-XX:MaxHeapFreeRatio=40"
              ;; Datahike's restored index nodes sit behind SoftReferences
              ;; (persistent-sorted-set's default ref type); the bounded node
              ;; LRU (:seon.config.db/store-cache-size) is the configured cache.
              ;; At the JDK default of 1000 ms per free MB a node read in the
              ;; last 20-50 minutes survives every collection, System/gc
              ;; included, and counts as tenured occupancy at the memory gate.
              "-XX:SoftRefLRUPolicyMSPerMB=10"]}

  ;; Rebuild the source-preferred class cache for the dependency namespaces
  ;; reached by `seon.cluster.boot`; first-party source remains uncached.
  :dev-cache
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          babashka/process {:local/root "reference-code/babashka-process"}}
   :ns-default dev-cache}

  ;; The test classpath every cluster JVM runs with: `seon.test/run` executes
  ;; tests in the cluster's own JVM (`bin/test-check`, `bin/test`).
  :test
  {:extra-paths ["test" "script" "."]
   :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                ;; JVM-only testbed dependency; the Seon fork is published
                ;; v0.1.5@376d6ec + 1 commit. fbff842 publishes the bound port.
                io.github.clojure/core.async.flow-monitor
                {:local/root "reference-code/core.async.flow-monitor"}}
   ;; The heap cap comes from the operator's `-Xmx`, as for :dev.
   :jvm-opts ["--add-modules" "jdk.incubator.vector"
              "--enable-native-access=ALL-UNNAMED"
              "-XX:+UseG1GC"
              "-XX:G1PeriodicGCInterval=30000"
              "-XX:MinHeapFreeRatio=20" "-XX:MaxHeapFreeRatio=40"
              ;; Datahike's restored index nodes sit behind SoftReferences
              ;; (persistent-sorted-set's default ref type); the bounded node
              ;; LRU (:seon.config.db/store-cache-size) is the configured cache.
              ;; At the JDK default of 1000 ms per free MB a node read in the
              ;; last 20-50 minutes survives every collection, System/gc
              ;; included, and counts as tenured occupancy at the memory gate.
              "-XX:SoftRefLRUPolicyMSPerMB=10"
              ;; A heap failure ends the JVM instead of limping into the store.
              ;; The operator names the dump directory (<root>/data/heap) at
              ;; launch; this JVM's working directory may be a pruned archive.
              ;; Crash, not Exit: an exit skips JFR's dump, a crash writes its
              ;; emergency dump (hs_err_pid<pid>.jfr) and hs_err log there too.
              "-XX:+CrashOnOutOfMemoryError" "-XX:-CreateCoredumpOnCrash"
              "-XX:+HeapDumpOnOutOfMemoryError"
              ;; Forensics: JFR's default (low-overhead) profile, continuously,
              ;; as a ring of the last 10 minutes or 256 MB on disk. A crash
              ;; dumps it; a live JVM dumps it with `jcmd <pid> JFR.dump name=seon`.
              "-XX:StartFlightRecording=name=seon,settings=default,maxage=10m,maxsize=256m"]}

  ;; Offline retained-size measurement of the contract table (contracts-out
  ;; design §10, root ruling 2026-09-27): its own JVM, never on default.
  ;; clojure -M:measure -m seon.measure-contracts bench/seon/contracts_corpus.edn bench/seon/contracts_measurement.edn
  :measure
  {:extra-paths ["bench"]
   :extra-deps {com.clojure-goes-fast/clj-memory-meter {:mvn/version "0.3.0"}}
   :jvm-opts ["-Djdk.attach.allowAttachSelf" "--add-modules" "jdk.incubator.vector"
              "--enable-native-access=ALL-UNNAMED" "-XX:+UseG1GC" "-Xmx6g"]}

  ;; Linting — run via Babashka for speed.
  ;; Usage: bb -M:lint src        (Splint)
  ;;        clj-kondo --lint src  (system clj-kondo)
  :lint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.22.0"}}
         :main-opts ["-m" "noahtheduke.splint"]}}}
