<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Console output only for tests - minimal noise -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5relative %-5level %logger{35} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress noisy third-party libraries during tests -->
    <logger name="org.eclipse.aether" level="ERROR" />
    <logger name="io.methvin.watcher" level="ERROR" />
    <logger name="org.eclipse.jgit" level="ERROR" />
    <logger name="com.zaxxer.hikari" level="ERROR" />
    <logger name="org.apache.http" level="ERROR" />
    <logger name="org.xnio.nio" level="ERROR" />
    <logger name="io.undertow" level="ERROR" />
    <logger name="org.apache.arrow" level="ERROR" />
    <logger name="io.netty" level="ERROR" />
    <logger name="xtdb" level="WARN" />

    <!-- Application logs at INFO level for tests -->
    <logger name="ml-options" level="INFO" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
