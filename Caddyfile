# Optional browser-facing HTTP/2 + TLS boundary for Seon's Node web UI.
# The pod remains the application server and defaults to 127.0.0.1:7890.
# Caddy multiplexes visible-tab Datastar feeds while proxying to that one
# canonical HTTP/1.1 implementation.
#
# The pod owns SSE gzip and Z_SYNC_FLUSH. Do not add an `encode` directive here
# or create a second buffering/compression policy. `flush_interval -1` makes the
# proxy stream every upstream write immediately; the pod also emits
# X-Accel-Buffering: no for proxies that understand it.
#
# Defaults can be overridden without editing this file:
#   SEON_CADDY_ADDRESS=https://localhost:3030
#   SEON_CADDY_UPSTREAM=127.0.0.1:7890
# Local certificates are deliberately not installed into host trust stores at
# process start. Run `caddy trust` once if a trusted browser URL is desired;
# curl and other diagnostics can instead opt into the local certificate.
{
	auto_https disable_redirects
	skip_install_trust
}

{$SEON_CADDY_ADDRESS:https://localhost:3030} {
	tls internal
	reverse_proxy {$SEON_CADDY_UPSTREAM:127.0.0.1:7890} {
		flush_interval -1
	}
}
