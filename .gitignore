# Clojure
.cpcache/
classes/
*.jar
pom.xml
pom.xml.asc

# XTDB data (large, local only)
data/
# V0 CLJS pod per-run datahike file stores (data/seon-pod/<run-id>/).
# Covered by data/ above; listed explicitly so the pod-store intent is
# discoverable and survives any narrowing of the data/ rule.
data/seon-pod/

# Editor/IDE
.nrepl-port
.lsp/.cache/
.clj-kondo/.cache/
.calva/output-window/
.claude/settings.local.json

# Logs and temporary files (local only)
logs/
tmp/
*.log

# Python generated bytecode
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Secrets (never commit)
.env
.env.*
!.env.example
*.secret
credentials.json

# Editor config
.calva/

# Node.js / Tailwind build
node_modules/
resources/public/css/output.css
hs_err_pid*.log

# shadow-cljs build outputs + per-build state
.shadow-cljs/
out/
# frozen bench bundle (:bench-client) — built on demand by bin/seon
out-bench/

# Symlink into out/ — convenience for local dev; resolves to nothing elsewhere
/bootstrap

# Rust / wasm-tauri build artifacts (per-user, large)
pod-host/wasm-tauri/target/
pod-host/wasm-tauri/pod-build/
pod-host/wasm-tauri/eval-smoke-build/
pod-host/wasm-tauri/smoke-build/
pod-host/wasm-tauri/.envrc

# client-runtime guest: generated wasm-rquickjs wrapper crate (regenerated by build-guest)
guest-cljs/build/crate/
client-runtime/host/target/

# Per-user reference checkouts (separate git clones, not Seon source)
reference-code/datahike-lmdb/

# Agent worktree state (per-user, local-only)
.claude/worktrees/
.antigravitycli/

# Obsidian vault state (per-user)
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/plugins/*/data.json
# Third-party plugin code — pulled in by Obsidian per user, not part of seon's source.
# Plugins ship under their own licenses (typically MIT) and inflate the repo.
docs/.obsidian/plugins/
# Root-level .obsidian/ appears if someone opens the seon/ dir as a vault;
# the canonical vault is docs/ — anything here is per-user workspace state.
/.obsidian/

# Claude Code runtime state
.claude/scheduled_tasks.lock
.claude/test-hook.db
.claude/test-hook.db-journal
.claude/test-hook.db-wal
.claude/test-hook.db-shm

# Stray konserve stores (if datahike :file backend ever runs without absolute :data-root)
*.ksv
target/
scratchpad/
out-acme/
evals/runs/*/*/blobs/
evals/runs/*/*/*/blobs/
# Raw drive transcripts (byte-exact LLM replays) are on-disk working artifacts,
# never committed — the distilled README.md/defects.md carry the cited excerpts.
evals/runs/*/transcripts/
*.heapsnapshot
