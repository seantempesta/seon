;; clj-kondo Configuration
;; See: https://github.com/clj-kondo/clj-kondo/blob/master/doc/config.md

{:linters
 {;; === ERROR LEVEL (block on these) ===
  ;; These are definite bugs that should block commits

  :unresolved-symbol {:level :error}
  :unresolved-namespace {:level :error}
  :unresolved-var {:level :error}
  :invalid-arity {:level :error}
  :type-mismatch {:level :error}
  :missing-else-branch {:level :off}  ; too noisy for our style

  ;; === WARNING LEVEL (report but don't block) ===
  ;; These are likely issues that should be fixed

  :unused-binding {:level :warning}
  :unused-import {:level :warning}
  :unused-namespace {:level :warning}
  :unused-referred-var {:level :warning}
  :unused-private-var {:level :warning}
  :redundant-do {:level :warning}
  :redundant-let {:level :warning}
  :redundant-expression {:level :warning}
  :misplaced-docstring {:level :warning}
  :deprecated-var {:level :warning}
  :shadowed-var {:level :warning}
  :loop-without-recur {:level :warning}
  :unused-value {:level :warning}
  :single-operand-comparison {:level :warning}

  ;; === INFO LEVEL (suggestions) ===
  ;; These are style suggestions, not problems

  :refer-all {:level :info}
  :clojure-lsp/unused-public-var {:level :info}

  ;; === OFF (disabled) ===
  ;; These are too noisy or not applicable

  :redundant-ignore {:level :off}  ; we use splint disable comments
  :docstring-blank? {:level :off}
  :docstring-no-summary {:level :off}
  :docstring-leading-trailing-whitespace {:level :off}}

 ;; Output format configuration
 :output
 {:format :text
  :canonical-paths true
  :include-files [".clj" ".cljc" ".cljs" ".edn"]}

 ;; Skip linting these paths
 :skip-files ["target/.*" "reference-code/.*" ".cpcache/.*"]

 ;; Namespace configuration
 :ns-groups
 [{:pattern "seon\\..*"
   :name seon}]

 ;; Analysis exports (useful for tooling integration)
 :analysis
 {:arglists true
  :locals true
  :keywords true
  :protocol-impls true
  :instance-invocations true}}
