;; clj-kondo Configuration
;; See: https://github.com/clj-kondo/clj-kondo/blob/master/doc/config.md

{:linters
 {;; === ERROR LEVEL (block on these) ===
  ;; These are definite bugs that should block commits

  ;; `await` is a CLJS 1.12.145+ special form for native async/await
  ;; (see memory: reference-cljs-async-await). clj-kondo doesn't know
  ;; the special form yet; whitelist it so ^:async fns lint clean.
  :unresolved-symbol {:level :error
                      :exclude [await]}
  :unresolved-namespace {:level :error}
  :unresolved-var {:level :error}
  :invalid-arity {:level :error}
  ;; visible warning context, never an edit veto: kondo's local type
  ;; inference is not a sound admission proof (AGENTS.md, dev feedback), and
  ;; src/seon/fn/analyzer.clj exempts exactly this class at publication — a
  ;; :error level here blocked edits the publication gate correctly admits
  ;; (issue: type-mismatch-blocks-edits-that-deref-a-connection)
  :type-mismatch {:level :warning}
  :missing-else-branch {:level :off}  ; too noisy for our style

  ;; === WARNING LEVEL (report but don't block) ===
  ;; These are likely issues that should be fixed

  :unused-binding {:level :warning}
  :unused-import {:level :warning}
  :unused-namespace {:level :warning}
  :unused-referred-var {:level :warning}
  :unused-private-var {:level :warning}
  :redundant-do {:level :warning}
  :redundant-let {:level :warning}
  :redundant-expression {:level :warning}
  :misplaced-docstring {:level :warning}
  :deprecated-var {:level :warning}
  :shadowed-var {:level :warning}
  :loop-without-recur {:level :warning}
  :unused-value {:level :warning}
  :single-operand-comparison {:level :warning}

  ;; A blocking wait belongs to `seon.await/await!`, which bounds it by a
  ;; carried config fact and names the missing event on expiry; a monitor
  ;; cannot be timed or interrupted at all (hangs research
  ;; 2026-09-23 section 2). Warning, not error: the counted residue is
  ;; converted by the slices that touch it, and an error here would block
  ;; every edit of a file that still holds one.
  :discouraged-var
  {clojure.core.async/<!! {:message "Bare blocking take: await it through seon.await/await! under a carried bound."}
   clojure.core.async/>!! {:message "Bare blocking put: await it through seon.await/await! under a carried bound."}
   clojure.core.async/alts!! {:message "Bare blocking alts: await it through seon.await/await! under a carried bound."}
   clojure.core/promise {:message "A promise is a completion without a bound: use the dependency's exit fact or a channel awaited through seon.await/await!."}
   clojure.core/future {:message "A future is a thread nobody joins: submit to the Flow work launcher, or await it through seon.await/await!."}
   clojure.core/locking {:message "A monitor cannot be timed or interrupted: serialize through a Flow proc or an atom."}
   ;; Printing has one owner per role (AGENTS.md, "Apply presentation
   ;; limits once"): display is the value printer (seon.render.value/bounded-text,
   ;; seon.render.value/floor for a Throwable); canonical EDN text and
   ;; hashing are seon.id/printed and seon.id/id, which stream into their
   ;; sink. A bare print of a value outside them is unbounded: a pr-str of a
   ;; failing value holding SCI contexts built a 2 GB string and killed
   ;; default (2026-09-28 00:07Z). `format` is not listed: 37 of its 50 uses
   ;; format numbers, and a var-level rule cannot tell `%,d` from `%s`.
   clojure.core/pr-str {:message "Unbounded print: display through seon.render.value/bounded-text; canonical EDN through seon.id/printed; identity through seon.id/id."}
   clojure.core/prn-str {:message "Unbounded print: display through seon.render.value/bounded-text; canonical EDN through seon.id/printed."}
   clojure.core/print-str {:message "Unbounded print: display through seon.render.value/bounded-text."}
   clojure.core/println-str {:message "Unbounded print: display through seon.render.value/bounded-text."}
   clojure.core/pr {:message "Unbounded print: display through seon.render.value/bounded-text."}
   clojure.core/prn {:message "Unbounded print: print (seon.render.value/bounded-text value), or seon.render.value/floor for a Throwable."}
   clojure.core/print {:message "Unbounded print: print only text the value printer bounded (seon.render.value/bounded-text)."}
   clojure.core/println {:message "Unbounded print: print only text the value printer bounded (seon.render.value/bounded-text); a Throwable through seon.render.value/floor."}
   clojure.core/printf {:message "Unbounded print: format numbers, and display values through seon.render.value/bounded-text."}
   clojure.pprint/pprint {:message "Unbounded print: display through seon.render.value, the value printer."}
   clojure.pprint/write {:message "Unbounded print: display through seon.render.value, the value printer."}}

  ;; === INFO LEVEL (suggestions) ===
  ;; These are style suggestions, not problems

  :refer-all {:level :info}
  :clojure-lsp/unused-public-var {:level :info}

  ;; === OFF (disabled) ===
  ;; These are too noisy or not applicable

  :redundant-ignore {:level :off}  ; we use splint disable comments
  :docstring-blank? {:level :off}
  :docstring-no-summary {:level :off}
  :docstring-leading-trailing-whitespace {:level :off}}

 ;; Macros whose binding forms clj-kondo cannot infer. `with-authority`
 ;; binds only the first element of its 3-element vector, so no builtin
 ;; binding shape applies; def-catch-all keeps unresolved-symbol trustworthy
 ;; everywhere else.
 :lint-as
 {seon.db.remote-contract-test/with-authority clj-kondo.lint-as/def-catch-all}

 ;; The one bounded await owner is the only namespace allowed the bare forms.
 ;; The print owners are the only namespaces allowed the bare printers: the
 ;; value printer and its layout (seon.render.value, seon.print) and the canonical
 ;; EDN text every identity hashes (seon.id).
 :config-in-ns
 {seon.render.value {:linters {:discouraged-var {clojure.core/pr-str {:level :off}}}}
  seon.print {:linters {:discouraged-var {clojure.core/pr-str {:level :off}}}}
  seon.id {:linters {:discouraged-var {clojure.core/pr {:level :off}}}}
  seon.await
  {:linters
   {:discouraged-var
    {clojure.core.async/<!! {:level :off}
     clojure.core.async/>!! {:level :off}
     clojure.core.async/alts!! {:level :off}
     clojure.core/promise {:level :off}
     clojure.core/future {:level :off}
     clojure.core/locking {:level :off}}}}}

 ;; Output format configuration
 :output
 {:format :text
  :canonical-paths true
  :include-files [".clj" ".cljc" ".cljs" ".edn"]}

 ;; Skip linting these paths
 :skip-files ["target/.*" "reference-code/.*" ".cpcache/.*"]

 ;; Namespace configuration
 :ns-groups
 [{:pattern "seon\\..*"
   :name seon}]

 ;; Analysis exports (useful for tooling integration)
 :analysis
 {:arglists true
  :locals true
  :keywords true
  :protocol-impls true
  :instance-invocations true}}
