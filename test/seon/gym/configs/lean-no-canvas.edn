;; Gym-local seon.config manifest — the lean A/B arm. A `:seon.gym/config`
;; `{:seon.gym.config/path "test/seon/gym/configs/lean-no-canvas.edn"}`
;; points SEON_CONFIG here for the run; the REAL seed path
;; (`agent/create!` → `ctx/seed-default-ctx!` → `config/resolve-agent-context`)
;; reads it, so gym agents seed FROM this agent-context.
;;
;; Supplies an intentionally small explicit block tree for config A/B runs.
;; It exercises the real manifest -> database seed path without relying on
;; hidden defaults or injecting skill bodies into agent context.
{:seon.config/agent-context
 {:seon.agent/ctx
  [{:seon.agent.ctx/name :namespaces :seon.agent.ctx/priority 20
    :seon.render/ai seon.agent.ctx.namespaces/namespaces-block}
   {:seon.agent.ctx/name :transcript :seon.agent.ctx/priority 100
    :seon.render/ai seon.agent.ctx.transcript/transcript-block
    :seon.render/html seon.agent.ctx.transcript/transcript-block-html}]}}
