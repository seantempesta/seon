;; S-01 (catalog §4) — stub pipeline smoke: message → run → turn → idle.
;; Proves the harness itself with ZERO spend, through the REAL agentic
;; loop (:scripted-replay llm injection): one scripted turn replies and
;; PARKS via `(wait …)`, which closes the run :waited so the loop stops
;; (the run-model loop runs until a bound or a verb closes the run — there
;; is no zero-forms halt; a scripted-replay script must close its own run).
;;
;; NOTE: the catalog's "expected RED until §7 item 4" applies to the
;; POD's built-in stub llm (which always emits forms and burns to the
;; turn-limit). This scenario uses the gym's replay llm-fn through the
;; same run-loop!, so it pins the TARGET pipeline behavior (message lands
;; fully formed → run opens → done turn → idle) without reproducing the
;; pod-stub bug.
{:seon.gym.scenario/id     :s01-stub-pipeline-smoke
 :seon.gym.scenario/doc    "Pipeline smoke: a user 'ping' lands as a fully-formed message (from user, hops 0, non-blank), opens a run, the run's turn closes :done, and the agent parks :idle. Catalog S-01."
 :seon.gym.scenario/tier   :stub
 :seon.gym.scenario/status :active
 :seon.gym.scenario/competency :planning
 :seon.gym.scenario/llm    :scripted-replay
 :seon.gym.scenario/axes   [:sees-question :terminates]
 :seon.gym.scenario/turns
 [{:seon.gym.turn/message "ping"
   :seon.gym.turn/llm-script
   ["(message/user \"pong\")\n(wait \"replied — parking\")\n"]}]
 :seon.gym.scenario/predicates
 [{:seon.gym.predicate/id     :message-row-landed-fully-formed
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :sees-question
   :seon.gym.predicate/query  [:find ?m
                               :where
                               [?m :seon.agent.message/content "ping"]
                               [?m :seon.agent.message/hops 0]
                               [?m :seon.agent.message/from ?u]
                               [?u :seon.user/id "user"]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id     :agent-woke-on-the-message-and-finished
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :sees-question
   ;; The run model links a turn to its run via :seon.agent.turn/run, and a
   ;; message-triggered run carries the waking message on
   ;; :seon.agent.run/cause (the bootstrap run has no cause). "Woke and
   ;; finished" = a turn of a caused run closed :done — excludes bootstrap
   ;; turn 0.
   :seon.gym.predicate/query  [:find ?t
                               :where
                               [?r :seon.agent.run/cause _]
                               [?t :seon.agent.turn/run ?r]
                               [?t :seon.agent.turn/status :done]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id     :bounded-run-driven-turns
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   ;; One productive turn (message/user + wait), then the run is closed by
   ;; the verb. Bounds the loop well below the 20-turn turn-limit without
   ;; pinning the exact count.
   :seon.gym.predicate/query  [:find ?t
                               :where
                               [?r :seon.agent.run/cause _]
                               [?t :seon.agent.turn/run ?r]]
   :seon.gym.predicate/expect [:count<= 5]}
  {:seon.gym.predicate/id     :agent-ends-idle
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   ;; State is DERIVED, not stored: idle ⇔ no open run. The caused run was
   ;; closed by the `(wait …)` verb (status :closed, reason :waited), which
   ;; retracts the agent's :seon.agent/run pointer → derived :idle.
   :seon.gym.predicate/query  [:find ?r
                               :where
                               [?r :seon.agent.run/cause _]
                               [?r :seon.agent.run/status :closed]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id   :reply-reached-the-transcript
   :seon.gym.predicate/kind :transcript-includes
   :seon.gym.predicate/axis :sees-question
   :seon.gym.predicate/text "pong"}]}
