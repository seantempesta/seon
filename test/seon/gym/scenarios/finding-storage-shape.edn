;; Regression: pins the taught knowledge-storage pipeline (V3-B my.kb
;; design, superseding run 7's generic :kb.finding/* shape) — design a
;; my.kb.<domain> schema (multi-segment namespace, NOT a bare
;; :finding/* fork), reference the SHARED :my.kb/* provenance attrs
;; (core-registered — never re-invented per domain), store with
;; full provenance, reply AFTER the store. Runs end-to-end through the
;; real eval pipeline (register! tee → transact → message/user), so a
;; context/teaching change that breaks the convention shows up as a
;; failed predicate, not a burned live run.
{:seon.gym.scenario/id     :finding-storage-shape
 :seon.gym.scenario/doc    "An agent following the taught my.kb convention must produce a my.kb.<domain> row with FULL provenance (domain claim + the shared :my.kb/source-path|source-line|confidence attrs), in the multi-segment namespace, and confirm to the user only after the store. Pipeline regression (was the run-7 :kb.finding shape)."
 :seon.gym.scenario/tier   :stub
 :seon.gym.scenario/status :active
 :seon.gym.scenario/competency :db-memory
 :seon.gym.scenario/axes   [:stores-proactively :reuses-schemas
                            :replies-honestly :terminates]
 :seon.gym.scenario/turns
 [{:seon.gym.turn/message "How does seon validate schemas at transact time? Store what you find so the next agent doesn't have to redo this."
   :seon.gym.turn/llm-script
   [";; design the domain schema FIRST — multi-segment namespace; the\n;; shared :my.kb/* provenance attrs are already registered\n(seon.schema/register! :my.kb.codebase.fn/name [:string {:seon.db/identity true}])\n(seon.schema/register! :my.kb.codebase.fn/claim :string)\n"
    ";; store the fact with full provenance (shared :my.kb/* attrs)\n(seon.db/transact! {:seon.db/tx-data [{:my.kb.codebase.fn/name \"seon.db/transact!\" :my.kb.codebase.fn/claim \"transact! Malli-validates every entity before the tx reaches datahike\" :my.kb/source-path \"src/seon/db.cljs\" :my.kb/source-line 630 :my.kb/confidence :verified}]})\n"
    ";; reply AFTER the verified store\n(message/user \"Stored 1 finding with provenance (src/seon/db.cljs:630): transact! Malli-validates every entity before the tx reaches datahike.\")\n"]}]
 :seon.gym.scenario/predicates
 [{:seon.gym.predicate/id     :knowledge-row-with-full-provenance
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :stores-proactively
   :seon.gym.predicate/query  [:find ?claim ?path ?line ?conf
                               :where
                               [?f :my.kb.codebase.fn/claim ?claim]
                               [?f :my.kb/source-path ?path]
                               [?f :my.kb/source-line ?line]
                               [?f :my.kb/confidence ?conf]]
   :seon.gym.predicate/expect [:count 1]}
  {:seon.gym.predicate/id     :no-single-segment-namespace-fork
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :reuses-schemas
   :seon.gym.predicate/query  [:find ?f :where [?f :finding/claim ?c]]
   :seon.gym.predicate/expect :empty}
  {:seon.gym.predicate/id   :reply-confirms-after-store
   :seon.gym.predicate/kind :transcript-includes
   :seon.gym.predicate/axis :replies-honestly
   :seon.gym.predicate/text "Stored 1 finding with provenance"}
  {:seon.gym.predicate/id     :turn-closes-done
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   :seon.gym.predicate/query  [:find ?t :where [?t :seon.agent.turn/status :done]]
   :seon.gym.predicate/expect :non-empty}]}
