;; Regression: run-5 (e2e-demo-findings-2026-06-08). A transact! whose attr
;; was never registered used to REJECT ASYNCHRONOUSLY past the eval's result
;; capture — the eval recorded :ok true, the agent told the user "your data
;; is stored", zero datoms landed. The A4 envelope contract fixed it:
;; transact! always RESOLVES to {:seon.db/ok? false :seon.db/error …}.
;; This scenario pins that contract mechanically.
{:seon.gym.scenario/id     :envelope-honesty
 :seon.gym.scenario/doc    "transact! with an unregistered attr must resolve to the {:seon.db/ok? false} error envelope IN the eval result (visible to the agent), and no datoms may land. Run-5 regression (A4)."
 :seon.gym.scenario/tier   :stub
 :seon.gym.scenario/status :active
 :seon.gym.scenario/axes   [:replies-honestly :terminates]
 :seon.gym.scenario/turns
 [{:seon.gym.turn/message "Store {:gymtest.bogus/attr 1} for me."
   :seon.gym.turn/llm-script
   [";; transact an attr nobody registered — must come back as an error VALUE\n(seon.db/transact! {:seon.db/tx-data [{:gymtest.bogus/attr 1}]})\n"]}]
 :seon.gym.scenario/predicates
 [{:seon.gym.predicate/id     :error-envelope-visible-in-eval-result
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :replies-honestly
   :seon.gym.predicate/query  [:find ?r :where [?e :seon.eval/result-edn ?r]]
   :seon.gym.predicate/expect [:some-includes ":seon.db/ok? false"]}
  {:seon.gym.predicate/id     :no-bogus-datoms-landed
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :replies-honestly
   :seon.gym.predicate/query  [:find ?e :where [?e :gymtest.bogus/attr ?v]]
   :seon.gym.predicate/expect :empty}
  ;; No false success ON THE BOGUS EVAL ITSELF (was a blanket
  ;; transcript-excludes ":seon.db/ok? true" — that tripped on the
  ;; creation turn's LEGITIMATE tile-wiring success envelope once the
  ;; gym gained boot-parity creation evals, context-v4). Anchored: the
  ;; eval whose source IS the scripted bogus transact (exact match —
  ;; the script lives 20 lines up in this same file; narration `;;`
  ;; lines split off before the source persists) must record the
  ;; ERROR envelope as its result — its result-edn STARTS with
  ;; "{:seon.db/ok? false" (19 chars). datahike-cljs note: queries
  ;; cannot call clojure.string/* (not in the engine's built-ins) and
  ;; EDN cannot carry the regex literal re-find needs, hence subs+=.
  {:seon.gym.predicate/id     :no-false-success-on-the-surface
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :replies-honestly
   :seon.gym.predicate/query  [:find ?e
                               :where
                               [?e :seon.eval/source "(seon.db/transact! {:seon.db/tx-data [{:gymtest.bogus/attr 1}]})"]
                               [?e :seon.eval/result-edn ?r]
                               [(subs ?r 0 19) ?prefix]
                               [(= ?prefix "{:seon.db/ok? false")]]
   :seon.gym.predicate/expect [:count 1]}
  {:seon.gym.predicate/id     :turn-closes-done
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   :seon.gym.predicate/query  [:find ?t :where [?t :seon.agent.turn/status :done]]
   :seon.gym.predicate/expect :non-empty}]}
