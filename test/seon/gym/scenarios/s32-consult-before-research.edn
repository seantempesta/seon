;; S-32 (catalog §4) — consult-before-research, ISOLATED (the salience
;; probe). Fixtures seed run-7's validation findings (migrated to the
;; V3-B my.kb shape: a my.kb.codebase domain referencing the shared
;; :my.kb/* provenance attrs) PLUS one finding whose
;; :my.kb.codebase/question is near-verbatim the user question — the
;; stored knowledge answers the question COMPLETELY, so consulting is
;; strictly cheaper than researching. The run-7 failure signature this
;; catches: re-deriving a stored answer (≥2 repo searches) even when
;; the final reply is right.
;;
;; DEEPSEEK TIER (cheap: one agent, one message) — costs real money.
;; Refuses without {:seon.gym/allow-paid? true} + DEEPSEEK_API_KEY.
{:seon.gym.scenario/id     :s32-consult-before-research
 :seon.gym.scenario/doc    "A stored finding answers the question verbatim. Pass = first eval queries my.kb.*/my.* attrs and AT MOST ONE repo-search eval happens (re-derivation = fail even with a right answer). Judge grades the reply against the seeded envelope facts."
 :seon.gym.scenario/tier   :deepseek
 :seon.gym.scenario/status :active
 :seon.gym.scenario/axes   [:consults-findings :searches-first
                            :replies-honestly :terminates]
 :seon.gym.scenario/schema-registrations
 [[:my.kb.codebase/claim :string]
  [:my.kb.codebase/question :string]]
 ;; F-findings-validation (run-7 output verbatim) + the #26 envelope
 ;; finding that answers THIS scenario's question completely.
 :seon.gym.scenario/fixtures
 [{:my.kb.codebase/claim   "validate-attrs! rejects any tx whose attr is not registered in seon.schema before the tx reaches datahike"
   :my.kb/source-path      "src/seon/db.cljs"
   :my.kb/source-line      630
   :my.kb/confidence       :verified
   :my.kb.codebase/question "How does seon validate schemas at transact time?"}
  {:my.kb.codebase/claim   "validate-entity-values! Malli-validates every entity value against the registered attr schema"
   :my.kb/source-path      "src/seon/db.cljs"
   :my.kb/source-line      694
   :my.kb/confidence       :verified
   :my.kb.codebase/question "How does seon validate schemas at transact time?"}
  {:my.kb.codebase/claim   "the transact pipeline runs attr-registration checks then value validation then the datahike write — every failure resolves to the error envelope, nothing throws past the boundary"
   :my.kb/source-path      "src/seon/db.cljs"
   :my.kb/confidence       :inferred
   :my.kb.codebase/question "How does seon validate schemas at transact time?"}
  {:my.kb.codebase/claim   "seon.agent/message! and reply! return a concise envelope — {:seon.agent.message/ok? true, :seon.agent.message/id ..., :seon.agent.message/hops ...} on success, {:seon.db/ok? false :seon.db/error ...} on failure — never the raw tx-report"
   :my.kb/source-path      "src/seon/agent.cljs"
   :my.kb/source-line      712
   :my.kb/confidence       :verified
   :my.kb.codebase/question "What does seon.agent/message! return — the full transact report or something smaller?"}]
 :seon.gym.scenario/turns
 [{:seon.gym.turn/message "What does seon.agent/message! return — the full transact report or something smaller?"}]
 :seon.gym.scenario/predicates
 ;; Anchored on the keyword colon: a consult means the eval actually
 ;; touches a :my.* DOMAIN attr (e.g. :my.kb/confidence,
 ;; :my.kb.codebase/claim). The old unanchored "my\\." substring also
 ;; matched the agent's own my.agent.<id> home-ns symbol (in-ns noise),
 ;; so a first eval that merely mentioned its own namespace scored as
 ;; consulting.
 [{:seon.gym.predicate/id      :first-eval-consults-stored-findings
   :seon.gym.predicate/kind    :first-eval-matches
   :seon.gym.predicate/axis    :consults-findings
   :seon.gym.predicate/pattern ":my\\."}
  ;; #26 salience axis, split honest (gym-upgrade U1): "the seeded
  ;; claim TEXT rendered in the prompt the agent acted on" (context
  ;; worked) scores SEPARATELY from "the first eval consulted it"
  ;; (agent behaved) — so "context failed" vs "agent ignored context"
  ;; are distinct failure signatures. The text is a fragment unique to
  ;; the seeded #26 envelope claim (verified absent from src/ — it can
  ;; only reach a prompt via the fixture row rendering). EXPECTED-RED
  ;; until a context rung renders finding CLAIM TEXT (not just attr
  ;; names) into the prompt — red-first is the gym pinning target
  ;; behavior, per the gym-upgrade PRD §4.
  {:seon.gym.predicate/id   :seeded-claim-rendered-in-prompt
   :seon.gym.predicate/kind :prompt-includes
   :seon.gym.predicate/axis :consults-findings
   :seon.gym.predicate/text "never the raw tx-report"}
  ;; searches-first INVERTED here: the answer is stored, so more than
  ;; one repo search = the run-7 re-derivation signature.
  ;; Toolbelt renamed seon.search/seon.fs → seon.agent.search/seon.agent.fs
  ;; in 06de140 (batch-2 reorg) — the old pattern matched nothing, making
  ;; this predicate vacuously green.
  {:seon.gym.predicate/id      :at-most-one-repo-search
   :seon.gym.predicate/kind    :eval-count-matching
   :seon.gym.predicate/axis    :searches-first
   :seon.gym.predicate/pattern "seon\\.agent\\.search/grep|seon\\.agent\\.fs/read-file"
   :seon.gym.predicate/expect  [:count<= 1]}
  ;; from-agent + hops>0, not the user-entity join (datahike-cljs
  ;; double-identity-join mis-binding — pinned in driver_test).
  {:seon.gym.predicate/id     :agent-replied-to-the-user
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :replies-honestly
   :seon.gym.predicate/query  [:find ?m
                               :where
                               [?m :seon.agent.message/from ?a]
                               [?a :seon.agent/id ?aid]
                               [?m :seon.agent.message/hops ?h]
                               [(pos? ?h)]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id     :agent-ends-idle
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   :seon.gym.predicate/query  [:find ?a
                               :where
                               [?a :seon.agent/state :idle]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id        :judge-answer-states-the-concise-envelope
   :seon.gym.predicate/kind      :llm-judge
   :seon.gym.predicate/axis      :replies-honestly
   :seon.gym.predicate/rubric    "PASS only if the reply states that message! returns a CONCISE envelope, NOT the full transact report: on success a map with :seon.agent.message/ok? true plus :seon.agent.message/id and :seon.agent.message/hops; on failure the standard error envelope {:seon.db/ok? false :seon.db/error ...}. Bonus (not required for pass): the reply attributes the answer to stored knowledge ('a stored finding says...') or cites src/seon/agent.cljs. FAIL if the reply claims the full tx-report/tx-data is returned, invents other keys as the primary shape, or says it throws."
   :seon.gym.predicate/reference "Ground truth (the seeded finding, verbatim): 'seon.agent/message! and reply! return a concise envelope — {:seon.agent.message/ok? true, :seon.agent.message/id ..., :seon.agent.message/hops ...} on success, {:seon.db/ok? false :seon.db/error ...} on failure — never the raw tx-report'. Source: src/seon/agent.cljs."}]}
