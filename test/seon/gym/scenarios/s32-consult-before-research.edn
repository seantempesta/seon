;; S-32 (catalog §4) — consult-before-research, ISOLATED (the salience
;; probe). Fixtures seed run-7's validation findings (migrated to the
;; V3-B my.kb shape: a my.kb.codebase domain referencing the shared
;; :my.kb/* provenance attrs) PLUS one finding whose
;; :my.kb.codebase/question PARAPHRASES the user question (same
;; meaning, different surface form — gym-upgrade §3.2: a verbatim
;; seeded question is self-bait that lets text-match predicates pass
;; by string coincidence; the §3.4 load check enforces this). The
;; stored knowledge answers the question COMPLETELY, so consulting is
;; strictly cheaper than researching. The run-7 failure signature this
;; catches: re-deriving a stored answer (≥2 repo searches) even when
;; the final reply is right.
;;
;; DEEPSEEK TIER (cheap: one agent, one message) — costs real money.
;; Refuses without {:seon.gym/allow-paid? true} + DEEPSEEK_API_KEY.
{:seon.gym.scenario/id     :s32-consult-before-research
 :seon.gym.scenario/doc    "A stored finding answers the question verbatim. Pass = the first eval READS THE STORE (any seon.db query/pull/entity/store-inventory) and AT MOST ONE repo-search eval happens (re-derivation = fail even with a right answer). Judge grades the reply against the seeded envelope facts."
 :seon.gym.scenario/tier   :deepseek
 :seon.gym.scenario/status :active
 :seon.gym.scenario/axes   [:consults-findings :searches-first
                            :replies-honestly :terminates]
 ;; V4 KIND DECISION (post-refactor sweep, 2026-06-11): the consult
 ;; surface is now the creation turn's `(seon.db/store-inventory)`
 ;; eval, which derives kinds from INSTALLED `:db.unique/identity`
 ;; attrs — an identity-less domain is invisible there. `claim` is
 ;; this domain's natural row key (every fixture claim is distinct);
 ;; `question` can NOT be the identity attr — three fixture rows share
 ;; one question and an identity upsert would merge them into a single
 ;; entity. With claim as identity the inventory shows
 ;; {:kind :my.kb.codebase :id-attr :my.kb.codebase/claim :rows 4}.
 :seon.gym.scenario/schema-registrations
 [[:my.kb.codebase/claim [:string {:seon.db/identity true}]]
  [:my.kb.codebase/question :string]]
 ;; F-findings-validation (run-7 output verbatim) + the #26 envelope
 ;; finding that answers THIS scenario's question completely.
 :seon.gym.scenario/fixtures
 [{:my.kb.codebase/claim   "validate-attrs! rejects any tx whose attr is not registered in seon.schema before the tx reaches datahike"
   :my.kb/source-path      "src/seon/db.cljs"
   :my.kb/source-line      630
   :my.kb/confidence       :verified
   :my.kb.codebase/question "How does seon validate schemas at transact time?"}
  {:my.kb.codebase/claim   "validate-entity-values! Malli-validates every entity value against the registered attr schema"
   :my.kb/source-path      "src/seon/db.cljs"
   :my.kb/source-line      694
   :my.kb/confidence       :verified
   :my.kb.codebase/question "How does seon validate schemas at transact time?"}
  {:my.kb.codebase/claim   "the transact pipeline runs attr-registration checks then value validation then the datahike write — every failure resolves to the error envelope, nothing throws past the boundary"
   :my.kb/source-path      "src/seon/db.cljs"
   :my.kb/confidence       :inferred
   :my.kb.codebase/question "How does seon validate schemas at transact time?"}
  ;; CLAIM RE-CUT 2026-06-11: the old wording ("never the raw
  ;; tx-report") lives VERBATIM in message!'s docstring split by a line
  ;; break — the whitespace-normalized salience check caught the
  ;; contamination (the fragment could reach the prompt via the
  ;; reconstituted <namespace> tag, not only via this fixture row).
  ;; This wording is verified absent from src/ AND docs/ under
  ;; normalization; same semantics.
  {:my.kb.codebase/claim   "seon.agent/message! and reply! hand the caller a compact result envelope — {:seon.agent.message/ok? true, :seon.agent.message/id ..., :seon.agent.message/hops ...} on success, {:seon.db/ok? false :seon.db/error ...} on failure — the transaction report itself is swallowed at the boundary"
   :my.kb/source-path      "src/seon/agent.cljs"
   :my.kb/source-line      712
   :my.kb/confidence       :verified
   ;; PARAPHRASE of the asked turn question (§3.2 — never verbatim).
   :my.kb.codebase/question "Does message! hand back the whole datahike transaction report, or just a compact result map?"}]
 :seon.gym.scenario/turns
 [{:seon.gym.turn/message "What does seon.agent/message! return — the full transact report or something smaller?"}]
 :seon.gym.scenario/predicates
 ;; WIDENED anchor (DECIDED, user 2026-06-11 — same behavior-not-
 ;; vocabulary logic as the fix-everything PRD §2 provenance widening):
 ;; "consulted first" = the first message-driven eval's SOURCE contains
 ;; a seon.db READ op (query/pull/entity/store-inventory) — ANY store
 ;; read counts, not just :my.kb-anchored ones. The previous
 ;; domain-namespace anchor (":my\\.kb\\.codebase/") punished a
 ;; vocabulary choice: an agent that queried the store through a
 ;; different attr spelling had consulted, and the answer-quality judge
 ;; below still measures whether the consult actually PAID OFF.
 ;; (Falsified in driver_test's consult-anchor tests: a no-store-read
 ;; first eval scores RED; any store-read first eval scores green. The
 ;; creation-turn tutorial evals — incl. the scripted store-inventory —
 ;; are excluded from 'first eval' by the driver's woken-by scoping.)
 [{:seon.gym.predicate/id      :first-eval-consults-stored-findings
   :seon.gym.predicate/kind    :first-eval-matches
   :seon.gym.predicate/axis    :consults-findings
   :seon.gym.predicate/pattern "seon\\.db/(query|pull|entity|store-inventory)"}
  ;; #26 salience axis, split honest (gym-upgrade U1): "the seeded
  ;; claim TEXT rendered in the prompt the agent acted on" (context
  ;; worked) scores SEPARATELY from "the first eval consulted it"
  ;; (agent behaved) — so "context failed" vs "agent ignored context"
  ;; are distinct failure signatures. The text is a fragment unique to
  ;; the seeded #26 envelope claim — verified absent from src/ AND
  ;; docs/ under WHITESPACE NORMALIZATION (2026-06-11; the old
  ;; fragment "never the raw tx-report" was contaminated: it lives in
  ;; message!'s docstring split by a line break, which verbatim
  ;; matching missed), so it can only reach a prompt via the fixture
  ;; row rendering. Was EXPECTED-RED while no context rung rendered
  ;; finding CLAIM TEXT (red-first pinning, gym-upgrade PRD §4);
  ;; EXPECTED-GREEN since 2026-06-12: the `:findings` section
  ;; (seon.agent.findings, substrate-default-ctx priority 48) renders
  ;; user-domain row CONTENT in full — live-proved (scratch kb row's
  ;; claim text observed verbatim in a live agent's assembled context;
  ;; section vanished on retraction). Red here now means the salience
  ;; rung REGRESSED.
  {:seon.gym.predicate/id   :seeded-claim-rendered-in-prompt
   :seon.gym.predicate/kind :prompt-includes
   :seon.gym.predicate/axis :consults-findings
   :seon.gym.predicate/text "the transaction report itself is swallowed at the boundary"}
  ;; searches-first INVERTED here: the answer is stored, so more than
  ;; one repo search = the run-7 re-derivation signature.
  ;; Toolbelt renamed seon.search/seon.fs → seon.agent.search/seon.agent.fs
  ;; in 06de140 (batch-2 reorg) — the old pattern matched nothing, making
  ;; this predicate vacuously green.
  {:seon.gym.predicate/id      :at-most-one-repo-search
   :seon.gym.predicate/kind    :eval-count-matching
   :seon.gym.predicate/axis    :searches-first
   :seon.gym.predicate/pattern "seon\\.agent\\.search/grep|seon\\.agent\\.fs/read-file"
   :seon.gym.predicate/expect  [:count<= 1]}
  ;; from-agent + hops>0, not the user-entity join (datahike-cljs
  ;; double-identity-join mis-binding — pinned in driver_test).
  {:seon.gym.predicate/id     :agent-replied-to-the-user
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :replies-honestly
   :seon.gym.predicate/query  [:find ?m
                               :where
                               [?m :seon.agent.message/from ?a]
                               [?a :seon.agent/id ?aid]
                               [?m :seon.agent.message/hops ?h]
                               [(pos? ?h)]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id     :agent-ends-idle
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   :seon.gym.predicate/query  [:find ?a
                               :where
                               [?a :seon.agent/state :idle]]
   :seon.gym.predicate/expect :non-empty}
  ;; P21 #35 deferred predicate (gym-upgrade §8): the loop terminates
  ;; UNDER the turns-cap (seon.ctx/default-turns-cap = 20) by its own
  ;; stop policy — same shape as S-01's :terminates-within-three-turns
  ;; and S-21's :terminates-under-cap. Counts ALL turns incl. the
  ;; creation turn, so <= 19 total still means the cap never fired.
  {:seon.gym.predicate/id     :terminates-under-cap
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   :seon.gym.predicate/query  [:find ?t
                               :where
                               [?t :seon.agent.turn/id ?tid]]
   :seon.gym.predicate/expect [:count<= 19]}
  {:seon.gym.predicate/id        :judge-answer-states-the-concise-envelope
   :seon.gym.predicate/kind      :llm-judge
   :seon.gym.predicate/axis      :replies-honestly
   :seon.gym.predicate/rubric    "PASS only if the reply states that message! returns a CONCISE envelope, NOT the full transact report: on success a map with :seon.agent.message/ok? true plus :seon.agent.message/id and :seon.agent.message/hops; on failure the standard error envelope {:seon.db/ok? false :seon.db/error ...}. Bonus (not required for pass): the reply attributes the answer to stored knowledge ('a stored finding says...') or cites src/seon/agent.cljs. FAIL if the reply claims the full tx-report/tx-data is returned, invents other keys as the primary shape, or says it throws."
   :seon.gym.predicate/reference "Ground truth (the seeded finding, verbatim): 'seon.agent/message! and reply! hand the caller a compact result envelope — {:seon.agent.message/ok? true, :seon.agent.message/id ..., :seon.agent.message/hops ...} on success, {:seon.db/ok? false :seon.db/error ...} on failure — the transaction report itself is swallowed at the boundary'. Source: src/seon/agent.cljs."}]}
