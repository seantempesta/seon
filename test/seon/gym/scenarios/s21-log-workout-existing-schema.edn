;; S-21 (catalog §4) — log a workout against the EXISTING schema, no
;; fork. Fixtures register exactly the LIVE store's :seon.workout/*
;; shape (date is a STRING — the live row stores "2026-06-10" as a
;; string; duration-minutes is an INT) plus the real strength/45min row
;; dated {{today}} — i.e. the world the demo store is actually in. The
;; run-4 regression this pins: a `duration-minutes` vs
;; `duration-seconds` style attr fork, or any re-register! when the
;; schema already covers the message.
;;
;; DEEPSEEK TIER (cheap) — refuses without allow-paid? + key.
{:seon.gym.scenario/id     :s21-log-workout-existing-schema
 :seon.gym.scenario/doc    "'I ran this morning — 24 minutes.' must land as ONE new row reusing the established :seon.workout/* attrs — zero attr forks, ideally zero register! evals (the schema already covers the message). Fully mechanical; catalog S-21."
 :seon.gym.scenario/tier   :deepseek
 :seon.gym.scenario/status :active
 :seon.gym.scenario/axes   [:reuses-schemas :models-work-directed
                            :terminates :replies-honestly]
 ;; F-workout-schema — the live store's exact shape (catalog §3).
 :seon.gym.scenario/schema-registrations
 [[:seon.workout/date :string]
  [:seon.workout/type :keyword]
  [:seon.workout/duration-minutes :int]
  [:seon.workout/notes :string]]
 ;; The live store's real row (strength/45min/today).
 :seon.gym.scenario/fixtures
 [{:seon.workout/date "{{today}}"
   :seon.workout/type :strength
   :seon.workout/duration-minutes 45}]
 :seon.gym.scenario/turns
 [{:seon.gym.turn/message "I ran this morning — 24 minutes, felt good. Log it with my other workouts."}]
 :seon.gym.scenario/predicates
 [{:seon.gym.predicate/id     :run-row-landed-with-established-attrs
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :reuses-schemas
   :seon.gym.predicate/query  [:find ?e
                               :where
                               [?e :seon.workout/type :run]
                               [?e :seon.workout/duration-minutes 24]]
   :seon.gym.predicate/expect [:count 1]}
  ;; The run-4 fork predicate, permanent — GENERIC since 2026-06-10:
  ;; the old version only inspected the seon.workout namespace, so a
  ;; fork into ANY OTHER namespace (:workout/*, :fitness.workout/*, …)
  ;; passed vacuously. :domain-attrs rows are EVERY agent-provenance
  ;; attr on the post-run store (seon.warn/domain-attrs), so every
  ;; attr the agent register!ed anywhere must be one of the four
  ;; seeded :seon.workout/* names — zero forks, in any namespace.
  {:seon.gym.predicate/id     :no-attr-fork-anywhere
   :seon.gym.predicate/kind   :domain-attrs
   :seon.gym.predicate/axis   :reuses-schemas
   :seon.gym.predicate/expect [:every-in [":seon.workout/date"
                                          ":seon.workout/type"
                                          ":seon.workout/duration-minutes"
                                          ":seon.workout/notes"]]}
  ;; …and the vacuity guard for the predicate above: the seeded reuse
  ;; surface must actually be VISIBLE as domain attrs (the fixture row
  ;; installs date/type/duration-minutes; an empty domain-attrs list
  ;; means the world seeding or the provenance rule regressed — the
  ;; S-21 production bug that hid :seon.workout/* from every catalog).
  {:seon.gym.predicate/id     :seeded-attrs-visible-as-domain-attrs
   :seon.gym.predicate/kind   :domain-attrs
   :seon.gym.predicate/axis   :reuses-schemas
   :seon.gym.predicate/expect [:count>= 3]}
  ;; The ideal: ZERO register! evals — the schema already covers it.
  {:seon.gym.predicate/id      :zero-schema-registrations-needed
   :seon.gym.predicate/kind    :eval-count-matching
   :seon.gym.predicate/axis    :models-work-directed
   :seon.gym.predicate/pattern "schema/register!"
   :seon.gym.predicate/expect  [:count 0]}
  ;; from-agent + hops>0, not the user-entity join (datahike-cljs
  ;; double-identity-join mis-binding — pinned in driver_test).
  {:seon.gym.predicate/id     :agent-replied-to-the-user
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :replies-honestly
   :seon.gym.predicate/query  [:find ?m
                               :where
                               [?m :seon.agent.message/from ?a]
                               [?a :seon.agent/id ?aid]
                               [?m :seon.agent.message/hops ?h]
                               [(pos? ?h)]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id     :agent-ends-idle
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   :seon.gym.predicate/query  [:find ?a
                               :where
                               [?a :seon.agent/state :idle]]
   :seon.gym.predicate/expect :non-empty}
  {:seon.gym.predicate/id     :terminates-under-cap
   :seon.gym.predicate/kind   :datalog
   :seon.gym.predicate/axis   :terminates
   :seon.gym.predicate/query  [:find ?t
                               :where
                               [?t :seon.agent.turn/id ?tid]]
   :seon.gym.predicate/expect [:count<= 19]}]}
