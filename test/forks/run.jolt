;; Fork test units on Jolt, in one process (bin/check's forks step: bin/forks deals the units into a few such
;; processes): each arg a Datahike test namespace (on the :dhtest alias's path) or a konserve test file's path, run in
;; order. Jolt's konserve backends load first, as seon.db loads them, so a test's {:backend :file} is Jolt's file store.
;; Prints, after each unit ends, one line FORK <unit> <its counts>, the line test/forks/baseline.edn holds, flushed, so a
;; process that dies leaves the lines of the units that ended and bin/forks runs the rest alone.
(require 'clojure.test 'konserve.jolt.store)
(doseq [unit *command-line-args*]
  (let [t0 (System/nanoTime)
        r (if (.endsWith ^String unit ".jolt")
            (do (load-file unit)
                (clojure.test/run-tests (symbol (second (re-find #"\(ns\s+([^\s\)]+)" (slurp unit))))))
            (do (require (symbol unit)) (clojure.test/run-tests (symbol unit))))]
    (println "FORK" unit (pr-str (select-keys r [:test :pass :fail :error])))
    ;; its wall, shown and never judged (bin/forks prints the slowest)
    (println "FORK-MS" unit (quot (- (System/nanoTime) t0) 1000000))
    (flush)))
(System/exit 0)
