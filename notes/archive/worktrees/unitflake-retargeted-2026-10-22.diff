+(defn unit-range
+  "How far measurements ms of one unit stray from its price: per dimension, the least and
+  largest ratio of a measurement to the price, over every size and run. :bytes only for a
+  unit that allocates (a price of 1 B or more: a zero row's ratio means nothing)."
+  {:malli/schema [:=> [:cat [:map [:ns [:double {:min 0.0}]] [:bytes [:double {:min 0.0}]]] [:sequential :seon.cost/dims]]
+                  :seon.cost/range]}
+  [price ms]
+  (into {} (for [d [:ns :bytes]
+                 :let [p (double (get price d 0.0))
+                       rs (for [m ms :let [v (get m d)] :when (some? v)] (/ (double v) p))]
+                 :when (and (>= p 1.0) (seq rs))]
+             [d [(apply min rs) (apply max rs)]])))
+
+(defn table
+  "The unit table measured k times at 1k, 10k and 100k units, as seon.cost/units' literal:
+  each row priced at its median 10k measurement, with :range (`unit-range`) over all of
+  them. Run at the REPL on the release binary and in source mode, and merge the ranges."
+  {:malli/schema [:=> [:cat pos-int?] [:map-of :keyword :seon.cost/unit]]}
+  [k]
+  (into (sorted-map)
+    (for [u (keys unit-benches)
+          :let [runs (vec (for [_ (range k)] (mapv #(measure-unit u %) [1000 10000 100000])))
+                median (fn [xs] (nth (vec (sort xs)) (quot (count xs) 2)))
+                price {:ns (median (map (comp :ns second) runs)) :bytes (median (map (comp :bytes second) runs))}]]
+      [u (assoc price :range (unit-range price (apply concat runs)) :what (:what (unit-benches u)))])))
 
