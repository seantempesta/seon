;; Facts knowledge base schema.
;;
;; Loaded once per session by sidecar-poc.seed-facts. Idempotent — the
;; seeder checks for the presence of :fact/id in the live schema before
;; transacting.
;;
;; Fact shape: a subject/predicate/object triple plus provenance:
;;   - :fact/id          unique identity (string; "subject-predicate-N")
;;   - :fact/subject     keyword (e.g. :seon/project, :seon.agent/turn-loop)
;;   - :fact/predicate   keyword (e.g. :thesis, :uses-library, :location)
;;   - :fact/object      serialized EDN string — pr-str of the value (lets
;;                       us store keywords/vectors/maps without per-shape
;;                       schemas; readers use clojure.edn/read-string)
;;   - :fact/source      citation, typically "<file>:<line>" inside /seon-src
;;   - :fact/recorded-by keyword identifying the agent or seeder
;;   - :fact/recorded-at instant
;;   - :fact/confidence  float 0.0-1.0
;;   - :fact/tags        keyword set
[{:db/ident       :fact/id
  :db/valueType   :db.type/string
  :db/unique      :db.unique/identity
  :db/cardinality :db.cardinality/one}
 {:db/ident       :fact/subject
  :db/valueType   :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/index       true}
 {:db/ident       :fact/predicate
  :db/valueType   :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/index       true}
 {:db/ident       :fact/object
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident       :fact/source
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "Citation: typically <file>:<line> or URL"}
 {:db/ident       :fact/recorded-by
  :db/valueType   :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc         "Agent or process that recorded the fact"}
 {:db/ident       :fact/recorded-at
  :db/valueType   :db.type/instant
  :db/cardinality :db.cardinality/one}
 {:db/ident       :fact/confidence
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "Confidence as integer 0-100 (percent). 100 = canonical/verified."}
 {:db/ident       :fact/tags
  :db/valueType   :db.type/keyword
  :db/cardinality :db.cardinality/many}]
