{;; -----------------------------------------------------------------------
 ;; Datalevin: DISABLED (datahike-migration Phase 3+).
 ;; The legacy Datalevin server crash-loops on startup (event-loop swallows
 ;; exceptions, restarts in a tight loop, hangs the infrastructure flow boot).
 ;; We're migrating to datahike. Until Phase 5 deletes the source code, the
 ;; Integrant keys are simply absent from this config:
 ;;   :seon.db.datalevin/server
 ;;   :seon.db.datalevin/connections
 ;;   :seon/runtime-db
 ;;   :seon.graph/scanner    (depends on runtime-db)
 ;; Code that calls seon.db with a datalevin-only db-name will fail with a
 ;; "Infrastructure flow not running" error rather than time out — the data-
 ;; hike path still works for namespaces declared under :seon.db/flow below.
 ;; -----------------------------------------------------------------------

 ;; Malli Schema Registry
 ;; Loads all domain schemas on startup
 :seon.schema/registry {}

 ;; Schema Consistency Check
 ;; Validates all persisted entity schemas at boot.
 ;; Catches :any, :some, [:maybe X], mixed enums before they reach Datalevin.
 :seon.db.schema/consistency-check
 {:registry #ig/ref :seon.schema/registry}

 ;; nREPL Server - managed by Integrant
 ;; Dev: Enabled - connect to inspect/modify the running system
 ;; Test/Prod: Disabled (headless)
 :seon.dev/nrepl
 {:enabled? #profile {:dev true     ; nREPL for REPL-driven development
                      :test false   ; Tests don't need nREPL
                      :prod false}  ; Production is headless
  :port #or [#env NREPL_PORT 7888]
  :bind "127.0.0.1"}

 ;; HTTP Server for Web UI
 :seon.web.server/http-server
 {:port #or [#env HTTP_PORT 8080]
  :bind "0.0.0.0"}

 ;; Tailwind CSS Watcher
 ;; Dev: Enabled - auto-rebuild CSS on file changes
 ;; Prod: Disabled - CSS pre-built during deployment
 :seon.web/tailwind
 {:enabled? #profile {:dev true
                      :test false
                      :prod false}
  :input "resources/public/css/input.css"
  :output "resources/public/css/output.css"}

 ;; Infrastructure Flow (reply-router + REPL eval + sinks)
 ;; Datalevin writer/reader are skipped when no connection-manager is provided
 ;; (datalevin is disabled). The flow still hosts the REPL eval process and
 ;; reply-router, which other flows depend on.
 :seon.flow/infrastructure
 {}

 ;; Agent JVM Pool
 ;; Pre-warmed JVM pool for instant agent startup.
 ;; Each agent gets an isolated JVM with its own nREPL and Malli registry.
 ;; Datalevin reference removed; agents no longer auto-connect to a
 ;; Datalevin server. Cross-JVM data access goes through the flow harness
 ;; (Phase 3 work).
 :seon.flow/pool
 {:size #or [#env AGENT_POOL_SIZE 3]
  :base-port #or [#env AGENT_BASE_PORT 7900]
  :enabled? #profile {:dev true
                      :test false   ; Unit tests mock pool structure
                      :prod true}}

 ;; Orchestrator Sessions
 ;; Initializes orchestrator session storage. Datalevin connection-manager
 ;; reference removed; the init! fn already ignores it (was kept for
 ;; backward compatibility).
 :seon.orchestrator/sessions
 {:pool #ig/ref :seon.flow/pool}

 ;; Caddy Reverse Proxy (HTTP/2 + TLS)
 ;; Dev: Enabled - serves https://localhost:3030 -> http://localhost:8080
 ;; Depends on HTTP server so Caddy starts after upstream is ready.
 :seon.web/caddy
 {:enabled? #profile {:dev true
                      :test false
                      :prod false}
  :config-file "Caddyfile"
  :http-server #ig/ref :seon.web.server/http-server}

 ;; Malli Function Instrumentation
 ;; Instruments all functions with :malli/schema for runtime validation.
 ;; Agent-friendly error messages on schema violations.
 :seon.dev/instrumentation {}

 ;; Claude Code SDK Configuration
 :seon.ai.claude/sdk
 {:cli-path #or [#env CLAUDE_CLI_PATH "/Users/sean/.local/bin/claude"]}

 ;; Datahike Flow (Phase 2 of datahike-migration)
 ;; Single Integrant key that owns every per-namespace datahike conn-process
 ;; and the tx-bus. `seon.db` routes ops for registered namespaces through
 ;; this flow via `seon.db.datahike.flow/request!`.
 ;;
 ;; Phase 2 carries a single fixture namespace (:seon.phase2.demo) so the
 ;; dispatch layer has something real to route to. New domain namespaces
 ;; are added here as they migrate.
 :seon.db/flow
 {:namespaces [:seon.phase2.demo]
  :backend #profile {:dev :memory
                     :test :memory
                     :prod :memory}
  :namespace-schemas {:seon.phase2.demo [:map
                                         [:seon.phase2.demo/id :seon.phase2.demo/id]
                                         [:seon.phase2.demo/name :seon.phase2.demo/name]]}}}
