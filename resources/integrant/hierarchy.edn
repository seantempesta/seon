 :seon.web/tailwind              [:seon/component]
 :seon.web/caddy                 [:seon/component]
 :seon.db/flow                   [:seon/component]
 :seon.flow/infrastructure        [:seon/component]
 :seon.flow/pool                 [:seon/component]
 :seon.orchestrator/sessions     [:seon/component]
 :seon.graph/scanner             [:seon/component]
 :seon.dev/instrumentation        [:seon/component]
 :seon.ai.claude/sdk             [:seon/component]}
