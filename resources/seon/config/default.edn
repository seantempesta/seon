;; Seon system default configuration (read once at cold bootstrap via `aero.core/read-config`
;; and stored directly as attributes on `{:config/key :system/root}` in Datahike `:main`).
;; Any `:agent/id` entity can override any `:config/*` attribute on itself; `seon.store/config-val`
;; resolves `(or (agent-attr) (root-attr))` in a single ~20 µs indexed pull!
{;; --- Runtime, Fork & Eval Budgets ---
 :config/eval-ticks        #long #or [#env SEON_EVAL_TICKS 100000000]
 :config/eval-bytes        #long #or [#env SEON_EVAL_BYTES 268435456]
 :config/gen-samples       #long #or [#env SEON_GEN_SAMPLES 100]
 :config/gen-seed          #long 42
 :config/max-os-procs      #long #or [#env SEON_MAX_OS_PROCS 6]
 :config/max-test-workers  #long #or [#env SEON_MAX_TEST_WORKERS 4]
 :config/max-model-slots   #long #or [#env SEON_MAX_MODEL_SLOTS 4]
 :config/child-cache-mb    #long 4
 :config/gc-generations    #long 6
 :config/auto-sync-git?    #boolean #or [#env SEON_AUTO_SYNC_GIT true]
 :config/ai-model          #or [#env SEON_AI_MODEL "deepseek-chat"]

 ;; --- Build toolchain keys read directly by `bin/env` and `bin/build` ---
 :seon.config.build/jolt-compiler-options "{:image-fn-forms false :no-inline-ns-prefixes [seon my]}"
 :seon.config.build/jolt-cache-mb 32768
 :seon.config.build/jolt-whole-program-inference false
 :seon.config.source/tree-excludes ["claude_scratch" "runs" "target"]}
