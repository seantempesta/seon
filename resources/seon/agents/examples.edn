 {:seon.agent/id :example/recursive-fanout,
  :seon.agent/scope seon.render,
  :seon.agent/branch :main,
  :seon.agent/role :worker,
  :seon.agent/goal "Receive a structured call, delegate sub-questions to child specialists in parallel via ask!/await!, and answer the parent call with the synthesized result.",
  :seon.agent/paused? true,
  :seon.agent/waiting? true,
  :evals [{:seon.agent.eval/call-index 0,
           :seon.agent.eval/call-id "ex-rec-1",
           :seon.agent.eval/thought "To answer this call accurately I will ask two child specialists in parallel and await both before settling my incoming call.",
           :seon.agent.eval/turn 1,
           :seon.agent.eval/value "{:ok? true, :settled? false, :awaiting [#uuid \"00000000-0000-0000-0000-000000000003\" #uuid \"00000000-0000-0000-0000-000000000004\"]}",
           :seon.agent.eval/intent "Delegate sub-questions to child specialists and await both",
           :seon.agent.eval/id #uuid "22336d21-5307-5660-b5be-d6529d55225e",
           :seon.agent.eval/code "(let [a (user/ask! :ns/seon.render.ui \"How does canvas-history-txs build timeline steps?\")\n      b (user/ask! :ns/seon.store \"How does agent-historical-evals use d/history?\")]\n  (user/await! [a b]))",
           :seon.agent.eval/handle result/e1,
           :seon.agent.eval/ticks 55000,
           :seon.agent.eval/out "",
           :seon.agent.eval/ms 2.1}
          {:seon.agent.eval/call-index 0,
           :seon.agent.eval/call-id "ex-rec-2",
           :seon.agent.eval/thought "Both child calls settled. I will now settle my incoming parent call via (user/answer! call-id ...).",
           :seon.agent.eval/turn 2,
           :seon.agent.eval/value "{:ok? true, :status :resolved}",
           :seon.agent.eval/intent "Return synthesized answer to parent caller",
           :seon.agent.eval/id #uuid "0bf0174a-36ff-5bf5-818a-c22678c221fc",
           :seon.agent.eval/code "(user/answer! #uuid \"00000000-0000-0000-0000-000000000001\" {:summary \"Canvas timeline folds d/history attribute txs with agent-historical-evals.\"})",
           :seon.agent.eval/handle result/e2,
           :seon.agent.eval/ticks 34000,
           :seon.agent.eval/out "",
           :seon.agent.eval/ms 1.4}]}
 {:seon.agent/id :example/tree-route,
