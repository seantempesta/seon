;; Root's system procs, declared (owner, 2026-10-20: "the definition lives in a file for now
;; and an explicit start is better"). Read with aero by seon.system/read-decl; started all at
;; once by seon.root/start! after the physics step (the store opened, the fork server forked
;; while root is single-threaded), and re-applied by seon.root/apply!, which update!s only
;; the procs whose declaration changed. Agents are not here: the reconciler starts them
;; from tasks.
;;
;; A proc: {:proc step-fn symbol, :args map, :chan-opts map}. A :bind/<name> keyword is a
;; value the boot step holds (a connection, a channel, a config key; seon.root/bindings), put in
;; at build. :conns is the dependency graph: procs park on their inputs until upstream
;; sends, readiness is each proc's ping-map-fn, and there is no start order.
;; :fx declares the effect kinds (session FX1): each becomes an owner :fx/<kind> and its workers.
{:procs
 {:api {:proc seon.root/api-proc
        ;; room for every answer the writer can owe while the api is not reading
        :chan-opts {:from-writer {:buf-or-n :bind/api-from-writer-buf}}
        :args {:view :bind/view :ext :bind/ext :back :bind/back :graph :bind/graph
               :system :bind/system :conn :bind/conn :stall-ms :bind/stall-ms
               :to-writer :bind/to-writer :events :bind/events}}
  :writer {:proc seon.writer/writer-proc
           :args {:conn :bind/conn :cfg :bind/store-cfg :durable? :bind/durable?
                  :to-writer :bind/to-writer :events :bind/events}}
  :fork-server {:proc seon.fork-server/fork-server-proc
                :args {:conn :bind/conn :pid :bind/fork-server-pid :fd :bind/fork-server-fd :fork-server-ev :bind/fork-server-ev}}
  :flusher {:proc seon.writer/flusher-proc
            :args {:to-writer :bind/to-writer :cfg :bind/store-cfg}}
  ;; the incremental reconciler reads every commit's datoms (k8s's watch): a bounded
  ;; buffer, back-pressure on the writer if it lags
  :reconciler {:proc seon.reconcile/reconciler-proc
               :chan-opts {:main {:buf-or-n :bind/reconciler-buf}}
               :args {:boot :bind/boot :judge :bind/judge :source :bind/source}}
;; the test service (seon.prove): one run at a time per checkout, whoever asks. :main is the writer's
  ;; commit notice, a sliding buffer of one beside the reconciler's (a reader catches up from main's head)
;; :req and :answers are lossless and bounded by the reconciler's size (a full one parks the api); a run's
  ;; waiters are answered one message each through the api's own from-writer buffer
  :prove {:proc seon.prove/prove-proc
          :chan-opts {:req {:buf-or-n :bind/reconciler-buf} :answers {:buf-or-n :bind/reconciler-buf}
                      :main {:buf-or-n :bind/prove-main-buf}}}
  ;; root's web (session W2): the render proc renders what changed into patches per view
  ;; (:compute, never waits); the web proc owns the listener and the tabs (:io). Port:
  ;; 127.0.0.1 only, :seon.config.web/port; 0 serves nothing
  :render {:proc seon.render.proc/render-proc
           :args {:events-mult :bind/events-mult :graph :bind/graph :system :bind/system}}
  :web {:proc seon.web/web-proc
        :args {:port :bind/web-port}}}
 :fx
 {:echo {:perform seon.fx/echo :workers 1}
  :file {:perform seon.fx/write-file :workers 1}
  :source {:perform seon.fx/read-source :workers 1}
  :git {:perform seon.fx/git-commit :workers 1}
  :deps {:perform seon.fx/resolve-deps :workers 1}
  ;; the next generation (my.root/build!): bin/build seon of the last merges commit, niced, ~25-45 s
  :build {:perform seon.fx/build :workers 1}
  ;; a merge's deferred process tests, run only when root asks (owner, 2026-10-23): prove's entry
  ;; (bin/prove --tests) on a worktree of the merge candidate, niced; one at a time
  :tests {:perform seon.fx/run-tests :workers 1}
  ;; the wiki's history from git: what each section was last written against (seon.docs/baseline-plan)
  :history {:perform seon.fx/wiki-history :workers 1}
  ;; the model provider is only root's: the agents never hold the key
  :model {:perform seon.fx/model :workers :bind/model-workers :ctx {:provider :bind/provider} :rate :bind/model-rate}}
 :conns
 [[[:writer :to-fork-server] [:fork-server :cmd]]
  [[:writer :to-api] [:api :from-writer]]
  [[:reconciler :to-api] [:api :from-writer]]
  [[:writer :main] [:reconciler :main]]
  [[:writer :main] [:prove :main]]
  [[:prove :to-api] [:api :from-writer]]
  [[:fork-server :to-api] [:api :from-fs]]
  [[:api :to-fs] [:fork-server :ext]]
  [[:writer :to-flusher] [:flusher :in]]
  [[:render :to-api] [:api :from-writer]]
  [[:web :to-api] [:api :from-writer]]
  [[:render :to-web] [:web :from-render]]
  [[:web :to-render] [:render :from-web]]]}
