{:seon.lint/id [:string {:min 1 :seon.db/identity true}]
 :seon.lint/fn [:and {:description "The containing function or test program row, when the finding is inside a declaration."} :seon.db/ref]
 :seon.lint/file :seon.db/ref
 :seon.lint/type [:keyword {:description "The exact clj-kondo finding type, such as :unused-binding; clj-kondo emits unqualified keywords."}]
 :seon.lint/level [:enum :info :warning :error]
 :seon.lint/message :string
 :seon.lint/row [:int {:min 1}]
 :seon.lint/col [:int {:min 1}]
 :seon.lint/finding
 [:map {:seon.db/attributes true}
  [:seon.lint/id :seon.lint/id]
  [:seon.lint/fn {:optional true} :seon.lint/fn]
  [:seon.lint/file :seon.lint/file]
  [:seon.lint/type :seon.lint/type]
  [:seon.lint/level :seon.lint/level]
  [:seon.lint/message :seon.lint/message]
  [:seon.lint/row :seon.lint/row]
  [:seon.lint/col :seon.lint/col]]}
