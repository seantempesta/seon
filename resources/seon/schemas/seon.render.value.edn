#:seon.render.value{:artifact
                    [:map
                     [:seon.sci.admit/print-node :seon.print/node]
                     [:seon.sci.admit/record
                      {:optional true}
                      :seon.sci.admit/record]],
                    :html :seon.render/hiccup,
                    :max-collection
                    [:int {:min 1, :seon.config/dial true}],
                    :options
                    [:map
                    [:seon.render.value/max-collection
                      {:optional true}
                      :seon.render.value/max-collection]
                     [:seon.render.value/structural?
                      {:optional true}
                      :boolean]
                     [:seon.print/length
                      {:optional true}
                      [:maybe {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                        :seon.schema.admission/reason "Clojure print bindings use nil to request unlimited printing; these are in-memory options, never stored attributes."
                        :gen/elements [nil 0 1 8 32]}
               :seon.print/length]]
                     [:seon.print/level
                      {:optional true}
                      [:maybe {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                        :seon.schema.admission/reason "Clojure print bindings use nil to request unlimited printing; these are in-memory options, never stored attributes."
                        :gen/elements [nil 0 1 8 32]}
               :seon.print/level]]
                     [:seon.print/width
                      {:optional true}
                      :seon.print/width]
                     [:seon.print/namespace-maps?
                      {:optional true}
                      :seon.print/namespace-maps?]
                     [:seon.print/table?
                      {:optional true}
                      :seon.print/table?]],
                    :projection
                    [:map
                     [:seon.render.value/tree :seon.render.value/tree]
                     [:seon.render.call/selected-producer {:optional true} :qualified-symbol]
                     [:seon.render.call/source-output? {:optional true :description "The selected producer returned REPL entries: the REPL path printing this value evaluates their forms."} :boolean]
                     [:seon.render.value/truncated?
                      :seon.render.value/truncated?]
                     [:seon.render.value/text :seon.render.value/text]
                     [:seon.render.value/html :seon.render.value/html]
                     [:seon.render.value/options :seon.print/options]
                     [:seon.render.value/diagnostics {:optional true} :seon.render.value/diagnostics]
                     [:seon.render.value/value-text {:optional true} :seon.render.value/value-text]
                     [:seon.render.value/elisions {:optional true} :seon.render.value/elisions]
                     [:seon.render.value/whole-characters {:optional true} :seon.render.value/whole-characters]
                     [:seon.render.value/full? {:optional true} :seon.render.value/full?]],
                    :elisions [:int {:min 0 :description "How many cuts the selection made: each node that shows less than it holds."}],
                    :whole-characters [:int {:min 0 :description "Estimated characters of the whole value: the shown text plus each cut's omitted part (seon.render.value/omitted-characters), never a second print; a lower bound when a lazy tail is pending."}],
                    :full? [:boolean {:description "The value opted into printing whole (seon.print/full): no budget and no structural bound applied."}],
                    :value-text [:string {:description "The value's own text without the diagnostic line :seon.render.value/text appends: what a caller that records the diagnostics beside the value (seon.sci.eval/shown-result) saves as the shown text. Present exactly when diagnostics are."}],
                    :diagnostics [:vector {:min 1 :description "Presentation failures shown once beside the value they did not replace; the caller records each as a core fault."}
                                  [:or :seon.error/throwable :seon.error/base]],
                    :text :string,
                    :tree :seon.print/node,
                    :truncated? :boolean,
                    :window-failed :seon.blob/digest
                    :window-offset [:int {:min 0}]
 :seon.render.value/root-description :string
 ; The floor's B cannot show a value's root or a page's first member (one-render-path §3c).
 :seon.render.value/budget [:int {:min 0 :description "The floor's character budget B."}]
 :seon.render.value/needed [:int {:min 0 :description "Characters the root, or the root with its first member and legend, needs."}]
 :seon.render.value/insufficient-floor-budget-error [:and {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :seon.error/base [:map [:seon.render.value/budget :seon.render.value/budget] [:seon.render.value/needed :seon.render.value/needed]]]
 :seon.render.value/unreadable-artifact [:string {:min 1 :description "Why stored content is not a value artifact: the one reader's refusal, or the shape it read."}]
 :seon.render.value/unreadable-artifact-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :seon.error/base [:map [:seon.render.value/unreadable-artifact :seon.render.value/unreadable-artifact]]]
 :seon.render.value/missing-root-identity-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :seon.error/base [:map [:seon.render.value/root-description :seon.render.value/root-description]]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.render.value/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.render.value/error-window :seon.render.value/error-window]
  [:seon.render.value/projection-observation
   :seon.render.value/projection-observation]]]

 :seon.render.value/error-window
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :seon.render.value/projection-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]
}
