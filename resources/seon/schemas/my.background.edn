#:my.background{:receipt
                [:map
                 [:seon.effect/id :seon.effect/id]
                 [:seon.effect/request-edn :seon.effect/request-edn]
                 [:seon.effect/result-edn
                  {:optional true}
                  :seon.effect/result-edn]
                 [:seon.effect/result-blob
                  {:optional true}
                  :seon.effect/result-blob]
                 [:seon.effect/result-size
                  {:optional true}
                  :seon.effect/result-size]
                 [:seon.effect/duration-ms
                  {:optional true}
                  :seon.effect/duration-ms]
                 [:seon.effect/interrupted-at
                  {:optional true}
                  :seon.effect/interrupted-at]],
                :result
                [:tuple [:= :seon.effect/id] :seon.effect/id],
                :invalid-call [:= true]
                :invalid-call-error [:map {:seon.error/class true :seon.render/ai "background needs exactly one direct capability call with one request value, optionally preceded by an options map." :seon.render/html [:p "background needs exactly one direct capability call with one request value, optionally preceded by an options map."] :error/message "must mark an invalid background call"} [:my.background/invalid-call :my.background/invalid-call] [:seon.error/message :seon.error/message]]
                :invalid-result [:= true]
                :invalid-result-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark an invalid background result"} [:my.background/invalid-result :my.background/invalid-result] [:seon.error/message :seon.error/message]]
                :missing-result [:= true]
                :missing-result-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a background call with no result"} [:my.background/missing-result :my.background/missing-result] [:seon.error/message :seon.error/message]]}
