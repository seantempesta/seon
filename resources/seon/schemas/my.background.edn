#:my.background{:receipt
                [:map
                 [:seon.effect/id :seon.effect/id]
                 [:seon.effect/request-edn :seon.effect/request-edn]
                 [:seon.effect/result-edn
                  {:optional true}
                  :seon.effect/result-edn]
                 [:seon.effect/result-blob
                  {:optional true}
                  :seon.effect/result-blob]
                 [:seon.effect/result-size
                  {:optional true}
                  :seon.effect/result-size]
                 [:seon.effect/duration-ms
                  {:optional true}
                  :seon.effect/duration-ms]
                 [:seon.effect/interrupted-at
                  {:optional true}
                  :seon.effect/interrupted-at]],
                :result
                [:tuple [:= :seon.effect/id] :seon.effect/id],
                :invalid-call [:= true]
                :invalid-call-error [:map {:seon.error/class true :seon.render/ai seon.background/render-ai :seon.render/html seon.background/render-html :error/message "must mark an invalid background call"} [:my.background/invalid-call :my.background/invalid-call] [:seon.error/message :seon.error/message]]
                :invalid-result [:= true]
                :invalid-result-error [:map {:seon.error/class true :seon.render/ai seon.background/render-ai :seon.render/html seon.background/render-html :error/message "must mark an invalid background result"} [:my.background/invalid-result :my.background/invalid-result] [:seon.error/message :seon.error/message]]
                :missing-result [:= true]
                :missing-result-error [:map {:seon.error/class true :seon.render/ai seon.background/render-ai :seon.render/html seon.background/render-html :error/message "must mark a background call with no result"} [:my.background/missing-result :my.background/missing-result] [:seon.error/message :seon.error/message]]
 ; Additive error declaration manifest, 2026-09-18.

 :my.background/authored-form
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :my.background/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:my.background/authored-form :my.background/authored-form]]]
}
