          :calls [:set :seon.db/ref],
          :doc :string,
          :keywords
          [:set
           {:description
            "Qualified keywords written literally in this declaration's indexed source. clj-kondo resolves ::kw and ::alias/kw before reporting, so the set holds real namespaced keywords. It is honest membership only, never a read-versus-write claim: a keyword built at runtime is invisible, unqualified keywords are excluded as destructuring and option noise, and a keyword in a var's metadata (its :malli/schema) attributes to the namespace rather than to the var."}
           :qualified-keyword],
          :fn
          [:map
           #:seon.db{:entity true}
           [:seon.fn/sym :seon.fn/sym]
           [:seon.schema.admission/source
