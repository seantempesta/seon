            :seon.fn.manifest/manifest]],
          :ns :seon.db/ref,
          :private? :boolean,
          :projection-boundary
          [:enum :seon.render/ai :seon.render/html :none],
          :roots [:vector [:string {:min 1}]],
          :source [:string {:min 1}],
          :spec :string,
          :sym
          [:qualified-symbol
           {:seon.db/identity true,
            :seon.program/row-schema :seon.fn/fn,
