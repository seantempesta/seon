          :source-scratch-not-fresh-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a source scratch branch that already contains program entities"} [:seon.fn/source-scratch-not-fresh :seon.fn/source-scratch-not-fresh] [:seon.error/message :seon.error/message]]}
