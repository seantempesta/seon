#:seon.fn{:affected [:set :seon.fn/sym]
 :tests [:vector :seon.test/sym]
 :reverse-closure-result
 [:map [:seon.fn/affected :seon.fn/affected] [:seon.fn/tests :seon.fn/tests]]
 :namespace-unresolvable [:= true]
          :namespace-unresolvable-error
          [:and :seon.error/base
           [:map
            [:seon.fn/namespace-unresolvable :seon.fn/namespace-unresolvable]
            [:seon.fn/source :seon.fn/source]]]
          :gate-request
          [:map [:seon.db/db :seon.db/database-value]
           [:seon.fn/seeds [:set :qualified-symbol]]],
          :root [:string {:min 1}],
          :source-path [:string {:min 1}],
          :arglists :string,
          :reference-to [:qualified-keyword {:description "Identity attribute of the function named by a declared reference value; enables call-graph joins from attribute consumers to the referenced identity."}]
          :invokes [:set {:description "Function-valued attributes this declaration actually invokes. Candidate targets derive from their declarations; merely reading or reporting a symbol does not assert invocation. Attribute names are values, so removing an attribute does not erase this dependency declaration."} :qualified-keyword]
          :file [:and {:description "Indexed source file shared by function and test declarations; absent on agent-admitted definitions."} :seon.db/ref],
          :form-span [:tuple {:description "Half-open UTF-8 byte offsets of this declaration's exact source within its indexed file."} :int :int],
          :internal? [:boolean {:description "Omit this implementation helper from the Tools summary; callability is unchanged."}],
          :doc-order [:int {:min 0 :description "Optional ordering priority in namespace documentation."}],
          :arglists-override? :boolean,
          :macro?
          [:boolean
           {:description
            "Asserts clj-kondo's ::analyzer/macro fact at indexing; absent means the function is not a macro."}],
          :inline?
          [:boolean {:description "The analyzer observed :inline metadata on this defn. Explicit false records completed analysis; absence on an older row is unknown for reload selection."}]
          :constant?
          [:boolean {:description "The analyzer observed a plain def whose initializer is literal data. Such a declaration has no body, contract or test reach; macros may read its value at caller compilation. Absent means not a literal constant."}]
          :host-bound?
          [:boolean {:seon.db/index true
                     :description "Derived per declaration from its defining form and its own analyzed references to classes or forms unavailable in SCI. Ordinary callers do not inherit this fact."}]
          :defined-by
          [:qualified-symbol
           {:seon.db/index true
            :description
            "The form that interned this var, exactly as clj-kondo's analysis reports it (`clojure.core/defn`, `clojure.core/deftype`, `clojure.core/defprotocol`, a first-party `def`-ing macro).

  THE FACT BEHIND \"who wrote this body\". A `deftype`/`defrecord` positional
  constructor and a `defprotocol` method signature are vars the author never
  gave a body to, so there is nowhere to hang a `:malli/schema` and no
  contract to arm; without this fact they read as uncontracted public
  functions and a detector must guess from their names. The indexer already
  had the fact from `:seon.fn.analyzer/defined-by` — the row simply keeps
  it, so the question is a Datalog clause."}],
          :arities [:vector #:seon.db{:component true :seon.db/component-schema :seon.fn.arity/row} :seon.db/ref],
          :calls [:set {:seon.db/index true} :seon.program/edge-symbol],
          :destroys
          [:string
           {:min 1
            :description
            "What this function deletes that it did not create, declared once in the function's own metadata at its definition and indexed here.

  THE ONE DECLARATION of destructiveness. Everything else derives: a test's
  host is `seon.test/host`, which walks `:seon.fn/calls` from the test to a
  function carrying this attribute, so no roster of destructive owners or
  destructive tests exists in code or in the database. A function that deletes
  only what it created carries nothing — `seon.cluster.store/create-store!`
  deletes its own incomplete genesis and refuses a complete store, so it is
  not an owner and the 42 file-store fixtures reaching it stay in process.

  The text is shown to an agent reading the test on ONE line, so it is a
  single line naming the thing destroyed (\"an operator root's whole data/
  directory\"), never the mechanism and never wrapped source prose: a newline
  reaches the reader escaped inside the rendered form."}],
          :references [:set {:seon.db/index true :description "Source-observed function names without a resolved call shape. Names survive target retraction; selection follows them conservatively."} :seon.program/edge-symbol],
          :unresolved-references [:set {:description "Known function targets mentioned outside an attributable definition. A changed target widens selection; absence of a caller never proves no test is needed. Analyzer usages with :clj-kondo/unknown-namespace have no target identity and cannot enter this target-keyed relation."} :seon.program/edge-symbol],
          :writes
          [:set {:seon.db/index true
                 :description "Qualified attributes the analyzed declaration writes. Values survive schema-row retraction; literal mentions remain a separate relation."}
           :qualified-keyword],
          :call-arities
          [:set
           {:description
            "The arities each `:seon.fn/calls` edge was invoked with.

  One tuple per distinct (callee, arity) this declaration's source
  contains: the callee's `:seon.fn/sym` identity value and the argument
  count clj-kondo reported at that call site. The callee travels as its
  identity value rather than as a ref because Datahike stores tuple
  members verbatim — it resolves neither a lookup ref nor a tempid inside
  a tuple (probed 2026-09-16), so a `[ref long]` tuple would store an
  unresolvable vector. `:seon.fn/calls` remains the reach index; this set
  only refines calls whose argument count is known. Declared function values
  carry reach without claiming an arity."}
           [:tuple :seon.program/edge-symbol [:int {:min 0}]]],
          :caller :seon.program/edge-symbol,
          :callee :seon.program/edge-symbol,
          :call-arity [:int {:min 0}],
          :declared-arities
          [:vector
           [:map
            [:seon.fn.arity/min :seon.fn.arity/min]
            [:seon.fn.arity/max {:optional true} :seon.fn.arity/max]]],
          :prepared-arities :seon.fn/declared-arities,
          :arity-mismatch
          [:map
           [:seon.fn/caller :seon.fn/caller]
           [:seon.fn/callee :seon.fn/callee]
           [:seon.fn/call-arity :seon.fn/call-arity]
           [:seon.fn/declared-arities :seon.fn/declared-arities]
           [:seon.fn/prepared-arities :seon.fn/prepared-arities]],
          :arity-mismatches [:vector :seon.fn/arity-mismatch],
          :arity-checked [:int {:min 0}],
          :arity-unchecked [:int {:min 0}],
          :arity-mismatch-report
          [:map
           {:description
            "Call sites the callee's prepared count ranges refuse, beside their
  coverage. An empty mismatch list is legible only next to
  `:seon.fn/arity-checked` and `:seon.fn/arity-unchecked`: silence with a
  zero checked count reports that nothing was compared, never health."}
           [:seon.fn/arity-mismatches :seon.fn/arity-mismatches]
           [:seon.fn/arity-checked :seon.fn/arity-checked]
           [:seon.fn/arity-unchecked :seon.fn/arity-unchecked]],

          :external-sink
          [:enum :ai-visible-text :html-response :codec-storage],
          :doc :string,
          :keywords
          [:set
           {:description
            "Qualified keywords written literally in this declaration's indexed source. clj-kondo resolves ::kw and ::alias/kw before reporting, so the set holds real namespaced keywords. It is honest membership only, never a read-versus-write claim: a keyword built at runtime is invisible, unqualified keywords are excluded as destructuring and option noise, and a keyword in a var's metadata (its :malli/schema) attributes to the namespace rather than to the var."}
           :qualified-keyword],
          :fn
          [:and
           {:seon.db/attributes true,
            :seon.render/ai seon.render.ns/function-ai
            :seon.render/html seon.render.ns/function-html :seon.program/partition :seon.program}
           [:map
           [:seon.fn/sym :seon.fn/sym]
           [:seon.program/definition-digest :seon.program/definition-digest]
           [:seon.program/analyzed-source-digest :seon.program/analyzed-source-digest]
           [:seon.test/subject {:optional true} :seon.test/subject]
           [:seon.schema.admission/source
            :seon.schema.admission/source]
           [:seon.fn/ns :seon.fn/ns]
           [:seon.fn/source :seon.fn/source]
           [:seon.fn/file {:optional true} :seon.fn/file]
           [:seon.fn/form-span {:optional true} :seon.fn/form-span]
           [:seon.fn/arglists :seon.fn/arglists]
           [:seon.fn/arglists-override?
            {:optional true}
            :seon.fn/arglists-override?]
