 :seon.fn/index-refused [:= true]
 :seon.fn/index-refused-error [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.fn/index-refused distinguishing member"} [:seon.fn/index-refused :seon.fn/index-refused] [:seon.cluster.source/phase {:optional true} :seon.cluster.source/phase] [:seon.error/message :seon.error/message]]
 :seon.fn/signature-refused [:= true]
