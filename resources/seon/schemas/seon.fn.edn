           [:seon.fn/private? :seon.fn/private?]
           [:seon.fn/internal? {:optional true} :seon.fn/internal?]
           [:seon.fn/doc-order {:optional true} :seon.fn/doc-order]
           [:seon.fn/macro? {:optional true} :seon.fn/macro?]
           [:seon.fn/inline? {:optional true} :seon.fn/inline?]
           [:seon.fn/constant? {:optional true} :seon.fn/constant?]
           [:seon.fn/host-bound? {:optional true} :seon.fn/host-bound?]
           [:seon.fn/defined-by {:optional true} :seon.fn/defined-by]
           [:seon.fn/spec {:optional true} :seon.fn/spec]
           [:seon.fn/calls {:optional true} :seon.fn/calls]
           [:seon.fn/invokes {:optional true} :seon.fn/invokes]
           [:seon.fn/destroys {:optional true} :seon.fn/destroys]
           [:seon.fn/references {:optional true} :seon.fn/references]
           [:seon.fn/call-arities {:optional true} :seon.fn/call-arities]
           [:seon.fn/writes {:optional true} :seon.fn/writes]
           [:seon.fn/keywords {:optional true} :seon.fn/keywords]
           [:seon.fn/arities {:optional true} :seon.fn/arities]
           [:seon.fn/workload {:optional true} :seon.fn/workload]
           [:seon.fn/external-sink
            {:optional true}
            :seon.fn/external-sink]
