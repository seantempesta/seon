#:seon.fn{:root [:string {:min 1}],
          :source-path [:string {:min 1}],
          :arglists :string,
          :reference-to [:qualified-keyword {:description "Identity attribute of the function named by a declared reference value; enables call-graph joins from attribute consumers to the referenced identity."}]
          :capability-fn
          [:and
           {:description
            "The function that executes this capability's requests: a ref to the handler's own declaration, beside the `:seon.effect/capability` symbol the metadata carries."
            :seon.db/index true
            :seon.fn/reference-to :seon.fn/sym}
           :seon.db/ref],
          :file [:and {:description "Indexed source file shared by function and test declarations; absent on agent-admitted definitions."} :seon.db/ref],
          :form-span [:tuple {:description "Half-open UTF-8 byte offsets of this declaration's exact source within its indexed file."} :int :int],
          :internal? [:boolean {:description "Omit this implementation helper from the Tools summary; callability is unchanged."}],
          :doc-order [:int {:min 0 :description "Optional ordering priority in namespace documentation."}],
          :arglists-override? :boolean,
          :macro?
          [:boolean
           {:description
            "Asserts clj-kondo's ::analyzer/macro fact at indexing; absent means the function is not a macro."}],
          :arities [:vector #:seon.db{:component true} :seon.db/ref],
          :ast [:and #:seon.db{:component true} :seon.db/ref],
          :calls [:set :seon.db/ref],
          :references [:set {:description "Function references without a resolved call shape. Selection follows these conservatively; no invocation or arity is asserted."} :seon.db/ref],
          :unresolved-references [:set {:description "Known function targets mentioned outside an attributable definition. A changed target widens selection; absence of a caller never proves no test is needed."} :seon.fn/sym],
          :writes
          [:set
           {:description
            "Declared attributes this declaration asserts at a database write.

  Derived by span containment at indexing: a qualified keyword whose
  position lies inside the span of a `seon.db/transact!` usage is
  transaction data that call carries. Each value is a `:seon.schema/key`
  row, never a keyword literal, so the writers of an attribute are one
  join. It over-reports nothing the call does not lexically contain, and
  under-reports transaction data assembled in a helper — which the
  `:seon.fn/calls` closure already reaches."}
           :seon.db/ref],
          :call-arities
          [:set
           {:description
            "The arities each `:seon.fn/calls` edge was invoked with.

  One tuple per distinct (callee, arity) this declaration's source
  contains: the callee's `:seon.fn/sym` identity value and the argument
  count clj-kondo reported at that call site. The callee travels as its
  identity value rather than as a ref because Datahike stores tuple
  members verbatim — it resolves neither a lookup ref nor a tempid inside
  a tuple (probed 2026-09-16), so a `[ref long]` tuple would store an
  unresolvable vector. `:seon.fn/calls` remains the reach index; this set
  only refines calls whose argument count is known. Declared function values
  carry reach without claiming an arity."}
           [:tuple [:string {:min 1}] [:int {:min 0}]]],
          :caller [:string {:min 1}],
          :callee [:string {:min 1}],
          :call-arity [:int {:min 0}],
          :declared-arities
          [:vector
           [:map
            [:seon.fn.arity/min :seon.fn.arity/min]
            [:seon.fn.arity/max {:optional true} :seon.fn.arity/max]]],
          :arity-mismatch
          [:map
           [:seon.fn/caller :seon.fn/caller]
           [:seon.fn/callee :seon.fn/callee]
           [:seon.fn/call-arity :seon.fn/call-arity]
           [:seon.fn/declared-arities :seon.fn/declared-arities]],
          :arity-mismatches [:vector :seon.fn/arity-mismatch],
          :arity-checked [:int {:min 0}],
          :arity-unchecked [:int {:min 0}],
          :arity-mismatch-report
          [:map
           {:description
            "Call sites the callee's declared arities refuse, beside their
  coverage. An empty mismatch list is legible only next to
  `:seon.fn/arity-checked` and `:seon.fn/arity-unchecked`: silence with a
  zero checked count reports that nothing was compared, never health."}
           [:seon.fn/arity-mismatches :seon.fn/arity-mismatches]
           [:seon.fn/arity-checked :seon.fn/arity-checked]
           [:seon.fn/arity-unchecked :seon.fn/arity-unchecked]],
          :pending-calls
          [:set {:description "Analyzer-observed call targets whose program identity is not yet admitted. The declaration writer resolves them when that identity arrives."}
           [:string {:min 1}]],
          :external-sink
          [:enum :ai-visible-text :html-response :codec-storage],
          :doc [:string #:seon.search{:index :text}],
          :keywords
          [:set
           {:description
            "Qualified keywords written literally in this declaration's indexed source. clj-kondo resolves ::kw and ::alias/kw before reporting, so the set holds real namespaced keywords. It is honest membership only, never a read-versus-write claim: a keyword built at runtime is invisible, unqualified keywords are excluded as destructuring and option noise, and a keyword in a var's metadata (its :malli/schema) attributes to the namespace rather than to the var."}
           :qualified-keyword],
          :fn
          [:map
           {:seon.db/attributes true,
            :seon.render/ai seon.render.ns/function-ai
            :seon.render/html seon.render.ns/function-html}
           [:seon.fn/sym :seon.fn/sym]
           [:seon.test/subject {:optional true} :seon.test/subject]
           [:seon.schema.admission/source
            :seon.schema.admission/source]
           [:seon.fn/ns :seon.fn/ns]
           [:seon.fn/source {:optional true} :seon.fn/source]
           [:seon.fn/file {:optional true} :seon.fn/file]
           [:seon.fn/form-span {:optional true} :seon.fn/form-span]
           [:seon.fn/arglists {:optional true} :seon.fn/arglists]
           [:seon.fn/arglists-override?
            {:optional true}
            :seon.fn/arglists-override?]
           [:seon.fn/doc {:optional true} :seon.fn/doc]
           [:seon.fn/private? {:optional true} :seon.fn/private?]
           [:seon.fn/internal? {:optional true} :seon.fn/internal?]
           [:seon.fn/doc-order {:optional true} :seon.fn/doc-order]
           [:seon.fn/macro? {:optional true} :seon.fn/macro?]
           [:seon.fn/spec {:optional true} :seon.fn/spec]
           [:seon.fn/calls {:optional true} :seon.fn/calls]
           [:seon.fn/references {:optional true} :seon.fn/references]
           [:seon.fn/call-arities {:optional true} :seon.fn/call-arities]
           [:seon.fn/writes {:optional true} :seon.fn/writes]
           [:seon.fn/pending-calls {:optional true} :seon.fn/pending-calls]
           [:seon.fn/keywords {:optional true} :seon.fn/keywords]
           [:seon.fn/arities {:optional true} :seon.fn/arities]
           [:seon.fn/ast {:optional true} :seon.fn/ast]
           [:seon.fn/workload {:optional true} :seon.fn/workload]
           [:seon.fn/external-sink
            {:optional true}
            :seon.fn/external-sink]
           [:seon.fn/projection-boundary
            {:optional true}
            :seon.fn/projection-boundary]
           [:seon.effect/capability
            {:optional true}
            :seon.effect/capability]
           [:seon.fn/capability-fn
            {:optional true}
            :seon.fn/capability-fn]],
          :index-request
          [:map
           [:seon.db/connection
            {:optional true}
            :seon.db/connection]
           [:seon.db/process {:optional true} :seon.db/ref]
           [:seon.source/previous-database
            {:optional true} :seon.source/previous-database]
           [:seon.source/database {:optional true} :seon.source/database]
           [:seon.fn/roots {:optional true} :seon.fn/roots]
           [:seon.fn/manifest
            {:optional true}
            :seon.fn.manifest/manifest]],
          :ns :seon.db/ref,
          :private? :boolean,
          :projection-boundary
          [:enum :seon.render/ai :seon.render/html :none],
          :roots [:vector [:string {:min 1}]],
          :source [:string {:min 1}],
          :spec :string,
          :sym
          [:string
           {:min 1, :seon.db/identity true, :seon.search/index :symbol,
            :seon.program/row-schema :seon.fn/fn,
            :seon.program/source-attribute :seon.fn/source}],
          :workload [:enum :io :compute],
          :index-phase :keyword,
          :capability-rule :keyword,
          :resource :string,
          :missing-population :qualified-keyword,
          :existing-program-entity :int,
          :index-transaction-refused :seon.fn/index-phase
          :index-transaction-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must identify the indexing phase whose transaction was refused"} [:seon.fn/index-transaction-refused :seon.fn/index-transaction-refused] [:seon.error/message :seon.error/message]]
          :source-checkout-required :seon.fn/resource
          :source-checkout-required-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must identify the resource that requires a source checkout"} [:seon.fn/source-checkout-required :seon.fn/source-checkout-required] [:seon.error/message :seon.error/message]]
          :source-span-absent [:= true]
          :source-span-absent-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must mark a declaration with no exact source span"} [:seon.fn/source-span-absent :seon.fn/source-span-absent] [:seon.error/message :seon.error/message]]
          :capability-graph-malformed :seon.fn/capability-rule
          :capability-graph-malformed-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must identify the malformed capability-graph rule"} [:seon.fn/capability-graph-malformed :seon.fn/capability-graph-malformed] [:seon.error/message :seon.error/message]]
          :analysis-failed [:= true]
          :analysis-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must mark static analysis with blocking findings"} [:seon.fn/analysis-failed :seon.fn/analysis-failed] [:seon.error/message :seon.error/message]]
          :source-file-invalid :seon.fn/source-path
          :source-file-invalid-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must identify the invalid or duplicate source file path"} [:seon.fn/source-file-invalid :seon.fn/source-file-invalid] [:seon.error/message :seon.error/message]]
          :manifest-absent [:= true]
          :manifest-absent-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must mark an indexing request with neither manifest nor source roots"} [:seon.fn/manifest-absent :seon.fn/manifest-absent] [:seon.error/message :seon.error/message]]
          :duplicate-program-identity [:= true]
          :duplicate-program-identity-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must mark duplicate program identities"} [:seon.fn/duplicate-program-identity :seon.fn/duplicate-program-identity] [:seon.error/message :seon.error/message]]
          :population-incomplete :seon.fn/missing-population
          :population-incomplete-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must identify the program population with no rows"} [:seon.fn/population-incomplete :seon.fn/population-incomplete] [:seon.error/message :seon.error/message]]
          :schema-declaration-invalid :seon.schema/key
          :schema-declaration-invalid-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must identify the declaration that is not a Malli schema"} [:seon.fn/schema-declaration-invalid :seon.fn/schema-declaration-invalid] [:seon.error/message :seon.error/message]]
          :scratch-not-fresh :seon.fn/existing-program-entity
          :scratch-not-fresh-error [:map {:seon.error/class true :seon.render/ai seon.error/index-refusal-prose :seon.render/html seon.error/render-html :error/message "must identify the program entity already present on a source scratch branch"} [:seon.fn/scratch-not-fresh :seon.fn/scratch-not-fresh] [:seon.error/message :seon.error/message]]
 :seon.fn/index-refused [:= true]
 :seon.fn/index-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.fn/index-refused class marker"} [:seon.fn/index-refused :seon.fn/index-refused] [:seon.error/message :seon.error/message]]
 :seon.fn/signature-refused [:= true]
 :seon.fn/signature-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.fn/signature-refused class marker"} [:seon.fn/signature-refused :seon.fn/signature-refused] [:seon.error/message :seon.error/message]]}
