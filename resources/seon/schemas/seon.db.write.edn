{
 ; Additive error declaration manifest, 2026-09-18.

 :seon.db.write/validation-refusal
 [:and
  {:seon.db/attributes false
   :seon.render/ai seon.db/render-rejection-ai
   :seon.render/html seon.db/render-rejection-html
   :description "Raw refused request and its observed basis. Recorder admission projects the transaction data into the stored write attempt; this transient value is not a stored entity."}
  :seon.error/base
  [:map
   [:seon.db.write.attempt/request-id :seon.db.write.attempt/request-id]
   [:seon.error/basis :seon.error/basis]
   [:seon.db.write/validator-schema {:optional true} :seon.db.write/validator-schema]
   [:seon.turn/deletion-proposals-edn {:optional true} :seon.turn/deletion-proposals-edn]
   [:seon.error/data
    [:map [:seon.db.write.attempt/transaction :seon.db.write.attempt/transaction]]]]]

 :seon.db.write/entity-refusal
 [:and
  {:seon.db/attributes false
   :description "The writer's refusal of a resulting entity: every failing path is a problem with its own offending value (a missing key's is the map it is missing from), never a placeholder such as :seon.error/unknown. A transient refusal value, not a stored entity."}
  :seon.error/base
  [:map
   [:seon.db/offending [:not= :seon.error/unknown]]
   [:seon.error/data [:map [:seon.error/problems [:vector {:min 1} :seon.error/problem-description]]]]]]

 :seon.db.write/validator-schema
 [:qualified-keyword {:description "The declared schema of the final validator's own refusal (e.g. :seon.program/deletion-refused-error), carried beside the generic write-attempt identity; the raw value also satisfies it."}]

 :seon.db.write/attempt
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.db.write.attempt/entity}
 :seon.db/ref]

 :seon.db.write/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.db.write/attempt :seon.db.write/attempt]
  [:seon.error/basis :seon.error/basis]
  [:seon.db.write/validator-schema {:optional true} :seon.db.write/validator-schema]
  [:seon.turn/deletion-proposals-edn {:optional true} :seon.turn/deletion-proposals-edn]]]
}
