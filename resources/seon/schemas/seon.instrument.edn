#:seon.instrument{:applied
                  [:map
                   [:seon.instrument/registered
                    :seon.instrument/registered]
                   [:seon.instrument/instrumented
                    :seon.instrument/instrumented]],
                  :args :string,
                  ;; The value at the violation's own path, bounded by the
                  ;; fault family's evidence bound. `:args` is what the ARM
                  ;; checked (the whole argument vector or returned value) and
                  ;; becomes the over-bound marker for any function carrying a
                  ;; context; this answers "what value broke the contract".
                  :actual :string,
                  ;; That value's OWN size in admitted-projection bytes,
                  ;; measured exactly the way `:seon.error/data-size` measures
                  ;; the whole source — so the two numbers are comparable and
                  ;; a reader can see how small the offending leaf was against
                  ;; the value it rode in. Never the request's size.
                  :actual-size [:int {:min 0}],
                  :arm [:enum :input :output],
                  :expected [:string {:min 1}],
                  :fn [:qualified-symbol {:seon.db/index true :description "The observed function identity, including historical fault attribution. It never requires or creates a definition row."}],
                  :instrumented [:int {:min 0}],
                  :registered [:int {:min 0}],
                  :changed-identities [:set [:tuple [:= :seon.fn/sym] :qualified-symbol]],
                  :request
                  [:map
                   [:seon.instrument/changed-identities
                    {:optional true}
                    :seon.instrument/changed-identities]
                   [:seon.config/on-core-error
                    :seon.config/on-core-error]
                   [:seon.schema/projection
                    {:optional true}
                    :seon.schema/projection]
                   [:seon.sci.admit/caps
                    {:optional true}
                    :seon.sci.admit/caps]
                   [:seon.config.error/max-evidence-bytes
                    {:optional true}
                    :seon.config.error/max-evidence-bytes]
                   [:seon.flow/commit-fault!
                    {:optional true}
                    :seon.flow/commit-fault!]
                   [:seon.profile/definition-digests
                    {:optional true}
                    :seon.profile/definition-digests]],
 :seon.instrument/loaded-var
 [:fn {:error/message "must be a loaded Clojure Var"
       :gen/gen seon.instrument/loaded-var-generator}
  clojure.core/var?]

 :seon.instrument/replaced-var :qualified-symbol
 :seon.instrument/root-class [:string {:min 1 :description "The class of the Var's current root, looked through the armed wrapper."}]
 :seon.instrument/expected-class [:string {:min 1 :description "The class a defn in the Var's own namespace compiles to."}]
 :seon.instrument/expected-file [:string {:min 1 :description "The function row's relative source path."}]
 :seon.instrument/loaded-file [:string {:min 1 :description "The file the Var's current definition was loaded from."}]
 :seon.instrument/replaced-root
 [:map
  [:seon.instrument/replaced-var :seon.instrument/replaced-var]
  [:seon.instrument/root-class :seon.instrument/root-class]
  [:seon.instrument/expected-class :seon.instrument/expected-class]
  [:seon.instrument/expected-file :seon.instrument/expected-file]
  [:seon.instrument/loaded-file {:optional true} :seon.instrument/loaded-file]]

 :seon.instrument/callable
 [:fn {:error/message "must be callable"
       :gen/schema [:=> [:cat] :nil]}
  clojure.core/ifn?]

 ; Additive error declaration manifest, 2026-09-18.



 :seon.instrument/arity
 [:int {:min 0}]

 :seon.instrument/arity-error
 [:and
 [:and
  {:seon.db/attributes true}
  :seon.error/base
  [:map
   {:seon.db/attributes true}
   [:seon.instrument/fn :seon.instrument/fn]
   [:seon.instrument/arity :seon.instrument/arity]
   [:seon.instrument/declared-arity-count
    :seon.instrument/declared-arity-count]
   [:seon.instrument/declared-arities
    :seon.instrument/declared-arities]]]
 [:fn
  {:error/message "arity-refusal-valid?",
   :gen/gen seon.error/arity-refusal-valid-generator}
  seon.error/arity-refusal-valid?]]

 :seon.instrument/check
 [:enum :input :output :guard]

 :seon.instrument/contract-error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.instrument/fn :seon.instrument/fn]
  [:seon.instrument/arity :seon.instrument/arity]
  [:seon.instrument/check :seon.instrument/check]
  [:seon.instrument/explanations :seon.instrument/explanations]
  [:seon.error/expected-shape :seon.error/expected-shape]
  [:seon.error/location :seon.error/location]
  [:seon.error/offending-projection
   {:optional true}
   :seon.error/offending-projection]]]

 :seon.instrument/declared-arities
 [:set
 {:seon.db/component true,
  :seon.db/component-schema :seon.instrument.arity/bounds}
 :seon.db/ref]

 :seon.instrument/declared-arity-count
 [:int {:min 1}]




 :seon.instrument/explanations
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.instrument.explanations/entity}
 :seon.db/ref]

 :seon.instrument/refusal-result
 [:or
 :seon.instrument/contract-error
 :seon.instrument/arity-error ]

 :seon.instrument/registration-error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.instrument/fn :seon.instrument/fn]
  [:seon.instrument/registration-observation
   :seon.instrument/registration-observation]]]

 :seon.instrument/registration-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]


}
