#:seon.cluster.agent{:agent
                     [:map
                      {:seon.db/attributes true,
                       :seon.render/ai
                       seon.cluster.agent/render-identity-ai,
                       :seon.render/html
                       seon.cluster.agent/render-identity-html,
                       :seon.render/form
                       seon.cluster.agent/identity-form}
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/namespace
                       {:optional true}
                       :seon.cluster.agent/namespace]
                      [:seon.cluster.agent/run
                       {:optional true}
                       :seon.cluster.agent/run]],
                     :arm-request
                     [:map
                      [:seon.cluster.loop/cluster
                       :seon.cluster.loop/cluster]
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/routing
                       :seon.cluster.agent/routing]],
                     :armed
                     [:map
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/eid :int]
                      [:seon.flow/graph :seon.flow/graph]
                      [:seon.cluster.wake/channel :seon.flow/channel]
                      [:seon.cluster.loop/completion
                       :seon.flow/channel]
                      [:seon.cluster.agent/turn-stopped
                       :seon.flow/channel]],
                     :blueprint-request
                     [:map
                      [:seon.cluster.loop/cluster
                       :seon.cluster.loop/cluster]
                      [:seon.cluster.agent/id :seon.cluster.agent/id]],
                     :cluster :seon.db/ref,
                     :context-links
                     [:map
                      #:seon.db{:attributes true}
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/cluster
                       :seon.cluster.agent/cluster]
                      [:seon.cluster.agent/instructions
                       {:optional true}
                       :seon.cluster.agent/instructions]],
                     :count [:int {:min 0}],
                     :creation-request
                     [:map
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.ns/name :seon.ns/name]
                      [:seon.cluster/name :seon.cluster/name]],
                     :creation-result
                     [:map
                      {:seon.render/ai
                       seon.cluster.agent/render-creation-ai,
                       :seon.render/html
                       seon.cluster.agent/render-creation-html}
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.ns/name :seon.ns/name]
                      [:seon.cluster/name :seon.cluster/name]
                      [:seon.cluster.run/id :seon.cluster.run/id]],
                     :creation-tx [:vector :map],
                     :disarm-request
                     [:map
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/routing
                       :seon.cluster.agent/routing]],
                     :eid :int,
                     :id [:string {:min 1, :seon.db/identity true}],
                     :instructions [:set :seon.db/ref],
                     :namespace
                     [:and #:seon.db{:unique true} :seon.db/ref],
                     :routing
                     [:fn
                      {:error/message
                       "must be a process-local atom containing agent routing state"
                       :gen/gen seon.flow/atom-reference-generator}
                      seon.flow/atom-reference?],
                     :run :seon.db/ref,
                     ;; The live value returned by `(help)`. These are
                     ;; projections of current facts, never attributes stored
                     ;; on the agent. Adding a member here is how the generated
                     ;; opening grows: its printed value introduces another
                     ;; reference to the symbol-driven frontier.
                     :namespace-ref :seon.db/ref,
                     :unread-message-count [:int {:min 0}],
                     :open-run-ref :seon.db/ref,
                     :protocol-namespaces [:vector :seon.ns/name],
                     :situation
                     [:map
                      {:seon.render/ai
                       seon.cluster.agent/render-situation-ai,
                       :seon.render/form
                       seon.cluster.agent/situation-form}
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/namespace-ref
                       :seon.cluster.agent/namespace-ref]
                      [:seon.cluster.agent/unread-message-count
                       :seon.cluster.agent/unread-message-count]
                      [:seon.cluster.agent/open-run-ref
                       {:optional true}
                       :seon.cluster.agent/open-run-ref]
                      [:seon.cluster.run/trigger
                       {:optional true}
                       :seon.cluster.run/trigger]
                      [:seon.cluster.run/turns-remaining
                       :seon.cluster.run/turns-remaining]
                      [:seon.cluster.agent/protocol-namespaces
                       :seon.cluster.agent/protocol-namespaces]],
                     :no-such-agent :seon.cluster.agent/id
                     :no-such-agent-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the requested agent that does not exist"} [:seon.cluster.agent/no-such-agent :seon.cluster.agent/no-such-agent] [:seon.error/message :seon.error/message]]
                     :turn-completion-backstop :seon.cluster.agent/id
                     :turn-completion-backstop-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the agent whose turn-completion backstop fired"} [:seon.cluster.agent/turn-completion-backstop :seon.cluster.agent/turn-completion-backstop] [:seon.error/message :seon.error/message]]
                     :turn-completion-undeliverable :seon.cluster.agent/id
                     :turn-completion-undeliverable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the agent whose turn completion was undeliverable"} [:seon.cluster.agent/turn-completion-undeliverable :seon.cluster.agent/turn-completion-undeliverable] [:seon.error/message :seon.error/message]]
                     :creation-incomplete :seon.cluster.agent/id
                     :creation-incomplete-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify an incompletely created agent"} [:seon.cluster.agent/creation-incomplete :seon.cluster.agent/creation-incomplete] [:seon.error/message :seon.error/message]]
                     :armer-quiescence-undeliverable [:= true]
                     :armer-quiescence-undeliverable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark an armer that could not publish quiescence"} [:seon.cluster.agent/armer-quiescence-undeliverable :seon.cluster.agent/armer-quiescence-undeliverable] [:seon.error/message :seon.error/message]]
                     :supervision-not-committed [:= true]
                     :supervision-not-committed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark first-agent supervision that did not commit"} [:seon.cluster.agent/supervision-not-committed :seon.cluster.agent/supervision-not-committed] [:seon.error/message :seon.error/message]]}
