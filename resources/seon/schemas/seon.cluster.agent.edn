#:seon.cluster.agent{:agent
                     [:map
                      {:seon.db/entity true,
                       :seon.render/ai seon.render.agent/agent-ai,
                       :seon.render/html seon.render.agent/agent-html}
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/namespace
                       {:optional true}
                       :seon.cluster.agent/namespace]
                      [:seon.cluster.agent/run
                       {:optional true}
                       :seon.cluster.agent/run]],
                     :arm-request
                     [:map
                      [:seon.cluster.loop/cluster
                       :seon.cluster.loop/cluster]
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/routing
                       :seon.cluster.agent/routing]],
                     :armed
                     [:map
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/eid :int]
                      [:seon.flow/graph :seon.flow/graph]
                      [:seon.cluster.wake/channel :seon.flow/channel]
                      [:seon.cluster.loop/completion
                       :seon.flow/channel]
                      [:seon.cluster.agent/turn-stopped
                       :seon.flow/channel]],
                     :blueprint-request
                     [:map
                      [:seon.cluster.loop/cluster
                       :seon.cluster.loop/cluster]
                      [:seon.cluster.agent/id :seon.cluster.agent/id]],
                     :cluster :seon.db/ref,
                     :context-links
                     [:map
                      #:seon.db{:entity true}
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/cluster
                       :seon.cluster.agent/cluster]
                      [:seon.cluster.agent/instructions
                       {:optional true}
                       :seon.cluster.agent/instructions]],
                     :count [:int {:min 0}],
                     :creation-request
                     [:map
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.ns/name :seon.ns/name]
                      [:seon.cluster/name :seon.cluster/name]],
                     :creation-tx [:vector :map],
                     :disarm-request
                     [:map
                      [:seon.cluster.agent/id :seon.cluster.agent/id]
                      [:seon.cluster.agent/routing
                       :seon.cluster.agent/routing]],
                     :eid :int,
                     :id [:string {:min 1, :seon.db/identity true}],
                     :instructions [:set :seon.db/ref],
                     :namespace
                     [:and #:seon.db{:unique true} :seon.db/ref],
                     :routing
                     [:fn
                      {:error/message
                       "must be a process-local atom containing agent routing state"
                       :gen/gen seon.flow/atom-reference-generator}
                      seon.flow/atom-reference?],
                     :run :seon.db/ref,
                     :no-such-agent :seon.cluster.agent/id
                     :no-such-agent-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the requested agent that does not exist"} [:seon.cluster.agent/no-such-agent :seon.cluster.agent/no-such-agent] [:seon.error/message :seon.error/message]]
                     :turn-completion-backstop :seon.cluster.agent/id
                     :turn-completion-backstop-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the agent whose turn-completion backstop fired"} [:seon.cluster.agent/turn-completion-backstop :seon.cluster.agent/turn-completion-backstop] [:seon.error/message :seon.error/message]]
                     :turn-completion-undeliverable :seon.cluster.agent/id
                     :turn-completion-undeliverable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the agent whose turn completion was undeliverable"} [:seon.cluster.agent/turn-completion-undeliverable :seon.cluster.agent/turn-completion-undeliverable] [:seon.error/message :seon.error/message]]}
