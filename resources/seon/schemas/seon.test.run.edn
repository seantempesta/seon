#:seon.test.run{:at :inst,
                :git-sha [:re "^[0-9a-f]{40}$"],
                :id [:string {:min 1, :seon.db/identity true}],
                :program-digest [:and {:seon.db/identity false} :seon.source/digest],
                :basis-t :seon.db/basis-t,
                :published-base-digest [:and {:seon.db/identity false :description "Digest of the published base resolved before overlay admission. This identifies the base, not the overlaid program."} :seon.source/digest],
                :overlay-input-digest [:and {:seon.db/identity false :description "Digest of the complete declared input inventory of the tested HEAD-plus-paths snapshot. Checkout bytes omitted from the snapshot never contribute."} :seon.source/digest],
                :snapshot
                [:map
                 [:seon.test.run/published-base-digest :seon.test.run/published-base-digest]
                 [:seon.test.run/overlay-input-digest :seon.test.run/overlay-input-digest]
                 [:seon.test.run/program-digest :seon.test.run/program-digest]
                 [:seon.test.run/basis-t :seon.test.run/basis-t]],
                :callers-at-head [:set {:description "Observed paths of dirty checkout callers omitted from the selected overlay. The tested snapshot contains their HEAD versions, not their dirty checkout bytes. Path values survive file deletion."} :seon.source/path],
                :branch [:and {:description "Durable destination branch of the result commit, addressable in its store. A publication scratch branch is never the destination; tested-branch records execution provenance separately."} :seon.source/branch],
                :tested-branch [:and {:description "Branch of the immutable database tested, when different from the result destination. basis-t belongs to this branch; it must not be interpreted as destination history."} :seon.source/branch],
                :cluster [:and {:description "Explicit authority cluster for an in-process run. A published snapshot instead carries its explicit source branch and snapshot provenance. The optional stored ref sweeps on cluster deletion, leaving cluster custody unavailable."} :seon.db/ref],
                :change-basis-t [:and {:description "Earlier tested basis used to select changes in the same lineage; absent for first-run."} :seon.db/basis-t],
                :members [:set {:seon.db/component true :seon.db/component-schema :seon.test.member/member :description "Selected memberships admitted atomically before execution; deleting the run cascades to these components."} :seon.db/ref],
                :covered-by [:set {:description "Existing run members accepted instead of duplicate execution at admission. Optional refs sweep with their targets; a reader must report missing coverage as unknown."} :seon.db/ref],
                :exclusions [:set {:seon.db/component true :seon.db/component-schema :seon.test.selection/exclusion :description "Request decisions excluded from executable membership; deletion of the owning run cascades to these observations."} :seon.db/ref],
                :selection-tx [:and {:description "Transaction admitting the complete selection, including zero members. Required at admission; the optional stored ref sweeps if that transaction is removed, leaving selection unavailable."} :seon.db/ref],
                :policy [:enum {:description "Requested eligibility scope. Matching recorded green evidence is reused under every policy."} :incremental :named :platform :all :full],
                :namespaces [:set {:description "Namespaces explicitly requested at admission; absence means none requested."} :symbol],
                :identities [:set {:description "Test identities explicitly requested at admission."} :qualified-symbol],
                :include-long? [:boolean {:description "Explicit long-test inclusion decision for this request."}],
                :input-digest [:and {:seon.db/identity false :description "Digest of publication inputs outside the program graph observed for this run."} :seon.source/digest],
                :admission
                [:map
                 [:seon.test.run/provenance :seon.test.run/provenance]
                 [:seon.test.run/cluster {:optional true} :seon.test.run/cluster]
                 [:seon.test.run/covered-by {:optional true} :seon.test.run/covered-by]
                 [:seon.test.run/input-digest :seon.test.run/input-digest]
                 [:seon.test.run/policy :seon.test.run/policy]
                 [:seon.test.run/include-long? :seon.test.run/include-long?]
                 [:seon.test.run/deadline {:optional true} :seon.test.run/deadline]
                 [:seon.test.run/change-basis-t {:optional true} :seon.test.run/change-basis-t]
                 [:seon.test.run/namespaces {:optional true} :seon.test.run/namespaces]
                 [:seon.test.run/identities {:optional true} :seon.test.run/identities]
                 [:seon.test.run/exclusions {:optional true} [:vector :seon.test.selection/exclusion]]
                 [:seon.test.run/members [:vector :seon.test.member/member]]],
                :deadline [:and {:description "Original request deadline; contention and reclaim never restart it."} :seon.test.run/at],
                :dead-workers [:vector {:description "Confirmed exited process generations from the process census or observed child exit; timeout or unknown observations do not qualify."}
                               [:map [:seon.db.process/pid :seon.db.process/pid]
                                [:seon.db.process/start-instant :seon.db.process/start-instant]]],
                :claim-request
                [:map
                 [:seon.test.run/id :seon.test.run/id]
                 [:seon.test.member/worker :seon.test.member/worker]
                 [:seon.db.process/pid :seon.db.process/pid]
                 [:seon.db.process/start-instant :seon.db.process/start-instant]
                 [:seon.test.member/claimed-at :seon.test.member/claimed-at]
                 [:seon.test.member/host :seon.test.member/host]
                 [:seon.test.run/deadline :seon.test.run/deadline]
                 [:seon.test.run/dead-workers {:optional true} :seon.test.run/dead-workers]],
                :terminated? [:boolean {:description "Caller observed execution return or exact process exit; a bound firing alone is false."}],
                :claim-completion
                [:and :seon.test.run/completion
                 [:map
                  [:seon.test.member/worker :seon.test.member/worker]
                  [:seon.test.member/claim-tx :seon.test.member/claim-tx]
                  [:seon.test.run/terminated? :seon.test.run/terminated?]]],
                :immutable [:and {:seon.db/identity false} :seon.test.run/id],
                :immutable-error
                [:and :seon.error/base [:map [:seon.test.run/immutable :seon.test.run/immutable]]],
                :unavailable [:= true],
                :provenance-failure [:string {:min 1}],
                :unavailable-error
                [:and :seon.error/base
                 [:map [:seon.test.run/unavailable :seon.test.run/unavailable]
                  [:seon.test.run/provenance-failure :seon.test.run/provenance-failure]]],
                :provenance
                [:map
                 [:seon.test.run/published-base-digest {:optional true} :seon.test.run/published-base-digest]
                 [:seon.test.run/overlay-input-digest {:optional true} :seon.test.run/overlay-input-digest]
                 [:seon.test.run/callers-at-head {:optional true} :seon.test.run/callers-at-head]
                 [:seon.test.run/id :seon.test.run/id]
                 [:seon.test.run/at :seon.test.run/at]
                 [:seon.test.run/git-sha {:optional true} :seon.test.run/git-sha]
                 [:seon.test.run/program-digest :seon.test.run/program-digest]
                 [:seon.test.run/basis-t :seon.test.run/basis-t]
                 [:seon.test.run/branch :seon.test.run/branch]],
                :destination [:map [:seon.test.run/branch :seon.test.run/branch]],
                :completion
                [:and :seon.test.runner/completion
                 [:map [:seon.test.run/provenance :seon.test.run/provenance]]],
                :run
                [:map
                 #:seon.db{:attributes true}
                 [:seon.test.run/published-base-digest {:optional true} :seon.test.run/published-base-digest]
                 [:seon.test.run/overlay-input-digest {:optional true} :seon.test.run/overlay-input-digest]
                 [:seon.test.run/callers-at-head {:optional true} :seon.test.run/callers-at-head]
                 [:seon.test.run/id :seon.test.run/id]
                 [:seon.test.run/at :seon.test.run/at]
                 [:seon.test.run/git-sha {:optional true} :seon.test.run/git-sha]
                 [:seon.test.run/program-digest {:optional true} :seon.test.run/program-digest]
                 [:seon.test.run/basis-t {:optional true} :seon.test.run/basis-t]
                 [:seon.test.run/tested-branch {:optional true} :seon.test.run/tested-branch]
                 [:seon.test.run/cluster {:optional true} :seon.test.run/cluster]
                 [:seon.test.run/input-digest {:optional true} :seon.test.run/input-digest]
                 [:seon.test.run/policy {:optional true} :seon.test.run/policy]
                 [:seon.test.run/include-long? {:optional true} :seon.test.run/include-long?]
                 [:seon.test.run/change-basis-t {:optional true} :seon.test.run/change-basis-t]
                 [:seon.test.run/namespaces {:optional true} :seon.test.run/namespaces]
                 [:seon.test.run/identities {:optional true} :seon.test.run/identities]
                 [:seon.test.run/members {:optional true} :seon.test.run/members]
                 [:seon.test.run/covered-by {:optional true} :seon.test.run/covered-by]
                 [:seon.test.run/exclusions {:optional true} :seon.test.run/exclusions]
                 [:seon.test.run/selection-tx {:optional true} :seon.test.run/selection-tx]
                 [:seon.test.run/deadline {:optional true} :seon.test.run/deadline]
                 [:seon.test.run/branch {:optional true} :seon.test.run/branch]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.test.run/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.test.run/error-request :seon.test.run/error-request]]]

 :seon.test.run/error-request
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]
}
