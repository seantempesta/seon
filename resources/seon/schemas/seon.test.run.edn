#:seon.test.run{:at :inst,
                :git-sha [:re "^[0-9a-f]{40}$"],
                :id [:string {:min 1, :seon.db/identity true}],
                :program-digest [:and {:seon.db/identity false} :seon.source/digest],
                :basis-t :seon.db/basis-t,
                :branch [:and {:description "Durable destination branch of the result commit, addressable in its store. A publication scratch branch is never the destination; tested-branch records execution provenance separately."} :seon.source/branch],
                :tested-branch [:and {:description "Branch of the immutable database tested, when different from the result destination. basis-t belongs to this branch; it must not be interpreted as destination history."} :seon.source/branch],
                :cluster [:and {:description "Explicit authority cluster that owns this run and its results. Required at admission; the optional stored ref sweeps on cluster deletion, leaving authority unavailable."} :seon.db/ref],
                :change-basis-t [:and {:description "Earlier tested basis used to select changes in the same lineage; absent for first-run."} :seon.db/basis-t],
                :members [:set {:seon.db/component true :description "Selected memberships admitted atomically before execution; deleting the run cascades to these components."} :seon.db/ref],
                :covered-by [:set {:description "Existing run members accepted instead of duplicate execution at admission. Optional refs sweep with their targets; a reader must report missing coverage as unknown."} :seon.db/ref],
                :selection-tx [:and {:description "Transaction admitting the complete selection, including zero members. Required at admission; the optional stored ref sweeps if that transaction is removed, leaving selection unavailable."} :seon.db/ref],
                :policy [:enum {:description "Requested gate policy; an execution scope, never an entity discriminator."} :incremental :named :platform :all :full],
                :namespaces [:set {:description "Namespaces explicitly requested at admission; absence means none requested."} :symbol],
                :identities [:set {:description "Test identities explicitly requested at admission."} :qualified-symbol],
                :include-long? [:boolean {:description "Explicit long-test inclusion decision for this request."}],
                :input-digest [:and {:seon.db/identity false :description "Digest of publication inputs outside the program graph observed for this run."} :seon.source/digest],
                :admission
                [:map
                 [:seon.test.run/provenance :seon.test.run/provenance]
                 [:seon.test.run/cluster :seon.test.run/cluster]
                 [:seon.test.run/input-digest :seon.test.run/input-digest]
                 [:seon.test.run/policy :seon.test.run/policy]
                 [:seon.test.run/include-long? :seon.test.run/include-long?]
                 [:seon.test.run/change-basis-t {:optional true} :seon.test.run/change-basis-t]
                 [:seon.test.run/namespaces {:optional true} :seon.test.run/namespaces]
                 [:seon.test.run/identities {:optional true} :seon.test.run/identities]
                 [:seon.test.run/members [:vector :seon.test.member/member]]],
                :immutable [:and {:seon.db/identity false} :seon.test.run/id],
                :immutable-error
                [:map {:seon.error/class true
                       :error/message "must identify the immutable test run"
                       :seon.render/ai seon.error/render-ai
                       :seon.render/html seon.error/render-html}
                 [:seon.test.run/immutable :seon.test.run/immutable]
                 [:seon.error/message :seon.error/message]],
                :unavailable [:= true],
                :unavailable-error
                [:map {:seon.error/class true
                       :error/message "must identify unavailable test execution"
                       :seon.render/ai seon.error/render-ai
                       :seon.render/html seon.error/render-html}
                 [:seon.test.run/unavailable :seon.test.run/unavailable]
                 [:seon.error/message :seon.error/message]],
                :provenance
                [:map
                 [:seon.test.run/id :seon.test.run/id]
                 [:seon.test.run/at :seon.test.run/at]
                 [:seon.test.run/git-sha {:optional true} :seon.test.run/git-sha]
                 [:seon.test.run/program-digest :seon.test.run/program-digest]
                 [:seon.test.run/basis-t :seon.test.run/basis-t]
                 [:seon.test.run/branch :seon.test.run/branch]],
                :destination [:map [:seon.test.run/branch :seon.test.run/branch]],
                :completion
                [:and :seon.test.runner/completion
                 [:map [:seon.test.run/provenance :seon.test.run/provenance]]],
                :run
                [:map
                 #:seon.db{:attributes true}
                 [:seon.test.run/id :seon.test.run/id]
                 [:seon.test.run/at :seon.test.run/at]
                 [:seon.test.run/git-sha {:optional true} :seon.test.run/git-sha]
                 [:seon.test.run/program-digest {:optional true} :seon.test.run/program-digest]
                 [:seon.test.run/basis-t {:optional true} :seon.test.run/basis-t]
                 [:seon.test.run/tested-branch {:optional true} :seon.test.run/tested-branch]
                 [:seon.test.run/cluster {:optional true} :seon.test.run/cluster]
                 [:seon.test.run/input-digest {:optional true} :seon.test.run/input-digest]
                 [:seon.test.run/policy {:optional true} :seon.test.run/policy]
                 [:seon.test.run/include-long? {:optional true} :seon.test.run/include-long?]
                 [:seon.test.run/change-basis-t {:optional true} :seon.test.run/change-basis-t]
                 [:seon.test.run/namespaces {:optional true} :seon.test.run/namespaces]
                 [:seon.test.run/identities {:optional true} :seon.test.run/identities]
                 [:seon.test.run/members {:optional true} :seon.test.run/members]
                 [:seon.test.run/covered-by {:optional true} :seon.test.run/covered-by]
                 [:seon.test.run/selection-tx {:optional true} :seon.test.run/selection-tx]
                 [:seon.test.run/branch {:optional true} :seon.test.run/branch]]}
