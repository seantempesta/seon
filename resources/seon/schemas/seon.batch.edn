#:seon.batch
{:world [:map {:description "The one world an entrant hands the path; every stage reads it from the request, never from an ambient binding. It extends :seon.db/custody-request (the connection, whose current value is the database a call omitting one is supplied); it holds no database value. Built by seon.turn.world/agent-world, test-agent-world, jvm-world or merge-world."}
         [:seon.boot/cluster-name :seon.boot/cluster-name]
         [:seon.agent/branch {:optional true} :seon.agent/branch]
         [:seon.db/connection {:optional true} :seon.db/connection]
         [:seon.db/writer {:optional true} :seon.db/writer]
         [:seon.sci.eval/ctx {:optional true} :seon.sci.eval/ctx]
         [:seon.sci.eval/base-ctx {:optional true :description "The cluster context the agent's fork came from: a reaching test's before-world forks it at the basis."} :seon.sci.eval/ctx]
         [:seon.env/environment {:optional true :description "Where the fault stage records: the execution's environment."} :seon.env/environment]
         [:seon.db.process/id {:optional true} :seon.db.process/id]
         [:seon.batch/scope {:optional true} :seon.batch/scope]
         [:seon.batch/sink {:optional true :description "This world's armed-call counts (seon.batch/sink): a test agent's counters see only its own calls."} :seon.batch/sink]
         [:seon.batch/reads {:optional true :description "One form's read sink: the atom seon.turn.world/with-world binds as seon.db/*read-evidence-sink*, so the form's reads and those of work it starts land in it."} :seon.db/read-evidence-sink]
         [:seon.batch/in-flight {:optional true} :seon.batch/owned]
         [:seon.batch/stamped-ns {:optional true :description "When this world last stamped a transaction (its start before the first): seon.profile/transaction-observation reads and moves it, so a transaction's :seon.db.transaction/ms is the work since the world's previous one."} :seon.batch/stamped-ns]
         [:seon.batch/ordinal {:optional true :description "The ordinal of the form this world is running."} :seon.cluster.eval/ordinal]
         [:seon.batch/form-sink {:optional true :description "The running form's own call sink: the evaluator binds it as the world's sink around the form's code (seon.sci.eval/evaluate), so the definitions the form executed are its code evidence."} :seon.batch/sink]
         [:seon.agent/id {:optional true} :seon.agent/id]
         [:seon.task/id {:optional true} :seon.task/id]
         [:seon.render/profile {:optional true} :seon.render/profile]
         [:seon.sci.eval/time-limit-ms {:optional true} :seon.sci.eval/time-limit-ms]
         [:seon.turn/id {:optional true} :seon.turn/id]
         [:seon.batch/settlement {:optional true} [:map [:seon.db/connection :seon.db/connection]]]
         [:seon.store/store {:optional true :description "The execution's store (its environment's): branch operations read its roster."} :seon.store/store]
         [:seon.agent/routing {:optional true :description "The execution's agent routing (its environment's): retiring a hosted agent reads it."} :seon.agent/routing]]
 :text [:string {:description "Exact text of a batch: what is read, evaluated, stored and rendered."}]
 :start-ns :symbol
 :mode [:enum :reply :code]
 :segmented [:map {:description "A text's forms as the forgiving scan finds them (seon.sci.forgive/segments): each construct's source, a failed read's span included, the text above it as its comment, the repairs made from its start to the next segment, and all the text's repairs."}
             [:seon.batch/segments [:vector [:map [:seon.batch/source :string]
                                             [:seon.batch/comment {:optional true} :string]
                                             [:seon.batch/repairs {:optional true} :seon.batch/repairs]]]]
             [:seon.batch/repairs {:optional true} :seon.batch/repairs]]
 :span [:tuple {:description "A top-level form's span in the forgiven text: start, end, and its start's line and column."} nat-int? nat-int? pos-int? pos-int?]
 :spans [:vector :seon.batch/span]
 :repair [:map {:description "One change the forgiving scan made to an unbalanced text: closers (or a string's quote) inserted on a line, or a stray closer dropped from it."}
          [:seon.batch/line pos-int?]
          [:seon.batch/at {:description "Where in the forgiven text the change was made; the segment whose span starts at or before it owns the repair."} nat-int?]
          [:seon.batch/inserted {:optional true} :string]
          [:seon.batch/dropped {:optional true} :string]]
 :repairs [:vector :seon.batch/repair]
 :forgiven [:map {:description "A text forgiven by seon.sci.forgive/forgive: the text, each top-level form's span in it, and the repairs when its delimiters did not balance."}
            [:seon.batch/text :seon.batch/text]
            [:seon.batch/spans :seon.batch/spans]
            [:seon.batch/repairs {:optional true} :seon.batch/repairs]]
 :pos nat-int?
 :reader [:any {:description "The reader over one form's span (seon.sci.forgive/step); a host object, never stored."}]
 :text-version [:map
                [:seon.batch/text :seon.batch/text]
                [:seon.batch/pos :seon.batch/pos]
                [:seon.batch/spans {:optional true :description "The spans still to read; present once the text is forgiven."} :seon.batch/spans]
                [:seon.batch/repairs {:optional true} :seon.batch/repairs]]
 :read-stage [:map {:description "The read itself, supplied as a value: read one form from the reader, or answer the given eof sentinel."}
              [:seon.batch/read [:=> [:cat :seon.batch/reader :any] :any]]]
 :last-code-end nat-int?
 :line-cursor [:map {:description "Where the last read form began: its text, offset, line and column. The next form's position is scanned on from here (seon.batch/line-cursor), so a batch's positions cost its text once."}
               [:seon.batch/text :seon.batch/text] [:seon.batch/pos :seon.batch/pos]
               [:seon.batch/line pos-int?] [:seon.batch/column pos-int?]]
 :read-state [:map
              [:seon.batch/version :seon.batch/text-version]
              [:seon.batch/last-code-end {:optional true} :seon.batch/last-code-end]]
 :version :seon.batch/text-version
 :form [:any {:description "One read form, as the reader answered it."}]
 :start nat-int?
 :end nat-int?
 :read-error [:any {:description "A form's read failure: the reader's error, answered once as that form's error, never evaluated."}]
 :eof [:= true]
 :unread-from nat-int?
 :reason [:or :keyword :string]
 :read-step [:or
             [:map [:seon.batch/form :seon.batch/form] [:seon.batch/start :seon.batch/start]
              [:seon.batch/end :seon.batch/end] [:seon.batch/version :seon.batch/text-version]]
             [:map [:seon.batch/read-error :seon.batch/read-error] [:seon.batch/start :seon.batch/start]
              [:seon.batch/end :seon.batch/end] [:seon.batch/version :seon.batch/text-version]]
             [:map [:seon.batch/eof :seon.batch/eof] [:seon.batch/version :seon.batch/text-version]]]
 :op [:enum :bind :unmap :remove-ns :namespace :expansion]
 :sym :qualified-symbol
 :ns :symbol
 :kind [:enum :root :extend]
 :def-origin [:or
              [:map [:line pos-int?] [:column pos-int?]
               [:end-line {:optional true} pos-int?] [:end-column {:optional true} pos-int?]
               [:expanded-by {:optional true} :symbol]]
              [:map {:description "A definition no reader located (made through eval): its origin is that it has no source position."}
               [:reason [:= :no-source-position]]]]
 :origin :seon.batch/def-origin
 :member-of :symbol
 :arm-error :string
 :var [:any {:description "The live SCI Var written; held only during the call."}]
 :write [:multi {:dispatch :seon.batch/op}
         [:bind [:map [:seon.batch/op [:= :bind]] [:seon.batch/sym {:optional true} :seon.batch/sym]
                 [:seon.batch/kind :seon.batch/kind] [:seon.batch/var :seon.batch/var]
                 [:seon.batch/origin {:optional true} :seon.batch/origin]
                 [:seon.batch/member-of {:optional true} :seon.batch/member-of]
                 [:seon.batch/arm-error {:optional true} :seon.batch/arm-error]
                 [:seon.batch/fn? {:optional true} :boolean]
                 [:seon.batch/ordinal {:optional true} :seon.cluster.eval/ordinal]]]
         [:unmap [:map [:seon.batch/op [:= :unmap]] [:seon.batch/sym :seon.batch/sym]
                  [:seon.batch/ordinal {:optional true} :seon.cluster.eval/ordinal]]]
         [:remove-ns [:map [:seon.batch/op [:= :remove-ns]] [:seon.batch/ns :seon.batch/ns]
                      [:seon.batch/ordinal {:optional true} :seon.cluster.eval/ordinal]]]
         [:expansion [:map {:description "One macro call SCI expanded during the evaluation: the call occurrence's authored span, its macro and the expansion, which the per-form analyzer's hook substitutes at exactly that occurrence."}
                      [:seon.batch/op [:= :expansion]] [:seon.batch/macro :symbol]
                      [:seon.batch/call-span [:tuple pos-int? pos-int? pos-int? pos-int?]]
                      [:seon.batch/expansion :seon.batch/form]
                      [:seon.batch/ordinal {:optional true} :seon.cluster.eval/ordinal]]]
         [:namespace [:map [:seon.batch/op [:= :namespace]] [:seon.batch/ns :seon.batch/ns]
                      [:seon.batch/ordinal {:optional true} :seon.cluster.eval/ordinal]]]]
 :join-kind [:enum {:description "How a definition write joined the form's analysis; :value is a def whose root is neither a function nor a test, the agent's private state."} :matched :member :rebound :unanalyzed :value]
 :join-reason [:enum {:description "Why a definition write joined no analyzed definition; :no-complete-span is an origin without its end position (seon.turn.batch/join-write)."} :no-definition-at-origin :ambiguous :captures-locals :no-source :not-a-function :no-complete-span]
 :join [:map [:seon.batch/join :seon.batch/join-kind]
        [:seon.batch/sym {:optional true} :seon.batch/sym]
        [:seon.batch/reason {:optional true} :seon.batch/join-reason]
        [:seon.batch/member-of {:optional true} :seon.batch/member-of]
        [:seon.batch/captured {:optional true} [:set :symbol]]
        [:seon.batch/other-namespace {:optional true} :boolean]
        [:seon.batch/definition {:optional true} :map]]
 :note [:or
        [:map [:seon.schema/key :qualified-keyword] [:seon.schema/installed? [:= false]] [:seon.error/message :string]]
        [:map [:seon.batch/sym :seon.batch/sym] [:seon.batch/arm-error :seon.batch/arm-error]]]
 :change [:map
          [:seon.batch/entities [:vector :seon.program/row]]
          [:seon.batch/removals [:vector :symbol]]
          [:seon.batch/schema-keys [:set :qualified-keyword]]
          [:seon.batch/namespaces [:set :symbol]]
          [:seon.batch/private {:optional true} [:vector :seon.batch/join]]
          [:seon.batch/notes {:optional true} [:vector :seon.batch/note]]]
 :stage :keyword
 :diagnostic [:map [:seon.error/message :string] [:seon.batch/stage :seon.batch/stage]
              [:seon.batch/ordinal {:optional true} :seon.cluster.eval/ordinal]
              [:seon.error/throwable-class {:optional true} :string]
              [:seon.error/data {:optional true} :map]
              [:seon.error/throwable {:optional true :description "The live failure, recorded by the fault stage with its frames (who produced it); never stored or printed."} :seon.error/throwable]]
 :value [:any {:description "The form's live value, kept whole; never stored."}]
 :outcome [:or {:description "An evaluate stage's answer: the value or the error, with the entrant's own entry keys."}
           [:map [:seon.batch/value :seon.batch/value]
            [:seon.batch/evaluation {:optional true} :seon.batch/evaluation]
            [:seon.batch/facts-refused {:optional true} :seon.batch/facts-refused]]
           [:map [:seon.batch/error :seon.batch/error]
            [:seon.batch/evaluation {:optional true} :seon.batch/evaluation]]]
 :error [:any {:description "The form's thrown failure, kept whole; its error value rides :seon.batch/error-value."}]
 :facts-refused [:map {:description "An evaluate stage's refusal of its own form's facts (the loaded program changed while the form ran): the value is kept, the facts are not proposed."}
                 [:seon.error/message :string]]
 :executed-key [:tuple {:description "An executed definition: its symbol and the digest its installed callable held, nil when unknown."} :qualified-symbol [:maybe :seon.program/definition-digest]]
 :executed [:map-of :seon.batch/executed-key nat-int?]
 :call-count nat-int?
 :call-profile [:map {:description "One evaluation's armed calls, and each function called more than seon.batch/repeated-calls times in it, as [sym calls ms], most calls first: repetition visible at the evaluation that made it."}
                [:seon.batch/call-count :seon.batch/call-count]
                [:seon.batch/repeated {:optional true} [:vector [:tuple :qualified-symbol pos-int? nat-int?]]]]
 :evidence [:enum {:description "Whether a form's frozen evidence is all of it: :pending when work it owns (a future it started) had not exited."} :complete :pending]
 :owned [:fn {:description "A form's owned-work count: a java.util.concurrent.atomic.AtomicLong the kernel's future-call raises and each future's exit lowers." :gen/gen seon.turn.world/owned-generator} seon.batch/owned?]
 :evaluation [:any {:description "The entrant's own record of the evaluation (a turn's :seon.sci.eval/evaluation), kept on the entry."}]
 :facts-error [:map {:description "The refusal of this form's facts, by the writer or while deriving them (a removal whose referrers survive): its logged return value. The facts were not proposed."}
               [:seon.error/message :string]]
 :entry [:map {:description "One top-level form: its value or error, published the moment evaluation returned, then where it came from and what its facts became."}
         [:seon.batch/ordinal :seon.cluster.eval/ordinal]
         [:seon.batch/value {:optional true} :seon.batch/value]
         [:seon.batch/error {:optional true} :seon.batch/error]
         [:seon.batch/duration-ms {:description "Evaluation alone, to the value's return."} number?]
         [:seon.batch/allocated-bytes {:optional true :description "Bytes the evaluating thread allocated during the evaluation (HotSpot ThreadMXBean); absent when it ran on a virtual thread, for which HotSpot keeps no count."} nat-int?]
         [:seon.batch/total-ms {:optional true :description "Evaluation, observation and the one print."} number?]
         [:seon.batch/source {:optional true} :string]
         [:seon.batch/line {:optional true} pos-int?]
         [:seon.batch/column {:optional true} pos-int?]
         [:seon.batch/ns-before {:optional true} :symbol]
         [:seon.batch/ns-after {:optional true} :symbol]
         [:seon.batch/change {:optional true} :seon.batch/change]
         [:seon.batch/facts-error {:optional true} :seon.batch/facts-error]
         [:seon.batch/private {:optional true} [:vector :seon.batch/join]]
         [:seon.batch/notes {:optional true} [:vector :seon.batch/note]]
         [:seon.batch/shown {:optional true} :string]
         [:seon.batch/form {:optional true} :seon.batch/form]
         [:seon.batch/evaluation {:optional true} :seon.batch/evaluation]
         [:seon.batch/facts-refused {:optional true} :seon.batch/facts-refused]
         [:seon.batch/refused-value {:optional true :description "A value a publication refused (an early disposition), kept beside its refusal."} :seon.batch/value]
         [:seon.batch/reads {:optional true} [:vector :any]]
         [:seon.batch/executed {:optional true} :seon.batch/executed]
         [:seon.batch/call-profile {:optional true} :seon.batch/call-profile]
         [:seon.batch/evidence {:optional true} :seon.batch/evidence]
         [:seon.batch/in-flight {:optional true} pos-int?]
         [:seon.batch/owned {:optional true} :seon.batch/owned]
         [:seon.batch/read-sink {:optional true :description "The form's live read sink, kept to tell a read after the freeze (work the form owns that outlived it)."} :seon.db/read-evidence-sink]
         [:seon.batch/shown-map {:optional true :description "The show stage's whole shown value (size keys, renderer, diagnostics), kept beside the text."} :map]]
 :applied :boolean
 :tx-count nat-int?
 :stamped-ns [:fn {:error/message "must be a java.util.concurrent.atomic.AtomicLong" :description "A world's clock: System/nanoTime of its previous transaction stamp." :gen/gen seon.turn.world/owned-generator} seon.batch/stamped-clock?]
 :sink [:fn {:description "A per-world call sink: java.util.concurrent.ConcurrentHashMap of executed definition [sym digest] -> [calls nanos self-nanos calls-stamped self-stamped] (java.util.concurrent.atomic.AtomicLongArray, seon.profile/new-adder)." :gen/gen seon.turn.world/sink-generator} seon.batch/sink?]
 :printed [:map {:description "The show stage's answer: the one print and its whole shown value, whose diagnostics (a renderer that refused) are the agent's."}
           [:seon.batch/shown :string]
           [:seon.batch/shown-map {:optional true} :map]]
 :scope [:map-of {:description "A running evaluation's observation scope: the observer's dynamic bindings (Var -> value), carried in its world so any thread re-establishing the world observes that evaluation."} :any :any]
 :storage-error :string
 :writer-refusal [:map {:description "The settlement writer's refusal of the recording: kept beside the values as data, and delivered as a diagnostic through the fault stage."}
                  [:seon.error/message :string]]
 :settled [:map {:closed true :description "What a settlement answers of the state it settled: the program and working value, and per published ordinal only its facts error. It never replaces or drops an entry (seon.batch/settled-into)."}
           [:seon.batch/entries {:optional true} [:vector [:map [:seon.batch/ordinal :seon.cluster.eval/ordinal]
                                                           [:seon.batch/facts-error {:optional true} :seon.batch/facts-error]]]]
           [:seon.batch/program {:optional true} :map]
           [:seon.batch/working {:optional true} :seon.db/database-value]]
 :commit [:or
          [:map [:seon.batch/applied :seon.batch/applied] [:seon.batch/tx-count :seon.batch/tx-count]
           [:seon.batch/measurement-error {:optional true :description "The settle's measuring failed (seon.profile.measurement/significant-tx); the commit went on without measurements."} :seon.error/base]
           [:seon.batch/after {:optional true} :seon.db/database-value]
           [:seon.batch/first-refusal {:optional true} :map]
           [:seon.batch/settled {:optional true} :seon.batch/settled]]
          [:map [:seon.batch/writer-refusal :seon.batch/writer-refusal] [:seon.batch/first-refusal {:optional true} :map]]
          [:map [:seon.batch/storage-error :seon.batch/storage-error]]]
 :failure-source [:map {:description "What seon.batch/produced-failures reads of a batch: each entry's ordinal, its failure and the definitions its change published. Open: a full :seon.batch/batch satisfies it."}
                  [:seon.batch/entries [:vector [:map
                                                 [:seon.batch/ordinal :seon.cluster.eval/ordinal]
                                                 [:seon.batch/error {:optional true} :seon.batch/error]
                                                 [:seon.batch/change {:optional true} [:map [:seon.batch/entities {:optional true} [:vector :map]]]]]]]]
 :batch [:map {:description "What the one function answers. Absent keys are stages not run."}
         [:seon.batch/entries [:vector :seon.batch/entry]]
         [:seon.batch/writes [:vector :seon.batch/write]]
         [:seon.batch/diagnostics [:vector :seon.batch/diagnostic]]
         [:seon.batch/text {:optional true} :seon.batch/text]
         [:seon.batch/unread {:optional true} [:map [:seon.batch/unread-from :seon.batch/unread-from]
                                               [:seon.batch/reason :seon.batch/reason]]]
         [:seon.batch/program {:optional true} :map]
         [:seon.batch/commit {:optional true} :seon.batch/commit]
         [:seon.batch/faults {:optional true} [:vector :any]]
         [:seon.batch/timings {:optional true} [:map-of :keyword number?]]
         [:seon.batch/total-ms {:optional true} number?]]
 :folding [:map {:description "The batch while the fold builds it, as each step reads and answers it. Its entries and writes are validated once each, where they are published or replaced (seon.batch/with-entry, seon.batch/with-writes), never re-walked per step; evaluate-batch answers the whole :seon.batch/batch."}
           [:seon.batch/entries vector?]
           [:seon.batch/writes vector?]
           [:seon.batch/diagnostics vector?]
           [:seon.batch/timings {:optional true} [:map-of :keyword number?]]]
 :request [:map {:description "One batch request: text, basis, and every stage as a value. An entrant is a choice of stage values."}
           [:seon.batch/text :seon.batch/text]
           [:seon.batch/world :seon.batch/world]
           [:seon.batch/basis {:description "The value the batch starts from: its world connection's value when the entrant built the request (seon.turn.world/basis), or the value the entrant read (a turn). The fold's working value starts here; the writer's stale guard compares against it. No world holds a database value."} :seon.db/database-value]
           [:seon.batch/working {:optional true :description "The batch's working value, on the request the fold hands a form's stages (evaluate, show, publish)."} :seon.db/database-value]
           [:seon.batch/start-ns {:optional true} :seon.batch/start-ns]
           [:seon.batch/mode {:optional true} :seon.batch/mode]
           [:seon.batch/read-state [:=> [:cat :string] :seon.batch/read-state]]
           [:seon.batch/read-next [:=> [:cat :map :seon.batch/read-state] :seon.batch/read-step]]
           [:seon.batch/first-ordinal {:optional true :description "The ordinal of the batch's first form (a turn resumed at its first unevaluated row)."} :seon.cluster.eval/ordinal]
           [:seon.batch/evaluate [:=> [:cat :map :any :seon.db/database-value] :seon.batch/outcome]]
           [:seon.batch/publish {:optional true :description "The entrant's last word on a published entry, in the form's world: it may replace it and stop reading."}
            [:=> [:cat :map :map :seon.batch/entry] [:map [:seon.batch/entry :seon.batch/entry] [:seon.batch/stop? {:optional true} :boolean]]]]
           [:seon.batch/ns-name [:=> [:cat :map] :symbol]]
           [:seon.batch/around {:optional true} [:=> [:cat :map [:=> [:cat] :any]] :any]]
           [:seon.batch/observe {:optional true}
            [:=> [:cat :map :seon.db/database-value [:=> [:cat :seon.batch/write] :any] [:=> [:cat] :any]] :any]]
           [:seon.batch/derive {:optional true}
            [:=> [:cat :map :map :seon.db/database-value :seon.batch/entry [:vector :seon.batch/write]]
             [:map [:seon.batch/change :seon.batch/change] [:seon.batch/derive-state :map]]]]
           [:seon.batch/facts {:optional true} [:=> [:cat :map :seon.db/database-value :seon.batch/change] :seon.store/transaction-data]]
           [:seon.batch/apply {:optional true}
            [:=> [:cat :map :seon.db/database-value :seon.store/transaction-data :seon.batch/change]
             [:or [:map [:seon.batch/working :seon.db/database-value]] [:map [:seon.batch/refusal :map]]]]]
           [:seon.batch/fold {:optional true} [:=> [:cat :map :map :seon.batch/change] :map]]
           [:seon.batch/settle {:optional true} [:=> [:cat :map :seon.batch/batch] :seon.batch/commit]]
           [:seon.batch/within {:optional true :description "The entrant's world boundary: (within world thunk) establishes the world on this thread (custody, read basis, seon.batch/*world*) around each evaluation and print (seon.turn.world/with-world)."} [:=> [:cat :seon.batch/world [:=> [:cat] :seon.batch/value]] :seon.batch/value]]
           [:seon.batch/show {:optional true} [:=> [:cat :map :seon.batch/entry] [:or :string :seon.batch/printed]]]
           [:seon.batch/fault {:optional true} [:=> [:cat :map :seon.batch/diagnostic] :any]]
           ]
 :reply [:map {:description "The one reply: a Seon agent's next context and the MCP tool's JSON carry the same data."}
         [:seon.batch/evaluations [:vector [:map [:seon.batch/ordinal :seon.cluster.eval/ordinal] [:seon.batch/shown :string]
                                             [:seon.batch/duration-ms {:optional true} number?]
                                             [:seon.batch/error? {:optional true} :boolean]
                                             [:seon.batch/facts-error {:optional true} :string]
                                             [:seon.batch/notes {:optional true} [:vector :seon.batch/note]]
                                             [:seon.batch/private {:optional true} [:vector :map]]]]]
         [:seon.batch/diagnostics [:vector :string]]
         [:seon.batch/unread {:optional true} :map]
         [:seon.batch/faults {:optional true} [:vector :any]]
         [:seon.batch/commit {:optional true} :map]]}
