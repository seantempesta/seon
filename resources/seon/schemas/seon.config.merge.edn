;; Merges (next's task config keys; a task's own :seon.config.merge/* and
;; :seon.config.agent/max-turns override the root's).
{:seon.config.merge/max-running [:int {:min 1 :seon.config/unit "merges" :description "Merge tasks working at once, when the definitions they change are disjoint; each ready one merges alone (1 is git's queue)."}]
 :seon.config.merge/max-conflicts [:int {:min 0 :seon.config/unit "conflicts" :description "Conflicts past which a merge run is refused (too many to resolve)."}]
 :seon.config.merge/max-merge-turns [:int {:min 0 :seon.config/unit "turns" :description "Merge turns without green past which the merge run ends."}]}
