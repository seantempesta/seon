;; Merges (next's task config keys; a task's own :seon.config.merge/* and
;; :seon.config.agent/max-turns override the root's).
{
 ;; Unit: merge tasks working at once. They work together only when the definitions they change are
 ;; disjoint; each ready one still merges alone, through the writer's one :merge. 1 is git's
 ;; one-at-a-time merge queue. Provenance: DECISIONS (root's calls on R3's questions): more stays
 ;; off until the par-200 hang and root memory growth with concurrent merges are fixed.
 :seon.config.merge/max-running [:int {:default 1 :min 1 :seon.config/unit "merges" :description "Merge tasks working at once, when the definitions they change are disjoint; each ready one merges alone (1 is git's queue)."}]
 ;; Unit: conflicts. A merge run whose merge of main has more is refused
 ;; (:too-many-conflicts); a task's own :seon.config.merge/max-conflicts wins.
 :seon.config.merge/max-conflicts [:int {:default 3 :min 0 :seon.config/unit "conflicts" :description "Conflicts past which a merge run is refused (too many to resolve)."}]
 ;; Unit: merge turns without green. Past it the merge run ends (:merge-turns); a task's
 ;; own :seon.config.merge/max-merge-turns wins.
 :seon.config.merge/max-merge-turns [:int {:default 2 :min 0 :seon.config/unit "turns" :description "Merge turns without green past which the merge run ends."}]}
