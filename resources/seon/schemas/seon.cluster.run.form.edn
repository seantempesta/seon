#:seon.cluster.run.form{:form
                        [:map
                         {:seon.db/attributes true,
                          ;; The frozen form's own projections are the
                          ;; evaluation's: one entity per (run, ordinal) is
                          ;; what an agent reads, and it reads it through the
                          ;; one REPL grammar.
                          :seon.render/ai seon.repl/render-ai,
                          :seon.render/html seon.repl/render-html}
                         [:seon.cluster.run.form/id
                          :seon.cluster.run.form/id]
                         [:seon.cluster.run.form/run
                          :seon.cluster.run.form/run]
                         [:seon.cluster.run.form/ordinal
                          :seon.cluster.run.form/ordinal]
                         [:seon.cluster.run.form/author
                          :seon.cluster.run.form/author]
                         [:seon.cluster.run.form/source
                          :seon.cluster.run.form/source]
                         [:seon.cluster.run.form/ns
                          {:optional true}
                          :seon.cluster.run.form/ns]
                         [:seon.cluster.run.form/refreshes
                          {:optional true}
                          :seon.cluster.run.form/refreshes]
                         ],
                        :author [:enum :agent :system],
                        :id [:string {:min 1, :seon.db/identity true}],
                        :ns :seon.db/ref,
                        :ordinal [:int {:min 0}],
                        :refreshes
                        [:and {:seon.db/unique true} :seon.db/ref],
                        :run :seon.db/ref,
                        :source
                        [:string {:min 1, :seon.db/no-history? true}]}
