;; The check harness's time (seon.check; docs/clocks.md "a check's measurement, and a check's ping").
{:seon.config.check/ping-ms [:int {:min 1 :seon.config/unit "ms" :description "How long a check's Flow ping waits for a proc to take its control message; past it the proc is recorded :blocked."}]
 :seon.config.check/step-end-factor [:int {:min 2 :seon.config/unit "times" :description "How many times its median measured run a bin/check step may run before it is ended, its evidence captured first, and said as the signal STEP-OVERRAN, no verdict and nothing failed (floored at :seon.config.agent/stall-ms); and how many times its last run a test bin/test runs may run before bin/stalls ends its shard, its evidence captured first, and it is red as OVERRAN (floored at this factor times :seon.config.agent/stall-ms). See docs/clocks.md#time-decides-the-owners-exceptions."}]
 :seon.config.check/hold-ms [:int {:min 1 :seon.config/unit "ms" :description "The window over which a check measures that something does not happen (a paused proc's request held, its flood not taken)."}]
 :seon.config.check/pages-ms [:int {:min 0 :seon.config/unit "ms" :description "The window after scale's kills over which it measures the memory the kernel returns (reported, not checked)."}]
 :seon.config.check/sample-ms [:int {:min 1 :seon.config/unit "ms" :description "The window between scale-work's readings of the machine's available memory and of its processes' footprints (a measurement, never a dependency)."}]}
