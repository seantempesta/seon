;; Cumulative inclusive call timing on the armed wrappers (src/seon/profile.clj).
;; Values only: nothing here is stored, so no Datahike attribute derives from it.
;; What is stored: the transaction's work (seon.db.transaction.edn).
{:seon.profile/sym [:qualified-symbol {:description "The installed callable's symbol."}]
 :seon.profile/digest :seon.program/definition-digest
 :seon.profile/definition-digests
 [:map-of {:description "Installer-supplied digests of the callables it arms, by symbol."}
  :qualified-symbol :seon.program/definition-digest]
 :seon.profile/scope [:enum {:description "Host: a loaded Var's JVM wrapper, attributed to no cluster. Context: one SCI installation's wrapper."}
                      :seon.profile/host :seon.profile/context]
 :seon.profile/context [:string {:min 1 :description "The installer's name for the SCI context, when it supplied one."}]
 :seon.profile/cold-calls [:int {:min 0 :description "How many of the callable's first calls in this process are cold (:seon.config.fn.cost/cold-calls at arming); absent: none."}]
 :seon.profile/ordinal [:fn {:error/message "must be a java.util.concurrent.atomic.AtomicLong"
                             :description "The cell's counted entries in this process, up to its cold calls: the call order that makes a call cold."}
                        seon.batch/stamped-clock?]
 :seon.profile/identity
 [:map
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/digest {:optional true} :seon.profile/digest]
  [:seon.profile/scope :seon.profile/scope]
  [:seon.profile/context {:optional true} :seon.profile/context]
  [:seon.profile/cold-calls {:optional true} :seon.profile/cold-calls]]
 :seon.profile/adder [:fn {:error/message "must be a java.util.concurrent.atomic.LongAdder"} seon.profile/adder?]
 :seon.profile/accumulator [:fn {:error/message "must be a java.util.concurrent.atomic.LongAccumulator"} seon.profile/accumulator?]
 :seon.profile/histogram [:fn {:error/message "must be an array of 40 java.util.concurrent.atomic.LongAdder"
                                 :description "The log2 latency histogram: bucket b counts outermost calls of [2^(b-1), 2^b) ns; calls are its sum."}
                           seon.profile/histogram?]
 :seon.profile/total-counter :seon.profile/adder
 :seon.profile/self-counter :seon.profile/adder
 :seon.profile/max-counter :seon.profile/accumulator
 :seon.profile/entry-counter [:and {:description "Outermost entries; in flight is entries minus calls."} :seon.profile/adder]
 :seon.profile/throw-counts [:fn {:error/message "must be a java.util.concurrent.ConcurrentHashMap of Class to LongAdder"
                                  :description "Outermost calls that threw, by the thrown class."}
                            seon.profile/throw-counts?]
 :seon.profile/entered [:fn {:error/message "must be a java.lang.ThreadLocal"
                             :description "Set on a thread while it is inside this cell's outermost call; a re-entry on that thread is not counted again."}
                        seon.profile/thread-local?]
 :seon.profile/cell
 [:map
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/digest {:optional true} :seon.profile/digest]
  [:seon.profile/scope :seon.profile/scope]
  [:seon.profile/context {:optional true} :seon.profile/context]
  [:seon.profile/histogram :seon.profile/histogram]
  [:seon.profile/total-counter :seon.profile/total-counter]
  [:seon.profile/self-counter :seon.profile/self-counter]
  [:seon.profile/max-counter :seon.profile/max-counter]
  [:seon.profile/entry-counter :seon.profile/entry-counter]
  [:seon.profile/throw-counts :seon.profile/throw-counts]
  [:seon.profile/entered :seon.profile/entered]
  [:seon.profile/ordinal :seon.profile/ordinal]
  [:seon.profile/cold-calls {:optional true} :seon.profile/cold-calls]]
 :seon.profile/held-cell
 [:map {:description "A live roster member as a read answers it. seon.profile/cell, the roster's only writer, checked its counters when it made the cell, so a read checks the cell's identity only."}
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/digest {:optional true} :seon.profile/digest]
  [:seon.profile/scope :seon.profile/scope]
  [:seon.profile/context {:optional true} :seon.profile/context]]
 :seon.profile/calls [:int {:min 0 :description "Completed outermost calls per thread (a re-entry through the same wrapper is inside its caller's): returns and throws both count."}]
 :seon.profile/total-ms [:int {:min 0 :description "Inclusive wall milliseconds."}]
 :seon.profile/self-ms [:int {:min 0 :description "Wall milliseconds in the definition's own body and unarmed callees: total less its counted armed callees'."}]
 :seon.profile/mean-us [:int {:min 0 :description "Inclusive wall microseconds per call."}]
 :seon.profile/self-mean-us [:int {:min 0 :description "Self microseconds per call (self-ms over calls): a wrapper whose callback does the work is near zero."}]
 :seon.profile/max-ms [:int {:min 0 :description "Lifetime maximum of one call, inclusive."}]
 :seon.profile/throws [:int {:min 0}]
 :seon.profile/in-flight [:int {:min 0 :description "Outermost calls entered and not yet returned, approximately (two counters read apart)."}]
 :seon.profile/p50-us [:int {:min 0 :description "The median's histogram bucket upper edge, in microseconds: within a factor of two."}]
 :seon.profile/p99-us [:int {:min 0 :description "The 99th percentile's histogram bucket upper edge, in microseconds: within a factor of two."}]
 :seon.profile/throws-by-class [:map-of {:description "Outermost calls that threw, by the thrown class's name: throws used as control flow show here."} :string [:int {:min 1}]]
 :seon.profile/observation
 [:map
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/digest {:optional true} :seon.profile/digest]
  [:seon.profile/scope :seon.profile/scope]
  [:seon.profile/context {:optional true} :seon.profile/context]
  [:seon.profile/calls :seon.profile/calls]
  [:seon.profile/total-ms :seon.profile/total-ms]
  [:seon.profile/self-ms :seon.profile/self-ms]
  [:seon.profile/mean-us :seon.profile/mean-us]
  [:seon.profile/self-mean-us :seon.profile/self-mean-us]
  [:seon.profile/max-ms {:optional true} :seon.profile/max-ms]
  [:seon.profile/throws {:optional true} :seon.profile/throws]
  [:seon.profile/in-flight {:optional true} :seon.profile/in-flight]
  [:seon.profile/p50-us {:optional true} :seon.profile/p50-us]
  [:seon.profile/p99-us {:optional true} :seon.profile/p99-us]
  [:seon.profile/throws-by-class {:optional true} :seon.profile/throws-by-class]]
 :seon.profile/counts [:fn {:error/message "must be a long array of 40 histogram counts and the throws"
                            :description "A cell's histogram counts followed by its throws, [b0 ... b39 throws]."}
                       seon.profile/counts?]
 :seon.profile/world-counter [:fn {:error/message "must be a java.util.concurrent.atomic.AtomicLongArray"
                                   :description "A world's counter array: one executed definition's counter in its call sink, [calls nanos self-nanos calls-at-last-transaction self-at-last-transaction nanos-at-last-transaction] for all its calls, then the same six for its cold calls alone (twelve slots, seon.profile/new-adder), or its writer meter (six slots, seon.db/writer-meter)."}
                              seon.profile/world-counter?]
 :seon.profile/observed [:int {:min 0}]
 :seon.profile/over-second-count [:int {:min 0 :description "Definitions with a call over one second (inclusive)."}]
 :seon.profile/call-row
 [:map {:description "One definition's calls, self and inclusive milliseconds and its longest call."}
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/calls :seon.profile/calls]
  [:seon.profile/self-ms :seon.profile/self-ms]
  [:seon.profile/total-ms :seon.profile/total-ms]
  [:seon.profile/max-ms :seon.profile/max-ms]
  [:seon.profile/throws {:optional true} [:int {:min 1}]]
  [:seon.profile/scope {:optional true} [:= :seon.profile/context]]]
 :seon.profile/by-self [:vector {:description "The definitions ranked by self time, then inclusive total."} :seon.profile/call-row]
 :seon.profile/summary
 [:map
  [:seon.profile/observed :seon.profile/observed]
  [:seon.profile/over-second-count :seon.profile/over-second-count]
  [:seon.profile/by-self :seon.profile/by-self]]
 :seon.profile/thunk [:=> {:description "A function of no arguments whose one call is measured."} [:cat]
                      [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                             :seon.schema.admission/reason "seon.profile/measure returns whatever the measured function returns."
                             :gen/elements [nil 1 [1 2] {:k 1}]}]]
 :seon.profile/value [:any {:description "The measured function's value, unchanged."
                            :seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                            :seon.schema.admission/reason "seon.profile/measure returns whatever the measured function returns."
                            :gen/elements [nil 1 [1 2] {:k 1}]}]
 :seon.profile/ms [:double {:min 0 :description "Wall milliseconds of the measured call, to 0.01."}]
 :seon.profile/alloc-bytes [:int {:min 0 :description "Heap bytes allocated over the measured call, in the scope :seon.profile/alloc-scope names."}]
 :seon.profile/alloc-scope [:enum {:description ":thread: the calling platform thread's own count, which misses work handed to other threads. A call on a virtual thread, which has no count of its own, carries neither allocation key: never every thread's total."} :thread]
 :seon.profile/gc-count [:int {:min 0 :description "Collections every collector (GarbageCollectorMXBean) completed over the measured call, JVM-wide."}]
 :seon.profile/gc-ms [:int {:min 0 :description "Collection time every collector accumulated over the measured call, JVM-wide: pause time for G1's young and old collectors, cycle time for its concurrent one."}]
 :seon.profile/ranked-by-calls [:vector {:description "The armed definitions entered over the measured call, most entries first (at most seon.profile/hot-limit): its repeated work."} :seon.profile/entered-row]
 :seon.profile/entered-row
 [:map {:description "One armed definition's outermost entries over a measured call and the self time they used (JVM-wide)."}
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/calls :seon.profile/calls]
  [:seon.profile/self-ms :seon.profile/self-ms]]
 :seon.profile/ranked-by-self [:vector {:description "The armed definitions entered over the measured call, most self time first (at most seon.profile/hot-limit): where the time went, wrappers below the work they wrap."} :seon.profile/entered-row]
 :seon.profile/called [:map-of {:description "Every armed definition entered over the measured call to its outermost entries (JVM-wide), uncut: seon.profile/calls-of reads one."} :seon.profile/sym [:int {:min 1}]]
 :seon.profile/reads [:int {:min 0 :description "The entries of seon.profile/read-entrances among the measured call's armed entries: database reads through seon.db."}]
 :seon.profile/measured-call
 [:map {:description "One measured call (seon.profile/measure): its value and what it cost, from JVM counters."}
  [:seon.profile/value :seon.profile/value]
  [:seon.cost/jvm-window {:optional true} :seon.cost/jvm-window]
  [:seon.profile/ms :seon.profile/ms]
  [:seon.profile/alloc-bytes {:optional true} :seon.profile/alloc-bytes]
  [:seon.profile/alloc-scope {:optional true} :seon.profile/alloc-scope]
  [:seon.profile/gc-count :seon.profile/gc-count]
  [:seon.profile/gc-ms :seon.profile/gc-ms]
  [:seon.profile/calls :seon.profile/calls]
  [:seon.profile/reads :seon.profile/reads]
  [:seon.profile/ranked-by-self :seon.profile/ranked-by-self]
  [:seon.profile/ranked-by-calls :seon.profile/ranked-by-calls]
  [:seon.profile/called :seon.profile/called]]}
