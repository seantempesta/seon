;; Cumulative inclusive call timing on the armed wrappers (src/seon/profile.clj).
;; Values only: nothing here is stored, so no Datahike attribute derives from it.
;; What is stored: the transaction's work (seon.db.transaction.edn).
{:seon.profile/sym [:qualified-symbol {:description "The installed callable's symbol."}]
 :seon.profile/digest :seon.program/definition-digest
 :seon.profile/definition-digests
 [:map-of {:description "Installer-supplied digests of the callables it arms, by symbol."}
  :qualified-symbol :seon.program/definition-digest]
 :seon.profile/scope [:enum {:description "Host: a loaded Var's JVM wrapper, attributed to no cluster. Context: one SCI installation's wrapper."}
                      :seon.profile/host :seon.profile/context]
 :seon.profile/context [:string {:min 1 :description "The installer's name for the SCI context, when it supplied one."}]
 :seon.profile/cold-calls [:int {:min 0 :description "How many of the callable's first calls in this process are cold (:seon.config.fn.cost/cold-calls at arming); absent: none."}]
 :seon.profile/size-period [:int {:min 0 :description "One outermost call in this many, at random, records its touched size (:seon.config.fn.cost/size-period at arming); 0 or absent: none."}]
 :seon.profile/read? [:boolean {:description "The callable is a seon.db read entrance (seon.profile/read-entrances): its calls count as reads in its callers."}]
 :seon.profile/volume-histogram [:fn {:error/message "must be a java.util.concurrent.atomic.AtomicLongArray of 40 buckets"
                                       :description "A log2 histogram of a per-call volume: bucket b counts outermost calls of [2^(b-1), 2^b) bytes or reads, bucket 0 the zero call."}
                                 seon.profile/world-counter?]
 :seon.profile/bracket [:fn {:error/message "must be a seon.profile.Bracket"
                             :description "A cell's one counting entry (seon.profile/bracket), made once at installation: a seon.profile.Bracket, which only seon.profile/bracket makes."}
                         clojure.core/some?]
 :seon.profile/sizes [:fn {:error/message "must be a java.util.concurrent.atomic.AtomicLongArray"
                           :description "A cell's sampled-size counters (seon.profile/size-slots): sampled calls, summed touched size N, steps, reads, allocated bytes, the largest reads and steps per N of one sample, in thousandths, then self steps, self reads and self allocated bytes."}
                      seon.profile/world-counter?]
 :seon.profile/ordinal [:fn {:error/message "must be a java.util.concurrent.atomic.AtomicLong"
                             :description "The cell's counted entries in this process, up to its cold calls: the call order that makes a call cold."}
