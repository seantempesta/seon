#:seon.blob{:content :string,
            :digest [:re "^[0-9a-f]{64}$"],
            :inline-prefix :seon.blob/octet-array,
            :input-stream
            [:fn
             {:error/message "must be a JVM input stream"
              :gen/gen seon.blob/input-stream-generator}
             seon.blob/input-stream?],
            :length [:int {:min 0}],
            :octet-array
            [:fn
             {:error/message "must be a JVM byte array"
              :gen/gen seon.blob/octet-array-generator}
             seon.schema/byte-array?],
            :offset [:int {:min 0}],
            :size [:int {:min 0}],
            :staged-path :string,
            :staged-octets :seon.blob/octet-array,
            :staged-write
            [:map
             [:seon.blob/digest :seon.blob/digest]
             [:seon.blob/size :seon.blob/size]
             [:seon.blob/inline-prefix :seon.blob/inline-prefix]
             [:seon.blob/staged-path {:optional true} :seon.blob/staged-path]
             [:seon.blob/staged-octets {:optional true} :seon.blob/staged-octets]],
            :write-result
            [:map
             [:seon.blob/digest :seon.blob/digest]
             [:seon.blob/size :seon.blob/size]
             [:seon.blob/inline-prefix :seon.blob/inline-prefix]],
            :compression
            [:map
             [:seon.config.blob/compress? {:optional true} :seon.config.blob/compress?]
             [:seon.config.blob/compress-min-bytes {:optional true} :seon.config.blob/compress-min-bytes]
             [:seon.config.blob/compress-max-bytes {:optional true} :seon.config.blob/compress-max-bytes]],
            :threshold-attribute :qualified-keyword
            :store-root-absent :string
            :stored-content-mismatch :seon.blob/digest
            :input-stalled :seon.blob/size
            :input-stalled-error [:and :seon.error/base [:map [:seon.blob/input-stalled :seon.blob/input-stalled]]]
            :content-digest-mismatch :seon.blob/digest}
