#:seon.render.web{

                  :feed-request
                  [:map
                   [:seon.agent/id :seon.agent/id]
                   [:seon.render.web/root-agent-id
                    :seon.render.web/root-agent-id]
                   [:seon.store/connection-object :seon.store/connection-object]
                   [:seon.sci.admit/caps :seon.sci.admit/caps]
                   [:seon.config.eval/time-limit-ms
                    :seon.sci.eval/time-limit-ms]
                   [:seon.db.process/id
                    :seon.db.process/id]
                   [:seon.render.web/pages-mult
                    :seon.render.web/pages-mult]
                   [:seon.render.web/registration
                    :seon.render.web/registration]
                   [:seon.render.web/latest-packages
                    :seon.render.web/latest-packages]
                   [:seon.render.web/render-channel :seon.flow/channel]
                   [:seon.sci.eval/ctx {:optional true} :seon.sci.eval/ctx]
                   [:seon.render.web/http {:optional true} :seon.render.web/http]],
                  :http
                  [:map {:description "The socket leaf the page goes through, member by member: http-kit's send!, write-state and run-server and Datastar's close-sse! when absent."}
                   [:seon.render.web/send! {:optional true} :seon.render.web/send!]
                   [:seon.render.web/write-state {:optional true} :seon.render.web/write-state]
                   [:seon.render.web/close-sse! {:optional true} :seon.render.web/close-sse!]
                   [:seon.render.web/run-server {:optional true} :seon.render.web/run-server]],
                  :send! [:=> {:description "Send one frame on an http-kit channel; false when the channel was already closed."}
                          [:cat :seon.schema/value :seon.schema/value :boolean] :boolean],
                  :write-state [:=> {:description "The channel's http-kit write state: its pending bytes and the future that completes when they drain or the channel closes."}
                                [:cat :seon.schema/value] :map],
                  :close-sse! [:=> {:description "Close one Datastar SSE generator."}
                               [:cat :seon.schema/value] :seon.schema/value],
                  :run-server [:=> {:description "Bind an http-kit server for a handler and its options; answers the server or throws the bind failure."}
                               [:cat [:fn clojure.core/ifn?] :map] :seon.schema/value],
                  :http-server
                  [:fn
                   {:error/message "must be an http-kit server"
                    :gen/gen seon.render.web/server-generator}
                   seon.render.web/server?],
                  :inbound
                  [:map
                   [:seon.agent/id :seon.agent/id]
                   [:seon.message/inbound-content
                    {:optional true}
                    :seon.message/inbound-content]],
                  :latest-packages
                  [:fn
                   {:error/message
                    "must be a process-local atom containing each page's latest render package"
                    :gen/gen seon.flow/atom-reference-generator}
                   seon.flow/atom-reference?],
                  :interest
                  [:fn
                   {:error/message
                    "must be a process-local atom containing render dependency attributes"
                    :gen/gen seon.flow/atom-reference-generator}
                   seon.flow/atom-reference?],
                  :page-request
                  [:map
                   [:seon.agent/id
                    {:optional true}
                    :seon.agent/id]
                   [:seon.render.debug/viewer-namespace
                    {:optional true}
                    :seon.ns/name]
                   [:seon.render/page :seon.render/page]
                   [:seon.render.web/feed-url [:string {:min 1}]]],
                  :pages-mult
                  [:fn
                   {:error/message
                    "must be a core.async mult carrying render packages"
                    :gen/gen seon.render.web/mult-generator}
                   seon.render.web/mult?],
                  :paint-request
                  [:map
                   [:seon.db/db :seon.db/database-value]
                   [:seon.db/connection
                    {:optional true}
                    :seon.db/connection]
                   [:seon.agent/id :seon.agent/id]
                   [:seon.render.web/root-agent-id
                    :seon.render.web/root-agent-id]
                   [:seon.sci.admit/caps :seon.sci.admit/caps]
                   [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                   [:seon.config.eval/time-limit-ms
                    :seon.sci.eval/time-limit-ms]
                   [:seon.ai/partial
                    {:optional true}
                    :seon.ai/partial]],
                  :port [:int {:min 0, :max 65535}],
                  :registration
                  [:fn
                   {:error/message
                    "must be a process-local atom containing registered namespace pages"
                    :gen/gen seon.flow/atom-reference-generator}
                   seon.flow/atom-reference?],
                  :root-agent-id :seon.agent/id,
                  :server
                  [:map
                   [:seon.render.web/server
                    :seon.render.web/http-server]
                   [:seon.render.web/port :seon.render.web/port]
                   [:seon.render.web/url :seon.render.web/url]
                   [:seon.render.web/wanted-port
                    {:optional true}
                    :seon.render.web/wanted-port]],
                  :stop-request
                  [:and {:description "What seon.render.web/stop! joins: the served descriptor, the view's tab registration and the delivery bound its writers wait under."}
                   :seon.render.web/server
                   [:map
                    [:seon.render.web/registration :seon.render.web/registration]
                    [:seon.config.eval/time-limit-ms :seon.sci.eval/time-limit-ms]]],
                  :service
                  [:map
                   [:seon.db/writer {:optional true :description "Writes an inbound message and the service's process row; seon.db/transact! when absent."} :seon.db/writer]
                   [:seon.render.web/http {:optional true} :seon.render.web/http]
                   [:seon.store/connection-object :seon.store/connection-object]
                   [:seon.agent/id :seon.agent/id]
                   [:seon.sci.admit/caps :seon.sci.admit/caps]
                   [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                   [:seon.config.eval/time-limit-ms
                    :seon.sci.eval/time-limit-ms]
                   [:seon.db.process/id
                    :seon.db.process/id]
                   [:seon.render.web/pages-mult
                    :seon.render.web/pages-mult]
                   [:seon.render.web/registration
                    :seon.render.web/registration]
                   [:seon.render.web/latest-packages
                    :seon.render.web/latest-packages]
                   [:seon.render.web/render-channel :seon.flow/channel]
                   [:seon.render.web/port
                    {:optional true}
                    :seon.render.web/port]],
                  :url [:string {:min 1}],
                  :view
                  [:map
                   [:seon.render.web/render-channel :seon.flow/channel]
                   [:seon.render.web/runtime-eval-channel
                    :seon.flow/channel]
                   [:seon.render.web/pages-channel :seon.flow/channel]
                   [:seon.render.web/registration
                    :seon.render.web/registration]
                   [:seon.render.web/latest-packages
                    :seon.render.web/latest-packages]
                   [:seon.render.web/interest
                    :seon.render.web/interest]
                   [:seon.render.web/completion :seon.flow/channel]
                   [:seon.render.web/root-agent-id
                    :seon.render.web/root-agent-id]
                   [:seon.db.process/id
                    :seon.db.process/id]
                   [:seon.render.web/pages-mult
                    :seon.render.web/pages-mult]],
                  :wanted-port :seon.render.web/port,
                  :missing-port :keyword

                  :value-not-found :seon.blob/digest
                  :value-unreadable :seon.blob/digest
                  :function-unavailable :qualified-symbol
                  :function-unavailable-error
                  [:and :seon.error/base [:map {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} [:seon.render.web/function-unavailable :seon.render.web/function-unavailable]]]


 ; Additive error declaration manifest, 2026-09-18.

 :seon.render.web/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.render.web/error-request :seon.render.web/error-request]
  [:seon.render.web/owner-observation
   :seon.render.web/owner-observation]]]

 :seon.render.web/error-request
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :seon.render.web/owner-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :refusal-reason [:enum :seon.render.web/owner-not-ensured :seon.render.web/page-derivation-failed]
 :page-exception-class :symbol
 :refused-member :qualified-keyword

 :request-error [:and :seon.error/base [:map {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} [:seon.render.web/refused-member :seon.render.web/refused-member] [:seon.render.web/refusal-reason {:optional true} :seon.render.web/refusal-reason] [:seon.render.web/page-exception-class {:optional true} :seon.render.web/page-exception-class]]]


 :context-error :seon.render.web/request-error
}
