;; The one value printer (v1: seon.config.render.agent.edn, ported: token-budget, max-depth,
;; whole-width, max-name, max-number-digits, sort-bound; seon.config.render/* are new in next).
{:seon.config.render.agent/token-budget [:int {:min 1 :seon.config/unit "tokens" :description "A reply value's printed budget."}]
 :seon.config.render.agent/max-depth [:int {:min 1 :seon.config/unit "levels" :description "Nested levels a printed value shows."}]
 :seon.config.render.agent/whole-width [:int {:min 1 :seon.config/unit "chars" :description "A value at most this wide is never cut."}]
 :seon.config.render.agent/max-name [:int {:min 1 :seon.config/unit "chars" :description "A keyword or symbol is whole up to this length."}]
 :seon.config.render.agent/max-number-digits [:int {:min 1 :seon.config/unit "digits" :description "A big number past this prints its digit count."}]
 :seon.config.render.agent/sort-bound [:int {:min 1 :seon.config/unit "keys" :description "A keyword map or set of at most this many is shown sorted."}]
 :seon.config.render/width [:int {:min 16 :seon.config/unit "chars" :description "The printed line width."}]
 :seon.config.render/nest-depth [:int {:min 0 :seon.config/unit "levels" :description "Nesting levels the printer indents; deeper levels print at the last indent (seon.print.emit)."}]
 :seon.config.render/part-budget [:int {:min 1 :seon.config/unit "tokens" :description "A value shown inside another (a refused argument, a test's expected and actual)."}]
 :seon.config.render/form-budget [:int {:min 1 :seon.config/unit "tokens" :description "A form echoed back."}]
 :seon.config.render/context-budget [:int {:min 1 :seon.config/unit "tokens" :description "The whole context block the model reads."}]
 :seon.config.render/history-budget [:int {:min 0 :seon.config/unit "tokens" :description "Earlier records the model reads: the newest whole, older ones collapsed, the oldest left out."}]
 :seon.config.render/history-step [:int {:min 1 :seon.config/unit "records" :description "The history's boundaries move in multiples of this many records."}]
 :seon.config.render/similar [:int {:min 0 :seon.config/unit "functions" :description "The program functions nearest the task's plan by meaning shown in its task story (:similar); 0 shows none."}]
 :seon.config.render/big-alloc [:int {:min 1 :seon.config/unit "bytes" :description "An evaluation that allocated more is flagged on the page."}]
 :seon.config.render/value-budget [:int {:min 1 :seon.config/unit "tokens" :description "A rendered value whose env names no budget."}]
 :seon.config.render/root-context-budget [:int {:min 1 :seon.config/unit "tokens" :description "Root's context, the system's AI face; later sections past it are named."}]
 :seon.config.render/line-budget [:int {:min 1 :seon.config/unit "tokens" :description "A message or reason in one line: root's context, a page's tile or row, a declared AI render's line."}]
 :seon.config.render/cell-budget [:int {:min 1 :seon.config/unit "tokens" :description "A table cell or a stream row's field: a form, a value, a reason in a row."}]
 :seon.config.render.list/stream [:int {:min 1 :seon.config/unit "events" :description "Events the dashboard's stream keeps, newest first; its header says how many older it did not keep."}]
 :seon.config.render.list/history [:int {:min 1 :seon.config/unit "rows" :description "Rows a page renders at first, newest first (an evaluation, or a turn with its evaluations), and how many more each time its last row scrolls into view; the rest are counted, unrendered."}]}
