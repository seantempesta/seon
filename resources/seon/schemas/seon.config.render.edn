;; The one value printer (v1: seon.config.render.agent.edn, ported: token-budget, max-depth,
;; whole-width, max-name, max-number-digits, sort-bound; seon.config.render/* are new in next).
{
 ;; Unit: reactions a step. The most reactions an owner proc (the render proc first) runs in one step; the rest are its next
 ;; message, so ping and stop interleave and nothing is dropped. Provenance: flow's review of Land A, 2026-11-15: a recorded error's
 ;; row ~39k ticks [runtime M result/d68abfc9], so 250 is ~10M ticks a step. At the bound: the rest wait one message.
 :seon.config.render/flush-max [:int {:default 250 :min 1 :seon.config/unit "reactions" :description "The most reactions an owner proc runs in one step (seon.ratom/flush!, seon.problems/recorded-sync!); the rest are its next message, so its control (ping, stop) interleaves and nothing is dropped (flow's rule 2)."}]
 ;; Unit: tokens a reply's value may spend, wherever an eval's value is shown (the model's
 ;; tool message, the agent's page). Provenance: v1's 6144 (owner 2026-10-12: print more, so
 ;; help and the current-state block show whole), raised to 16000 (owner 2026-10-25: "a
 ;; generous context budget"; main's problems through their render measured 14,218 tokens
 ;; whole, cut at 6144; docs/render.md). Past it the value is cut, every
 ;; cut carrying the form that reads its rest.
 :seon.config.render.agent/token-budget [:int {:default 16000 :seon.config/at-load true :min 1 :seon.config/unit "tokens" :description "A reply value's printed budget."}]
 ;; Unit: nested levels shown (v1's :seon.config.render.agent/max-depth).
 :seon.config.render.agent/max-depth [:int {:default 8 :min 1 :seon.config/unit "levels" :description "Nested levels a printed value shows."}]
 ;; Unit: characters. A value whose laid-out text is at most this wide is never cut: its cut
 ;; would say less than the value (v1).
 :seon.config.render.agent/whole-width [:int {:default 24 :seon.config/at-load true :min 1 :seon.config/unit "chars" :description "A value at most this wide is never cut."}]
 ;; Unit: characters. A keyword or symbol is one name, whole up to this length (v1).
 :seon.config.render.agent/max-name [:int {:default 256 :seon.config/at-load true :min 1 :seon.config/unit "chars" :description "A keyword or symbol is whole up to this length."}]
 ;; Unit: decimal digits. A BigInt, Ratio or BigDecimal past this prints as its digit count (v1).
 :seon.config.render.agent/max-number-digits [:int {:default 32 :seon.config/at-load true :min 1 :seon.config/unit "digits" :description "A big number past this prints its digit count."}]
 ;; Unit: keys. A keyword-keyed map or set of at most this many shows identity attributes and
 ;; short members first, then alphabetically; a larger one its own seq order (v1).
 :seon.config.render.agent/sort-bound [:int {:default 64 :seon.config/at-load true :min 1 :seon.config/unit "keys" :description "A keyword map or set of at most this many is shown sorted."}]
 ;; The one-printer law (docs/render.md#one-printer; owner: "Do not create more than one value printer and no clipping happens
 ;; before then"), read by seon.problems/unnamed-sites over the compiler's :form/refs. Why dials: they are the law's definition,
 ;; the host's printers and cutters no fact of ours can name, and the namespaces where output is made for a person or a model.
 ;; Unit: vars. What turns a value into text beside the one printer: a src var referencing one is a site docs/render.md names.
 :seon.config.render/printer-vars [:set {:default #{clojure.core/pr-str clojure.core/prn-str clojure.core/print-str clojure.core/with-out-str
                                    clojure.core/pr clojure.core/prn clojure.core/printf clojure.pprint/pprint clojure.pprint/pp
                                    clojure.pprint/write clojure.pprint/cl-format} :seon.config/unit "vars" :description "What turns a value into text beside the one printer: a src var referencing one is a one-printer site docs/render.md#one-printer must name (seon.problems/unnamed-sites)."} :qualified-symbol]
 ;; Unit: vars. What shortens what is shown: a site where a display namespace references one.
 :seon.config.render/cut-vars [:set {:default #{clojure.core/subs clojure.core/take clojure.core/take-last clojure.core/drop-last} :seon.config/unit "vars" :description "What shortens what is shown: a one-printer site where a display namespace references one."} :qualified-symbol]
 ;; Unit: vars. The printer's calls that cut to a budget: a site where a namespace outside the display ones references one.
 :seon.config.render/budgeted-vars [:set {:default #{seon.print/text seon.print/line seon.print/plain} :seon.config/unit "vars" :description "The printer's calls that cut to a budget: a one-printer site where a namespace outside the display ones references one."} :qualified-symbol]
 ;; Unit: namespaces, each with the ones under it. Where output is made for a person or a model.
 :seon.config.render/display-namespaces [:set {:default #{my seon.render seon.web seon.ctx.search seon.ctx.status seon.ctx.wire seon.ctx.session
                                          seon.mcp seon.server seon.cost seon.repl seon.agent seon.problems} :seon.config/unit "namespaces, each with those under it" :description "Where output is made for a person or a model (the one-printer law's display namespaces)."} :symbol]
 ;; Unit: characters per printed line (session P1's printer, matching v1's corpus output).
 :seon.config.render/width [:int {:default 72 :min 16 :seon.config/unit "chars" :description "The printed line width."}]
 ;; Unit: levels. The agents list (every page's) is the signed-in user's pull of the agents it started, each with the ones it
 ;; started, to this many levels; the last level's agents show how many they started (seon.render.ui/agent's entry), never cut silently.
 :seon.config.render/agent-tree-depth [:int {:default 3 :min 1 :max 16 :seon.config/unit "levels" :description "How many levels of the agents each one started a user's pull joins (its agents list): an agent at the last level shows how many it started, never a silent cut. See docs/users.md#whats-on-screen."}]
 ;; Unit: rows. How many rows of a problem list a page shows: an agent's newest failures its open problems show, each with its cause
 ;; (plan Stage 0.3), and each class of a problems report no tab opened (root's tile): enough to see a run of one kind and the one
 ;; before it, never the whole history; the rest is one call away.
 :seon.config.render/recent-errors [:int {:default 5 :min 0 :seon.config/unit "rows" :description "How many rows of a problem list a page shows: an agent's newest failures (a model call's error, an eval's) with their causes, and each class of a problems report no tab opened; the rest is one call away."}]
 ;; Unit: tokens for a value shown inside another: a refused argument, a test's expected and
 ;; actual, ex-data (session P1).
 :seon.config.render/part-budget [:int {:default 256 :seon.config/at-load true :min 1 :seon.config/unit "tokens" :description "A value shown inside another (a refused argument, a test's expected and actual)."}]
 ;; Unit: tokens for a form echoed back (session P1).
 :seon.config.render/form-budget [:int {:default 600 :seon.config/at-load true :min 1 :seon.config/unit "tokens" :description "A form echoed back."}]
 ;; Unit: tokens for the context block the model reads (the task, its proofs, what it cites),
 ;; breadth first so every section shows before any one deepens (session P1).
 :seon.config.render/context-budget [:int {:default 16000 :seon.config/at-load true :min 1 :seon.config/unit "tokens" :description "The whole context block the model reads."}]
 ;; Relevance (seon.ctx.search/relevance, docs/vector.md#relevance): a logistic over five features of
 ;; an item near a context, one weight set a kind: zc its cosine with the query's vector, zb its BM25
 ;; for the query's words, over the pool (seon.doc/bm25), zt its cosine with the touched items' mean vector (each a z-score over
 ;; the pool), g1 log(1 + the seeds it neighbours x its rarity), ppr log(1 + scale x its
 ;; personalized PageRank from the seeds), the constants :seon.config.render/relevance-features. Weighing a link by its rarity took plumbing
 ;; (seon.contract/checked, seon.db/eid ...) from 20 to 1 of 570 function lines at the same recall. Provenance: fitted (scikit-learn, L2 C=1) on 220 merges' commit subjects as queries
 ;; and what each merge changed as the relevant items, cold and with three of them touched;
 ;; judged on 57 merged tasks' plans held out (the relevance-lab worktree, 2026-10-27). They hold
 ;; only with :seon.config.render/relevance-features as fitted: change one, fit them again
 ;; (docs/vector.md/). At the bound: none; each kind's set is required.
 :seon.config.render/relevance-weights [:map {:default {:var {:zc 0.382 :zb 0.568 :zt 0.267 :g1 1.527 :ppr 0.112 :intercept -3.881}
                                        :section {:zc 0.162 :zb 0.816 :zt 0.101 :g1 0.690 :ppr 0.255 :intercept -4.100}
                                        :schema {:zc 0.517 :zb 0.318 :zt 0.332 :g1 0.382 :ppr 0.435 :intercept -4.991}} :seon.config/unit "logit per feature" :description "Each kind's logistic weights over relevance's five features, and its intercept."}
                                       [:var [:map [:zc number?] [:zb number?] [:zt number?] [:g1 number?] [:ppr number?] [:intercept number?]]] [:section [:map [:zc number?] [:zb number?] [:zt number?] [:g1 number?] [:ppr number?] [:intercept number?]]] [:schema [:map [:zc number?] [:zb number?] [:zt number?] [:g1 number?] [:ppr number?] [:intercept number?]]]]
 ;; The constants relevance's features were fitted with (seon.ctx.search/relevance): :alpha the share a
 ;; PageRank push keeps (the field's 0.15, Andersen, Chung and Lang 2006); :bm25-k1 and :bm25-b
 ;; BM25's saturation and length normalization (the field's 1.2 and 0.75, Robertson and Zaragoza
 ;; 2009); :rarity-cap the degree a link's rarity, (1 + cap)/(1 + degree), counts to (16, as the
 ;; rank fusion's measured cap was: no plumbing lines at 16, 64 and 256 alike), which is also the most
 ;; datoms that count reads; :ppr-scale the rank's scale inside its log (10^4: a rank of 1e-4, a
 ;; seed's typical neighbour, reads log 2); :hub the degree from which a node never pushes and is
 ;; never read whole (64 ranked the 57 held-out plans exactly as no bound, while the bound keeps a
 ;; push from counting seon.contract/checked's thousands of callers: each datom read costs ~1.4 KB
 ;; here). Provenance: the weights were fitted with these; no others were measured but :hub's.
 ;; At the bound: none; each is required.
 :seon.config.render/relevance-features [:map {:default {:alpha 0.15 :bm25-k1 1.2 :bm25-b 0.75 :rarity-cap 16 :ppr-scale 10000.0 :hub 64} :seon.config/unit "the features' constants" :description "The constants relevance's features were fitted with: :alpha, :bm25-k1, :bm25-b, :rarity-cap, :ppr-scale, :hub."}
                                        [:alpha [:double {:min 0.01 :max 0.99}]] [:bm25-k1 [:double {:min 0.0}]] [:bm25-b [:double {:min 0.0 :max 1.0}]]
                                        [:rarity-cap [:int {:min 1}]] [:ppr-scale [:double {:min 1.0}]] [:hub [:int {:min 1}]]]
 ;; Unit: [logit chance] knots a kind, read piecewise linearly. What a relevance logit means: the
 ;; chance an item is worth reading for the work now, as an independent judge (Sonnet) labelled 1,905
 ;; lines useful or noise: the first five of each kind on 59 merged tasks' pages and 20 search
 ;; queries (the plan's focus, 1,185 lines), and at 48 moments of 10 recorded runs under the work's
 ;; focus (the plan decaying into the agent's evals, 720 lines; docs/vector.md/). Fitted per kind
 ;; as sigmoid(a log c + b) over both, c the item's chance that its merge changes it, and cross-fitted
 ;; by halves of the moments: at 60% or more the plan's pages predicted 0.78 / 0.82 / 0.73 and found
 ;; 0.76 / 0.86 / 0.70 (functions, sections, schema keys), the work's 0.64 / 0.85 / 0.71 and found
 ;; 0.76 / 0.81 / 0.67; a term for the state moved nothing at the cut. Below each kind's fifth item it
 ;; is extrapolated: no label is there. At the bound: a logit past either end reads its end's chance.
 :seon.config.render/relevance-calibration [:map {:default {:var [[-6.51 0.16] [-5.17 0.169] [-3.83 0.243] [-3.3 0.312] [-2.78 0.362] [-1.95 0.433] [-1.12 0.485] [-0.6 0.554] [-0.07 0.602] [0.62 0.701] [1.32 0.753] [2.56 0.77] [3.81 0.784]]
                                            :section [[-6.16 0.0] [-4.98 0.0] [-3.8 0.002] [-3.3 0.004] [-2.81 0.007] [-2.63 0.022] [-2.45 0.045] [-2.19 0.127] [-1.92 0.232] [-1.55 0.373] [-1.19 0.497] [-0.94 0.582] [-0.69 0.651] [-0.54 0.765] [-0.4 0.834] [2.12 0.913] [4.65 0.948]]
                                            :schema [[-8.67 0.014] [-6.58 0.02] [-4.49 0.043] [-4.14 0.07] [-3.79 0.096] [-3.36 0.17] [-2.93 0.237] [-2.39 0.401] [-1.84 0.515] [-1.68 0.591] [-1.52 0.648] [-0.61 0.72] [0.29 0.769] [0.65 0.769] [1.0 0.769]]} :seon.config/unit "[logit chance] knots" :description "What each kind's relevance logit means as a chance, knots in ascending logit, read piecewise linearly."}
                                           [:var [:vector {:min 2} [:tuple number? number?]]] [:section [:vector {:min 2} [:tuple number? number?]]] [:schema [:vector {:min 2} [:tuple number? number?]]]]
 ;; Unit: tokens. The source a search's part draws of its nearest functions (seon.render.ui/searched).
 ;; Provenance: round 1 (2026-11-15), task seon.agent/a-test-child-starts-on-its-branchs-environment: its
 ;; request's search held hold-env!, agent-frame and test-child-runs! (relevance 0.40-0.48) as lines and
 ;; the agent spent turns on (source ..) of each; their sources are ~500, ~4,400 and ~2,000 tokens, so
 ;; 10,000 draws a task's nearest three to five whole, sent once in the cached prefix.
 :seon.config.render/search-source-tokens [:int {:default 10000 :min 0 :seon.config/unit "tokens" :description "The tokens a search's part spends on its functions' source: best first, a function at :seon.config.render/relevance-summary or above is drawn whole while it fits, the rest each its line (seon.render.ui/searched). Round 1 (2026-11-15): its agent, shown the functions it needed as lines, spent turns sourcing each; ~10k covers a task's nearest three to five functions (500 to 4,400 tokens each). See docs/vector.md#search."}]
 ;; Unit: chance (0-1). A hit my.agent/search ranks at this relevance or more is shown, a line with its
 ;; chance; below it, counted (a last :more entry) with the call that lists it. A task may set its own (its
 ;; :seon.task/config). Provenance: the judge's labels, cross-fitted: at 0.4 the lines shown were
 ;; worth reading 0.57 (functions), 0.66 (sections) and 0.68 (schema keys) of the time, about 3.6,
 ;; 2.3 and 1.6 a page of the first five; at 0.05 (the merge-change scale's cut before) functions
 ;; were starved and sections and keys half noise (docs/vector.md#relevance). At the bound: an item at
 ;; exactly this chance is shown.
 :seon.config.render/relevance-summary [:double {:default 0.4 :min 0.0 :max 1.0 :seon.config/unit "chance" :description "The relevance at which my.agent/search shows a hit, a line with its chance; below it, counted."}]
 ;; Unit: items of each kind. How many of the nearest by meaning relevance's pool takes
 ;; (seon.vector/near), beside the seeds and their neighbourhood, and how many of a seed's
 ;; neighbours each read of who names it takes (seon.ctx.search/neighbours: a plan citing
 ;; seon.config/value would pool its hundreds of callers). Provenance: 100, 200 and 400 ranked
 ;; alike on the held-out plans (functions R@5 0.433 / 0.436 / 0.451, sections 0.764 / 0.766 /
 ;; 0.766); the pool's texts are tokenized each call, so the smallest. At the bound: an item past
 ;; it and outside the seeds' first neighbours is never scored.
 :seon.config.render/relevance-pool [:int {:default 100 :min 1 :seon.config/unit "items of each kind" :description "How many of the nearest by meaning relevance scores, beside the seeds and their neighbourhood."}]
 ;; Unit: residual mass per neighbour. The local push's threshold for relevance's personalized
 ;; PageRank (seon.ctx.search/pushed): at most 1/(alpha x this) pushes, whatever the store's size.
 ;; Provenance: 1e-3 pushed 37 nodes a plan and ranked as well as 1e-4 (376 nodes; functions R@5 0.434
 ;; and 0.430 on the held-out plans). At the bound: a node holding less than this per neighbour is not pushed.
 :seon.config.render/relevance-eps [:double {:default 0.001 :min 1.0E-6 :seon.config/unit "residual mass per neighbour" :description "The local push's threshold for relevance's personalized PageRank: at most 1/(alpha x this) pushes; above 0, or the push never ends."}]
 ;; Unit: hits. How many hits (my.agent/search) answers when its options give no :k: the best of the
 ;; exact text, meaning and references fused by seon.vector/rrf. Provenance: the literal 10 that
 ;; my.agent/similar took (owner, 2026-10-27: "fix the search so it includes docs ... params to
 ;; specify what to focus on"). At the bound: the hits past it are not answered; ask a larger :k.
 :seon.config.render/search [:int {:default 10 :min 1 :seon.config/unit "hits" :description "How many hits (my.agent/search) answers when its options give no :k, the best of exact text, meaning and references fused by reciprocal rank."}]
 ;; Unit: standard deviations. my.agent/search keeps a text hit (BM25 over the query's identifier-split
 ;; words) only when its score is this many standard deviations above the mean of every text's score for
 ;; that query. Provenance: embeddings lab, 2026-10-27 (20 hand-checked queries; scratchpad
 ;; embeddings-design.md): tokens kept at z >= 2 lifted R@10 from 0.68 to 0.71 without hurting the
 ;; paraphrase queries; unfiltered they are noise on text. At the bound: a text scoring below it is not a hit.
 :seon.config.render/search-token-z [:double {:default 2.0 :min 0.0 :seon.config/unit "standard deviations" :description "How many standard deviations above the mean of every text's BM25 score for the query a text must score to be a text hit of my.agent/search."}]
 ;; Unit: candidates per hit shown. How many of the nearest by meaning my.agent/search reads for each hit
 ;; it may show (seon.vector/near takes this times :seon.config.render/search), before the
 ;; fusion and the filters cut them to the count. Provenance: the literal the
 ;; fused search was measured with (b9920ecf5b, docs/vector.md#what-was-compared-and-what-it-left-out); no other value
 ;; was measured. At the bound: a candidate past it is never ranked by meaning.
 :seon.config.render/related-near [:int {:default 4 :min 1 :seon.config/unit "candidates per hit shown" :description "How many of the nearest by meaning my.agent/search reads for each hit it may show, before fusion and filters."}]
 ;; Unit: tokens. How a section or message of a request reads on the debug page; only its colour changes at either bound,
 ;; nothing is cut or refused. Provenance: the commit adding these keys, from a kept 22k request.
 :seon.config.render/tokens-warn [:int {:default 2000 :min 1 :seon.config/unit "tokens" :description "A section or message of a request this large is marked amber on the debug page (docs/render.md#the-debug-page-is-the-wire-request)."}]
 :seon.config.render/tokens-over [:int {:default 5000 :min 1 :seon.config/unit "tokens" :description "A section or message of a request this large is marked red on the debug page."}]
 ;; Unit: tokens. The same for a whole request. Provenance: the commit adding these keys.
 :seon.config.render/request-tokens-warn [:int {:default 50000 :min 1 :seon.config/unit "tokens" :description "A whole request this large is marked amber on the debug page."}]
 :seon.config.render/request-tokens-over [:int {:default 150000 :min 1 :seon.config/unit "tokens" :description "A whole request this large is marked red on the debug page."}]
 ;; Unit: tokens a rendered value spends when its env names no budget (seon.render/print-hiccup,
 ;; an agent's history row). Provenance: the literal 600 render.clj and
 ;; render.ui carried (2026-10-22), kept as it was.
 :seon.config.render/value-budget [:int {:default 600 :min 1 :seon.config/unit "tokens" :description "A rendered value whose env names no budget."}]
 ;; Unit: tokens of root's context, its page's hiccup printed (seon.render.proc/pass: the render
 ;; of root's ctx, /root/debug and /context.txt); past it the printer names what it left. Provenance: render.ai's
 ;; and the render proc's 700.
 :seon.config.render/root-context-budget [:int {:default 700 :min 1 :seon.config/unit "tokens" :description "Root's context, the system's AI face; later sections past it are named."}]
 ;; Unit: tokens of a message or reason shown in one line (root's context, a page's tile or row,
 ;; a nested value's line); past it the line's cut names the form that reads the
 ;; rest. Provenance: the literals 40-60 render.ui and render.ai carried (2026-10-22), as one.
 :seon.config.render/line-budget [:int {:default 50 :min 1 :seon.config/unit "tokens" :description "A message or reason in one line: root's context, a page's tile or row, a declared AI render's line."}]
 ;; Unit: tokens of a table cell or a stream row's field (a form, a value, a reason); past it the
 ;; cut says what it omitted and links the page that shows it whole. Provenance: the literals
 ;; 12-30 render.ui carried (2026-10-22), as one.
 :seon.config.render/cell-budget [:int {:default 25 :min 1 :seon.config/unit "tokens" :description "A table cell or a stream row's field: a form, a value, a reason in a row."}]
 ;; Unit: events root's context keeps (the render proc), newest first; its events section says
 ;; how many older ones it did not keep. Provenance: the render proc's EVENT-CAP 60.
 :seon.config.render.list/stream [:int {:default 60 :min 1 :seon.config/unit "events" :description "Events the dashboard's stream keeps, newest first; its header says how many older it did not keep."}]
}
