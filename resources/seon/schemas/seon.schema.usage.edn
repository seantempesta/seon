#:seon.schema.usage{:previous
                    [:and {:description "The committed form a registration replaces, when it differs. Shown, never stored."}
                     :seon.schema/value],
                    :new?
                    [:= {:description "Present when the read found no form committed under the key."} true],
                    :doc
                    [:string {:min 1 :description "A listed schema's description line."}],
                    :checked
                    [:int {:min 0 :description "Distinct stored entities whose value of the attribute the new form judged: the first 200 in index order."}],
                    :failing
                    [:int {:min 0 :description "How many of the checked entities' values the new form refuses."}],
                    :more?
                    [:= {:description "Present when more entities hold the attribute than were checked."} true],
                    :failing-example
                    [:tuple {:description "The first refused stored value as [entity value], the value as the writer reconstructs it."} :int :seon.schema/value],
                    :stored-check
                    [:map {:description "What a registered form makes of the attribute's stored values, computed once when register! is evaluated (seon.db/stored-value-check)."}
                     [:seon.schema.usage/checked :seon.schema.usage/checked]
                     [:seon.schema.usage/failing :seon.schema.usage/failing]
                     [:seon.schema.usage/more? {:optional true} :seon.schema.usage/more?]
                     [:seon.schema.usage/failing-example {:optional true} :seon.schema.usage/failing-example]],
                    :check
                    [:or {:description "A registration's recorded stored-data verdict, or the refusal that prevented it."}
                     :seon.schema.usage/stored-check :seon.error/base],
                    :referenced-by
                    [:vector {:description "Schemas whose form names the key, sorted."} :qualified-keyword],
                    :contracts
                    [:vector {:description "Functions whose contract names the key, sorted."} :qualified-symbol],
                    :listing
                    [:map {:description "A schema listed among others: its key and description line."}
                     [:seon.schema/key :seon.schema/registry-key]
                     [:seon.schema.usage/doc {:optional true} :seon.schema.usage/doc]],
                    :report
                    [:map {:description "What registering a form under a key means for the program (seon.render.schema/usage), with the registration's recorded stored-data check."}
                     [:seon.schema/key :seon.schema/registry-key]
                     [:seon.schema/definition :seon.schema/value]
                     [:seon.schema.usage/previous {:optional true} :seon.schema.usage/previous]
                     [:seon.schema.usage/new? {:optional true} :seon.schema.usage/new?]
                     [:seon.schema.usage/check {:optional true} :seon.schema.usage/check]
                     [:seon.schema.usage/referenced-by {:optional true} :seon.schema.usage/referenced-by]
                     [:seon.schema.usage/contracts {:optional true} :seon.schema.usage/contracts]]}
