{:seon.cluster.store/branch-absent :seon.store/branch
 :seon.cluster.store/branch-already-open :seon.store/branch
 :seon.cluster.store/rule :keyword
 :seon.cluster.store/held-elsewhere :seon.store/lock-file
 :seon.cluster.store/initialization-incomplete :seon.store/dir
 :seon.cluster.store/refused :seon.cluster.store/rule
 :seon.cluster.store/file-lock-generator-failed :seon.store/lock-file
 ; Additive error declaration manifest, 2026-09-18.

 :seon.cluster.store/acquisition-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.cluster.store/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.cluster.store/error-root :seon.cluster.store/error-root]
  [:seon.cluster.store/acquisition-observation
   :seon.cluster.store/acquisition-observation]]]

 :seon.cluster.store/error-root
 [:string {:min 1}]

 :seon.cluster.store/writer-operation
 [:fn
  {:description "A Datahike writer operation (`datahike.writing/transact!`, `merge-writer!`): the writer's current database value and the dispatched arguments to the operation's report. Consumer: the store configuration's :write-fn-map."
   :error/message "must be a writer operation function"
   :gen/schema [:=> [:cat :seon.db/database-value :map] :map]}
  clojure.core/ifn?]
}
