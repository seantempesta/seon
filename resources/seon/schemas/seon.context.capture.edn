#:seon.context.capture{:basis-t [:int {:min 0}],
                       :capture
                       [:map
                        {:seon.db/attributes true,
                         :seon.render/ai seon.context/capture-ai,
                         :seon.render/html seon.context/capture-html}
                        [:seon.context.capture/id
                         :seon.context.capture/id]
                        [:seon.context.capture/run
                         :seon.context.capture/run]
                        [:seon.context.capture/basis-t
                         :seon.context.capture/basis-t]
                        [:seon.context.capture/prompt
                         {:optional true}
                         :seon.context.capture/prompt]
                        ;; the prompt's exact character count, recorded
                        ;; beside the prompt in the same transaction so
                        ;; token calibration can join it to the
                        ;; provider's own count without loading every
                        ;; recorded prompt string
                        [:seon.ai.tokens/characters
                         {:optional true}
                         :seon.ai.tokens/characters]
                        [:seon.context.capture/contributions
                         {:optional true}
                         :seon.context.capture/contributions]
                        [:seon.error/kind
                         {:optional true}
                         :seon.error/kind]
                        [:seon.error/message
                         {:optional true}
                         :seon.error/message]
                        [:seon.cluster.run/live-processes
                         {:optional true}
                         :seon.cluster.run/live-processes]],
                       :contributions
                       [:set #:seon.db{:component true} :seon.db/ref],
                       :id [:string {:min 1, :seon.db/identity true}],
                       :prompt
                       [:string {:min 1, :seon.db/no-history? true}],
                       :run :seon.db/ref}
