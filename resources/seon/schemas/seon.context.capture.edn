#:seon.context.capture{:basis-t [:int {:min 0}],
                       :capture
                       [:map
                        {:seon.db/attributes true :seon.program/partition :seon.data
                         :description "Retiring with no writer since CX-10: kept only so a store holding captures adopts; deleted after the reset."}
                        [:seon.context.capture/id
                         :seon.context.capture/id]
                        [:seon.context.capture/run
                         :seon.context.capture/run]
                        [:seon.context.capture/basis-t
                         :seon.context.capture/basis-t]
                        [:seon.context.capture/prompt
                         {:optional true}
                         :seon.context.capture/prompt]
                        ;; the prompt's exact character count, recorded
                        ;; beside the prompt in the same transaction so
                        ;; token calibration can join it to the
                        ;; provider's own count without loading every
                        ;; recorded prompt string
                        [:seon.ai.tokens/characters
                         {:optional true}
                         :seon.ai.tokens/characters]
                        [:seon.context.capture/contributions
                         {:optional true}
                         :seon.context.capture/contributions]
                        [:seon.error/message
                         {:optional true}
                         :seon.error/message]
                        ],
                       :contributions
                       [:set #:seon.db{:component true :seon.db/component-schema :seon.context.contribution/contribution} :seon.db/ref],
                       :id [:string {:min 1, :seon.db/identity true :seon.program/row-schema :seon.context.capture/capture}],
                       :prompt
                       [:string {:min 1,
                                 :description "Exact prompt observed for this capture, retained in history after replacement or retraction so temporal token calibration can recover the original bytes."}],
                       :run :seon.db/ref}
