;; The one process cache (src/seon/cache.clj). Values only: nothing here is stored.
{:seon.cache/cache [:fn {:error/message "must be a cache seon.cache/create built"} seon.cache/cache?]
 :seon.cache/max-bytes [:int {:min 1 :description "The byte budget in force: estimated bytes."}]
 :seon.cache/weighted-bytes [:int {:min 0 :description "Estimated bytes the retained entries weigh."}]
 :seon.cache/hits [:int {:min 0}]
 :seon.cache/misses [:int {:min 0 :description "Derivations started: one per key however many callers missed together."}]
 :seon.cache/evictions [:int {:min 0}]
 :seon.cache/bytes [:int {:description "Estimated bytes this kind retains."}]
 :seon.cache/load-ms [:int {:min 0 :description "Wall milliseconds spent deriving missed values."}]
 :seon.cache/kind [:qualified-keyword {:description "A cache kind: the owner's name for one derivation."}]
 :seon.cache/hit-percent [:int {:min 0 :max 100 :description "Hits of all lookups, a whole percent."}]
 :seon.cache/byte-percent [:int {:min 0 :max 100 :description "This kind's share of the weighed bytes, a whole percent."}]
 :seon.cache/since :inst
 :seon.cache/pending-kind :qualified-keyword
 :seon.cache/pending [:map {:description "A lookup-within reader's answer while the key's one derivation runs."}
                      [:seon.cache/pending-kind :seon.cache/pending-kind]
                      [:seon.cache/since :seon.cache/since]]
 :seon.cache/discipline-warning
 [:map {:seon.health/severity 5 :seon.health/impact :seon.cache/byte-percent :seon.health/subject :seon.cache/kind
        :seon.health/in [:seon.health/cache :seon.cache/kinds]
        :seon.health/clues [[:seon.cache/byte-percent] [:seon.cache/hit-percent] [:seon.cache/bytes] [:seon.cache/evictions] [:seon.cache/load-ms]]
        :description "A kind (its status) holding a quarter or more of the cache while under half its lookups hit: its derivation, not the budget, is the finding (health plan §10)."}
  [:seon.cache/kind :seon.cache/kind]
  [:seon.cache/byte-percent [:int {:min 25}]]
  [:seon.cache/hit-percent [:int {:max 49}]]]
 :seon.cache/kind-status
 [:map
  [:seon.cache/kind :seon.cache/kind]
  [:seon.cache/hit-percent :seon.cache/hit-percent]
  [:seon.cache/byte-percent :seon.cache/byte-percent]
  [:seon.cache/hits :seon.cache/hits]
  [:seon.cache/misses :seon.cache/misses]
  [:seon.cache/evictions :seon.cache/evictions]
  [:seon.cache/bytes :seon.cache/bytes]
  [:seon.cache/load-ms :seon.cache/load-ms]]
 :seon.cache/kinds [:map-of :qualified-keyword :seon.cache/kind-status]
 :seon.cache/status
 [:map {:description "The process cache: its budget, the bytes it weighs, and per-kind counters since the JVM began."}
  [:seon.cache/max-bytes :seon.cache/max-bytes]
  [:seon.cache/weighted-bytes :seon.cache/weighted-bytes]
  [:seon.cache/kinds :seon.cache/kinds]]}
