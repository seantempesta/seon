#:seon.effect{:capability :qualified-symbol,
              :content-blobs [:vector :seon.blob/digest],
              :background? :boolean,
              :disposition [:enum :interrupted],
              :execution-options
              [:map
               [:seon.effect/background?
                {:optional true}
                :seon.effect/background?]
               [:seon.effect/time-limit-ms
                {:optional true}
                :seon.effect/time-limit-ms]],
              :time-limit-ms [:int {:min 1}],
              :form-ordinal [:int {:min 0}],
              :duration-ms [:int {:min 0}],
              :id [:string {:min 1, :seon.db/identity true}],
              :interrupted-at :inst,
              :open-request :seon.effect/receipt,
              :opened-at :inst,
              :ordinal [:int {:min 0}],
              :owner :seon.db/ref,
              :receipt
              [:map
               {:seon.db/attributes true
                :seon.render/ai seon.effect/render-ai
                :seon.render/html seon.effect/render-html}
               [:seon.effect/id :seon.effect/id]
               [:seon.effect/run :seon.effect/run]
               [:seon.effect/owner :seon.effect/owner]
               [:seon.effect/form-ordinal :seon.effect/form-ordinal]
               [:seon.effect/ordinal :seon.effect/ordinal]
               [:seon.effect/request-edn :seon.effect/request-edn]
               [:seon.effect/opened-at :seon.effect/opened-at]
               [:seon.effect/notify
                {:optional true}
                :seon.effect/notify]
               [:seon.effect/to {:optional true} :seon.effect/to]
               [:seon.effect/result-edn
                {:optional true}
                :seon.effect/result-edn]
               [:seon.effect/result-blob
                {:optional true}
                :seon.effect/result-blob]
               [:seon.effect/content-blobs
                {:optional true}
                :seon.effect/content-blobs]
               [:seon.effect/result-size
                {:optional true}
                :seon.effect/result-size]
               [:seon.effect/duration-ms
                {:optional true}
                :seon.effect/duration-ms]
               [:seon.effect/settled-at
                {:optional true}
                :seon.effect/settled-at]
               [:seon.effect/interrupted-at
                {:optional true}
                :seon.effect/interrupted-at]],
              :request-context
              [:map
               [:seon.db/connection
                :seon.db/connection]
               [:seon.cluster.run/id :seon.cluster.run/id]
               [:seon.cluster.run.form/ordinal
                :seon.cluster.run.form/ordinal]
               [:seon.boot/cluster-name :seon.boot/cluster-name]
               [:seon.sci.admit/caps :seon.sci.admit/caps]
               [:seon.config/on-core-error
                :seon.config/on-core-error]
               [:seon.cluster.agent/id
                {:optional true}
                :seon.cluster.agent/id]
               [:seon.flow/work-launcher
                {:optional true}
                :seon.flow/work-launcher]],
              :notify [:and #:seon.db{:index true} :seon.db/ref],
              :request-edn [:string #:seon.db{:no-history? true}],
              :result-edn [:string #:seon.db{:no-history? true}],
              :result-blob :seon.blob/digest,
              :result-size [:int {:min 0}],
              :run [:and #:seon.db{:index true} :seon.db/ref],
              :settle-request
              [:map
               [:seon.effect/id :seon.effect/id]
               [:seon.effect/result-edn :seon.effect/result-edn]
               [:seon.effect/result-blob
                {:optional true}
                :seon.effect/result-blob]
               [:seon.effect/content-blobs
                {:optional true}
                :seon.effect/content-blobs]
               [:seon.effect/result-size
                {:optional true}
                :seon.effect/result-size]
               [:seon.effect/duration-ms :seon.effect/duration-ms]
               [:seon.effect/settled-at :seon.effect/settled-at]],
              :settled-at :inst,
              :to [:and #:seon.db{:index true} :seon.db/ref]
 :seon.effect/already-recorded [:= true]
 :seon.effect/already-recorded-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.effect/already-recorded class marker"} [:seon.effect/already-recorded :seon.effect/already-recorded] [:seon.error/message :seon.error/message]]
 :seon.effect/already-settled [:= true]
 :seon.effect/already-settled-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.effect/already-settled class marker"} [:seon.effect/already-settled :seon.effect/already-settled] [:seon.error/message :seon.error/message]]
 :seon.effect/missing-receipt [:= true]
 :seon.effect/missing-receipt-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.effect/missing-receipt class marker"} [:seon.effect/missing-receipt :seon.effect/missing-receipt] [:seon.error/message :seon.error/message]]}
