#:seon.effect{:disposition [:enum :interrupted],
              :file
              [:and
               {:description
                "The indexed source file this effect wrote, by canonical absolute path. Absent when the written path is not part of the indexed program.",
                :seon.db/index true}
               :seon.db/ref],
              :handler-failed-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/failed-owner
                 :seon.effect/failed-owner]]],
              :provenance
              [:map
               {:description
                "Write-back provenance a capability handler reports to the effect writer. It never reaches the agent: `settle-value!` removes it from the handler's value exactly as it removes `:seon.blob/staged-writes`, and the writer derives `:seon.effect/program` from the file and span at the database that owns the declarations."}
               [:seon.effect/file :my.fs/path]
               [:seon.effect/form-span :seon.effect/form-span]],
              :request-edn [:string #:seon.db{:no-history? true}],
              :result-edn [:string #:seon.db{:no-history? true}],
              :error
              [:and
               #:seon.db{:attributes true}
               :seon.error/base
               [:map
                #:seon.db{:attributes true}
                [:seon.effect/request-identity
                 :seon.effect/request-identity]
                [:seon.effect/capability-symbol
                 :seon.effect/capability-symbol]
                [:seon.effect/execution-observation
                 :seon.effect/execution-observation]]],
              :settled-effect-id [:string {:min 1}],
              :interrupted-at :inst,
              :execution-options
              [:map
               [:seon.effect/background?
                {:optional true}
                :seon.effect/background?]
               [:seon.effect/time-limit-ms
                {:optional true}
                :seon.effect/time-limit-ms]],
              :missing-receipt-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/missing-effect-id
                 :seon.effect/missing-effect-id]]],
              :result-validator
              [:fn
               #:gen{:schema [:=> [:cat :seon.schema/value] :boolean]}
               clojure.core/ifn?],
              :request-owner :qualified-symbol,
              :program
              [:and
               {:description
                "The declaration whose span contains the region this effect wrote. Absent when no indexed declaration contains it.",
                :seon.db/index true}
               :seon.db/ref],
              :invalid-time-limit-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/time-limit-attribute
                 :seon.effect/time-limit-attribute]]],
              :id [:string {:min 1, :seon.db/identity true}],
              :time-limit-attribute :qualified-keyword,
              :unavailable-handler-symbol :qualified-symbol,
              :request-too-large-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/unadmitted-owner
                 :seon.effect/unadmitted-owner]]],
              :form-span
              [:tuple
               {:description
                "Half-open UTF-8 byte offsets of the region this effect wrote, in the file AFTER the write — the same unit as `:seon.fn/form-span`."}
               :int
               :int],
              :time-limit-ms [:int {:min 1}],
              :execution-observation
              [:and
               #:seon.db{:component true,
                         :component-schema :seon.error.evidence/entity}
               :seon.db/ref],
              :to
              [:and
               {:description
                "The agent a settled effect is delivered to. A LISTENED ATTRIBUTE: the settlement transaction moves the recipient from `notify` to `to`, so the datom appears exactly when the result becomes deliverable and is never retracted-and-reasserted. Also an INSIDE wake — the agent asked for this effect, so its settlement does not reset that agent's turn bound.",
                :seon.db/index true,
                :seon.wake/listen true,
                :seon.wake/opens-turn? true,
                :seon.wake/inside true}
               :seon.db/ref],
              :interrupted-effect-id [:string {:min 1}],
              :undeclared-owner-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/owner-without-handler
                 :seon.effect/owner-without-handler]]],
              :eval
              [:and
               {:description
                "The evaluation this request was made from. `:seon.effect/run` and `:seon.effect/form-ordinal` are the two parts of exactly this evaluation's identity; they remain written only because `seon.turn` still reads them, and retire with that reader (issue effect-run-and-form-ordinal-duplicate-the-evaluation-ref).",
                :seon.db/index true}
               :seon.db/ref],
              :owner :seon.db/ref,
              :open-request
              [:map
               [:seon.effect/receipt :seon.effect/receipt]
               [:seon.effect/arguments
                {:optional true}
                :seon.effect/arguments]],
              :request-context
              [:map
               [:seon.db/connection :seon.db/connection]
               [:seon.turn/id :seon.turn/id]
               [:seon.cluster.eval/ordinal :seon.cluster.eval/ordinal]
               [:seon.boot/cluster-name :seon.boot/cluster-name]
               [:seon.sci.admit/caps :seon.sci.admit/caps]
               [:seon.config/on-core-error :seon.config/on-core-error]
               [:seon.agent/id {:optional true} :seon.agent/id]
               [:seon.sci.eval/projection-state
                {:optional true,
                 :description
                 "This evaluation's schema projection state, named so a detached handler can rebuild the frame instead of hoping its executor inherited one."}
                :seon.sci.eval/projection-state]
               [:seon.flow/work-launcher
                {:optional true}
                :seon.flow/work-launcher]],
              :notify [:and #:seon.db{:index true} :seon.db/ref],
              :interrupted-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/interrupted-effect-id
                 :seon.effect/interrupted-effect-id]]],
              :result-size [:int {:min 0}],
              :failed-owner :qualified-symbol,
              :missing-bound :qualified-keyword,
              :unavailable-handler-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/unavailable-handler-symbol
                 :seon.effect/unavailable-handler-symbol]]],
              :missing-effect-id [:string {:min 1}],
              :missing-background-time-limit-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/missing-bound
                 :seon.effect/missing-bound]]],
              :recorded-effect-id [:string {:min 1}],
              :already-settled-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/settled-effect-id
                 :seon.effect/settled-effect-id]]],
              :run [:and #:seon.db{:index true} :seon.db/ref],
              :background? :boolean,
              :arguments
              [:map
               {:description
                "The admitted request or result map, handed to the writer beside the receipt so the writer can record the entries this branch installs as attributes. It is transaction-function input, never an entity map."}],
              :invalid-request-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/request-owner
                 :seon.effect/request-owner]]],
              :no-evaluation-context-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/missing-context-member
                 :seon.effect/missing-context-member]]],
              :unadmitted-owner :qualified-symbol,
              :settled-at :inst,
              :request-identity [:string {:min 1}],
              :invalid-owner-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/owner-class :seon.effect/owner-class]]],
              :form-ordinal [:int {:min 0}],
              :settle-request
              [:map
               [:seon.effect/id :seon.effect/id]
               [:seon.effect/result-edn :seon.effect/result-edn]
               [:seon.effect/result-blob
                {:optional true}
                :seon.effect/result-blob]
               [:seon.effect/content-blobs
                {:optional true}
                :seon.effect/content-blobs]
               [:seon.effect/result-size
                {:optional true}
                :seon.effect/result-size]
               [:seon.effect/duration-ms :seon.effect/duration-ms]
               [:seon.effect/settled-at :seon.effect/settled-at]
               [:seon.effect/arguments
                {:optional true}
                :seon.effect/arguments]
               [:seon.effect/provenance
                {:optional true}
                :seon.effect/provenance]],
              :result-blob :seon.blob/digest,
              :owner-class :symbol,
              :ordinal [:int {:min 0}],
              :receipt
              [:map
               {:seon.db/attributes true,
                :seon.render/ai seon.effect/render-ai,
                :seon.render/html seon.effect/render-html}
               [:seon.effect/id :seon.effect/id]
               [:seon.effect/run :seon.effect/run]
               [:seon.effect/eval {:optional true} :seon.effect/eval]
               [:seon.effect/owner :seon.effect/owner]
               [:seon.effect/capability :seon.effect/capability]
               [:seon.effect/file {:optional true} :seon.effect/file]
               [:seon.effect/form-span
                {:optional true}
                :seon.effect/form-span]
               [:seon.effect/program
                {:optional true}
                :seon.effect/program]
               [:seon.effect/form-ordinal :seon.effect/form-ordinal]
               [:seon.effect/ordinal :seon.effect/ordinal]
               [:seon.effect/request-edn :seon.effect/request-edn]
               [:seon.effect/opened-at :seon.effect/opened-at]
               [:seon.effect/notify
                {:optional true}
                :seon.effect/notify]
               [:seon.effect/to {:optional true} :seon.effect/to]
               [:seon.effect/result-edn
                {:optional true}
                :seon.effect/result-edn]
               [:seon.effect/result-blob
                {:optional true}
                :seon.effect/result-blob]
               [:seon.effect/content-blobs
                {:optional true}
                :seon.effect/content-blobs]
               [:seon.effect/result-size
                {:optional true}
                :seon.effect/result-size]
               [:seon.effect/duration-ms
                {:optional true}
                :seon.effect/duration-ms]
               [:seon.effect/settled-at
                {:optional true}
                :seon.effect/settled-at]
               [:seon.effect/interrupted-at
                {:optional true}
                :seon.effect/interrupted-at]],
              :capability-symbol
              [:qualified-symbol #:seon.db{:index true}],
              :duration-ms [:int {:min 0}],
              :owner-without-handler :qualified-symbol,
              :capability
              [:qualified-symbol
               {:seon.db/index true,
                :description
                "Declared handler on a function; the exact dispatched handler observed on an effect. Only function declarations are live deletion obligations."}],
              :missing-context-member :qualified-keyword,
              :request-result
              :seon.schema/value,
              :opened-at :inst,
              :content-blobs [:vector :seon.blob/digest],
              :already-recorded-error
              [:and
               :seon.error/base
               [:map
                [:seon.effect/recorded-effect-id
                 :seon.effect/recorded-effect-id]]]}
