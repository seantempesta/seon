;; The config (lane CONFIG, owner 2026-10-21: "the only things that should stay are documented
;; config schemas that we are porting from seon if they are relevant"). The values, with each
;; key's unit, provenance and what happens at its bound, are in resources/seon/config/default.edn;
;; the keys' schemas are in seon.config.<area>.edn, v1's shape (~/src/seon resources/seon/schemas/
;; seon.config.*.edn): a schema with a :description and its :seon.config/unit.
;;
;; :seon.config/config is the whole resolved config: a closed map, so an unknown key refuses boot,
;; and its entries declare the attributes root writes on main's root entity (seon.config/facts).
{:seon.config/config
 [:map {:closed true :seon.db/attributes true :seon.render/html seon.render.ui/config-panel
        :description "The resolved config: every limit, bound, dial and default of the platform, one key each."}
  ;; root and its procs
  [:seon.config.root/max-agents :seon.config.root/max-agents]
  [:seon.config.root/api-writes :seon.config.root/api-writes]
  [:seon.config.root/api-batch :seon.config.root/api-batch]
  [:seon.config.root/writer-batch :seon.config.root/writer-batch]
  [:seon.config.root/writer-buf :seon.config.root/writer-buf]
  [:seon.config.root/reconciler-buf :seon.config.root/reconciler-buf]
  [:seon.config.root/standby-every :seon.config.root/standby-every]
  [:seon.config.root/gc-sweepers :seon.config.root/gc-sweepers]
  [:seon.config.root/runs-dir :seon.config.root/runs-dir]
  [:seon.config.root/store-path :seon.config.root/store-path]
  [:seon.config.root/main :seon.config.root/main]
  [:seon.config.root/system-path :seon.config.root/system-path]
  [:seon.config.root/tasks-dir :seon.config.root/tasks-dir]
  ;; the store
  [:seon.config.store/backend :seon.config.store/backend]
  [:seon.config.store/eid-lease :seon.config.store/eid-lease]
  [:seon.config.store/lmdb-map-bytes :seon.config.store/lmdb-map-bytes]
  [:seon.config.store/branching-factor :seon.config.store/branching-factor]
  [:seon.config.store/keep-history? :seon.config.store/keep-history?]
  [:seon.config.store/value-out-of-line-bytes :seon.config.store/value-out-of-line-bytes]
  [:seon.config.store/compressor :seon.config.store/compressor]
  ;; the machine
  [:seon.config.machine/memory-mb :seon.config.machine/memory-mb]
  [:seon.config.machine/relay-mb :seon.config.machine/relay-mb]
  ;; the check harness
  [:seon.config.check/ping-ms :seon.config.check/ping-ms]
  [:seon.config.check/hold-ms :seon.config.check/hold-ms]
  [:seon.config.check/pages-ms :seon.config.check/pages-ms]
  ;; agents
  [:seon.config.agent/max-running :seon.config.agent/max-running]
  [:seon.config.agent/max-turns :seon.config.agent/max-turns]
  [:seon.config.agent/cwd :seon.config.agent/cwd]
  [:seon.config.agent/inbox-size :seon.config.agent/inbox-size]
  [:seon.config.agent/trip-bytes :seon.config.agent/trip-bytes]
  [:seon.config.agent/heap-extra-bytes :seon.config.agent/heap-extra-bytes]
  [:seon.config.agent/sock-buf-bytes :seon.config.agent/sock-buf-bytes]
  [:seon.config.agent/form-ticks :seon.config.agent/form-ticks]
  [:seon.config.agent/form-top-fns :seon.config.agent/form-top-fns]
  [:seon.config.agent/test-ticks :seon.config.agent/test-ticks]
  ;; merges and refinement
  [:seon.config.merge/max-running :seon.config.merge/max-running]
  [:seon.config.merge/max-conflicts :seon.config.merge/max-conflicts]
  [:seon.config.merge/max-merge-turns :seon.config.merge/max-merge-turns]
  [:seon.config.task/budget :seon.config.task/budget]
  ;; Seon's own source
  [:seon.config.source/root {:optional true} :seon.config.source/root]
  [:seon.config.source/dirs :seon.config.source/dirs]
  [:seon.config.source/branch :seon.config.source/branch]
  [:seon.config.source/committer-name :seon.config.source/committer-name]
  [:seon.config.source/committer-email :seon.config.source/committer-email]
  [:seon.config.source/generations-dir :seon.config.source/generations-dir]
  [:seon.config.source/test-results-dir :seon.config.source/test-results-dir]
  [:seon.config.proofs/jobs :seon.config.proofs/jobs]
  ;; effects and the model
  [:seon.config.fx/buf :seon.config.fx/buf]
  [:seon.config.ai/provider :seon.config.ai/provider]
  [:seon.config.ai/script {:optional true} :seon.config.ai/script]
  [:seon.config.ai/model :seon.config.ai/model]
  [:seon.config.ai/max-tokens :seon.config.ai/max-tokens]
  [:seon.config.ai/thinking {:optional true} :seon.config.ai/thinking]
  [:seon.config.ai/reasoning-effort {:optional true} :seon.config.ai/reasoning-effort]
  [:seon.config.ai/max-in-flight :seon.config.ai/max-in-flight]
  [:seon.config.ai/providers :seon.config.ai/providers]
  [:seon.config.ai/models :seon.config.ai/models]
  [:seon.config.ai/rate :seon.config.ai/rate]
  [:seon.config.ai/chars-per-token-prior :seon.config.ai/chars-per-token-prior]
  ;; the printer
  [:seon.config.render.agent/token-budget :seon.config.render.agent/token-budget]
  [:seon.config.render.agent/max-depth :seon.config.render.agent/max-depth]
  [:seon.config.render.agent/whole-width :seon.config.render.agent/whole-width]
  [:seon.config.render.agent/max-name :seon.config.render.agent/max-name]
  [:seon.config.render.agent/max-number-digits :seon.config.render.agent/max-number-digits]
  [:seon.config.render.agent/sort-bound :seon.config.render.agent/sort-bound]
  [:seon.config.render/width :seon.config.render/width]
  [:seon.config.render/part-budget :seon.config.render/part-budget]
  [:seon.config.render/form-budget :seon.config.render/form-budget]
  [:seon.config.render/context-budget :seon.config.render/context-budget]
  [:seon.config.render/evals-budget :seon.config.render/evals-budget]
  [:seon.config.render/history-budget :seon.config.render/history-budget]
  [:seon.config.render/reference-tokens :seon.config.render/reference-tokens]
  [:seon.config.render/found :seon.config.render/found]
  [:seon.config.render.list/rows :seon.config.render.list/rows]
  [:seon.config.render.list/newest :seon.config.render.list/newest]
  [:seon.config.render.list/brief :seon.config.render.list/brief]
  [:seon.config.render.list/top :seon.config.render.list/top]
  [:seon.config.render/big-alloc :seon.config.render/big-alloc]
  [:seon.config.render/value-budget :seon.config.render/value-budget]
  [:seon.config.render/root-context-budget :seon.config.render/root-context-budget]
  [:seon.config.render/history-row-budget :seon.config.render/history-row-budget]
  ;; the web, the guarantees, the native probe
  [:seon.config.web/port :seon.config.web/port]
  [:seon.config.root/entrance-port :seon.config.root/entrance-port]
  [:seon.config.web/public-dir :seon.config.web/public-dir]
  [:seon.config.web/utc-offset :seon.config.web/utc-offset]
  [:seon.config.contract/guarantees :seon.config.contract/guarantees]
  [:seon.config.native/probe-lib :seon.config.native/probe-lib]]

 ;; which layer each key came from (seon.config/sources): the shipped file, config/local.edn,
 ;; a --config file or --set; written beside the config on main's root entity, as EDN text
 :seon.config/sources [:map-of {:seon.db/data true} :qualified-keyword :string]
 :seon.config/sources-fact [:map {:seon.db/attributes true} [:seon.config/sources :seon.config/sources]]

 ;; one refused key: unknown (not in :seon.config/config), missing (required, absent) or invalid
 :seon.config/problem [:map [:key :any] [:problem [:enum :unknown-key :missing-key :invalid]] [:value :string]]
 :seon.config/problems [:vector :seon.config/problem]
 :seon.config/refused [:map {:description "The config does not satisfy :seon.config/config: boot is refused, naming each key."}
                       [:seon.error/type [:= :seon.config/refused]] [:seon.error/operation :qualified-symbol]
                       [:seon.error/message :string] [:seon.config/problems {:optional true} :seon.config/problems]]}
