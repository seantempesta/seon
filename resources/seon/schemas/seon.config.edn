 ;; the config in force as an entity of its own (docs/config.md#facts-on-main): named by the content id of its map
 ;; (seon.task/config-tx), so the same config is one entity on every branch, and root's entity refs it (:seon.system/config)
 :seon.config/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :seon.config/config-fact [:and {:seon.db/attributes true :seon.render/hiccup seon.render.ui/config-panel
                                 :description "The config in force: its keys (:seon.config/config) and its content id."}
                           :seon.config/config [:map [:seon.config/id :seon.config/id]]]

 ;; which layer each key came from (seon.config/sources): the shipped file, a --config file
 ;; (the standing root's config/local.edn among them) or --set; written on main's root entity, as EDN text
 :seon.config/sources [:map-of :qualified-keyword :string]
 :seon.config/sources-fact [:map {:seon.db/attributes true :seon.db/root-only true} [:seon.config/sources :seon.config/sources]]

 ;; one refused key: unknown (not in :seon.config/config), missing (required, absent) or invalid
 :seon.config/problem [:map [:key :any] [:problem [:enum :missing-key :invalid]] [:value :string]]
 :seon.config/problems [:vector :seon.config/problem]
 :seon.config/refused [:map {:description "The config does not satisfy :seon.config/config: boot is refused, naming each key."}
                       [:seon.error/type [:= :seon.config/refused]] [:seon.error/operation :qualified-symbol]
                       [:seon.error/message :string] [:seon.config/problems {:optional true} :seon.config/problems]]
 ;; keys-schemas sweep: the properties of a config key's schema, and an option of the config reader
 :seon.config/at-load [:boolean {:description "On a config key's schema, true when the value is read once at load and a branch's change of it does not act until a rebuild."}]
 :seon.config/place [:boolean {:description "On a config key's schema, true when it names a place (a port, a path) read before any db, so a branch's statement of it does not act until a rebuild."}]
 :seon.config/build [:boolean {:description "On a config key's schema, true when the compiler reads its value at a build (bin/env, bin/build), so the binary's identity (seon.fx/binary-digest) holds it and a change of it is a build."}]
 :seon.config/unit [:string {:description "On a config key's schema, the unit its value is in (\"ms\", \"bytes\", \"path\"), shown beside it."}]
 :seon.config/checkout [:string {:description "In the options the config file is read with, the absolute path of the checkout that #seon/checkout paths are read under."}]}
