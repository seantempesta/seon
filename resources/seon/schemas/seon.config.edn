#:seon.config{:agent [:and {:seon.db/identity true
                           :description "The agent owning this addressable settings component."} :seon.db/ref],
              :settings [:map {:seon.db/attributes true
                               :seon.render/ai seon.agent/render-settings-ai
                               :seon.render/html seon.agent/render-settings-html
                               :seon.config/display
                               {:seon.config.eval/time-limit-ms #:seon.config{:display-label "Evaluation deadline" :display-divisor 1000 :display-unit "s"}
                                :seon.config.ai/timeout-ms #:seon.config{:display-label "Provider timeout" :display-divisor 1000 :display-unit "s"}
                                :seon.config.ai.backup/timeout-ms #:seon.config{:display-label "Backup provider timeout" :display-divisor 1000 :display-unit "s"}
                                :seon.config.ai.retry/base-delay-ms #:seon.config{:display-label "Initial retry delay" :display-divisor 1000 :display-unit "s"}
                                :seon.config.ai.retry/maximum-delay-ms #:seon.config{:display-label "Maximum retry delay" :display-divisor 1000 :display-unit "s"}
                                :seon.config.ai.retry/maximum-total-delay-ms #:seon.config{:display-label "Total retry delay" :display-divisor 1000 :display-unit "s"}
                                :seon.config.agent/turn-completion-backstop-ms #:seon.config{:display-label "Turn completion allowance" :display-divisor 1000 :display-unit "s"}
                                :seon.config.web/timeout-ms #:seon.config{:display-label "Web timeout" :display-divisor 1000 :display-unit "s"}
                                :seon.config.shell/time-limit-ms #:seon.config{:display-label "Shell deadline" :display-divisor 1000 :display-unit "s"}
                                :seon.config.shell/termination-grace-ms #:seon.config{:display-label "Shell termination grace" :display-divisor 1000 :display-unit "s"}}}
                         [:seon.config/agent :seon.config/agent]],
              :display-label :string,
              :display-divisor [:int {:min 1}],
              :display-unit :string,
              :display [:map-of :qualified-keyword
                        [:map
                         [:seon.config/display-label {:optional true} :seon.config/display-label]
                         [:seon.config/display-divisor {:optional true} :seon.config/display-divisor]
                         [:seon.config/display-unit {:optional true} :seon.config/display-unit]]],
              :dial :boolean,
              :optional :boolean,
              :per-agent :boolean,
              :applied-manifest-digest [:re "^[0-9a-f]{64}$"],
              :apply-request
              [:map
               [:seon.db/connection :seon.db/connection]
               [:seon.config/manifest
                {:optional true}
                :seon.config/manifest]
               [:seon.config/environment
                {:optional true}
                :seon.config/manifest]
               [:seon.boot/cluster-name
                :seon.boot/cluster-name]],
              :cluster [:string {:min 1, :seon.db/identity true}],
              :missing-effective :seon.boot/cluster-name
              :missing-effective-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the cluster whose effective configuration facts are absent"} [:seon.config/missing-effective :seon.config/missing-effective] [:seon.error/message :seon.error/message]]
              :compile-request
              [:map
               [:seon.config/manifest
                {:optional true}
                :seon.config/manifest]
               [:seon.config/environment
                {:optional true}
                :seon.config/manifest]
               [:seon.boot/cluster-name
                :seon.boot/cluster-name]],
              :compiled
              [:map
               [:seon.config/effective :seon.config/effective]
               [:seon.config/applied-manifest-digest
                :seon.config/applied-manifest-digest]
               [:seon.config/desired-row :seon.config/entity]
               [:seon.config/resolved-attributes
                [:set :qualified-keyword]]],
              :on-core-error
              [:enum #:seon.config{:dial true} :record :panic],
              :rule :keyword,
              :path [:string {:min 1}],
              :key :qualified-keyword,
              :refused :seon.config/rule
              :refused-error [:and {:seon.error/class true :seon.error/refusal true :seon.error/refusal-shape :seon.error/refusal-value :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :gen/schema [:map [:seon.config/refused :seon.config/refused] [:seon.error/message :seon.error/message]] :error/message "must identify the refused configuration rule"} :seon.error/refusal-value [:map [:seon.config/refused :seon.config/refused]]]
              :manifest-unreadable :seon.config/path
              :manifest-unreadable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the configuration manifest that could not be read"} [:seon.config/manifest-unreadable :seon.config/manifest-unreadable] [:seon.error/message :seon.error/message]]
              :reconcile-refused :seon.config/rule
              :reconcile-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the rule that refused configuration reconciliation"} [:seon.config/reconcile-refused :seon.config/reconcile-refused] [:seon.error/message :seon.error/message]]
              :required-absent :seon.config/key
              :required-absent-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the required configuration key that is absent"} [:seon.config/required-absent :seon.config/required-absent] [:seon.error/message :seon.error/message]]
              :unknown-key :seon.config/key
              :unknown-key-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the unknown configuration key"} [:seon.config/unknown-key :seon.config/unknown-key] [:seon.error/message :seon.error/message]]
 :seon.config/missing-result-cap [:= true]
 :seon.config/missing-result-cap-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.config/missing-result-cap class marker"} [:seon.config/missing-result-cap :seon.config/missing-result-cap] [:seon.error/message :seon.error/message]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.config/error
 [:and
 [:and
  {:seon.db/attributes true}
  :seon.error/base
  [:map
   {:seon.db/attributes true}
   [:seon.config/error-key :seon.config/error-key]]]
 [:fn
  {:error/message "config-expectation-present?",
   :gen/gen seon.error/config-expectation-present-generator}
  seon.error/config-expectation-present?]]

 :seon.config/error-key
 :qualified-keyword

 :seon.config/rule-error
 [:and
 {:seon.db/attributes true}
 :seon.config/error
 [:map
  {:seon.db/attributes true}
  [:seon.config/rule :seon.config/rule]]]
}
