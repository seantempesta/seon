#:my.shell{:argv [:vector {:min 1} [:string {:min 1}]]
           :cwd :my.fs/path
           :exit :int
           :run-request
           [:map
            [:my.shell/argv :my.shell/argv]
            [:my.shell/cwd :my.shell/cwd]
            [:my.shell/stdin {:optional true} :my.shell/stdin]]
           :run-result
           [:map
            [:my.shell/argv :my.shell/argv]
            [:my.shell/cwd :my.shell/cwd]
            [:my.shell/exit :my.shell/exit]
            [:my.shell/stdout :my.shell.output/value]
            [:my.shell/stderr :my.shell.output/value]]
           :stderr :my.shell.output/value
           :stdin
           [:and
            [:map
             [:my.shell/stdin-text {:optional true} :my.shell/stdin-text]
             [:my.shell/stdin-bytes {:optional true} :my.shell/stdin-bytes]
             [:seon.blob/digest {:optional true} :seon.blob/digest]]
            [:fn
             {:error/message
              "must contain exactly one stdin source: :my.shell/stdin-text, :my.shell/stdin-bytes, or :seon.blob/digest"
              :gen/schema
              [:or
               [:map [:my.shell/stdin-text :my.shell/stdin-text]]
               [:map [:my.shell/stdin-bytes :my.shell/stdin-bytes]]
               [:map [:seon.blob/digest :seon.blob/digest]]]}
             my.shell/stdin?]]
           :stdin-bytes :my.fs/bytes
           :stdin-text :string
           :stdout :my.shell.output/value
 :my.shell/blob-unavailable [:= true]
 :my.shell/blob-unavailable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :my.shell/blob-unavailable class marker"} [:my.shell/blob-unavailable :my.shell/blob-unavailable] [:seon.error/message :seon.error/message]]
 :my.shell/stdin-limit [:= true]
 :my.shell/stdin-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :my.shell/stdin-limit class marker"} [:my.shell/stdin-limit :my.shell/stdin-limit] [:seon.error/message :seon.error/message]]
 :my.shell/cwd-refused [:= true]
 :my.shell/cwd-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a refused child working directory"} [:my.shell/cwd-refused :my.shell/cwd-refused] [:seon.error/message :seon.error/message]]
 :my.shell/time-limit [:= true]
 :my.shell/time-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a foreign process stopped by its time limit"} [:my.shell/time-limit :my.shell/time-limit] [:seon.error/message :seon.error/message]]
 :my.shell/start-failed [:= true]
 :my.shell/start-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a foreign process that could not start"} [:my.shell/start-failed :my.shell/start-failed] [:seon.error/message :seon.error/message]]}
