#:my.shell{:argv [:vector {:min 1} [:string {:min 1}]]
           :cwd :my.fs/path
           :exit :int
           :run-request
           [:map
            [:my.shell/argv :my.shell/argv]
            [:my.shell/cwd :my.shell/cwd]
            [:my.shell/stdin {:optional true} :my.shell/stdin]]
           :run-result
           [:map
            [:my.shell/argv :my.shell/argv]
            [:my.shell/cwd :my.shell/cwd]
            [:my.shell/exit :my.shell/exit]
            [:my.shell/stdout :my.shell.output/value]
            [:my.shell/stderr :my.shell.output/value]]
           :stderr :my.shell.output/value
           :stdin
           [:and
            [:map
             [:my.shell/stdin-text {:optional true} :my.shell/stdin-text]
             [:my.shell/stdin-bytes {:optional true} :my.shell/stdin-bytes]
             [:seon.blob/digest {:optional true} :seon.blob/digest]]
            [:fn
             {:error/message
              "must contain exactly one stdin source: :my.shell/stdin-text, :my.shell/stdin-bytes, or :seon.blob/digest"
              :gen/schema
              [:or
               [:map [:my.shell/stdin-text :my.shell/stdin-text]]
               [:map [:my.shell/stdin-bytes :my.shell/stdin-bytes]]
               [:map [:seon.blob/digest :seon.blob/digest]]]}
             seon.shell/stdin?]]
           :stdin-bytes :my.fs/bytes
           :stdin-text :string
           :stdout :my.shell.output/value
 :my.shell/stdin-blob-digest :seon.blob/digest
 :my.shell/stdin-blob-offset [:int {:min 0}]
 :my.shell/blob-unavailable-error
 [:and :seon.error/base
  [:map
   [:my.shell/stdin-blob-digest :my.shell/stdin-blob-digest]
   [:my.shell/stdin-blob-offset :my.shell/stdin-blob-offset]
]]
 :my.shell/stdin-byte-limit [:int {:min 0}]
 :my.shell/observed-stdin-bytes [:int {:min 0}]
 :my.shell/stdin-limit-error
 [:and :seon.error/base
  [:map
   [:my.shell/stdin-byte-limit :my.shell/stdin-byte-limit]
   [:my.shell/observed-stdin-bytes :my.shell/observed-stdin-bytes]
]]
 :my.shell/cwd-observation
 [:or :my.fs/stat-result :my.fs/path-refused-error :my.fs/not-found-error
      :my.fs/not-directory-error :my.fs/read-failed-error]
 :my.shell/process-exception-data :map
 :my.shell/refused-cwd :my.fs/path
 :my.shell/cwd-refused-error
 [:and :seon.error/base
  [:map
   [:my.shell/refused-cwd :my.shell/refused-cwd]
   [:my.shell/cwd-observation {:optional true} :my.shell/cwd-observation]
]]
 :my.shell/terminated-pid :int
 :my.shell/limiting-config-key :qualified-keyword
 :my.shell/time-limit-error
 [:and :seon.error/base
  [:map
   [:my.shell/terminated-pid :my.shell/terminated-pid]
   [:my.shell/limiting-config-key :my.shell/limiting-config-key]
]]
 :my.shell/failed-argv :my.shell/argv
 :my.shell/start-failed-error
 [:and :seon.error/base
  [:map
   [:my.shell/failed-argv :my.shell/failed-argv]
   [:my.shell/process-exception-data {:optional true} :my.shell/process-exception-data]
]]
 ; Additive error declaration manifest, 2026-09-18.

 :my.shell/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:my.shell/error-command :my.shell/error-command]
  [:my.shell/execution-observation :my.shell/execution-observation]]]

 :my.shell/error-command
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :my.shell/execution-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]
}
