#:seon.task.attempt
{:end [:enum {:seon.db/index true :seon.wake/starts true
              :description "How an attempt ended, asserted once on its assignment row by seon.turn/end-task-call: proofs green, given back, turns spent, stalled, sent back to :seon.task.attempt/target, cancelled, or failed to execute (runtime-follows-db §2)."}
       :done :given-back :capped :stalled :sent-back :cancelled :error]
 :relaunch [:string {:min 1 :seon.db/index true :seon.wake/starts true :description "Root's reason for launching another attempt after this ended one."}]
 :relaunch-fork [:uuid {:description "The commit root explicitly chooses for the next attempt instead of this attempt's fork point."}]
 :target [:and {:description "The task a :sent-back end sends the work back to."} :seon.db/ref]
 :number [:int {:min 1 :description "Which attempt of its task this row is: one more than the task's ended attempts when it was written (seon.task/attempt-tx); with the task's handle it derives the row's identity."}]
 :reason [:string {:min 1 :description "Why an attempt ended other than :done."}]
 :commit [:uuid {:description "The attempt's branch commit at its end: its successor's fork basis, keyed by commit id, never t."}]
 :fork [:uuid {:description "The commit the attempt's branch forked from when it is its predecessor's end commit (a need's :seon.task.attempt/commit), recorded once with the attempt row (seon.cluster.agent/write-attempt!) so a restart forks the same world; absent, the branch forked main after the attempt row was written. The predecessor's branch is kept (its head is that commit, with its merge base) until no successor waits on it."}]}
