#:seon.embed{:task
             [:enum {:description "The embed server's task prefix: similarity for names, code for a query by meaning, none for a text carrying its own `title: T | text: C` prefix."}
              "similarity" "document" "code" "query" "none"],
             :text [:string {:min 1}],
             :key [:string {:min 64, :max 64, :description "SHA-256 of model, task, dimension and text: an embedding's content identity."}],
             :octets [:fn {:error/message "must be the little-endian float32 bytes of one embedding"} clojure.core/bytes?],
             :settings
             [:map
              [:seon.config.embed/endpoint :seon.config.embed/endpoint]
              [:seon.config.embed/model :seon.config.embed/model]
              [:seon.config.embed/dimension :seon.config.embed/dimension]
              [:seon.config.embed/request-bytes :seon.config.embed/request-bytes]
              [:seon.config.embed/timeout-ms :seon.config.embed/timeout-ms]
              [:seon.config.embed/wait-ms :seon.config.embed/wait-ms]],
             :store [:map {:description "The durable konserve store of embeddings: packed segments and their manifest (seon.embed/write-segment!)."}],
             :segment [:fn {:error/message "must be a packed segment: int32 count and width, the digests, then the embeddings"} clojure.core/bytes?],
             :segment-id [:string {:min 64, :max 64, :description "SHA-256 of a packed segment's bytes: its content identity and store key."}],
             :count [:int {:min 1 :description "How many embeddings a segment holds."}],
             :width [:int {:min 1 :description "Octets per embedding in a segment."}],
             :row
             [:map {:description "Where one embedding lives: its segment, its row there and the segment's count and width (seon.embed/present)."}
              [:seon.embed/segment :seon.embed/segment-id]
              [:seon.embed/row nat-int?]
              [:seon.embed/count :seon.embed/count]
              [:seon.embed/width :seon.embed/width]],
             :layers
             [:map {:description "The embeddings of texts by content key, by the layer that held them (seon.embed/layered)."}
              [:seon.embed/content-keys [:vector :seon.embed/key]]
              [:seon.embed/from-cache :seon.embed/found]
              [:seon.embed/from-store :seon.embed/found]
              [:seon.embed/from-server :seon.embed/found]
              [:seon.embed/error {:optional true} :seon.embed/unreachable-error]],
             :found [:map-of {:description "Embeddings by content key."} :seon.embed/key :seon.embed/octets],
             :request [:fn {:error/message "must be a function of settings, task and texts, like seon.embed/request!"} clojure.core/ifn?],
             :reason [:string {:min 1}],
             :unreachable-error
             [:merge :seon.error/base
              [:map {:error/message "must name the endpoint it could not reach"}
               [:seon.config.embed/endpoint :seon.config.embed/endpoint]
               [:seon.embed/reason :seon.embed/reason]]],
             :embedded
             [:map
              [:seon.embed/vectors [:vector :seon.embed/octets]]
              [:seon.embed/hot nat-int?]
              [:seon.embed/durable nat-int?]
              [:seon.embed/requested nat-int?]],
             :matrix [:fn {:error/message "must be the row-major little-endian float32 bytes of the embeddings"} clojure.core/bytes?],
             :index
             [:map {:description "The embeddings of texts as one matrix, row i the embedding of text i (seon.embed/index)."}
              [:seon.embed/texts [:vector :seon.embed/text]]
              [:seon.embed/matrix :seon.embed/matrix]],
             :texts [:vector :seon.embed/text],
             :score [:double {:description "Cosine similarity, rounded to thousandths: 1.0 the same direction."}],
             :neighbours
             [:vector {:description "Texts nearest a query, nearest first (seon.embed/nearest)."}
              [:map [:seon.embed/text :seon.embed/text] [:seon.embed/score :seon.embed/score]]],
             :pending [:int {:min 1 :description "How many texts the index still being derived ranks."}],
             :in-progress
             [:map {:description "Embedding in progress: the index of these texts is still being derived (by the background fill, seon.embed/fill-step, or this call's own miss), so the call answers now with nothing ranked; repeat it shortly."}
              [:seon.embed/pending :seon.embed/pending]],
             :answer [:or :seon.embed/neighbours :seon.embed/in-progress]
             :when
             [:enum {:description "When an embedded attribute's texts are embedded: :write by the background fill as they are written (seon.embed/fill-step), :query on the first query of their corpus."}
              :write :query],
             :reads [:set {:description "The attributes an embedded text is built from: a change to any of them changes the text (the attribute itself always)."} :qualified-keyword],
             :text-fn [:qualified-symbol {:description "The function building an embedded attribute's texts from its entity's values of the attribute and its reads (a map), none leaving the entity out of the corpus; absent, the text is the attribute's value as a string."}],
             :declaration
             [:map {:description "An attribute's embedding, declared by `:seon.embed/task` in its schema's properties (seon.embed/embedded-attributes)."}
              [:seon.embed/task :seon.embed/task]
              [:seon.embed/when :seon.embed/when]
              [:seon.embed/reads :seon.embed/reads]
              [:seon.embed/text-fn {:optional true} :seon.embed/text-fn]],
             :declarations [:map-of {:description "Each embedded attribute's declaration."} :qualified-keyword :seon.embed/declaration],
             :held
             [:map {:description "Texts an index ranks, sorted and distinct, with the digest naming them (seon.embed/held)."}
              [:seon.embed/texts :seon.embed/texts]
              [:seon.embed/digest :seon.embed/key]],
             :entities [:map-of {:description "The entities holding each text of a corpus, by entity id."} :seon.embed/text [:vector :int]],
             :corpus
             [:merge {:description "One task's corpus on a database value: the texts of every attribute declaring that task, and the entities holding each (seon.embed/corpus)."}
              :seon.embed/held
              [:map [:seon.embed/task :seon.embed/task] [:seon.embed/entities :seon.embed/entities]]],
             :entity-neighbours
             [:vector {:description "The entities nearest a query on the asking database value, nearest first (seon.embed/entities-now)."}
              [:map [:db/id :int] [:seon.embed/text :seon.embed/text] [:seon.embed/score :seon.embed/score]]],
             :entity-answer [:or :seon.embed/entity-neighbours :seon.embed/in-progress]}
