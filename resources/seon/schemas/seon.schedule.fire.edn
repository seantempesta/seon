#:seon.schedule.fire{:id
                     [:string {:min 1, :seon.db/identity true}],
                     :task [:and #:seon.db{:index true} :seon.db/ref],
                     :nominal-at
                     [:and #:seon.db{:index true} :inst],
                     :observed-at :inst,
                     :agent
                     [:and
                      {:description
                       "The agent this firing belongs to: the owner of the fired task, carried on the firing so the wake router needs no query. A LISTENED ATTRIBUTE, one datom per firing entity with its own transaction `:t`, asserted once and never retracted-and-reasserted — a recurrence definition asserts nothing. It does NOT open a turn: a firing surfaces in the agent's next context, and the maintenance portfolio's ticks are not model calls.",
                       :seon.db/index true,
                       :seon.wake/listen true,
                       :seon.wake/opens-turn? false}
                      :seon.db/ref],
                     :fire
                     [:map {:seon.db/attributes true :seon.program/partition :seon.data}
                      [:seon.schedule.fire/id :seon.schedule.fire/id]
                      [:seon.schedule.fire/task :seon.schedule.fire/task]
                      [:seon.schedule.fire/agent :seon.schedule.fire/agent]
                      [:seon.schedule.fire/nominal-at
                       :seon.schedule.fire/nominal-at]
                      [:seon.schedule.fire/observed-at
                       :seon.schedule.fire/observed-at]],
                     :request
                     [:map
                      [:seon.schedule.task/id :seon.schedule.task/id]
                      [:seon.schedule.fire/id :seon.schedule.fire/id]
                      [:seon.agent/id :seon.agent/id]
                      [:seon.fn/sym :seon.fn/sym]
                      [:seon.schedule.fire/nominal-at
                       :seon.schedule.fire/nominal-at]
                      [:seon.schedule.fire/observed-at
                       :seon.schedule.fire/observed-at]
                      [:seon.boot/cluster-name :seon.boot/cluster-name]
                      [:seon.operator/repository-root
                       :seon.operator/repository-root]
                      [:seon.operator/managed-root
                       :seon.operator/managed-root]
                      [:seon.boot/log-dir :seon.boot/log-dir]
                      [:seon.config.maintenance/min-usable-bytes
                       {:optional true}
                       :seon.config.maintenance/min-usable-bytes]
                      [:seon.config.maintenance/min-usable-ratio
                       {:optional true}
                       :seon.config.maintenance/min-usable-ratio]
                      [:seon.config.maintenance/log-max-bytes
                       {:optional true}
                       :seon.config.maintenance/log-max-bytes]
                      [:seon.config.maintenance/log-retained-files
                       {:optional true}
                       :seon.config.maintenance/log-retained-files]
                      [:seon.config.operator/event-silence-backstop-ms
                       {:optional true}
                       :seon.config.operator/event-silence-backstop-ms]]}
