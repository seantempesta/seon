;; The model provider and its effect workers (v1: seon.config.ai.edn; ported: model,
;; api-key-variable, max-tokens, thinking, chars-per-token-prior; base-url replaces
;; v1's endpoint (next appends /chat/completions); provider, script, workers, rate are new).
{:seon.config.ai/provider [:enum {:seon.config/unit "kind" :description "Who answers agents' turns: the scripted model or an OpenAI-compatible endpoint."} :scripted :openai-compat]
 :seon.config.ai/script [:qualified-symbol {:seon.config/unit "function" :description "The scripted model's reply function (provider :scripted)."}]
 :seon.config.ai/base-url [:string {:min 1 :seon.config/unit "URL" :description "The OpenAI-compatible endpoint's base URL (/chat/completions is appended)."}]
 :seon.config.ai/model [:string {:min 1 :seon.config/unit "model name" :description "The provider's own model name."}]
 :seon.config.ai/api-key-variable [:string {:min 1 :seon.config/unit "env var name" :description "The NAME of the environment variable holding the key; never the key."}]
 :seon.config.ai/max-tokens [:int {:min 1 :seon.config/unit "tokens" :description "A reply's completion budget, reasoning included."}]
 :seon.config.ai/thinking [:enum {:seon.config/unit "mode" :description "DeepSeek's thinking mode; absent: the provider's default."} :enabled :disabled]
 :seon.config.ai/reasoning-effort [:enum {:seon.config/unit "effort" :description "DeepSeek's reasoning effort; absent: the provider's default."} :low :medium :high]
 :seon.config.ai/max-in-flight [:int {:min 1 :seon.config/unit "calls" :description "Model calls in flight at once, cluster-wide: our admission cap (the :model owner's workers)."}]
 :seon.config.ai/rate [:int {:min 0 :seon.config/unit "tokens/s" :description "Tokens per second the provider admits (the :model owner's bucket). 0: no bucket."}]
 ;; ---- the model manifest (v1's seon.ai.model rows; config/default.edn :seon.config.ai/providers,
 ;; :seon.config.ai/models): by id in the file, an entity each on main
 :seon.config.ai/providers [:map-of {:seon.db/data true :seon.config/unit "providers" :description "The model providers, by id: their wire facts and their own settings."} :string :seon.ai.model/provider-settings]
 :seon.config.ai/models [:map-of {:seon.db/data true :seon.config/unit "models" :description "The models, by id: their provider, window, prices and their own settings."} :string :seon.ai.model/model-settings]
 :seon.ai.model/provider-settings [:map {:closed true}
                                   [:seon.config.ai/base-url :seon.config.ai/base-url]
                                   [:seon.config.ai/api-key-variable :seon.config.ai/api-key-variable]
                                   [:seon.ai.model/output-token-wire-key :seon.ai.model/output-token-wire-key]
                                   [:seon.config.ai/max-in-flight {:optional true} :seon.config.ai/max-in-flight]]
 :seon.ai.model/model-settings [:map {:closed true}
                                [:seon.ai.model/provider :seon.ai.model/provider]
                                [:seon.ai.model/version :seon.ai.model/version]
                                [:seon.ai.model/context-window-tokens :seon.ai.model/context-window-tokens]
                                [:seon.ai.model/max-output-tokens :seon.ai.model/max-output-tokens]
                                [:seon.ai.model/input-usd-per-mtok :seon.ai.model/input-usd-per-mtok]
                                [:seon.ai.model/cached-input-usd-per-mtok :seon.ai.model/cached-input-usd-per-mtok]
                                [:seon.ai.model/output-usd-per-mtok :seon.ai.model/output-usd-per-mtok]
                                [:seon.ai.model/thinking-dials :seon.ai.model/thinking-dials]
                                [:seon.ai.model/provider-max-in-flight :seon.ai.model/provider-max-in-flight]
                                [:seon.ai.model/source :seon.ai.model/source]
                                [:seon.config.ai/max-in-flight {:optional true} :seon.config.ai/max-in-flight]
                                [:seon.config.ai/max-tokens {:optional true} :seon.config.ai/max-tokens]]
 :seon.ai.model/provider-id [:and {:seon.db/identity true} :string]
 :seon.ai.model/id [:and {:seon.db/identity true} :string]
 :seon.ai.model/provider [:string {:min 1 :description "The model's provider, by id."}]
 :seon.ai.model/version [:string {:min 1 :description "The provider's name for the build behind this id."}]
 :seon.ai.model/output-token-wire-key [:string {:min 1 :description "The request field the completion budget is sent in."}]
 :seon.ai.model/context-window-tokens [:int {:min 1 :seon.config/unit "tokens"}]
 :seon.ai.model/max-output-tokens [:int {:min 1 :seon.config/unit "tokens"}]
 :seon.ai.model/input-usd-per-mtok [:double {:min 0.0 :seon.config/unit "USD / M tokens"}]
 :seon.ai.model/cached-input-usd-per-mtok [:double {:min 0.0 :seon.config/unit "USD / M tokens"}]
 :seon.ai.model/output-usd-per-mtok [:double {:min 0.0 :seon.config/unit "USD / M tokens"}]
 :seon.ai.model/thinking-dials [:set :keyword]
 :seon.ai.model/provider-max-in-flight [:int {:min 1 :seon.config/unit "calls" :description "The provider's documented concurrency ceiling for this model, per account."}]
 :seon.ai.model/source [:string {:min 1 :description "Where the prices and limits were read, and when."}]
 :seon.ai.model/provider-fact [:map {:seon.db/attributes true}
                               [:seon.ai.model/provider-id :seon.ai.model/provider-id]
                               [:seon.config.ai/base-url :seon.config.ai/base-url]
                               [:seon.config.ai/api-key-variable :seon.config.ai/api-key-variable]
                               [:seon.ai.model/output-token-wire-key :seon.ai.model/output-token-wire-key]]
 :seon.ai.model/model-fact [:map {:seon.db/attributes true}
                            [:seon.ai.model/id :seon.ai.model/id]
                            [:seon.ai.model/provider :seon.ai.model/provider]
                            [:seon.ai.model/version :seon.ai.model/version]
                            [:seon.ai.model/context-window-tokens :seon.ai.model/context-window-tokens]
                            [:seon.ai.model/max-output-tokens :seon.ai.model/max-output-tokens]
                            [:seon.ai.model/input-usd-per-mtok :seon.ai.model/input-usd-per-mtok]
                            [:seon.ai.model/cached-input-usd-per-mtok :seon.ai.model/cached-input-usd-per-mtok]
                            [:seon.ai.model/output-usd-per-mtok :seon.ai.model/output-usd-per-mtok]
                            [:seon.ai.model/thinking-dials :seon.ai.model/thinking-dials]
                            [:seon.ai.model/provider-max-in-flight :seon.ai.model/provider-max-in-flight]
                            [:seon.ai.model/source :seon.ai.model/source]]
 ;; a setting resolved (seon.config/resolve): its value and where it came from
 :seon.config/source [:or [:tuple [:= :task]] [:tuple [:enum :model :provider :config] :string]]
 :seon.config/resolved [:map [:value :any] [:source :seon.config/source]]
 :seon.config/context [:map [:task {:optional true} [:maybe :map]] [:model {:optional true} [:maybe :string]]]
 :seon.config.ai/chars-per-token-prior [:double {:min 0.5 :seon.config/unit "chars/token" :description "Characters per token the printer and context estimate with."}]
 :seon.config.fx/buf [:int {:min 1 :seon.config/unit "requests" :description "Requests one effect owner holds queued; at the bound agent procs park."}]}
