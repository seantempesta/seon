#:seon.cluster.work{:agent-request
                    [:map
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.cluster.run/process
                      :seon.cluster.run/process]],
                    :episode-runs [:int {:min 0}],
                    :form-settlement
                    [:map
                     [:seon.cluster.run.form/id
                      :seon.cluster.run.form/id]
                     [:seon.cluster.run.form/ordinal
                      :seon.cluster.run.form/ordinal]
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.cluster.eval/id
                      {:optional true}
                      :seon.cluster.eval/id]
                     [:seon.problems/id
                      {:optional true}
                      :seon.problems/id]
                     [:seon.cluster.work/form-state
                      :seon.cluster.work/form-state]
                     [:seon.cluster.work/settled?
                      :seon.cluster.work/settled?]],
                    :form-state
                    [:enum
                     :unevaluated
                     :running
                     :succeeded
                     :routed
                     :unrouted-red
                     :owner-fixed
                     :owner-declared-cant],
                    :forms
                    [:vector :seon.cluster.work/form-settlement],
                    :next
                    [:multi
                     {:dispatch :seon.cluster.work/situation}
                     [:resume
                      [:map
                       [:seon.cluster.work/situation [:= :resume]]
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id :seon.cluster.agent/id]
                       [:seon.cluster.run.form/ordinal
                        :seon.cluster.run.form/ordinal]]]
                     [:call
                      [:map
                       [:seon.cluster.work/situation [:= :call]]
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id
                        :seon.cluster.agent/id]]]
                     [:open
                      [:map
                       [:seon.cluster.work/situation [:= :open]]
                       [:seon.cluster.agent/id :seon.cluster.agent/id]
                       [:seon.cluster.message/id
                        {:optional true}
                        :seon.cluster.message/id]]]
                     [:close
                      [:map
                       [:seon.cluster.work/situation [:= :close]]
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id
                        :seon.cluster.agent/id]]]],
                    :now :inst,
                    :plan-settlement
                    [:map
                     [:seon.cluster.run/id :seon.cluster.run/id]
                     [:seon.cluster.work/forms
                      [:vector :seon.cluster.work/form-settlement]]
                     [:seon.cluster.work/settled?
                      :seon.cluster.work/settled?]],
                    :settled? :boolean,
                    :situation [:enum :resume :call :open :close]}
