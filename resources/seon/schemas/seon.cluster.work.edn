#:seon.cluster.work{:agent-request
                    [:map
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.cluster.run/process
                      :seon.cluster.run/process]],
                    :answered?
                    [:= :any],
                    :wake-request
                    [:map
                     {:description
                      "How much of an agent's wake history a derivation wants: absent means the unanswered ones, :any means every one of them. :seon.cluster.work/attributes says WHICH listened attributes are bound: absent means only those that open a turn, :listened means every listened attribute (what a context shows)."}
                     [:seon.cluster.work/answered?
                      {:optional true}
                      :seon.cluster.work/answered?]
                     [:seon.cluster.work/attributes
                      {:optional true}
                      :seon.cluster.work/attributes]],
                    :attributes
                    [:enum
                     {:description
                      "Which listened attributes a wake derivation binds: :opening (only those declared :seon.wake/opens-turn? true) or :listened (every listened attribute)."}
                     :opening :listened],
                    :episode-runs [:int {:min 0}],
                    :form-settlement
                    [:map
                     [:seon.cluster.eval/id
                      :seon.cluster.eval/id]
                     [:seon.cluster.eval/ordinal
                      :seon.cluster.eval/ordinal]
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.problems/id
                      {:optional true}
                      :seon.problems/id]
                     [:seon.cluster.work/form-state
                      :seon.cluster.work/form-state]
                     [:seon.cluster.work/settled?
                      :seon.cluster.work/settled?]],
                    :form-state
                    [:enum
                     :unevaluated
                     :running
                     :succeeded
                     :routed
                     :unrouted-red
                     :owner-fixed
                     :owner-declared-cant],
                    :forms
                    [:vector :seon.cluster.work/form-settlement],
                    :next
                    [:multi
                     {:dispatch :seon.cluster.work/situation}
                     [:resume
                      [:map
                       [:seon.cluster.work/situation [:= :resume]]
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id :seon.cluster.agent/id]
                       [:seon.cluster.eval/ordinal
                        :seon.cluster.eval/ordinal]]]
                     [:call
                      [:map
                       [:seon.cluster.work/situation [:= :call]]
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id
                        :seon.cluster.agent/id]]]
                     [:generate
                      [:map
                       [:seon.cluster.work/situation [:= :generate]]
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id
                        :seon.cluster.agent/id]]]
                     [:open
                      [:map
                       [:seon.cluster.work/situation [:= :open]]
                       [:seon.cluster.agent/id :seon.cluster.agent/id]
                       [:seon.cluster.message/id
                        {:optional true}
                        :seon.cluster.message/id]]]
                     [:close
                      [:map
                       [:seon.cluster.work/situation [:= :close]]
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id
                        :seon.cluster.agent/id]]]],
                    :now :inst,
                    :plan-settlement
                    [:map
                     [:seon.cluster.run/id :seon.cluster.run/id]
                     [:seon.cluster.work/forms
                      [:vector :seon.cluster.work/form-settlement]]
                     [:seon.cluster.work/settled?
                      :seon.cluster.work/settled?]],
                    :settled? :boolean,
                    :situation [:enum :resume :call :generate :open :close]}
