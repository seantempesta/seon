;; Proof runs by reach digest (seon.proofs/prove: bin/prove, bin/test, bin/check without a run
;; size, an agent's test run). Values, units and provenance: resources/seon/config/default.edn.
{:seon.config.proofs/full-run-at [:or {:seon.config/at-load true :seon.config/unit "hh:mm UTC" :description "The time of day (UTC) at which the cron proc (seon.cron) asks the test service for the full run of main (bin/test --all in a worktree of main, green or not: the net under the narrow digests, docs/merging.md), its shards caching their verdicts by digest as any run does. \"\": never. A root started after the time waits for the next day's; a malformed time is refused when the config loads."} [:= ""] [:re "(?:[01][0-9]|2[0-3]):[0-5][0-9]"]]
 :seon.config.proofs/prove-main-on-commit [:boolean {:seon.config/unit "boolean" :description "Whether each commit that moves main's program starts a run of main's tests in a prove agent forked from main (seon.prove)."}]
 :seon.config.proofs/results-dir [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "Where every checkout's test and check verdicts are kept, one file per (key, digest, status): the main tree's target/results under bin/env."}]
 :seon.config.proofs/results-max-bytes [:int {:min 1 :seon.config/unit "bytes" :description "The verdict cache's capacity; a write past it removes the least recently used verdicts (oldest mtime, greens and reds alike) until it is under, never the one just written."}]
 :seon.config.proofs/results-evict-percent [:int {:min 0 :max 100 :seon.config/unit "percent" :description "How far under results-max-bytes a write past it takes the cache."}]
 :seon.config.proofs/shard-min-ms [:int {:min 1 :seon.config/unit "ms" :description "The least work a shard of an incremental run is worth."}]
 :seon.config.proofs/reuse-audit [:int {:min 0 :seon.config/unit "tests" :description "How many reused greens of each class (tests that start a process, tests that do not) a run runs again, chosen by the tree (seon.proofs/plan-of's :audit)."}]
 :seon.config.proofs/recent-verdicts [:int {:min 1 :seon.config/unit "verdicts" :description "How many of a test's newest greens its history holds."}]
 :seon.config.proofs/program-store [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "The plan's store of kept program dbs, a branch per git tree id (test-runner/program-db)."}]
 :seon.config.proofs/program-store-max-bytes [:int {:min 1 :seon.config/unit "bytes" :description "The kept program dbs' store on disk; past it the store is removed before it is opened and starts again from the run's tree."}]
 :seon.config.proofs/check-store [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "The checks' own store, keyed by its seed (seon.check/seed); a store named otherwise is opened as given."}]
 :seon.config.proofs/check-store-max-bytes [:int {:min 1 :seon.config/unit "bytes" :description "The checks' seeded store on disk; past it, seeding removes and remakes it."}]
 :seon.config.proofs/slow-test-ms [:int {:min 1 :seon.config/unit "ms" :description "A test measured at this or over is left out of bin/prove and a merge until it is fast; naming it or the full run still runs it (docs/merging.md#a-slow-test-runs-last)."}]
 :seon.config.proofs/error-frames [:int {:min 1 :seon.config/unit "frames" :description "How many frames of where a test's error was thrown its report keeps (seon.proofs/error-at)."}]
 :seon.config.proofs/stall-factor [:int {:min 1 :seon.config/unit "times a test's last run" :description "How long, as a multiple of its own last recorded ms, a test bin/test runs may be quiet before it is named STALLED (never ended); :seon.config.agent/stall-ms is its floor and the bound of a test with no record."}]
 :seon.config.proofs/child-min-ms [:int {:min 1 :seon.config/unit "ms" :description "The least work a test child of an agent's test run is worth: a run forks at most its tests' typical ms over this children (seon.agent/run-tests-forked)."}]
 :seon.config.proofs/unmeasured-ms [:int {:min 1 :seon.config/unit "ms" :description "What an in-process test never measured counts for in a deal of tests into shards or children (seon.proofs/estimated-ms). See docs/merging.md#a-merge-runs-what-the-change-reaches."}]
 :seon.config.proofs/shard-mb [:int {:min 1 :seon.config/unit "MB" :description "What one shard of a run takes at its peak, its process and the roots and agents its tests start (seon.proofs/memory-jobs). See docs/merging.md#a-merge-runs-what-the-change-reaches."}]
 :seon.config.proofs/free-floor-mb [:int {:min 0 :seon.config/unit "MB" :description "The free memory a run leaves the machine; below it a run takes one shard (seon.proofs/memory-jobs). See docs/merging.md#a-merge-runs-what-the-change-reaches."}]
 :seon.config.proofs/unmeasured-process-ms [:int {:min 1 :seon.config/unit "ms" :description "What a process test never measured counts for in a deal of tests into shards or children (seon.proofs/estimated-ms). See docs/merging.md#a-merge-runs-what-the-change-reaches."}]
 :seon.config.proofs/jobs [:int {:min 1 :seon.config/unit "processes" :description "Shards a worktree session's or root's proof run (bin/prove, bin/test) runs its selected tests in at once."}]
 :seon.config.proofs/max-workers [:int {:min 1 :seon.config/unit "items" :description "The most items (a test, a process test, a check step, a build or seed) the test service runs at once on this machine: a count bound on its workers. Absent: no count bound of its own (max-cores, max-load or the machine's cores bound it). See docs/merging.md#the-test-service."}]
 :seon.config.proofs/max-cores [:and {:seon.config/unit "a share of the cores, in (0,1]" :description "The share of :seon.config.machine/cores the test service's items may use (rounded down, at least 1): at most that many items run at once. A count of items is max-workers. Absent: no core bound. See docs/config.md#the-test-services-three-limits."} :double [:> 0.0] [:<= 1.0]]
 :seon.config.proofs/max-load [:or {:seon.config/unit "the machine's 1-minute load average" :description "The test service grants an item only while the machine's 1-minute load average (seon.lib/load-average, read in a step the service already takes) is under this, except that with nothing running one item is always granted. Set per machine (config/local.edn), never shipped: a load is absolute, so one machine's number overloads a machine of fewer cores. Absent: the load admits everything. Admission only, never a verdict: docs/clocks.md#the-machines-load-admits-work."} [:double {:min 0.0}] [:int {:min 1}]]
 :seon.config.proofs/case-sizes [:int {:min 1 :seon.config/unit "test.check sizes" :description "How many sizes a generated cost proof's cases cycle through (seon.cost/cases): case i is drawn at (mod i this)."}]
 :seon.config.proofs/seed-salt [:int {:seon.config/unit "a salt (integer)" :description "Salt of every generative check's seed (seon.proofs/seed); 0 normally, changed to re-roll every seed once."}]
 :seon.config.proofs/seeds [:int {:min 1 :seon.config/unit "seeds (a count)" :description "How many seeds a randomized property test draws in this run (its test-seed and the next ones); the full run draws 5."}]
 :seon.config.proofs/cost-settled [:int {:min 2 :seon.config/unit "calls (in a row, allocating no fewer bytes than the least so far)" :description "How many calls in a row of a cost proof's measured function must allocate no fewer bytes than the least so far for the measure to take it as the steady state (seon.cost/measure)."}]
 :seon.config.proofs/cost-max-samples [:int {:min 1 :seon.config/unit "calls" :description "The most calls a cost proof makes of one function at one size when its one call was over its estimate (seon.cost/run): until cost-settled calls in a row allocate no fewer bytes, the least of them judged."}]
 :seon.config.proofs/cost-max-n [:int {:min 1 :seon.config/unit "n (a cost proof's input size)" :description "The largest input a cost proof measures in this run (seon.cost/sizes); the full run measures as written."}]
 :seon.config.proofs/test-ticks-cap [:int {:min 1 :seon.config/unit "engine ticks" :description "The most ticks a test's :seon.test/estimate may state; past it the test is an :undeclared-test. See docs/testing.md#test-kinds."}]
 :seon.config.proofs/system-test-asks-cap [:int {:min 0 :seon.config/unit "asks" :description "The most asks of its root a system test's estimate may state; past it the test is an :undeclared-test. See docs/testing.md#test-kinds."}]
 :seon.config.proofs/binary-test-execs-cap [:int {:min 0 :seon.config/unit "commands" :description "The most commands a binary test's estimate may state as :execs; past it the test is an :undeclared-test. See docs/testing.md#test-kinds."}]
 :seon.config.proofs/system-vars [:set {:seon.config/unit "vars" :description "The vars that start a running system for a test: a test reaching one through the test namespaces names its root (:seon.test/root). See docs/testing.md#test-kinds."} :qualified-symbol]
 :seon.config.proofs/exec-vars [:set {:seon.config/unit "vars" :description "The vars that run a command for a test: a test reaching one through the test namespaces names its commands (:seon.test/execs). See docs/testing.md#test-kinds."} :qualified-symbol]
 :seon.config.proofs/own-store-vars [:set {:seon.config/unit "vars" :description "The vars that make a store of a test's own: a test namespace calling one, not the shared world, is an :undeclared-test. See docs/testing.md#test-kinds."} :qualified-symbol]
 :seon.config.proofs/tick-quantum [:int {:min 0 :seon.config/unit "engine ticks" :description "What one measure of a call's ticks may be off by (a 1,000-tick timer chunk and ~50): seon.cost/judge allows it in the bound and in the growth fit."}]}
