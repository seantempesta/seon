;; A function's latest cost in one scope: one entity per symbol and scope
;; (`:seon.fn.cost/key`), holding two samples that are never averaged together
;; nor compared with each other: the COLD sample (the definition's first
;; :seon.config.fn.cost/cold-calls calls in a process, by its profile cell's
;; call order: startup cost, first-class) and the WARM sample (its later calls).
;; Each sample is the definition digest it was measured under, its calls and its
;; per-call self and inclusive microseconds, from a world's call sink
;; (`seon.batch/sink`, the `seon.profile/timed` counters): self time excludes
;; counted callees (FEEDBACK-LOOP card §2–3).
;; Producer: `seon.profile/transaction-observation`, called by the transaction
;; function `seon.db/cost-upserts` that `seon.db/stamp-transaction` appends to a
;; transaction the world already writes (zero extra transactions). Each sample is
;; replaced only from its own kind (cold from cold, warm from warm, same scope)
;; when none is stored, its digest changed or its self time moved by the factor
;; :seon.config.fn.cost/hysteresis (`seon.profile/moved?`). A warm sample needs
;; :seon.config.fn.cost/min-calls warm calls; either needs
;; :seon.config.fn.cost/min-total-us of self time; at most
;; :seon.config.test.cost/top new entities a transaction.
;; Consumers: `seon.batch/cost-diff` (main's side of the comparison, like with
;; like only), `seon.context`'s cost block, `seon.health`'s slow unit (warm), and
;; the queries "which functions are slow" (warm-self-us) and "which are slow to
;; start" (cold-self-us).
;; Every value is noHistory: the latest value is the fact, and a replacement
;; leaves one datom in the temporal indexes. Only the identity is indexed. Main's
;; entities come from main's own traffic; cost entities are data and never merge
;; as program.
#:seon.fn.cost
{:key [:tuple {:seon.db/identity true :seon.program/row-schema :seon.fn.cost/entity
               :description "The measured function and the scope its samples were measured in: :seon.profile/host a loaded Var's compiled wrapper, :seon.profile/context an interpreted SCI definition. Values of different scopes are never compared."}
       :qualified-symbol [:enum :seon.profile/host :seon.profile/context]]
 :warm-digest [:and {:seon.db/no-history? true
                     :description "The definition digest the warm sample was measured under."}
               :seon.program/definition-digest]
 :warm-calls [:int {:min 1 :seon.db/no-history? true
                    :description "The warm calls the warm sample averages over: calls after the definition's cold ones in its process. Stored only from at least :seon.config.fn.cost/min-calls; a reply's live entity may hold fewer."}]
 :warm-self-us [:double {:min 0.0 :seon.db/no-history? true
                         :description "Mean microseconds per warm call spent in the function itself, counted callees excluded."}]
 :warm-total-us [:double {:min 0.0 :seon.db/no-history? true
                          :description "Mean microseconds per warm call including counted callees."}]
 :cold-digest [:and {:seon.db/no-history? true
                     :description "The definition digest the cold sample was measured under."}
               :seon.program/definition-digest]
 :cold-calls [:int {:min 1 :seon.db/no-history? true
                    :description "The cold calls the cold sample averages over: the definition's first :seon.config.fn.cost/cold-calls calls in a process (its profile cell's call order)."}]
 :cold-self-us [:double {:min 0.0 :seon.db/no-history? true
                         :description "Mean microseconds per cold call spent in the function itself, counted callees excluded: its startup cost."}]
 :cold-total-us [:double {:min 0.0 :seon.db/no-history? true
                          :description "Mean microseconds per cold call including counted callees."}]
 :sample [:tuple {:description "One sample of a cost entity as a value (`seon.profile/sample`): digest, calls, per-call self and inclusive microseconds."}
          :seon.program/definition-digest [:int {:min 1}] [:double {:min 0.0}] [:double {:min 0.0}]]
 :entity [:map {:seon.db/attributes true :seon.program/partition :seon.data}
          [:seon.fn.cost/key :seon.fn.cost/key]
          [:seon.fn.cost/warm-digest {:optional true} :seon.fn.cost/warm-digest]
          [:seon.fn.cost/warm-calls {:optional true} :seon.fn.cost/warm-calls]
          [:seon.fn.cost/warm-self-us {:optional true} :seon.fn.cost/warm-self-us]
          [:seon.fn.cost/warm-total-us {:optional true} :seon.fn.cost/warm-total-us]
          [:seon.fn.cost/cold-digest {:optional true} :seon.fn.cost/cold-digest]
          [:seon.fn.cost/cold-calls {:optional true} :seon.fn.cost/cold-calls]
          [:seon.fn.cost/cold-self-us {:optional true} :seon.fn.cost/cold-self-us]
          [:seon.fn.cost/cold-total-us {:optional true} :seon.fn.cost/cold-total-us]]
 ;; No producer: one entity per symbol averaged cold and warm calls and any
 ;; scope together. Kept declared only until they can be retired (task
 ;; seon.db/transaction-stamp-attributes-outlive-their-producer).
 :sym [:qualified-symbol {:seon.db/identity true
                          :description "No longer written: the measured function of a per-symbol cost entity."}]
 :digest [:and {:seon.db/no-history? true :description "No longer written."} :seon.program/definition-digest]
 :scope [:enum {:seon.db/no-history? true :description "No longer written: the scope is the second member of :seon.fn.cost/key."}
         :seon.profile/host :seon.profile/context]
 :calls [:int {:min 1 :seon.db/no-history? true :description "No longer written."}]
 :self-us [:double {:min 0.0 :seon.db/no-history? true :description "No longer written."}]
 :total-us [:double {:min 0.0 :seon.db/no-history? true :description "No longer written."}]}
