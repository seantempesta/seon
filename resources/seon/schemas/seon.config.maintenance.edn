#:seon.config.maintenance{:collect?
                          [:boolean
                           {:seon.config/optional true,
                            :seon.config/dial true,
                            :description "Whole-store collection runs only when true; absent means off. The shipped decision (config/default.edn) is true: the plain collection keeps every branch's whole ancestry and sweeps only what no branch reaches, proven against a held value, a non-head adopted commit and a concurrent writer."}],
                          :log-max-bytes
                          [:int {:min 1, :seon.config/dial true}],
                          :log-retained-files
                          [:int {:min 0, :seon.config/dial true}],
                          :min-usable-bytes
                          [:int {:min 1, :seon.config/dial true}],
                          :min-usable-ratio
                          [:double
                           {:min 0.0,
                            :max 1.0,
                            :seon.config/dial true}]}
