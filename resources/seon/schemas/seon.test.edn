 ; One test request (track 1.3d commit 4): a test is an isolated agent for one body.
 :seon.test/execution
 [:and {:description "The execution value a test request runs: an agent context source or an acquired execution handle. Its connection's current commit is captured once per request."}
  :seon.agent/context-source]
 :seon.test/recording-connection
 [:and {:description "The durable authority a request admits and records on. It holds the execution branch; it never grants a test body custody."}
  :seon.db/connection]
 :seon.test/policy :seon.test.run/policy
 :seon.test/request
 [:map
  [:seon.test/execution :seon.test/execution]
  [:seon.test/recording-connection :seon.test/recording-connection]
  [:seon.test/policy :seon.test/policy]
  [:seon.test/identities {:optional true} [:set :seon.test/sym]]
  [:seon.test/namespaces {:optional true} [:set :symbol]]
  [:seon.test/changed {:optional true} :seon.test/changed]
  [:seon.test/include-long? {:optional true} :boolean]
  [:seon.test/check-time-limit-ms {:optional true} :seon.test/check-time-limit-ms]
  [:seon.test/batch-limit {:optional true} :seon.test/batch-limit]]
 :seon.test/loaded-source [:and {:description "The source commit this JVM loaded (its store's published head), supplied to selection."} :seon.source/commit-id]
 :seon.test/loaded-source-drift
 [:map {:description "The loaded source differs from the program rows the cluster records: recorded evidence cannot vouch for what executes, so nothing was reused."}
  [:seon.test/loaded-source :seon.test/loaded-source]
  [:seon.source/commit-id {:optional true} :seon.source/commit-id]]
 :seon.test/batch-limit [:int {:min 1 :description "Members per admission and per release transaction; defaults to seon.test/batch-limit."}]
 :seon.test/executed-count [:int {:min 0}]
 :seon.test/reused-count [:int {:min 0}]
 :seon.test/passed? [:boolean {:description "True only when every obligation of the request has green evidence; exclusions, pending and unfinished members are unfulfilled."}]
 :seon.test/pending [:vector {:description "Admitted members never started: the request bound fired, a platform member was red, or a body did not exit."} :seon.test/sym]
 :seon.test/unfinished
 [:vector {:description "Members whose body thread was still live at the bound; each keeps its branch until it exits."}
  [:map [:seon.test/sym :seon.test/sym]
   [:seon.agent/branch :seon.agent/branch]
   [:seon.test/failure-message :seon.test/failure-message]]]
 :seon.test/recording-refusal :seon.error/value
 :seon.test/timings
 [:vector {:description "Measured per-member phases on the member's own branch: acquisition, Var resolution, body, and unlink."}
  [:map [:seon.test/sym :seon.test/sym]
   [:seon.agent/branch :seon.agent/branch]
   [:seon.test.timing/acquire-ms :seon.test.timing/acquire-ms]
