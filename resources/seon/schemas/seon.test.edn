#:seon.test{:ns :seon.db/ref,
            :reach [:set {:seon.db/index true} :seon.program/edge-symbol],
            :reaches [:map-of :seon.test/sym :seon.test/reach],
            :reach-unknown [:string {:min 1 :description "Typed unknown for a result whose tested closure could not be retained. Replaced on every run; absence of both membership and this marker is legacy unknown, never proof of an empty closure."}],
            :reach-digest [:and {:seon.db/identity false} :seon.source/digest],
            :reach-digests [:map-of :seon.test/sym :seon.test/reach-digest],
            :skipped-count [:int {:min 0}],
            :skip-reason :string,
            :source :string,
            :subject [:and {:seon.db/index true} :seon.program/edge-symbol],
            :usage :boolean,
            :fixture-observation
            [:string {:min 1
                      :description "Nonblank explanation of the observation an ordinary database branch cannot prove; checked at selection and expensive fixture acquisition."}],
            :long
            [:string {:min 1
                      :description "The declared reason this test is long: a real boot, a multi-minute fixture, or another cost an ordinary branch pays once. Indexed from the test Var's :seon.test/long metadata, so an in-process check can exclude it by query instead of by loading the Var."}],
            :platform
            [:string {:min 1
                      :description "The declared reason this test is a platform regression: a moving part whose breakage poisons the bulk tier. Indexed from the test Var's or its namespace's :seon.test/platform metadata, so the tier partition reads the fact the coordinator already holds instead of re-reading Var metadata."}],
            :fixture
            [:string {:min 1
                      :description "The declared reason this namespace's tests are fixture material another test asserts over, never gate members: a deliberate failure, an assertionless example, a usage sample. Declared once on the ns form and lifted onto every test row, so bare selection excludes it by fact instead of by a filename that does not end in _test."}],
            :long-ms
            [:int {:min 1
                   :description "Per-test completion bound in milliseconds. Only a positive allowance accompanied by a nonblank :seon.test/long reason may exceed the default; exceeding the bound is a test failure."}],
            :time-limit-ms
            [:int {:min 1 :default 5000
                   :description "Default per-test body bound in milliseconds. The runner reads this declaration once per run and carries it with reporter options. Only :seon.test/long with a reason and :seon.test/long-ms can raise it; overruns are recorded assertion failures."}],
            :pass-count [:int {:min 0}],
            :fail-count [:int {:min 0}],
            :error-count [:int {:min 0}],
            :run-basis-t :seon.db/basis-t,
            :run-at :inst,
            :unchanged [:= true],
            :recorded-basis-t [:and {:description "Transaction basis at which the reused result facts were recorded; distinct from the program basis they tested."} :seon.db/basis-t],
            :run :seon.db/ref,
            :failure-identity
            [:string {:min 64, :max 64}],
            :failing-assertions
            [:vector
             :seon.test/failure-identity],
            :failure-message :string,
            :failures [:vector {:seon.db/component true :seon.db/component-schema :seon.test.failure/failure} :seon.db/ref],
            :var
            [:fn
             {:error/message "must be a host or SCI Var"
              :gen/gen seon.test.runner/var-generator}
             seon.test.runner/var-reference?],
            :not-runnable :string,
            :not-runnable-error
            [:and :seon.error/base [:map [:seon.test/not-runnable :seon.test/not-runnable]]],
            :sym
            [:qualified-symbol
             { :seon.db/identity true,
              :seon.program/row-schema :seon.test/test,
              :seon.program/source-attribute :seon.test/source}],
            :result
            [:map
             {:seon.render/ai seon.render.test/render-ai
              :seon.render/html seon.render.test/render-html}
             [:seon.test/failures {:optional true} [:vector :seon.test.failure/value]]
             [:seon.test/sym :seon.test/sym]
             [:seon.test/pass-count :seon.test/pass-count]
             [:seon.test/fail-count :seon.test/fail-count]
             [:seon.test/error-count :seon.test/error-count]
             [:seon.test/reach-digest {:optional true} :seon.test/reach-digest]
             [:seon.test/reach {:optional true} :seon.test/reach]
             [:seon.test/reach-unknown {:optional true} :seon.test/reach-unknown]
             [:seon.test/run-basis-t :seon.test/run-basis-t]
             [:seon.test/run-at :seon.test/run-at]
             [:seon.test/unchanged {:optional true} :seon.test/unchanged]
             [:seon.test/recorded-basis-t {:optional true} :seon.test/recorded-basis-t]
             [:seon.test/run {:optional true} :seon.test/run]
             [:seon.test/failing-assertions
              {:optional true}
              :seon.test/failing-assertions]
             [:seon.test/failure-message
              {:optional true}
              :seon.test/failure-message]],
            :results [:vector :seon.test/result],
            :test
            [:map
             {:seon.db/attributes true
              :seon.render/ai seon.render.test/render-ai
              :seon.render/html seon.render.test/render-html :seon.program/partition :seon.program}
             [:seon.test/sym :seon.test/sym]
             [:seon.program/definition-digest :seon.program/definition-digest]
             [:seon.program/analyzed-source-digest :seon.program/analyzed-source-digest]
             [:seon.schema.admission/source
              :seon.schema.admission/source]
             [:seon.test/ns :seon.test/ns]
             [:seon.test/failures
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/failures]
             [:seon.test/source :seon.test/source]
             [:seon.fn/file {:optional true} :seon.fn/file]
             [:seon.fn/form-span {:optional true} :seon.fn/form-span]
             [:seon.test/reach-digest
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/reach-digest]
             [:seon.test/reach
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/reach]
             [:seon.test/reach-unknown
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/reach-unknown]
             [:seon.fn/calls {:optional true} :seon.fn/calls]
             [:seon.fn/references {:optional true} :seon.fn/references]
             [:seon.fn/call-arities {:optional true} :seon.fn/call-arities]
             [:seon.fn/writes {:optional true} :seon.fn/writes]
             [:seon.fn/keywords {:optional true} :seon.fn/keywords]
             [:seon.test/usage {:optional true} :seon.test/usage]
             [:seon.test/fixture-observation {:optional true}
              :seon.test/fixture-observation]
             [:seon.test/long {:optional true} :seon.test/long]
             [:seon.test/long-ms {:optional true} :seon.test/long-ms]
             [:seon.test/platform {:optional true} :seon.test/platform]
             [:seon.test/fixture {:optional true} :seon.test/fixture]
             [:seon.test/subject {:optional true} :seon.test/subject]
             [:seon.test/pass-count
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/pass-count]
             [:seon.test/fail-count
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/fail-count]
             [:seon.test/error-count
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/error-count]
             [:seon.test/run-basis-t
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/run-basis-t]
             [:seon.test/run-at
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/run-at]
             [:seon.test/run
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/run]
             [:seon.test/failing-assertions
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/failing-assertions]
             [:seon.test/failure-message
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/failure-message]]
