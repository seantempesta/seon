#:seon.test{:ns :seon.db/ref,
            :reach [:set {:seon.db/index true} :qualified-symbol],
            :reaches [:map-of :seon.test/sym :seon.test/reach],
            :reach-unknown [:string {:min 1 :description "Typed unknown for a result whose tested closure could not be retained. Replaced on every run; absence of both membership and this marker is legacy unknown, never proof of an empty closure."}],
            :reach-digest [:and {:seon.db/identity false} :seon.source/digest],
            :reach-digests [:map-of :seon.test/sym :seon.test/reach-digest],
            :skipped-count [:int {:min 0}],
            :skip-reason :string,
            :source :string,
            :subject [:qualified-symbol {:seon.db/index true}],
            :usage :boolean,
            :fixture-observation
            [:string {:min 1
                      :description "Nonblank explanation of the observation an ordinary database branch cannot prove; checked at selection and expensive fixture acquisition."}],
            :long
            [:string {:min 1
                      :description "The declared reason this test is long: a real boot, a multi-minute fixture, or another cost an ordinary branch pays once. Indexed from the test Var's :seon.test/long metadata, so an in-process check can exclude it by query instead of by loading the Var."}],
            :platform
            [:string {:min 1
                      :description "The declared reason this test is a platform regression: a moving part whose breakage poisons the bulk tier. Indexed from the test Var's or its namespace's :seon.test/platform metadata, so the tier partition reads the fact the coordinator already holds instead of re-reading Var metadata."}],
            :fixture
            [:string {:min 1
                      :description "The declared reason this namespace's tests are fixture material another test asserts over, never gate members: a deliberate failure, an assertionless example, a usage sample. Declared once on the ns form and lifted onto every test row, so bare selection excludes it by fact instead of by a filename that does not end in _test."}],
            :long-ms
            [:int {:min 1
                   :description "The declared completion allowance in milliseconds for a :seon.test/long test. The cold runner widens that test's per-worker-exchange bound to it, so the bound derives from the declaration instead of standing in for it. Absent means the ordinary per-exchange bound applies."}],
            :pass-count [:int {:min 0}],
            :fail-count [:int {:min 0}],
            :error-count [:int {:min 0}],
            :run-basis-t :seon.db/basis-t,
            :run-at :inst,
            :unchanged [:= true],
            :recorded-basis-t [:and {:description "Transaction basis at which the reused result facts were recorded; distinct from the program basis they tested."} :seon.db/basis-t],
            :run :seon.db/ref,
            :failure-identity
            [:string {:min 64, :max 64}],
            :failing-assertions
            [:vector {:seon.db/cardinality :many}
             :seon.test/failure-identity],
            :failure-message :string,
            :failures [:vector {:seon.db/component true} :seon.db/ref],
            :var
            [:fn
             {:error/message "must be a host or SCI Var"
              :gen/gen seon.test.runner/var-generator}
             seon.test.runner/var-reference?],
            :not-runnable :string,
            :not-runnable-error
            [:map
             {:seon.error/class true
              :seon.render/ai seon.error/render-ai
              :seon.render/html seon.error/render-html
              :error/message "must identify the Var with no test function"}
             [:seon.test/not-runnable :seon.test/not-runnable]
             [:seon.error/message :seon.error/message]],
            :sym
            [:qualified-symbol
             { :seon.db/identity true, :seon.search/index :symbol,
              :seon.program/row-schema :seon.test/test,
              :seon.program/source-attribute :seon.test/source}],
            :result
            [:map
             {:seon.render/ai seon.render.test/render-ai
              :seon.render/html seon.render.test/render-html}
             [:seon.test/failures {:optional true} [:vector :seon.test.failure/value]]
             [:seon.test/sym :seon.test/sym]
             [:seon.test/pass-count :seon.test/pass-count]
             [:seon.test/fail-count :seon.test/fail-count]
             [:seon.test/error-count :seon.test/error-count]
             [:seon.test/reach-digest {:optional true} :seon.test/reach-digest]
             [:seon.test/reach {:optional true} :seon.test/reach]
             [:seon.test/reach-unknown {:optional true} :seon.test/reach-unknown]
             [:seon.test/run-basis-t :seon.test/run-basis-t]
             [:seon.test/run-at :seon.test/run-at]
             [:seon.test/unchanged {:optional true} :seon.test/unchanged]
             [:seon.test/recorded-basis-t {:optional true} :seon.test/recorded-basis-t]
             [:seon.test/run {:optional true} :seon.test/run]
             [:seon.test/failing-assertions
              {:optional true}
              :seon.test/failing-assertions]
             [:seon.test/failure-message
              {:optional true}
              :seon.test/failure-message]],
            :results [:vector :seon.test/result],
            :test
            [:map
             {:seon.db/attributes true
              :seon.render/ai seon.render.test/render-ai
              :seon.render/html seon.render.test/render-html}
             [:seon.test/sym :seon.test/sym]
           [:seon.program/analyzed-source-digest :seon.program/analyzed-source-digest]
             [:seon.schema.admission/source
              :seon.schema.admission/source]
             [:seon.test/ns :seon.test/ns]
             [:seon.test/failures
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/failures]
             [:seon.test/source :seon.test/source]
             [:seon.fn/file {:optional true} :seon.fn/file]
             [:seon.fn/form-span {:optional true} :seon.fn/form-span]
             [:seon.test/reach-digest
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/reach-digest]
             [:seon.test/reach
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/reach]
             [:seon.test/reach-unknown
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/reach-unknown]
             [:seon.fn/calls {:optional true} :seon.fn/calls]
             [:seon.fn/references {:optional true} :seon.fn/references]
             [:seon.fn/call-arities {:optional true} :seon.fn/call-arities]
             [:seon.fn/writes {:optional true} :seon.fn/writes]
             [:seon.fn/keywords {:optional true} :seon.fn/keywords]
             [:seon.test/usage {:optional true} :seon.test/usage]
             [:seon.test/fixture-observation {:optional true}
              :seon.test/fixture-observation]
             [:seon.test/long {:optional true} :seon.test/long]
             [:seon.test/long-ms {:optional true} :seon.test/long-ms]
             [:seon.test/platform {:optional true} :seon.test/platform]
             [:seon.test/fixture {:optional true} :seon.test/fixture]
             [:seon.test/subject {:optional true} :seon.test/subject]
             [:seon.test/pass-count
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/pass-count]
             [:seon.test/fail-count
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/fail-count]
             [:seon.test/error-count
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/error-count]
             [:seon.test/run-basis-t
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/run-basis-t]
             [:seon.test/run-at
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/run-at]
             [:seon.test/run
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/run]
             [:seon.test/failing-assertions
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/failing-assertions]
             [:seon.test/failure-message
              {:optional true :seon.program/written-by seon.test.runner/record-tx}
              :seon.test/failure-message]]
 :seon.test/identity :qualified-symbol
 :seon.test/acquisition-refusals [:vector :seon.error/value]
 :seon.test/acquisition
 [:map
  [:seon.db/db {:optional true} :seon.db/database-value]
  [:seon.test/acquisition-refusals :seon.test/acquisition-refusals]
  [:seon.test/class-loader {:optional true} :seon.test/class-loader]]
 :seon.test/class-loader
 [:fn {:error/message "must be a JVM ClassLoader"
       :gen/gen seon.test.runner/class-loader-generator} seon.test.runner/class-loader?]
 :seon.test/classpath-roots [:vector :string]
 :seon.test/classpath-root :string
 :seon.test/jvm-options [:vector :string]
 :seon.test/classpath
 [:map [:seon.test/classpath-roots :seon.test/classpath-roots]
  [:seon.test/classpath-root :seon.test/classpath-root]
  [:seon.test/jvm-options {:optional true} :seon.test/jvm-options]]
 :seon.test/resolution-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.db/connection :seon.db/connection]
  [:seon.test/identity :seon.test/identity]
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:seon.schema/projection :seon.schema/projection]
  [:seon.test/class-loader :seon.test/class-loader]]
:seon.test/changed
 [:vector [:or :qualified-symbol :seon.program/identity]]
 :seon.test/paths [:vector [:string {:min 1}]]
 :seon.test/namespaces [:vector :seon.ns/name]
 :seon.test/check-time-limit-ms
 [:int {:min 1 :seon.config/dial true :seon.config/optional true
        :seon.config/default 120000
        :description "Total in-process selection, canonical fixture preparation, and test execution allowance."}]
 :seon.test/reaching-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.test/changed :seon.test/changed]]
 :seon.test/check-request
 [:map [:seon.db/connection :seon.db/connection]
  [:my.program/context {:optional true} :my.program/context]
  [:seon.test/class-loader {:optional true} :seon.test/class-loader]
  [:seon.test/changed {:optional true} :seon.test/changed]
  [:seon.test/paths {:optional true} :seon.test/paths]
  [:seon.test/namespaces {:optional true} :seon.test/namespaces]
  [:seon.boot/cluster-name {:optional true} :seon.boot/cluster-name]
  [:seon.test/declared-root {:optional true} :seon.test/declared-root]
  [:seon.test/defer-widened? {:optional true} :boolean]
  [:seon.test/include-long? {:optional true} :boolean]]
 :seon.test/run-options
 [:map [:seon.test.run/provenance :seon.test.run/provenance]
  [:seon.sci.eval/ctx {:optional true} :seon.sci.eval/ctx]
  [:seon.db/db {:optional true} :seon.db/database-value]
  [:seon.db/connection {:optional true}
   [:and {:description "The custody the test BODY runs under: present means the run is that cluster's own work and the body's elided seon.db arities reach it; absent means none. It is not the connection the result facts are committed through, which is the call's own argument."}
    :seon.db/connection]]
  [:seon.test/declared-root {:optional true} :seon.test/declared-root]
  [:seon.test/remaining-ms [:int {:min 1}]]]
 :seon.test/run-owned-request
 [:map {:description "One of the calling agent's own declared tests, with the connection call preparation supplies from its environment."}
  [:seon.test/run-basis-t {:optional true} :seon.test/run-basis-t]
  [:seon.db/connection :seon.db/connection]
  [:my.program/context :my.program/context]
  [:seon.test/class-loader {:optional true} :seon.test/class-loader]
  [:seon.test/var :seon.test/var]]
 :seon.test/reuse-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.test/identity :seon.test/identity]
  [:seon.test/run-basis-t {:optional true} :seon.test/run-basis-t]]
 :seon.test/reuse-result
 [:or :seon.test/result [:= :seon.test/execution-required] :seon.error/value]
 :seon.test/declared-root
 [:string {:min 1
           :description "The operator root the caller genuinely holds; absent means this JVM's own declaration is read."}]
 :seon.test/destructive-path
 [:vector {:min 1 :description "The declared call path from a test down to the destructive owner it reaches."}
  :qualified-symbol]
 :seon.test/destructive-excluded
 [:vector [:map [:seon.test/sym :seon.test/sym]
           [:seon.fn/sym :seon.fn/sym]
           [:seon.fn/destroys {:optional true} :seon.fn/destroys]
           [:seon.test/destructive-path :seon.test/destructive-path]
           [:seon.test/command :seon.test/command]]]
 :seon.test/host
 [:enum {:description "Where a test runs, derived from its program-graph reach, never declared on the test: :seon.test.host/in-process is the cluster's own JVM; :seon.test.host/isolated-snapshot is a JVM under its own operator root, because the test reaches a function declaring :seon.fn/destroys. An unanswerable reach is the typed unknown, never this value."}
  :seon.test.host/in-process :seon.test.host/isolated-snapshot]
 :seon.test/host-report
 [:map {:description "Where one test runs and why, as data an agent can read: the host, and for an isolated one the owner it reaches, what that owner destroys, the declared call path between them, and the cold invocation that may run it."}
  [:seon.test/sym :seon.test/sym]
  [:seon.test/host :seon.test/host]
  [:seon.fn/sym {:optional true} :seon.fn/sym]
  [:seon.fn/destroys {:optional true} :seon.fn/destroys]
  [:seon.test/destructive-path {:optional true} :seon.test/destructive-path]
  [:seon.test/command {:optional true} :seon.test/command]]
 :seon.test/unknown :string
 :seon.test/unknown-error
 [:map {:seon.error/class true :seon.render/ai seon.error/render-ai
        :seon.render/html seon.error/render-html
        :error/message "must name the unavailable test check input"}
  [:seon.test/unknown :seon.test/unknown]
  [:seon.error/message :seon.error/message]]
 :seon.test/next-tier
 [:or [:= :none] [:vector [:vector [:string {:min 1}]]]]
 :seon.test/command [:vector [:string {:min 1}]]
 :seon.test/deferred
 [:vector [:map [:seon.test/sym :seon.test/sym]
           [:seon.test/fixture-observation :seon.test/fixture-observation]
           [:seon.test/command :seon.test/command]]]
 :seon.test/long-excluded
 [:vector [:map [:seon.test/sym :seon.test/sym]
           [:seon.test/long :seon.test/long]
           [:seon.test/command :seon.test/command]]]
 :seon.test/expired
 [:and {:description "The declared check bound fired with runs already recorded. It names what never returned; the verdicts it accompanies are the tests that did complete."}
  :seon.test/unknown-error]
 :seon.test/check-result
 [:map
  [:seon.test/skipped-count {:optional true} :seon.test/skipped-count]
  [:seon.test/skip-reason {:optional true} :seon.test/skip-reason]
  [:seon.test/tests [:vector :seon.test/sym]]
  [:seon.test/passed [:vector :seon.test/sym]]
  [:seon.test/failed
   [:vector [:map [:seon.test/sym :seon.test/sym]
             [:seon.test/failures {:optional true} [:vector :seon.test.failure/value]]
             [:seon.test/failure-message :string]
             [:seon.test/changed :seon.test/changed]]]]
  [:seon.test/results :seon.test/results]
  [:seon.test.run/basis-t :seon.test.run/basis-t]
  [:seon.test.run/program-digest {:optional true} :seon.test.run/program-digest]
  [:seon.test/elapsed-ms :double]
  [:seon.test/next-tier :seon.test/next-tier]
  [:seon.test/widened {:optional true} :string]
  [:seon.test/pending {:optional true} [:vector :seon.test/sym]]
  [:seon.test/deferred {:optional true} :seon.test/deferred]
  [:seon.test/destructive-excluded {:optional true} :seon.test/destructive-excluded]
  [:seon.test/long-excluded {:optional true} :seon.test/long-excluded]
  [:seon.test/expired {:optional true} :seon.test/expired]]
 :seon.test/adoption-identities [:set :seon.db/ref]
 :seon.test/adoption-inputs [:set :string]
 :seon.test/adoption-cluster :seon.db/ref
 :seon.test/adoption
 [:map {:seon.db/attributes true}
  [:seon.test/adoption-cluster :seon.test/adoption-cluster]
  [:seon.test/adoption-identities {:optional true} :seon.test/adoption-identities]
  [:seon.test/adoption-inputs {:optional true} :seon.test/adoption-inputs]]}
