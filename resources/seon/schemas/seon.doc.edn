;; The wiki as data (seon.doc, task seon.doc/docs-are-data-in-the-store): a section entity
;; per heading of docs/*.md, as one parse (seon.ref/parse) reads it. Its references are what
;; its own text cites (sections by link, vars by name), so a section's backlinks are who cites
;; it. Stored shapes; the Datahike attributes are derived from :seon.doc/fact.
{:seon.doc/address [:and {:seon.db/identity true :seon.db/content-id true :description "The section's address, path#anchor as the parse writes it, such as docs/references.md#one-parse. See docs/references.md#the-wiki-in-the-store."} :string]
 :seon.doc/heading [:string {:description "The heading as its line writes it, in Markdown (a code span keeps its backticks)."}]
 :seon.doc/level [:int {:min 1 :max 6 :description "The heading's level, where a single # is 1."}]
 :seon.doc/position [:int {:description "The section's place among its parent's sections as the page holds them, 0 first."}]
 :seon.doc/lead [:string {:description "The heading's next block when it is a paragraph, which is what summary depth shows."}]
 :seon.doc/text [:string {:description "The section's own text: the lines after its heading, up to the next heading of any level."}]
 :seon.doc/parent [:and {:seon.db/to [:seon.doc/fact] :description "The enclosing section."} :seon.db/ref]
 :seon.doc/references [:set {:description "What the section's own text cites and resolves to: a section by a link, or a var by a name. A link to no section refuses the load (the error :seon.db/no-target). See docs/references.md#the-wiki-in-the-store."} :seon.db/ref]
 ;; indexed (AVET): the sections that cite a name are sought by it, when a var or task of that name appears or
 ;; vanishes (seon.problems/caused-split, docs/cost.md#a-diff-per-attribute-costs-a-descent-each)
 :seon.doc/names [:set {:seon.db/index true :description "The names the section's own text cites as references, kept as names, so a var deleted later leaves its name here. A text word is kept only when it named something at load."} :qualified-symbol]
 :seon.doc/read [:map-of {:description "The form id of each var the section cites, as it stood when the section's text was last written. A var whose form id now differs leaves the section stale. From git's baseline a var may instead be :absent (no form defined it at the section's commit) or :changed (its form's docstring or contract changed since), each stale. See docs/health.md#a-stale-section."} :qualified-symbol [:or :string [:enum :absent :changed]]]
 :seon.doc/baseline-unread [:string {:description "Why the baseline of the section's :seon.doc/read could not be taken from git. The section's :seon.doc/read is then as of the load, and shows as attention until the section is edited. See docs/health.md#a-stale-section."}]
 :seon.doc/reviewed [:map {:description "The last review that read the section as it is though its code changed, written by (my.doc/reviewed! address who): who reviewed it, and the form ids it read at. Older reviews stay in the history. See docs/health.md#a-stale-section."} [:by :string] [:forms [:map-of :qualified-symbol :string]]]
 :seon.doc/fact [:map {:seon.db/attributes true :description "A section of the wiki as the store holds it, one entity per heading of each page. See docs/references.md#the-wiki-in-the-store."}
                     [:seon.doc/address :seon.doc/address]
                     [:seon.doc/heading :seon.doc/heading]
                     [:seon.doc/level {:optional true} :seon.doc/level]
                     [:seon.doc/position {:optional true} :seon.doc/position]
                     [:seon.doc/lead {:optional true} :seon.doc/lead]
                     [:seon.doc/text {:optional true} :seon.doc/text]
                     [:seon.doc/parent {:optional true} :seon.doc/parent]
                     [:seon.doc/references {:optional true} :seon.doc/references]
                     [:seon.doc/names {:optional true} :seon.doc/names]
                     [:seon.doc/read {:optional true} :seon.doc/read]
                     [:seon.doc/baseline-unread {:optional true} :seon.doc/baseline-unread]
                     [:seon.doc/reviewed {:optional true} :seon.doc/reviewed]]
 :seon.doc/parsed [:map {:closed true :description "A section as one parse reads it, before it is stored: its fact's values, its parent's address, and the citations of its own text. See docs/references.md#one-parse."}
                       [:seon.doc/address :seon.doc/address]
                       [:seon.doc/heading :seon.doc/heading]
                       [:seon.doc/level :seon.doc/level]
                       [:seon.doc/position :seon.doc/position]
                       [:seon.doc/lead {:optional true} :seon.doc/lead]
                       [:seon.doc/text {:optional true} :seon.doc/text]
                       [:seon.ref/parent {:optional true} :seon.ref/address]
                       [:seon.ref/citations [:vector :seon.ref/citation]]]}
