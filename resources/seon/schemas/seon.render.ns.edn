{:seon.render.ns/agent-namespace-view
 [:map {:description "An agent's own namespace as its AI face shows it: name, doc line, requires, and how many definitions it holds."}
  [:seon.ns/name [:maybe :seon.ns/name]]
  [:seon.ns/doc {:optional true} :seon.ns/doc]
  [:seon.ns/requires [:vector :symbol]]
  [:seon.render.ns/definition-count [:int {:min 0}]]]
 :seon.render.ns/namespace-view
 [:map {:description "A namespace node as its AI face shows it: named, and beyond distance zero its requires and its public functions as name, arglists and doc summary rows."}
  [:seon.ns/name :seon.ns/name]
  [:seon.ns/doc {:optional true} :seon.ns/doc]
  [:seon.ns/requires {:optional true} [:vector :symbol]]
  [:seon.repl/columns {:optional true} [:vector :keyword]]
  [:seon.repl/rows {:optional true} [:vector [:vector :seon.schema/value]]]]
 :seon.render.ns/function-view
 [:map {:description "A function node as its AI face shows it: named, and beyond distance zero its source and contract, a library Var's arglists, and the forms that read its callers and the tests reaching it. What it calls and what calls it are its related data."}
  [:seon.fn/sym :seon.fn/sym]
  [:seon.fn/doc {:optional true} :seon.fn/doc]
  [:seon.render.ns/source-lines {:optional true} [:vector :string]]
  [:seon.fn/spec {:optional true} :seon.fn/spec]
  [:arglists {:optional true} :seon.ref/arglists]
  [:seon.render/operations {:optional true} :seon.render/operations]]}
