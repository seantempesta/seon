#:seon.render.profile{:id :qualified-keyword,
                      :token-budget [:int {:min 1}],
                      :token-ceiling [:int {:min 1 :description "The hard ceiling in tokens no display-budget override passes: the model's prompt window."}],
                      :max-depth [:int {:min 0}],
                      :max-children [:int {:min 0}],
                      :max-string-length [:int {:min 0}],
                      :whole-width [:int {:min 1 :description "Characters: a value at most this wide is never cut."}],
                      :max-name [:int {:min 1 :description "Characters: a keyword or symbol at most this long shows whole."}],
                      :max-number-digits [:int {:min 1 :description "Digits: a larger big number prints as its digit count."}],
                      :sort-bound [:int {:min 0 :description "Keys: a keyword-keyed map or set of at most this many shows identity and short members first."}],
                      :composition
                      [:enum :single-line :multiline],
                      :profile
                      [:map
                       [:seon.render.profile/id
                        :seon.render.profile/id]
                       [:seon.render.profile/token-budget
                        :seon.render.profile/token-budget]
                       [:seon.render.profile/token-ceiling {:optional true}
                        :seon.render.profile/token-ceiling]
                       [:seon.render.profile/max-depth
                        :seon.render.profile/max-depth]
                       [:seon.render.profile/max-children
                        :seon.render.profile/max-children]
                       [:seon.render.profile/max-string-length {:optional true}
                        :seon.render.profile/max-string-length]
                       [:seon.render.profile/composition
                        :seon.render.profile/composition]
                       [:seon.render.profile/whole-width {:optional true} :seon.render.profile/whole-width]
                       [:seon.render.profile/max-name {:optional true} :seon.render.profile/max-name]
                       [:seon.render.profile/max-number-digits {:optional true} :seon.render.profile/max-number-digits]
                       [:seon.render.profile/sort-bound {:optional true} :seon.render.profile/sort-bound]]}
