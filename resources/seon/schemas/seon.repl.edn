#:seon.repl{:cost
            [:map-of {:description "One evaluation's measures as seon.repl/findings judges them against :seon.config.eval/bounds: each recorded measure the evaluation carries (counts, sizes, the set of unadmitted definitions), plus :seon.repl/out-tokens. Absent means not measured."}
             :qualified-keyword :seon.schema/value]
            :finding [:keyword {:description "What one exceeded declared bound (:seon.config.eval/bounds) names, e.g. :large-value."}]
            :fix [:string {:min 1 :description "The declared fix for one finding."}]
            :with [:vector {:description "The other recorded measures a bound's finding reports beside its own."} :qualified-keyword]
            :finding-value
            [:map {:description "One finding in the reply map's :seon.repl/findings: its kind, the measure it exceeded with the observed value, the other measures it reports, and its fix."}
             [:seon.repl/finding :seon.repl/finding]
             [:seon.repl/fix {:optional true} :seon.repl/fix]]
            :findings [:vector {:description "The declared bounds this evaluation exceeded (:seon.config.eval/bounds), each with the measure, its observed value and the fix; read it to correct how you evaluate. Absent when every bound held."} :seon.repl/finding-value]
            :request [:and {:description "What the whole request cost, measured from the MCP entrance: wall time, armed calls, reads, transactions, allocation and CPU by thread, and the stage times. Read it to judge whether a form cost what it should; a request 10x over its work is wrong work."} :seon.cost/request]
            :cost-result [:qualified-symbol {:description "The result handle the request's whole cost is bound under in the agent's context; (get result/<handle> :seon.cost/stages) reads any member."}]
            :request-reply
            [:map {:seon.render/ai seon.mcp/render-request-reply-ai
                   :seon.render/html seon.mcp/render-request-reply-html
                   :description "The reply that carries a request's cost, as seon.mcp/eval-clj prints it."}
             [:seon.repl/request :seon.repl/request]
             [:seon.repl/cost-result {:optional true} :seon.repl/cost-result]]
            :request-reply-ai
            [:map {:description "The AI face of the request reply: the cost's headline and the handle holding the whole cost."}
             [:seon.repl/request :seon.cost/headline]
             [:seon.repl/cost-result {:optional true} :seon.repl/cost-result]]
            :out-tokens
            [:int {:min 0 :description "Estimated tokens (seon.ai.tokens/estimate) of an evaluation's printed output, derived from the saved output when its reply is rendered."}]
            :directory
            [:map {:seon.render/ai seon.repl/render-directory-ai
                   :seon.render/html seon.repl/render-directory-html
                   :description "The existing dir API's function and schema data."}
             [:functions [:vector [:map [:sym :qualified-symbol]
                                    [:arglists :seon.schema/value]
                                    [:doc {:optional true} :string]
                                    [:in {:optional true} :seon.schema/value]
                                    [:out {:optional true} :seon.schema/value]
                                    [:seon.sci.eval/missing-declaration {:optional true} :qualified-keyword]
                                    [:supplied {:optional true} [:vector :qualified-keyword]]]]]
             [:schemas [:map-of :qualified-keyword :seon.schema/value]]]
            :columns [:vector :keyword]
            :rows [:vector [:vector :seon.schema/value]]
            :schemas [:map-of :qualified-keyword :seon.schema/value]
            :changes :seon.db.diff/paths
            :errors
            [:string
             {:min 1,
              :description
              "The value renderer's text for the new open errors recorded on the evaluation's branch between the previous evaluation's settlement and this one's, one entry per signature with its count. Present only when there are any."}]
            :shown-value :seon.schema/value
            :comment [:string {:min 1}],
            :diagnostics
            [:string
             {:min 1,
              :description
              "The flat errors a later stage (printing, a renderer, settlement) attached beside the evaluation's unchanged value, as the value printer shows them; the value still stands. Present only beside :seon.repl/value."}]
            :subject :seon.render.walk/lookup,
            :interrupted
            [:string
             {:min 1,
              :description
              "The instant boot cut one evaluation, as the readable #inst the one print grammar renders every other instant as. Present exactly when the evaluation carries :seon.cluster.eval/interrupted-at, so an evaluation that was interrupted never reads in the agent's own history like one that is still running."}],
            :entry
            [:map
             [:seon.repl/comment {:optional true} :seon.repl/comment]
             [:seon.repl/form :seon.repl/form]
             [:seon.repl/key {:optional true} :seon.schema/value]
             [:seon.repl/subject
              {:optional true}
              :seon.render.walk/lookup]],
            :note
            [:string
             {:description
              "The one-sentence note every top-level def earns (owner, 2026-09-08): the var lives only in the agent's SCI context and is never persisted; functions, schemas, tests, and transacted data are what persist."}],
            :error
            [:string
             {:description
              "The failed evaluation's error as shown: one flat error map (its :seon.error/type, operation and message) read as data. Exactly one of :seon.repl/value and :seon.repl/error is present."}],
            :settled
            [:map
             [:seon.repl/key :seon.repl/key]
             [:seon.eval/renderer {:optional true} :seon.eval/renderer]
             [:seon.eval/shown {:optional true} :seon.eval/shown]
             [:seon.eval/private {:optional true} :seon.eval/private]
             [:seon.cluster.eval/output {:optional true} :string]
             [:seon.cluster.eval/error {:optional true} :string]
             [:seon.sci.admit/print-node
              {:optional true}
              :seon.schema/value]],
            :value
            [:string
             {:description
              "The evaluation's result as shown: the text its render or the value printer produced when it was evaluated, with runnable elision forms for what it cut. Present unless the evaluation failed, when :seon.repl/error takes its place."}],
            :out
            [:string
             {:description
              "Everything one evaluation printed to its output, exactly as it printed it, separate from its result."}],
            :entity-request
            [:or
             :seon.render/unit
             :seon.eval/entity
             [:map [:seon.render/value :seon.eval/entity]]],
            :pull-result
            [:map
             [:seon.repl/root-key :seon.repl/key]
             [:seon.repl/candidates [:vector :seon.repl/candidate]]
             [:seon.repl/settled [:vector :seon.repl/settled]]
             [:seon.print/identity-attributes
              :seon.print/identity-attributes]],
            :episode [:vector :seon.repl/entry],
            :result
            [:string
             {:min 1,
              :description
              "The bound handle for this evaluation's value as text, result/e<entity-id>, so a later turn in the same agent's session can reach the value it already produced. Present exactly when :seon.repl/handle is."}],
            :candidate
            [:map
             [:seon.repl/key :seon.repl/key]
             [:seon.repl/subject :seon.repl/subject]
             [:seon.repl/entry :seon.repl/entry]],
            :entries [:vector {:min 1} :seon.repl/entry],
            :changed-since?
            [:boolean {:description "Derived emission metadata: this system turn follows an earlier turn. Never stored on an evaluation."}]
            :emission
            [:map
             {:description
              "One evaluation as seon.repl/text renders it: the agent's comment and the fixed source it wrote, the namespace the prompt line names, and whatever terminal facts the evaluation has settled. The stored evaluation entity satisfies this directly; a caller that already bounded the value supplies its printed text as :seon.repl/value instead of the stored :seon.eval/shown. The source is OPTIONAL so that a unit which is not an evaluation at all refuses through seon.repl/render-ai's own guard instead of raising a contract violation that takes the whole page derivation with it (law 2.4)."}
             [:seon.cluster.eval/source
              {:optional true}
              :seon.cluster.eval/source]
             [:seon.cluster.eval/id
              {:optional true}
              :seon.cluster.eval/id]
             [:seon.ns/name {:optional true} :seon.ns/name]
             [:seon.repl/changed-since? {:optional true} :seon.repl/changed-since?]
             [:seon.cluster.eval/comment
              {:optional true}
              :seon.cluster.eval/comment]
             [:seon.cluster.eval/delimiter-repairs {:optional true} :seon.cluster.eval/delimiter-repairs]
             [:seon.cluster.eval/ordinal
              {:optional true}
              :seon.cluster.eval/ordinal]
             [:seon.eval/renderer {:optional true} :seon.eval/renderer]
             [:seon.eval/shown {:optional true} :seon.eval/shown]
             [:seon.cluster.eval/error
              {:optional true}
              :seon.cluster.eval/error]
             [:seon.cluster.eval/interrupted-at
              {:optional true}
              :seon.cluster.eval/interrupted-at]
             [:seon.cluster.eval/diagnostics
              {:optional true}
              :seon.cluster.eval/diagnostics]
             [:seon.cluster.eval/output
              {:optional true}
              :seon.cluster.eval/output]
             [:seon.sci.eval/ending-ns
              {:optional true}
              :seon.sci.eval/ending-ns]
             [:seon.eval/duration-ms
              {:optional true}
              :seon.eval/duration-ms]
             [:seon.repl/value {:optional true} :seon.repl/value]
             [:seon.eval/print-length {:optional true} :seon.eval/print-length]
             [:seon.eval/print-level {:optional true} :seon.eval/print-level]
             [:seon.print/options {:optional true} :seon.print/options]
             [:seon.repl/handle {:optional true} :seon.repl/handle]
             [:seon.repl/errors {:optional true} :seon.repl/errors]],
            :response
            [:map
             {:description
              "The REPL's one answer to one evaluated form, emitted in exactly this key order by seon.repl/response. The agent is never asked to write one; every key is absent when the evaluation has nothing to say for it."}
             [:seon.repl/findings {:optional true} :seon.repl/findings]
             [:seon.repl/interrupted
              {:optional true}
              :seon.repl/interrupted]
             [:seon.repl/result {:optional true} :seon.repl/result]
             [:seon.repl/out {:optional true} :seon.repl/out]
             [:seon.repl/note {:optional true} :seon.repl/note]
             [:seon.repl/ns {:optional true} :seon.repl/ns]
             [:seon.repl/ms {:optional true} :seon.repl/ms]
             [:seon.repl/alloc-mb {:optional true} :seon.repl/alloc-mb]
             [:seon.repl/repairs {:optional true} :seon.repl/repairs]
             [:seon.repl/errors {:optional true} :seon.repl/errors]
             [:seon.repl/diagnostics {:optional true} :seon.repl/diagnostics]
             [:seon.repl/value {:optional true} :seon.repl/value]
             [:seon.repl/error {:optional true} :seon.repl/error]],
            :candidates [:vector :seon.repl/candidate],
            :ns
            [:string
             {:min 1,
              :description
              "The namespace one evaluation left in effect, present only when the form changed it — the next prompt line already says which namespace it is in."}],
            :form :seon.repl/expression,
            :root-key :seon.repl/key,
            :ms
            [:string
             {:description
              "The wall-clock milliseconds one evaluation took, as seon.eval/duration-ms recorded it."}],
            :alloc-mb
            [:string
             {:description
              "The megabytes (to 0.1) one evaluation allocated, as seon.eval/allocated-bytes recorded it; that attribute names what the measure includes. Absent when the evaluation was not measured."}],
            :repairs
            [:string
             {:description
              "The forgiving scan's repairs owned by one evaluation (seon.cluster.eval/delimiter-repairs), as the value printer shows that data, beside its value."}],
            :expression
            [:or
             :qualified-symbol
             [:fn
              {:error/message "must be a Clojure list form",
               :gen/schema [:enum (help) (dir 'clojure.core)]}
              clojure.core/seq?]],
            :settled-entries [:vector :seon.repl/settled],
            :key :seon.schema/value,
            :handle
            [:qualified-symbol
             {:description
              "The symbol bound directly to the evaluation's actual result in its agent's live SCI context. Stored shown text names the historical handle; restarting loses the object, and a preview without an evaluation identity has no handle."}]}
