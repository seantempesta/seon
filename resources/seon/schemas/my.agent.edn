{:my.agent/id [:and {:description "The agent this identity names."} :seon.agent/id]
 :my.agent/namespace [:and {:description "Its assigned namespace's name."} :seon.ns/name]
 :my.agent/steward [:and {:description "The agent responsible for that namespace."} :seon.agent/id]
 :my.agent/turns-left [:int {:min 0 :seon.wake/context-inert true}]
 :my.agent/identity [:map [:my.agent/id :my.agent/id]
                     [:my.agent/namespace {:optional true} :my.agent/namespace]
                     [:my.agent/steward {:optional true} :my.agent/steward]]
 :my.agent/settings :seon.config/agent-overlay
 :my.agent/branch-request [:map {:description "A lane branch named by its store branch keyword."} [:seon.store/branch :seon.store/branch]]
 :my.agent/created-branch [:map {:description "A branch created off my cluster's head: the commit it forks and that commit's basis."}
                           [:seon.store/branch :seon.store/branch] [:seon.cluster/created? :seon.cluster/created?]
                           [:seon.cluster.registry/from :seon.cluster.registry/from] [:seon.db/basis-t :seon.db/basis-t]]
 :my.agent/retired? :boolean
 :my.agent/retired-branch [:map {:description "A lane branch removed from the store's branches; its data goes when retention collects."}
                           [:seon.store/branch :seon.store/branch] [:my.agent/retired? :my.agent/retired?] [:my.agent/retiring? {:optional true} :boolean]]
 :my.agent/own-branch [:and {:description "The branch my cluster's connection holds; shared, never a lane's."} :seon.store/branch]
 :my.agent/branches [:map [:my.agent/own-branch :my.agent/own-branch] [:my.agent/roster :my.agent/roster]]
 :my.agent/roster [:and {:description "Every branch in the store."} :seon.cluster.registry/branches]
 :my.agent/branch-context [:map {:description "What a branch operation reads: the store's branches and its main connection, my cluster's connection (whose branch is mine) and, to retire a hosted agent, the routing."}
                           [:seon.store/store :seon.store/store] [:seon.db/connection :seon.db/connection]
                           [:seon.agent/routing {:optional true} :seon.agent/routing]]}
