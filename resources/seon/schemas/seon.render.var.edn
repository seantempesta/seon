#:seon.render.var
{:var [:fn {:description "A defined Var (host or SCI): its declared render pair shows what its definition has to say."
            :error/message "must be a Var"
            :gen/gen seon.render.var/var-generator
            :seon.render/ai seon.render.var/render-ai
            :seon.render/html seon.render.var/render-html}
       seon.render.var/var-value?]
 :contract [:enum {:description "A definition's contract when it is not present: :missing, or an authored contract Malli refuses, :malformed (its refusal under :seon.render.var/malli-refusal)."} :missing :malformed]
 :malli-refusal [:map-of {:description "Malli's refusal of an authored contract, as :seon.fn.contract/malli-type to :seon.fn.contract/malli-data. Producer: seon.render.var/malformed-refusal."} :qualified-keyword :seon.schema/value]
 :findings-error [:or {:description "The refusal of seon.fn/contract-findings when the contract's refusal could not be read. Producer: seon.render.var/malformed-refusal."} :seon.error/value :seon.db/invalid-read-error :seon.schema/validation-refusal]
 :example [:any {:description "A contract form to start from, as data: the defn with an example :malli/schema." :gen/elements [(defn f {:malli/schema [:=> [:cat :int] :int]} [x] x)]}]
 :symbol [:qualified-symbol {:description "The symbol the rendered Var names."}]
 :pending [:vector {:description "Reaching tests with no result recorded against a program holding the current definition (the first five)."} :qualified-symbol]
 :newly-red [:vector {:description "Reaching tests that passed before the current definition and fail at it (the first five)."} :qualified-symbol]
 :newly-green [:vector {:description "Reaching tests that failed before the current definition and pass at it (the first five)."} :qualified-symbol]
 :defining [:set {:description "The symbols the form being shown defines: their tests' status is the reply's test step's, so a Var named here shows only its contract."} :qualified-symbol]
 :counts [:map-of {:description "How many names a status list holds, for a list longer than it shows."} [:enum :seon.render.var/pending :seon.render.var/newly-red :seon.render.var/newly-green] [:int {:min 1}]]
 :status [:map {:description "What a definition has to say; empty when nothing changed."}
          [:seon.render.var/contract {:optional true} :seon.render.var/contract]
          [:seon.render.var/example {:optional true} :seon.render.var/example]
          [:seon.render.var/malli-refusal {:optional true} :seon.render.var/malli-refusal]
          [:seon.render.var/findings-error {:optional true} :seon.render.var/findings-error]
          [:seon.render.var/pending {:optional true} :seon.render.var/pending]
          [:seon.render.var/newly-red {:optional true} :seon.render.var/newly-red]
          [:seon.render.var/newly-green {:optional true} :seon.render.var/newly-green]
          [:seon.render.var/counts {:optional true} :seon.render.var/counts]]
 :view [:map {:description "A Var's AI face, data for the value printer: its symbol, its status, and the forms that act on it (never run by the render)."}
        [:seon.render.var/symbol [:maybe :seon.render.var/symbol]]
        [:seon.render.var/contract {:optional true} :seon.render.var/contract]
        [:seon.render.var/example {:optional true} :seon.render.var/example]
        [:seon.render.var/malli-refusal {:optional true} :seon.render.var/malli-refusal]
        [:seon.render.var/findings-error {:optional true} :seon.render.var/findings-error]
        [:seon.render.var/pending {:optional true} :seon.render.var/pending]
        [:seon.render.var/newly-red {:optional true} :seon.render.var/newly-red]
        [:seon.render.var/newly-green {:optional true} :seon.render.var/newly-green]
        [:seon.render.var/counts {:optional true} :seon.render.var/counts]
        [:seon.render/operations {:optional true} :seon.render/operations]]}
