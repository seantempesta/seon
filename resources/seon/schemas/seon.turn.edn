#:seon.turn{:write? [:and {:seon.wake/context-inert true} :boolean],
            :turn
            [:map
             {:seon.db/attributes true,
              :seon.render/ai seon.render.transcript/render-run-ai,
              :seon.render/html seon.render.transcript/render-run-html :seon.program/partition :seon.data}
             [:seon.turn/id :seon.turn/id]
             [:seon.turn/agent :seon.turn/agent]
             [:seon.turn/attempts {:optional true} :seon.turn/attempts]
             [:seon.turn/disposition {:optional true} :seon.turn/disposition]
             [:seon.turn/sent-back-to {:optional true} :seon.turn/sent-back-to]
             [:seon.turn/result {:optional true} :seon.turn/result]
             [:seon.turn/trigger {:optional true} :seon.turn/trigger]
             [:seon.turn/handled {:optional true} :seon.turn/handled]
             [:seon.turn/opened-tx :seon.turn/opened-tx]
             [:seon.turn/starting-ns
              {:optional true}
              :seon.turn/starting-ns]
             [:seon.turn/closed-tx
              {:optional true}
              :seon.turn/closed-tx]
             [:seon.turn/reply {:optional true} :seon.turn/reply]
             [:seon.turn/reply-blob
              {:optional true}
              :seon.turn/reply-blob]
             [:seon.turn/reply-size
              {:optional true}
              :seon.turn/reply-size]
             [:seon.turn.work/situation
              {:optional true}
              :seon.turn.work/situation]],
            :disposition
            [:and {:description "The completed/wait control returned by the last evaluated form, recorded with settlement before presentation. These are the two closed session dispositions, not an entity kind or a stored session-open flag." :seon.wake/context-inert true}
             :my.turn/disposition],
            :sent-back-to
            [:qualified-symbol {:description "The task a :completed disposition sends the work back to (my.task/send-back!'s :my.task/target), recorded with settlement beside the disposition; the task's end is then :sent-back to it." :seon.wake/context-inert true}],
            :result
            [:and {:description "The reply text a :completed disposition carried, recorded with settlement beside the disposition. Absent for :wait." :seon.wake/context-inert true}
             :my.turn/result],
            :rule [:keyword {:description "The violated transition rule in a refusal. Diagnostic data, not turn progress."}],
            :handled [:set {:description "Messages handled by this turn at settlement. Optional peer refs sweep if a message is deleted; they do not decide wake answering."} :seon.db/ref],
            :trigger [:and #:seon.db{:index true :seon.wake/context-inert true} :seon.db/ref],
            :agent
            [:and
             {:description
              "The agent whose run this is; its reverse is that agent's own evaluation history.",
              :seon.render/ai seon.render.transcript/render-history-ai,
              :seon.render/html
              seon.render.transcript/render-history-html :seon.wake/context-inert true}
             :seon.db/ref],
            :record-evaluated-request
            [:map
             [:seon.turn.loop/cluster :seon.turn.loop/cluster]
             [:seon.db/db :seon.db/database-value]
             [:seon.turn/id :seon.turn/id]
             [:seon.turn/agent :seon.turn/agent]
             [:seon.turn/starting-ns :seon.turn/starting-ns]
             [:seon.turn/reply :seon.turn/reply]
             [:seon.turn/opened-tx :seon.turn/opened-tx]
             [:seon.turn/closed-tx :seon.turn/closed-tx]
             [:seon.turn.loop/evaluated-sources
              [:vector
               [:and
                :seon.turn.loop/evaluated-source
                [:map
                 [:seon.sci.eval/evaluation
                  [:map
                   [:seon.cluster.eval/at
                    :seon.cluster.eval/at]]]]]]]],
            :basis-t [:and {:seon.wake/context-inert true} :seon.db/basis-t],
            :starting-ns [:and {:seon.wake/context-inert true} :seon.db/ref],
            :evaluation-facts-request
            [:map
             [:seon.turn/id :seon.turn/id]
             [:seon.cluster.eval/ordinal :seon.cluster.eval/ordinal]
             [:seon.sci.eval/evaluation :seon.turn.loop/evaluation]
             [:seon.turn.loop/settlement-evaluation
              :seon.turn.loop/evaluation]
             [:my.turn/value {:optional true} :my.turn/value]],
            :turns-remaining [:int {:min 0 :seon.wake/context-inert true}],
            :reply [:string #:seon.db{:no-history? true :seon.wake/context-inert true}],
            :missing-results [:int {:min 0 :seon.wake/context-inert true}],
            :attempts
            [:set
             {:seon.db/component true :seon.db/component-schema :seon.ai/attempt,
              :description "The provider attempts owned by this turn." :seon.wake/context-inert true}
             :seon.db/ref],
            :refused [:and {:seon.wake/context-inert true} :seon.turn/rule],
            :system-run-request
            [:map
             [:seon.agent/id :seon.agent/id]
             [:seon.turn/id :seon.turn/id]
             [:seon.turn/opened-tx :seon.turn/opened-tx]
             ;; absent: the writer starts the run where the agent's previous
             ;; run ended, else in its assigned namespace
             [:seon.turn/starting-ns {:optional true} :seon.turn/starting-ns]
             [:seon.turn/sources :seon.cluster.reply/sources]
             [:seon.turn/reply {:optional true} :seon.turn/reply]
             [:seon.turn/reply-blob
              {:optional true}
              :seon.turn/reply-blob]
             [:seon.turn/reply-size
              {:optional true}
              :seon.turn/reply-size]
             [:seon.turn/trigger {:optional true} :seon.turn/trigger]],
            :closed-tx [:and {:seon.wake/context-inert true} :seon.db/ref],
            :opened-tx [:and {:seon.wake/context-inert true} :seon.db/ref],
            :transition [:and {:seon.wake/context-inert true} :keyword],
            :reply-blob [:and {:seon.wake/context-inert true} :seon.blob/digest],
            :id [:string {:min 1, :seon.db/identity true :seon.program/row-schema :seon.turn/turn :seon.wake/context-inert true}],
            :refused-error
            [:merge
             {:seon.db/attributes true,
              :description "A transition refused its actual request under the named rule. Occurrences own this observation; no agent identity is inferred for a request that may name no existing agent."}
             :seon.error/base
             [:map {:seon.db/attributes true}
              [:seon.turn/rule :seon.turn/rule]]],
            :reply-size [:int {:min 0 :seon.wake/context-inert true}],
            :record-evaluated-call-request
            [:map
             [:seon.turn/id :seon.turn/id]
             [:seon.turn/agent :seon.turn/agent]
             [:seon.turn/starting-ns :seon.turn/starting-ns]
             [:seon.turn/opened-tx :seon.turn/opened-tx]
             [:seon.turn/closed-tx :seon.turn/closed-tx]
             [:seon.turn/reply {:optional true} :seon.turn/reply]
             [:seon.turn/reply-blob
              {:optional true}
              :seon.turn/reply-blob]
             [:seon.turn/reply-size :seon.turn/reply-size]
             [:seon.turn/sources :seon.cluster.reply/sources]
             [:seon.turn/evaluations
              [:vector
               [:and
                :seon.cluster.eval/settle-request
                [:map
                 [:seon.cluster.eval/at :seon.cluster.eval/at]
                 [:seon.cluster.eval/source :seon.cluster.eval/source]
                 [:seon.cluster.eval/ns :seon.cluster.eval/ns]]]]]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.turn/invalid-disposition-source :string
 :seon.turn/compaction-agent-id :seon.agent/id
 :seon.turn/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.turn/error-turn-id :seon.turn/error-turn-id]]]

 :seon.turn/error-turn-id
 [:string {:min 1}]

 ; A refused run settlement's association of a deletion the writer named with
 ; the one form whose settled entity proposed it (seon.turn/deletion-proposals).
 ; It is an association, never a cause; ambiguity names its reason instead.
 :seon.turn/unattributed
 [:enum {:description "Why no single form is associated: several entities delete the identity, an entity in the run declares it, no settled entity deletes it, the named refusal schema is not in the projection, or the claimed deletion evidence does not validate against it."}
  :several-deletions :declared-in-run :no-deleting-form :unknown-validator-schema :invalid-deletion-evidence]
 :seon.turn/deletion-proposal
 [:or
  [:map
   [:seon.program/identity :seon.program/identity]
   [:seon.cluster.eval/ordinal :seon.cluster.eval/ordinal]
   [:seon.program/referrers :seon.program/referrers]]
  [:map
   [:seon.program/identity {:optional true} :seon.program/identity]
   [:seon.turn/unattributed :seon.turn/unattributed]]]
 :seon.turn/deletion-proposals [:vector {:min 1} :seon.turn/deletion-proposal]
 :seon.turn/deletion-proposals-edn
 [:string {:min 1 :description "The printed :seon.turn/deletion-proposals value stored on the refused write's error occurrence; the run reference scopes its ordinals."}]
}
