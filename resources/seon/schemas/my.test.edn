{:my.test/check-request
 [:map {:description "The agent protocol receives its acquired program context and writer through call preparation; the changed identities select the reaching tests."}
  [:seon.db/connection :seon.db/connection]
  [:my.program/context :my.program/context]
  [:seon.test/changed {:optional true} :seon.test/changed]
  [:seon.test/identities {:optional true :description "Tests to run themselves, instead of those reaching a change."} [:set :seon.test/sym]]
  [:seon.batch/defined {:optional true} :seon.batch/defined]]
 :my.test/check-platform-request
 [:map {:description "My branch's host-bound change to prove in a JVM loaded from it: call preparation supplies my context and writer; the tests default to those reaching my change, the declarations to my whole branch difference."}
  [:seon.db/connection :seon.db/connection]
  [:my.program/context :my.program/context]
  [:seon.test/identities {:optional true} [:set :seon.test/sym]]
  [:seon.program/identities {:optional true} :seon.program/identity-set]]
 :my.test/after-recording
 [:vector {:description "The named identities an earlier form of the same request defined: their tests run right after the request's one recording transaction, in the pass's test step, and their results ride the same reply."} :qualified-symbol]
 :my.test/after-recording-result
 [:map {:description "The answer when every named identity was defined earlier in the same request: nothing ran yet; the test step runs them after recording."}
  [:my.test/after-recording :my.test/after-recording]]
 :my.test/unreached-result
 [:map {:description "The answer when no test reaches the change: it names the unreached identities and carries no :seon.test/passed?, since nothing ran."}
  [:seon.test/unreached :seon.test/unreached]
  [:seon.test/results :seon.test.runner/captured-results]
  [:seon.test.run/id :seon.test.run/id]]
 :my.test/run-request
 [:map {:description "My namespace's tests: call preparation supplies my acquired context, writer, database and identity."}
  [:seon.db/connection :seon.db/connection]
  [:seon.db/db :seon.db/database-value]
  [:seon.agent/id :seon.agent/id]
  [:my.program/context :my.program/context]
  [:seon.ns/name {:optional true} :seon.ns/name]]}
