#:my.plan{:agent [:and {:seon.db/identity true
                       :description "The agent owning this addressable plan component."} :seon.db/ref]
          :completion [:map [:db/txInstant :inst]]
          :objective :string
          :entity
          [:map {:seon.db/attributes true
                 :seon.render/ai seon.plan/render-plan-ai
                 :seon.render/html seon.plan/render-plan-html}
           [:my.plan/agent :my.plan/agent]
           [:my.plan/objective {:optional true} :my.plan/objective]
           [:my.plan/steps {:optional true} :my.plan/steps]
           [:my.plan/current-step {:optional true} :my.plan/current-step]]
          :current-value
          [:map
           [:my.plan.item/id {:optional true} :my.plan.item/id]
           [:my.plan.item/title {:optional true} :my.plan.item/title]
           [:my.plan.item/done-when {:optional true} :my.plan.item/done-when]
                [:my.plan.item/done-query {:optional true} :my.plan.item/done-query]
                [:my.plan.item/subject {:optional true} :my.plan.item/subject]
           [:my.plan.item/completed-tx {:optional true} :my.plan/completion]
           [:my.plan.item/about {:optional true} :my.plan.item/about]
           [:my.plan/needs {:optional true} :my.plan/needs]
           [:my.plan/state {:optional true} :my.plan/state]]
          :step-summary
          [:map
           [:my.plan.item/id :my.plan.item/id]
           [:my.plan.item/title :my.plan.item/title]
           [:my.plan.item/done-when {:optional true} :my.plan.item/done-when]
                [:my.plan.item/done-query {:optional true} :my.plan.item/done-query]
                [:my.plan.item/subject {:optional true} :my.plan.item/subject]
           [:my.plan.item/completed-tx {:optional true} :my.plan/completion]
           [:my.plan.item/about {:optional true} :my.plan.item/about]
           [:my.plan/needs {:optional true} :my.plan/needs]
           [:my.plan/state {:optional true} :my.plan/state]]
          :steps
          [:set
           {:seon.db/component true :seon.db/component-schema :my.plan.item/item,
            :description
            "The root steps of this agent's one plan. The component edge is the ownership fact: retracting the agent or a step retracts everything it owns, and nothing stores a backlink."}
           :seon.db/ref],
          :current-step
          [:and
           {:description
            "The optional open step this agent has selected as its current focus. Currentness neither owns nor copies the step, so this is an ordinary ref; absence means no step is selected and the plan still renders."}
           :seon.db/ref],
          :agent-state
          [:map
           {:seon.db/attributes true,
            :description
            "The agent's one owned plan component."}
           [:seon.agent/id :seon.agent/id]
           [:seon.agent/plan {:optional true} :seon.agent/plan]],
          :parent-step
          [:and
           {:description
            "An existing step, named as the component parent a newly added step is nested under."}
           :seon.db/ref],
          :current?
          [:boolean
           {:description
            "Whether the added step becomes this agent's current step."}],
          :needs
          [:vector
           {:description
            "The ids of the plan items this step is waiting for."}
           :my.plan.item/id],
          :parent
          [:and
           {:description
            "The derived stable reference of the component parent that owns a step."}
           :my.plan/stable-item-reference],
          :depth
          [:int
           {:min 0,
            :description
            "The derived nesting depth of a step, zero for a root step."}],
          :state
          [:enum
           {:description
            "The derived disposition of one step at the read basis: a closed set of presentation states, never a stored status."}
           :completed :current :blocked :ready :open],
          :stable-item-reference
          [:map
           {:description
            "One plan step named by its stable identity. Renderers carry these instead of entity ids, so no numeric reference reaches an output."}
           [:my.plan.item/id :my.plan.item/id]],
          :render-step
          [:map
           {:description
            "One derived plan step as both projections consume it: stored content plus the derived parent, dependencies, depth, and state."
            :seon.render/ai seon.plan/render-item-ai
            :seon.render/html seon.plan/render-item-html}
           [:my.plan.item/id :my.plan.item/id]
           [:my.plan.item/title :my.plan.item/title]
           [:my.plan.item/position {:optional true} :my.plan.item/position]
           [:my.plan.item/description
            {:optional true}
            :my.plan.item/description]
           [:my.plan.item/done-when
            {:optional true}
            :my.plan.item/done-when]
                [:my.plan.item/done-query {:optional true} :my.plan.item/done-query]
                [:my.plan.item/subject {:optional true} :my.plan.item/subject]
           [:my.plan.item/completed-tx
            {:optional true}
            :my.plan/completion]
           [:my.plan.item/about {:optional true} :my.plan.item/about]
           [:my.plan/needs {:optional true} :my.plan/needs]
           [:my.plan/parent {:optional true} :my.plan/parent]
           [:my.plan/depth {:optional true} :my.plan/depth]
           [:my.plan/state {:optional true} :my.plan/state]],
          :render-steps
          [:vector
           {:description "Derived plan steps in depth-first authored order."}
           :my.plan/render-step],
          :component-input
          [:schema
           {:registry
            {:my.plan/component-input-node
             [:map
              [:my.plan.item/id :my.plan.item/id]
              [:my.plan.item/title :my.plan.item/title]
              [:my.plan.item/position
               {:optional true}
               :my.plan.item/position]
              [:my.plan.item/description
               {:optional true}
               :my.plan.item/description]
              [:my.plan.item/done-when
               {:optional true}
               :my.plan.item/done-when]
                [:my.plan.item/done-query {:optional true} :my.plan.item/done-query]
                [:my.plan.item/subject {:optional true} :my.plan.item/subject]
              [:my.plan.item/completed-tx
               {:optional true}
               :my.plan.item/completed-tx]
              [:my.plan.item/needs {:optional true} :my.plan.item/needs]
              [:my.plan.item/about {:optional true} :my.plan.item/about]
              [:my.plan.item/steps
               {:optional true}
               [:vector [:ref :my.plan/component-input-node]]]]}}
           [:map
            {:description
             "One complete authored plan tree as ordinary nested transaction data: the same stored keys, ordered by vector position."}
            [:my.plan/objective {:optional true} :my.plan/objective]
            [:my.plan/steps
             {:optional true}
             [:vector [:ref :my.plan/component-input-node]]]
            [:my.plan/current-step
             {:optional true}
             :my.plan/stable-item-reference]]],
          :component-view
          [:map
           {:description
            "The derived current projection of one agent-owned plan component tree, read by both projections from the same function."
            :seon.render/ai seon.plan/format-plan-ai
            :seon.render/html seon.plan/render-plan-html}
           [:seon.agent/id :seon.agent/id]
           [:my.plan/objective {:optional true} :my.plan/objective]
           [:my.plan/steps :my.plan/render-steps]
           [:my.plan/ready :my.plan/ready]
           [:my.plan/blocked :my.plan/blocked]
           [:my.plan/recent-completions :my.plan/recent-completions]
           [:my.plan/current-step
            {:optional true}
            :my.plan/stable-item-reference]
           [:my.plan/older-completions
            {:optional true}
            :my.plan/older-completions]],
          :added [:int {:min 0}],
          :changed [:int {:min 0}],
          :retracted [:int {:min 0}],
          :diff
          [:map
           {:description
            "What one whole-tree reconciliation added, changed, and retracted."}
           [:my.plan/added :my.plan/added]
           [:my.plan/changed :my.plan/changed]
           [:my.plan/retracted :my.plan/retracted]],
          :converged? :boolean,
          :basis-t :seon.db/basis-t,
          :plan-result
          [:map
           [:my.plan/converged? :my.plan/converged?]
           [:my.plan/basis-t :my.plan/basis-t]
           [:my.plan/diff :my.plan/diff]],
          :request
          [:map
           [:seon.db/db :seon.db/database-value]
           [:seon.agent/id :seon.agent/id]],
          :item-request
          [:map
           [:seon.db/db :seon.db/database-value]
           [:my.plan.item/id :my.plan.item/id]],
          :item-ids [:vector :my.plan.item/id],
          :items-request
          [:map
           [:seon.db/db :seon.db/database-value]
           [:my.plan/item-ids :my.plan/item-ids]],
          :ready
          [:vector
           {:description
            "Open steps whose descendants and dependencies do not block them."}
           :my.plan/render-step],
          :intent-subjects [:vector :seon.db/ref],
          :blocked
          [:vector
           {:description
            "Open steps blocked by open work on a needed step."}
           :my.plan/render-step],
          :recent-completions
          [:vector
           {:description
            "All completed steps, most recent first; presentation bounds belong to rendering."}
           :my.plan/render-step],
          :older-completions :seon.print/elision,
          :ready-items
          [:vector
           {:description
            "A ready-work selection carried as its own renderable unit."}
           :my.plan/render-step],
          :missing-agent-id [:and {:description "Observed missing agent id; a value retained independently of the plan entity."} :string],
          :agent-not-found-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/missing-agent-id :my.plan/missing-agent-id]]],
          :cycle-item-id [:and {:description "Observed cycle item id; a value retained independently of the plan entity."} :string],
          :dependency-cycle-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/cycle-item-id :my.plan/cycle-item-id]]],
          :missing-dependency-id [:and {:description "Observed missing dependency id; a value retained independently of the plan entity."} :string],
          :dependency-not-found-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/missing-dependency-id :my.plan/missing-dependency-id]]],
          :duplicate-item-id [:and {:description "Observed duplicate item id; a value retained independently of the plan entity."} :string],
          :duplicate-identity-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/duplicate-item-id :my.plan/duplicate-item-id]]],
          :duplicate-sibling-position [:and {:description "Observed duplicate sibling position; a value retained independently of the plan entity."} :int],
          :duplicate-position-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/duplicate-sibling-position :my.plan/duplicate-sibling-position]]],
          :foreign-item-id [:and {:description "Observed foreign item id; a value retained independently of the plan entity."} :string],
          :foreign-identity-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/foreign-item-id :my.plan/foreign-item-id]]],
          :existing-item-id [:and {:description "Observed existing item id; a value retained independently of the plan entity."} :string],
          :identity-exists-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/existing-item-id :my.plan/existing-item-id]]],
          :missing-reference-member [:and {:description "Observed missing reference member; a value retained independently of the plan entity."} :qualified-keyword],
          :item-reference-not-found-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/missing-reference-member :my.plan/missing-reference-member]]],
          :unowned-reference-member [:and {:description "Observed unowned reference member; a value retained independently of the plan entity."} :qualified-keyword],
          :item-reference-not-owned-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/unowned-reference-member :my.plan/unowned-reference-member]]],
          :missing-item-id [:and {:description "Observed missing item id; a value retained independently of the plan entity."} :string],
          :not-found-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/missing-item-id :my.plan/missing-item-id]]],
          :unowned-item-id [:and {:description "Observed unowned item id; a value retained independently of the plan entity."} :string],
          :not-owned-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/unowned-item-id :my.plan/unowned-item-id]]],
          :missing-subject-attribute [:and {:description "Observed missing subject attribute; a value retained independently of the plan entity."} :qualified-keyword],
          :subject-not-found-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/missing-subject-attribute :my.plan/missing-subject-attribute]]],
          :unusable-current-id [:and {:description "Observed unusable current id; a value retained independently of the plan entity."} :string],
          :unusable-current-step-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} :my.plan/request-error [:map [:my.plan/unusable-current-id :my.plan/unusable-current-id]]]
 :add-request [:map [:my.plan.item/id {:optional true} :my.plan.item/id] [:my.plan.item/done-when {:optional true} :my.plan.item/done-when]
