#:my.plan{:anchor :seon.db/ref,
          :anchor? :boolean,
          :label [:string {:min 1}],
          :after [:vector :my.plan/label],
          :children [:vector :my.plan/node],
          :node
          [:schema
           {:registry
            {:my.plan/node*
             [:map
              [:my.plan.item/id {:optional true} :my.plan.item/id]
              [:my.plan.item/title :my.plan.item/title]
              [:my.plan.item/description
               {:optional true}
               :my.plan.item/description]
              [:my.plan.item/expected-result
               {:optional true}
               :my.plan.item/expected-result]
              [:my.plan.item/needs {:optional true} :my.plan.item/needs]
              [:my.plan.item/about {:optional true} :my.plan.item/about]
              [:my.plan/label {:optional true} :my.plan/label]
              [:my.plan/after {:optional true} :my.plan/after]
              [:my.plan/children
               {:optional true}
               [:vector [:ref :my.plan/node*]]]]}}
           [:ref :my.plan/node*]],
          :tree [:vector :my.plan/node],
          :added [:int {:min 0}],
          :changed [:int {:min 0}],
          :retracted [:int {:min 0}],
          :diff
          [:map
           [:my.plan/added :my.plan/added]
           [:my.plan/changed :my.plan/changed]
           [:my.plan/retracted :my.plan/retracted]],
          :converged? :boolean,
          :basis-t :seon.db/basis-t,
          :ids [:map-of :my.plan/label :my.plan.item/id],
          :plan-result
          [:map
           [:my.plan/converged? :my.plan/converged?]
           [:my.plan/basis-t :my.plan/basis-t]
           [:my.plan/diff :my.plan/diff]
           [:my.plan/ids :my.plan/ids]],
          :agent-state
          [:map {:seon.db/attributes true}
           [:seon.cluster.agent/id :seon.cluster.agent/id]
           [:my.plan/anchor {:optional true} :my.plan/anchor]],
          :obligation-source [:enum :message :run :test],
          :obligation-id [:string {:min 1}],
          :obligation-title [:string {:min 1}],
          :obligation-ref :seon.db/ref,
          :obligation
          [:map
           [:my.plan/obligation-source :my.plan/obligation-source]
           [:my.plan/obligation-id :my.plan/obligation-id]
           [:my.plan/obligation-title :my.plan/obligation-title]
           [:my.plan/obligation-ref :my.plan/obligation-ref]],
          :obligations [:vector :my.plan/obligation],
          :ready [:vector :my.plan.item/item],
          :intent-subjects [:vector :seon.db/ref],
          :blocked [:vector :my.plan.item/item],
          :recent-completions [:vector :my.plan.item/item],
          :older-completions :seon.print/elision,
          :ready-items
          [:vector
           {:seon.render/ai my.plan/render-ready-items-ai,
            :seon.render/html my.plan/render-ready-items-html}
           :my.plan.item/item],
          :view
          [:map
           {:seon.render/ai my.plan/render-plan-ai,
            :seon.render/html my.plan/render-plan-html}
           [:seon.cluster.agent/id :seon.cluster.agent/id]
           [:my.plan/obligations :my.plan/obligations]
           [:my.plan/ready :my.plan/ready]
           [:my.plan/blocked :my.plan/blocked]
           [:my.plan/recent-completions :my.plan/recent-completions]
           [:my.plan/anchor {:optional true} :my.plan/anchor]
           [:my.plan/older-completions
            {:optional true}
            :my.plan/older-completions]],
          :agent-not-found [:= true],
          :agent-not-found-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a plan request whose agent does not exist"} [:my.plan/agent-not-found :my.plan/agent-not-found] [:seon.error/message :seon.error/message]],
          :ambiguous-identity [:= true],
          :ambiguous-identity-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark an authored plan identity with multiple candidates"} [:my.plan/ambiguous-identity :my.plan/ambiguous-identity] [:seon.error/message :seon.error/message]],
          :completed-identity [:= true],
          :completed-identity-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a completed identity that cannot be rewritten"} [:my.plan/completed-identity :my.plan/completed-identity] [:seon.error/message :seon.error/message]],
          :dependency-not-found [:= true],
          :dependency-not-found-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a plan dependency that does not exist"} [:my.plan/dependency-not-found :my.plan/dependency-not-found] [:seon.error/message :seon.error/message]],
          :duplicate-identity [:= true],
          :duplicate-identity-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark an identity repeated in one authored plan"} [:my.plan/duplicate-identity :my.plan/duplicate-identity] [:seon.error/message :seon.error/message]],
          :duplicate-label [:= true],
          :duplicate-label-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a label repeated in one authored plan"} [:my.plan/duplicate-label :my.plan/duplicate-label] [:seon.error/message :seon.error/message]],
          :foreign-identity [:= true],
          :foreign-identity-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark an authored identity owned by another agent"} [:my.plan/foreign-identity :my.plan/foreign-identity] [:seon.error/message :seon.error/message]],
          :identity-exists [:= true],
          :identity-exists-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a new plan item identity that already exists"} [:my.plan/identity-exists :my.plan/identity-exists] [:seon.error/message :seon.error/message]],
          :item-reference-not-found [:= true],
          :item-reference-not-found-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a referenced plan item that does not exist"} [:my.plan/item-reference-not-found :my.plan/item-reference-not-found] [:seon.error/message :seon.error/message]],
          :item-reference-not-owned [:= true],
          :item-reference-not-owned-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a referenced plan item owned by another agent"} [:my.plan/item-reference-not-owned :my.plan/item-reference-not-owned] [:seon.error/message :seon.error/message]],
          :not-found [:= true],
          :not-found-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a plan item that does not exist"} [:my.plan/not-found :my.plan/not-found] [:seon.error/message :seon.error/message]],
          :not-owned [:= true],
          :not-owned-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a plan item owned by another agent"} [:my.plan/not-owned :my.plan/not-owned] [:seon.error/message :seon.error/message]],
          :subject-not-found [:= true],
          :subject-not-found-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a plan subject that does not exist"} [:my.plan/subject-not-found :my.plan/subject-not-found] [:seon.error/message :seon.error/message]],
          :unknown-label [:= true],
          :unknown-label-error [:map {:seon.error/class true, :seon.render/ai seon.error/render-ai, :seon.render/html seon.error/render-html, :error/message "must mark a plan dependency label that does not exist"} [:my.plan/unknown-label :my.plan/unknown-label] [:seon.error/message :seon.error/message]]}
