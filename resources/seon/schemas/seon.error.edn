;; The one error map (Seon's names; the shape is Seon's errors-cut target: :seon.error/base
;; without :at and :layer). Copied concept by concept, not Seon's registry.
{:seon.error/type :qualified-keyword
 :seon.error/operation :qualified-symbol
 :seon.error/message :string
 :seon.error/fix :string
 :seon.error/member :keyword
 :seon.error/in [:qualified-symbol {:description "The fn an error was raised in (a var symbol, as `ns/name`)."}]
 :seon.error/at [:map {:description "A position in that form's own text (what (source v) prints), 1-based."} [:line :int] [:column {:optional true} :int]]
 :seon.error/problem [:map {:description "One refused part of a value: malli's path and the value as it prints, marked code (seon.print/code)."}
                      [:path vector?] [:in vector?] [:expected :any] [:value [:map [:seon.print/code :string]]]]
 :seon.error/problems [:vector :seon.error/problem]
 ;; what the error is about, when it names one: a var (symbol), a section address (string) or an
 ;; attribute (keyword: a proc's own fact, e.g. root's :seon.root/watch). Once its subject changes
 ;; after the error last happened, the error is closed (seon.problems), by a read
 :seon.error/subject [:or :string :symbol :qualified-keyword]
 :seon.error/base [:and {:seon.render/html seon.render.ui/error-box :description "Every error: its variant (a registered schema key), the operation that raised it, a short message; plain data, all of it (seon.contract/error makes it so)."}
                   [:map
                   [:seon.error/type :seon.error/type]
                   [:seon.error/operation :seon.error/operation]
                   [:seon.error/message :seon.error/message]
                   [:seon.error/fix {:optional true} :seon.error/fix]
                   [:seon.error/member {:optional true} :seon.error/member]
                   [:seon.error/in {:optional true} :seon.error/in]
                   [:seon.error/at {:optional true} :seon.error/at]
                   ;; a macro's syntax error: the forms its call was given, each whole, as read (seon.repl/given)
                   [:seon.error/given {:optional true} [:vector :string]]
                   [:seon.error/problems {:optional true} :seon.error/problems]
                   [:seon.error/subject {:optional true} :seon.error/subject]]
                   :seon.db/plain]
 ;; the instrumented wrapper's errors (Seon's variant names)
 :seon.instrument/contract-error [:and :seon.error/base [:map [:seon.error/type [:enum :seon.instrument/contract-error]]]]
 :seon.instrument/arity-error [:and :seon.error/base [:map [:seon.error/type [:enum :seon.instrument/arity-error]]]]}
