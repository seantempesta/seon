#:seon.error{:throwable
             [:fn {:error/message "must be a JVM Throwable"
                   :gen/gen seon.error/throwable-generator} seon.error/throwable?],
             :explain-request
             [:map
              [:seon.error/problem
               [:map [:schema [:fn {:error/message "must be a compiled Malli schema"
                                   :gen/gen seon.error/compiled-schema-generator} malli.core/schema?]]
                [:value :seon.schema/value]
                [:type {:optional true} :keyword]]]
              [:seon.error/path :seon.render.data/path]
              [:seon.error/argument :string]
              [:seon.error/parent {:optional true} :seon.schema/value]],
             :problem-description
             [:map
              [:seon.error/path :seon.render.data/path]
              [:seon.error/argument :string]
              [:seon.error/expected :seon.schema/value]
              [:seon.error/expected-description :string]
              [:seon.error/offending :seon.schema/value]
              [:seon.error/actual-description :string]
              [:seon.error/fix :string]],
             :run [:and #:seon.db{:index true} :seon.db/ref],
             :data-blob :seon.blob/digest,
             :doc
             [:map
              {:description "Function documentation attached to a contract refusal at the agent evaluation boundary."}
              [:summary :string]
              [:body :string]
              [:example :string]
              [:in :seon.schema/value]
              [:out :seon.schema/value]],
             :class [:= true],
             :evidence [:tuple [:enum :seon.error/id] :seon.error/id],
             :steward-request
             [:map
              {:description
               "What `steward-call` needs to route one fault inside the committing transaction."}
              [:seon.error/id :seon.error/id]
              [:seon.instrument/fn
               {:optional true}
               :seon.instrument/fn]],
             :value
             [:map
              [:seon.error/kind :seon.error/kind]
              [:seon.error/message :seon.error/message]
              [:seon.error/doc {:optional true} :seon.error/doc]
              [:seon.error/data {:optional true} :seon.error/data]],
             :notice-request
             [:map
              [:seon.error/fact :seon.error/fact]
              [:seon.error/reason {:optional true} :seon.error/reason]
              [:seon.error/occurrence
               {:optional true}
               :seon.error/occurrence]
              [:seon.error/occurrences
               {:optional true}
               :seon.error/occurrences]
              [:seon.error/notification-limit
               {:optional true}
               :seon.error/notification-limit]
              [:seon.error/notification
               {:optional true}
               :seon.error/notification]
              [:seon.agent/id {:optional true} :seon.agent/id]],
             :capped? :boolean,
             :occurrences [:int {:min 1}],
             :reason
             [:enum
              :your-run
              :no-attributable-agent
              :recurring
              :failover],
             :op :keyword,
             :data-edn :string,
             :refusal-value
             [:map
              [:seon.error/message :seon.error/message]
              [:seon.turn/rule {:optional true} :seon.turn/rule]
              [:seon.turn/transition
               {:optional true}
               :seon.turn/transition]],
             :source
             [:any
              {:seon.schema.admission/exemption
               :seon.schema.admission/polymorphic-boundary,
               :seon.schema.admission/reason
               "The error boundary must normalize any value or Throwable that escaped a failing subsystem.",
               :gen/elements
               [nil true 0 "failure" :failure [] {} #{}]}],
             :normalize-request
             [:map
              [:seon.error/source :seon.error/source]
              [:seon.error/id :seon.error/id]
              [:seon.error/at :seon.error/at]
              [:seon.error/process :seon.error/process]
              [:seon.sci.admit/caps :seon.sci.admit/caps]
              [:seon.error/basis-t
               {:optional true}
               :seon.error/basis-t]
              [:seon.turn/id {:optional true} :seon.turn/id]
              [:seon.agent/id {:optional true} :seon.agent/id]
              [:seon.config.error/max-evidence-bytes
               :seon.config.error/max-evidence-bytes]],
             :id [:string {:min 1, :seon.db/identity true}],
             :message [:string {:min 1, :seon.search/index :text}],
             :refusal-shape :qualified-keyword,
             :proc :keyword,
             :dropped-fault-digest [:string {:min 64, :max 64}],
             :cid :keyword,
             :fact
             [:map
              {:seon.db/attributes true,
               :seon.render/ai seon.error/render-ai,
               :seon.render/html seon.error/render-html}
              [:seon.error/id :seon.error/id]
              [:seon.error/at :seon.error/at]
              [:seon.error/process :seon.error/process]
              [:seon.error/kind :seon.error/kind]
              [:seon.error/message :seon.error/message]
              [:seon.error/signature :seon.error/signature]
              [:seon.error/data-edn :seon.error/data-edn]
              [:seon.error/data-size
               {:optional true}
               :seon.error/data-size]
              [:seon.error/data-blob
               {:optional true}
               :seon.error/data-blob]
              [:seon.error/capped? :seon.error/capped?]
              [:seon.error/throwable-class
               {:optional true}
               :seon.error/throwable-class]
              [:seon.error/proc {:optional true} :seon.error/proc]
              [:seon.error/op {:optional true} :seon.error/op]
              [:seon.error/cid {:optional true} :seon.error/cid]
              [:seon.error/dropped-fault-count
               {:optional true}
               :seon.error/dropped-fault-count]
              [:seon.error/dropped-fault-digest
               {:optional true}
               :seon.error/dropped-fault-digest]
              [:seon.error/basis-t
               {:optional true}
               :seon.error/basis-t]
              [:seon.error/run {:optional true} :seon.error/run]
              [:seon.error/agent {:optional true} :seon.error/agent]
              [:seon.error/steward
               {:optional true}
               :seon.error/steward]
              [:seon.instrument/fn
               {:optional true}
               :seon.instrument/fn]
              [:seon.instrument/arm
               {:optional true}
               :seon.instrument/arm]
              [:seon.instrument/expected
               {:optional true}
               :seon.instrument/expected]
              [:seon.instrument/args
               {:optional true}
               :seon.instrument/args]],
             :commit-tx-request
             [:map
              [:seon.error/source :seon.error/source]
              [:seon.error/id :seon.error/id]
              [:seon.error/at :seon.error/at]
              [:seon.error/process :seon.error/process]
              [:seon.sci.admit/caps :seon.sci.admit/caps]
              [:seon.config.error/recurrence-limit
               :seon.config.error/recurrence-limit]
              [:seon.error/basis-t
               {:optional true}
               :seon.error/basis-t]
              [:seon.turn/id {:optional true} :seon.turn/id]
              [:seon.agent/id {:optional true} :seon.agent/id]
              [:seon.config.error/escalate-to
               {:optional true}
               :seon.config.error/escalate-to]
              [:seon.config.error/max-evidence-bytes
               :seon.config.error/max-evidence-bytes]
              [:seon.error/fact {:optional true} :seon.error/fact]],
             :prepare-request :seon.error/normalize-request,
             :data :map,
             :prepared
             [:map
              [:seon.error/fact :seon.error/fact]
              [:seon.error/data-content :seon.error/data-content]],
             :steward
             [:and
              {:description
               "The agent this fault is ROUTED TO for repair: the steward of the namespace of the function that failed (:seon.instrument/fn -> :seon.fn/ns -> :seon.ns/steward), decided inside the committing transaction. A LISTENED ATTRIBUTE: asserting it wakes that agent. Distinct from :seon.error/agent, which is the agent this fault happened TO. Also an INSIDE wake — a fault is the population's own activity and never resets the steward's turn bound; the bound is what stops a fault about an agent's own code looping.",
               :seon.db/index true,
               :seon.render/ai seon.error/render-faults-ai,
               :seon.render/html seon.error/render-faults-html,
               :seon.render/form seon.error/faults-form,
               :seon.wake/listen true,
               :seon.wake/opens-turn? true,
               :seon.wake/inside true}
              :seon.db/ref],
             :data-content :string,
             :occurrence [:int {:min 1}],
             :unclassified-error
             [:map
              {:seon.error/class true,
               :seon.render/ai seon.error/unclassified-prose,
               :seon.render/html seon.error/render-html,
               :error/message
               "must mark a failure that no registered error class recognized"}
              [:seon.error/unclassified :seon.error/unclassified]
              [:seon.error/message :seon.error/message]],
             :notice
             [:map
              [:seon.error/fact :seon.error/fact]
              [:seon.error/kind :seon.error/kind]
              [:seon.error/evidence :seon.error/evidence]
              [:seon.render/ai :qualified-symbol]
              [:seon.error/reason {:optional true} :seon.error/reason]
              [:seon.error/occurrence
               {:optional true}
               :seon.error/occurrence]
              [:seon.error/occurrences
               {:optional true}
               :seon.error/occurrences]
              [:seon.error/notification-limit
               {:optional true}
               :seon.error/notification-limit]
              [:seon.error/notification
               {:optional true}
               :seon.error/notification]
              [:seon.agent/id {:optional true} :seon.agent/id]],
             :refusal [:= true],
             :basis-t [:int {:min 0}],
             :agent
             [:and
              {:description
               "The agent this fault happened to; its reverse is that agent's fault list.",
               :seon.render/ai seon.error/render-faults-ai,
               :seon.render/html seon.error/render-faults-html,
               :seon.db/index true}
              :seon.db/ref],
             :data-size [:int {:min 0}],
             :kind :keyword,
             :at :inst,
             :throwable-class [:string {:min 1}],
             :notification-limit [:int {:min 1}],
             :notification [:enum :final],
             :unclassified [:= true],
             :dropped-fault-count [:int {:min 1}],
             :signature [:re #:seon.db{:index true} "^[0-9a-f]{64}$"],
             :process [:string {:min 1}]}
