#:seon.cluster.host{:refused-error
                    [:merge {:description "A host decision refused by name: a closed admission, another home branch, another agent hosted on the branch; :seon.error/member names which."}
                     :seon.error/base
                     [:map [:seon.cluster.host/refused-agent :seon.cluster.host/refused-agent]]],
                    :refused-agent [:string {:min 1 :description "The agent id a host decision refused, as a value (not the agent's identity)."}],
                    :request
                    [:map
                     {:description "Host one agent on an existing branch through the running cluster's handle."}
                     [:seon.turn.loop/cluster :seon.agent/context-source]
                     [:seon.agent/branch :seon.agent/branch]
                     [:seon.agent/id :seon.agent/id]
                     [:seon.ns/name :seon.ns/name]],
                    :host
                    [:map
                     {:description "A running host: the branch handle, its registry, the hosted agent and the acquired execution, whose connection carries the branch's route listener."}
                     [:seon.turn.loop/cluster :seon.turn.loop/cluster]
                     [:seon.agent/routing :seon.agent/routing]
                     [:seon.agent/id :seon.agent/id]
                     [:seon.cluster.host/execution :seon.agent/execution-handle]]}
