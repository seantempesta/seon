#:seon.sci.eval{:private-state
                [:enum {:description "In-process regeneration preserves private Var roots, atoms, result objects and captured values by identity. A fresh agent or JVM restart has no private layer to restore; only admitted program facts are loaded."}
                 :preserved-in-memory :absent],
                :load-state
                [:enum {:description "Current core admission copies the JVM root; agent admission interprets source. An unevaluable agent source uses the loaded JVM root only with jvm-fallback and its diagnostic. Unavailable means no loaded root could be installed."}
                 :jvm :interpreted :jvm-fallback :unavailable],
                :load-result
                [:map
                 [:seon.sci.eval/load-state :seon.sci.eval/load-state]
                 [:seon.fn/sym :seon.fn/sym]
                 [:seon.error/message {:optional true} :seon.error/message]],
                :load-results [:vector :seon.sci.eval/load-result],
                :evaluation
                [:map
                 [:seon.test.accretion/candidate-ctx {:optional true}
                  :seon.test.accretion/candidate-ctx]
                 [:seon.sci.admit/value
                  {:optional true}
                  [:any
                   {:seon.schema.admission/exemption
                    :seon.schema.admission/polymorphic-boundary,
                    :seon.schema.admission/reason
                    "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation.",
                    :gen/elements [nil true 0 "" :k [] {} #{}]}]]
                 [:seon.eval/renderer {:optional true} :seon.eval/renderer]
             [:seon.eval/shown {:optional true} :seon.eval/shown]
                 [:seon.cluster.eval/error
                  {:optional true}
                  :seon.cluster.eval/error]
                 [:seon.cluster.eval/triage-edn
                  {:optional true}
                  :seon.cluster.eval/triage-edn]
                 [:seon.cluster.eval/interrupted-at
                  {:optional true}
                  :seon.cluster.eval/interrupted-at]
                 [:seon.cluster.eval/output
                  {:optional true}
                  :seon.cluster.eval/output]
                 [:seon.cluster.eval/read-evidence
                  {:optional true}
                  [:vector :seon.db/read-evidence]]
                 [:seon.cluster.eval/ns :seon.cluster.eval/ns]
                 [:seon.sci.eval/ending-ns :seon.sci.eval/ending-ns]
                 [:seon.program/row {:optional true} :seon.program/row]
                 [:seon.sci.eval/bindings
                  {:optional true}
                  :seon.sci.eval/bindings]
                 [:seon.print/options :seon.print/options]
                 [:seon.sci.admit/record :seon.sci.admit/record]],
                ,
                ,
                ,
                :missing-function-row :qualified-symbol,
                ,
                :referenced-vars [:set :symbol],
                ,
                :binding
                [:map
                 [:seon.sci.eval/metadata :map]
                 [:seon.sci.eval/value
                  [:any
                   {:seon.schema.admission/exemption
                    :seon.schema.admission/polymorphic-boundary,
                    :seon.schema.admission/reason
                    "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation.",
                    :gen/elements [nil true 0 "" :k [] {} #{}]}]]],
                ,
                :missing-function-row-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.eval/missing-function-row :seon.sci.eval/missing-function-row]]],
                :time-limit-ms [:int {:min 1}],
                :defs-fork-result
                [:map [:seon.sci.eval/ctx :seon.sci.eval/ctx]],
                :namespace-binding-cycle-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.eval/pending-namespaces :seon.sci.eval/pending-namespaces]]],
                :defs-fork-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.sci.eval/agent-ctx
                  {:optional true}
                  :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.agent/id :seon.agent/id]
                 [:seon.turn/id {:optional true} :seon.turn/id]
                 [:seon.db/connection
                  {:optional true}
                  :seon.db/connection]],
                ,
                :unrun-request
                [:map
                 [:seon.sci.admit/value :seon.error/value]
                 [:seon.cluster.eval/ns :seon.db/ref]
                 [:seon.eval/duration-ms {:optional true} :int]
                 [:seon.cluster.eval/interrupted-at
                  {:optional true}
                  :seon.cluster.eval/interrupted-at]],
                :invocation-result
                [:map
                 [:seon.sci.admit/print-node
                  {:optional true}
                  :seon.print/node]
                 [:seon.sci.admit/value
                  {:optional true}
                  [:any
                   {:seon.schema.admission/exemption
                    :seon.schema.admission/polymorphic-boundary,
                    :seon.schema.admission/reason
                    "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation.",
                    :gen/elements [nil true 0 "" :k [] {} #{}]}]]
                 [:seon.sci.admit/record :seon.sci.admit/record]],
                ,
                :install-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.program/row :seon.program/row]],
                :invocation-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.fn/sym :seon.fn/sym]
                 [:seon.sci.eval/args :seon.sci.eval/args]
                 [:seon.sci.eval/time-limit-ms
                  :seon.sci.eval/time-limit-ms]
                 [:seon.sci.admit/caps :seon.sci.admit/caps]
                 [:seon.db/read-evidence-sink
                  {:optional true}
                  :seon.db/read-evidence-sink]
                 [:seon.config/on-core-error
                  :seon.config/on-core-error]],
                :args
                [:vector
                 [:any
                  {:seon.schema.admission/exemption
                   :seon.schema.admission/polymorphic-boundary,
                   :seon.schema.admission/reason
                   "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation.",
                   :gen/elements [nil true 0 "" :k [] {} #{}]}]],
                :schema-refused-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.eval/schema-refused :seon.sci.eval/schema-refused]]],
                :reader-event-count :int,
                ,
                :time-limit :seon.eval/fn-entries,
                :ctx
                [:fn
                 {:error/message "must be an SCI evaluation context",
                  :gen/gen seon.sci.eval/ctx-generator}
                 seon.sci.eval/ctx?],
                :ending-ns :symbol,
                :request
                [:map
                 [:seon.cluster.eval/source :seon.cluster.eval/source]
                 [:seon.cluster.eval/ns
                  {:optional true}
                  :seon.cluster.eval/ns]
                 [:seon.sci.admit/caps :seon.sci.admit/caps]
                 [:seon.sci.eval/time-limit-ms
                  :seon.sci.eval/time-limit-ms]
                 [:seon.config/on-core-error
                  :seon.config/on-core-error]
                 [:seon.sci.eval/ctx
                  {:optional true}
                  :seon.sci.eval/ctx]
                 [:seon.db/db {:optional true} :seon.db/database-value]
                 [:seon.agent/id {:optional true} :seon.agent/id]
                 [:seon.turn/id {:optional true} :seon.turn/id]
                 [:seon.cluster.eval/ordinal
                  {:optional true}
                  :seon.cluster.eval/ordinal]
                 [:seon.sci.eval/output-prefix
                  {:optional true}
                  :string]
                 [:seon.boot/cluster-name
                  {:optional true}
                  :seon.boot/cluster-name]],
                :schema-refused :seon.schema/key,
                :reader-event-count-error
                [:and {:seon.db/attributes true
                       :description "An evaluation requires exactly one reader event. This observation records the actual count; it does not claim a parsed form or a projected source."}
                 :seon.error/base
                 [:map {:seon.db/attributes true}
                 [:seon.sci.eval/reader-event-count
                  :seon.sci.eval/reader-event-count]]],
                :documentation-unavailable :symbol,
                :bindings
                [:map-of :qualified-symbol :seon.sci.eval/binding],
                :install-mismatch-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.eval/installation-member :seon.sci.eval/installation-member]]],
                :projection-state
                [:fn
                 {:error/message
                  "must hold one immutable replacement environment",
                  :gen/gen seon.sci.eval/projection-state-generator}
                 seon.sci.eval/projection-state?],
                :documentation-unavailable-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.eval/documentation-unavailable :seon.sci.eval/documentation-unavailable]]],
                :acquire-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.flow/commit-fault!
                  {:optional true}
                  :seon.flow/commit-fault!]
                 [:seon.schema/projection
                  {:optional true}
                  :seon.schema/projection]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.sci.eval/row-acquisition-error
 [:and
  {:seon.db/attributes true,
   :description "Failure to acquire one observed program member. Owned by the error occurrence; no whole-program identity is asserted."}
  :seon.error/base
  [:map
   {:seon.db/attributes true}
   [:seon.sci.eval/row-member :seon.sci.eval/row-member]
   [:seon.sci.eval/acquisition-observation :seon.sci.eval/acquisition-observation]]]

 :seon.sci.eval/row-member
 [:or {:description "The program name observed while acquiring a row: a namespace, function or test symbol, or a schema keyword. A value observation, never a ref; deleting the named declaration leaves this evidence unchanged."}
  :symbol :qualified-keyword]

 :seon.sci.eval/acquisition-error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.eval/requested-program :seon.sci.eval/requested-program]
  [:seon.sci.eval/acquisition-member :seon.sci.eval/acquisition-member]
  [:seon.sci.eval/acquisition-observation
   :seon.sci.eval/acquisition-observation]]]

 :seon.sci.eval/acquisition-member
 [:or :qualified-symbol :qualified-keyword]

 :seon.sci.eval/acquisition-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.sci.eval/evaluation-error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.eval/evaluation-id :seon.sci.eval/evaluation-id]
  [:seon.sci.eval/source-projection :seon.sci.eval/source-projection]]]

 :seon.sci.eval/evaluation-id
 [:string {:min 1}]

 :seon.sci.eval/requested-program
 [:string {:min 64, :max 64}]

 :seon.sci.eval/source-projection
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

:pending-namespaces [:set {:min 1} :symbol]
:missing-declaration :qualified-keyword
:declaration-absent-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.eval/missing-declaration :seon.sci.eval/missing-declaration]]]

:installation-member [:or :symbol :qualified-keyword :string]
}
