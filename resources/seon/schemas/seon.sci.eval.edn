:untrusted [:map {:description "Why a frame's kept value is not trusted: a failure after SCI returned it (the loaded program changed while it ran). The value stays; its program facts are not proposed."}
            [:seon.error/message :string]]
:database
[:and {:description "The database an evaluation reads when its caller hands one. Absent, the evaluation reads its context's custody, so this is not a world member (seon.batch/world-members): a bound world never supplies it."}
 :seon.db/database-value]
:stacktrace [:vector {:min 1 :description "An interpreted failure's source location: the author's SCI frames, innermost first, as [function-or-namespace line column] (sci.core/stacktrace). SCI's live callstack is read once and never stored."} [:tuple :symbol :int :int]]
