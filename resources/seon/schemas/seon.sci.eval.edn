#:seon.sci.eval{:acquire-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.flow/commit-fault! {:optional true} :seon.flow/commit-fault!]
                 [:seon.schema/projection
                  {:optional true}
                  :seon.schema/projection]],
                :args [:vector [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                          :seon.schema.admission/reason "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation."
                          :gen/elements [nil true 0 "" :k [] {} #{}]}]],
                :ctx
                [:fn
                 {:error/message "must be an SCI evaluation context"
                  :gen/gen seon.sci.eval/ctx-generator}
                 seon.sci.eval/ctx?],
                :projection-state
                [:fn
                 {:error/message
                  "must hold one immutable replacement environment"
                  :gen/gen seon.sci.eval/projection-state-generator}
                 seon.sci.eval/projection-state?],
                :ending-ns :symbol,
                :evaluation
                [:map
                 ;; A VALUE AND ITS BYTES ARE ONE TERMINAL SHAPE, and the
                 ;; other is :seon.eval/missing. An evaluation over the
                 ;; storage bound carries neither the value nor the node, so
                 ;; requiring them made the evaluator's own contract refuse
                 ;; the answer it is supposed to give.
                 [:seon.sci.admit/value {:optional true}
                  [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                          :seon.schema.admission/reason "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation."
                          :gen/elements [nil true 0 "" :k [] {} #{}]}]]
                 [:seon.cluster.eval/result-edn
                  {:optional true}
                  :seon.cluster.eval/result-edn]
                 [:seon.eval/missing {:optional true} :seon.eval/missing]
                 [:seon.eval/size {:optional true} :seon.eval/size]
                 [:seon.cluster.eval/error
                  {:optional true}
                  :seon.cluster.eval/error]
                 [:seon.cluster.eval/triage-edn
                  {:optional true}
                  :seon.cluster.eval/triage-edn]
                 [:seon.cluster.eval/interrupted-at
                  {:optional true}
                  :seon.cluster.eval/interrupted-at]
                 [:seon.cluster.eval/output
                  {:optional true}
                  :seon.cluster.eval/output]
                 [:seon.cluster.eval/read-evidence
                  {:optional true}
                  [:vector :seon.db/read-evidence]]
                 [:seon.cluster.eval/ns :seon.cluster.eval/ns]
                 [:seon.sci.eval/ending-ns :seon.sci.eval/ending-ns]
                 [:seon.program/row
                  {:optional true}
                  :seon.program/row]
                 [:seon.sci.eval/defs
                  {:optional true}
                  :seon.sci.eval/defs]
                 [:seon.print/options :seon.print/options]
                 [:seon.sci.admit/record :seon.sci.admit/record]],
                :unrun-request
                [:map
                 [:seon.sci.admit/value :seon.error/value]
                 [:seon.cluster.eval/ns :seon.db/ref]
                 [:seon.eval/duration-ms {:optional true} :int]
                 [:seon.cluster.eval/interrupted-at
                  {:optional true}
                  :seon.cluster.eval/interrupted-at]],
                :install-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.program/row
                  :seon.program/row]],
                :invocation-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.fn/sym :seon.fn/sym]
                 [:seon.sci.eval/args :seon.sci.eval/args]
                 [:seon.sci.eval/time-limit-ms
                  :seon.sci.eval/time-limit-ms]
                 [:seon.sci.admit/caps :seon.sci.admit/caps]
                 [:seon.db/read-evidence-sink
                  {:optional true}
                  :seon.db/read-evidence-sink]
                 [:seon.config/on-core-error
                  :seon.config/on-core-error]],
                :invocation-result
                [:map
                 [:seon.sci.admit/print-node {:optional true} :seon.print/node]
                 [:seon.sci.admit/value {:optional true} [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                          :seon.schema.admission/reason "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation."
                          :gen/elements [nil true 0 "" :k [] {} #{}]}]]
                 [:seon.eval/missing {:optional true} :seon.eval/missing]
                 [:seon.eval/size {:optional true} :seon.eval/size]
                 [:seon.sci.admit/record :seon.sci.admit/record]],
                :referenced-vars [:set :symbol],
                :request
                [:map
                 [:seon.cluster.eval/source
                  :seon.cluster.eval/source]
                 [:seon.cluster.eval/ns
                  {:optional true}
                  :seon.cluster.eval/ns]
                 [:seon.sci.admit/caps :seon.sci.admit/caps]
                 [:seon.sci.eval/time-limit-ms
                  :seon.sci.eval/time-limit-ms]
                 [:seon.config/on-core-error
                  :seon.config/on-core-error]
                 [:seon.sci.eval/ctx
                  {:optional true}
                  :seon.sci.eval/ctx]
                 [:seon.db/db
                  {:optional true}
                  :seon.db/database-value]
                 [:seon.cluster.agent/id
                  {:optional true}
                  :seon.cluster.agent/id]
                 [:seon.cluster.run/id
                  {:optional true}
                  :seon.cluster.run/id]
                 [:seon.cluster.eval/ordinal
                  {:optional true}
                  :seon.cluster.eval/ordinal]
                 [:seon.sci.eval/output-prefix
                  {:optional true}
                  :string]
                 [:seon.boot/cluster-name
                  {:optional true}
                  :seon.boot/cluster-name]],
                :def-candidate
                [:map
                 [:seon.def/id :seon.def/id]
                 [:seon.def/ns :seon.def/ns]
                 [:seon.def/name :seon.def/name]
                 [:seon.def/atom? {:optional true} :seon.def/atom?]
                 [:seon.sci.eval/value [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                          :seon.schema.admission/reason "The evaluator accepts and returns arbitrary Clojure values; admission owns their bounded representation."
                          :gen/elements [nil true 0 "" :k [] {} #{}]}]]],
                :defs [:vector :seon.sci.eval/def-candidate],
                :defs-fork-request
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.cluster.agent/id :seon.cluster.agent/id]
                 ;; The run whose already settled evaluations this fork binds
                 ;; back as result/eN handles. Absent when no run is in
                 ;; effect, and then the fork simply binds none.
                 [:seon.cluster.run/id
                  {:optional true}
                  :seon.cluster.run/id]
                 [:seon.db/connection
                  {:optional true}
                  :seon.db/connection]],
                :defs-fork-result
                [:map
                 [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                 [:seon.sci.eval/defs-notices
                  :seon.sci.eval/defs-notices]],
                :defs-notices [:vector :string],
                :time-limit-ms [:int {:min 1}],
                :install-mismatch [:= true]
                :install-mismatch-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the function whose installed source or deletion mismatched"} [:seon.sci.eval/install-mismatch :seon.sci.eval/install-mismatch] [:seon.error/message :seon.error/message]]
                :documentation-unavailable :symbol
                :documentation-unavailable-error
                [:map {:seon.error/class true
                       :seon.render/ai seon.error/render-ai
                       :seon.render/html seon.error/render-html}
                 [:seon.sci.eval/documentation-unavailable :seon.sci.eval/documentation-unavailable]
                 [:seon.error/message :seon.error/message]]
                :missing-function-row :qualified-symbol
                :missing-function-row-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the function with no admitted program row"} [:seon.sci.eval/missing-function-row :seon.sci.eval/missing-function-row] [:seon.error/message :seon.error/message]]
                :namespace-binding-cycle [:= true]
                :namespace-binding-cycle-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify a namespace participating in a binding cycle"} [:seon.sci.eval/namespace-binding-cycle :seon.sci.eval/namespace-binding-cycle] [:seon.error/message :seon.error/message]]
                :reader-event-count :int
                :reader-event-count-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the impossible reader-event count"} [:seon.sci.eval/reader-event-count :seon.sci.eval/reader-event-count] [:seon.error/message :seon.error/message]]
                :schema-refused :seon.schema/key
                :schema-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the schema declaration refused during evaluation"} [:seon.sci.eval/schema-refused :seon.sci.eval/schema-refused] [:seon.error/message :seon.error/message]]
                :def-blob-unavailable :seon.blob/digest
                :def-blob-unavailable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the unavailable blob for the agent's def"} [:seon.sci.eval/def-blob-unavailable :seon.sci.eval/def-blob-unavailable] [:seon.error/message :seon.error/message]]
                :time-limit :seon.eval/fn-entries
                :time-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/time-limit-prose :seon.render/html seon.error/render-html :error/message "must identify the evaluation time limit that was reached"} [:seon.sci.eval/time-limit :seon.sci.eval/time-limit] [:seon.error/message :seon.error/message]]
                :evaluation-failed [:= true]
                :evaluation-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark an evaluation that failed before producing a value"} [:seon.sci.eval/evaluation-failed :seon.sci.eval/evaluation-failed] [:seon.error/message :seon.error/message]]
 :seon.sci.eval/acquisition-refused [:= true]
 :seon.sci.eval/acquisition-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.sci.eval/acquisition-refused class marker"} [:seon.sci.eval/acquisition-refused :seon.sci.eval/acquisition-refused] [:seon.error/message :seon.error/message]]
 :seon.sci.eval/function-root-identity-mismatch [:= true]
 :seon.sci.eval/function-root-identity-mismatch-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.sci.eval/function-root-identity-mismatch class marker"} [:seon.sci.eval/function-root-identity-mismatch :seon.sci.eval/function-root-identity-mismatch] [:seon.error/message :seon.error/message]]
 :seon.sci.eval/namespace-unloadable [:= true]
 :seon.sci.eval/namespace-unloadable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.sci.eval/namespace-unloadable class marker"} [:seon.sci.eval/namespace-unloadable :seon.sci.eval/namespace-unloadable] [:seon.error/message :seon.error/message]]
 :seon.sci.eval/unrestorable-function-root [:= true]
 :seon.sci.eval/unrestorable-function-root-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.sci.eval/unrestorable-function-root class marker"} [:seon.sci.eval/unrestorable-function-root :seon.sci.eval/unrestorable-function-root] [:seon.error/message :seon.error/message]]}
