 :seon.sci.eval/row-acquisition-error
 [:and
  {:seon.db/attributes true,
   :description "Failure to acquire one observed program member. Owned by the error occurrence; no whole-program identity is asserted."}
  :seon.error/base
  [:map
   {:seon.db/attributes true}
   ;; exactly one names the observed member: a symbol, or a schema entity's key
   [:seon.sci.eval/row-member {:optional true} :seon.sci.eval/row-member]
   [:seon.sci.eval/row-symbol {:optional true} :seon.sci.eval/row-symbol]
   [:seon.sci.eval/row-schema-key {:optional true} :seon.sci.eval/row-schema-key]
   [:seon.sci.eval/acquisition-observation :seon.sci.eval/acquisition-observation]]]

 :seon.sci.eval/row-member
 [:or {:description "RETIRING (two adoptions): installed as a string, so a symbol could not be stored. No producer or reader remains; entity-symbol and entity-schema-key replace it. Its declaration goes in the next adoption, once no stored entity schema requires it."}
  :symbol :qualified-keyword]

 :seon.sci.eval/row-symbol
 [:symbol {:description "The namespace, function or test symbol observed while acquiring an entity, stored as a native symbol. A value observation, never a ref; deleting the named declaration leaves this evidence unchanged. Replaces :seon.sci.eval/row-member, which installed as a string."}]

 :seon.sci.eval/row-schema-key
 [:qualified-keyword {:description "The schema key observed while acquiring a schema entity, stored as a native keyword. A value observation, never a ref."}]

 :seon.sci.eval/acquisition-error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.eval/requested-program :seon.sci.eval/requested-program]
  [:seon.sci.eval/acquisition-member :seon.sci.eval/acquisition-member]
  [:seon.sci.eval/acquisition-observation
   :seon.sci.eval/acquisition-observation]]]

 :seon.sci.eval/acquisition-member
 [:or :qualified-symbol :qualified-keyword]

 :seon.sci.eval/acquisition-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.sci.eval/evaluation-error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
