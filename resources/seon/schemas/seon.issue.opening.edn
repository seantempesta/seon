{:seon.issue.opening/view
 [:map {:description "One issue's opening as its worker's AI face shows it: what decides done, what its dialled candidate adds, and the reads offered."}
  [:seon.issue/id :seon.issue/id]
  [:seon.issue/title {:optional true} :seon.issue/title]
  [:seon.issue.opening/done-when-tests {:optional true} [:map-of :seon.test/sym [:enum :pass :fail :error :unrun]]]
  [:seon.issue.opening/detector {:optional true} [:maybe :qualified-symbol]]
  [:seon.issue.opening/candidate {:optional true} :seon.config.render/issue-opening]
  [:seon.issue.opening/first-test {:optional true} :map]
  [:seon.issue/tests {:optional true} [:vector :map]]
  [:seon.issue/functions {:optional true} [:vector :map]]
  [:seon.issue.opening/problem-lines {:optional true} [:vector :string]]
  [:seon.ns/names {:optional true} [:vector :symbol]]
  [:seon.render/operations :seon.render/operations]]}
