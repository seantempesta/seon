{:my.edit/path :my.fs/path
 :my.edit/expected-digest :my.fs/digest
 :my.edit/form :my.edit.form/selector
 :my.edit/operation [:enum :replace :insert-before :insert-after :delete]
 :my.edit/source :string
 :my.edit/form-request
 [:and
  [:map
   [:my.edit/path :my.edit/path]
   [:my.edit/expected-digest :my.edit/expected-digest]
   [:my.edit/form :my.edit/form]
   [:my.edit/operation :my.edit/operation]
   [:my.edit/source {:optional true} :my.edit/source]]
  [:fn {:error/message
        "must pair :delete with no :my.edit/source, or a replace/insert operation with one readable Clojure form in :my.edit/source"
        :gen/gen my.edit/form-request-generator}
   my.edit/valid-form-operation?]]
 :my.edit/old-string [:string {:min 1}]
 :my.edit/new-string :string
 :my.edit/replace-all? :boolean
 :my.edit/exact-request
 [:map
  [:my.edit/path :my.edit/path]
  [:my.edit/expected-digest :my.edit/expected-digest]
  [:my.edit/old-string :my.edit/old-string]
  [:my.edit/new-string :my.edit/new-string]
  [:my.edit/replace-all? {:optional true} :my.edit/replace-all?]]
 :my.edit/from-line [:int {:min 1}]
 :my.edit/to-line [:int {:min 1}]
 :my.edit/old-window :string
 :my.edit/new-window :string
 :my.edit/actual-window :my.edit/source-window
 :my.edit/lines-request
 [:map
  [:my.edit/path :my.edit/path]
  [:my.edit/expected-digest :my.edit/expected-digest]
  [:my.edit/from-line :my.edit/from-line]
  [:my.edit/to-line :my.edit/to-line]
  [:my.edit/old-window :my.edit/old-window]
  [:my.edit/new-window :my.edit/new-window]]
 :my.edit/changed? :boolean
 :my.edit/before-digest :my.fs/digest
 :my.edit/after-digest :my.fs/digest
 :my.edit/before-bytes :my.fs/byte-count
 :my.edit/after-bytes :my.fs/byte-count
 :my.edit/source-window :string
 :my.edit/source-window-complete? :boolean
 :my.edit/replacements [:int {:min 0}]
 :my.edit/result
 [:map
  [:my.edit/path :my.edit/path]
  [:my.edit/changed? :my.edit/changed?]
  [:my.edit/before-digest :my.edit/before-digest]
  [:my.edit/after-digest :my.edit/after-digest]
  [:my.edit/before-bytes :my.edit/before-bytes]
  [:my.edit/after-bytes :my.edit/after-bytes]
  [:my.edit/from-line :my.edit/from-line]
  [:my.edit/to-line :my.edit/to-line]
  [:my.edit/source-window :my.edit/source-window]
  [:my.edit/source-window-complete? :my.edit/source-window-complete?]
  [:my.edit/replacements {:optional true} :my.edit/replacements]],
 :my.edit/no-match :my.edit/path
 :my.edit/no-match-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path with no matching edit target"} [:my.edit/no-match :my.edit/no-match] [:seon.error/message :seon.error/message]]
 :my.edit/ambiguous-match :my.edit/path
 :my.edit/ambiguous-match-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path with ambiguous edit targets"} [:my.edit/ambiguous-match :my.edit/ambiguous-match] [:seon.error/message :seon.error/message]]
 :my.edit/parse-refused [:= true]
 :my.edit/parse-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark edited source refused by the Clojure reader"} [:my.edit/parse-refused :my.edit/parse-refused] [:seon.error/message :seon.error/message]]
 :my.edit/lossless-check-failed [:= true]
 :my.edit/lossless-check-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark edited source that failed the lossless check"} [:my.edit/lossless-check-failed :my.edit/lossless-check-failed] [:seon.error/message :seon.error/message]]
 :my.edit/stale-source :my.edit/path
 :my.edit/stale-source-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose source is stale"} [:my.edit/stale-source :my.edit/stale-source] [:seon.error/message :seon.error/message]]
 :my.edit/not-utf8 :my.edit/path
 :my.edit/not-utf8-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose source is not strict UTF-8"} [:my.edit/not-utf8 :my.edit/not-utf8] [:seon.error/message :seon.error/message]]}
