#:seon.chain
{:branch [:and {:seon.wake/starts true :description "The branch holding a chain's tasks and attempts: forked from main by seon.task/chain!, merged into main once at the chain's end. Counted by seon.cluster.registry/cluster-claims, so boot's retirement keeps it and its base."} :seon.store/branch]
 :first [:and {:seon.db/identity true :seon.program/row-schema :seon.chain/chain
               :description "The chain's first task, by its :seon.task/id: the chain's identity, since only the first task supplies a chain's name."}
         :seon.task/handle]
 :from [:and {:description "The branch whose head a new chain forks from instead of main's (seon.task/chain!): it selects only the starting head; the chain's base and merge target stay main."} :seon.store/branch]
 :merge? [:boolean {:description "Whether root merges the chain branch to main when its last task is done (seon.task/chain!, default true). False ends the chain at that done with its branch kept for reading: no merge request, no publication (a bench run is CI on a branch that is never merged). Written on the chain fact only when decided."}]
 :config [:map-of {:description "A chain's own config decisions as seon.task/chain! takes them: dial to value, or seon.config/absent to decide it absent, over main's effective config. Only the dials of :seon.task/desired-config are a chain's; the runnable view refuses any other."}
          :qualified-keyword :seon.schema/value]
 :chain [:map {:seon.db/attributes true :seon.program/partition :seon.data
               :description "The chain fact on main, one per chain: discovery, not status. Root finds every chain through it and reads the chain's state on its branch."}
         [:seon.chain/first :seon.chain/first]
         [:seon.chain/branch :seon.chain/branch]
         [:seon.chain/merge? {:optional true} :seon.chain/merge?]]
 :state [:enum {:description "A chain's state from its tasks (seon.task/chain-views): unread when its branch and main hold no task, done when the last task's latest attempt finished, ended when main no longer holds its chain fact otherwise (root abandoned it), bailed when a task's latest attempt was closed by root or ended without finishing, else running."}
         :running :bailed :done :unread :ended]
 :kind [:enum {:description "A chain task's kind from its :seon.task/step: Prove, Implement, else Design."} :design :prove :implement]
 :attempt-view [:map {:seon.render/html seon.task/attempt-html
                      :description "One attempt of a chain task: main's row (number, outcome, reasons, what its merge made) overlaid by the branch's (the agent's end), the agent named by id with its end summary. Producer: seon.task/chain-views."}
                [:seon.task/assignment :seon.task/assignment]
                [:seon.task.attempt/number {:optional true} :seon.task.attempt/number]
                [:seon.task.attempt/end {:optional true} :seon.task.attempt/end]
                [:seon.task.attempt/reason {:optional true} :seon.task.attempt/reason]
                [:seon.task/outcome {:optional true} :seon.task/outcome]
                [:seon.task/reason {:optional true} :seon.task/reason]
                [:seon.agent/id {:optional true} :seon.agent/id]
                [:seon.agent/end-calls {:optional true} :seon.agent/end-calls]
                [:seon.agent/end-prompt-tokens {:optional true} :seon.agent/end-prompt-tokens]
                [:seon.agent/end-completion-tokens {:optional true} :seon.agent/end-completion-tokens]
                [:seon.task/branch {:optional true} :seon.task/branch]
                [:seon.source/commit-id {:optional true} :seon.source/commit-id]
                [:seon.task/merged-declarations {:optional true} :seon.task/merged-declarations]
                [:seon.task/git-commit {:optional true} :seon.task/git-commit]]
 :attempts [:vector :seon.chain/attempt-view]
 :task-view [:map {:seon.render/html seon.task/chain-task-html
                   :description "One task of a chain in the chains page: its name, kind and execution, and its attempts in order. Producer: seon.task/chain-views."}
             [:seon.task/id :seon.task/id]
             [:seon.task/ns :seon.task/ns]
             [:seon.task/name :seon.task/name]
             [:seon.chain/kind :seon.chain/kind]
             [:seon.task/execution {:optional true} :seon.task/execution]
             [:seon.chain/attempts :seon.chain/attempts]]
 :tasks [:vector :seon.chain/task-view]
 :view [:map {:seon.render/html seon.task/chain-html
              :description "A chain as the chains page shows it: its branch, first task, state and its tasks in :seon.task/next order. Producer: seon.task/chain-views; consumer: seon.render.web's /chains page."}
        [:seon.chain/branch :seon.chain/branch]
        [:seon.chain/first :seon.chain/first]
        [:seon.chain/state :seon.chain/state]
        [:seon.chain/tasks :seon.chain/tasks]]}
