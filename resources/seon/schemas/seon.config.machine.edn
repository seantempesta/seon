;; The machine Seon targets (owner, 2026-10-22: a 16 GB MacBook M1).
{:seon.config.machine/memory-mb [:int {:min 256 :seon.config/unit "MB" :description "The memory Seon itself may use on the machine it targets; seon.check/scale fails past it."}]
 :seon.config.machine/relay-mb [:int {:min 1 :seon.config/unit "MB" :description "The most physical footprint one MCP relay (bin/mcp) may reach; seon.check/mcp-proof fails past it."}]
 :seon.config.machine/cores [:int {:min 1 :seon.config/unit "cores" :description "The machine's core count, read when the config is read (#seon/cores, docs/config.md#the-file), never shipped as a literal: what a share of :seon.config.proofs/max-cores is a share of. config/local.edn may set it, to admit as a machine of that many cores would (the 8-core target's admission on this machine)."}]}
