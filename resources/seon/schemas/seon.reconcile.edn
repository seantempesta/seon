#:seon.reconcile{:adopt-identities [:set [:tuple :qualified-keyword :seon.schema/value]],
                 :retain-identities [:set {:description "Identities the reconciliation never manages, whatever process first wrote them: the caller derives them from facts (another cluster's required reference to them)."} [:tuple :qualified-keyword :seon.schema/value]],
                 :converged? :boolean,
                 :desired [:vector [:map]],
                 :operations [:int {:min 0}],
                 :dropped-datoms
                 [:int {:min 1
                        :description "Current datoms a schema change dropped with the replaced or retired attributes that carried them; absent when nothing was dropped."}],
                 :process [:string {:min 1}],
                 :request
                 [:map
                  [:seon.db/writer {:optional true :description "Writes the reconcile transaction; seon.db/transact! when absent."} :seon.db/writer]
                  [:seon.reconcile/desired :seon.reconcile/desired]
                  [:seon.reconcile/process :seon.reconcile/process]
                  [:seon.reconcile/adopt-identities
                   {:optional true}
                   :seon.reconcile/adopt-identities]
                  [:seon.reconcile/retain-identities
                   {:optional true}
                   :seon.reconcile/retain-identities]],
                 :result
                 [:or
                  [:map
                   [:seon.reconcile/converged?
                    :seon.reconcile/converged?]
                   [:seon.reconcile/operations
                    :seon.reconcile/operations]
                   [:seon.reconcile/dropped-datoms {:optional true}
                    :seon.reconcile/dropped-datoms]]
                  :seon.error/value],
                 :rule :keyword,
                 :refused :seon.reconcile/rule
                 :no-identity [:= true]
                 :two-identities [:= true]
                 :duplicate-identity [:= true]
                 :identity-outside-scope [:= true]
 :seon.reconcile/missing-declarations [:= true]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.reconcile/constraint-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.reconcile/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.reconcile/requested-identity
   :seon.reconcile/requested-identity]
  [:seon.reconcile/constraint-observation
   :seon.reconcile/constraint-observation]]]

 :seon.reconcile/requested-identity
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]
}
