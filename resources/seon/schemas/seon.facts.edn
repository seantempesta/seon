;; The program facts seon.db writes (lane D1's proto.db.facts.edn) (namespaces, vars, the example task and note) and the
;; recording transaction of each eval request, as entity schemas. Stored shapes; the Datahike
;; schema is derived from them (seon.schema.datahike/declarations).
{;; ---- the program, as the compiler knows it (seon.program; inv4's design) ----
 ;; A FORM is the unit of reproduction: main evaluates forms, write-back writes them. Each
 ;; definition (var, multimethod method, protocol extension, namespace) points to the form
 ;; that last made it; what a form defines, declares and references comes from Jolt's
 ;; analyzer (jolt.analyzer/*unit-tap*, or analysis-only for a file), never from text.
 :form/id [:and {:seon.db/identity true} :string]
 ;; the exact text as written, and the whitespace and comments before it in its file
 :form/src :string
 :form/lead :string
 :form/ns [:and {:seon.db/index true} :seon.db/ref]
 ;; its place among its namespace's forms (a file's order; a new form after all others)
 :form/order :int
 :form/defines [:set :seon.db/ref]
 :form/declares [:set :seon.db/ref]
 ;; the vars it references, resolved by the compiler (clojure.core's left out): callers are
 ;; one AVET seek
 :form/refs [:set {:seon.db/index true} :qualified-symbol]
 ;; the namespaces its require/use calls name
 :form/requires [:set :symbol]
 ;; references to clojure.core/intern, alter-var-root, eval, load-string, and definitions
 ;; inside a function body: judged at merge (every definition happens once)
 :form/banned [:set :qualified-symbol]
 :form/inline-defs [:set :qualified-symbol]
 :ns/name [:and {:seon.db/identity true} :symbol]
 :ns/doc :string
 :ns/form :seon.db/ref
 ;; the file it was imported from, relative to the source tree's root (seon.source)
 :ns/file :string
 ;; the text after its file's last form
 :ns/tail :string
 :var/name [:and {:seon.db/identity true} :symbol]
 :var/ns :seon.db/ref
 :var/form :seon.db/ref
 :var/doc :string
 :var/arity :int
 ;; what a defined var holds (:fn :test :macro :value :multi :protocol :protocol-fn :type
 ;; :ctor) and its declared contract, as text
 :var/kind :keyword
 :var/contract :string
 :method/key [:and {:seon.db/identity true} :string]
 :method/multi :qualified-symbol
 :method/dispatch :string
 :method/form :seon.db/ref
 :impl/key [:and {:seon.db/identity true} :string]
 :impl/protocol :qualified-symbol
 :impl/type :string
 :impl/form :seon.db/ref
 :seon.db/form-fact [:map {:seon.db/attributes true}
                      [:form/id :form/id] [:form/src :form/src] [:form/ns :form/ns] [:form/order :form/order]
                      [:form/lead {:optional true} :form/lead] [:form/defines {:optional true} :form/defines]
                      [:form/declares {:optional true} :form/declares] [:form/refs {:optional true} :form/refs]
                      [:form/requires {:optional true} :form/requires] [:form/banned {:optional true} :form/banned]
                      [:form/inline-defs {:optional true} :form/inline-defs]]
 :seon.db/ns-fact [:map {:seon.db/attributes true} [:ns/name :ns/name] [:ns/doc {:optional true} :ns/doc]
                    [:ns/form {:optional true} :ns/form] [:ns/file {:optional true} :ns/file] [:ns/tail {:optional true} :ns/tail]]
 :seon.db/var-fact [:map {:seon.db/attributes true}
                     [:var/name :var/name] [:var/ns {:optional true} :var/ns] [:var/form {:optional true} :var/form]
                     [:var/doc {:optional true} :var/doc] [:var/arity {:optional true} :var/arity]
                     [:var/kind {:optional true} :var/kind] [:var/contract {:optional true} :var/contract]]
 :seon.db/method-fact [:map {:seon.db/attributes true}
                        [:method/key :method/key] [:method/multi :method/multi] [:method/dispatch :method/dispatch]
                        [:method/form {:optional true} :method/form]]
 :seon.db/impl-fact [:map {:seon.db/attributes true}
                      [:impl/key :impl/key] [:impl/protocol :impl/protocol] [:impl/type :impl/type]
                      [:impl/form {:optional true} :impl/form]]
 ;; ---- the example program's task and note ----
 :task/name [:and {:seon.db/identity true} :keyword]
 :task/plan :string
 :task/status [:and {:seon.db/index true} :keyword]
 :task/refs [:set :seon.db/ref]
 :task/agent :keyword
 :note/text :string
 :note/agent [:and {:seon.db/index true} :keyword]
 :note/about :seon.db/ref
 :seon.db/example-task-fact [:map {:seon.db/attributes true}
                              [:task/name :task/name] [:task/plan :task/plan] [:task/status :task/status]
                              [:task/refs {:optional true} :task/refs] [:task/agent {:optional true} :task/agent]]
 :seon.db/note-fact [:map {:seon.db/attributes true}
                      [:note/text :note/text] [:note/agent :note/agent] [:note/about {:optional true} :note/about]]
 ;; ---- the recording transaction of each eval request, and the agent's answered t.
 ;; Observations: data on the branch that recorded them, never carried by a merge ----
 :seon.cluster.eval/id :string
 :seon.cluster.eval/agent :seon.db/ref
 ;; the evaluation's details as one EDN value: {:tag :form :shown|:error :out :ms :alloc-bytes :fns}
 ;; (:fns: its 10 costliest contracted functions, [{:var :calls :ms}], seon.profile)
 :seon.cluster.eval/record [:map {:seon.db/edn true :seon.render/html seon.render.ui/history-row} [:tag [:enum :ret :err]]]
 :seon.agent/id [:and {:seon.db/identity true} :keyword]
 :seon.agent/answered-t :int
 :seon.db/eval-fact [:map {:seon.db/attributes true}
                     [:seon.cluster.eval/id :seon.cluster.eval/id] [:seon.cluster.eval/agent :seon.cluster.eval/agent]
                     [:seon.cluster.eval/record :seon.cluster.eval/record]]
 :seon.db/agent-fact [:map {:seon.db/attributes true}
                       [:seon.agent/id :seon.agent/id] [:seon.agent/answered-t {:optional true} :seon.agent/answered-t]]
 ;; ---- tasks, attempts, proof results, root's boot, turns and ends (lane D1's proto.agents.facts.edn) ----
;; ---- the task ----
 :seon.task/id [:and {:seon.db/identity true} :string]
 :seon.task/ns :symbol
 :seon.task/name :string
 :seon.task/plan :string
 :seon.task/instructions :string
 :seon.task/proofs [:set :qualified-symbol]
 :seon.task/needs [:set :seon.db/ref]
 :seon.task/branch :keyword
 :seon.task/model :string
 :seon.task/execution [:and {:seon.db/index true} [:enum :held :running :cancelled]]
 :seon.task/problem :string
 :seon.task/kind [:enum :work :design :implement :test :merge]
 ;; measured evidence a task starts from: a failed attempt's conflicts, red proofs and problem
 :seon.task/evidence [:map {:seon.db/edn true}
                      [:from :seon.attempt/id] [:conflicts [:vector :seon.merge/conflict]]
                      [:unmerged [:vector :string]] [:red [:vector :qualified-symbol]]
                      ;; why the attempt failed: its refusals or its death, as the reconciler stated it
                      [:problem {:optional true} :string]]
 :seon.task/generation :int
 ;; the refinement chains a task's failures may attach (generations; :seon.reconcile/default-budget
 ;; when absent); replaces :seon.config.merge/max-attach
 :seon.task/budget [:int {:min 0}]
 ;; derived by the reconciler when a failure finds the budget spent: the attempt, the root cause
 ;; and the tasks it blocks (the task stays released; it is not ready while this holds)
 :seon.task/stuck [:map {:seon.db/edn true} [:attempt :seon.attempt/id] [:cause :string] [:blocks [:vector :seon.task/id]]]
 ;; the declaration a task file last stated for this task (seon.task/load-tx), as EDN
 :seon.task/declared :string
 ;; config dials are attributes of the task, by their own names
 :seon.config.agent/max-turns [:int {:min 1}]
 :seon.config.merge/max-conflicts :int
 :seon.config.merge/max-merge-turns :int
 :seon.task/task-fact [:map {:seon.db/attributes true}
                          [:seon.task/id :seon.task/id] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
                          [:seon.task/plan :seon.task/plan] [:seon.task/execution :seon.task/execution]
                          [:seon.task/branch :seon.task/branch] [:seon.task/kind :seon.task/kind]
                          [:seon.task/proofs {:optional true} :seon.task/proofs] [:seon.task/needs {:optional true} :seon.task/needs]
                          [:seon.task/instructions {:optional true} :seon.task/instructions]
                          [:seon.task/model {:optional true} :seon.task/model] [:seon.task/problem {:optional true} :seon.task/problem]
                          [:seon.task/evidence {:optional true} :seon.task/evidence]
                          [:seon.task/generation {:optional true} :seon.task/generation]
                          [:seon.task/budget {:optional true} :seon.task/budget] [:seon.task/stuck {:optional true} :seon.task/stuck]
                          [:seon.task/declared {:optional true} :seon.task/declared]
                          [:seon.config.agent/max-turns {:optional true} :seon.config.agent/max-turns]
                          [:seon.config.merge/max-conflicts {:optional true} :seon.config.merge/max-conflicts]
                          [:seon.config.merge/max-merge-turns {:optional true} :seon.config.merge/max-merge-turns]]
 ;; ---- the attempt and its proof results (observed by root) ----
 :seon.attempt/id [:and {:seon.db/identity true} :string]
 :seon.attempt/task [:and {:seon.db/index true} :seon.db/ref]
 :seon.attempt/status [:and {:seon.db/index true} [:enum :running :ended :killed :dead :lost :done :merged :behind :bailed :closed]]
 :seon.attempt/boot :string
 :seon.attempt/agent :keyword
 :seon.attempt/pid :int
 :seon.attempt/start-ms :int
 :seon.attempt/end-ms :int
 :seon.attempt/branch :keyword
 :seon.attempt/model :string
 :seon.attempt/max-turns :int
 :seon.attempt/outcome [:enum :green :red :waiting :cap :sent-back :merge-failed :error]
 :seon.attempt/reason :string
 :seon.attempt/turns :int
 :seon.attempt/model-calls :int
 :seon.attempt/tokens :int
 :seon.attempt/merged-t :int
 :seon.attempt/basis-t :int
 :seon.attempt/uncontracted [:set :qualified-symbol]
 :seon.proof/test :qualified-symbol
 :seon.proof/status [:enum :pass :fail :error :none]
 ;; one entity per test, owned by the attempt
 :seon.attempt/results [:set {:seon.db/component true} :seon.db/ref]
 ;; measured at the attempt's end from the branch: its merge entries (:seon.merge/*) and the keys still unmerged
 :seon.attempt/conflicts [:set {:seon.db/component true} :seon.db/ref]
 :seon.attempt/unmerged [:set :string]
 ;; measured at the attempt's end from the branch (seon.merge/three-way's :ours): the printed
 ;; program keys the branch changed since its merge base; the merge train admits on them
 :seon.attempt/changed [:set :string]
 :seon.attempt/attempt-fact [:map {:seon.db/attributes true}
                             [:seon.attempt/id :seon.attempt/id] [:seon.attempt/task :seon.attempt/task]
                             [:seon.attempt/status :seon.attempt/status] [:seon.attempt/boot :seon.attempt/boot]
                             [:seon.attempt/agent :seon.attempt/agent] [:seon.attempt/start-ms :seon.attempt/start-ms]
                             [:seon.attempt/pid {:optional true} :seon.attempt/pid] [:seon.attempt/end-ms {:optional true} :seon.attempt/end-ms]
                             [:seon.attempt/branch {:optional true} :seon.attempt/branch] [:seon.attempt/model {:optional true} :seon.attempt/model]
                             [:seon.attempt/max-turns {:optional true} :seon.attempt/max-turns]
                             [:seon.attempt/outcome {:optional true} :seon.attempt/outcome] [:seon.attempt/reason {:optional true} :seon.attempt/reason]
                             [:seon.attempt/turns {:optional true} :seon.attempt/turns] [:seon.attempt/model-calls {:optional true} :seon.attempt/model-calls]
                             [:seon.attempt/tokens {:optional true} :seon.attempt/tokens] [:seon.attempt/merged-t {:optional true} :seon.attempt/merged-t]
                             [:seon.attempt/basis-t {:optional true} :seon.attempt/basis-t]
                             [:seon.attempt/uncontracted {:optional true} :seon.attempt/uncontracted]
                             [:seon.attempt/results {:optional true} :seon.attempt/results]
                             [:seon.attempt/conflicts {:optional true} :seon.attempt/conflicts]
                             [:seon.attempt/unmerged {:optional true} :seon.attempt/unmerged]
                             [:seon.attempt/changed {:optional true} :seon.attempt/changed]]
 :seon.proof/proof-fact [:map {:seon.db/attributes true} [:seon.proof/test :seon.proof/test] [:seon.proof/status :seon.proof/status]]
 ;; ---- root's boot and dials (main) ----
 :seon.root/id [:and {:seon.db/identity true} :keyword]
 :seon.root/boot :string
 :seon.config.agent/max-running :int
 :seon.config.merge/max-running :int
 ;; the reconciler's positive report of quiescence: at main's t nothing runs, nothing is to
 ;; judge, nothing is ready; :stuck names each released task not done, with its root cause and
 ;; what it blocks (seon.reconcile/stuck)
 :seon.root/quiescent [:map {:seon.db/edn true} [:t :int] [:stuck [:vector :seon.reconcile/stuck-row]]]
 :seon.root/root-fact [:map {:seon.db/attributes true}
                          [:seon.root/id :seon.root/id] [:seon.root/boot :seon.root/boot]
                          [:seon.root/quiescent {:optional true} :seon.root/quiescent]
                          [:seon.config.agent/max-running {:optional true} :seon.config.agent/max-running]
                          [:seon.config.merge/max-running {:optional true} :seon.config.merge/max-running]]
 ;; ---- written by an agent on its own branch; they reach main with its merge ----
 :seon.turn/id [:and {:seon.db/identity true} :string]
 :seon.turn/attempt [:and {:seon.db/index true} :string]
 :seon.turn/n :int
 :seon.turn/reply :string
 :seon.turn/forms :int
 :seon.turn/errors :int
 :seon.turn/red :int
 :seon.turn/ms :int
 :seon.turn/tokens :int
 ;; the model's reply stopped at max-tokens: its text was cut
 :seon.turn/truncated :boolean
 :seon.end/attempt [:and {:seon.db/identity true} :string]
 :seon.end/outcome :keyword
 :seon.end/reason :string
 :seon.end/turns :int
 :seon.end/tokens :int
 :seon.turn/turn-fact [:map {:seon.db/attributes true}
                          [:seon.turn/id :seon.turn/id] [:seon.turn/attempt :seon.turn/attempt] [:seon.turn/n :seon.turn/n]
                          [:seon.turn/reply :seon.turn/reply] [:seon.turn/forms :seon.turn/forms] [:seon.turn/errors :seon.turn/errors]
                          [:seon.turn/red :seon.turn/red] [:seon.turn/ms :seon.turn/ms] [:seon.turn/tokens :seon.turn/tokens]
                          [:seon.turn/truncated {:optional true} :seon.turn/truncated]]
 :seon.end/end-fact [:map {:seon.db/attributes true}
                         [:seon.end/attempt :seon.end/attempt] [:seon.end/outcome :seon.end/outcome]
                         [:seon.end/reason {:optional true} :seon.end/reason]
                         [:seon.end/turns {:optional true} :seon.end/turns] [:seon.end/tokens {:optional true} :seon.end/tokens]]
 ;; ---- an effect's outcome, recorded by its asker on its own branch (seon.fx, lane FX1) ----
 :seon.fx/id [:and {:seon.db/identity true} :string]
 :seon.fx/kind :keyword
 :seon.fx/status :keyword
 :seon.fx/us :int
 :seon.fx/queue-us :int
 :seon.fx/cost :int
 :seon.fx/error :string
 :seon.fx/fx-fact [:map {:seon.db/attributes true}
                     [:seon.fx/id :seon.fx/id] [:seon.fx/kind :seon.fx/kind] [:seon.fx/status :seon.fx/status]
                     [:seon.fx/us :seon.fx/us] [:seon.fx/queue-us :seon.fx/queue-us]
                     [:seon.fx/cost {:optional true} :seon.fx/cost] [:seon.fx/error {:optional true} :seon.fx/error]]
 ;; ---- the program merge's facts (lane D1's proto.merge.facts.edn) ----
 :seon.merge/key [:any {:seon.db/index true :seon.db/edn true}]
 :seon.merge/kind :keyword
 :seon.merge/base [:any {:seon.db/edn true}]
 :seon.merge/ours [:any {:seon.db/edn true}]
 :seon.merge/theirs [:any {:seon.db/edn true}]
 :seon.merge/main-t :int
 :seon.merge/resolved? :boolean
 :seon.merge/entry-fact [:map {:seon.db/attributes true}
                          [:seon.merge/key :seon.merge/key] [:seon.merge/kind :seon.merge/kind]
                          [:seon.merge/base {:optional true} :seon.merge/base] [:seon.merge/ours {:optional true} :seon.merge/ours]
                          [:seon.merge/theirs {:optional true} :seon.merge/theirs]
                          [:seon.merge/main-t {:optional true} :seon.merge/main-t] [:seon.merge/resolved? {:optional true} :seon.merge/resolved?]]}
