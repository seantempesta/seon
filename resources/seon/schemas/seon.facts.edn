 ;; record while the entity stays, so a swap! can bring it back (docs/data-modeling.md#a-schema-is-a-set-of-keys-written-together:
 ;; a membership ref is never required); each still means something alone: the code that ran, what was cited, the query, the process
 :seon.db/eval-fact [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/evaluation :seon.render/openai-compat seon.ctx.wire/eval-msgs}
                     [:seon.eval/id :seon.eval/id] [:seon.eval/agent {:optional true} :seon.eval/agent] [:seon.eval/by {:optional true} :seon.eval/by]
                     [:seon.eval/code :seon.eval/code] [:seon.eval/intent {:optional true} :seon.eval/intent]
                     [:seon.eval/call-id {:optional true} :seon.eval/call-id]
                     [:seon.eval/schema {:optional true} :seon.eval/schema] [:seon.eval/basis {:optional true} :seon.eval/basis]
                     [:seon.eval/fns {:optional true} :seon.eval/fns] [:seon.eval/call {:optional true} :seon.eval/call]
                     [:seon.eval/response :seon.eval/response] [:seon.eval/result {:optional true} :seon.eval/result] [:seon.eval/opened {:optional true} :seon.eval/opened]]
 ;; an entity's record (seon.ctx, :seon.ctx/pattern: Datahike's pull syntax as data, docs/ctx.md#the-pattern;
 ;; its joins are the page walk's units, seon.render/units), each member rendered by its own schema's render
 :seon.db/agent-fact [:map {:seon.db/attributes true :seon.ctx/required {:seon.agent/task "the task you work" :seon.message/_to "the messages sent to you" :seon.eval/_agent "your evals" :seon.model-call/_agent "your turns"} :seon.render/keys [:seon.agent/key :seon.agent/status :seon.agent/branch :seon.agent/description] :seon.ctx/pattern [:seon.agent/key
                               :seon.user/name
                               :seon.render/hiccup
                               :seon.agent/branch
                               :seon.agent/status
                               :seon.agent/description
                               :seon.agent/max-turns
                               :seon.agent/turn
                               :seon.agent/test-error
                               :seon.agent/outcome
                               :seon.agent/reason
                               :seon.agent/ended-turn
                               :seon.ctx/pattern
                               :seon.agent/main-commit
                               :seon.agent/main-program
                               :seon.agent/base-commit
                               :seon.agent/ns
                               {:seon.agent/agents [:seon.agent/key :seon.agent/status :seon.agent/branch :seon.agent/turn :seon.agent/outcome :seon.agent/ended-turn :seon.agent/started-ms {:seon.agent/task [:seon.task/id :seon.task/plan :seon.task/outcome :seon.task/reason {:seon.task/started-by [:seon.user/name]}]} {:seon.agent/agents [:db/id]}]}
                               {:seon.agent/task :seon.task/task-fact}
                               {:seon.agent/system [:db/id]}
                               {[:seon.model-call/_agent :tx :at] [:seon.model-call/id :seon.model-call/n :seon.model-call/origin :seon.model-call/reply :seon.model-call/reasoning :seon.model-call/truncated :seon.model-call/error :seon.model-call/forms :seon.model-call/basis {:seon.eval/_call [:db/id :seon.eval/call-id :seon.eval/agent]}]}
                               {[:seon.eval/_agent :tx :at] [:seon.eval/id :seon.eval/agent {:seon.eval/by [:db/id :seon.agent/key :seon.root/id]} :seon.eval/code :seon.eval/intent :seon.eval/call-id :seon.eval/schema :seon.eval/basis :seon.eval/fns :seon.eval/call :seon.eval/response :seon.eval/result :seon.eval/opened]}
                               {[:seon.message/_to :tx :at] [:seon.message/id {:seon.message/from [:seon.agent/key :seon.user/name :seon.root/id]} :seon.message/to :seon.message/body]}
                               {:seon.cite/_of :seon.cite/cite-fact}
                               {:seon.search/_of :seon.search/search-fact}] :seon.render/hiccup seon.render.ui/agent :seon.render/openai-compat seon.ctx.wire/agent-msgs}
                       [:seon.agent/key :seon.agent/key] [:seon.agent/agents {:optional true} :seon.agent/agents] [:seon.agent/system {:optional true} :seon.agent/system]
                       [:seon.agent/root {:optional true} :seon.agent/root] [:seon.agent/branch {:optional true} :seon.agent/branch]
                       [:seon.agent/status {:optional true} :seon.agent/status]
                       [:seon.agent/description {:optional true} :seon.agent/description]
                       [:seon.agent/task {:optional true} :seon.agent/task] [:seon.agent/max-turns {:optional true} :seon.agent/max-turns] [:seon.agent/turn {:optional true} :seon.agent/turn]
                       [:seon.agent/model {:optional true} :seon.agent/model] [:seon.agent/holder {:optional true} :seon.agent/holder]
                       [:seon.agent/ended-ms {:optional true} :seon.agent/ended-ms]
                       [:seon.agent/test-error {:optional true} :seon.agent/test-error]
                       [:seon.agent/outcome {:optional true} :seon.agent/outcome] [:seon.agent/reason {:optional true} :seon.agent/reason]
                       [:seon.agent/ended-turn {:optional true} :seon.agent/ended-turn]
                       [:seon.agent/error {:optional true} :seon.agent/error] [:seon.agent/waste {:optional true} :seon.agent/waste]
                       [:seon.ctx/pattern {:optional true} :seon.ctx/pattern] [:seon.render/hiccup {:optional true} :seon.render/hiccup] [:seon.agent/opened {:optional true} :seon.agent/opened]
                       [:seon.agent/main-commit {:optional true} :seon.agent/main-commit] [:seon.agent/main-program {:optional true} :seon.agent/main-program] [:seon.agent/base-commit {:optional true} :seon.agent/base-commit]
                       [:seon.agent/ns {:optional true} :seon.agent/ns]]
 ;; a user: an agent with a person's name (docs/users.md#what-each-thing-is), its own schema by extending the agent's, so its
 ;; layout is its own and an entity holding both identities is a user whatever its keys' order (seon.render/entity-schema)
 ;; a started agent: an agent (it extends :seon.db/agent-fact, as a user does) with the boot of the root that started it and
 ;; when, both written by every start (seon.task/start-tx, seon.root's own spawn). Its branch comes only with a task and its
 ;; turn budget it also writes alone on its own branch (seon.turn), so they stay the agent's, optional
 :seon.db/agent-start-fact [:and {:seon.db/attributes true :description "An agent a root started: the boot of that root, and when."}
                            :seon.db/agent-fact [:map [:seon.agent/boot :seon.agent/boot] [:seon.agent/started-ms :seon.agent/started-ms]]]
 ;; the agent whose page the person last opened: home is this page (docs/users.md#whats-on-screen); absent means root
 ;; or a task: an agent focuses the person on work it just launched (my.task/launch! answers the task), its agent made a moment later
 :seon.user/focus [:and {:seon.db/to [:seon.db/agent-fact :seon.task/task-fact]} :seon.db/ref]
