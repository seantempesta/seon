 :seon.cite/cite-fact [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/cite
                             ;; what it names, by identity alone: its render reads the rest from the db (:seon.cite/of-read, :seon.cite/target-read)
                             :seon.ctx/pattern [:seon.cite/id :seon.cite/depth :seon.cite/order
                                                {:seon.cite/of [:seon.task/id :seon.task/ns :seon.agent/key]}
                                                ;; a cited task also by what an agent may edit of it at this path: the task content a run's end
                                                ;; carries to main (seon.task/carry-tx), so a task that curates another reads and writes its plan here
                                                {:seon.cite/target [:seon.doc/address :var/name :schema/key :ns/name :file/path
                                                                    :seon.task/id :seon.task/plan :seon.task/instructions :seon.task/proofs :seon.task/cause]}]}
                       [:seon.cite/id :seon.cite/id] [:seon.cite/of {:optional true} :seon.cite/of] [:seon.cite/target :seon.cite/target]
                       [:seon.cite/depth :seon.cite/depth] [:seon.cite/order :seon.cite/order]]
 ;; ---- tasks, runs, proof results, root's boot, turns and ends (session D1's proto.agents.facts.edn) ----
;; ---- the task ----
 :seon.task/id [:and {:seon.db/identity true :description "The task's identity."} :string]
 :seon.task/ns [:symbol {:description "The namespace the task's code lives in; its agent's REPL starts there."}]
 :seon.task/name [:string {:description "The task's name within its namespace."}]
 :seon.task/plan :seon.db/text
 :seon.task/instructions :seon.db/text
 :seon.task/proofs [:set {:description "The tests that say this task is done. A proof is a clojure.test deftest in the test namespace of what it proves, built on a small test world, never the live db: (my.test/world). Register one with (my.task/update! :seon.task/proofs conj (quote ns-test/name)). (prove) runs your proofs and every test your change reaches, and records the verdicts; clojure.test/run-test-var records nothing."} :qualified-symbol]
 :seon.task/needs [:set {:seon.db/to [:seon.task/task-fact] :description "The tasks that this task needs."} :seon.db/ref]
 ;; the example sessions its agent reads before its own (seon.ctx.wire/request): agents keyed "example/<id>"
 ;; (seon.ctx.session/session-tx), drawn by the renders that draw its own session
 :seon.task/examples [:set {:seon.db/to [:seon.db/agent-fact] :description "The example sessions its agent reads before its own: refs to agents keyed \"example/<id>\", finished sessions of other tasks, which the model reads as messages (seon.ctx.wire/request) and the page draws with seon.render.ui/examples. See docs/tasks.md#a-task-names-example-sessions."} :seon.db/ref]
 :seon.task/branch [:keyword {:description "The branch the task's work is on."}]
 :seon.task/model [:string {:description "The model that works the task."}]
 :seon.task/execution [:and {:seon.db/index true :description "Whether the task is held, running or cancelled."} [:enum :held :running :cancelled]]
 :seon.task/kind [:enum {:description "What kind of work the task is."} :user :work :design :implement :test :merge :whole]
 ;; measured evidence a task starts from: its last failed run's conflicts, unmerged keys, red
 ;; proofs and problem (seon.reconcile/hold-tx), read by the run root releases next
 :seon.task/evidence [:map {:description "The measured evidence the task starts from: its last failed run's conflicts, unmerged keys, red proofs and problem."}
                      [:from :seon.task/id] [:conflicts [:vector :seon.merge/conflict]]
                      [:unmerged [:vector :string]] [:red [:vector :qualified-symbol]]
