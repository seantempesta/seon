 :seon.task/cause [:map {:description "The cause of a stall task: the stall root observed, what it was, the evidence captured, whether it is a bug and the defect task filed for it."} [:stall [:map [:agent :keyword] [:task {:optional true} :seon.task/id] [:quiet-ms :int] [:pid {:optional true} [:maybe :int]]
                                 [:last-op {:optional true} [:maybe :seon.agent/last-op]]
                                 ;; the api's open asks ([rid kind agent]) and the test service's state (seon.prove/state-view) when it stalled
                                 [:api {:optional true} :map]]]
                   [:what {:optional true} :string] [:evidence {:optional true} :map]
                   [:bug? {:optional true} :boolean] [:defect {:optional true} :seon.task/id]]
 :seon.task/gone [:and {:description "What the task's text cites whose cites ended with their targets (each target's identity value), written by the write that ended them and cleared when the text is written again. See docs/references.md#task-references."} [:vector :any] :seon.db/plain]
 :seon.task/failure [:map {:description "The failure the task was held or marked failed with: its reason, counterexample, agent and turn."} [:reason :string] [:counterexample {:optional true} :string] [:agent {:optional true} :string] [:turn {:optional true} :int]]
 ;; the declaration a task file last stated for this task (seon.task/load-tx), as EDN
 :seon.task/declared [:string {:description "The declaration that a task file last stated for this task, as EDN."}]
 ;; a task may hold config keys as its overrides, by their own names; each key is defined once, by its own schema
 ;; (seon.config.agent.edn, seon.config.merge.edn), never listed here (an attribute is named by one entity schema)
 :seon.task/task-fact [:map {:seon.db/attributes true
