                                :seon.task/outcome
                                :seon.task/reason
                                :seon.task/reasons
                                :seon.task/started-by
                                {[:seon.task/proofs :by :var/name :as :proved] :seon.db/var-fact}
                                {:seon.task/needs [:seon.task/id :seon.task/ns :seon.task/plan :seon.task/execution :seon.task/kind :seon.task/instructions :seon.task/evidence :seon.task/failure :seon.task/cause :seon.task/outcome :seon.task/reason :seon.task/started-by {[:seon.task/proofs :by :var/name :as :proved] :seon.db/var-fact} {:seon.cite/_of :seon.cite/cite-fact}]}
                                {:seon.cite/_of :seon.cite/cite-fact}
                                {:seon.search/_of :seon.search/search-fact}
                                {:seon.task/examples [:seon.agent/key :seon.agent/description {:seon.eval/_agent [:seon.eval/id :seon.eval/agent {:seon.eval/by [:db/id :seon.agent/key :seon.root/id]} :seon.eval/code :seon.eval/intent :seon.eval/call-id :seon.eval/schema :seon.eval/basis :seon.eval/fns :seon.eval/call :seon.eval/response :seon.eval/result :seon.eval/opened]}]}] :seon.render/hiccup seon.render.ui/task-view}
                          [:seon.task/id :seon.task/id] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
                          [:seon.task/plan :seon.task/plan] [:seon.task/execution :seon.task/execution]
                          [:seon.task/branch :seon.task/branch] [:seon.task/kind :seon.task/kind]
                          [:seon.task/proofs {:optional true} :seon.task/proofs] [:seon.task/needs {:optional true} :seon.task/needs]
                          [:seon.task/examples {:optional true} :seon.task/examples]
                          [:seon.task/instructions {:optional true} :seon.task/instructions]
                          [:seon.task/model {:optional true} :seon.task/model]
                          [:seon.task/evidence {:optional true} :seon.task/evidence]
                          [:seon.task/failure {:optional true} :seon.task/failure] [:seon.task/gone {:optional true} :seon.task/gone]
                          [:seon.task/cause {:optional true} :seon.task/cause]
                          [:seon.task/agent {:optional true} :seon.task/agent] [:seon.task/outcome {:optional true} :seon.task/outcome]
                          [:seon.task/started-by {:optional true} :seon.task/started-by] [:seon.task/reason {:optional true} :seon.task/reason] [:seon.task/reasons {:optional true} :seon.task/reasons]
                          [:seon.task/commit {:optional true} :seon.task/commit]
                          [:seon.task/merged-t {:optional true} :seon.task/merged-t] [:seon.task/error {:optional true} :seon.task/error]
                          [:seon.task/deferred {:optional true} :seon.task/deferred] [:seon.task/deferred-results {:optional true} :seon.task/deferred-results]
                          [:seon.task/gate-unread {:optional true} :seon.task/gate-unread] [:seon.task/changed {:optional true} :seon.task/changed]
                          [:seon.task/conflicts {:optional true} :seon.task/conflicts] [:seon.task/unmerged {:optional true} :seon.task/unmerged]
                          [:seon.task/task-conflicts {:optional true} :seon.task/task-conflicts] [:seon.task/failures {:optional true} :seon.task/failures]
                          [:seon.task/costs {:optional true} :seon.task/costs] [:seon.task/waste {:optional true} :seon.task/waste]
                          [:seon.task/declared {:optional true} :seon.task/declared]]
 ;; ---- how a task's work stands and ended: attributes of the task, on main, written when root starts and judges it ----
 ;; (docs/reconcile.md#a-task-holds-how-its-work-ended). A task's history is its attributes' previous values (d/history).
 ;; the agent that works it now (an agent moves between a session's tasks, seon.reconcile/stage-boundary)
 :seon.task/agent [:and {:seon.db/to [:seon.db/agent-fact] :seon.db/index true :description "The agent that works the task now."} :seon.db/ref]
 ;; the work's state, which the compare-and-swap guards (seon.reconcile/cas-tx). nil: no agent yet. finished: the task is done
 ;; (seon.task/finished); judged: judged, root has the next step to take (the merge's turn or its gate); failed: its agent died
 ;; or was lost, a death (seon.problems/report). :running, an agent works it; :parked, its agent waits for a message and its
 ;; process stays; :told, root told it a verdict and it waits for the next wake; :cap, it spent its agent's turns and waits for them to be
 ;; raised (:seon.agent/max-turns) and the task released again; :done, accepted on its branch; :ready, a merge ready for the octopus
 ;; merge; :gate, a merge whose process tests are to run first; :merged, in main; :behind, a merge main moved under; :dead, its
 ;; agent died; :lost, its process was gone; :killed, stopped for a cancel, a hold or a changed environment; :refused, root refused
 ;; the spawn; :closed, judged when its task was no longer running, or held for root
 :seon.task/outcome [:and {:seon.db/index true :seon.status/finished #{:done :merged} :seon.status/judged #{:ready :gate} :seon.status/failed #{:dead :lost} :description "How the task's work stands or ended."}
                     [:enum :running :parked :told :cap :done :ready :gate :merged :behind :dead :lost :killed :refused :closed]]
 ;; why it stands so: the agent's own words, or root's (the death, a refused start)
 ;; the branch of the agent that launched this task (my.task/launch!), told how it ends (seon.reconcile/tell-tx)
 ;; who started it, a user or an agent: its agent, when it starts, is in that one's :seon.agent/agents (seon.task/start-tx; docs/users.md#what-each-thing-is)
 :seon.task/started-by [:and {:seon.db/to [:seon.db/agent-fact] :description "Who started the task, a user or an agent. See docs/users.md#what-each-thing-is."} :seon.db/ref]
 :seon.task/reason [:string {:description "Why the task stands as its outcome says: the agent's own words, or root's."}]
 :seon.task/reasons [:vector {:description "What the done rule said was not done when the task was last judged, each reason a map with what it is about (a proof's name, a problem's key, how far behind main). The same reasons twice in a row hold the task; they are retracted when a person continues it. See docs/tasks.md#the-done-rule."}
                     :seon.reconcile/not-done]
 ;; the merges-branch commit holding the source files a merge rewrote (seon.source, the
 ;; :git effect), or why the commit was refused; recorded by its asker, the reconciler
 :seon.task/commit [:string {:description "The merges-branch commit holding the source files a merge rewrote, or why the commit was refused."}]
 :seon.task/merged-t [:int {:description "The t at which the task's branch was merged."}]
 ;; the process tests its change reaches, which its merge runs on a checkout (root's ruling, 2026-10-22), never an agent's fork;
 ;; the gate's run of them (each test's status); the changed namespaces the gate could not read from the branch, each with why:
 ;; it tested another tree than the one that merges, so none of its results counts as a pass
 :seon.task/deferred [:map-of {:description "The process tests that the task's change reaches, which its merge runs on a checkout, each with its digest as main held it at the task's base: the key by which the gate reads main's own verdict of that test (seon.proofs/main-red); nil when the test is new on the branch, so its red is the task's. An observation; the gate's results are :seon.task/deferred-results."} :qualified-symbol [:maybe :string]]
 :seon.task/deferred-results [:map-of {:description "The gate's run of the deferred tests, each test's status."} :qualified-symbol :seon.proof/status]
 :seon.task/gate-unread [:vector {:description "The changed namespaces that the gate could not read from the branch, each with why."} [:map [:ns :symbol] [:reason :string]]]
 ;; measured at its end from the branch (seon.merge/three-way's :ours): the printed program keys it changed since its merge base
 ;; (each seon.edn/encode of a :seon.merge/program-key, so generated ones are too); the octopus merge admits on them
 :seon.task/changed [:set {:description "The printed program keys that the task changed since its merge base, which the octopus merge admits on."} [:string {:gen/elements ["[:var app/a]" "[:var app.b/c]" "[:form \"app/1-2\"]" "[:ns app]"]}]]
 ;; its merge entries (:seon.merge/conflict) and the keys still unmerged on the branch
 :seon.task/conflicts [:vector {:description "The task's merge entries that conflict."} :seon.merge/conflict]
 :seon.task/unmerged [:set {:description "The keys still unmerged on the task's branch."} :string]
 ;; a test's name and status in a proof's results (a gate's, seon.proofs/results); verdicts themselves are cached by
 ;; digest outside the store (docs/merging.md#verdicts-are-a-cache)
 :seon.proof/status [:enum :pass :fail :error :none]
 ;; ---- root's boot and config keys (main) ----
 :seon.root/id [:and {:seon.db/identity true} :keyword]
 :seon.root/boot :string
 ;; the config in force, an entity of its own (docs/config.md#facts-on-main): root's entity holds root's attributes only
 :seon.root/config [:and {:seon.db/to [:seon.config/config-fact]} :seon.db/ref]
 ;; who is signed in: the user / is the page of (docs/users.md#whats-on-screen); until there is a login, boot signs in the OS account running root
 :seon.root/signed-in [:and {:seon.db/to [:seon.db/user-fact]} :seon.db/ref]
 :seon.root/started-by [:string {:description "The test whose process started this boot (ns/name, seon.test-store/start-root! from clojure.test/*testing-vars*, given to the root as --started-by): the merge gate leaves it out of a merge's deferred process tests, since a test cannot be its own gate. Absent: no test started it, and every deferred test is gated. See docs/merging.md#a-merge-runs-what-the-change-reaches."}]
 ;; the reconciler's positive report of quiescence: at main's t nothing runs, nothing is to
 ;; judge, nothing is ready; :root-causes names each released task not done, with its root cause and
 ;; what it blocks (seon.reconcile/root-causes)
 :seon.root/quiescent [:map [:t :int] [:root-causes [:vector :seon.reconcile/root-cause]]]
 ;; Seon's own source as last indexed into main's program (seon.source: a seed, seon.root/import-tree!, or a re-index,
 ;; my.root/import!): the tree, its HEAD commit (none when it is no repository) and the branch checked out (none when detached), the revision it pins each reference-code
 ;; submodule at (its gitlink), the digest of the files and pins read (an index of a tree that reads the same writes
 ;; nothing), its files and forms, the program entities the index retracted, how long reading, analysing and transacting
 ;; took, or why it was refused
 :seon.root/source [:map {:seon.render/hiccup seon.render.ui/source-line}
                    [:root :string] [:commit {:optional true} :string] [:branch {:optional true} :string] [:tree {:optional true} :string] [:dirs {:optional true} [:vector :string]]
                    [:pins {:optional true} [:map-of :string :string]] [:digest {:optional true} :string]
                    [:files :int] [:forms :int] [:retracted {:optional true} :int] [:ms number?]
                    [:error {:optional true} :string]
                    ;; as the last boot states it (seon.root/booted-source): its id, the git tree its binary was built from
                    ;; (:binary-tree) and that tree's program (:binary); only when that tree is :tree, the one main was last
                    ;; brought to from outside (an import or a landing; what agents merged since is main's own), the binary's
                    ;; inputs with no program facts (seon.fx/inputs), what its agents key their test results by, and :program the
                    ;; binary's, else main's at boot (seon.program/program-digest); two trees are seon.problems/stale-binary's row
                    [:boot {:optional true} :string] [:binary {:optional true} :string] [:binary-tree {:optional true} :string]
                    [:program {:optional true} :string]
                    ;; seon.root/stale-binary's answer at the boot: why the binary is not current for main ({:binary :tree :reaches}, or what is
                    ;; missing), absent when current; what the :stale-binary row shows
                    [:stale-binary {:optional true} :map]
                    ;; the build's index only: the code that made it (seon.program/index-code)
                    [:indexed-by {:optional true} :string]
                    [:inputs {:optional true} :seon.program/inputs]]
 ;; the next generation (docs/source.md#the-next-generation): the merges commit the :build effect
 ;; built (seon.fx/build), its worktree and binary and how long the build took, or why it was
 ;; refused; recorded by its asker, the reconciler; bin/root next starts the binary on this store
 :seon.root/generation [:map [:commit :string] [:checkout {:optional true} :string] [:binary {:optional true} :string] [:ms number?]
                        [:error {:optional true} :string]]
 ;; root's last collection of the store (seon.db/collect!, run by the writer when no agent is
 ;; live): how many keys it swept, how long it took, the branches it saw (a later collection
 ;; runs only once one of them is gone) and how many were gone since the one before
 :seon.root/retained [:map [:swept :int] [:ms number?] [:generation :int]]
 ;; no history: only the last collection is read (seon.db/collect!), and its history cost 4 nodes a write
 :seon.root/collected [:and {:seon.db/no-history? true} [:map [:swept :int] [:ms number?] [:branches [:set :keyword]] [:gone :int]]]
 ;; main's content mark: a t past every t main held before the commit that last moved main's content (a datom of an
 ;; attribute a program key's content reads, or carried task content: seon.merge/moves-content?); the writer moves it in that
 ;; same commit, and at its start, so two commits of main with one mark hold the same content (docs/storage.md#mains-content-mark)
 :seon.root/content-t :int
 ;; how a root ended: its boot, why (:stop! a caller's stop, :stdin-eof its owner closed its
 ;; stdin (bin/root stop), :signal SIGTERM, SIGINT or SIGHUP (Jolt's shutdown hooks), :unclean
 ;; no stop fact at all: SIGKILL or a crash, found by the next boot) and when
 :seon.root/end [:map [:boot :string] [:cause :keyword] [:at-ms :int]]
 ;; written by seon.root/stop! before anything stops, durable
 ;; the outcome of root's last read of the task files (my.root/load-tasks!): how many files read, or
 ;; the refused read's message. A refused read's error names it as its subject
 ;; and is written in the same transaction, so it stays open until a good read writes another value
 ;; (seon.problems/closed?); the same outcome again writes no datom
 :seon.root/tasks [:or [:map [:files nat-int?]] [:map [:error :string]]]
 :seon.root/stopped :seon.root/end
 ;; what this boot found of the root before it on this main: its stop fact, or :unclean
 :seon.root/previous-end :seon.root/end
 :seon.root/root-fact [:map {:seon.db/attributes true :seon.render/keys [:seon.root/id :seon.root/boot :seon.root/generation :seon.root/quiescent] :seon.ctx/pattern [* {:seon.root/config [*]} {[:seon.agent/_root :as :agents :limit :seon.config.ctx/window :reverse true] [* {[:seon.agent/task :as :task] [:seon.task/id :seon.task/outcome :seon.task/reason]} {[:seon.process/_agent :as :processes] [*]} {[:seon.eval/_agent :as :evals :limit :seon.config.ctx/window :reverse true] [*]}]} {[:seon.eval/_agent :as :evals :limit :seon.config.ctx/window :reverse true] [*]}] :seon.render/hiccup seon.render.ui/root}
                          [:seon.root/id :seon.root/id]
                          ;; a seeded store's root holds no boot until a root first boots on it (seon.task/entity-value reads it so)
                          [:seon.root/boot {:optional true} :seon.root/boot] [:seon.root/signed-in {:optional true} :seon.root/signed-in]
                          [:seon.root/config {:optional true} :seon.root/config]
                          [:seon.root/started-by {:optional true} :seon.root/started-by]
                          [:seon.root/stopped {:optional true} :seon.root/stopped]
                          [:seon.root/previous-end {:optional true} :seon.root/previous-end]
                          [:seon.root/quiescent {:optional true} :seon.root/quiescent]
                          [:seon.root/source {:optional true} :seon.root/source]
                          [:seon.root/tasks {:optional true} :seon.root/tasks]
                          [:seon.root/generation {:optional true} :seon.root/generation]
                          [:seon.root/collected {:optional true} :seon.root/collected] [:seon.root/retained {:optional true} :seon.root/retained]
                          [:seon.root/content-t {:optional true} :seon.root/content-t]]
 ;; ---- on every transaction Seon makes, in its tx-meta (seon.db/tx-meta) ----
 ;; the runtime that made it, as its compiled units are keyed (jolt.host/runtime-fingerprint:
 ;; Jolt's version, its runtime fingerprint, its trace tag; docs/storage.md#history)
 :seon.tx/runtime [:string {:description "The runtime that made the transaction, as its compiled units are keyed. See docs/storage.md#history."}]
 ;; the branch the transaction was written on: it travels with a merged datom, so the union
 ;; of every branch's history names who wrote what (seon.union). Not indexed by value: it is read off the
 ;; transaction entity (seon.ctx/made-by), never sought by value, and the index cost 5 nodes a write
 ;; (docs/storage.md#what-a-datom-costs-to-add)
 :seon.tx/branch [:keyword {:description "The branch that the transaction was written on; it travels with a merged datom."}]
 ;; the eval whose code made it (its :seon.eval/id on the branch): an agent's write during
 ;; an eval, its record's included (seon.agent/transact!); none outside an eval
 :seon.tx/eval [:string {:min 1 :description "The id of the eval whose code made the transaction; none outside an eval."}]
 ;; the branch a catch-up merged (seon.agent/merge-main!): what it applied is that branch's, not
 ;; the agent's, though :seon.tx/branch names the branch it was written on
 :seon.tx/merged [:and {:description "The branch that a catch-up merged, when the transaction is a merge."} :seon.db/branch]
 :seon.tx/meta [:map {:seon.db/attributes true} [:seon.tx/runtime {:optional true} :seon.tx/runtime]
                [:seon.tx/branch {:optional true} :seon.tx/branch]
                [:seon.tx/eval {:optional true} :seon.tx/eval]
                [:seon.tx/merged {:optional true} :seon.tx/merged]]
 ;; a message, one entity read by everyone it is to (docs/users.md#messages): written on main by root's writer at the send,
 ;; and on each recipient's branch whole when its next act delivers it (seon.agent/deliver!). from names a sender: an agent's
 ;; key, "root" or "owner"; to names its recipients by agent entity, a ref each, and a recipient's branch holds its own ref
 ;; only: removing the message from a ctx retracts that ref (the entity stays, so it is not delivered again)
 :seon.message/id [:and {:seon.db/identity true :seon.db/content-id true :description "The message's identity."} :string]
 :seon.message/from [:and {:seon.db/to [:seon.db/agent-fact :seon.root/root-fact] :seon.db/index true :description "Who sent the message: an agent, a user or the system."} :seon.db/ref]
 :seon.message/to [:set {:seon.db/to [:seon.db/agent-fact] :seon.db/index true :description "The agents that receive the message, a ref each."} :seon.db/ref]
 ;; when root's writer recorded it (ms): it orders and decides nothing (docs/clocks.md)
 :seon.message/sent-ms [:int {:description "When root's writer recorded the message, in ms; it orders and decides nothing. See docs/clocks.md."}]
 :seon.message/body :seon.db/text
 :seon.message/fact [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/message :seon.render/openai-compat seon.ctx.wire/message-msgs} [:seon.message/id :seon.message/id] [:seon.message/from :seon.message/from]
                     [:seon.message/to {:optional true} :seon.message/to] [:seon.message/sent-ms {:optional true} :seon.message/sent-ms]
                     [:seon.message/body :seon.message/body]]
 ;; ---- written by an agent on its own branch; they reach main with its merge ----
 ;; (my.task/status) asked before any turn of this process observed its task: why, and what runs its proofs
 :seon.turn/not-observed [:and :seon.error/base [:map [:seon.error/type [:= :seon.turn/not-observed]]]]
 ;; a model's eval call left unrun because an earlier call of its reply threw (seon.repl/unrun): :after, that call's id
 ;; a model's eval call with no intent or no form, not run (seon.repl/call-problem): :problem why, :forms 0 for an empty one
 :seon.turn/invalid-call [:and :seon.error/base [:map [:seon.error/type [:= :seon.turn/invalid-call]] [:problem [:enum :no-intent :forms :arguments :repaired]] [:forms {:optional true} nat-int?]]]
 ;; a name an agent asked about (my.agent/source, callers, callees) that is no var on its branch nor
 ;; in its process: said, never answered as no callers or silence; :nearest the nearest existing
 ;; names (my.agent/no-var); :ask the form for the registry key of that name, when there is one
 :my.agent/no-var [:and :seon.error/base [:map [:seon.error/type [:= :my.agent/no-var]] [:name :symbol] [:nearest [:vector :symbol]] [:ask {:optional true} :string]]]
 ;; my.task/update! of a member to a value its schema does not admit (seon.task/member-tx): nothing written
 :seon.task/invalid-member [:and :seon.error/base [:map [:seon.error/type [:= :seon.task/invalid-member]] [:member :keyword]
                                                        ;; what the update would have made it, printed by the error's render (the one printer)
                                                        [:value :any]]]
 ;; ---- a process: one spawn of an agent, its telemetry on its own entity pointing at the agent
 ;; (seon.ctx/the-record-is-facts-about-the-work, move 2), so the agent's pull holds its work and no more; an agent's
 ;; current process is its newest (seon.task/current-process); root's agents card joins them
 ;; (docs/ctx.md#the-agents-entity-holds-its-work) ----
 ;; the agent's key and the process's pid (seon.task/agent-tx)
 :seon.process/id [:and {:seon.db/identity true} :string]
 :seon.process/agent [:and {:seon.db/to [:seon.db/agent-fact] :seon.db/index true} :seon.db/ref]
 :seon.process/pid :int
 ;; the form it evaluates now; retracted when it returns
 :seon.process/running :string
 :seon.process/forked-ms :double
 :seon.process/ended-ms :int
 ;; root observed it stalled (seon.agent-proc's stall check: a request in flight, no frame past the bound), with
 ;; what it waits on (the request root last sent it: its kind and form, a test run's test); retracted when its
 ;; next frame arrives or it ends. An open :stalled problem while it holds (seon.problems/stalled-agents)
 :seon.process/stall [:map [:quiet-ms :int] [:last-op {:optional true} [:maybe :seon.agent/last-op]]]
  :seon.process/process-fact [:map {:seon.db/attributes true}
                          [:seon.process/id :seon.process/id] [:seon.process/agent {:optional true} :seon.process/agent]
                          [:seon.process/pid {:optional true} :seon.process/pid]
                          [:seon.process/running {:optional true} :seon.process/running]
                          [:seon.process/forked-ms {:optional true} :seon.process/forked-ms] [:seon.process/ended-ms {:optional true} :seon.process/ended-ms]
                          [:seon.process/stall {:optional true} :seon.process/stall]]
 ;; ---- a model call: one request to the model, on its own entity pointing at its agent (the turn is a
 ;; number on each record, docs/turn.md#the-turn-is-a-number: what a turn entity held is the model call's). Its reply, its
 ;; reasoning and how it stopped are the model's words; its tokens, sent-hash and split are bookkeeping, which the agent's
 ;; pull leaves out (docs/ctx.md#the-agents-entity-holds-its-work); the debug page and the turn's header read it ----
 ;; the digest of the agent's key and n, the turn it answers (seon.lib/call-id); an outside read of the context (seon.turn/context-block), of the key and "read-<k>"
 :seon.model-call/id [:and {:seon.db/identity true :description "The model call's identity: the digest of the agent's key and n."} :string]
 ;; the agent whose request it is, and the turn it answers (a model's: :seon.agent/turn when it started) or the read's own
 ;; counter k (an outside read moves no turn)
 :seon.model-call/agent [:and {:seon.db/to [:seon.db/agent-fact] :seon.db/index true :description "The agent whose request the model call is."} :seon.db/ref]
 :seon.model-call/n [:int {:description "The turn that the call answers, or the read's own counter for an outside read."}]
 ;; who read the context: the agent's model, or an outside agent through the server (a read is a call)
 :seon.model-call/origin [:enum {:description "Who read the context: the agent's model, or an outside agent through the server."} :model :outside]
 ;; the model's reply: its text (a reply that called nothing is a message to the user), its reasoning as returned and the
 ;; provider's finish_reason; truncated, the reply stopped at max-tokens and its text was cut
 :seon.model-call/reply :seon.db/text
 :seon.model-call/reasoning :seon.db/text
 :seon.model-call/truncated [:boolean {:description "True when the reply stopped at max-tokens and its text was cut."}]
 ;; a call that failed: the typed error as data (the agent's end holds it too, :seon.agent/error)
 :seon.model-call/error [:and {:description "The typed error, as data, of a call that failed."} :seon.error/base]
 :seon.model-call/forms [:int {:description "How many forms the reply held."}]
 :seon.model-call/ms [:int {:description "How long the call took, in ms."}]
 :seon.model-call/tokens [:int {:description "The tokens of the call, as the provider reported them."}]
 ;; the prompt tokens the provider served from its prefix cache, and those it did not, as its
 ;; usage reported them (absent when it did not: nobody measured them)
 :seon.model-call/cache-hit-tokens [:int {:description "The prompt tokens that the provider served from its prefix cache; absent when it did not report them."}]
 :seon.model-call/cache-miss-tokens [:int {:description "The prompt tokens that the provider did not serve from its prefix cache; absent when it did not report them."}]
 ;; the model that answered
 :seon.model-call/model [:string {:description "The model that answered."}]
 ;; what the reader's context was built from, never its text (a model call stores its basis,
 ;; not its prompt): the commit it read, its task, run and turn, the observations no db
 ;; holds (the proofs' results, red assertions, reasons, the run's errors), whether the
 ;; branch's unmerged entries show, and the last evaluations' transcript while no earlier turn
 ;; shows them. seon.ctx.wire/render makes the exact user message from it on that commit.
 :seon.model-call/basis [:map {:description "What the reader's context was built from, never its text: the commit it read, its task, turn and observations no db holds."} [:commit :uuid] [:t {:optional true} :int] [:task :seon.task/id]
                   [:turn :int] [:max-turns :int] [:origin :seon.model-call/origin]
                   [:merge? {:optional true} :boolean]
                   ;; the agent whose record the request renders (its key)
                   [:agent {:optional true} :string]
                   ;; the run's own model, when it names one (seon.config/provider-at)
                   [:model {:optional true} :string]]
 ;; a hash of the bytes a request sent (seon.lib/digest of its messages, seon.turn/act!): the debug page draws a turn again from
 ;; its records at its commit with today's renders, and says when its redraw hashes to something else (docs/render.md#the-debug-page-is-the-wire-request)
 :seon.model-call/sent-hash [:string {:min 16 :max 16 :description "A hash of the bytes that the request sent. See docs/render.md#the-debug-page-is-the-wire-request."}]
 :seon.model-call/fact [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/model-call-view :seon.render/openai-compat seon.ctx.wire/model-call-msgs}
                          [:seon.model-call/id :seon.model-call/id] [:seon.model-call/agent {:optional true} :seon.model-call/agent]
                          [:seon.model-call/n {:optional true} :seon.model-call/n] [:seon.model-call/origin {:optional true} :seon.model-call/origin]
                          [:seon.model-call/reply {:optional true} :seon.model-call/reply]
                          [:seon.model-call/reasoning {:optional true} :seon.model-call/reasoning]
                          [:seon.model-call/truncated {:optional true} :seon.model-call/truncated] [:seon.model-call/error {:optional true} :seon.model-call/error]
                          [:seon.model-call/forms {:optional true} :seon.model-call/forms]
                          [:seon.model-call/ms {:optional true} :seon.model-call/ms]
                          [:seon.model-call/tokens {:optional true} :seon.model-call/tokens]
                          [:seon.model-call/cache-hit-tokens {:optional true} :seon.model-call/cache-hit-tokens]
                          [:seon.model-call/cache-miss-tokens {:optional true} :seon.model-call/cache-miss-tokens]
                          [:seon.model-call/model {:optional true} :seon.model-call/model]
                          [:seon.model-call/basis {:optional true} :seon.model-call/basis] [:seon.model-call/sent-hash {:optional true} :seon.model-call/sent-hash]]
 ;; ---- a first move scored (seon.judge, my.root/first-moves!) ----
 ;; the digest of the request it answers (seon.judge/digest): the same context is scored once
 :seon.judge/digest [:and {:seon.db/identity true} :string]
 :seon.judge/task :seon.task/id
 ;; the score from the compiler's facts, with the version that served the context (root's
 ;; source tree and its commit), the reply's eval calls and their cost in USD when priced
 :seon.judge/score [:map [:acted :boolean] [:right-var :boolean] [:right-test :boolean]
                    [:waste :int] [:uncompiled :int] [:green :boolean] [:version [:map [:root {:optional true} :string] [:commit {:optional true} :string]]]
                    [:calls [:vector :string]]
                    ;; the provider's token counts, by the model call's own names (seon.turn/usage): a value of the score
                    [:usage {:optional true} [:map [:seon.model-call/tokens {:optional true} :int] [:seon.model-call/cache-hit-tokens {:optional true} :int]
                                              [:seon.model-call/cache-miss-tokens {:optional true} :int]]]
                    [:usd {:optional true} number?]
                    ;; the scoring that made it (seon.judge/scorer): other scoring scores the calls again
                    [:scorer :string]]
 ;; a pass that stopped at its budget: what it spent, the bound, the tasks it left
 :seon.judge/stopped [:map [:usd number?] [:bound number?] [:left [:vector :seon.task/id]]]
 :seon.judge/judge-fact [:map {:seon.db/attributes true}
                         [:seon.judge/digest :seon.judge/digest] [:seon.judge/task {:optional true} :seon.judge/task]
                         [:seon.judge/score {:optional true} :seon.judge/score] [:seon.judge/stopped {:optional true} :seon.judge/stopped]]
 ;; ---- the program merge's facts (session D1's proto.merge.facts.edn) ----
 :seon.merge/key [:and {:seon.db/index true} :seon.db/plain]
 :seon.merge/base :seon.db/plain
 :seon.merge/ours :seon.db/plain
 :seon.merge/theirs :seon.db/plain
 :seon.merge/main-t :int
 :seon.merge/resolved? :boolean
 :seon.merge/entry-fact [:map {:seon.db/attributes true}
                          [:seon.merge/key :seon.merge/key]
                          [:seon.merge/base {:optional true} :seon.merge/base] [:seon.merge/ours {:optional true} :seon.merge/ours]
                          [:seon.merge/theirs {:optional true} :seon.merge/theirs]
                          [:seon.merge/main-t {:optional true} :seon.merge/main-t] [:seon.merge/resolved? {:optional true} :seon.merge/resolved?]]}
