;; The program facts seon.db writes (session D1's proto.db.facts.edn) (namespaces, vars, the example task and note) and the
;; recording transaction of each eval request, as entity schemas. Stored shapes; the Datahike
;; schema is derived from them (seon.schema.datahike/declarations).
{;; ---- the program, as the compiler knows it (seon.program; inv4's design) ----
 ;; A FORM is the unit of reproduction: main evaluates forms, write-back writes them. Each
 ;; definition (var, multimethod method, protocol extension, namespace) points to the form
 ;; that last made it; what a form defines, declares and references comes from Jolt's
 ;; analyzer (jolt.analyzer/*unit-tap*, or analysis-only for a file), never from text.
 :form/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 ;; the exact text as written, and the whitespace and comments before it in its file
 :form/src :string
 :form/lead :string
 ;; the form is the text of a source tree a generation was built from (seon.source's import):
 ;; the binary holds it compiled, so a process evaluates it again only where a changed macro
 ;; expanded or a changed schema reaches its contract (seon.program/load-changes!); a form an agent or a merge
 ;; makes never carries it
 :form/source :boolean
 :form/ns [:and {:seon.db/index true} :seon.db/ref]
 ;; its place among its namespace's forms (a file's order; a new form after all others)
 :form/order :int
 :form/defines [:set :seon.db/ref]
 :form/declares [:set :seon.db/ref]
 ;; the vars it references, resolved by the compiler (clojure.core's left out): callers are
 ;; one AVET seek
 :form/refs [:set {:seon.db/index true} :qualified-symbol]
 ;; the namespaces its require/use calls name
 :form/requires [:set :symbol]
 ;; references to clojure.core/intern, alter-var-root, eval, load-string, and definitions
 ;; inside a function body: judged at merge (every definition happens once)
 :form/banned [:set :qualified-symbol]
 :form/inline-defs [:set :qualified-symbol]
 ;; the calls it bounds by a clock (deref with a timeout; Thread/sleep and core.async's
 ;; timeout are in its refs), and its catch clauses as EDN {:class name ("*" for a catch-all)
 ;; :answers :constant|:rethrows|:expr}: the facts the guard detectors query
 :form/timeouts [:set {:seon.db/index true} :qualified-symbol]
 :form/catches [:set :string]
 :ns/name [:and {:seon.db/identity true :seon.db/content-id true} :symbol]
 :ns/doc :string
 :ns/form :seon.db/ref
 ;; the file it was imported from, relative to the source tree's root (seon.source)
 :ns/file :string
 ;; the text after its file's last form
 :ns/tail :string
 :var/name [:and {:seon.db/identity true :seon.db/content-id true} :symbol]
 :var/ns :seon.db/ref
 :var/form :seon.db/ref
 :var/doc :string
 :var/arity :int
 ;; what a defined var holds (:fn :test :macro :value :multi :protocol :protocol-fn :type
 ;; :ctor) and its declared contract, as text
 :var/kind :keyword
 :var/contract :string
 :method/key [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :method/multi :qualified-symbol
 :method/dispatch :string
 :method/form :seon.db/ref
 :impl/key [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :impl/protocol :qualified-symbol
 :impl/type :string
 :impl/form :seon.db/ref
 ;; A SCHEMA ENTRY of a schema resource (resources/seon/schemas/*.edn) is program too
 ;; (seon.source; v1: the program is entities, schemas among them): its key, its form as
 ;; EDN text, the resource it is written back to, and whether the binary holds it (imported
 ;; from the tree a generation was built from; an entry an agent registers or a merge
 ;; carries never does). The resource's text as imported is the base write-back edits.
 :schema/key [:and {:seon.db/identity true :seon.db/content-id true} :qualified-keyword]
 :schema/form :string
 :schema/file [:and {:seon.db/index true} :string]
 :schema/source :boolean
 :schema.file/path [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :schema.file/text :string
 :seon.db/schema-fact [:map {:seon.db/attributes true} [:schema/key :schema/key] [:schema/form :schema/form]
                        [:schema/file :schema/file] [:schema/source {:optional true} :schema/source]]
 :seon.db/schema-file-fact [:map {:seon.db/attributes true} [:schema.file/path :schema.file/path] [:schema.file/text :schema.file/text]]
 :seon.db/form-fact [:map {:seon.db/attributes true}
                      [:form/id :form/id] [:form/src :form/src] [:form/ns :form/ns] [:form/order :form/order]
                      [:form/lead {:optional true} :form/lead] [:form/defines {:optional true} :form/defines]
                      [:form/declares {:optional true} :form/declares] [:form/refs {:optional true} :form/refs]
                      [:form/requires {:optional true} :form/requires] [:form/banned {:optional true} :form/banned]
                      [:form/inline-defs {:optional true} :form/inline-defs] [:form/source {:optional true} :form/source]
                      [:form/timeouts {:optional true} :form/timeouts] [:form/catches {:optional true} :form/catches]]
 :seon.db/ns-fact [:map {:seon.db/attributes true} [:ns/name :ns/name] [:ns/doc {:optional true} :ns/doc]
                    [:ns/form {:optional true} :ns/form] [:ns/file {:optional true} :ns/file] [:ns/tail {:optional true} :ns/tail]]
 :seon.db/var-fact [:map {:seon.db/attributes true}
                     [:var/name :var/name] [:var/ns {:optional true} :var/ns] [:var/form {:optional true} :var/form]
                     [:var/doc {:optional true} :var/doc] [:var/arity {:optional true} :var/arity]
                     [:var/kind {:optional true} :var/kind] [:var/contract {:optional true} :var/contract]]
 :seon.db/method-fact [:map {:seon.db/attributes true}
                        [:method/key :method/key] [:method/multi :method/multi] [:method/dispatch :method/dispatch]
                        [:method/form {:optional true} :method/form]]
 :seon.db/impl-fact [:map {:seon.db/attributes true}
                      [:impl/key :impl/key] [:impl/protocol :impl/protocol] [:impl/type :impl/type]
                      [:impl/form {:optional true} :impl/form]]
 ;; ---- the example program's task and note ----
 :task/name [:and {:seon.db/identity true} :keyword]
 :task/plan :string
 :task/status [:and {:seon.db/index true} :keyword]
 :task/refs [:set :seon.db/ref]
 :task/agent :keyword
 :note/text :string
 :note/agent [:and {:seon.db/index true} :keyword]
 :note/about :seon.db/ref
 :seon.db/example-task-fact [:map {:seon.db/attributes true}
                              [:task/name :task/name] [:task/plan :task/plan] [:task/status :task/status]
                              [:task/refs {:optional true} :task/refs] [:task/agent {:optional true} :task/agent]]
 :seon.db/note-fact [:map {:seon.db/attributes true}
                      [:note/text :note/text] [:note/agent :note/agent] [:note/about {:optional true} :note/about]]
 ;; ---- the recording transaction of each eval request, and the agent's answered t.
 ;; Observations: data on the branch that recorded them, never carried by a merge ----
 :seon.cluster.eval/id :string
 :seon.cluster.eval/agent :seon.db/ref
 ;; the evaluation's details as one EDN value: {:tag :form :shown|:error :out :ms :alloc-bytes :fns}
 ;; (:fns: its 10 costliest contracted functions, [{:var :calls :ms}], seon.profile)
 :seon.cluster.eval/record [:map {:seon.db/data true :seon.render/html seon.render.ui/history-row} [:tag [:enum :ret :err]]]
 ;; an agent: one entity per agent per boot of its root (an id like :a3 starts again each boot),
 ;; named by its key (seon.task/agent-key: "<boot>/<id>"), a content id so root's entity on main
 ;; and the one its branch's records name are one; it refs the root that started it. What root
 ;; observes of it (status, pid, memory, the form running, its task's description) is recorded
 ;; on it when root's view of it changes (seon.task/agent-tx)
 :seon.agent/key [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :seon.agent/id [:and {:seon.db/index true} :keyword]
 :seon.agent/root :seon.db/ref
 :seon.agent/branch :keyword
 :seon.agent/pid :int
 :seon.agent/mem-mb :double
 :seon.agent/running :string
 :seon.agent/description [:string {:seon.render/prose true}]
 :seon.agent/forked-ms :double
 :seon.agent/ended-ms :int
 :seon.agent/answered-t :int
 :seon.db/eval-fact [:map {:seon.db/attributes true}
                     [:seon.cluster.eval/id :seon.cluster.eval/id] [:seon.cluster.eval/agent :seon.cluster.eval/agent]
                     [:seon.cluster.eval/record :seon.cluster.eval/record]]
 ;; an entity's units (seon.render/walk): the neighbours a view of it shows, one hop, as pull's
 ;; attributes (a leading _ the reverse ref), each rendered by its own schema's render
 :seon.db/agent-fact [:map {:seon.db/attributes true :seon.render/keys [:seon.agent/id :seon.agent/status :seon.agent/pid :seon.agent/branch :seon.agent/running :seon.agent/description] :seon.render/units [:seon.attempt/_agent :seon.cluster.eval/_agent]}
                       [:seon.agent/key :seon.agent/key] [:seon.agent/id {:optional true} :seon.agent/id]
                       [:seon.agent/root {:optional true} :seon.agent/root] [:seon.agent/branch {:optional true} :seon.agent/branch]
                       [:seon.agent/status {:optional true} :seon.agent/status] [:seon.agent/pid {:optional true} :seon.agent/pid]
                       [:seon.agent/mem-mb {:optional true} :seon.agent/mem-mb] [:seon.agent/running {:optional true} :seon.agent/running]
                       [:seon.agent/description {:optional true} :seon.agent/description]
                       [:seon.agent/forked-ms {:optional true} :seon.agent/forked-ms] [:seon.agent/ended-ms {:optional true} :seon.agent/ended-ms]
                       [:seon.agent/answered-t {:optional true} :seon.agent/answered-t]]
 ;; ---- tasks, attempts, proof results, root's boot, turns and ends (session D1's proto.agents.facts.edn) ----
;; ---- the task ----
 :seon.task/id [:and {:seon.db/identity true} :string]
 :seon.task/ns :symbol
 :seon.task/name :string
 :seon.task/plan [:string {:seon.render/prose true}]
 :seon.task/instructions [:string {:seon.render/prose true}]
 :seon.task/proofs [:set :qualified-symbol]
 :seon.task/needs [:set :seon.db/ref]
 :seon.task/references [:set :qualified-symbol]
 :seon.task/branch :keyword
 :seon.task/model :string
 :seon.task/execution [:and {:seon.db/index true} [:enum :held :running :cancelled]]
 :seon.task/kind [:enum :work :design :implement :test :merge]
 ;; measured evidence a task starts from: its last failed attempt's conflicts, unmerged keys, red
 ;; proofs and problem (seon.reconcile/hold-tx), read by the attempt root releases next
 :seon.task/evidence [:map {:seon.db/data true}
                      [:from :seon.attempt/id] [:conflicts [:vector :seon.merge/conflict]]
                      [:unmerged [:vector :string]] [:red [:vector :qualified-symbol]]
                      ;; why the attempt failed: its reasons or its death, as the reconciler stated it
                      [:problem {:optional true} :string]]
 ;; root's go (my.root/gate!): the process tests this task's change reaches run on the gate
 ;; checkout before it merges; without it they are never run automatically (owner, 2026-10-23)
 :seon.task/gate? :boolean
 ;; the task held for root with a failure: an attempt the reconciler refused, whose agent died or
 ;; whose merge was refused (seon.reconcile/hold-tx: why, the attempt), or marked failed
 ;; (my.task/fail!, root or a check: why, the value that shows it, the attempt); root's judge
 ;; carries an attempt's own onto main (state :failed), where it stays as a record after a release
 :seon.task/failure [:map {:seon.db/data true} [:reason :string] [:counterexample {:optional true} :string] [:attempt {:optional true} [:maybe :seon.attempt/id]]]
 ;; the declaration a task file last stated for this task (seon.task/load-tx), as EDN
 :seon.task/declared :string
 ;; config keys are attributes of the task, by their own names (schemas: seon.config.agent.edn, seon.config.merge.edn)
 :seon.task/task-fact [:map {:seon.db/attributes true :seon.render/units [:seon.task/plan :seon.task/proofs]}
                          [:seon.task/id :seon.task/id] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
                          [:seon.task/plan :seon.task/plan] [:seon.task/execution :seon.task/execution]
                          [:seon.task/branch :seon.task/branch] [:seon.task/kind :seon.task/kind]
                          [:seon.task/proofs {:optional true} :seon.task/proofs] [:seon.task/needs {:optional true} :seon.task/needs]
                          [:seon.task/references {:optional true} :seon.task/references]
                          [:seon.task/instructions {:optional true} :seon.task/instructions]
                          [:seon.task/model {:optional true} :seon.task/model]
                          [:seon.task/evidence {:optional true} :seon.task/evidence]
                          [:seon.task/gate? {:optional true} :seon.task/gate?]
                          [:seon.task/failure {:optional true} :seon.task/failure]
                          [:seon.task/declared {:optional true} :seon.task/declared]
                          [:seon.config.agent/max-turns {:optional true} :seon.config.agent/max-turns]
                          [:seon.config.merge/max-conflicts {:optional true} :seon.config.merge/max-conflicts]
                          [:seon.config.merge/max-merge-turns {:optional true} :seon.config.merge/max-merge-turns]]
 ;; ---- the attempt and its proof results (observed by root) ----
 ;; a content id: the run an agent's branch names (its turns, the messages it took) and the run
 ;; on main are one entity (docs/storage.md#ids)
 :seon.attempt/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :seon.attempt/task [:and {:seon.db/index true} :seon.db/ref]
 ;; finished: its task is done (seon.reconcile/finished); judged: ended or dead, the done rule's to judge;
 ;; failed: its agent died or was lost, a death (seon.problems/report)
 :seon.attempt/status [:and {:seon.db/index true :seon.status/finished #{:done :merged} :seon.status/judged #{:ended :dead} :seon.status/failed #{:dead :lost}} [:enum :running :ended :killed :dead :lost :done :merged :behind :closed :refused]]
 :seon.attempt/boot :string
 ;; the agent that works it (seon.task/agent-key)
 :seon.attempt/agent :seon.db/ref
 :seon.attempt/pid :int
 :seon.attempt/start-ms :int
 :seon.attempt/end-ms :int
 :seon.attempt/branch :keyword
 :seon.attempt/model :string
 :seon.attempt/max-turns :int
 :seon.attempt/outcome [:enum :green :red :waiting :cap :failed :merge-failed :error :no-end :no-progress]
 :seon.attempt/reason [:string {:seon.render/prose true}]
 :seon.attempt/turns :int
 :seon.attempt/model-calls :int
 :seon.attempt/tokens :int
 :seon.attempt/merged-t :int
 ;; the merges-branch commit holding the source files a merge rewrote (seon.source, the
 ;; :git effect), or why the commit was refused; recorded by its asker, the reconciler
 :seon.attempt/commit :string
 :seon.attempt/commit-error :string
 :seon.attempt/basis-t :int
 ;; the task's accumulated plan as the attempt began (seon.task/accumulate): a design step is
 ;; done only when the plan differs from it (seon.reconcile/done-explain :no-design)
 :seon.attempt/plan :seon.task/plan
 :seon.attempt/uncontracted [:set :qualified-symbol]
 :seon.proof/test :qualified-symbol
 :seon.proof/status [:enum :pass :fail :error :none]
 ;; one entity per test, owned by the attempt
 :seon.attempt/results [:set {:seon.db/component true} :seon.db/ref]
 ;; measured at the attempt's end from the branch: its merge entries (:seon.merge/*) and the keys still unmerged
 :seon.attempt/conflicts [:set {:seon.db/component true} :seon.db/ref]
 :seon.attempt/unmerged [:set :string]
 ;; measured at the attempt's end from the branch (seon.merge/three-way's :ours): the printed
 ;; program keys the branch changed since its merge base (each seon.edn/encode of a
 ;; :seon.merge/program-key, so generated ones are too); the octopus merge admits on them
 :seon.attempt/changed [:set [:string {:gen/elements ["[:var app/a]" "[:var app.b/c]" "[:form \"app/1-2\"]" "[:ns app]"]}]]
 ;; measured at the attempt's end (the reach walk's :process?): the process tests its change reaches,
 ;; which its merge runs on a checkout (root's ruling, 2026-10-22), never an agent's fork
 :seon.attempt/deferred [:set :qualified-symbol]
 ;; the merge gate's run of them on a checkout (seon.fx/run-tests): each test's status, as proofs'
 :seon.attempt/deferred-results [:set {:seon.db/component true} :seon.db/ref]
 ;; the changed namespaces the merge gate could not read from the branch, each with why: its
 ;; run tested another tree than the one that merges, so none of its results counts as a pass
 :seon.attempt/gate-unread [:vector {:seon.db/data true} [:map [:ns :symbol] [:reason :string]]]
 ;; measured at the attempt's end from the branch (seon.problems/caused): the derived problems
 ;; its work made true since its merge base, by message; the done rule refuses while any is open
 :seon.attempt/caused [:set :string]
 :seon.attempt/attempt-fact [:map {:seon.db/attributes true :seon.render/keys [:seon.attempt/id :seon.attempt/status :seon.attempt/outcome :seon.attempt/reason :seon.attempt/model :seon.attempt/turns :seon.attempt/max-turns :seon.attempt/branch] :seon.render/units [:seon.attempt/task :seon.turn/_attempt :seon.message/_to]}
                             [:seon.attempt/id :seon.attempt/id] [:seon.attempt/task :seon.attempt/task]
                             [:seon.attempt/status :seon.attempt/status] [:seon.attempt/boot :seon.attempt/boot]
                             [:seon.attempt/agent {:optional true} :seon.attempt/agent] [:seon.attempt/start-ms :seon.attempt/start-ms]
                             [:seon.attempt/pid {:optional true} :seon.attempt/pid] [:seon.attempt/end-ms {:optional true} :seon.attempt/end-ms]
                             [:seon.attempt/branch {:optional true} :seon.attempt/branch] [:seon.attempt/model {:optional true} :seon.attempt/model]
                             [:seon.attempt/max-turns {:optional true} :seon.attempt/max-turns]
                             [:seon.attempt/outcome {:optional true} :seon.attempt/outcome] [:seon.attempt/reason {:optional true} :seon.attempt/reason]
                             [:seon.attempt/turns {:optional true} :seon.attempt/turns] [:seon.attempt/model-calls {:optional true} :seon.attempt/model-calls]
                             [:seon.attempt/tokens {:optional true} :seon.attempt/tokens] [:seon.attempt/merged-t {:optional true} :seon.attempt/merged-t]
                             [:seon.attempt/basis-t {:optional true} :seon.attempt/basis-t]
                             [:seon.attempt/plan {:optional true} :seon.attempt/plan]
                             [:seon.attempt/uncontracted {:optional true} :seon.attempt/uncontracted]
                             [:seon.attempt/results {:optional true} :seon.attempt/results]
                             [:seon.attempt/conflicts {:optional true} :seon.attempt/conflicts]
                             [:seon.attempt/unmerged {:optional true} :seon.attempt/unmerged]
                             [:seon.attempt/changed {:optional true} :seon.attempt/changed]
                             [:seon.attempt/deferred {:optional true} :seon.attempt/deferred]
                             [:seon.attempt/deferred-results {:optional true} :seon.attempt/deferred-results]
                             [:seon.attempt/gate-unread {:optional true} :seon.attempt/gate-unread]
                             [:seon.attempt/caused {:optional true} :seon.attempt/caused]
                             [:seon.attempt/commit {:optional true} :seon.attempt/commit]
                             [:seon.attempt/commit-error {:optional true} :seon.attempt/commit-error]]
 :seon.proof/proof-fact [:map {:seon.db/attributes true} [:seon.proof/test :seon.proof/test] [:seon.proof/status :seon.proof/status]]
 ;; ---- root's boot and config keys (main) ----
 :seon.root/id [:and {:seon.db/identity true} :keyword]
 :seon.root/boot :string
 ;; the reconciler's positive report of quiescence: at main's t nothing runs, nothing is to
 ;; judge, nothing is ready; :root-causes names each released task not done, with its root cause and
 ;; what it blocks (seon.reconcile/root-causes)
 :seon.root/quiescent [:map {:seon.db/data true} [:t :int] [:root-causes [:vector :seon.reconcile/root-cause]]]
 ;; Seon's own source imported at boot as main's program (seon.source), one fact per boot: the tree, its HEAD
 ;; commit (none when it is no repository), the revision it pins each reference-code submodule
 ;; at (its gitlink, what a cited reference-code file shows: seon.ref/file-view), the digest of
 ;; the files and pins read (a boot whose tree
 ;; reads the same imports nothing), its files and forms, the program entities the import
 ;; retracted, how long reading, analysing and transacting took, or why it was refused
 :seon.root/source [:map {:seon.db/data true} [:root :string] [:commit {:optional true} :string]
                    [:pins {:optional true} [:map-of :string :string]] [:digest {:optional true} :string]
                    [:files :int] [:forms :int] [:retracted {:optional true} :int] [:ms number?]
                    [:error {:optional true} :string]
                    ;; this boot's, and the tree's inputs with no program facts (seon.fx/inputs) when the running
                    ;; binary is built from this very tree: what its agents key their test results by;
                    ;; otherwise why not (:unshared)
                    [:boot {:optional true} :string] [:inputs {:optional true} :seon.program/inputs]
                    [:unshared {:optional true} :string]]
 ;; the next generation (docs/source.md#the-next-generation): the merges commit the :build effect
 ;; built (seon.fx/build), its worktree and binary and how long the build took, or why it was
 ;; refused; recorded by its asker, the reconciler; bin/root next starts the binary on this store
 :seon.root/generation [:map {:seon.db/data true} [:commit :string] [:checkout {:optional true} :string] [:binary {:optional true} :string] [:ms number?]
                        [:error {:optional true} :string]]
 ;; root's last collection of the store (seon.db/collect!, run by the writer when no agent is
 ;; live): how many keys it swept, how long it took, the branches it saw (a later collection
 ;; runs only once one of them is gone) and how many were gone since the one before
 :seon.root/collected [:map {:seon.db/data true} [:swept :int] [:ms number?] [:branches [:set :keyword]] [:gone :int]]
 ;; how a root ended: its boot, why (:stop! a caller's stop, :stdin-eof its owner closed its
 ;; stdin (bin/root stop), :signal SIGTERM, SIGINT or SIGHUP (Jolt's shutdown hooks), :unclean
 ;; no stop fact at all: SIGKILL or a crash, found by the next boot) and when
 :seon.root/end [:map {:seon.db/data true} [:boot :string] [:cause :keyword] [:at-ms :int]]
 ;; written by seon.root/stop! before anything stops, durable
 ;; root's file watcher (seon.watch, my.root/watch!): the roots it watches, this boot's; the
 ;; batches and paths it read; the rescans FSEvents asked for (events under a subtree it
 ;; coalesced or dropped, or a watched root moved: every kind loaded again), counted, the
 ;; newest with its path; or why it is not watching
 :seon.root/watch [:map {:seon.db/data true} [:roots [:vector :string]] [:boot :string]
                   [:batches nat-int?] [:paths nat-int?] [:rescans nat-int?]
                   [:last-rescan {:optional true} [:map [:path :string] [:kind [:enum :rescan :root]]]]
                   [:last-opened {:optional true} [:vector :string]]
                   [:error {:optional true} :string]]
 :seon.root/stopped :seon.root/end
 ;; what this boot found of the root before it on this main: its stop fact, or :unclean
 :seon.root/previous-end :seon.root/end
 :seon.root/root-fact [:map {:seon.db/attributes true :seon.render/keys [:seon.root/id :seon.root/boot :seon.root/generation :seon.root/stopped :seon.root/quiescent] :seon.render/units [:seon.agent/_root]}
                          [:seon.root/id :seon.root/id] [:seon.root/boot :seon.root/boot]
                          [:seon.root/stopped {:optional true} :seon.root/stopped]
                          [:seon.root/previous-end {:optional true} :seon.root/previous-end]
                          [:seon.root/quiescent {:optional true} :seon.root/quiescent]
                          [:seon.root/source {:optional true} :seon.root/source]
                          [:seon.root/watch {:optional true} :seon.root/watch]
                          [:seon.root/generation {:optional true} :seon.root/generation]
                          [:seon.root/collected {:optional true} :seon.root/collected]
                          [:seon.config.agent/max-running {:optional true} :seon.config.agent/max-running]
                          [:seon.config.merge/max-running {:optional true} :seon.config.merge/max-running]]
 ;; ---- on every transaction Seon makes, in its tx-meta (seon.db/tx-meta) ----
 ;; the runtime that made it, as its compiled units are keyed (jolt.host/runtime-fingerprint:
 ;; Jolt's version, its runtime fingerprint, its trace tag; docs/storage.md#history)
 :seon.tx/runtime :string
 ;; the branch the transaction was written on: it travels with a merged datom, so the union
 ;; of every branch's history names who wrote what (seon.union)
 :seon.tx/branch [:and {:seon.db/index true} :keyword]
 :seon.tx/meta [:map {:seon.db/attributes true} [:seon.tx/runtime {:optional true} :seon.tx/runtime]
                [:seon.tx/branch {:optional true} :seon.tx/branch]]
 ;; a message between root and an agent, as a fact on the sender's branch: root's on main, an
 ;; agent's reply on its own; the union of every branch's history joins a conversation in one
 ;; query (seon.union). from and to name an attempt (its :seon.attempt/id, "demo/f#1"),
 ;; "root", or "owner" (the page's message bar and the server's :message op, written by root):
 ;; an agent id starts again every boot, an attempt's names one worker for good. The agent that
 ;; takes a message writes the same fact on its own branch, and its turn's basis names it by id.
 ;; reply-to is the replied message's id, a value, since that message may be on a branch the
 ;; reply's is not
 :seon.message/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :seon.message/from [:and {:seon.db/index true} :string]
 ;; the run it is to (the agent working it takes it)
 :seon.message/to [:and {:seon.db/index true} :seon.db/ref]
 :seon.message/body [:string {:seon.render/prose true}]
 :seon.message/reply-to [:and {:seon.db/index true} :string]
 :seon.message/fact [:map {:seon.db/attributes true} [:seon.message/id :seon.message/id] [:seon.message/from :seon.message/from]
                     [:seon.message/to {:optional true} :seon.message/to] [:seon.message/body :seon.message/body]
                     [:seon.message/reply-to {:optional true} :seon.message/reply-to]]
 ;; ---- written by an agent on its own branch; they reach main with its merge ----
 :seon.turn/id [:and {:seon.db/identity true} :string]
 :seon.turn/attempt [:and {:seon.db/index true} :seon.db/ref]
 :seon.turn/n :int
 :seon.turn/reply [:string {:seon.render/prose true}]
 :seon.turn/forms :int
 :seon.turn/errors :int
 :seon.turn/red :int
 :seon.turn/ms :int
 :seon.turn/tokens :int
 ;; the prompt tokens the provider served from its prefix cache, and those it did not, as its
 ;; usage reported them (absent when it did not: nobody measured them)
 :seon.turn/cache-hit-tokens :int
 :seon.turn/cache-miss-tokens :int
 ;; the model's reply stopped at max-tokens: its text was cut
 :seon.turn/truncated :boolean
 ;; who read the context: the agent's model, or an outside agent through the server (a read is a turn)
 :seon.turn/origin [:enum :model :outside]
 ;; what the reader's context was built from, never its text (a model call stores its basis,
 ;; not its prompt): the commit it read, its task, attempt and turn, the observations no db
 ;; holds (the proofs' results, red assertions, reasons, the run's errors), whether the
 ;; branch's unmerged entries show, and the last evaluations' transcript while no earlier turn
 ;; shows them. seon.context/render makes the exact user message from it on that commit.
 :seon.turn/basis [:map {:seon.db/data true} [:commit :uuid] [:task :seon.task/id] [:attempt :seon.attempt/id]
                   [:turn :int] [:max-turns :int] [:origin :seon.turn/origin] [:observed :map]
                   [:merge? {:optional true} :boolean] [:last-evals {:optional true} :string]]
 ;; a model turn's eval calls, each its id, its code and what it evaluated to as the later
 ;; turns' tool messages show it (seon.context/evaluations-text: folded, within the evals budget)
 :seon.turn/calls [:vector {:seon.db/data true} [:map [:id :string] [:code :string] [:evals :string]
                                                    ;; the ids of the call's evaluation records (:seon.cluster.eval/id), and the
                                                    ;; model's thinking about the call (the eval tool's optional argument)
                                                    [:items {:optional true} [:vector :string]] [:thinking {:optional true} :string]]]
 ;; the provider's finish_reason, the model that answered, and its reasoning text
 :seon.turn/finish :string
 :seon.turn/model :string
 :seon.turn/reasoning [:string {:seon.render/prose true}]
 ;; where the turn's time went, as the agent saw it: the proof run, the context render, the
 ;; model round trip, the reply's evaluations, the turn's record (ms)
 :seon.turn/split [:map {:seon.db/data true} [:tests-ms {:optional true} :int] [:context-ms :int]
                   [:model-ms {:optional true} :int] [:eval-ms {:optional true} :int] [:record-ms {:optional true} :int]]
 :seon.end/attempt [:and {:seon.db/identity true} :string]
 :seon.end/outcome :keyword
 :seon.end/reason :string
 :seon.end/turns :int
 :seon.end/tokens :int
 :seon.turn/turn-fact [:map {:seon.db/attributes true :seon.render/html seon.render.ui/turn-row}
                          [:seon.turn/id :seon.turn/id] [:seon.turn/attempt :seon.turn/attempt] [:seon.turn/n :seon.turn/n]
                          [:seon.turn/reply :seon.turn/reply] [:seon.turn/forms :seon.turn/forms] [:seon.turn/errors :seon.turn/errors]
                          [:seon.turn/red :seon.turn/red] [:seon.turn/ms :seon.turn/ms] [:seon.turn/tokens {:optional true} :seon.turn/tokens]
                          [:seon.turn/cache-hit-tokens {:optional true} :seon.turn/cache-hit-tokens]
                          [:seon.turn/cache-miss-tokens {:optional true} :seon.turn/cache-miss-tokens]
                          [:seon.turn/truncated {:optional true} :seon.turn/truncated]
                          [:seon.turn/origin {:optional true} :seon.turn/origin] [:seon.turn/basis {:optional true} :seon.turn/basis]
                          [:seon.turn/calls {:optional true} :seon.turn/calls]
                          [:seon.turn/finish {:optional true} :seon.turn/finish] [:seon.turn/model {:optional true} :seon.turn/model]
                          [:seon.turn/reasoning {:optional true} :seon.turn/reasoning] [:seon.turn/split {:optional true} :seon.turn/split]]
 :seon.end/end-fact [:map {:seon.db/attributes true}
                         [:seon.end/attempt :seon.end/attempt] [:seon.end/outcome :seon.end/outcome]
                         [:seon.end/reason {:optional true} :seon.end/reason]
                         [:seon.end/turns {:optional true} :seon.end/turns] [:seon.end/tokens {:optional true} :seon.end/tokens]]
 ;; ---- an effect's outcome, recorded by its asker on its own branch (seon.fx, session FX1) ----
 :seon.fx/id [:and {:seon.db/identity true} :string]
 :seon.fx/kind :keyword
 :seon.fx/status :keyword
 :seon.fx/us :int
 :seon.fx/queue-us :int
 :seon.fx/cost :int
 :seon.fx/error :string
 :seon.fx/fx-fact [:map {:seon.db/attributes true}
                     [:seon.fx/id :seon.fx/id] [:seon.fx/kind :seon.fx/kind] [:seon.fx/status :seon.fx/status]
                     [:seon.fx/us :seon.fx/us] [:seon.fx/queue-us :seon.fx/queue-us]
                     [:seon.fx/cost {:optional true} :seon.fx/cost] [:seon.fx/error {:optional true} :seon.fx/error]]
 ;; ---- the program merge's facts (session D1's proto.merge.facts.edn) ----
 :seon.merge/key [:any {:seon.db/index true :seon.db/data true}]
 :seon.merge/kind :keyword
 :seon.merge/base [:any {:seon.db/data true}]
 :seon.merge/ours [:any {:seon.db/data true}]
 :seon.merge/theirs [:any {:seon.db/data true}]
 :seon.merge/main-t :int
 :seon.merge/resolved? :boolean
 :seon.merge/entry-fact [:map {:seon.db/attributes true}
                          [:seon.merge/key :seon.merge/key] [:seon.merge/kind :seon.merge/kind]
                          [:seon.merge/base {:optional true} :seon.merge/base] [:seon.merge/ours {:optional true} :seon.merge/ours]
                          [:seon.merge/theirs {:optional true} :seon.merge/theirs]
                          [:seon.merge/main-t {:optional true} :seon.merge/main-t] [:seon.merge/resolved? {:optional true} :seon.merge/resolved?]]}
