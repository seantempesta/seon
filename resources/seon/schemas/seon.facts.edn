;; The program facts seon.db writes (session D1's proto.db.facts.edn) (namespaces, vars, the example task and note) and the
;; recording transaction of each eval request, as entity schemas. Stored shapes; the Datahike
;; schema is derived from them (seon.schema.datahike/declarations).
{;; ---- the program, as the compiler knows it (seon.program; inv4's design) ----
 ;; A FORM is the unit of reproduction: main evaluates forms, write-back writes them. Each
 ;; definition (var, multimethod method, protocol extension, namespace) points to the form
 ;; that last made it; what a form defines, declares and references comes from Jolt's
 ;; analyzer (jolt.analyzer/*unit-tap*, or analysis-only for a file), never from text.
 :form/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 ;; the exact text as written, and the whitespace and comments before it in its file
 :form/src :string
 :form/lead :string
 ;; the form is the text of a source tree a generation was built from (seon.source's import):
 ;; the binary holds it compiled, so a process evaluates it again only where a changed macro
 ;; expanded or a changed schema reaches its contract (seon.program/load-changes!); a form an agent or a merge
 ;; makes never carries it. Its :form/order is its place in that file, so seon.program/load-order
 ;; keeps the order between two such forms (the file already loads)
 :form/source :boolean
 :form/ns [:and {:seon.db/index true} :seon.db/ref]
 ;; its place among its namespace's forms (a file's order; a new form after all others)
 :form/order :int
 :form/defines [:set :seon.db/ref]
 :form/declares [:set :seon.db/ref]
 ;; the vars it references, resolved by the compiler (clojure.core's left out): callers are
 ;; one AVET seek
 :form/refs [:set {:seon.db/index true} :qualified-symbol]
 ;; the qualified names its quoted data holds (seon.program/quoted-names): names, not references,
 ;; so the reach never follows them; a caller listing reads them (seon.doc/callers: who names a
 ;; render, a proc, a form sent to an agent)
 :form/quoted [:set {:seon.db/index true} :qualified-symbol]
 ;; the ops of the requests it builds ({:op :done ...}: a map's constant keyword under :op), recorded
 ;; by the analyzer (seon.program/unit-account): a test that starts a root reaches the server's
 ;; answer of each op it sends, seon.server/op-answer's method, and no other (seon.program/reach-step)
 :form/ops [:set :keyword]
 ;; the qualified keywords its code and its contracts name, recorded by the analyzer from the read
 ;; it already does (seon.program/unit-account): the attributes, config keys and schema entries it
 ;; operates on; a key's forms are one AVET seek (seon.program/schema-dependents, my.agent/callers)
 :form/keywords [:set {:seon.db/index true} :qualified-keyword]
 ;; the namespaces its require/use calls name
 :form/requires [:set :symbol]
 ;; references to clojure.core/intern, alter-var-root, eval, load-string, and definitions
 ;; inside a function body: judged at merge (every definition happens once)
 :form/banned [:set :qualified-symbol]
 :form/inline-defs [:set :qualified-symbol]
 ;; the calls it bounds by a clock (deref with a timeout; Thread/sleep and core.async's
 ;; timeout are in its refs), and its catch clauses as EDN {:class name ("*" for a catch-all)
 ;; :answers :constant|:rethrows|:expr}: the facts the guard detectors query
 :form/timeouts [:set {:seon.db/index true} :qualified-symbol]
 :form/catches [:set :string]
 :ns/name [:and {:seon.db/identity true :seon.db/content-id true} :symbol]
 :ns/doc :string
 :ns/form :seon.db/ref
 ;; the file it was imported from, relative to the source tree's root (seon.source)
 :ns/file :string
 ;; the text after its file's last form
 :ns/tail :string
 :var/name [:and {:seon.db/identity true :seon.db/content-id true} :symbol]
 :var/ns :seon.db/ref
 :var/form :seon.db/ref
 :var/doc :string
 :var/arity :int
 ;; what a defined var holds (:fn :test :macro :value :multi :protocol :protocol-fn :type
 ;; :ctor) and its declared contract, as text
 :var/kind :keyword
 :var/contract :string
 ;; A TEST'S LAST RESULT, on its var entity on the branch whose agent ran it (seon.proofs/result-tx,
 ;; written by seon.agent/run-tests-forked when a run ends; task seon.proofs/test-results-are-a-few-facts,
 ;; R2a): overwritten in place, no history. The digest it was judged at; green, red, or flaky (green and red at
 ;; that digest, seon.proofs/verdict), or deferred (a process test the run left to root's gate), and present only while that digest is the test's reach digest now (a
 ;; moved digest retracts them: unknown); its failing assertions as data, the test child's reports (seon.proofs/failures,
 ;; every one; present only while not green, printed by the one printer where shown);
 ;; and running sums over the runs at this digest (a new digest resets them): mean = sum / runs, computed on read
 :seon.test/digest [:and {:seon.db/no-history? true} :string]
 :seon.test/status [:and {:seon.db/no-history? true} [:enum :green :red :flaky :deferred]]
 :seon.test/failures [:and {:seon.db/no-history? true} [:vector :seon.problems/assertion]]
 :seon.test/runs [:and {:seon.db/no-history? true} :int]
 :seon.test/ms [:and {:seon.db/no-history? true} :int]
 :seon.test/ticks [:and {:seon.db/no-history? true} :int]
 :seon.test/bytes [:and {:seon.db/no-history? true} :int]
 :method/key [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :method/multi :qualified-symbol
 :method/dispatch :string
 :method/form :seon.db/ref
 :impl/key [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :impl/protocol :qualified-symbol
 :impl/type :string
 :impl/form :seon.db/ref
 ;; A SCHEMA ENTRY of a schema resource (resources/seon/schemas/*.edn) is program too
 ;; (seon.source; v1: the program is entities, schemas among them): its key, its form as
 ;; EDN text, the resource it is written back to, and whether the binary holds it (imported
 ;; from the tree a generation was built from; an entry an agent registers or a merge
 ;; carries never does). The resource's text as imported is the base write-back edits.
 :schema/key [:and {:seon.db/identity true :seon.db/content-id true} :qualified-keyword]
 :schema/form :string
 :schema/file [:and {:seon.db/index true} :string]
 :schema/source :boolean
 :schema.file/path [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :schema.file/text :string
 :seon.db/schema-fact [:map {:seon.db/attributes true} [:schema/key :schema/key] [:schema/form :schema/form]
                        [:schema/file :schema/file] [:schema/source {:optional true} :schema/source]]
 :seon.db/schema-file-fact [:map {:seon.db/attributes true} [:schema.file/path :schema.file/path] [:schema.file/text :schema.file/text]]
 :seon.db/form-fact [:map {:seon.db/attributes true}
                      [:form/id :form/id] [:form/src :form/src] [:form/ns :form/ns] [:form/order :form/order]
                      [:form/lead {:optional true} :form/lead] [:form/defines {:optional true} :form/defines]
                      [:form/declares {:optional true} :form/declares] [:form/refs {:optional true} :form/refs] [:form/quoted {:optional true} :form/quoted] [:form/ops {:optional true} :form/ops] [:form/keywords {:optional true} :form/keywords]
                      [:form/requires {:optional true} :form/requires] [:form/banned {:optional true} :form/banned]
                      [:form/inline-defs {:optional true} :form/inline-defs] [:form/source {:optional true} :form/source]
                      [:form/timeouts {:optional true} :form/timeouts] [:form/catches {:optional true} :form/catches]]
 :seon.db/ns-fact [:map {:seon.db/attributes true} [:ns/name :ns/name] [:ns/doc {:optional true} :ns/doc]
                    [:ns/form {:optional true} :ns/form] [:ns/file {:optional true} :ns/file] [:ns/tail {:optional true} :ns/tail]]
 :seon.db/var-fact [:map {:seon.db/attributes true :seon.ctx/pattern [* {[:var/form :as :form] [*]}]}
                     [:var/name :var/name] [:var/ns {:optional true} :var/ns] [:var/form {:optional true} :var/form]
                     [:var/doc {:optional true} :var/doc] [:var/arity {:optional true} :var/arity]
                     [:var/kind {:optional true} :var/kind] [:var/contract {:optional true} :var/contract]
                     [:seon.test/digest {:optional true} :seon.test/digest] [:seon.test/status {:optional true} :seon.test/status]
                     [:seon.test/failures {:optional true} :seon.test/failures] [:seon.test/runs {:optional true} :seon.test/runs]
                     [:seon.test/ms {:optional true} :seon.test/ms] [:seon.test/ticks {:optional true} :seon.test/ticks]
                     [:seon.test/bytes {:optional true} :seon.test/bytes]]
 :seon.db/method-fact [:map {:seon.db/attributes true}
                        [:method/key :method/key] [:method/multi :method/multi] [:method/dispatch :method/dispatch]
                        [:method/form {:optional true} :method/form]]
 :seon.db/impl-fact [:map {:seon.db/attributes true}
                      [:impl/key :impl/key] [:impl/protocol :impl/protocol] [:impl/type :impl/type]
                      [:impl/form {:optional true} :impl/form]]
 ;; ---- the example program's task and note ----
 :task/name [:and {:seon.db/identity true} :keyword]
 :task/plan :string
 :task/status [:and {:seon.db/index true} :keyword]
 :task/refs [:set :seon.db/ref]
 :task/agent :keyword
 :note/text :string
 :note/agent [:and {:seon.db/index true} :keyword]
 :note/about :seon.db/ref
 :seon.db/example-task-fact [:map {:seon.db/attributes true}
                              [:task/name :task/name] [:task/plan :task/plan] [:task/status :task/status]
                              [:task/refs {:optional true} :task/refs] [:task/agent {:optional true} :task/agent]]
 :seon.db/note-fact [:map {:seon.db/attributes true}
                      [:note/text :note/text] [:note/agent :note/agent] [:note/about {:optional true} :note/about]]
 ;; ---- the recording transaction of each eval request, and the agent's answered t.
 ;; Observations: data on the branch that recorded them, never carried by a merge ----
 ;; an eval: one per eval request (a model's tool call, a form the user or a session typed),
 ;; its id the handle's name (e43); who evaluated it (the agent's id, "user", "outside", "context")
 :seon.eval/id [:and {:seon.db/identity true} :string]
 :seon.eval/agent :seon.db/ref
 :seon.eval/by [:and {:seon.db/index true} :string]
 ;; opened by a reader of the agent's page: true once, never retracted; root writes it on main as the
 ;; agent's :seon.agent/opened (an eval's id names it only within its agent), its turn on its branch
 :seon.eval/opened :boolean
 ;; what is stored of an eval's answer (:seon.repl/answer): its value made plain (seon.repl/record-details)
 :seon.eval/response [:and :seon.repl/answer :seon.db/plain]
 ;; an eval's details, each its own attribute, each only when present (seon.repl/record-details): the code; the
 ;; model's prose beside the call; the provider's call id (the reply's text and reasoning are its model call's,
 ;; :seon.model-call/reply, which an eval's turn number names); its run (until runs go); its 10 costliest contracted functions
 ;; ([{:var :calls :ms}], seon.profile); a value that names its render schema keeps that schema, and a value
 ;; that names its basis (@ctx, seon.ctx) the basis it is rendered from, in place of a copy (the page and the
 ;; model draw it from the branch at its t). The response is :seon.eval/response, whole, its value as plain data
 ;; (seon.contract/plainly) up to :seon.config.store/max-value-chars; never a text made for a reader (seon.print
 ;; prints it when it is sent or shown). The prose is kept as written, never parsed as it is recorded
 :seon.eval/code :string
 :seon.eval/prose :string
 :seon.eval/call-id :string
 ;; the agent's turn number in force when it was written (0 before its first turn; absent on root's)
 :seon.eval/turn :int
 :seon.eval/fns [:vector :map]
 :seon.eval/schema :qualified-keyword
 :seon.eval/basis [:map [:t :int] [:branch :seon.db/branch]]
 ;; an agent: one entity per agent per boot of its root (an id like :a3 starts again each boot),
 ;; named by its key (seon.task/agent-key: "<boot>/<id>"), a content id so root's entity on main
 ;; and the one its branch's records name are one; it refs the root that started it. What root
 ;; observes of it (status, pid, memory, the form running, its task's description) is recorded
 ;; on it when root's view of it changes (seon.task/agent-tx)
 :seon.agent/key [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :seon.agent/id [:and {:seon.db/index true} :keyword]
 :seon.agent/root :seon.db/ref
 :seon.agent/branch :keyword
 ;; the task it works (the agent's record pulls it, docs/ctx.md#the-pattern) and the turns it may take: raised to extend the agent
 ;; (the agent is the unit, seon.agent/the-agent-is-the-unit-not-the-run; max-turns is written from its cut 2, until then work!'s
 ;; :max-turns bounds the loop)
 :seon.agent/task :seon.db/ref
 ;; the turns it may take, agent-wide: its :seon.agent/turn against it. Set at spawn from the config its task's environment names
 ;; (seon.reconcile/desired-env); raised, and the task released again (my.root/run!), it goes on (docs/turn.md#the-cap)
 :seon.agent/max-turns :int
 ;; the agent's turn number (docs/turn.md#the-turn-is-a-number): moved by the model turn that starts (seon.turn/act!) in the
 ;; transaction of its model call's first facts, agent-wide and never restarting across wakes; every record takes the number in force
 :seon.agent/turn :int
 :seon.agent/description [:string]
 ;; the model it works for, when its task names none of root's; the client that attached it, when an outside agent's (seon.server/held)
 :seon.agent/model :string
 :seon.agent/holder :string
 ;; root's boot it was started in, and when (ms): the agent is live in a root when the boot is that root's and its task is :running
 :seon.agent/boot :string
 :seon.agent/started-ms :int
 :seon.agent/ended-ms :int
 ;; the messages to its branch it had taken when root last judged it (seon.reconcile/judge-tx): main holding more wakes it once parked
 :seon.agent/taken :int
 ;; a test run that failed as a whole (its fork refused, a namespace did not load): the error as data (its type, message and
 ;; data keys), written on the agent's branch by its turn (seon.turn/observe) and retracted when a run answers;
 ;; present only while it is so (seon.context/status)
 :seon.agent/test-error :seon.error/base
 ;; how its work ended, as the agent writes it on its branch (seon.agent/write-end!), naming its turn: root reads it at judging
 ;; (seon.reconcile/pull-end), and an end whose turn is not past the wake's is none (:no-end)
 :seon.agent/outcome [:enum :green :red :waiting :cap :failed :merge-failed :error]
 :seon.agent/reason :string
 :seon.agent/ended-turn :int
 :seon.ctx/pattern [:and [:vector :any] :seon.db/plain]
 ;; the ids of its evals a reader of its page opened (seon.root/opened!), on main; its turn writes each
 ;; on its branch as the eval's :seon.eval/opened (seon.agent/untaken-facts)
 :seon.agent/opened [:set :string]
 ;; main's head and its branch's merge base as it last heard them (seon.agent's state :main, :base), the commits the
 ;; page's branch views read, written by its turn, so a cold build draws what the live page does
 :seon.agent/main-commit :uuid
 :seon.agent/base-commit :uuid
 ;; the namespace its REPL is in, as its newest eval left it (seon.repl/record-tx: a datom when it moved), so a cold
 ;; build draws what the live page does; before any, where the REPL starts (seon.context/current-ns)
 :seon.agent/ns :symbol
 :seon.db/eval-fact [:map {:seon.db/attributes true :seon.render/html seon.render.ui/evaluation :seon.render/model seon.context/eval-messages}
                     [:seon.eval/id :seon.eval/id] [:seon.eval/agent :seon.eval/agent] [:seon.eval/by {:optional true} :seon.eval/by]
                     [:seon.eval/code :seon.eval/code] [:seon.eval/prose {:optional true} :seon.eval/prose]
                     [:seon.eval/call-id {:optional true} :seon.eval/call-id]
                     [:seon.eval/schema {:optional true} :seon.eval/schema] [:seon.eval/basis {:optional true} :seon.eval/basis]
                     [:seon.eval/fns {:optional true} :seon.eval/fns] [:seon.eval/turn {:optional true} :seon.eval/turn]
                     [:seon.eval/response :seon.eval/response] [:seon.eval/opened {:optional true} :seon.eval/opened]]
 ;; an entity's record (seon.ctx, :seon.ctx/pattern: Datahike's pull syntax as data, docs/ctx.md#the-pattern;
 ;; its joins are the page walk's units, seon.render/units), each member rendered by its own schema's render
 :seon.db/agent-fact [:map {:seon.db/attributes true :seon.render/keys [:seon.agent/id :seon.agent/status :seon.agent/branch :seon.agent/description] :seon.ctx/pattern [* {[:seon.agent/task :as :task] :seon.task/task-fact} {[:seon.model-call/_agent :as :calls] [:seon.model-call/id :seon.model-call/n :seon.model-call/origin :seon.model-call/reply :seon.model-call/reasoning :seon.model-call/finish :seon.model-call/truncated :seon.model-call/error :seon.model-call/forms]} {[:seon.eval/_agent :as :evals] [*]} {[:seon.message/_agent :as :messages :reverse true] [*]} {[:seon.cite/_of :as :cites] :seon.cite/cite-fact} {[:seon.search/_of :as :searches] :seon.search/search-fact}] :seon.render/html seon.render.ui/agent}
                       [:seon.agent/key :seon.agent/key] [:seon.agent/id {:optional true} :seon.agent/id]
                       [:seon.agent/root {:optional true} :seon.agent/root] [:seon.agent/branch {:optional true} :seon.agent/branch]
                       [:seon.agent/status {:optional true} :seon.agent/status]
                       [:seon.agent/description {:optional true} :seon.agent/description]
                       [:seon.agent/task {:optional true} :seon.agent/task] [:seon.agent/max-turns {:optional true} :seon.agent/max-turns] [:seon.agent/turn {:optional true} :seon.agent/turn]
                       [:seon.agent/model {:optional true} :seon.agent/model] [:seon.agent/holder {:optional true} :seon.agent/holder]
                       [:seon.agent/boot {:optional true} :seon.agent/boot] [:seon.agent/started-ms {:optional true} :seon.agent/started-ms]
                       [:seon.agent/ended-ms {:optional true} :seon.agent/ended-ms] [:seon.agent/taken {:optional true} :seon.agent/taken]
                       [:seon.agent/test-error {:optional true} :seon.agent/test-error]
                       [:seon.agent/outcome {:optional true} :seon.agent/outcome] [:seon.agent/reason {:optional true} :seon.agent/reason]
                       [:seon.agent/ended-turn {:optional true} :seon.agent/ended-turn]
                       [:seon.agent/error {:optional true} :seon.agent/error] [:seon.agent/waste {:optional true} :seon.agent/waste]
                       [:seon.ctx/pattern {:optional true} :seon.ctx/pattern] [:seon.agent/opened {:optional true} :seon.agent/opened]
                       [:seon.agent/main-commit {:optional true} :seon.agent/main-commit] [:seon.agent/base-commit {:optional true} :seon.agent/base-commit]
                       [:seon.agent/ns {:optional true} :seon.agent/ns]]
 ;; ---- a citation: what an entity cites, an entity of its own (docs/references.md#an-entity-cites) ----
 ;; its content id, "<of> <target>": the citing entity's identity value (a task's :seon.task/id, an agent's
 ;; :seon.agent/key) and its target as text (the address it is written with, or the name)
 :seon.cite/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 ;; the citing entity: a task (its text's, written by seon.task/cites-tx with the text) or an agent
 ;; (my.agent/cite!, and :seon.config.agent/cites written when the agent is made)
 :seon.cite/of :seon.db/ref
 ;; a section's address, path#anchor; a page cited whole is its top section's (the sections below it
 ;; joined), a page the db does not hold the address as written (it joins nothing)
 :seon.cite/address :string
 ;; a var or test (a qualified symbol), a schema key (a qualified keyword) or a namespace (a symbol)
 :seon.cite/name :seon.ref/name
 ;; a name that names a task, its id (a task's :seon.task/id is a string, a cite's name a symbol): what the
 ;; pattern joins the task by
 :seon.cite/task :string
 :seon.cite/depth :seon.ref/depth
 ;; its first mention's place in the citing text (an agent's: the order its cites were written)
 :seon.cite/order :int
 ;; the cite as ctx holds it: what it names joined (a section with its sections below; a var with its
 ;; form and newest callers, each caller with the vars it defines; a task; a schema key's entry; a
 ;; namespace), drawn by its two renders (docs/render.md#a-part-answers-data)
 ;; a search an agent's context holds: what it asks, drawn at each page draw by seon.context/search on the
 ;; branch's db (seon.render.ui/searched), so a change of its query (a swap! on ctx) redraws that part alone
 :seon.search/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 ;; the entity whose context holds it: a task (its request's, written with the task) or an agent
 :seon.search/of :seon.db/ref
 ;; the words searched: matched as words, by meaning and by the names they hold (seon.context/search)
 :seon.search/query :string
 ;; how many hits are shown, when the search asks other than :seon.config.render/search
 :seon.search/k pos-int?
 :seon.search/search-fact [:map {:seon.db/attributes true :seon.ctx/pattern [*]}
                           [:seon.search/id :seon.search/id] [:seon.search/of :seon.search/of] [:seon.search/query :seon.search/query]
                           [:seon.search/k {:optional true} :seon.search/k]]
 :seon.cite/cite-fact [:map {:seon.db/attributes true
                             :seon.ctx/pattern [* {[:seon.cite/address :by :seon.doc/address :as :section]
                                                   [:seon.doc/address :seon.doc/heading :seon.doc/lead :seon.doc/text :seon.doc/references
                                                    {[:seon.doc/_parent :as :below] [:seon.doc/address :seon.doc/heading]}]}
                                                {[:seon.cite/name :by :var/name :as :var]
                                                 [* {[:var/form :as :form] [*]}
                                                  {[:form/_refs :by :var/name :as :callers :limit :seon.config.ctx/callers :reverse true]
                                                   [* {[:form/defines :as :defines] [:var/name :var/kind]}]}]}
                                                {[:seon.cite/task :by :seon.task/id :as :task] [:seon.task/id :seon.task/plan :seon.task/kind]}
                                                {[:seon.cite/name :by :schema/key :as :schema] [*]}
                                                {[:seon.cite/name :by :ns/name :as :ns] [:ns/name :ns/doc]}]
                             :seon.render/html seon.render.ui/cite :seon.render/model seon.render.ui/cite-model}
                       [:seon.cite/id :seon.cite/id] [:seon.cite/of :seon.cite/of] [:seon.cite/depth :seon.cite/depth] [:seon.cite/order :seon.cite/order]
                       [:seon.cite/address {:optional true} :seon.cite/address] [:seon.cite/name {:optional true} :seon.cite/name] [:seon.cite/task {:optional true} :seon.cite/task]]
 ;; ---- tasks, runs, proof results, root's boot, turns and ends (session D1's proto.agents.facts.edn) ----
;; ---- the task ----
 :seon.task/id [:and {:seon.db/identity true} :string]
 :seon.task/ns :symbol
 :seon.task/name :string
 :seon.task/plan [:string]
 :seon.task/instructions [:string]
 :seon.task/proofs [:set :qualified-symbol]
 :seon.task/needs [:set :seon.db/ref]
 ;; the example sessions its agent reads before its own (seon.context/request): agents keyed "example/<id>"
 ;; (seon.context/session-tx), drawn by the renders that draw its own session
 :seon.task/examples [:set {:description "The example sessions its agent reads before its own: refs to agents keyed \"example/<id>\", finished sessions of other tasks, which the model reads as messages (seon.context/request) and the page draws with seon.render.ui/examples. See docs/tasks.md#a-task-names-example-sessions."} :seon.db/ref]
 :seon.task/branch :keyword
 :seon.task/model :string
 :seon.task/execution [:and {:seon.db/index true} [:enum :held :running :cancelled]]
 :seon.task/kind [:enum :work :design :implement :test :merge :whole]
 ;; measured evidence a task starts from: its last failed run's conflicts, unmerged keys, red
 ;; proofs and problem (seon.reconcile/hold-tx), read by the run root releases next
 :seon.task/evidence [:map
                      [:from :seon.task/id] [:conflicts [:vector :seon.merge/conflict]]
                      [:unmerged [:vector :string]] [:red [:vector :qualified-symbol]]
                      ;; why the run failed: its reasons or its death, as the reconciler stated it
                      [:problem {:optional true} :string]]
 ;; set by my.root/gate!, no longer read: a merge's gate runs the process tests its change
 ;; reaches nobody asking (seon.reconcile's :gate); kept until THE PLAN step 0.7 exercises the gate
 :seon.task/gate? :boolean
 ;; the task held for root with a failure: a run the reconciler refused, whose agent died or
 ;; whose merge was refused (seon.reconcile/hold-tx: why, the run), or marked failed
 ;; (my.task/fail!, root or a check: why, the value that shows it, the run); root's judge
 ;; carries a run's own onto main (state :failed), where it stays as a record after a release
 ;; a stall task's subject and finding (seon.template/stall): the stall root observed (the agent, its run,
 ;; what it waited on, how long, its pid), written with the task; then the cause its worker records
 ;; (my.task/update!): what it was, the evidence captured (sample, lsof, ps), whether it is a bug, and the
 ;; defect task filed for one. Its proofs read it (seon.stall-proofs)
 :seon.task/cause [:map [:stall [:map [:agent :keyword] [:task {:optional true} :seon.task/id] [:quiet-ms :int] [:pid {:optional true} [:maybe :int]]
                                 [:last-op {:optional true} [:maybe :seon.agent/last-op]]
                                 ;; the api's open asks ([rid kind agent]) and the test service's state (seon.prove/state-view) when it stalled
                                 [:api {:optional true} :map]]]
                   [:what {:optional true} :string] [:evidence {:optional true} :map]
                   [:bug? {:optional true} :boolean] [:defect {:optional true} :seon.task/id]]
 :seon.task/failure [:map [:reason :string] [:counterexample {:optional true} :string] [:agent {:optional true} :string] [:turn {:optional true} :int]]
 ;; the declaration a task file last stated for this task (seon.task/load-tx), as EDN
 :seon.task/declared :string
 ;; config keys are attributes of the task, by their own names (schemas: seon.config.agent.edn, seon.config.merge.edn)
 :seon.task/task-fact [:map {:seon.db/attributes true :seon.ctx/pattern [* {[:seon.task/proofs :by :var/name :as :proved] :seon.db/var-fact} {[:seon.task/needs :as :needs] [* {[:seon.task/proofs :by :var/name :as :proved] :seon.db/var-fact} {[:seon.cite/_of :as :cites] :seon.cite/cite-fact}]} {[:seon.cite/_of :as :cites] :seon.cite/cite-fact} {[:seon.search/_of :as :searches] :seon.search/search-fact} {[:seon.task/examples :as :examples] [:seon.agent/key :seon.agent/description {[:seon.eval/_agent :as :evals] [*]}]}] :seon.render/html seon.render.ui/task :seon.render/model seon.render.ui/task-model}
                          [:seon.task/id :seon.task/id] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
                          [:seon.task/plan :seon.task/plan] [:seon.task/execution :seon.task/execution]
                          [:seon.task/branch :seon.task/branch] [:seon.task/kind :seon.task/kind]
                          [:seon.task/proofs {:optional true} :seon.task/proofs] [:seon.task/needs {:optional true} :seon.task/needs]
                          [:seon.task/examples {:optional true} :seon.task/examples]
                          [:seon.task/instructions {:optional true} :seon.task/instructions]
                          [:seon.task/model {:optional true} :seon.task/model]
                          [:seon.task/evidence {:optional true} :seon.task/evidence]
                          [:seon.task/gate? {:optional true} :seon.task/gate?]
                          [:seon.task/failure {:optional true} :seon.task/failure]
                          [:seon.task/cause {:optional true} :seon.task/cause]
                          [:seon.task/agent {:optional true} :seon.task/agent] [:seon.task/outcome {:optional true} :seon.task/outcome]
                          [:seon.task/reason {:optional true} :seon.task/reason] [:seon.task/reasons {:optional true} :seon.task/reasons]
                          [:seon.task/commit {:optional true} :seon.task/commit] [:seon.task/commit-error {:optional true} :seon.task/commit-error]
                          [:seon.task/merged-t {:optional true} :seon.task/merged-t] [:seon.task/error {:optional true} :seon.task/error]
                          [:seon.task/deferred {:optional true} :seon.task/deferred] [:seon.task/deferred-results {:optional true} :seon.task/deferred-results]
                          [:seon.task/gate-unread {:optional true} :seon.task/gate-unread] [:seon.task/changed {:optional true} :seon.task/changed]
                          [:seon.task/conflicts {:optional true} :seon.task/conflicts] [:seon.task/unmerged {:optional true} :seon.task/unmerged]
                          [:seon.task/task-conflicts {:optional true} :seon.task/task-conflicts] [:seon.task/failures {:optional true} :seon.task/failures]
                          [:seon.task/costs {:optional true} :seon.task/costs] [:seon.task/waste {:optional true} :seon.task/waste]
                          [:seon.task/declared {:optional true} :seon.task/declared]
                          [:seon.config.agent/max-turns {:optional true} :seon.config.agent/max-turns]
                          [:seon.config.merge/max-conflicts {:optional true} :seon.config.merge/max-conflicts]
                          [:seon.config.merge/max-merge-turns {:optional true} :seon.config.merge/max-merge-turns]]
 ;; ---- how a task's work stands and ended: attributes of the task, on main, written when root starts and judges it ----
 ;; (docs/reconcile.md#a-task-holds-how-its-work-ended). A task's history is its attributes' previous values (d/history).
 ;; the agent that works it now (an agent moves between a session's tasks, seon.reconcile/stage-boundary)
 :seon.task/agent [:and {:seon.db/index true} :seon.db/ref]
 ;; the work's state, which the compare-and-swap guards (seon.reconcile/cas-tx). nil: no agent yet. finished: the task is done
 ;; (seon.task/finished); judged: judged, root has the next step to take (the merge's turn or its gate); failed: its agent died
 ;; or was lost, a death (seon.problems/report). :running, an agent works it; :parked, its agent waits for a message and its
 ;; process stays; :told, root told it a verdict and it waits for the next wake; :cap, it spent its agent's turns and waits for them to be
 ;; raised (:seon.agent/max-turns) and the task released again; :done, accepted on its branch; :ready, a merge ready for the octopus
 ;; merge; :gate, a merge whose process tests are to run first; :merged, in main; :behind, a merge main moved under; :dead, its
 ;; agent died; :lost, its process was gone; :killed, stopped for a cancel, a hold or a changed environment; :refused, root refused
 ;; the spawn; :closed, judged when its task was no longer running, or held for root
 :seon.task/outcome [:and {:seon.db/index true :seon.status/finished #{:done :merged} :seon.status/judged #{:ready :gate} :seon.status/failed #{:dead :lost}}
                     [:enum :running :parked :told :cap :done :ready :gate :merged :behind :dead :lost :killed :refused :closed]]
 ;; why it stands so: the agent's own words, or root's (the death, a refused start)
 :seon.task/reason :string
 ;; what the done rule said was not done when root judged it (seon.reconcile/done-explain); the same again holds the task
 ;; (seon.reconcile/judgment); retracted when a person continues the task
 :seon.task/reasons [:vector [:map [:reason :keyword] [:symbol {:optional true} :symbol] [:key {:optional true} :string] [:behind {:optional true} :int]]]
 ;; the merges-branch commit holding the source files a merge rewrote (seon.source, the
 ;; :git effect), or why the commit was refused; recorded by its asker, the reconciler
 :seon.task/commit :string
 :seon.task/commit-error :string
 :seon.task/merged-t :int
 ;; the process tests its change reaches, which its merge runs on a checkout (root's ruling, 2026-10-22), never an agent's fork;
 ;; the gate's run of them (each test's status); the changed namespaces the gate could not read from the branch, each with why:
 ;; it tested another tree than the one that merges, so none of its results counts as a pass
 :seon.task/deferred [:set :qualified-symbol]
 :seon.task/deferred-results [:map-of :qualified-symbol :seon.proof/status]
 :seon.task/gate-unread [:vector [:map [:ns :symbol] [:reason :string]]]
 ;; measured at its end from the branch (seon.merge/three-way's :ours): the printed program keys it changed since its merge base
 ;; (each seon.edn/encode of a :seon.merge/program-key, so generated ones are too); the octopus merge admits on them
 :seon.task/changed [:set [:string {:gen/elements ["[:var app/a]" "[:var app.b/c]" "[:form \"app/1-2\"]" "[:ns app]"]}]]
 ;; its merge entries (:seon.merge/conflict) and the keys still unmerged on the branch
 :seon.task/conflicts [:vector :seon.merge/conflict]
 :seon.task/unmerged [:set :string]
 ;; a test's name and status in a proof's results (a gate's, seon.proofs/results); verdicts themselves are cached by
 ;; digest outside the store (docs/merging.md#verdicts-are-a-cache)
 :seon.proof/status [:enum :pass :fail :error :none]
 ;; ---- root's boot and config keys (main) ----
 :seon.root/id [:and {:seon.db/identity true} :keyword]
 :seon.root/boot :string
 ;; the digest of what the wiki load read (seon.root/wiki-digest): a boot that computes the same writes no wiki
 :seon.root/wiki [:string {:description "The digest of what the wiki load of the boot that wrote it read: the pages of the wiki dirs, the program and the task ids of main before the boot. A boot that computes the same loads nothing (seon.root/wiki-digest, docs/root.md#boot)."}]
 :seon.root/started-by [:string {:description "The test whose process started this boot (ns/name, seon.test-store/start-root! from clojure.test/*testing-vars*, given to the root as --started-by): the merge gate leaves it out of a merge's deferred process tests, since a test cannot be its own gate. Absent: no test started it, and every deferred test is gated. See docs/merging.md#a-merge-runs-what-the-change-reaches."}]
 ;; the reconciler's positive report of quiescence: at main's t nothing runs, nothing is to
 ;; judge, nothing is ready; :root-causes names each released task not done, with its root cause and
 ;; what it blocks (seon.reconcile/root-causes)
 :seon.root/quiescent [:map [:t :int] [:root-causes [:vector :seon.reconcile/root-cause]]]
 ;; Seon's own source imported at boot as main's program (seon.source), one fact per boot: the tree, its HEAD
 ;; commit (none when it is no repository), the revision it pins each reference-code submodule
 ;; at (its gitlink, what a cited reference-code file shows: seon.ref/file-view), the digest of
 ;; the files and pins read (a boot whose tree
 ;; reads the same imports nothing), its files and forms, the program entities the import
 ;; retracted, how long reading, analysing and transacting took, or why it was refused
 :seon.root/source [:map [:root :string] [:commit {:optional true} :string]
                    [:pins {:optional true} [:map-of :string :string]] [:digest {:optional true} :string]
                    [:files :int] [:forms :int] [:retracted {:optional true} :int] [:ms number?]
                    [:error {:optional true} :string]
                    ;; this boot's, and the tree's inputs with no program facts (seon.fx/inputs) when the running
                    ;; binary is built from this very tree: what its agents key their test results by;
                    ;; otherwise why not (:unshared)
                    [:boot {:optional true} :string] [:inputs {:optional true} :seon.program/inputs]
                    [:unshared {:optional true} :string]]
 ;; the next generation (docs/source.md#the-next-generation): the merges commit the :build effect
 ;; built (seon.fx/build), its worktree and binary and how long the build took, or why it was
 ;; refused; recorded by its asker, the reconciler; bin/root next starts the binary on this store
 :seon.root/generation [:map [:commit :string] [:checkout {:optional true} :string] [:binary {:optional true} :string] [:ms number?]
                        [:error {:optional true} :string]]
 ;; root's last collection of the store (seon.db/collect!, run by the writer when no agent is
 ;; live): how many keys it swept, how long it took, the branches it saw (a later collection
 ;; runs only once one of them is gone) and how many were gone since the one before
 :seon.root/collected [:map [:swept :int] [:ms number?] [:branches [:set :keyword]] [:gone :int]]
 ;; how a root ended: its boot, why (:stop! a caller's stop, :stdin-eof its owner closed its
 ;; stdin (bin/root stop), :signal SIGTERM, SIGINT or SIGHUP (Jolt's shutdown hooks), :unclean
 ;; no stop fact at all: SIGKILL or a crash, found by the next boot) and when
 :seon.root/end [:map [:boot :string] [:cause :keyword] [:at-ms :int]]
 ;; written by seon.root/stop! before anything stops, durable
 ;; root's file watcher (seon.watch, my.root/watch!): the roots it watches, this boot's; the
 ;; batches and paths it read; the rescans FSEvents asked for (events under a subtree it
 ;; coalesced or dropped, or a watched root moved: every kind loaded again), counted, the
 ;; newest with its path; or why it is not watching
 :seon.root/watch [:map [:roots [:vector :string]] [:boot :string]
                   [:batches nat-int?] [:paths nat-int?] [:rescans nat-int?]
                   [:last-rescan {:optional true} [:map [:path :string] [:kind [:enum :rescan :root]]]]
                   [:last-opened {:optional true} [:vector :string]]
                   ;; the last batch that loaded: each kind with the first record that made it
                   [:last-load {:optional true} [:map-of [:enum :docs :tasks :source] [:tuple [:enum :path :rescan :root] :string]]]
                   [:error {:optional true} :string]]
 ;; the outcome of root's last read of the task files (my.root/load-tasks!): how many files read, or
 ;; the refused read's message. A refused read's error names it as its subject
 ;; and is written in the same transaction, so it stays open until a good read writes another value
 ;; (seon.problems/closed?); the same outcome again writes no datom
 :seon.root/tasks [:or [:map [:files nat-int?]] [:map [:error :string]]]
 :seon.root/stopped :seon.root/end
 ;; what this boot found of the root before it on this main: its stop fact, or :unclean
 :seon.root/previous-end :seon.root/end
 :seon.root/root-fact [:map {:seon.db/attributes true :seon.render/keys [:seon.root/id :seon.root/boot :seon.root/generation :seon.root/quiescent] :seon.ctx/pattern [* {[:seon.agent/_root :as :agents :limit :seon.config.ctx/window :reverse true] [* {[:seon.agent/task :as :task] [:seon.task/id :seon.task/outcome :seon.task/reason]} {[:seon.process/_agent :as :processes] [*]} {[:seon.eval/_agent :as :evals :limit :seon.config.ctx/window :reverse true] [*]}]} {[:seon.eval/_agent :as :evals :limit :seon.config.ctx/window :reverse true] [*]}] :seon.render/html seon.render.ui/root}
                          [:seon.root/id :seon.root/id] [:seon.root/boot :seon.root/boot]
                          [:seon.root/started-by {:optional true} :seon.root/started-by]
                          [:seon.root/wiki {:optional true} :seon.root/wiki]
                          [:seon.root/stopped {:optional true} :seon.root/stopped]
                          [:seon.root/previous-end {:optional true} :seon.root/previous-end]
                          [:seon.root/quiescent {:optional true} :seon.root/quiescent]
                          [:seon.root/source {:optional true} :seon.root/source]
                          [:seon.root/watch {:optional true} :seon.root/watch]
                          [:seon.root/tasks {:optional true} :seon.root/tasks]
                          [:seon.root/generation {:optional true} :seon.root/generation]
                          [:seon.root/collected {:optional true} :seon.root/collected]
                          [:seon.config.agent/max-running {:optional true} :seon.config.agent/max-running]
                          [:seon.config.merge/max-running {:optional true} :seon.config.merge/max-running]]
 ;; ---- on every transaction Seon makes, in its tx-meta (seon.db/tx-meta) ----
 ;; the runtime that made it, as its compiled units are keyed (jolt.host/runtime-fingerprint:
 ;; Jolt's version, its runtime fingerprint, its trace tag; docs/storage.md#history)
 :seon.tx/runtime :string
 ;; the branch the transaction was written on: it travels with a merged datom, so the union
 ;; of every branch's history names who wrote what (seon.union)
 :seon.tx/branch [:and {:seon.db/index true} :keyword]
 ;; the eval whose code made it (its :seon.eval/id on the branch, "e5"): an agent's write during
 ;; an eval, its record's included (seon.agent/transact!); none outside an eval
 :seon.tx/eval [:string {:min 1}]
 ;; the branch a catch-up merged (seon.agent/merge-main!): what it applied is that branch's, not
 ;; the agent's, though :seon.tx/branch names the branch it was written on
 :seon.tx/merged :seon.db/branch
 :seon.tx/meta [:map {:seon.db/attributes true} [:seon.tx/runtime {:optional true} :seon.tx/runtime]
                [:seon.tx/branch {:optional true} :seon.tx/branch]
                [:seon.tx/eval {:optional true} :seon.tx/eval]
                [:seon.tx/merged {:optional true} :seon.tx/merged]]
 ;; a message between root and an agent, as a fact on the sender's branch: root's on main, an
 ;; agent's reply on its own; the union of every branch's history joins a conversation in one
 ;; query (seon.union). from and to name a task's agent (its branch),
 ;; "root", or "owner" (the page's message bar and the server's :message op, written by root):
 ;; an agent id starts again every boot, a run's names one worker for good. The agent that
 ;; takes a message writes the same fact on its own branch, and its turn's basis names it by id.
 ;; reply-to is the replied message's id, a value, since that message may be on a branch the
 ;; reply's is not
 :seon.message/id [:and {:seon.db/identity true :seon.db/content-id true} :string]
 :seon.message/from [:and {:seon.db/index true} :string]
 ;; the agent it is to, by its branch: the agent's identity across boots and wakes (task
 ;; seon.agent/the-agent-is-the-unit-not-the-run, A2)
 :seon.message/branch [:and {:seon.db/index true} :seon.db/branch]
 ;; the agent that took it (written by the turn that takes it, seon.agent/entries-tx)
 :seon.message/agent [:and {:seon.db/index true} :seon.db/ref]
 ;; the turn that read it: the number a model turn that takes it (seon.turn/take!) or the agent's code (seon.agent/messages)
 ;; takes it under; the loop's own messages (seon.turn/tell-error!) the next turn's
 :seon.message/turn :int
 :seon.message/body [:string]
 ;; what an entry is (design one-derivation 4.1 section 5): a person's words (:message), root's at a
 ;; stage boundary (:stage), the judge's verdict with its reasons (:verdict); each wakes its session
 :seon.message/kind [:and {:seon.db/index true} [:enum :message :stage :verdict]]
 :seon.message/reply-to [:and {:seon.db/index true} :string]
 :seon.message/fact [:map {:seon.db/attributes true :seon.render/html seon.render.ui/message :seon.render/model seon.context/message-messages} [:seon.message/id :seon.message/id] [:seon.message/from :seon.message/from]
                     [:seon.message/branch {:optional true} :seon.message/branch] [:seon.message/agent {:optional true} :seon.message/agent] [:seon.message/turn {:optional true} :seon.message/turn] [:seon.message/body :seon.message/body]
                     [:seon.message/kind {:optional true} :seon.message/kind]
                     [:seon.message/reply-to {:optional true} :seon.message/reply-to]]
 ;; ---- written by an agent on its own branch; they reach main with its merge ----
 ;; a catch-up: one merge of main into the agent's branch (seon.agent/merge-main!), written in the
 ;; merge's own transaction, so the agent's record holds what main brought it (its ctx's
 ;; :catch-ups, in the order they happened) and a view reads it as a fact
 :seon.catch-up/id [:and {:seon.db/identity true} :string]
 :seon.catch-up/agent [:and {:seon.db/index true} :seon.db/ref]
 ;; the branch merged in, and its t: main's head the catch-up merged
 :seon.catch-up/from :seon.db/branch
 :seon.catch-up/from-t :int
 ;; the program keys main changed that applied, and those that conflicted (left unmerged)
 :seon.catch-up/applied [:vector :seon.merge/program-key]
 :seon.catch-up/conflicts [:vector :seon.merge/conflict]
 :seon.catch-up/fact [:map {:seon.db/attributes true} [:seon.catch-up/id :seon.catch-up/id] [:seon.catch-up/agent :seon.catch-up/agent]
                      [:seon.catch-up/from :seon.catch-up/from] [:seon.catch-up/from-t :seon.catch-up/from-t]
                      [:seon.catch-up/applied :seon.catch-up/applied] [:seon.catch-up/conflicts :seon.catch-up/conflicts]]
 ;; (my.task/status) asked before any turn of this process observed its task: why, and what runs its proofs
 :seon.turn/not-observed [:and :seon.error/base [:map [:seon.error/type [:= :seon.turn/not-observed]]]]
 ;; a model's eval call left unrun because an earlier call of its reply threw (seon.repl/unrun): :after, that call's id
 :seon.turn/not-run [:and :seon.error/base [:map [:seon.error/type [:= :seon.turn/not-run]] [:after :string]]]
 ;; a turn whose agent's walk drew no status (its render threw, or no layout placed it): the done rule
 ;; cannot be read, so the run ends :error on it, never :green (seon.turn/status-now)
 :seon.turn/no-status [:and :seon.error/base [:map [:seon.error/type [:= :seon.turn/no-status]]]]
 ;; a model's eval call with no prose or no form, not run (seon.turn/call-problem): :problem why, :forms 0 for an empty one
 :seon.turn/invalid-call [:and :seon.error/base [:map [:seon.error/type [:= :seon.turn/invalid-call]] [:problem [:enum :no-prose :forms]] [:forms {:optional true} nat-int?]]]
 ;; a name an agent asked about (my.agent/source, callers, callees) that is no var on its branch nor
 ;; in its process: said, never answered as no callers or silence; :nearest the nearest existing
 ;; names (my.agent/no-var); :ask the form for the registry key of that name, when there is one
 :my.agent/no-var [:and :seon.error/base [:map [:seon.error/type [:= :my.agent/no-var]] [:name :symbol] [:nearest [:vector :symbol]] [:ask {:optional true} :string]]]
 ;; my.task/update! of a member to a value its schema does not admit (seon.task/member-tx): nothing written
 :seon.task/invalid-member [:and :seon.error/base [:map [:seon.error/type [:= :seon.task/invalid-member]] [:member :keyword]
                                                        ;; what the update would have made it, printed by the error's render (the one printer)
                                                        [:value :any]]]
 ;; ---- a process: one spawn of an agent, its telemetry on its own entity pointing at the agent
 ;; (seon.ctx/the-record-is-facts-about-the-work, move 2), so the agent's pull holds its work and no more; an agent's
 ;; current process is its newest (seon.task/current-process); root's agents card joins them
 ;; (docs/ctx.md#the-record-is-the-agents-work) ----
 ;; the agent's key and the process's pid (seon.task/agent-tx)
 :seon.process/id [:and {:seon.db/identity true} :string]
 :seon.process/agent [:and {:seon.db/index true} :seon.db/ref]
 :seon.process/pid :int
 :seon.process/mem-mb :double
 ;; the form it evaluates now; retracted when it returns
 :seon.process/running :string
 :seon.process/forked-ms :double
 :seon.process/ended-ms :int
 ;; root observed it stalled (seon.agent-proc's stall check: a request in flight, no frame past the bound), with
 ;; what it waits on (the request root last sent it: its kind and form, a test run's test); retracted when its
 ;; next frame arrives or it ends. An open :stalled problem while it holds (seon.problems/stalled-agents)
 :seon.process/stall [:map [:quiet-ms :int] [:last-op {:optional true} [:maybe :seon.agent/last-op]]]
  :seon.process/process-fact [:map {:seon.db/attributes true}
                          [:seon.process/id :seon.process/id] [:seon.process/agent :seon.process/agent]
                          [:seon.process/pid {:optional true} :seon.process/pid] [:seon.process/mem-mb {:optional true} :seon.process/mem-mb]
                          [:seon.process/running {:optional true} :seon.process/running]
                          [:seon.process/forked-ms {:optional true} :seon.process/forked-ms] [:seon.process/ended-ms {:optional true} :seon.process/ended-ms]
                          [:seon.process/stall {:optional true} :seon.process/stall]]
 ;; ---- a model call: one request to the model, on its own entity pointing at its agent (the turn is a
 ;; number on each record, docs/turn.md#the-turn-is-a-number: what a turn entity held is the model call's). Its reply, its
 ;; reasoning and how it stopped are the model's words; its tokens, sent and split are bookkeeping, which the agent's
 ;; pull leaves out (docs/ctx.md#the-record-is-the-agents-work); the debug page and the turn's header read it ----
 ;; "<agent key>/<n>", n the agent's turn it answers; an outside read of the context (seon.turn/context-block) "<agent key>/read-<k>"
 :seon.model-call/id [:and {:seon.db/identity true} :string]
 ;; the agent whose request it is, and the turn it answers (a model's: :seon.agent/turn when it started) or the read's own
 ;; counter k (an outside read moves no turn)
 :seon.model-call/agent [:and {:seon.db/index true} :seon.db/ref]
 :seon.model-call/n :int
 ;; who read the context: the agent's model, or an outside agent through the server (a read is a call)
 :seon.model-call/origin [:enum :model :outside]
 ;; the model's reply: its text (a reply that called nothing is a message to the user), its reasoning as returned and the
 ;; provider's finish_reason; truncated, the reply stopped at max-tokens and its text was cut
 :seon.model-call/reply [:string]
 :seon.model-call/reasoning [:string]
 :seon.model-call/finish :string
 :seon.model-call/truncated :boolean
 ;; a call that failed: the typed error as data (the agent's end holds it too, :seon.agent/error)
 :seon.model-call/error :seon.error/base
 :seon.model-call/forms :int
 :seon.model-call/errors :int
 :seon.model-call/red :int
 :seon.model-call/ms :int
 :seon.model-call/tokens :int
 ;; the prompt tokens the provider served from its prefix cache, and those it did not, as its
 ;; usage reported them (absent when it did not: nobody measured them)
 :seon.model-call/cache-hit-tokens :int
 :seon.model-call/cache-miss-tokens :int
 ;; the model that answered
 :seon.model-call/model :string
 ;; what the reader's context was built from, never its text (a model call stores its basis,
 ;; not its prompt): the commit it read, its task, run and turn, the observations no db
 ;; holds (the proofs' results, red assertions, reasons, the run's errors), whether the
 ;; branch's unmerged entries show, and the last evaluations' transcript while no earlier turn
 ;; shows them. seon.context/render makes the exact user message from it on that commit.
 :seon.model-call/basis [:map [:commit :uuid] [:task :seon.task/id]
                   [:turn :int] [:max-turns :int] [:origin :seon.model-call/origin]
                   [:merge? {:optional true} :boolean]
                   ;; the session id its request opens its own session with, when it names one (the agent's key else)
                   [:session {:optional true} :string]
                   ;; the agent whose record the request renders (its key)
                   [:agent {:optional true} :string]
                   ;; the run's own model, when it names one (seon.config/provider-at)
                   [:model {:optional true} :string]]
 ;; what a model turn's request sent, the records it rendered in order (seon.context/request, parts-of):
 ;; the system prompt's section and the task, each as of a t; an eval or message by id, an eval with the fold it was
 ;; sent with (its value or output an earlier record showed: the handle there); a reply (its text and reasoning, and its calls' place among them) by its model call's id
 :seon.model-call/sent [:vector [:or [:tuple [:enum :section :task] :int :int] [:tuple [:enum :eval :message :reply :session] :string]
                                      ;; an example session a request sent whole (seon.context/example-messages), as of its newest record's t
                                      [:tuple [:= :example] :string :int] [:tuple [:= :eval] :string [:map-of :keyword :symbol]]
                                      ;; the page's parts a request sent: the agent, the commit they are drawn at on replay, whole?, their ids, the model call that sent them
                                      [:tuple [:= :parts] :int :uuid :boolean [:vector :string] :string]
                                      ;; the content hash of every part the model has after the request: what the next compares
                                      [:tuple [:= :hashes] [:map-of :string :uuid]]]]
 ;; where the turn's time went, as the agent saw it: the proof run, the context render, the
 ;; model round trip, the reply's evaluations, the turn's record (ms)
 :seon.model-call/split [:map [:tests-ms {:optional true} :int] [:context-ms :int]
                   [:model-ms {:optional true} :int] [:eval-ms {:optional true} :int] [:record-ms {:optional true} :int]]
 :seon.model-call/fact [:map {:seon.db/attributes true :seon.render/html seon.render.ui/turn :seon.render/model seon.context/turn-messages}
                          [:seon.model-call/id :seon.model-call/id] [:seon.model-call/agent {:optional true} :seon.model-call/agent]
                          [:seon.model-call/n {:optional true} :seon.model-call/n] [:seon.model-call/origin {:optional true} :seon.model-call/origin]
                          [:seon.model-call/reply {:optional true} :seon.model-call/reply]
                          [:seon.model-call/reasoning {:optional true} :seon.model-call/reasoning] [:seon.model-call/finish {:optional true} :seon.model-call/finish]
                          [:seon.model-call/truncated {:optional true} :seon.model-call/truncated] [:seon.model-call/error {:optional true} :seon.model-call/error]
                          [:seon.model-call/forms {:optional true} :seon.model-call/forms] [:seon.model-call/errors {:optional true} :seon.model-call/errors]
                          [:seon.model-call/red {:optional true} :seon.model-call/red] [:seon.model-call/ms {:optional true} :seon.model-call/ms]
                          [:seon.model-call/tokens {:optional true} :seon.model-call/tokens]
                          [:seon.model-call/cache-hit-tokens {:optional true} :seon.model-call/cache-hit-tokens]
                          [:seon.model-call/cache-miss-tokens {:optional true} :seon.model-call/cache-miss-tokens]
                          [:seon.model-call/model {:optional true} :seon.model-call/model]
                          [:seon.model-call/basis {:optional true} :seon.model-call/basis] [:seon.model-call/sent {:optional true} :seon.model-call/sent]
                          [:seon.model-call/split {:optional true} :seon.model-call/split]]
 ;; ---- a first move scored (seon.judge, my.root/first-moves!) ----
 ;; the digest of the request it answers (seon.judge/digest): the same context is scored once
 :seon.judge/digest [:and {:seon.db/identity true} :string]
 :seon.judge/task :seon.task/id
 ;; the score from the compiler's facts, with the version that served the context (root's
 ;; source tree and its commit), the reply's eval calls and their cost in USD when priced
 :seon.judge/score [:map [:acted :boolean] [:right-var :boolean] [:right-test :boolean]
                    [:waste :int] [:uncompiled :int] [:green :boolean] [:version [:map [:root {:optional true} :string] [:commit {:optional true} :string]]]
                    [:calls [:vector :string]] [:usd {:optional true} number?]
                    ;; the scoring that made it (seon.judge/scorer): other scoring scores the calls again
                    [:scorer :string]]
 ;; a pass that stopped at its budget: what it spent, the bound, the tasks it left
 :seon.judge/stopped [:map [:usd number?] [:bound number?] [:left [:vector :seon.task/id]]]
 :seon.judge/judge-fact [:map {:seon.db/attributes true}
                         [:seon.judge/digest :seon.judge/digest] [:seon.judge/task {:optional true} :seon.judge/task]
                         [:seon.judge/score {:optional true} :seon.judge/score] [:seon.judge/stopped {:optional true} :seon.judge/stopped]
                         [:seon.model-call/tokens {:optional true} :seon.model-call/tokens]
                         [:seon.model-call/cache-hit-tokens {:optional true} :seon.model-call/cache-hit-tokens]
                         [:seon.model-call/cache-miss-tokens {:optional true} :seon.model-call/cache-miss-tokens]]
 ;; ---- an effect's outcome, recorded by its asker on its own branch (seon.fx, session FX1) ----
 :seon.fx/id [:and {:seon.db/identity true} :string]
 :seon.fx/kind :keyword
 :seon.fx/status :keyword
 :seon.fx/us :int
 :seon.fx/queue-us :int
 :seon.fx/cost :int
 :seon.fx/error :string
 :seon.fx/fx-fact [:map {:seon.db/attributes true}
                     [:seon.fx/id :seon.fx/id] [:seon.fx/kind :seon.fx/kind] [:seon.fx/status :seon.fx/status]
                     [:seon.fx/us :seon.fx/us] [:seon.fx/queue-us :seon.fx/queue-us]
                     [:seon.fx/cost {:optional true} :seon.fx/cost] [:seon.fx/error {:optional true} :seon.fx/error]]
 ;; ---- the program merge's facts (session D1's proto.merge.facts.edn) ----
 :seon.merge/key [:and {:seon.db/index true} :seon.db/plain]
 :seon.merge/kind :keyword
 :seon.merge/base :seon.db/plain
 :seon.merge/ours :seon.db/plain
 :seon.merge/theirs :seon.db/plain
 :seon.merge/main-t :int
 :seon.merge/resolved? :boolean
 :seon.merge/entry-fact [:map {:seon.db/attributes true}
                          [:seon.merge/key :seon.merge/key] [:seon.merge/kind :seon.merge/kind]
                          [:seon.merge/base {:optional true} :seon.merge/base] [:seon.merge/ours {:optional true} :seon.merge/ours]
                          [:seon.merge/theirs {:optional true} :seon.merge/theirs]
                          [:seon.merge/main-t {:optional true} :seon.merge/main-t] [:seon.merge/resolved? {:optional true} :seon.merge/resolved?]]}
