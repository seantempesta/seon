 ;; process's status, its branch and turns, when it started, its name when it is a user, its task; the agents it started again, to
 ;; :seon.config.render/agent-tree-depth levels (a depth join), and below the last only their ids (its :below option), so an entry says how
 ;; many are below it (docs/ctx.md#the-pattern)
 :seon.agent/entry [:map {:description "What an agent's entry reads where a user's pull joins the agents it started, to the configured depth (a depth join), and below the last level their ids alone (its :below option). See docs/users.md#whats-on-screen." :seon.ctx/pattern [:seon.agent/key :seon.user/name :seon.agent/status :seon.agent/branch :seon.agent/turn :seon.agent/outcome :seon.agent/ended-turn :seon.agent/started-ms {:seon.agent/task [:seon.task/id :seon.task/plan :seon.task/outcome :seon.task/reason {:seon.task/started-by [:seon.user/name]}]} {[:seon.agent/agents :below [:db/id]] :seon.config.render/agent-tree-depth}]}]
 :seon.db/user-fact [:and {:seon.db/attributes true :seon.ctx/required {:seon.agent/agents "the sessions you started"} :seon.render/hiccup seon.render.ui/agent :seon.ctx/pattern [:seon.agent/key :seon.user/name :seon.render/hiccup {:seon.agent/agents :seon.agent/entry}]} :seon.db/agent-fact [:map [:seon.user/name :seon.user/name] [:seon.user/focus {:optional true} :seon.user/focus]]]
 ;; ---- a citation: what an entity cites, an entity of its own (docs/references.md#an-entity-cites) ----
 ;; its content id, "<of> <target>": the citing entity's identity value (a task's :seon.task/id, an agent's
 ;; :seon.agent/key) and its target's (seon.ref/target-value: an address, a name, an id, a key or a path)
 :seon.cite/id [:and {:seon.db/identity true :seon.db/content-id true :description "The cite's identity: the citing entity's identity value and its target's, joined by a space."} :string]
 ;; the citing entity: a task (its text's, written by seon.task/cites-tx with the text) or an agent
 ;; (my.agent/cite!, and :seon.config.agent/cites written when the agent is made)
 :seon.cite/of [:and {:seon.db/to [:seon.task/task-fact :seon.db/agent-fact] :description "The citing entity: a task or an agent."} :seon.db/ref]
 ;; what it cites: a section, a var, a task, a schema entry, a namespace or a file, written as the lookup of its
 ;; identity (seon.ref/target), which resolves against what the same write made before it; a lookup to nothing is refused,
 ;; :seon.db/no-target (docs/references.md#an-entity-cites)
 :seon.cite/target [:and {:seon.db/to [:seon.doc/fact :seon.db/var-fact :seon.task/task-fact :seon.db/schema-fact :seon.db/ns-fact :seon.db/file-fact] :description "What it cites: a section, a var, a task, a schema entry, a namespace or a file. See docs/references.md#an-entity-cites."} :seon.db/ref]
 :seon.cite/depth [:and {:description "How much of the cited target the cite shows."} :seon.ref/depth]
 ;; its first mention's place in the citing text (an agent's: the order its cites were written)
 :seon.cite/order [:int {:description "The place of the cite's first mention in the citing text."}]
 ;; a search an agent's context holds: what it asks, drawn at each page draw by seon.ctx.search/search on the
 ;; branch's db (seon.render.ui/searched), so a change of its query (a swap! on ctx) redraws that part alone
 :seon.search/id [:and {:seon.db/identity true :seon.db/content-id true :description "The search's identity."} :string]
 ;; the entity whose context holds it: a task (its request's, written with the task) or an agent
 :seon.search/of [:and {:seon.db/to [:seon.task/task-fact :seon.db/agent-fact] :description "The entity whose context holds the search: a task or an agent."} :seon.db/ref]
 ;; the words searched: matched as words, by meaning and by the names they hold (seon.ctx.search/search)
 :seon.search/query [:string {:description "The words searched: matched as words, by meaning and by the names they hold."}]
 ;; how many hits are shown, when the search asks other than :seon.config.render/search
 :seon.search/k [:and {:description "How many hits are shown, when the search asks for other than the configured number."} pos-int?]
 :seon.search/search-fact [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/searched :seon.ctx/pattern [:seon.search/id :seon.search/query :seon.search/k]}
                           [:seon.search/id :seon.search/id] [:seon.search/of {:optional true} :seon.search/of] [:seon.search/query :seon.search/query]
                           [:seon.search/k {:optional true} :seon.search/k]]
 ;; what the cite's render (seon.render.ui/cite) reads of its owner from the db, by the owner's identity the cite holds: a function in
 ;; the task's namespace, or among its proofs' forms' refs, is one it will change (docs/references.md#an-entity-cites)
 :seon.cite/of-read [:map {:seon.ctx/pattern [:seon.task/id :seon.task/ns {[:seon.task/proofs :by :var/name :as :proved] [:var/name {:var/form [:form/refs]}]}]}]
 ;; what the cite's render reads of its target from the db, by the target's identity the cite holds: the union of what each kind
 ;; of target shows (a section with its sections below; a var with its form and newest callers, each caller with the vars it
 ;; defines; a task; a schema key's entry; a namespace), so ctx holds what is cited and the page what it says (docs/references.md#an-entity-cites)
 :seon.cite/target-read [:map {:seon.ctx/pattern [:seon.doc/address :seon.doc/heading :seon.doc/lead :seon.doc/text :seon.doc/references
                                                  {:seon.doc/_parent [:seon.doc/address :seon.doc/heading]}
                                                  :var/name :var/ns :var/doc :var/meta :seon.test/status :seon.test/failures :seon.test/ticks :seon.test/bytes
                                                  {:var/form [:form/id :form/src :form/defines :form/refs :form/quoted :form/keywords]}
                                                  {[:form/_refs :by :var/name :as :callers :limit :seon.config.ctx/callers :reverse true]
                                                   [:form/id :form/src :form/refs :form/quoted :form/keywords {:form/defines [:var/name :var/meta]}]}
                                                  :seon.task/id :seon.task/plan :seon.task/kind
                                                  :schema/key :schema/form
                                                  :ns/name :ns/doc
                                                  :file/path]}]
