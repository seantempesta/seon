#:seon.sci.kernel{:arm
                  [:fn
                   {:error/message
                    "must be a live arm value from seon.sci.kernel/current-arm"
                    :gen/gen seon.sci.kernel/arm-generator}
                   seon.sci.kernel/arm?],
                  :failure-request
                  [:map
                   [:seon.fn/sym {:optional true} :seon.fn/sym]
                   [:seon.sci.kernel/time-limit-kind :qualified-keyword]
                   [:seon.sci.kernel/failure-kind :qualified-keyword]
                   [:seon.sci.eval/form {:optional true :description "The form the failing evaluation ran, which an allocation-bound error names."} :seon.batch/form]
                   [:seon.config.eval/alloc-limit-bytes {:optional true} :seon.config.eval/alloc-limit-bytes]],

 ; A kernel guard's refusal: it names the guard's observation (a deadline
 ; that fired, a symbol with no installed Var, an unadmittable failure).
 :seon.sci.kernel/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.kernel/guard-observation
   :seon.sci.kernel/guard-observation]]]

 ; An evaluation cut by its allocation bound (seon.sci.kernel/failure-value,
 ; outcome :alloc): the bound the request carried, the allocation its arm
 ; measured past it, and the form that ran.
 :seon.sci.kernel/alloc-limit-error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.kernel/guard-observation :seon.sci.kernel/guard-observation]
  [:seon.eval/allocated-bytes :seon.eval/allocated-bytes]
  [:seon.config.eval/alloc-limit-bytes :seon.config.eval/alloc-limit-bytes]
  [:seon.error/offending {:optional true} :seon.batch/form]]]

 ; An agent's own exception, as seon.sci.kernel/failure-value reports it the
 ; way clojure.main does: the class the author's code threw, its message, the
 ; chain with ex-data and first-party frames per link, kept whole, and SCI's
 ; author stacktrace; its pair selects what an agent sees. No bookkeeping:
 ; duration, allocation and outcome stay on the evaluation record.
 :seon.sci.kernel/execution-error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.error/exception-class :seon.error/exception-class]
  [:seon.sci.eval/stacktrace {:optional true} :seon.sci.eval/stacktrace]]]

 :seon.sci.kernel/pool :string
 :seon.sci.kernel/used-bytes :int
 :seon.sci.kernel/max-bytes :int
 :seon.sci.kernel/collections :int
 :seon.sci.kernel/enter-bytes :int
 :seon.sci.kernel/resume-bytes :int
 :seon.sci.kernel/entered-at inst?
 :seon.sci.kernel/thread [:string {:description "The name of the thread that owns an evaluation's arm."}]
 :seon.sci.kernel/form-head [:symbol {:description "The head symbol of the form an evaluation is on (seon.sci.kernel/evaluating!)."}]
 :seon.sci.kernel/running
 [:map {:description "One evaluation running under its own arm (seon.sci.kernel/running-evaluations): its thread, whose work it is, the form it is on, and its wall time and allocation so far."}
  [:seon.sci.kernel/thread :seon.sci.kernel/thread]
  [:seon.eval/duration-ms :seon.eval/duration-ms]
  [:seon.eval/allocated-bytes :seon.eval/allocated-bytes]
  [:seon.agent/id {:optional true} :seon.agent/id]
  [:seon.boot/cluster-name {:optional true} :seon.boot/cluster-name]
  [:seon.store/branch {:optional true} :seon.store/branch]
  [:seon.sci.kernel/form-head {:optional true} :seon.sci.kernel/form-head]]
 :seon.sci.kernel/in-flight [:vector {:description "The evaluations running in this process, most allocation first."} :seon.sci.kernel/running]
 :seon.sci.kernel/memory-pressure
 [:map
  [:seon.sci.kernel/pool :seon.sci.kernel/pool]
  [:seon.sci.kernel/used-bytes :seon.sci.kernel/used-bytes]
  [:seon.sci.kernel/max-bytes :seon.sci.kernel/max-bytes]
  [:seon.sci.kernel/collections :seon.sci.kernel/collections]
  [:seon.sci.kernel/enter-bytes :seon.sci.kernel/enter-bytes]
  [:seon.sci.kernel/resume-bytes :seon.sci.kernel/resume-bytes]
  [:seon.sci.kernel/entered-at :seon.sci.kernel/entered-at]
  [:seon.sci.kernel/in-flight {:optional true} :seon.sci.kernel/in-flight]]
 :seon.sci.kernel/memory-pressure-error
 [:merge :seon.error/base :seon.sci.kernel/memory-pressure]

 :seon.sci.kernel/guard-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]
}
