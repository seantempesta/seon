#:seon.sci.kernel{:arm
                  [:fn
                   {:error/message
                    "must be a live arm value from seon.sci.kernel/current-arm"
                    :gen/gen seon.sci.kernel/arm-generator}
                   seon.sci.kernel/arm?],
                  :failure-request
                  [:map
                   [:seon.fn/sym {:optional true} :seon.fn/sym]
                   [:seon.sci.kernel/time-limit-kind :qualified-keyword]
                   [:seon.sci.kernel/failure-kind :qualified-keyword]],

 ; A kernel guard's refusal: it names the guard's observation (a deadline
 ; that fired, a symbol with no installed Var, an unadmittable failure).
 :seon.sci.kernel/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.kernel/guard-observation
   :seon.sci.kernel/guard-observation]]]

 ; An agent's own exception, as seon.sci.kernel/failure-value reports it the
 ; way clojure.main does: the class the author's code threw, its message, the
 ; chain with ex-data per link, and SCI's author stacktrace. No bookkeeping:
 ; duration, allocation and outcome stay on the evaluation record.
 :seon.sci.kernel/execution-error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.error/exception-class :seon.error/exception-class]
  [:seon.sci.eval/stacktrace {:optional true} :seon.sci.eval/stacktrace]]]

 :seon.sci.kernel/pool :string
 :seon.sci.kernel/used-bytes :int
 :seon.sci.kernel/max-bytes :int
 :seon.sci.kernel/enter-bytes :int
 :seon.sci.kernel/resume-bytes :int
 :seon.sci.kernel/entered-at inst?
 :seon.sci.kernel/in-flight [:vector [:tuple :seon.agent/id :seon.turn/id]]
 :seon.sci.kernel/memory-pressure
 [:map
  [:seon.sci.kernel/pool :seon.sci.kernel/pool]
  [:seon.sci.kernel/used-bytes :seon.sci.kernel/used-bytes]
  [:seon.sci.kernel/max-bytes :seon.sci.kernel/max-bytes]
  [:seon.sci.kernel/enter-bytes :seon.sci.kernel/enter-bytes]
  [:seon.sci.kernel/resume-bytes :seon.sci.kernel/resume-bytes]
  [:seon.sci.kernel/entered-at :seon.sci.kernel/entered-at]
  [:seon.sci.kernel/in-flight :seon.sci.kernel/in-flight]]
 :seon.sci.kernel/memory-pressure-error
 [:and {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :seon.error/base :seon.sci.kernel/memory-pressure]

 :seon.sci.kernel/guard-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]
}
