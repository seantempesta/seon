#:my.root{:instructions [:map {:description "The laws root applies to merge requests and agents, as data (my.root/instructions)."}
                         [:my.root/laws [:vector [:string {:min 1}]]]]
          :open-assignment [:map {:description "An open assignment as root reads it: its key, task, branch, merge base and the end main holds."}
                            [:seon.task/assignment :seon.task/assignment] [:seon.task/assigned :seon.task/assigned]
                            [:seon.task/branch :seon.task/branch] [:seon.task/merge-base {:optional true} :seon.task/merge-base]
                            [:seon.task.attempt/end {:optional true} :seon.task.attempt/end]]
          :merge-request [:and {:description "An open merge request, the assignment, as root reads it, with the merge and the close offered."}
                          :my.root/open-assignment [:map [:seon.render/operations :seon.render/operations]]]
          :merge-requests [:vector :my.root/merge-request]
          :merge-request-read [:map [:seon.db/db :seon.db/database-value]]
          :merge-request-request [:map {:description "The open assignment root merges, into the checkout :seon.fn/root (the cluster's :seon.config.fs/working-root when absent)."}
                                  [:my.program/context :my.program/context] [:seon.task/assignment :seon.task/assignment]
                                  [:seon.fn/root {:optional true} :seon.fn/root]]
          :close-request [:map {:description "The open assignment root closes without merging, and why."}
                          [:my.program/context :my.program/context] [:seon.task/assignment :seon.task/assignment]
                          [:seon.task/reason :seon.task/reason]]
          :ended [:vector {:description "The task ends in root's unread inbox, each as the value its end message stands for."} :seon.task/ended]}
