#:seon.cluster.run{:agent :seon.db/ref,
                   :background-results [:set :seon.db/ref],
                   :closed-at :inst,
                   :error [:string {:min 1}],
                   :forms
                   [:set #:seon.db{:component true} :seon.db/ref],
                   :id [:string {:min 1, :seon.db/identity true}],
                   ;; PRESENCE IS THE STATE: a run carries this exactly
                   ;; when a dead process's custody of it was recovered.
                   ;; The receipt-level twin says which FORM was cut; a
                   ;; run whose dead process left no receipt row has no
                   ;; form-level evidence at all, and this is the only
                   ;; fact separating it from a normal close.
                   :interrupted-at :inst,
                   :live-processes [:set :seon.cluster.run/process],
                   :missing-results [:int {:min 0}],
                   :opening-commit-id :uuid,
                   :opened-at :inst,
                   :plan-digest [:string {:min 1}],
                   :process [:string {:min 1}],
                   :starting-ns :seon.db/ref,
                   :supersedes [:set :seon.db/ref],
                   :system-run-request
                   [:map
                    [:seon.cluster.agent/id :seon.cluster.agent/id]
                    [:seon.cluster.run/id :seon.cluster.run/id]
                    [:seon.cluster.run/process :seon.cluster.run/process]
                    [:seon.cluster.run/opened-at :seon.cluster.run/opened-at]
                    [:seon.cluster.run/starting-ns :seon.cluster.run/starting-ns]
                    [:seon.cluster.run/plan-digest :seon.cluster.run/plan-digest]
                    [:seon.cluster.run/sources :seon.cluster.reply/sources]
                    [:seon.cluster.run/trigger {:optional true} :seon.cluster.run/trigger]],
                   :run
                   [:map
                    {:seon.db/entity true,
                     :seon.render/ai seon.cluster.run/render-ai,
                     :seon.render/html seon.cluster.run/render-html}
                    [:seon.cluster.run/id :seon.cluster.run/id]
                    [:seon.cluster.run/agent :seon.cluster.run/agent]
                    [:seon.cluster.run/trigger
                     {:optional true}
                     :seon.cluster.run/trigger]
                    [:seon.cluster.run/background-results
                     {:optional true}
                     :seon.cluster.run/background-results]
                    [:seon.cluster.run/opened-at
                     :seon.cluster.run/opened-at]
                    [:seon.cluster.run/opening-commit-id
                     {:optional true}
                     :seon.cluster.run/opening-commit-id]
                    [:seon.cluster.run/starting-ns
                     {:optional true}
                     :seon.cluster.run/starting-ns]
                    [:seon.cluster.run/supersedes
                     {:optional true}
                     :seon.cluster.run/supersedes]
                    [:seon.cluster.run/closed-at
                     {:optional true}
                     :seon.cluster.run/closed-at]
                    [:seon.cluster.run/interrupted-at
                     {:optional true}
                     :seon.cluster.run/interrupted-at]
                    [:seon.cluster.run/process
                     {:optional true}
                     :seon.cluster.run/process]
                    [:seon.cluster.run/plan-digest
                     {:optional true}
                     :seon.cluster.run/plan-digest]
                    [:seon.cluster.run/error
                     {:optional true}
                     :seon.cluster.run/error]],
                   :trigger [:and #:seon.db{:index true} :seon.db/ref],
                   :rule :keyword,
                   :transition :keyword,
                   :refused :seon.cluster.run/rule
                   :refused-error [:and {:seon.error/class true :seon.error/refusal true :seon.error/refusal-shape :seon.error/refusal-value :seon.render/ai seon.error/refusal-prose :seon.render/html seon.error/render-html :gen/schema [:map [:seon.cluster.run/refused :seon.cluster.run/refused] [:seon.error/message :seon.error/message]] :error/message "must identify the run rule that refused its transition"} :seon.error/refusal-value [:map [:seon.cluster.run/refused :seon.cluster.run/refused]]]}
