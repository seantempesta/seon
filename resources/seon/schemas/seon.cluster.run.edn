#:seon.cluster.run{:agent
                   [:and
                    {:description
                     "The agent whose run this is; its reverse is that agent's own evaluation history.",
                     :seon.render/ai
                     seon.render.transcript/render-history-ai,
                     :seon.render/html
                     seon.render.transcript/render-history-html}
                    :seon.db/ref],
                   :background-results [:set :seon.db/ref],
                   :closed-at :inst,
                   :error [:string {:min 1}],
                   :id [:string {:min 1, :seon.db/identity true}],
                   :generated-form-request
                   [:map
                    [:seon.cluster.run/id :seon.cluster.run/id]

                    [:seon.cluster.eval/at :seon.cluster.eval/at]
                    [:seon.cluster.eval/ordinal
                     :seon.cluster.eval/ordinal]
                    [:seon.cluster.eval/source
                     :seon.cluster.eval/source]
                    [:seon.cluster.eval/comment
                     {:optional true}
                     :seon.cluster.eval/comment]
                    [:seon.ns/name :seon.ns/name]],

                   :missing-results [:int {:min 0}],
                   :opened-at :inst,
                   :plan-digest [:string {:min 1}],
                   :reply [:string {:seon.db/no-history? true}],
                   :reply-blob :seon.blob/digest,
                   :reply-size [:int {:min 0}],

                   :starting-ns :seon.db/ref,
                   :supersedes [:set :seon.db/ref],
                   :evaluation-facts-request
                   [:map
                    [:seon.cluster.run/id :seon.cluster.run/id]

                    [:seon.cluster.eval/ordinal :seon.cluster.eval/ordinal]
                    [:seon.sci.eval/evaluation :seon.cluster.loop/evaluation]
                    [:seon.cluster.loop/settlement-evaluation :seon.cluster.loop/evaluation]
                    [:seon.problems/form-problem {:optional true} :seon.problems/form-problem]

                    [:my.run/value {:optional true} :my.run/value]],
                   :record-evaluated-request
                   [:map
                    [:seon.cluster.loop/cluster :seon.cluster.loop/cluster]
                    [:seon.db/db :seon.db/database-value]
                    [:seon.cluster.run/id :seon.cluster.run/id]
                    [:seon.cluster.run/agent :seon.cluster.run/agent]
                    [:seon.cluster.run/starting-ns :seon.cluster.run/starting-ns]
                    [:seon.cluster.run/reply :seon.cluster.run/reply]
                    [:seon.cluster.run/opened-at :seon.cluster.run/opened-at]
                    [:seon.cluster.run/closed-at :seon.cluster.run/closed-at]
                    [:seon.cluster.loop/evaluated-sources
                     [:vector
                      [:and :seon.cluster.loop/evaluated-source
                       [:map
                        [:seon.sci.eval/evaluation
                         [:map [:seon.cluster.eval/at :seon.cluster.eval/at]]]]]]]],
                   :record-evaluated-call-request
                   [:map
                    [:seon.cluster.run/id :seon.cluster.run/id]
                    [:seon.cluster.run/agent :seon.cluster.run/agent]
                    [:seon.cluster.run/starting-ns :seon.cluster.run/starting-ns]
                    [:seon.cluster.run/opened-at :seon.cluster.run/opened-at]
                    [:seon.cluster.run/closed-at :seon.cluster.run/closed-at]
                    [:seon.cluster.run/reply {:optional true} :seon.cluster.run/reply]
                    [:seon.cluster.run/reply-blob {:optional true} :seon.cluster.run/reply-blob]
                    [:seon.cluster.run/reply-size :seon.cluster.run/reply-size]
                    [:seon.cluster.run/sources :seon.cluster.reply/sources]
                    [:seon.cluster.run/evaluations
                     [:vector [:and :seon.cluster.eval/settle-request
                               [:map
                                [:seon.cluster.eval/at :seon.cluster.eval/at]
                                [:seon.cluster.eval/source :seon.cluster.eval/source]
                                [:seon.cluster.eval/ns :seon.cluster.eval/ns]]]]]],
                   :system-run-request
                   [:map
                    [:seon.cluster.agent/id :seon.cluster.agent/id]
                    [:seon.cluster.run/id :seon.cluster.run/id]

                    [:seon.cluster.run/opened-at :seon.cluster.run/opened-at]
                    [:seon.cluster.run/starting-ns :seon.cluster.run/starting-ns]
                    [:seon.cluster.run/plan-digest :seon.cluster.run/plan-digest]
                    [:seon.cluster.run/sources :seon.cluster.reply/sources]
                    [:seon.cluster.run/reply {:optional true} :seon.cluster.run/reply]
                    [:seon.cluster.run/reply-blob {:optional true} :seon.cluster.run/reply-blob]
                    [:seon.cluster.run/reply-size {:optional true} :seon.cluster.run/reply-size]
                    [:seon.cluster.run/trigger {:optional true} :seon.cluster.run/trigger]],
                   :generated-run-request
                   [:map
                    [:seon.cluster.agent/id :seon.cluster.agent/id]
                    [:seon.cluster.run/id :seon.cluster.run/id]

                    [:seon.cluster.run/opened-at :seon.cluster.run/opened-at]
                    [:seon.cluster.run/starting-ns :seon.cluster.run/starting-ns]
                    [:seon.cluster.run/trigger {:optional true}
                     :seon.cluster.run/trigger]],
                   :run
                   [:map
                    {:seon.db/attributes true,
                     :seon.render/ai seon.render.transcript/render-run-ai,
                     :seon.render/html seon.render.transcript/render-run-html}
                    [:seon.cluster.run/id :seon.cluster.run/id]
                    [:seon.cluster.run/agent :seon.cluster.run/agent]
                    [:seon.cluster.run/trigger
                     {:optional true}
                     :seon.cluster.run/trigger]
                    [:seon.cluster.run/background-results
                     {:optional true}
                     :seon.cluster.run/background-results]
                    [:seon.cluster.run/opened-at
                     :seon.cluster.run/opened-at]
                    [:seon.cluster.run/starting-ns
                     {:optional true}
                     :seon.cluster.run/starting-ns]
                    [:seon.cluster.run/supersedes
                     {:optional true}
                     :seon.cluster.run/supersedes]
                    [:seon.cluster.run/closed-at
                     {:optional true}
                     :seon.cluster.run/closed-at]

                    [:seon.cluster.run/undisposed-at
                     {:optional true}
                     :seon.cluster.run/undisposed-at]

                    [:seon.cluster.run/plan-digest
                     {:optional true}
                     :seon.cluster.run/plan-digest]
                    [:seon.cluster.run/reply
                     {:optional true}
                     :seon.cluster.run/reply]
                    [:seon.cluster.run/reply-blob
                     {:optional true}
                     :seon.cluster.run/reply-blob]
                    [:seon.cluster.run/reply-size
                     {:optional true}
                     :seon.cluster.run/reply-size]
                    [:seon.cluster.work/situation
                     {:optional true}
                     :seon.cluster.work/situation]
                    [:seon.cluster.run/error
                     {:optional true}
                     :seon.cluster.run/error]],
                   :trigger [:and #:seon.db{:index true} :seon.db/ref],
                   :turns-remaining [:int {:min 0}],
                   ;; PRESENCE IS THE STATE: the run loop asserts this in
                   ;; the same transaction that closes the last clean form
                   ;; exactly when no complete/wait disposition was returned.
                   :undisposed-at :inst,
                   :rule :keyword,
                   :transition :keyword,
                   :refused :seon.cluster.run/rule
                   :refused-error [:and {:seon.error/class true :seon.error/refusal true :seon.error/refusal-shape :seon.error/refusal-value :seon.render/ai seon.error/refusal-prose :seon.render/html seon.error/render-html :gen/schema [:map [:seon.cluster.run/refused :seon.cluster.run/refused] [:seon.error/message :seon.error/message]] :error/message "must identify the run rule that refused its transition"} :seon.error/refusal-value [:map [:seon.cluster.run/refused :seon.cluster.run/refused]]]
 :seon.cluster.run/missing-opening-datom [:= true]
 :seon.cluster.run/missing-opening-datom-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.cluster.run/missing-opening-datom class marker"} [:seon.cluster.run/missing-opening-datom :seon.cluster.run/missing-opening-datom] [:seon.error/message :seon.error/message]]}
