;; The program merge's named schemas (session M1's proto.merge.edn).
{:seon.merge/data-attrs [:or [:= :all] [:set :keyword]]
 ;; a definition (var, multimethod method, protocol extension, namespace), a form (the
 ;; unit main evaluates), or a datum of declared data
 :seon.merge/program-key [:or [:tuple [:= :var] :qualified-symbol]
                   [:tuple [:= :method] :qualified-symbol :any]
                   [:tuple [:= :impl] :qualified-symbol :string]
                   [:tuple [:= :ns] :symbol]
                   [:tuple [:= :form] :string]
                   [:tuple [:= :schema] :qualified-keyword]
                   [:tuple [:= :section] :string]
                   [:tuple [:= :config] :qualified-keyword]
                   [:tuple [:= :script] :string]
                   [:tuple [:= :datum] :int :keyword]
                   [:tuple [:= :datum] :int :keyword :any]]
 ;; a definition's key: what a form defines
 :seon.merge/def-key [:or [:tuple [:= :var] :qualified-symbol]
                      [:tuple [:= :method] :qualified-symbol :string]
                      [:tuple [:= :impl] :qualified-symbol :string]
                      [:tuple [:= :ns] :symbol]]
 ;; a schema entry's content: its form as EDN text and the resource it is written back to
 :seon.merge/schema-entry [:map [:form :string] [:file :string]]
 :seon.merge/program [:map-of :seon.merge/program-key :any]
 :seon.merge/changes [:map-of :seon.merge/program-key [:tuple :any :any]]
 ;; the datoms that differ between a base and a db in what a key's content reads (seon.merge/content-datoms), read once and passed on
 :seon.merge/moved [:sequential :seon.host/datom]
 ;; whether a branch can merge into main now (seon.merge/readiness)
 :seon.merge/readiness [:map [:main-moved [:vector :seon.merge/program-key]] [:conflicts [:vector :seon.merge/program-key]]]
 :seon.merge/conflict [:map [:key :seon.merge/program-key]
                        [:base {:optional true} :any] [:ours {:optional true} :any] [:theirs {:optional true} :any]]
 ;; a merge entry's :seon.merge/* members as conflict-value reads them (a pulled entry or an
 ;; run's evidence): the stored facts (seon.facts' :seon.merge/entry-fact) with key
 ;; at the conflict's own schemas
 :seon.merge/entry-members [:map [:seon.merge/key :seon.merge/program-key]
                             [:seon.merge/base {:optional true} :any] [:seon.merge/ours {:optional true} :any]
                             [:seon.merge/theirs {:optional true} :any]]
 :seon.merge/entry-value [:map [:key :seon.merge/program-key]
                            [:base {:optional true} :any] [:ours {:optional true} :any] [:theirs {:optional true} :any]
                            [:main-t :int] [:resolved? :boolean]]
 :seon.merge/result [:map [:ours :seon.merge/changes] [:theirs :seon.merge/changes]
                      [:apply [:vector :seon.merge/program-key]] [:conflicts [:vector :seon.merge/conflict]]]
 ;; a branch whose program calls intern, alter-var-root, eval or load-string, or defines inside a
 ;; function body (seon.merge/mutations), refused at merge
 :seon.merge/mutation [:and :seon.error/base [:map [:seon.error/type [:= :seon.merge/mutation]]
                                               [:mutations [:vector [:map [:form :string] [:ns :symbol] [:defines [:vector :any]]]]]]]
 :seon.merge/behind [:and :seon.error/base [:map [:seon.error/type [:enum :seon.merge/behind]]
                                             [:behind pos-int?]]]
 ;; a merge whose program, merged into main, leaves a reference naming nothing: each live form calling a definition it removes
 ;; (seon.merge/dangling, docs/merging.md#a-merge-leaves-no-name-unbound)
 :seon.merge/dangling [:and :seon.error/base [:map [:seon.error/type [:= :seon.merge/dangling]] [:dangling [:vector [:map [:ref :qualified-symbol] [:form :string]]]]]]
 ;; one key both sides of a merge changed to different ends since their base (seon.merge/conflicts): its key by the entity's
 ;; identity, [identity-attr identity-value attribute] (and the value, for an attribute of cardinality many), and each side's
 ;; end: a value, true (a member asserted), or :seon.merge/gone (retracted). :base, the base's value at the key, is present for a
 ;; key of cardinality one that base held a value of (seon.merge/net-change reads it from the value retracted)
 :seon.merge/data-conflict [:map [:key [:or [:tuple :keyword :any :keyword] [:tuple :keyword :any :keyword :any]]] [:base {:optional true} :any] [:ours :any] [:theirs :any]]
 ;; a merge refused because the two sides' net changes conflict (seon.writer/plan-refused): the agent resolves them
 :seon.merge/conflicts [:and :seon.error/base [:map [:seon.error/type [:= :seon.merge/conflicts]] [:conflicts [:vector {:min 1} :seon.merge/data-conflict]]]]
 ;; a merge refused because the branch changed an entity that bears no identity, named by its attributes
 ;; (seon.writer/plan-refused): a defect of that entity's schema
 :seon.merge/unidentified [:and :seon.error/base [:map [:seon.error/type [:= :seon.merge/unidentified]] [:unidentified [:set {:min 1} [:set :keyword]]]]]
 ;; a merge refused because main's write check refused one of the branch's transactions replayed on it (seon.writer/applied!):
 ;; main moved since the base, so the branch merges main and tries again. :refused names the source transaction and the check's error
 :seon.merge/replay-refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.merge/replay-refused]] [:refused [:map [:tx :int] [:error :seon.error/base]]]]]
 :seon.merge/unmerged [:and :seon.error/base [:map [:seon.error/type [:enum :seon.merge/unmerged]]
                                               [:unmerged [:vector :any]]]]}
