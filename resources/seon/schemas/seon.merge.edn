;; The program merge's named schemas (lane M1's proto.merge.edn).
{:seon.merge/data-attrs [:or [:= :all] [:set :keyword]]
 :seon.merge/program-key [:or [:tuple [:= :var] :qualified-symbol]
                   [:tuple [:= :ns] :symbol]
                   [:tuple [:= :alias] :symbol :symbol]
                   [:tuple [:= :datum] :int :keyword]
                   [:tuple [:= :datum] :int :keyword :any]]
 :seon.merge/entry [:map [:src {:optional true} :string] [:kind {:optional true} :keyword]
                     [:contract {:optional true} :string] [:doc {:optional true} :string] [:meta {:optional true} :string]
                     [:flagged {:optional true} true?]]
 :seon.merge/program [:map-of :seon.merge/program-key :any]
 :seon.merge/changes [:map-of :seon.merge/program-key [:tuple :any :any]]
 :seon.merge/conflict-kind [:enum :both-modified :both-added :deleted-by-us :deleted-by-them]
 :seon.merge/conflict [:map [:key :seon.merge/program-key] [:kind :seon.merge/conflict-kind]
                        [:base {:optional true} :any] [:ours {:optional true} :any] [:theirs {:optional true} :any]]
 :seon.merge/entry-value [:map [:key :seon.merge/program-key] [:kind :seon.merge/conflict-kind]
                            [:base {:optional true} :any] [:ours {:optional true} :any] [:theirs {:optional true} :any]
                            [:main-t :int] [:resolved? :boolean]]
 :seon.merge/result [:map [:ours :seon.merge/changes] [:theirs :seon.merge/changes]
                      [:apply [:vector :seon.merge/program-key]] [:conflicts [:vector :seon.merge/conflict]]]
 :seon.merge/behind [:and :seon.error/base [:map [:seon.error/type [:enum :seon.merge/behind]]
                                             [:merged? false?] [:behind pos-int?]]]
 :seon.merge/unmerged [:and :seon.error/base [:map [:seon.error/type [:enum :seon.merge/unmerged]]
                                               [:merged? false?] [:unmerged [:vector :any]]]]
 :seon.merge/merge-main-result [:map [:ok :boolean] [:applied [:vector :seon.merge/program-key]]
                                 [:conflicts [:vector :seon.merge/conflict]] [:t {:optional true} :int]]}
