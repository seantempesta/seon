#:my.fs{:after-digest :my.fs/digest
        :already-exists? :boolean
        :before-digest :my.fs/digest
        :byte [:int {:min 0, :max 255}]
        :byte-count [:int {:min 0}]
        :byte-offset [:int {:min 0}]
        :byte-size :my.fs/byte-count
        :bytes [:vector :my.fs/byte]
        :bytes-read :my.fs/byte-count
        :bytes-written :my.fs/byte-count
        :changed? :boolean
        :complete? :boolean
        :content
        [:and
         [:map
          [:my.fs/text {:optional true} :string]
          [:my.fs/bytes {:optional true} :my.fs/bytes]
          [:seon.blob/digest {:optional true} :seon.blob/digest]]
         [:fn
          {:error/message
           "must contain exactly one byte source: :my.fs/text, :my.fs/bytes, or :seon.blob/digest"
           :gen/schema
           [:or
            [:map [:my.fs/text :string]]
            [:map [:my.fs/bytes :my.fs/bytes]]
            [:map [:seon.blob/digest :seon.blob/digest]]]}
          my.fs/content?]]
        :created? :boolean
        :digest :seon.blob/digest
        :directory? :boolean
        :encoding [:enum :bytes :utf-8]
        :eof? :boolean
        :examined [:int {:min 0}]
        :expected-absence? [:= true]
        :expected-digest :my.fs/digest
        :file-bytes :my.fs/byte-count
        :glob-request
        [:map
         [:my.fs/root :my.fs/path]
         [:my.fs/pattern :my.fs/pattern]
         [:my.fs/max-depth {:optional true} [:int {:min 0}]]
         [:my.fs/max-results {:optional true} [:int {:min 1}]]]
        :glob-result
        [:map
         [:my.fs/root :my.fs/path]
         [:my.fs/paths [:vector :my.fs/path]]
         [:my.fs/returned [:int {:min 0}]]
         [:my.fs/examined [:int {:min 0}]]
         [:my.fs/complete? :boolean]]
        :max-bytes [:int {:min 1}]
        :max-depth [:int {:min 0}]
        :max-results [:int {:min 1}]
        :modified-at :inst
        :path [:string {:min 1}]
        :paths [:vector :my.fs/path]
        :pattern [:string {:min 1}]
        :precondition :my.fs/write-precondition
        :read-request
        [:map
         [:my.fs/path :my.fs/path]
         [:my.fs/byte-offset {:optional true} :my.fs/byte-offset]
         [:my.fs/max-bytes {:optional true} :my.fs/max-bytes]
         [:my.fs/encoding {:optional true} :my.fs/encoding]]
        :read-result
        [:map
         [:my.fs/path :my.fs/path]
         [:my.fs/window-digest :my.fs/digest]
         [:my.fs/digest {:optional true} :my.fs/digest]
         [:my.fs/file-bytes :my.fs/file-bytes]
         [:my.fs/byte-offset :my.fs/byte-offset]
         [:my.fs/bytes-read :my.fs/bytes-read]
         [:my.fs/eof? :boolean]
         [:my.fs/bytes {:optional true} :my.fs/bytes]
         [:my.fs/text {:optional true} :string]]
        :regular-file? :boolean
        :returned [:int {:min 0}]
        :root :my.fs/path
        :stat-request [:map [:my.fs/path :my.fs/path]]
        :stat-result
        [:map
         [:my.fs/path :my.fs/path]
         [:my.fs/regular-file? :boolean]
         [:my.fs/directory? :boolean]
         [:my.fs/symbolic-link? :boolean]
         [:my.fs/byte-size {:optional true} :my.fs/byte-size]
         [:my.fs/modified-at {:optional true} :my.fs/modified-at]]
        :symbolic-link? :boolean
        :text :string
        :window-digest :my.fs/digest
        :write-precondition
        [:and
         [:map
          [:my.fs/expected-absence?
           {:optional true}
           :my.fs/expected-absence?]
          [:my.fs/expected-digest
           {:optional true}
           :my.fs/expected-digest]]
         [:fn
          {:error/message
           "must contain exactly one write fence: :my.fs/expected-absence? or :my.fs/expected-digest"
           :gen/schema
           [:or
            [:map [:my.fs/expected-absence? :my.fs/expected-absence?]]
            [:map [:my.fs/expected-digest :my.fs/expected-digest]]]}
          my.fs/write-precondition?]]
        :write-request
        [:map
         [:my.fs/path :my.fs/path]
         [:my.fs/content :my.fs/content]
         [:my.fs/precondition :my.fs/write-precondition]]
        :write-result
        [:map
         [:my.fs/path :my.fs/path]
         [:my.fs/created? :boolean]
         [:my.fs/changed? :boolean]
         [:my.fs/before-digest {:optional true} :my.fs/before-digest]
         [:my.fs/after-digest :my.fs/after-digest]
         [:my.fs/bytes-written :my.fs/bytes-written]],
 :not-found :my.fs/path
 :not-found-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the absent filesystem path"} [:my.fs/not-found :my.fs/not-found] [:seon.error/message :seon.error/message]]
 :not-directory :my.fs/path
 :not-directory-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path that is not a directory"} [:my.fs/not-directory :my.fs/not-directory] [:seon.error/message :seon.error/message]]
 :not-regular-file :my.fs/path
 :not-regular-file-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path that is not a regular file"} [:my.fs/not-regular-file :my.fs/not-regular-file] [:seon.error/message :seon.error/message]]
 :already-exists :my.fs/path
 :already-exists-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path that already exists"} [:my.fs/already-exists :my.fs/already-exists] [:seon.error/message :seon.error/message]]
 :path-refused :my.fs/path
 :path-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the refused filesystem path"} [:my.fs/path-refused :my.fs/path-refused] [:seon.error/message :seon.error/message]]
 :read-failed [:= true]
 :read-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose read failed"} [:my.fs/read-failed :my.fs/read-failed] [:seon.error/message :seon.error/message]]
 :write-failed [:= true]
 :write-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose write failed"} [:my.fs/write-failed :my.fs/write-failed] [:seon.error/message :seon.error/message]]
 :read-limit :my.fs/path
 :read-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose read exceeded its limit, the size observed, and the ceiling"} [:my.fs/read-limit :my.fs/read-limit] [:seon.error/message :seon.error/message]]
 :write-limit :seon.config.fs/max-write-bytes
 :write-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose write exceeded its limit"} [:my.fs/write-limit :my.fs/write-limit] [:seon.error/message :seon.error/message]]
 :stale-digest :my.fs/path
 :stale-digest-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose digest is stale"} [:my.fs/stale-digest :my.fs/stale-digest] [:seon.error/message :seon.error/message]]
 :changed-during-read :my.fs/path
 :changed-during-read-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path that changed during its read"} [:my.fs/changed-during-read :my.fs/changed-during-read] [:seon.error/message :seon.error/message]]
 :invalid-utf8-window :my.fs/path
 :invalid-utf8-window-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose requested window is not UTF-8"} [:my.fs/invalid-utf8-window :my.fs/invalid-utf8-window] [:seon.error/message :seon.error/message]]
 :atomic-write-unsupported [:= true]
 :atomic-write-unsupported-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path where atomic replacement is unavailable"} [:my.fs/atomic-write-unsupported :my.fs/atomic-write-unsupported] [:seon.error/message :seon.error/message]]
 :glob-failed :my.fs/path
 :glob-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose glob expansion failed"} [:my.fs/glob-failed :my.fs/glob-failed] [:seon.error/message :seon.error/message]]
 :invalid-glob :my.fs/pattern
 :invalid-glob-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the path whose glob expression is invalid"} [:my.fs/invalid-glob :my.fs/invalid-glob] [:seon.error/message :seon.error/message]]
 :blob-unavailable :seon.blob/digest
 :blob-unavailable-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the unavailable blob digest"} [:my.fs/blob-unavailable :my.fs/blob-unavailable] [:seon.error/message :seon.error/message]]}
