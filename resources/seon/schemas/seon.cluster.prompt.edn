#:seon.cluster.prompt{:rendered-context
                      [:map
                       [:seon.cluster.prompt/text
                        :seon.cluster.prompt/text]
                       [:seon.context/contributions
                        :seon.context/contributions]
                       [:seon.db/db :seon.db/database-value]],
                      :request
                      [:map
                       [:seon.cluster.run/id :seon.cluster.run/id]
                       [:seon.cluster.agent/id :seon.cluster.agent/id]
                       [:seon.sci.admit/caps :seon.sci.admit/caps]
                       [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                       [:seon.sci.eval/time-limit-ms
                        :seon.sci.eval/time-limit-ms]
                       [:seon.config/on-core-error
                        :seon.config/on-core-error]
                       [:seon.render/context-channel
                        :seon.flow/channel]
                       [:seon.render/distance
                        {:optional true}
                        :seon.render/distance]
                       [:seon.cluster.run/live-processes
                        {:optional true}
                        :seon.cluster.run/live-processes]],
                      :text [:string {:min 1}],
                      :rule :keyword,
                      :no-trigger [:= true]
                      :no-trigger-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a prompt request with no trigger"} [:seon.cluster.prompt/no-trigger :seon.cluster.prompt/no-trigger] [:seon.error/message :seon.error/message]]
                      :refused :seon.cluster.prompt/rule
                      :refused-error [:and {:seon.error/class true :seon.error/refusal true :seon.error/refusal-shape :seon.error/refusal-value :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the refused prompt rule"} :seon.error/refusal-value [:map [:seon.cluster.prompt/refused :seon.cluster.prompt/refused]]]}
