#:seon.cluster.prompt{:rendered-context
                      [:map
                       [:seon.cluster.prompt/text
                        :seon.cluster.prompt/text]
                       [:seon.context/contributions
                        :seon.context/contributions]
                       [:seon.db/db :seon.db/database-value]],
                      :result
                      [:or
                       :seon.cluster.prompt/rendered-context
                       :seon.error/value],
                      :request
                      [:map
                       [:seon.turn/id {:optional true} :seon.turn/id]
                       [:seon.agent/id :seon.agent/id]
                       [:seon.db/connection :seon.db/connection]
                       [:seon.sci.admit/caps :seon.sci.admit/caps]
                       [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                       [:seon.sci.eval/time-limit-ms
                        :seon.sci.eval/time-limit-ms]
                       [:seon.render/distance
                        {:optional true}
                        :seon.render/distance]
                       ],
                      :text [:string {:min 1}],
                      :rule :keyword,
                      :no-trigger [:= true]
                      :refused :seon.cluster.prompt/rule
                      :missing-cluster :seon.agent/id
                      :missing-cluster-error [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the agent whose prompt has no cluster configuration"} [:seon.cluster.prompt/missing-cluster :seon.cluster.prompt/missing-cluster] [:seon.error/message :seon.error/message]]
                      :budget-exceeded :seon.ai/tokens
 :seon.cluster.prompt/missing-config :seon.agent/id
 :seon.cluster.prompt/missing-config-error [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the agent whose effective prompt configuration is absent"} [:seon.cluster.prompt/missing-config :seon.cluster.prompt/missing-config] [:seon.error/message :seon.error/message]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.cluster.prompt/derivation-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.cluster.prompt/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.cluster.prompt/error-agent-id
   :seon.cluster.prompt/error-agent-id]
  [:seon.cluster.prompt/derivation-observation
   :seon.cluster.prompt/derivation-observation]]]

 :seon.cluster.prompt/error-agent-id
 [:string {:min 1}]
}
