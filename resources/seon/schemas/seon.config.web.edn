#:seon.config.web{:max-inline-bytes
                  [:int {:min 1, :seon.config/dial true}],
                  :max-redirects
                  [:int {:min 0, :seon.config/dial true}],
                  :max-response-bytes
                  [:int {:min 1, :seon.config/dial true}],
                  :max-search-results
                  [:int {:min 1, :seon.config/dial true}],
                  :port
                  [:int
                   {:min 0,
                    :max 65535,
                    :seon.config/optional true,
                    :seon.config/dial true}],
                  :search-api-key-variable
                  [:string {:min 1, :seon.config/dial true}],
                  :search-endpoint
                  [:and #:seon.config{:dial true} :my.web/url],
                  :search-result-projection
                  [:and #:seon.config{:dial true} :qualified-symbol],
                  :timeout-ms [:int {:seon.config/display-label "Web timeout" :seon.config/display-divisor 1000 :seon.config/display-unit "s" :min 1, :seon.config/dial true}]}
