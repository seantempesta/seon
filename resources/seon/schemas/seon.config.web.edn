;; The dashboard, the instrument switch and the native probe (v1: seon.config.web.edn's port,
;; ported; the rest new in next).
{:seon.config.web/port [:int {:seon.config/place true :min 0 :max 65535 :seon.config/unit "TCP port" :description "The dashboard's port on 127.0.0.1. 0: no web."}]
 :seon.config.root/end-with [:int {:seon.config/place true :min 0 :seon.config/unit "pid" :description "The process this root ends with (seon.lib/end-with!): a test's root names its test process, so its roots and agents never outlive it. 0: none."}]
 :seon.config.root/server-port [:int {:seon.config/place true :min -1 :max 65535 :seon.config/unit "TCP port" :description "Root's server on 127.0.0.1 (bin/mcp, outside agents). -1: a free port the kernel assigns; 0: none; >0: that port. The port bound is named on ROOT LISTENING (runs/root.port); nothing reads -1 as a port."}]
 :seon.config.web/public-dir [:string {:seon.config/at-load true :min 1 :seon.config/unit "path" :description "Where datastar.js is read."}]
 :seon.config.web/streams-buf [:int {:seon.config/at-load true :min 1 :seon.config/unit "messages" :description "In-flight text messages the web proc's :streams in-port holds while it is busy; a sliding buffer, the oldest dropped past it (shown as … in that stream)."}]
 :seon.config.web/feed-encoding [:enum {:seon.config/unit "encoding" :description "How each tab's feed is compressed: :auto deflate when the browser takes it, :deflate, or :none (plain, to read a stream when debugging)."} :auto :deflate :none]
 :seon.config.web/feed-deflate-level [:int {:min 1 :max 9 :seon.config/unit "zlib level" :description "The feed's deflate level: higher is fewer bytes and more work per update."}]
 :seon.config.web/stylesheet [:string {:seon.config/at-load true :min 1 :seon.config/unit "path" :description "The page's stylesheet, bin/build's css step's output (read per request)."}]
 :seon.config.contract/instrument [:enum {:seon.config/at-load true :seon.config/unit "mode" :description "Contracts and their recording: on, contracts (wrappers, no recording), off."} :on :contracts :off]
 :seon.config.contract/private-checked? [:boolean {:seon.config/at-load true :seon.config/unit "boolean" :description "Is a private function's contract (defn-) checked on each call? True in test processes (--profile scripted; an agent's test child sets it at its fork), false in root and its agents otherwise: docs/checks.md#contracts-armed-at-definition."}]
 :seon.config.native/probe-lib [:string {:min 1 :seon.config/unit "path" :description "native/probe.c's library (bin/build native)."}]
 :seon.config.native/sqlite-lib [:string {:min 1 :seon.config/unit "path" :description "The libsqlite3 seon.sqlite binds on first use, built with FTS5 (docs/vector.md#search). Missing or without FTS5: the first text index throws :seon.sqlite/unloaded or :seon.sqlite/refused, so no search by text runs."}]}
