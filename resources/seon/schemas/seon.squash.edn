#:seon.squash
{:source-branch [:and {:seon.db/index true
                       :description "Transaction metadata of a squash merge (seon.merge/merge!): the branch whose facts it merged."}
                 :seon.store/branch]
 :source-commit [:and {:seon.db/index true
                       :description "Transaction metadata of a squash merge (seon.merge/merge!): the source branch's commit it merged."}
                 :seon.source/commit-id]
 :conflict [:map {:description "One value both main and the source branch changed since their merge base, kept as main's by the entity schema's :root rule."}
            [:entity :seon.db/entity-id] [:attribute :qualified-keyword]
            [:base :seon.schema/value] [:ours :seon.schema/value] [:theirs :seon.schema/value]]}
