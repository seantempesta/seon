#:seon.git{:commit [:string {:min 40 :max 40 :description "A git commit's full sha, as `git rev-parse` prints it: the commit a landing made (seon.cluster.source/commit!)."}],
           :paths [:vector {:description "The checkout-relative paths a landing asked git to commit."} :seon.source/path],
           :commit-refused [:enum {:description "Why seon.cluster.source/commit! committed nothing or could not verify its commit."}
                            :no-git-dir :lock-not-taken :index-unreadable :other-staged :nothing-written :unproven :commit-failed
                            :not-on-head :not-exact :not-candidate],
           :commit-error [:and {:description "seon.cluster.source/commit! refused or could not verify a landing's git commit."} :seon.error/base
                          [:map [:seon.git/paths :seon.git/paths] [:seon.git/commit-refused :seon.git/commit-refused]]]}
