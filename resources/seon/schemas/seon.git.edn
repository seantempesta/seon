;; Co-located Malli schemas for `seon.git` & `seon.merge`.
{:seon.git/repo   [:and {:seon.db/identity true :seon.db/content-id true :seon.merge/skip true} :keyword]
 :seon.git/commit [:string {:seon.merge/skip true :min 7}]
 :seon.git/branch [:string {:seon.merge/skip true :min 1}]

 :seon.git/entity
 [:map {:seon.db/attributes true}
  [:seon.git/repo :seon.git/repo]
  [:seon.git/commit {:optional true} :seon.git/commit]
  [:seon.git/branch {:optional true} :seon.git/branch]]

 :seon.merge/entity-diff
 [:map
  [:entity [:tuple :qualified-keyword :any]]
  [:status [:enum :added :modified :deleted :conflict]]
  [:path {:optional true} [:or :string :nil]]]

 :seon.merge/plan
 [:map
  [:ok? :boolean]
  [:base-commit :uuid]
  [:ours-commit :uuid]
  [:theirs-commit :uuid]
  [:tx-data [:vector :any]]
  [:touched-paths [:set :string]]
  [:entity-diffs [:vector :seon.merge/entity-diff]]
  [:conflicts [:vector :map]]]}
