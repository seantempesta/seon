#:seon.bootstrap{
 :acquired-member-count [:int {:min 0}]
 :root-acquisition-empty-error [:and :seon.error/base [:map [:seon.bootstrap/acquired-member-count :seon.bootstrap/acquired-member-count]]]
 :unmatched-source :string
 :unmatched-source-error [:and :seon.error/base [:map [:seon.bootstrap/unmatched-source :seon.bootstrap/unmatched-source] [:seon.turn/id :seon.turn/id]]]
 :expected-prefix-count [:int {:min 0}]
 :actual-prefix-count [:int {:min 0}]
 :prefix-drift-error [:and :seon.error/base [:map [:seon.bootstrap/expected-prefix-count :seon.bootstrap/expected-prefix-count] [:seon.bootstrap/actual-prefix-count :seon.bootstrap/actual-prefix-count] [:seon.turn/id :seon.turn/id]]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.bootstrap/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.bootstrap/error-member :seon.bootstrap/error-member]
  [:seon.bootstrap/prefix-observation
   :seon.bootstrap/prefix-observation]]]

 :seon.bootstrap/error-member
 :qualified-keyword

 :seon.bootstrap/prefix-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]
}
