#:my.run{:completed
         [:map
          [:my.run/disposition [:= :completed]]
          [:my.run/result :my.run/result]
          [:my.run/delivered-to
           {:optional true}
           :my.run/delivered-to]],
         :delivered-to [:or :seon.cluster.agent/id [:= :outside]],
         :disposition [:enum :wait :completed],
         :note [:string {:min 1}],
         :namespace-unit
         [:map
          {:seon.render/ai my.run/render-namespace-ai,
           :seon.render/form my.run/usage-form}
          [:seon.ns/name [:= my.run]]
          [:seon.db/db {:optional true} :seon.db/database-value]
          [:seon.ns/doc {:optional true} :seon.ns/doc]],
         :usage-unit
         [:map
          {:seon.db/entity true,
           :seon.render/form my.run/usage-form}
          [:seon.test/sym :seon.test/sym]
          [:seon.test/usage [:= true]]],
         :result [:string {:min 1}],
         :value [:or :my.run/wait :my.run/completed],
         :wait
         [:map
          [:my.run/disposition [:= :wait]]
          [:my.run/note :my.run/note]
          [:my.background/result
           {:optional true}
           :my.background/result]],
         :blank-note [:= true]
         :blank-note-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a run wait whose note is blank"} [:my.run/blank-note :my.run/blank-note] [:seon.error/message :seon.error/message]]
         :blank-result [:= true]
         :blank-result-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a run completion whose result is blank"} [:my.run/blank-result :my.run/blank-result] [:seon.error/message :seon.error/message]]
         :usage-walkthrough-absent [:= true]
         :usage-walkthrough-absent-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark my.run when its usage walkthrough is absent"} [:my.run/usage-walkthrough-absent :my.run/usage-walkthrough-absent] [:seon.error/message :seon.error/message]]}
