 :seon.issue/refusal [:or :seon.issue/subject-without-identity-error :seon.issue/subject-unlinkable-error :seon.issue/subject-absent-error :seon.issue/detector-unknown-error :seon.issue/detector-unresolved-error :seon.issue/detector-refused-error :seon.issue/not-a-test-error :seon.issue/not-found-error :seon.issue/already-started-error :seon.issue/no-tests-error :seon.issue/no-namespace-error :seon.issue/no-cluster-error :seon.issue/worker-exists-error :seon.issue/already-exists-error :seon.issue/no-author-error :seon.issue/git-unbounded-error :seon.issue/notes-absent-error :seon.issue/citations-undeclared-error]
