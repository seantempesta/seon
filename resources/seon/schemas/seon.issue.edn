  :seon.error/base [:map [:seon.issue/assigned-issue-id :seon.issue/assigned-issue-id]]]
 :seon.issue/unverifiable-issue-id :string
 :seon.issue/no-tests-error
 [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :seon.error/base [:map [:seon.issue/unverifiable-issue-id :seon.issue/unverifiable-issue-id]]]
 :seon.issue/unassigned-namespace-issue-id :string
