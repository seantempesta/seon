#:seon.issue{:id        [:string {:min 1 :seon.db/identity true :description "The note's file slug for indexed issues; seon.id/id of [title subject] for issues authored in the database."}]
             :title     [:string {:min 1}]
             :status    [:enum {:description "The issues README lifecycle; a closed set."} :open :resolved :superseded]
             :severity  [:enum :blocker :friction :cleanup]
             :opened    :inst
             :path      [:string {:min 1 :description "Repository path of the note whose sections are the prose; absent for database-authored issues."}]
             :problem   [:string {:min 1 :description "The Problem section, or the instructions to an agent."}]
             :functions [:set {:seon.issue/cites [:seon.fn/sym]
                              :description "Program entities the issue is about: cited qualified symbols resolved to :seon.fn entities at index time."} :seon.db/ref]
             :tests     [:set {:seon.db/append-only-after :seon.issue/agent
                              :seon.db/retraction-authority :seon.issue/created-by
                              :seon.issue/cites [:seon.test/sym]
                              :description "Success tests remain nonempty after first assignment. Only the creator may retract members; database admission enforces this after transaction expansion."} :seon.db/ref]
             :errors    [:set {:seon.issue/cites [:seon.error/signature :seon.error/id]
                              :description "seon.error entities cited by signature or by error id."} :seon.db/ref]
             :keys      [:set {:seon.issue/cites [:seon.schema/key]
                              :description "Schema key entities the note cites as qualified keywords."} :seon.db/ref]
             :namespaces [:set {:seon.issue/cites [:seon.ns/name]
                               :description "Namespaces the note cites by name, including notes that cite no symbol at all."} :seon.db/ref]
             :files     [:set {:seon.db/component true
                              :seon.issue/cites [:seon.fn.file/path]
                              :description "One seon.issue.citation component per cited file and span; the path resolves to the seon.fn.file entity whose stored path ends with it."} :seon.db/ref]
             :runs      [:set {:seon.issue/cites [:seon.test.run/id]
                              :description "Test runs the note cites as the gate that proved a slice."} :seon.db/ref]
             :issues    [:set {:seon.issue/cites [:seon.issue/id]
                              :description "Sibling issues the note cites by slug; a class note's membership is :seon.issue/members."} :seon.db/ref]
             :unresolved [:set {:description "Exact citation tokens that match no installed identity value: evidence that a note names a deleted symbol or a foreign coordinate, never a refusal."} [:string {:min 1}]]
             :commits   [:set [:string {:min 9 :max 9 :description "Nine-character Git commit citations; not Datahike source commit UUIDs."}]]
             :members   [:set {:description "A class note's member issues."} :seon.db/ref]
             :agent     [:and {:description "The agent working it; asserted by start! in the transaction that creates the agent and opens its first turn. A LISTENED ATTRIBUTE: the assignment IS the worker's first wake, so the worker takes a turn about its issue without anyone sending it a message. Asserted exactly once — start! refuses an issue that already has a worker — and never retracted-and-reasserted. It is an OUTSIDE wake: the assignment comes from whoever started the issue, so it refills the worker's turn bound."
                               :seon.db/index true
                               :seon.wake/listen true
                               :seon.wake/opens-turn? true} :seon.db/ref]
             :created-by [:and {:description "The author agent. Its first assertion is the enduring retraction authority, including after unassignment."} :seon.db/ref]
             :detector  [:and {:description "The detector function's program entity for a generated issue. With the subject's own identity value it is the issue's identity, so a detector run upserts its issues instead of duplicating them. Absent on an authored issue."} :seon.db/ref]
             :budget    [:int {:min 1 :description "Provider turns for the worker; copied to its settings overlay at start."}]
             :resolved-tx [:and {:description "The transaction recording that every test verified; absence means open. Written by settlement, never asserted by a model."} :seon.db/ref]
             :issue [:map {:seon.db/attributes true
                           :seon.render/units [:seon.issue/functions :seon.issue/tests :seon.issue/errors :seon.issue/members]
                           :seon.render/ai seon.issue/render-ai :seon.render/html seon.issue/render-html}
                     [:seon.issue/id :seon.issue/id] [:seon.issue/title :seon.issue/title]
                     [:seon.issue/status :seon.issue/status] [:seon.issue/severity :seon.issue/severity]
                     [:seon.issue/problem :seon.issue/problem]
                     [:seon.issue/opened {:optional true} :seon.issue/opened]
                     [:seon.issue/path {:optional true} :seon.issue/path]
                     [:seon.issue/functions {:optional true} :seon.issue/functions]
                     [:seon.issue/tests {:optional true} :seon.issue/tests]
                     [:seon.issue/errors {:optional true} :seon.issue/errors]
                     [:seon.issue/keys {:optional true} :seon.issue/keys]
                     [:seon.issue/namespaces {:optional true} :seon.issue/namespaces]
                     [:seon.issue/files {:optional true} :seon.issue/files]
                     [:seon.issue/runs {:optional true} :seon.issue/runs]
                     [:seon.issue/issues {:optional true} :seon.issue/issues]
                     [:seon.issue/unresolved {:optional true} :seon.issue/unresolved]
                     [:seon.issue/commits {:optional true} :seon.issue/commits]
                     [:seon.issue/members {:optional true} :seon.issue/members]
                     [:seon.issue/agent {:optional true} :seon.issue/agent]
                     [:seon.issue/created-by {:optional true} :seon.issue/created-by]
                     [:seon.issue/detector {:optional true} :seon.issue/detector]
                     [:seon.issue/budget {:optional true} :seon.issue/budget]
                     [:seon.issue/resolved-tx {:optional true} :seon.issue/resolved-tx]]}
