{:seon.render.test/run-result-view
 [:map {:description "A finished run's AI face: tests run, assertions passed, failed and erred, and each failed assertion's test, expected and actual."}
  [:seon.test.run/id :seon.test.run/id]
  [:seon.test/passed? {:optional true} :seon.test/passed?]
  [:seon.test/elapsed-ms {:optional true} :seon.test/elapsed-ms]
  [:seon.render.test/test [:int {:min 0}]]
  [:seon.render.test/pass [:int {:min 0}]]
  [:seon.render.test/fail [:int {:min 0}]]
  [:seon.render.test/error [:int {:min 0}]]
  [:seon.render.test/failures {:optional true}
   [:vector [:map [:seon.test/sym :seon.test/sym]
             [:seon.test.failure/expected {:optional true} :seon.test.failure/expected]
             [:seon.test.failure/actual {:optional true} :seon.test.failure/actual]
             [:seon.test/failure-message {:optional true} :seon.test/failure-message]]]]]
 :seon.render.test/run-view
 [:map {:description "A test run as its AI face shows it: when, at what basis on which branch, its members' outcomes counted, and the red ones by name."}
  [:seon.test.run/id {:optional true} :seon.test.run/id]
  [:seon.test.run/at {:optional true} :seon.test.run/at]
  [:seon.test.run/basis-t {:optional true} :seon.test.run/basis-t]
  [:seon.test.run/branch {:optional true} :seon.test.run/branch]
  [:seon.render.test/outcomes [:map-of [:enum :error :fail :pass :unfinished] [:int {:min 0}]]]
  [:seon.render.test/red {:optional true} [:vector :seon.test/sym]]]
 :seon.render.test/view
 [:map {:description "A test as its AI face shows it: state once it has run (absent otherwise), beyond distance zero its host, failed assertions and, unless green, the definitions changed since it last passed, with the forms that read its source and run it; a refused read as its error's AI face."}
  [:seon.test/sym [:maybe :seon.test/sym]]
  [:seon.render.test/state {:optional true} [:enum "pass" "fail" "error"]]
  [:seon.test/unchanged {:optional true} :seon.test/unchanged]
  [:seon.test/recorded-basis-t {:optional true} :seon.test/recorded-basis-t]
  [:seon.test/run-basis-t {:optional true} :seon.test/run-basis-t]
  [:seon.test/failure-message {:optional true} :seon.test/failure-message]
  [:seon.test/reach-unknown {:optional true} :seon.test/reach-unknown]
  [:seon.render.test/host {:optional true} [:or [:map [:seon.test/host :seon.test/host]] :seon.error/reply]]
  [:seon.test.failure/reports {:optional true} [:vector :map]]
  [:seon.render.test/changed-since-green {:optional true}
   [:or [:vector :seon.fn/sym] :seon.error/reply]]
  [:seon.render/operations {:optional true} :seon.render/operations]]}
