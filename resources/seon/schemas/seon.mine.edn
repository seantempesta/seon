#:seon.mine
{:class [:enum {:description "What one model form did, read from its stored source and error (seon.mine/classify): read, re-read, search, probe, progress, wait, navigation (in-ns or a bare ns), repeat, or its error's class (unresolved, contract refusal, other error)."}
         :read :re-read :search :probe :progress :wait :navigation :repeat :unresolved :contract-refusal :error]
 :subject [:or {:description "What a read form names: the quoted symbol or keyword of a doc or source read (seon.mine/subject)."}
           :symbol :keyword]
 :cut [:map {:description "One cut the value printer made in a printed value, read back from its printed text: the omitted count marker and the continuation form it offered, with the handle and the path that form reads."}
       [:seon.mine/marker :seon.mine/marker]
       [:seon.mine/form :seon.mine/form]
       [:seon.mine/handle {:optional true} :seon.mine/handle]
       [:seon.mine/path {:optional true} :seon.mine/path]]
 :cuts [:or {:description "The cuts of one printed value in text order, or :unreadable when its printed text does not read as forms."}
        [:vector :seon.mine/cut] [:= :unreadable]]
 :producer-kind [:enum {:description "The kind of producer that made what an agent was shown: a declared render, the value printer's cuts, an error's constructor, the current-state block, help, a docstring or a task template."}
                 :render :printer :error :context :help :docstring :template]
 :cause [:map {:description "A producer that made what an agent was shown, a candidate for a wasted turn's cause."}
         [:seon.mine/kind :seon.mine/producer-kind]
         [:seon.mine/producer :seon.mine/producer]]
 :shown [:map {:description "One evaluation of an agent step as the agent was shown it: its form and class, the render selected, the printed tokens, the printer's cuts, its error, and whether its read subject is one of the task's references the current-state block resolves."}
         [:seon.cluster.eval/id :seon.cluster.eval/id]
         [:seon.cluster.eval/source {:optional true} :seon.cluster.eval/source]
         [:seon.mine/class :seon.mine/class]
         [:seon.mine/handle :seon.mine/handle]
         [:seon.eval/renderer {:optional true} :seon.eval/renderer]
         [:seon.eval/value-class {:optional true} :seon.eval/value-class]
         [:seon.eval/shown-tokens {:optional true} :seon.eval/shown-tokens]
         [:seon.eval/value-tokens {:optional true} :seon.eval/value-tokens]
         [:seon.eval/elisions {:optional true} :seon.eval/elisions]
         [:seon.mine/cuts {:optional true} :seon.mine/cuts]
         [:seon.cluster.eval/error {:optional true} :seon.cluster.eval/error]
         [:seon.mine/error-producer {:optional true} :seon.mine/error-producer]
         [:seon.mine/subject {:optional true} :seon.mine/subject]
         [:seon.mine/referenced? {:optional true} :seon.mine/referenced?]
         [:seon.mine/causes :seon.mine/causes]]
 :rule [:enum {:description "Why a next form is a wasted turn (self-improvement-loop.md, step 2): it repeats a form that erred, follows a printer cut's continuation, reads an earlier value's handle, re-reads a subject already read, or enters the namespace it is already in."}
        :repeats-error :follows-cut :reads-handle :re-read :redundant-in-ns]
 :waste [:map {:description "One next form charged as waste to the cause that showed what it repeats or digs for."}
         [:seon.mine/rule :seon.mine/rule]
         [:seon.cluster.eval/id :seon.cluster.eval/id]
         [:seon.cluster.eval/source {:optional true} :seon.cluster.eval/source]
         [:seon.mine/shown-by {:optional true} :seon.mine/shown-by]
         [:seon.mine/cause :seon.mine/cause]]
 :step [:int {:min 0 :description "An agent step's position in its attempt: the model call's index in opening order."}]
 :merged? [:boolean {:description "Whether main records the attempt merged (:seon.task/outcome :merged)."}]
 :situation [:map {:description "One agent step of a kept attempt, read-only from its branch (seon.mine/situations): what its eval request showed, the forms the agent wrote next, how the attempt ended, and the next forms charged as waste with their causes."}
             [:seon.store/branch :seon.store/branch]
             [:seon.task/assignment :seon.task/assignment]
             [:seon.task/sym {:optional true} :seon.task/sym]
             [:seon.task.attempt/end {:optional true} :seon.task.attempt/end]
             [:seon.mine/merged? :seon.mine/merged?]
             [:seon.mine/step :seon.mine/step]
             [:seon.turn/id :seon.turn/id]
             [:seon.mine/shown :seon.mine/shown-list]
             [:seon.mine/next :seon.mine/next]
             [:seon.mine/waste :seon.mine/waste-list]
             [:seon.mine/causes :seon.mine/causes]]
 :situations [:vector :seon.mine/situation]
 :rank-row [:map {:description "One cause's wasted turns over mined situations (seon.mine/rank): the wasted next forms charged to it, the distinct steps they came from, and how many under each rule."}
            [:seon.mine/cause :seon.mine/cause]
            [:seon.mine/wasted-forms :seon.mine/wasted-forms]
            [:seon.mine/wasted-turns :seon.mine/wasted-turns]
            [:seon.mine/rules :seon.mine/rules]]
 :marker [:string {:min 1 :description "A cut's omitted-count marker as printed, e.g. …68 or …+100524."}]
 :form [:and {:description "The continuation form a cut offered, as read."} :seon.schema/value]
 :handle [:qualified-symbol {:description "An evaluation's value handle, result/e<evaluation id> (seon.sci.admit/result-handle)."}]
 :path [:vector {:description "The get-in path a cut's continuation form reads into its handle's value; empty for the whole value."} :seon.schema/value]
 :producer [:or {:description "The producer's name: a function symbol, an error type or class keyword, or a resource path."} :qualified-symbol :keyword :string]
 :causes [:vector :seon.mine/cause]
 :error-producer [:or {:description "Who made an evaluation's error: its error's :seon.error/type, else its first diagnostic's :seon.error/operation, else its class (seon.mine/classify)."} :keyword :qualified-symbol]
 :referenced? [:boolean {:description "Whether a read's subject is one of the task's :seon.task/references, which the current-state block resolves as its must-reads."}]
 :shown-by [:and {:description "The earlier evaluation whose showing a wasted form repeats or digs into."} :seon.cluster.eval/id]
 :shown-list [:vector :seon.mine/shown]
 :next [:vector {:description "The forms the agent wrote at its next step, in order; empty at an attempt's last step."} :seon.cluster.eval/source]
 :waste-list [:vector :seon.mine/waste]
 :wasted-forms [:int {:min 1}]
 :wasted-turns [:int {:min 1}]
 :rules [:map-of :seon.mine/rule [:int {:min 1}]]}
