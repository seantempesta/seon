                         [:seon.store/branch :seon.store/branch]],
                        :branch-result
                        [:map
                         [:seon.store/branch :seon.store/branch]
                         [:seon.cluster/created?
                          :seon.cluster/created?]],
                        :cluster-request
                        [:map
                         [:seon.store/store :seon.store/store]
                         [:seon.boot/cluster-name
                          :seon.boot/cluster-name]
                         [:seon.source/commit-id
                          :seon.source/commit-id]],
                        :from [:or :keyword :uuid],
                        :retire-request
                        [:map
                         [:seon.store/store :seon.store/store]
                         [:seon.store/branch :seon.store/branch]],
                        :roster [:set :keyword],
                        :swept [:int {:min 0}],
                        :retained-files [:int {:min 0}],
                        :candidate-files [:int {:min 0}],
                        :candidate-bytes [:int {:min 0}],
                        :file-bytes [:int {:min 0}],
                        :mark-duration-ms [:int {:min 0}],
                        :missing-candidate-files [:vector :string],
                        :inventory
                        [:map
                         [:seon.cluster.registry/retained-files
                          :seon.cluster.registry/retained-files]
                         [:seon.cluster.registry/candidate-files
                          :seon.cluster.registry/candidate-files]
                         [:seon.cluster.registry/candidate-bytes
                          :seon.cluster.registry/candidate-bytes]
                         [:seon.cluster.registry/file-bytes
                          :seon.cluster.registry/file-bytes]
                         [:seon.cluster.registry/mark-duration-ms
                          :seon.cluster.registry/mark-duration-ms]
                         [:seon.cluster.registry/swept
                          {:optional true}
                          :seon.cluster.registry/swept]],
                        :rule :keyword,
                        :cannot-retire-main :seon.cluster/name
                        :cannot-retire-main-error [:map { :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the main cluster that cannot be retired"} [:seon.cluster.registry/cannot-retire-main :seon.cluster.registry/cannot-retire-main] [:seon.error/message :seon.error/message]]
                        :cluster-connected :seon.cluster/name
                        :cluster-connected-error [:map { :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the connected cluster that cannot be changed"} [:seon.cluster.registry/cluster-connected :seon.cluster.registry/cluster-connected] [:seon.error/message :seon.error/message]]
                        :source-absent :seon.cluster/name
                        :source-absent-error [:map { :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the cluster whose source branch is absent"} [:seon.cluster.registry/source-absent :seon.cluster.registry/source-absent] [:seon.error/message :seon.error/message]]
                        :refused :seon.cluster.registry/rule
                        :refused-error [:and { :seon.error/refusal true :seon.error/refusal-shape :seon.error/refusal-value :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :gen/schema [:map [:seon.cluster.registry/refused :seon.cluster.registry/refused] [:seon.error/message :seon.error/message]] :error/message "must identify the refused cluster-registry rule"} :seon.error/refusal-value [:map [:seon.cluster.registry/refused :seon.cluster.registry/refused]]]
 :seon.cluster.registry/branch-head-absent [:= true]
 :seon.cluster.registry/branch-head-absent-error [:map { :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.cluster.registry/branch-head-absent distinguishing member"} [:seon.cluster.registry/branch-head-absent :seon.cluster.registry/branch-head-absent] [:seon.error/message :seon.error/message]]
 :seon.cluster.registry/candidate-file-absent [:= true]
 :seon.cluster.registry/candidate-file-absent-error [:map { :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.cluster.registry/candidate-file-absent distinguishing member"} [:seon.cluster.registry/candidate-file-absent :seon.cluster.registry/candidate-file-absent] [:seon.error/message :seon.error/message]]
 :seon.cluster.registry/dry-run-barrier-absent [:= true]
 :seon.cluster.registry/dry-run-barrier-absent-error [:map { :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.cluster.registry/dry-run-barrier-absent distinguishing member"} [:seon.cluster.registry/dry-run-barrier-absent :seon.cluster.registry/dry-run-barrier-absent] [:seon.error/message :seon.error/message]]
 :seon.cluster.registry/dry-run-complete [:= true]
 :seon.cluster.registry/dry-run-complete-error [:map { :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.cluster.registry/dry-run-complete distinguishing member"} [:seon.cluster.registry/dry-run-complete :seon.cluster.registry/dry-run-complete] [:seon.error/message :seon.error/message]]
