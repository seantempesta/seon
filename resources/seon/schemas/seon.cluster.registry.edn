#:seon.cluster.registry{:branch-commit-request
                        [:map
                         [:seon.store/store :seon.store/store]
                         [:seon.store/branch :seon.store/branch]
                         [:seon.cluster.registry/branches {:optional true}
                          :seon.cluster.registry/branches]],
                        :branch-request
                        [:map
                         [:seon.store/store :seon.store/store]
                         [:seon.cluster.registry/from
                          :seon.cluster.registry/from]
                         [:seon.store/branch :seon.store/branch]
                         [:seon.db/db {:optional true} :seon.db/db]
                         [:seon.branch/target {:optional true} :seon.branch/target]],
                        :branch-result
                        [:map
                         [:seon.store/branch :seon.store/branch]
                         [:seon.cluster/created?
                          :seon.cluster/created?]],
                        :cluster-request
                        [:map
                         [:seon.store/store :seon.store/store]
                         [:seon.boot/cluster-name
                          :seon.boot/cluster-name]
                         [:seon.source/commit-id
                          :seon.source/commit-id]],
                        :from [:or :keyword :uuid],
                        :retire-request
                        [:map
                         [:seon.store/store :seon.store/store]
                         [:seon.store/branch :seon.store/branch]],
                        :branches [:set :keyword],
                        :retired [:set :seon.store/branch],
                        :swept [:int {:min 0}],
                        :observed-keys [:set :seon.schema/value],
                        :key-count [:int {:min 0}],
                        :candidates [:set [:or :keyword :uuid :string [:tuple [:= :datahike/commit-graph] :uuid]]],
                        :mark-duration-ms [:int {:min 0}],
                        :inventory
                        [:map
                         [:seon.cluster.registry/key-count :seon.cluster.registry/key-count]
                         [:seon.cluster.registry/observed-keys :seon.cluster.registry/observed-keys]
                         [:seon.cluster.registry/candidates :seon.cluster.registry/candidates]
                         [:seon.cluster.registry/mark-duration-ms :seon.cluster.registry/mark-duration-ms]
                         [:seon.cluster.registry/swept :seon.cluster.registry/swept]],
                        :rule :keyword,
                        :cannot-retire-main :seon.cluster/name
                        :cluster-connected :seon.cluster/name
                        :source-absent :seon.cluster/name
                        :refused :seon.cluster.registry/rule
 :seon.cluster.registry/branch-missing [:= true]
 :seon.cluster.registry/branch-missing-error [:merge {:error/message "must name the store and a branch the store does not hold"} :seon.error/base [:map [:seon.cluster.registry/branch-missing :seon.cluster.registry/branch-missing] [:seon.store/dir :seon.store/dir] [:seon.store/branch :seon.store/branch]]]
 :seon.cluster.registry/candidate-file-absent [:= true]
 :seon.cluster.registry/dry-run-barrier-absent [:= true]
 :seon.cluster.registry/dry-run-complete [:= true]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.cluster.registry/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.cluster.registry/target-branch
   :seon.cluster.registry/target-branch]
  [:seon.cluster.registry/registry-observation
   :seon.cluster.registry/registry-observation]]]

 :seon.cluster.registry/registry-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.cluster.registry/target-branch
 :keyword
}
