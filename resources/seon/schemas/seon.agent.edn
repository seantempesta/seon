#:seon.agent{:branch [:keyword {:description "The explicit branch supplying this agent’s custody; equal to the cluster branch for live execution."}]
 :mode [:enum :live :isolated]
 :context-source [:map
  [:seon.db/connection :seon.db/connection]
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:seon.cluster/name :seon.cluster/name]
  [:seon.store/store {:optional true} :seon.store/store]
  [:my.program/base-ctx {:optional true} :seon.sci.eval/ctx]
  [:seon.sci.eval/base-ctx {:optional true} :seon.sci.eval/ctx]
  [:seon.agent/routing :seon.agent/routing]
  [:seon.render.web/render-channel {:optional true :description "The cluster's render proc wake channel; every branch route it registers delivers its render wakes there (seon.cluster.agent/start-branch-flow!)."} :seon.flow/channel]
  [:seon.render.web/interest {:optional true} :seon.render.web/interest]]
 :execution-handle [:map
  [:seon.cluster/name :seon.cluster/name]
  [:seon.sci.eval/base-ctx :seon.sci.eval/ctx]
  [:seon.db/connection :seon.db/connection]
  [:seon.source/commit-id :seon.source/commit-id]
  [:seon.schema/projection :seon.schema/projection]
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:seon.env/environment :seon.env/environment]
  [:seon.agent/branch :seon.agent/branch]
  [:seon.agent/mode :seon.agent/mode]
  [:seon.agent/owns-connection? :boolean]
  [:seon.agent/owns-branch? :boolean]
  [:seon.agent/routing {:description "The registry this execution's contexts are held in and its graphs arm in; release stops and joins them before it closes."} :seon.agent/routing]
  [:seon.store/store {:optional true} :seon.store/store]]
 :acquisition-options [:map
  [:seon.agent/branch {:optional true} :seon.agent/branch]
  [:seon.agent/isolate? {:optional true} :boolean]
  [:seon.cluster.registry/from {:optional true} :seon.source/commit-id]]
 :archived-tx [:and {:description "The transaction that archived this retained agent identity. Archival only filters presentation; it does not stop its graph, detach ownership or disable resumption."} :seon.db/ref]
 :end-calls [:int {:min 0 :description "The model calls the agent's task took, recorded when the task ended (seon.context/end-summary-tx) so the end summary outlives the agent's branch."}]
 :end-prompt-tokens [:int {:min 0 :description "The prompt tokens those calls sent, recorded with :seon.agent/end-calls."}]
 :end-completion-tokens [:int {:min 0 :description "The completion tokens those calls received, recorded with :seon.agent/end-calls."}]
 :end-green [:int {:min 1 :description "How many of the task's proofs were green when it ended; absent when none."}]
 :end-red [:int {:min 1 :description "How many of the task's proofs were red when it ended; absent when none."}]
 :end-pending [:int {:min 1 :description "How many of the task's proofs were pending when it ended; absent when none."}]
 :end-red-proofs [:set {:min 1 :description "The task's proofs that were red when it ended, by reference; absent when none."} :seon.test/sym]
 :end-test-error [:string {:min 1 :description "The error that stopped the agent's latest test run (:seon.test.run/stopped-error: canonical EDN of its :seon.error/type, operation and message); absent when no run was stopped by a throw. Producer: seon.context/end-summary-tx; reader: seon.cluster.agent/chain-bails."}]
 :end-refusals [:string {:min 1 :description "The done rule's refusals (seon.cluster.source/done-refusals, as seon.context/step-section shows them) the task's step met when it ended, as canonical EDN of their vector (seon.context/refusal-data: each with its :seon.source/red-tests; seon.id/printed; clojure.edn reads it back); absent when it refused nothing. Producer: seon.context/end-summary-tx; reader: seon.cluster.agent/chain-bails."}]
 :admission-closed-tx [:and {:description "The transaction that closed this agent's admission: the run writer refuses every later run for it by name (seon.turn/system-run-call and plan-call). A hosted agent's retirement is this one assertion; the runs committed before it are the ones retirement awaits."} :seon.db/ref]
:cluster [:string {:min 1 :description "The name of the cluster this agent was created in: its config row ([:seon.config/cluster name]) is the agent's config (seon.config/agent-cluster). Several clusters' config rows may share a branch. A name, as config rows are keyed, so an agent is created before or without its cluster's entity."}]
:runtime [:and {:seon.db/component true :seon.db/component-schema :seon.runtime/entity :description "The agent owns its runtime: latest trigger and listens. Its turns name it (:seon.turn/agent)."} :seon.db/ref]
:agent
                     [:map
                      {:seon.db/attributes true,
                       :seon.render/units
                       [:seon.task/of-agent
                        :seon.turn/_agent
                        :seon.message/_to
                        :seon.agent/settings
                        :seon.agent/namespace
                        :seon.agent/runtime
                        :seon.error/of-steward],
                       :seon.render/ai
                       seon.cluster.agent/render-identity-ai,
                       :seon.render/html
                       seon.cluster.agent/render-identity-html
                       :seon.render/form
                       seon.cluster.agent/identity-form :seon.program/partition :seon.data}
                      [:seon.agent/id :seon.agent/id]
                      [:seon.agent/branch :seon.agent/branch]
                      [:seon.agent/cluster {:optional true} :seon.agent/cluster]
                      [:seon.agent/archived-tx {:optional true} :seon.agent/archived-tx]
                      [:seon.agent/admission-closed-tx {:optional true} :seon.agent/admission-closed-tx]
                      [:seon.agent/end-calls {:optional true} :seon.agent/end-calls]
                      [:seon.agent/end-prompt-tokens {:optional true} :seon.agent/end-prompt-tokens]
                      [:seon.agent/end-completion-tokens {:optional true} :seon.agent/end-completion-tokens]
                      [:seon.agent/end-green {:optional true} :seon.agent/end-green]
                      [:seon.agent/end-red {:optional true} :seon.agent/end-red]
                      [:seon.agent/end-pending {:optional true} :seon.agent/end-pending]
                      [:seon.agent/end-red-proofs {:optional true} :seon.agent/end-red-proofs]
                      [:seon.agent/end-refusals {:optional true} :seon.agent/end-refusals]
                      [:seon.agent/end-test-error {:optional true} :seon.agent/end-test-error]
                      [:seon.agent/namespace
                       {:optional true}
                       :seon.agent/namespace]
                      [:seon.agent/settings {:optional true} :seon.agent/settings]
                      [:seon.agent/runtime {:optional true} :seon.agent/runtime]],
                     :db-request
                     [:map {:description "A call from an agent's world: the database value and the agent, both supplied by call preparation."}
                      [:seon.db/db :seon.db/database-value]
                      [:seon.agent/id :seon.agent/id]],
                     :start-request
                     [:map
                      [:seon.turn.loop/cluster
                       :seon.turn.loop/cluster]
                      [:seon.agent/id :seon.agent/id]
                      [:seon.agent/routing
                       :seon.agent/routing]
                      [:seon.task/execution {:optional true :description "The intent the graph starts under: only :running resumes it."}
                       :seon.task/execution]],
                     :started
                     [:map
                      [:seon.agent/id :seon.agent/id]
                      [:seon.agent/eid :int]
                      [:seon.flow/graph :seon.flow/graph]
                      [:seon.flow/started {:optional true} :seon.flow/started]
                      [:seon.cluster.wake/channel :seon.flow/channel]
                      [:seon.turn.loop/completion
                       :seon.flow/channel]
                      [:seon.agent/requests {:optional true} :seon.agent/requests]
                      [:seon.flow/executor {:optional true} :seon.flow/executor]
                      [:seon.flow.actions/paused? {:optional true} :seon.flow.actions/paused?]],
                     :blueprint-request
                     [:map
                      [:seon.turn.loop/cluster
                       :seon.turn.loop/cluster]
                      [:seon.agent/id :seon.agent/id]],
                     :count [:int {:min 0}],
                     :creation-request
                     [:map
                      [:seon.agent/id :seon.agent/id]
                      [:seon.agent/branch {:optional true} :seon.agent/branch]
                      [:seon.ns/name :seon.ns/name]
                      [:seon.cluster/name :seon.cluster/name]],
                     :creation-result
                     [:map
                      {:seon.render/ai
                       seon.cluster.agent/render-creation-ai,
                       :seon.render/html
                       seon.cluster.agent/render-creation-html}
                      [:seon.agent/id :seon.agent/id]
                      [:seon.ns/name :seon.ns/name]
                      [:seon.cluster/name :seon.cluster/name]],
                     :creation-tx :seon.store/transaction-data,
                     :stop-request
                     [:map
                      [:seon.agent/id :seon.agent/id]
                      [:seon.agent/routing
                       :seon.agent/routing]
                      [:seon.agent/finish?
                       {:optional true}
                       :seon.agent/finish?]],
                     :finish? [:boolean {:description "A stop that lets the agent's in-flight pass finish instead of interrupting it, then joins the graph: db<->flow's stop of an ended assignment, whose own pass wrote the end (seon.cluster.agent/next-actions)."}],
                     :eid :int,
                     :id
                     [:string
                      {:min 1,
                       :seon.db/identity true :seon.program/row-schema :seon.agent/agent,
                       :seon.wake/starts true,
                       :description
                       "The agent's identity: the name every message, run, and namespace assignment resolves it by. A STARTING ATTRIBUTE: asserting it is the one durable evidence that an agent exists, so its commit wakes db<->flow and an agent created while the cluster runs is started without waiting for the next boot."}],
                     :identity-request
                     [:map
                      [:seon.db/db :seon.db/database-value]
                      [:seon.agent/id :seon.agent/id]],
                     :namespace
                     [:and
                      {:description
                       "The namespace this agent is assigned to work in by default; not unique — several agents may share one, and an agent may `in-ns` anywhere its REPL reaches."
                       :seon.render/ai seon.render.ns/agent-namespace-ai
                       :seon.render/form seon.render.ns/agent-namespace-form}
                      :seon.db/ref],
                     :routing
                     [:fn
                      {:description "One execution's registry: armed graphs and mailboxes, held contexts by [branch agent-id], and the registries of branches acquired through it."
                       :error/message
                       "must be a process-local atom containing agent routing state"
                       :gen/gen seon.flow/atom-reference-generator}
                      seon.flow/atom-reference?],
                     :source-submission-request
                     [:map
                      [:seon.turn.loop/cluster
                       :seon.turn.loop/cluster]
                      [:seon.agent/routing
                       :seon.agent/routing]
                      [:seon.agent/id :seon.agent/id]
                      [:seon.turn/starting-ns {:optional true}
                       :seon.turn/starting-ns]
                      [:seon.agent/segmenter {:optional true}
                       :seon.agent/segmenter]
                      [:seon.cluster.reply/text :seon.cluster.reply/text]],
                     :segmenter
                     [:qualified-symbol
                      {:description "The function that segments a submission's text into sources: seon.turn/planned-sources for a model reply (the default), seon.turn/code-sources for code. It must declare planned-sources' contract."}],
                     :source-submission-result
                     [:map
                      [:seon.turn/id :seon.turn/id]
                      [:seon.agent/reply {:optional true} :seon.agent/reply]
                      ;; the value the run's settlement left (evaluate-source!)
                      [:seon.db/db {:optional true} :seon.db/database-value]
                      ;; each held form with the receipt that settlement saved
                      [:seon.turn.loop/evaluated-sources {:optional true} :seon.turn.loop/evaluated-sources]
                      ;; the wall time of each stage the run's pass ran
                      [:seon.turn.loop/stages {:optional true} :seon.turn.loop/stages]
                      [:seon.cost/counts {:optional true} :seon.cost/counts]],
                     ;; A source submission as the value its agent's turn proc
                     ;; receives on its bounded request port: the run request
                     ;; (`seon.turn/system-run-call`'s input), its staged reply,
                     ;; and the port the pass answers once the run has settled.
                     ;; Replaceable: the caller holds it and awaits, so nothing
                     ;; durable is lost when a stop drops it.
                     :request
                     [:map
                      [:seon.turn/id :seon.turn/id]
                      [:seon.agent/run-request :seon.agent/run-request]
                      [:seon.blob/staged-writes [:vector :seon.blob/staged-write]]
                      [:seon.agent/reply :seon.agent/reply]],
                     :reply :seon.flow/channel,
                     :run-request :seon.turn/system-run-request,
                     :requests :seon.flow/channel,
                     ;; The live value returned by `(help)`. These are
                     ;; projections of current facts, never attributes stored
                     ;; on the agent. Adding a member here is how the generated
                     ;; opening grows: its printed value introduces another
                     ;; reference to the symbol-driven frontier.
                     :namespace-ref :seon.db/ref,
                     :unread-message-count [:int {:min 0}],
                     :open-run-ref :seon.db/ref,
                     :protocol-namespaces [:vector :seon.ns/name],
                     :situation
                     [:map
                      {:seon.render/ai
                       seon.cluster.agent/render-situation-ai,
                       :seon.render/form
                       seon.cluster.agent/situation-form}
                      [:seon.agent/id :seon.agent/id]
                      [:seon.agent/namespace-ref
                       :seon.agent/namespace-ref]
                      [:seon.agent/unread-message-count
                       :seon.agent/unread-message-count]
                      [:seon.agent/open-run-ref
                       {:optional true}
                       :seon.agent/open-run-ref]
                      [:seon.turn/trigger
                       {:optional true}
                       :seon.turn/trigger]
                      [:seon.turn/turns-remaining
                       :seon.turn/turns-remaining]
                      [:seon.agent/protocol-namespaces
                       :seon.agent/protocol-namespaces]],
                     :no-such-agent :seon.agent/id
                     :no-such-agent-error [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the requested agent that does not exist"} [:seon.agent/no-such-agent :seon.agent/no-such-agent] [:seon.error/message :seon.error/message]]
                     :turn-completion-backstop :seon.agent/id
                     :turn-completion-undeliverable :seon.agent/id
                     :creation-incomplete :seon.agent/id
                     :plan-quiescence-undeliverable [:= true]
                     :supervision-not-committed [:= true]
             :settings [:and {:seon.db/component true :seon.db/component-schema :seon.config/agent-overlay
                              :seon.render/ai seon.agent/render-settings-ai
                              :seon.render/html seon.agent/render-settings-html
                              :seon.render/form seon.agent/render-settings-form} :seon.db/ref]
             :archived [:map {:description "An archived agent as archive! answers it: its id and the transaction that archived it."}
                        [:seon.agent/id :seon.agent/id]
                        [:seon.agent/archived-tx :seon.agent/archived-tx]]
             :identity-view [:map {:description "My identity as the AI face shows it: my id, my namespace and its steward, my cluster, and the reads offered."}
                             [:seon.agent/id :seon.agent/id]
                             [:seon.agent/cluster {:optional true} :seon.agent/cluster]
                             [:seon.agent/namespace {:optional true} [:map [:seon.ns/name :seon.ns/name]
                                                                      [:seon.ns/steward {:optional true} [:map [:seon.agent/id :seon.agent/id]]]]]
                             [:seon.render/operations :seon.render/operations]]
             :settings-view [:map {:description "My setting overrides as the AI face shows them, with the read of the effective defaults offered."}
                             [:my.agent/settings :my.agent/settings]
                             [:seon.render/operations :seon.render/operations]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.agent/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.agent/error-agent-id :seon.agent/error-agent-id]]]

 :seon.agent/error-agent-id
 [:string {:min 1}]

 :seon.agent/failure
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.failure/entity}
 :seon.db/ref]
 :seon.agent/refused-source-agent [:string {:min 1}]
 :seon.agent/source-submission-refused-error
 [:merge :seon.error/base
  [:map {:seon.db/attributes true}
   [:seon.agent/refused-source-agent :seon.agent/refused-source-agent]]]
}
