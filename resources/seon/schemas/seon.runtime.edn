#:seon.runtime{:agent [:and {:seon.db/identity true :seon.program/row-schema :seon.runtime/entity
                            :description "The agent owning this runtime component."} :seon.db/ref]
               :turns [:set {:description "RETIRED, no writer or reader: an agent's turns are the reverse of :seon.turn/agent. Installed as a plain ref so the next publication retires it by retracting these datoms, never their turns (a retired component retracts its values as entities); delete this declaration once this form is adopted." :seon.wake/context-inert true} :seon.db/ref]
               :trigger [:and {:description "The fact whose wake opened the latest turn."} :seon.db/ref]
               :listens [:set {:seon.db/component true :seon.db/component-schema :seon.listen/pattern
                               :description "Authored index patterns: attribute with optional entity and value constraints."} :seon.db/ref]
               :entity [:map {:seon.db/attributes true
                              :seon.render/ai seon.render.transcript/render-runtime-ai
                              :seon.render/html seon.render.transcript/render-runtime-html
                              :seon.render/form seon.render.transcript/render-runtime-form :seon.program/partition :seon.data}
                        [:seon.runtime/agent :seon.runtime/agent]
                        [:seon.runtime/turns {:optional true} :seon.runtime/turns]
                        [:seon.runtime/trigger {:optional true} :seon.runtime/trigger]
                        [:seon.runtime/listens {:optional true} :seon.runtime/listens]]}
