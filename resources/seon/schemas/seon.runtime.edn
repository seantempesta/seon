#:seon.runtime{:agent [:and {:seon.db/identity true
                            :description "The agent owning this runtime component."} :seon.db/ref]
               :turns [:set {:seon.db/component true
                             :seon.render/ai seon.render.transcript/render-history-ai
                             :seon.render/html seon.render.transcript/render-history-html
                             :description "This agent's turn entities; an open turn has no closed-tx."} :seon.db/ref]
               :trigger [:and {:description "The fact whose wake opened the latest turn."} :seon.db/ref]
               :listens [:set {:seon.db/component true
                               :description "Authored index patterns: attribute with optional entity and value constraints."} :seon.db/ref]
               :entity [:map {:seon.db/attributes true
                              :seon.render/ai seon.render.transcript/render-runtime-ai
                              :seon.render/html seon.render.transcript/render-runtime-html}
                        [:seon.runtime/agent :seon.runtime/agent]
                        [:seon.runtime/turns {:optional true} :seon.runtime/turns]
                        [:seon.runtime/trigger {:optional true} :seon.runtime/trigger]
                        [:seon.runtime/listens {:optional true} :seon.runtime/listens]]}
