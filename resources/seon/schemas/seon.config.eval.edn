#:seon.config.eval{:time-limit-ms
                   [:int
                    {:seon.config/display-label "Evaluation deadline" :seon.config/display-divisor 1000 :seon.config/display-unit "s" :min 1,
                     :seon.config/per-agent true,
                     :seon.config/dial true}],
                   :bounds
                   [:map
                    {:description "The declared misuse bounds over one evaluation's measures (seon.repl/cost). Each m/explain error against this schema is one finding under :seon.repl/findings in the reply map: its :seon.repl/finding kind, the measure and the observed value, the other recorded measures named by :seon.repl/with, and :seon.repl/fix. Within every bound the reply carries no :findings key. A new rule is a new entry; each measure is recorded by its producer."}
                    [:seon.eval/duration-ms
                     {:optional true
                      :seon.repl/finding :slow
                      :seon.repl/fix "Over one second in the evaluation you asked for: find what the work is proportional to (the store? the program? the call count?) and remove it; (seon.profile/summary (seon.profile/cells) 5) ranks the armed functions by time."}
                     [:<= 1000]]
                    [:seon.eval/value-tokens
                     {:optional true
                      :seon.repl/finding :large-value
                      :seon.repl/with [:seon.eval/shown-tokens]
                      :seon.repl/fix "A value this big usually means a query or function returns more than it should: select what you need."}
                     [:<= 1000]]
                    [:seon.eval/allocated-bytes
                     {:optional true
                      :seon.repl/finding :large-allocation
                      :seon.repl/fix "Something realized far more than it returned (an unbounded lazy sequence, a whole-store read, a copied collection): realize only what you need."}
                     [:<= 536870912]]
                    [:seon.eval/unadmitted
                     {:optional true
                      :seon.repl/finding :not-admitted
                      :seon.repl/fix "This form failed, so these definitions stayed private to your context with no program entity (no tests, no merge): evaluate each again once its form succeeds."}
                     [:set {:max 0} :qualified-symbol]]
                    [:seon.eval/replaced
                     {:optional true
                      :seon.repl/finding :replaced-definition
                      :seon.repl/fix "The program advanced over these definitions of yours: their changed program entities replaced them in your context. Evaluate yours again to redefine them."}
                     [:set {:max 0} :qualified-symbol]]
                    [:seon.eval/ungeneratable
                     {:optional true
                      :seon.repl/finding :no-generator
                      :seon.repl/fix "These schemas have no Malli generator, so functions using them skip auto-check: add a generator or a generatable form."}
                     [:set {:max 0} :qualified-keyword]]
                    [:seon.repl/out-tokens
                     {:optional true
                      :seon.repl/finding :large-output
                      :seon.repl/fix "Printed output is saved and re-read in every later context: return the value instead of printing it."}
                     [:<= 500]]]}
