#:seon.ns{:context-relevant? [:boolean {:description "This namespace declares agent-facing context relevance; it never controls callability."}],
          :aliases [:set #:seon.db{:component true :seon.db/component-schema :seon.ns.alias/binding} :seon.db/ref],
          :doc [:string #:seon.search{:index :text}],
          :imports [:set #:seon.db{:component true :seon.db/component-schema :seon.ns.import/binding} :seon.db/ref],
          :name
          [:symbol
           {:seon.db/identity true, :seon.search/index :symbol,
            :seon.program/row-schema :seon.ns/ns,
            :seon.program/source-attribute :seon.ns/source}],
          :ns
          [:map
           {:seon.db/attributes true,
            :seon.render/ai seon.render.ns/render-ai,
            :seon.render/html seon.render.ns/render-html,
            :seon.render/form seon.render.ns/namespace-form}
           [:seon.ns/name :seon.ns/name]
           [:seon.program/definition-digest :seon.program/definition-digest]
           [:seon.fn/file {:optional true} :seon.fn/file]
           [:seon.ns/context-relevant? {:optional true} :seon.ns/context-relevant?]
           [:seon.schema.admission/source
            {:optional true}
            :seon.schema.admission/source]
           [:seon.ns/source {:optional true} :seon.ns/source]
           [:seon.ns/doc {:optional true} :seon.ns/doc]
           [:seon.ns/requires {:optional true} :seon.ns/requires]
           [:seon.ns/aliases {:optional true} :seon.ns/aliases]
           [:seon.ns/imports {:optional true} :seon.ns/imports]
           [:seon.ns/refers {:optional true} :seon.ns/refers]
           [:seon.ns/steward
            {:optional true
             :seon.program/written-by seon.cluster.agent/steward-call}
            :seon.ns/steward]],
          :refers [:set #:seon.db{:component true :seon.db/component-schema :seon.ns.refer/binding} :seon.db/ref],
          :requires [:set {:seon.db/index true} :symbol],
          :source [:string {:min 1}],
          :steward
          [:and
           {:description
            "The one agent that stewards this namespace: faults in its functions, complaints, and feature requests from other agents route here. Assignment is not stewardship; several agents may work a namespace."}
           :seon.db/ref]}
