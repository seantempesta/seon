{:seon.fn.file/relative-path [:string {:min 1 :seon.db/identity true
                             :seon.program/row-schema :seon.fn.file/file
                             :seon.program/source-attribute :seon.fn.file/digest}]
 :seon.fn.file/digest [:string {:min 64 :max 64}]
 :seon.fn.file/relative-root
 [:string {:min 1
           :description
           "The walked source directory relative to the publication root. Absent means the file lies under no declared source directory."}]
 :seon.fn.file/file
 [:map {:seon.db/attributes true}
  [:seon.fn.file/relative-path :seon.fn.file/relative-path]
  [:seon.fn.file/digest :seon.fn.file/digest]
  [:seon.fn/unresolved-references {:optional true} :seon.fn/unresolved-references]
  [:seon.fn.file/relative-root {:optional true} :seon.fn.file/relative-root]
  [:seon.schema.admission/source {:optional true}
   :seon.schema.admission/source]]
 :seon.fn.file/rows :seon.program/rows
 :seon.fn.file/identities [:vector :seon.program/identity]
 :seon.fn.file/findings [:vector :map]
 :seon.fn.file/declaration-digests
 [:map-of :seon.program/identity :seon.source/digest]
 :seon.fn.file/first-party-functions [:vector :seon.fn/sym]
 :seon.fn.file/artifact
 [:map
  [:seon.fn.file/relative-path :seon.fn.file/relative-path]
  [:seon.fn.file/digest :seon.fn.file/digest]
  [:seon.fn.file/rows :seon.fn.file/rows]
  [:seon.fn.file/declaration-digests {:optional true} :seon.fn.file/declaration-digests]
  [:seon.fn.file/findings {:optional true} :seon.fn.file/findings]
  [:seon.fn.file/identities :seon.fn.file/identities]]}
