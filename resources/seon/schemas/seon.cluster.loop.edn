                      :keyword]],
                    :completion :seon.flow/channel,
                    :evaluation
                    [:map
                     [:seon.cluster.eval/at {:optional true} :seon.cluster.eval/at]
                     ;; ONE OF TWO TERMINAL SHAPES: an admitted value with its
                     ;; bytes, or :seon.eval/missing with the reason.
                     [:seon.sci.admit/value
                      {:optional true}
                      [:any
                       {:seon.schema.admission/exemption
                        :seon.schema.admission/polymorphic-boundary
