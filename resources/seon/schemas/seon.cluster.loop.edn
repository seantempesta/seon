                     [:seon.sci.eval/ending-ns
                      {:optional true}
                      :seon.sci.eval/ending-ns]
                     [:seon.program/row
                      {:optional true}
                      :seon.program/row]

                     [:my.run/value {:optional true} :my.run/value]],
                    :settle-evaluation-request
                    [:map
                     [:seon.cluster.loop/cluster
                      :seon.cluster.loop/cluster]
                     [:seon.cluster.loop/now :seon.cluster.loop/now]
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.cluster.run/id :seon.cluster.run/id]
                     [:seon.cluster.eval/ordinal
                      :seon.cluster.eval/ordinal]
                     [:seon.sci.eval/evaluation
                      :seon.sci.eval/evaluation]
                     [:seon.problems/form-problem
                      {:optional true}
                      :seon.problems/form-problem]
                     [:seon.cluster.message/trigger
                      {:optional true}
                      :seon.cluster.message/id]],
                    :settle-failure-request
                    [:map
                     [:seon.cluster.loop/cluster
                      :seon.cluster.loop/cluster]
                     [:seon.cluster.loop/now :seon.cluster.loop/now]
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.error/value :seon.error/value]
                     [:seon.cluster.run/id
                      {:optional true}
                      :seon.cluster.run/id]
                     [:seon.cluster.eval/ordinal
                      {:optional true}
                      :seon.cluster.eval/ordinal]],
                    :settle-request
                    [:or
                     :seon.cluster.loop/settle-evaluation-request
                     :seon.cluster.loop/settle-failure-request],
                    :evaluation-settlement
                    [:map
                     [:seon.cluster.loop/settled
                      [:or :nil :my.run/value]]
                     [:seon.cluster.loop/evaluation
                      :seon.cluster.loop/evaluation]
                     [:seon.cluster.loop/receipt
                      :seon.cluster.loop/terminal-request]
                     [:seon.blob/staged-writes
                      [:vector :seon.blob/staged-write]]
