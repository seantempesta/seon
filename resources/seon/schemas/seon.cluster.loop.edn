                     [:seon.ns/name :seon.ns/name]
                     [:seon.cluster.reply/text :seon.cluster.reply/text]
                     [:seon.sci.admit/caps :seon.sci.admit/caps]],
                    :evaluate-sources-request
                    [:map
                     [:seon.cluster.loop/cluster :seon.cluster.loop/cluster]
                     [:seon.db/db {:optional true} :seon.db/database-value]
                     [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.cluster.run/id {:optional true} :seon.cluster.run/id]
                     [:seon.cluster.eval/ordinal :seon.cluster.eval/ordinal]
                     [:seon.ns/name :seon.ns/name]
                     [:seon.cluster.reply/sources :seon.cluster.reply/sources]
],
