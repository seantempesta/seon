                     [:seon.cluster.loop/outcome
                      :seon.cluster.loop/commit-outcome]
                     [:seon.cluster.loop/refused-outcome
                      {:optional true}
                      :seon.error/value]],
                    :settlement
                    [:or
                     :seon.cluster.loop/evaluation-settlement
                     :seon.cluster.loop/failure-settlement],
                    :turn-report
                    [:map
                     [:seon.cluster.run/id
                      {:optional true}
                      :seon.cluster.run/id]
                     [:seon.cluster.agent/id :seon.cluster.agent/id]
                     [:seon.cluster.work/situation
                      :seon.cluster.work/situation]
                     [:seon.cluster.loop/forms-run [:int {:min 0}]]
                     [:seon.cluster.loop/outcome
                      :seon.cluster.loop/outcome]],
                    :turn-request
                    [:map
                     [:seon.cluster.loop/cluster
                      :seon.cluster.loop/cluster]
                     [:seon.cluster.work/next :seon.cluster.work/next]],
                    :lint-rejected [:= true]
                    :lint-rejected-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark an evaluated form rejected by lint"} [:seon.cluster.loop/lint-rejected :seon.cluster.loop/lint-rejected] [:seon.error/message :seon.error/message]]
                    :prompt-failed :seon.cluster.agent/id
                    :prompt-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the agent whose prompt failed to render"} [:seon.cluster.loop/prompt-failed :seon.cluster.loop/prompt-failed] [:seon.error/message :seon.error/message]]
                    :terminal-refusal-settlement-refused :seon.cluster.run/rule
                    :terminal-refusal-settlement-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the run rule that refused terminal-refusal settlement"} [:seon.cluster.loop/terminal-refusal-settlement-refused :seon.cluster.loop/terminal-refusal-settlement-refused] [:seon.error/message :seon.error/message]]
 :seon.cluster.loop/phase-failed [:= true]
 :seon.cluster.loop/phase-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.cluster.loop/phase-failed class marker"} [:seon.cluster.loop/phase-failed :seon.cluster.loop/phase-failed] [:seon.error/message :seon.error/message]]}
