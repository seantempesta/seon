#:seon.problems{:failed-tests
                [:vector [:map [:seon.test/sym :seon.test/sym]
                          [:seon.test/fail-count :seon.test/fail-count]
                          [:seon.test/error-count :seon.test/error-count]
                          [:seon.test/failures {:optional true} [:vector :seon.test.failure/value]]]]
                :errored-receipt
                [:map
                 [:seon.cluster.eval/id :seon.cluster.eval/id]
                 [:seon.turn/id :seon.turn/id]
                 [:seon.cluster.eval/ordinal
                  :seon.cluster.eval/ordinal]
                 [:seon.cluster.eval/source :seon.cluster.eval/source]
                 [:seon.cluster.eval/error :seon.cluster.eval/error]],
                :id [:string {:min 1, :seon.db/identity true}],
                :form-problem
                [:map
                 [:seon.problems/id :seon.problems/id]
                 [:seon.cluster.eval/id :seon.cluster.eval/id]
                 [:seon.turn/id :seon.turn/id]
                 [:seon.cluster.eval/ordinal
                  :seon.cluster.eval/ordinal]
                 [:seon.cluster.eval/source :seon.cluster.eval/source]
                 [:seon.agent/id :seon.agent/id]
                 [:seon.problems/author :seon.agent/id]
                 [:seon.cluster.eval/error :seon.cluster.eval/error]],
                :unowned-namespace
                [:map [:seon.ns/name :seon.ns/name]],
                :missing-model
                [:map
                 #:seon.render{:ai seon.problems/missing-model-ai,
                               :html seon.problems/missing-model-html}
                 [:seon.config.ai/model :seon.config.ai/model]],
                :failed-run
                [:map
                 [:seon.turn/id :seon.turn/id]
                 [:seon.agent/id :seon.agent/id]],
                :stale-var
                [:map
                 ;; NO RENDER PAIR. This row's only attribute is
                 ;; `:seon.fn/sym`, the `:db.unique/identity` of the
                 ;; `:seon.fn` family, and maps are OPEN — so a declared
                 ;; pair here is selected for EVERY function row an agent
                 ;; pulls, and the whole published program graph was
                 ;; presented as stale Vars. `ai-prose` and `html-report`
                 ;; call `stale-var-ai`/`stale-var-html` directly on the
                 ;; rows `stale-vars` derived, which is the one mechanism
                 ;; and the only place the staleness is actually known;
                 ;; the sibling finding rows (`:failed-run`,
                 ;; `:unowned-namespace`) declare no pair for the same
                 ;; reason.
                 [:seon.fn/sym :seon.fn/sym]],
                :deferred-agent
                [:map
                 [:seon.agent/id :seon.agent/id]
                 [:seon.turn.work/episode-runs
                  :seon.turn.work/episode-runs]
                 [:seon.problems/deferred-count [:int {:min 1}]]],
                :form-problem-request
                [:map
                 [:seon.turn/id :seon.turn/id]
                 [:seon.cluster.eval/ordinal
                  :seon.cluster.eval/ordinal]
                 [:seon.sci.eval/evaluation
                  :seon.sci.eval/evaluation]],
                :request [:map],
                :problems
                [:map
                 #:seon.render{:ai seon.problems/ai-prose,
                               :html seon.problems/html-report}
                 [:seon.problems/failed-tests {:optional true}
                  :seon.problems/failed-tests]
                 [:seon.problems/error-signatures
                  {:optional true}
                  [:vector :seon.problems/error-signature]]
                 [:seon.problems/failed-runs
                  {:optional true}
                  [:vector :seon.problems/failed-run]]
                 [:seon.problems/errored-receipts
                  {:optional true}
                  [:vector :seon.problems/errored-receipt]]
                 [:seon.problems/deferred-agents
                  {:optional true}
                  [:vector :seon.problems/deferred-agent]]
                 [:seon.problems/unowned-namespaces
                  {:optional true}
                  [:vector :seon.problems/unowned-namespace]]
                 [:seon.problems/stale-vars
                  {:optional true}
                  [:vector :seon.problems/stale-var]]
                 [:seon.problems/missing-models
                  {:optional true}
                  [:vector :seon.problems/missing-model]]],
                :error-signature
                [:map
                 [:seon.error/signature :seon.error/signature]
                 [:seon.error/at :seon.error/at]
                 [:seon.error/layer :seon.error/layer]
                 [:seon.error/operation :seon.error/operation]
                 [:seon.problems/occurrences
                  :seon.problems/occurrences]
                 [:seon.error/fact :seon.error/fact]],
                :occurrences [:int {:min 1}],
                :author :seon.agent/id
 ; Additive error declaration manifest, 2026-09-18.

 :seon.problems/detector-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.problems/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.problems/error-detector :seon.problems/error-detector]
  [:seon.problems/detector-observation
   :seon.problems/detector-observation]]]

 :seon.problems/error-detector
 [:qualified-symbol {:seon.db/index true}]
}
