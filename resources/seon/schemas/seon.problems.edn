;; Problems as typed facts (session D2, the session design papers in git history): the error variants every
;; producer builds through seon.contract/error (the one error map), the recorded error (one
;; entity per signature on main, R4's seon.error), the problem members of a run's end,
;; and the shape of the one read, seon.problems/report.
{;; ---- variants of the one error map (each [:and :seon.error/base ...]) ----
 ;; an agent's test results not recorded as facts on its branch: its schema lacks them, or the branch refused the write (seon.agent/record-results!); the run answers it under :unrecorded
 :seon.agent/unrecorded [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/unrecorded]]]]
 :seon.agent/gate-unread [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/gate-unread]]]]
 ;; a commit the agent's branch refused (a value the store cannot hash): its run-ahead writes dropped, the eval ids among them named (seon.agent/commit!); an eval answers it under :unrecorded
 :seon.agent/no-branch [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/no-branch]]]]
 :seon.agent/commit-refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/commit-refused]] [:transactions :int] [:evals [:vector :string]]]]
 :seon.agent/eval-error [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/eval-error]]
                                                [:class :string] [:data {:optional true} :map] [:phase {:optional true} :keyword]
                                                [:jolt.error/line {:optional true} :int] [:jolt.error/column {:optional true} :int]
                                                [:jolt.error/symbol {:optional true} :string] [:jolt.error/ns {:optional true} :string]
                                                [:jolt.error/kind {:optional true} :keyword] [:jolt.error/type {:optional true} :keyword]
                                                [:jolt.error/suggestions {:optional true} [:vector :string]]
                                                [:causes {:optional true} [:vector :string]]]]
 :seon.db/name-retired [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/name-retired]] [:seon.db/retired [:map-of :qualified-keyword :qualified-keyword]]]]
 :seon.db/types-differ [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/types-differ]]
                                                [:seon.db/attributes [:map-of :qualified-keyword [:map [:stored :keyword] [:declared :keyword]]]]]]
 ;; a store that keeps no history (:seon.config.store/keep-history? false, fixed when it is made): d/history and d/as-of throw on it, so
 ;; seon.db/history and at answer this, never an empty history (docs/storage.md#history)
 :seon.db/no-history [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/no-history]]]]
 ;; what seon.db/history or at was asked to read and the store does not hold: an :entity, :branch, :commit or :t (a t this branch never
 ;; had: t ids are unique across the store, so another branch's t is none of this one's)
 :seon.db/unresolved [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/unresolved]] [:kind [:enum :entity :branch :commit :t]] [:value :any]]]
 :seon.db/ids-unopened [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/ids-unopened]] [:path :string] [:errno :int]]]
 :seon.db/store-unplaced [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/store-unplaced]] [:path :string] [:errno :int]]]
 :seon.sqlite/unloaded [:and :seon.error/base [:map [:seon.error/type [:= :seon.sqlite/unloaded]] [:path :string]]]
 :seon.sqlite/refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.sqlite/refused]] [:op :keyword] [:rc :int]]]
 :seon.vector/model-unopened [:and :seon.error/base [:map [:seon.error/type [:= :seon.vector/model-unopened]] [:path :string]]]
 :seon.vector/helper-died [:and :seon.error/base [:map [:seon.error/type [:= :seon.vector/helper-died]] [:exit :int] [:stderr :string]]]
 :seon.vector/encode-failed [:and :seon.error/base [:map [:seon.error/type [:= :seon.vector/encode-failed]] [:code :int]]]
 :seon.system/no-agent [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/no-agent]] [:agent {:optional true} [:maybe :keyword]]]]
 ;; a wait on main (seon.system/await-db) whose pred was false when the reconciler went quiet at
 ;; t: nothing in flight will make it true (an outside commit still may)
 :seon.system/quiet-before-true [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/quiet-before-true]] [:t :int] [:waits-on :string]]]
 ;; a request to an agent after it ended (root stopped it, or it died): not gone, it was
 :seon.system/ended [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/ended]] [:agent :keyword]]]
 :seon.agent/last-op [:map [:kind :keyword] [:form {:optional true} [:maybe :string]] [:since-ms {:optional true} [:maybe :int]]]
 :seon.agent/died [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/died]] [:agent :keyword]
                                          [:pid {:optional true} [:maybe :int]] [:exit {:optional true} [:maybe :seon.lib/exit-status]]
                                          [:stderr {:optional true} [:maybe :string]] [:last-op {:optional true} [:maybe :seon.agent/last-op]]]]
 ;; a message root sent an agent that the wire's codec cannot encode: answered to its request in its place, the end kept open
 :seon.agent/unencodable [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/unencodable]] [:message-op {:optional true} [:maybe :keyword]]]]
 ;; what root saw go wrong for an agent: a red test run of an agent with no task (a task's
 ;; run records its reds at its end), a spawn or fork refused (seon.system/set-agent)
 :seon.agent/failed [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/failed]] [:agent :keyword]]]
 ;; an agent's socket to root that cannot raise SIGIO (seon.sock/signal-at-input!): the agent
 ;; ends with its root only when it next reads that socket
 :seon.sock/unwatched [:and :seon.error/base [:map [:seon.error/type [:= :seon.sock/unwatched]] [:errno :int]]]
 ;; the kernel refused a write for a reason other than a gone peer
 :seon.sock/write-failed [:and :seon.error/base [:map [:seon.error/type [:= :seon.sock/write-failed]] [:errno :int] [:fd :int] [:sent :int] [:of :int]]]
 :seon.agent/stalled [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/stalled]] [:agent :keyword]
                                             [:quiet-ms :int] [:last-op {:optional true} [:maybe :seon.agent/last-op]]]]
 ;; a resumed agent's branch program that did not load (seon.program/load-diff!): main's ran instead
 ;; an agent's boot check found its SIGUSR1 handler never ran (seon.agent/interrupt-self-test)
 :seon.agent/interrupt-unreachable [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/interrupt-unreachable]]]]
 :seon.agent/load-failed [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/load-failed]] [:ns :symbol]]]
 ;; an agent's config cites a wiki section its store holds no entity for (seon.task/agent-cites-missing, said in its hello): it runs
 ;; citing the rest (docs/references.md#an-entity-cites)
 :seon.agent/cite-missing [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/cite-missing]] [:address :string]]]
 ;; an agent forked from a program that did not load (seon.system's set-agent at its hello): every load error it was given; the agent runs
 :seon.agent/program-differs [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/program-differs]] [:differs [:vector :map]]]]
 :seon.agent/started-without-program [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/started-without-program]] [:errors [:vector :seon.program/error]]]]
 ;; a new agent whose branch or forked image is not at the commit root branched it from
 ;; (the writer's :spawn names main's commit and t on :fork; seon.agent/init! compares)
 :seon.agent/fork-misaligned [:and :seon.error/base [:map [:seon.error/type [:= :seon.agent/fork-misaligned]]
                                                     [:commit :uuid] [:t :int] [:branch-commit [:maybe :uuid]] [:image-t :int]]]
 :seon.system/proc-defect [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/proc-defect]] [:pid {:optional true} [:maybe :keyword]]
                                                     [:took {:optional true} [:or :keyword [:vector :keyword]]]]]
 :seon.system/refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/refused]]]]
 :seon.system/no-gate-checkout [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/no-gate-checkout]]]]
 ;; a step of the fork server that threw (seon.fork-server/server-step): docs/processes.md#a-step-that-throws
 :seon.fork-server/step-failed [:and :seon.error/base [:map [:seon.error/type [:= :seon.fork-server/step-failed]] [:op {:optional true} [:maybe :keyword]]]]
 ;; the fork server made no standby (seon.system/back-op): a platform problem, and root's view shows it has none (docs/processes.md#a-step-that-throws)
 :seon.fork-server/standby-failed [:and :seon.error/base [:map [:seon.error/type [:= :seon.fork-server/standby-failed]] [:active-threads {:optional true} [:maybe :int]] [:gen {:optional true} [:maybe :int]]]]
 ;; a release (my.root/run!) of a task that is not held: unknown (execution nil), already
 ;; running, or cancelled; the held ids of the same call are released
 :seon.system/not-held [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/not-held]] [:task :string]
                                             [:execution [:maybe [:enum :held :running :cancelled]]]]]
 ;; a cancel (my.root/cancel-tx) of an id that names no task: answered, never upserted as a task
 :seon.system/unknown-task [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/unknown-task]] [:task :string]]]
 ;; seon.ctx.session/session-tx of a key no agent holds, of a session with no request to show or with a record of a kind an
 ;; example does not hold: docs/tasks.md#a-task-names-example-sessions
 ;; a request whose tree drew no system message (seon.ctx.wire/request): refused, what stood first in its place named
 ;; a definition that broke Seon's recording of it, undone (seon.repl/undo-definition!)
 :seon.repl/definition-undone [:and :seon.error/base [:map [:seon.error/type [:= :seon.repl/definition-undone]] [:vars [:vector :any]]]]
 ;; a call Seon writes for the model whose function's var lacks its reply or its intent (seon.ctx.wire/page-message; docs/render.md#the-render-is-an-eval)
 :seon.ctx/unworded [:and :seon.error/base [:map [:seon.error/type [:= :seon.ctx/unworded]] [:function {:optional true} :symbol]]]
 :seon.ctx/no-system-message [:and :seon.error/base [:map [:seon.error/type [:= :seon.ctx/no-system-message]] [:first {:optional true} [:maybe :map]]]]
 :seon.ctx/session-refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.ctx/session-refused]] [:key :string]]]
 ;; my.root/example-txs of an example file that is missing, does not read as EDN, or is not the vector of tx-data
 ;; seon.ctx.session/session-tx writes: docs/failure-points.md
 :seon.system/example-refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/example-refused]] [:path :string]]]
 ;; my.root/write-back! of a run that lost no write-back (or does not exist), of a root with no source tree,
 ;; or of files main holds no text for: nothing to write
 :seon.system/nothing-lost [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/nothing-lost]] [:run :string]]]
 ;; my.root/sync-req: a task named that is no merged task main's files still declare (docs/source.md#a-merged-task-reaches-mains-files)
 :seon.system/nothing-to-sync [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/nothing-to-sync]] [:task :seon.task/id]]]
 :seon.system/no-source-root [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/no-source-root]] [:runs [:vector :string]]]]
 ;; the daily full run asked while the one before it has not ended (seon.prove's full run): a hung
 ;; full run is seen the next day, never a day skipped in silence
 :seon.prove/full-run-red [:and :seon.error/base [:map [:seon.error/type [:= :seon.prove/full-run-red]] [:tests [:vector :qualified-symbol]]]]
 :seon.prove/full-run-running [:and :seon.error/base [:map [:seon.error/type [:= :seon.prove/full-run-running]] [:running :string]]]
 :seon.prove/no-verdict [:and :seon.error/base [:map [:seon.error/type [:= :seon.prove/no-verdict]] [:test [:or :qualified-symbol :string]]]]
 ;; a tree's build or seed that is not green (seon.prove/item-ended): every item that needs it answers it, none granted
 :seon.prove/build-red [:and :seon.error/base [:map [:seon.error/type [:= :seon.prove/build-red]] [:tree :string] [:kind [:enum :build :seed]]]]
 :seon.prove/superseded [:and :seon.error/base [:map {:description "A run of the test service ended because a request for the same slot came at another digest: its branch moved on (seon.prove/request). See docs/merging.md#the-test-service."} [:seon.error/type [:= :seon.prove/superseded]] [:by :string]]]
 :seon.system/no-source-text [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/no-source-text]] [:paths [:vector :string]]]]
 ;; my.root/hold! of a task that is not running (held, cancelled, unknown): nothing to take back
 :seon.system/not-running [:and :seon.error/base [:map [:seon.error/type [:= :seon.system/not-running]] [:task :string]
                                                [:execution [:maybe [:enum :held :running :cancelled]]]]]
 ;; a defect answering one outside request at root's server (seon.server/respond): the
 ;; line it took, and the cause's ex-data printed; the server goes on serving
 :seon.server/held [:and :seon.error/base [:map [:seon.error/type [:= :seon.server/held]] [:agent :keyword] [:task :seon.task/id] [:holder :string]]]
 ;; a client's request that root never answered (seon.server/ask-streamed): no root on port, or the connection's end before the answer
 :seon.server/unanswered [:and :seon.error/base [:map [:seon.error/type [:= :seon.server/unanswered]] [:port :int] [:why [:enum :refused :eof :reset]]]]
 :seon.server/defect [:and :seon.error/base [:map [:seon.error/type [:= :seon.server/defect]] [:line :string] [:data {:optional true} :seon.db/plain]]]
 ;; a value its attribute's declared schema refuses, at the write (seon.db/invalid-datom)
 :seon.db/invalid-datom [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/invalid-datom]] [:attribute :qualified-keyword]]]
 ;; a lookup ref a write names that names no entity (a cite's target, a wiki link to no section), at the write (seon.db/checked): the lookup
 :seon.db/no-target [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/no-target]] [:target :seon.ref/target]]]
 ;; an entity a write touched that an entity schema its keys select refuses, at the write (seon.db/invalid-entity)
 :seon.db/invalid-entity [:and :seon.error/base [:map [:seon.error/type [:= :seon.db/invalid-entity]] [:entity :string] [:schema :qualified-keyword]
                          [:missing [:vector :qualified-keyword]] [:entities {:optional true} [:vector :string]]]]
 :seon.writer/refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.writer/refused]]]]
 :seon.merge/uncontracted [:and :seon.error/base [:map [:seon.error/type [:= :seon.merge/uncontracted]]
                                                  [:uncontracted [:vector :qualified-symbol]]]]
 ;; a form or a test run stopped by the work it did: its engine ticks reached the budget
 ;; (procedure calls and loop back-edges; never elapsed time): runtime-fixable, the agent's to read
 :seon.repl/ticks-spent [:and :seon.error/base [:map [:seon.error/type [:= :seon.repl/ticks-spent]] [:ticks :int] [:budget :int]]]
 ;; a form that allocated past its byte budget (seon.intr/run): what it allocated, its budget
 :seon.repl/bytes-spent [:and :seon.error/base [:map [:seon.error/type [:= :seon.repl/bytes-spent]] [:bytes :int] [:budget :int]]]
 ;; the agent could not fork its test run (threads were active): no proof ran
 :seon.test/fork-refused [:and :seon.error/base [:map [:seon.error/type [:= :seon.test/fork-refused]] [:active-threads :int]]]
 ;; a line the agent's test process sent does not read (a value that prints as no EDN in it): its test
 ;; ends :error with the line's head, and the agent goes on (seon.agent/child-line)
 :seon.test/unreadable-line [:and :seon.error/base [:map [:seon.error/type [:= :seon.test/unreadable-line]]]]
 ;; the OS refused the thread that ends a process with its starter (seon.lib/end-with!)
 :seon.lib/starter-unwatched [:and :seon.error/base [:map [:seon.error/type [:= :seon.lib/starter-unwatched]] [:pid [:maybe :int]]]]
 :seon.test/ticks-spent [:and :seon.error/base [:map [:seon.error/type [:= :seon.test/ticks-spent]] [:ticks :int] [:budget :int]
                                                [:test {:optional true} :string]]]
 :seon.fx/io-error [:and :seon.error/base [:map [:seon.error/type [:= :seon.fx/io-error]]]]
 ;; a merged task's write-back the git effect refused (seon.reconcile/commit-tx): held in the task's :seon.task/error
 ;; with the source files no commit holds yet, until one does (my.root/write-back!)
 :seon.git/commit-failed [:and :seon.error/base [:map [:seon.error/type [:= :seon.git/commit-failed]] [:seon.git/files [:vector :string]]]]
 ;; a cost proof the cap (:seon.config.proofs/cost-max-n) leaves fewer than seon.cost/min-points sizes: refused, measured nothing
 :seon.cost/too-few-sizes [:and :seon.error/base [:map [:seon.error/type [:= :seon.cost/too-few-sizes]] [:of :qualified-symbol]
                                                  [:sizes [:vector pos-int?]] [:cap pos-int?]]]
 :seon.fx/unresolved [:and :seon.error/base [:map [:seon.error/type [:= :seon.fx/unresolved]] [:deps [:vector :symbol]] [:unresolved [:vector :map]]]]
 :seon.fx/budget-spent [:and :seon.error/base [:map [:seon.error/type [:= :seon.fx/budget-spent]]]]
 :seon.fx/defect [:and :seon.error/base [:map [:seon.error/type [:= :seon.fx/defect]]]]
 :seon.fx/unknown-kind [:and :seon.error/base [:map [:seon.error/type [:= :seon.fx/unknown-kind]]]]
 :seon.fx/in-test [:and :seon.error/base [:map [:seon.error/type [:= :seon.fx/in-test]]]]
 ;; the provider's HTTP 429: transient, the :model owner keeps the request and pauses (its Retry-After when given)
 :seon.model/rate-limited [:and :seon.error/base [:map [:seon.error/type [:= :seon.model/rate-limited]] [:status {:optional true} :int]
                                                  [:body {:optional true} :string] [:retry-after-ms {:optional true} :int]]]
 ;; the connection failed or died (connect, reset, EOF mid-reply): transient, kept and retried after a pause
 :seon.turn/cache-miss [:and :seon.error/base [:map [:seon.error/type [:= :seon.turn/cache-miss]] [:hit nat-int?] [:expected nat-int?] [:block pos-int?] [:shared nat-int?] [:messages nat-int?]]]
 :seon.model/transport [:and :seon.error/base [:map [:seon.error/type [:= :seon.model/transport]] [:url {:optional true} :string]]]
 ;; the reply's content is empty while its reasoning is not: thinking spent the token budget
 :seon.model/reasoning-ate-reply [:and :seon.error/base [:map [:seon.error/type [:= :seon.model/reasoning-ate-reply]]
                                                         [:reasoning-tokens {:optional true} :int] [:completion-tokens {:optional true} :int]
                                                         [:max-tokens {:optional true} :int] [:reasoning-chars :int]]]
 ;; the config names no model provider (no profile): the turn ends on it, naming what to set
 :seon.model/no-provider [:and :seon.error/base [:map [:seon.error/type [:= :seon.model/no-provider]]]]
 ;; a model's reply that does not read or compile where the first-move judge analyzes it (seon.judge/form-facts)
 :seon.judge/uncompiled [:and :seon.error/base [:map [:seon.error/type [:= :seon.judge/uncompiled]]]]
 ;; a first-move pass whose reply's usage cannot be priced: the pass stops there (my.root/first-moves!)
 ;; the disposable scoring agent answered no score (its eval's error, as it came)
 :seon.judge/unscored [:and :seon.error/base [:map [:seon.error/type [:= :seon.judge/unscored]]]]
 :seon.judge/cost-unknown [:and :seon.error/base [:map [:seon.error/type [:= :seon.judge/cost-unknown]]]]
 ;; the scripted provider's :script names a function this process cannot load (its namespace is
 ;; on no source root, or does not define it): seon.model/scripted
 :seon.model/no-script [:and :seon.error/base [:map [:seon.error/type [:= :seon.model/no-script]] [:script :qualified-symbol]]]
 ;; a scripted model (a test fixture) that answered no :seon.model/script-reply: its problems say what is wrong
 :seon.model/script-invalid [:and :seon.error/base [:map [:seon.error/type [:= :seon.model/script-invalid]] [:script :qualified-symbol]]]
 :seon.model/failure [:or :seon.model/no-provider :seon.model/no-script :seon.model/script-invalid :seon.model/provider-error :seon.model/rate-limited :seon.model/transport :seon.model/reasoning-ate-reply]

 ;; ---- recorded errors: one entity per signature (main), counted across agents ----
 ;; who observed it: a root proc's defect, an agent's eval, an agent's death or stall, an effect's outcome
 :seon.error/class [:enum :platform :eval :agent :effect]
 :seon.error/signature [:and {:seon.db/identity true} [:string {:min 16 :max 16}]]
 :seon.error/count :int
 :seon.error/agents :int
 :seon.error/first-ms :int
 :seon.error/last-ms :int
 :seon.error/last-agent :keyword
 ;; indexed: a task's record reads the errors last raised in it by the task's id (seon.ctx, the task pattern)
 :seon.error/last-task [:and {:seon.db/index true} :string]
 :seon.error/form :string
 ;; the first occurrence's error map, as EDN
 :seon.error/example :seon.error/base
 :seon.error/recorded-fact [:map {:seon.db/attributes true}
                            [:seon.error/signature :seon.error/signature] [:seon.error/class :seon.error/class]
                            [:seon.error/count :seon.error/count] [:seon.error/agents :seon.error/agents]
                            [:seon.error/first-ms :seon.error/first-ms] [:seon.error/last-ms :seon.error/last-ms]
                            [:seon.error/type {:optional true} :seon.error/type]
                            [:seon.error/operation {:optional true} :seon.error/operation]
                            [:seon.error/message {:optional true} :seon.error/message]
                            [:seon.error/last-agent {:optional true} :seon.error/last-agent]
                            [:seon.error/last-task {:optional true} :seon.error/last-task]
                            [:seon.error/form {:optional true} :seon.error/form]
                            [:seon.error/subject {:optional true} :seon.error/subject]
                            [:seon.error/example {:optional true} :seon.error/example]]
 ;; one occurrence as its observer sees it (a value; never stored whole)
 :seon.error/occurrence [:map [:error :map] [:class :seon.error/class] [:cause [:vector :any]]
                         [:agent [:maybe :keyword]] [:task [:maybe :string]] [:form [:maybe :string]]
                         [:n pos-int?] [:first-ms :int] [:ms :int]]
 :seon.error/entry [:map [:signature :seon.error/signature] [:class :seon.error/class] [:count pos-int?]
                    [:agents [:set :keyword]] [:first-ms :int] [:last-ms :int] [:example :map]
                    [:form [:maybe :string]] [:last-agent [:maybe :keyword]] [:last-task [:maybe :string]]
                    [:dirty? :boolean] [:pending? {:optional true} :boolean] [:base {:optional true} :int]]
 ;; the fold in the observer's state: cause -> its running entry
 :seon.error/fold [:map-of [:vector :any] :seon.error/entry]
 ;; what an agent sends root with its commit: its occurrences since the last commit, folded
 :seon.error/sent [:map [:error :map] [:class :seon.error/class] [:form [:maybe :string]] [:n pos-int?] [:first-ms :int] [:last-ms :int]]

 ;; ---- problem members of how a task's work ended (on the task, on main; the judge writes them) and of the agent's end (its branch) ----
 ;; the error that ended it: the agent's death, the turn loop's error, a refused merge
 :seon.task/error :seon.error/base
 ;; failing assertions per red test (at most 8 each, printed by seon.print under :part)
 :seon.problems/assertion [:map [:type [:enum :fail :error]] [:message {:optional true} [:maybe :string]] [:flaky {:optional true} :boolean]
                           [:expected {:optional true} [:maybe :string]] [:actual {:optional true} [:maybe :string]]
                           [:got {:optional true} [:maybe :string]] [:seon.error/type {:optional true} :qualified-keyword]]
 ;; one clojure.test report as the test child keeps it (seon.agent/test-report)
 :seon.test/report [:map [:type :keyword] [:var {:optional true} [:maybe :string]] [:message {:optional true} [:maybe :string]]
                    [:expected {:optional true} [:maybe :string]] [:actual {:optional true} [:maybe :string]]
                    ;; a failed (is (pred ...)): what (pred ...) evaluated to, without clojure.test's (not ...)
                    [:got {:optional true} :string]
                    ;; a run stopped by its tick budget: the typed error, on the test that was running
                    [:seon.error/type {:optional true} :qualified-keyword] [:ticks {:optional true} :int] [:budget {:optional true} :int]
                    [:cost {:optional true} :seon.cost/report]]
 :seon.task/failures [:map-of :qualified-symbol [:vector :seon.problems/assertion]]
 ;; a cost proof's measured rows and verdict per test (seon.cost/proof's report)
 :seon.cost/report [:map [:rows [:vector {:gen/max 4} :seon.cost/row]] [:verdict :seon.cost/verdict]]
 :seon.task/costs [:map-of :qualified-symbol :seon.cost/report]
 ;; waste charged to the producer of what the agent was shown (R4, v1 survey idea 14)
 :seon.learn/waste [:map-of :any [:map [:forms :int] [:turns :int]]]
 :seon.task/waste :seon.learn/waste
 :seon.agent/waste :seon.learn/waste
 :seon.agent/error :seon.error/base
 ;; task content a branch and main both changed since the branch's base, differently: root's
 ;; to resolve (seon.task/carry-tx; owner, 2026-10-22, D4)
 :seon.task/task-conflicts [:vector [:map [:task :seon.task/id] [:attr :keyword] [:base :any] [:ours :any] [:theirs :any]]]

 ;; ---- the one read: seon.problems/report ----
 ;; each class's area, the group root's page and context show it under (docs/health.md),
 ;; declared once here and read through seon.contract/properties (as a status set is)
 :seon.problems/class [:enum {;; what a class's open rows are, said before their count (\"tasks that cite no section: 168\"), read by a person and the model alike
                             :seon.status/title {:stalled "stalled agents" :platform "platform errors" :eval "eval errors" :agent "agent errors" :effect "effect errors"
                                                    :error "errors" :waste "runs that wasted turns" :red "red proofs" :cost "proofs over their cost bound"
                                                    :merge "refused merges" :task-conflict "tasks in conflict with main" :unrun "merges whose tests did not run"
                                                    :unsynced "merged tasks not yet in main's files" :dead "agents that died" :failed "failed tasks"
                                                    :unnamed-site "catch sites the laws do not name" :stale-pin "stale pins" :stale-binary "binaries older than their source"
                                                    :stale-section "wiki sections whose cited code changed" :orphan-page "wiki pages nothing links"
                                                    :leadless-section "wiki sections with no lead" :uncited-task "tasks that cite no section"
                                                    :stale-plan "task plans that went stale" :uncited-var "functions that cite no section"
                                                    :problem-unlinked "problem classes with no wiki section" :long-form "forms too long" :waived-proof "proofs that pass by waiver" :undeclared-test "tests that break their law"}
                             :seon.problems/derived #{:stalled :unnamed-site :stale-pin :stale-binary :stale-section :orphan-page :leadless-section :uncited-task :stale-plan :uncited-var :problem-unlinked :long-form :waived-proof :unsynced :undeclared-test}
                             ;; shown, never a reason to refuse done (root's ruling, 2026-10-23: every var edit stales the sections that cite it)
                             :seon.problems/attention #{:stale-section :uncited-var :long-form}
                             :seon.problems/areas [[:docs #{:stale-pin :stale-section :orphan-page :leadless-section :uncited-var}] [:tests #{:red :cost :waived-proof :undeclared-test}]
                                                    [:laws #{:unnamed-site :long-form}] [:merges #{:merge :task-conflict :unrun :unsynced}] [:tasks #{:failed :uncited-task :stale-plan}]
                                                    [:agents #{:stalled :dead :error :waste}] [:errors #{:platform :eval :agent :effect}] [:health #{:problem-unlinked :stale-binary}]]
                             ;; each class's section of the wiki: what it is and how it is fixed. A class with open rows whose
                             ;; section is no stored section is itself a problem (:problem-unlinked)
                             :seon.problems/docs {:stalled "docs/processes.md#a-stalled-agent" :platform "docs/errors.md#problems" :eval "docs/errors.md#problems" :agent "docs/errors.md#problems"
                                                  :effect "docs/errors.md#problems" :error "docs/errors.md#problems" :waste "docs/errors.md#problems"
                                                  :red "docs/tasks.md#the-done-rule" :cost "docs/tasks.md#the-done-rule"
                                                  :merge "docs/merging.md#conflicts-and-pins" :task-conflict "docs/merging.md#conflicts-and-pins"
                                                  :unrun "docs/merging.md#a-merge-runs-what-the-change-reaches" :unsynced "docs/source.md#a-merged-task-reaches-mains-files"
                                                  :dead "docs/root.md#runs-and-judging" :failed "docs/tasks.md#a-refused-run-is-held-for-root"
                                                  :unnamed-site "docs/health.md#a-laws-unnamed-site"
                                                  :stale-pin "docs/forks.md#branch-scheme" :stale-binary "docs/health.md#a-stale-binary" :stale-section "docs/health.md#a-stale-section"
                                                  :orphan-page "docs/health.md#an-orphan-page" :leadless-section "docs/health.md#a-section-with-no-lead" :uncited-task "docs/health.md#a-task-that-cites-nothing" :stale-plan "docs/health.md#a-plan-that-went-stale" :uncited-var "docs/health.md#a-function-that-cites-no-section" :long-form "docs/health.md#a-form-too-long" :waived-proof "docs/health.md#a-proof-that-passes-by-waiver" :problem-unlinked "docs/health.md#a-problem-with-no-page" :undeclared-test "docs/testing.md#test-kinds"}}
                       :stalled :platform :eval :agent :effect :red :cost :merge :dead :error :waste :failed :task-conflict :unnamed-site :stale-pin :stale-binary :unrun
                       :stale-section :orphan-page :leadless-section :uncited-task :stale-plan :uncited-var :problem-unlinked :long-form :waived-proof :unsynced :undeclared-test]
 :seon.problems/row [:map {:seon.render/hiccup seon.render.ui/problem-row}
                     [:producer [:maybe :qualified-symbol]] [:owner-ns [:maybe :symbol]]
                     [:evidence :map] [:proofs [:vector :qualified-symbol]] [:answered-by [:vector :string]]
                     [:at-ms [:maybe :int]]]
 :seon.problems/report [:map {:seon.render/hiccup seon.render.ui/problems :seon.render/model seon.render.ui/problems-model} [:t :int]
                        [:classes [:map-of :seon.problems/class [:map [:n nat-int?] [:rows [:vector :seon.problems/row]]]]]]}
