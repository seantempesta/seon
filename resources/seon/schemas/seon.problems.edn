#:seon.problems{:author :seon.cluster.agent/id,
                :deferred-agent
                [:map
                 [:seon.cluster.agent/id :seon.cluster.agent/id]
                 [:seon.cluster.work/episode-runs
                  :seon.cluster.work/episode-runs]
                 [:seon.problems/deferred-count [:int {:min 1}]]],
                :error-signature
                [:map
                 [:seon.error/signature :seon.error/signature]
                 [:seon.error/kind :seon.error/kind]
                 [:seon.problems/occurrences
                  :seon.problems/occurrences]
                 [:seon.error/fact :seon.error/fact]],
                :errored-receipt
                [:map
                 [:seon.cluster.eval/id :seon.cluster.eval/id]
                 [:seon.cluster.run/id :seon.cluster.run/id]
                 [:seon.cluster.eval/ordinal
                  :seon.cluster.eval/ordinal]
                 [:seon.cluster.run.form/source
                  :seon.cluster.run.form/source]
                 [:seon.error/kind :seon.error/kind]
                 [:seon.cluster.eval/error :seon.cluster.eval/error]],
                :failed-run
                [:map
                 [:seon.cluster.run/id :seon.cluster.run/id]
                 [:seon.cluster.agent/id :seon.cluster.agent/id]
                 [:seon.cluster.run/error :seon.cluster.run/error]],
                :form-problem
                [:map
                 [:seon.problems/id :seon.problems/id]
                 [:seon.cluster.eval/id :seon.cluster.eval/id]
                 [:seon.cluster.run/id :seon.cluster.run/id]
                 [:seon.cluster.run.form/ordinal
                  :seon.cluster.run.form/ordinal]
                 [:seon.cluster.run.form/source
                  :seon.cluster.run.form/source]
                 [:seon.cluster.agent/id :seon.cluster.agent/id]
                 [:seon.problems/author :seon.cluster.agent/id]
                 [:seon.error/kind :seon.error/kind]
                 [:seon.cluster.eval/error :seon.cluster.eval/error]],
                :form-problem-request
                [:map
                 [:seon.cluster.run/id :seon.cluster.run/id]
                 [:seon.cluster.run.form/ordinal
                  :seon.cluster.run.form/ordinal]
                 [:seon.sci.eval/evaluation
                  :seon.sci.eval/evaluation]],
                :id [:string {:min 1, :seon.db/identity true}],
                :occurrences [:int {:min 1}],
                :problems
                [:map
                 #:seon.render{:ai seon.problems/ai-prose,
                               :html seon.problems/html-report}
                 [:seon.problems/error-signatures
                  {:optional true}
                  [:vector :seon.problems/error-signature]]
                 [:seon.problems/wedged-runs
                  {:optional true}
                  [:vector :seon.problems/wedged-run]]
                 [:seon.problems/failed-runs
                  {:optional true}
                  [:vector :seon.problems/failed-run]]
                 [:seon.problems/errored-receipts
                  {:optional true}
                  [:vector :seon.problems/errored-receipt]]
                 [:seon.problems/deferred-agents
                  {:optional true}
                  [:vector :seon.problems/deferred-agent]]
                 [:seon.problems/unowned-namespaces
                  {:optional true}
                  [:vector :seon.problems/unowned-namespace]]
                 [:seon.problems/stale-vars
                  {:optional true}
                  [:vector :seon.problems/stale-var]]
                 [:seon.problems/missing-models
                  {:optional true}
                  [:vector :seon.problems/missing-model]]],
                :request
                [:map
                 [:seon.cluster.run/live-processes
                  :seon.cluster.run/live-processes]],
                :unowned-namespace
                [:map [:seon.ns/name :seon.ns/name]],
                :stale-var
                [:map
                 #:seon.render{:ai seon.problems/stale-var-ai,
                               :html seon.problems/stale-var-html}
                 [:seon.fn/sym :seon.fn/sym]],
                :missing-model
                [:map
                 #:seon.render{:ai seon.problems/missing-model-ai,
                               :html seon.problems/missing-model-html}
                 [:seon.config.ai/model :seon.config.ai/model]],
                :wedged-run
                [:map
                 [:seon.cluster.run/id :seon.cluster.run/id]
                 [:seon.cluster.agent/id :seon.cluster.agent/id]
                 [:seon.cluster.run/process :seon.cluster.run/process]],
                :unbound-var :seon.fn/sym
                :unbound-var-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the unbound var referenced by a failed form"} [:seon.problems/unbound-var :seon.problems/unbound-var] [:seon.error/message :seon.error/message]]
                :evaluation-failed [:= true]
                :evaluation-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a routed form whose evaluation failed"} [:seon.problems/evaluation-failed :seon.problems/evaluation-failed] [:seon.error/message :seon.error/message]]}
