;; The one value printer (seon.print): its options, its answer, and the internal shapes its
;; allotter (seon.print.select) and emitter (seon.print.emit) pass between their functions.
{:seon.print/opts [:map [:handle {:optional true} [:maybe [:or :symbol [:sequential :any]]]] [:budget {:optional true} pos-int?]
                   [:max-depth {:optional true} pos-int?] [:width {:optional true} nat-int?]
                   [:outputs {:optional true} [:set [:enum :text :hiccup]]]
                   ;; a nested value's own render: (fn [v] {:text :html}) for a value whose schema
                   ;; declares one, or (fn [v] {:value x}) for one whose schema declares a summary
                   ;; (x printed here, as any value), else nil; the printer shows it in that value's place
                   [:render {:optional true} [:maybe :seon.host/fn]]]
 :seon.print/answer [:map [:text :string] [:tokens nat-int?] [:truncated? :boolean] [:elisions nat-int?]
                     [:html {:optional true} :seon.print/hiccup]]
 ;; printed, or the budget refused the value's first part (an error map)
 :seon.print/result [:or :seon.print/answer [:map [:seon.error/type :qualified-keyword] [:seon.error/message :string]]]
 :seon.print/hiccup [:vector :any]
 ;; prose (seon.print/prose): text shown as itself under a budget; a cut says what it
 ;; omitted (characters, lines) and, given a source form, the form that reads the rest
 :seon.print/prose-opts [:map [:source {:optional true} :any] [:one-line? {:optional true} :boolean]]
 :seon.print/prose [:map [:text :string] [:shown :string] [:truncated? :boolean]
                    [:omitted {:optional true} nat-int?] [:lines {:optional true} nat-int?]
                    [:offset {:optional true} nat-int?] [:continuation {:optional true} :any]]
 ;; the allotter's working node ({:kind :leaf|:string|:name|:map|:coll|:entry ...}) and its context (budget, width, config keys)
 :seon.print/alloc [:map [:kind [:enum :leaf :string :name :map :coll :entry]]]
 :seon.print/context [:map [:budget number?] [:max-depth number?]]
 ;; a print node (a face and its members), and one fipp operation
 :seon.print/node :map
 :seon.print/op [:map [:op :keyword]]}
