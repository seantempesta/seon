#:seon.print{:default [:or :boolean :int :keyword],
             :face
             [:enum
              :seon.print/nil
              :seon.print/boolean
              :seon.print/number
              :seon.print/keyword
              :seon.print/symbol
              :seon.print/char
              :seon.print/string
              :seon.print/inst
              :seon.print/uuid
              :seon.print/vector
              :seon.print/list
              :seon.print/set
              :seon.print/map
              :seon.print/record
              :seon.print/var
              :seon.print/type
              :seon.print/class
              :seon.print/object
              :seon.print/truncated-string
              :seon.print/failed
              :seon.print/throwable
              :seon.print/elided
              :seon.print/projected
              :seon.print/pruned],
             :length
             [:int
              {:min 0,
               :seon.config/dial true,
               :seon.print/default 32}],
             :level
             [:int
              {:min 0, :seon.config/dial true, :seon.print/default 8}],
             :namespace-maps? [:boolean #:seon.print{:default true}],
             :node
             [:schema
              {:registry
               #:seon.print{:node*
                            [:multi
                             {:dispatch :seon.print/face}
                             [:seon.print/nil
                              [:map
                               [:seon.print/face [:= :seon.print/nil]]
                               [:seon.print/value :nil]]]
                             [:seon.print/boolean
                              [:map
                               [:seon.print/face
                                [:= :seon.print/boolean]]
                               [:seon.print/value :boolean]]]
                             [:seon.print/number
                              [:map
                               [:seon.print/face
                                [:= :seon.print/number]]
                               [:seon.print/value
                                [:fn
                                 #:gen{:gen
                                       seon.print/number-generator}
                                 seon.print/print-number?]]]]
                             [:seon.print/keyword
                              [:map
                               [:seon.print/face
                                [:= :seon.print/keyword]]
                               [:seon.print/value :keyword]]]
                             [:seon.print/symbol
                              [:map
                               [:seon.print/face
                                [:= :seon.print/symbol]]
                               [:seon.print/value :symbol]]]
                             [:seon.print/char
                              [:map
                               [:seon.print/face [:= :seon.print/char]]
                               [:seon.print/value
                                [:fn
                                 #:gen{:gen seon.print/char-generator}
                                 seon.print/print-char?]]]]
                             [:seon.print/string
                              [:map
                               [:seon.print/face
                                [:= :seon.print/string]]
                               [:seon.print/value :string]]]
                             [:seon.print/inst
                              [:map
                               [:seon.print/face [:= :seon.print/inst]]
                               [:seon.print/value :inst]]]
                             [:seon.print/uuid
                              [:map
                               [:seon.print/face [:= :seon.print/uuid]]
                               [:seon.print/value :uuid]]]
                             [:seon.print/vector
                              [:map
                               [:seon.print/face
                                [:= :seon.print/vector]]
                               [:seon.print/items
                                [:vector [:ref :seon.print/node*]]]]]
                             [:seon.print/list
                              [:map
                               [:seon.print/face [:= :seon.print/list]]
                               [:seon.print/items
                                [:vector [:ref :seon.print/node*]]]]]
                             [:seon.print/set
                              [:map
                               [:seon.print/face [:= :seon.print/set]]
                               [:seon.print/items
                                [:vector [:ref :seon.print/node*]]]]]
                             [:seon.print/map
                              [:map
                               [:seon.print/face [:= :seon.print/map]]
                               [:seon.print/entries
                                [:vector
                                 [:or
                                  [:tuple
                                   [:ref :seon.print/node*]
                                   [:ref :seon.print/node*]]
                                  [:map
                                   [:seon.print/face
                                    [:= :seon.print/elided]]]]]]]]
                             [:seon.print/record
                              [:map
                               [:seon.print/face
                                [:= :seon.print/record]]
                               [:seon.print/name :string]
                               [:seon.print/entries
                                [:vector
                                 [:or
                                  [:tuple
                                   [:ref :seon.print/node*]
                                   [:ref :seon.print/node*]]
                                  [:map
                                   [:seon.print/face
                                    [:= :seon.print/elided]]]]]]]]
                             [:seon.print/var
                              [:map
                               [:seon.print/face [:= :seon.print/var]]
                               [:seon.print/name :string]]]
                             [:seon.print/type
                              [:map
                               [:seon.print/face [:= :seon.print/type]]
                               [:seon.print/name :string]]]
                             [:seon.print/class
                              [:map
                               [:seon.print/face
                                [:= :seon.print/class]]
                               [:seon.print/name :string]]]
                             [:seon.print/object
                              [:map
                               [:seon.print/face
                                [:= :seon.print/object]]
                               [:seon.print/class :string]
                               [:seon.print/address :string]
                               [:seon.print/rep
                                {:optional true}
                                :string]]]
                             [:seon.print/truncated-string
                              [:map
                               [:seon.print/face
                                [:= :seon.print/truncated-string]]
                               [:seon.print/value :string]
                               [:seon.print/length [:int {:min 0}]]]]
                             [:seon.print/failed
                              [:map
                               [:seon.print/face
                                [:= :seon.print/failed]]
                               [:seon.print/class :string]
                               [:seon.print/message :string]]]
                             [:seon.print/throwable
                              [:map
                               [:seon.print/face
                                [:= :seon.print/throwable]]
                               [:seon.print/value
                                [:ref :seon.print/node*]]]]
                             [:seon.print/elided
                              :seon.print/elision]
                             [:seon.print/projected
                              [:map
                               {:gen/gen seon.print/projected-node-generator}
                               [:seon.print/face
                                [:= :seon.print/projected]]
                               [:seon.render/output
                                [:enum
                                 :seon.render/ai
                                 :seon.render/html]]
                               [:seon.print/value
                                [:or
                                 :string
                                 :seon.render/hiccup]]]]
                             [:seon.print/pruned
                              [:map
                               [:seon.print/face
                                [:= :seon.print/pruned]]]]]}}
              [:ref :seon.print/node*]],
             :options
             [:map
              [:seon.print/length
               {:optional true}
               [:maybe :seon.print/length]]
              [:seon.print/level
               {:optional true}
               [:maybe :seon.print/level]]
              [:seon.print/width {:optional true} :seon.print/width]
              [:seon.print/namespace-maps?
               {:optional true}
               :seon.print/namespace-maps?]
              [:seon.print/table?
               {:optional true}
               :seon.print/table?]],
             :result
             [:map
              [:seon.print/text :string]
              [:seon.print/hiccup :seon.render/hiccup]],
             :omitted [:int {:min 1}],
             :elision-unit
             [:enum :children :characters :subtree :tokens],
             :requery-id :seon.schema/value,
             :requery-refusal [:string {:min 1}],
             :prefix :string,
             :elision-base
             [:map
              [:seon.print/face [:= :seon.print/elided]]
              [:seon.print/omitted :seon.print/omitted]
              [:seon.print/elision-unit :seon.print/elision-unit]
              [:seon.render.data/total
               {:optional true}
               :seon.render.data/total]
              [:seon.render.data/path :seon.render.data/path]
              [:seon.render.data/next-offset
               :seon.render.data/next-offset]
              [:seon.render.profile/id :seon.render.profile/id]
              [:seon.print/prefix {:optional true} :string]],
             :elision
             [:or
              {:seon.render/ai seon.print/render-elision-ai
               :gen/gen seon.print/elision-node-generator}
              [:map
               [:seon.print/face [:= :seon.print/elided]]
               [:seon.print/omitted :seon.print/omitted]
               [:seon.print/elision-unit :seon.print/elision-unit]
               [:seon.render.data/total
                {:optional true}
                :seon.render.data/total]
               [:seon.render.data/path :seon.render.data/path]
               [:seon.render.data/next-offset
                :seon.render.data/next-offset]
               [:seon.render.profile/id :seon.render.profile/id]
               [:seon.print/prefix {:optional true} :string]
               [:seon.print/requery-id :seon.print/requery-id]]
              [:map
               [:seon.print/face [:= :seon.print/elided]]
               [:seon.print/omitted :seon.print/omitted]
               [:seon.print/elision-unit :seon.print/elision-unit]
               [:seon.render.data/total
                {:optional true}
                :seon.render.data/total]
               [:seon.render.data/path :seon.render.data/path]
               [:seon.render.data/next-offset
                :seon.render.data/next-offset]
               [:seon.render.profile/id :seon.render.profile/id]
               [:seon.print/prefix {:optional true} :string]
               [:seon.print/requery-refusal
                :seon.print/requery-refusal]]],
             :sink
             [:fn
              {:error/message "must implement seon.print/Sink"
               :gen/gen seon.print/sink-generator}
              seon.print/sink?],
             :table?
             [:enum
              #:seon.print{:default :derived}
              :derived
              true
              false],
             :width [:int {:min 0, :seon.print/default 72}],
             :unknown-face :seon.print/face
             :unknown-face-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the requested print face that is not declared"} [:seon.print/unknown-face :seon.print/unknown-face] [:seon.error/message :seon.error/message]]}
