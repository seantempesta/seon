;; The one value printer (seon.print): its options, its answer, and the internal shapes its
;; allotter (seon.print.select) and emitter (seon.print.emit) pass between their functions.
{:seon.print/opts [:map [:handle {:optional true} [:maybe [:or :symbol [:sequential :any]]]] [:budget {:optional true} pos-int?]
                   [:max-depth {:optional true} pos-int?] [:width {:optional true} nat-int?]
                   [:outputs {:optional true} [:set [:enum :text :hiccup]]]
                   ;; a nested value's own render: (fn [v] {:text :html}) for a value whose schema
                   ;; declares one, or (fn [v] {:value x}) for one whose schema declares a summary
                   ;; (x printed here, as any value), else nil; the printer shows it in that value's place
                   [:render {:optional true} [:maybe :seon.host/fn]]]
 :seon.print/answer [:map [:text :string] [:tokens nat-int?] [:truncated? :boolean] [:elisions nat-int?]
                     [:html {:optional true} :seon.print/hiccup]]
 ;; printed, or the budget refused the value's first part (an error map)
 :seon.print/result [:or :seon.print/answer [:map [:seon.error/type :qualified-keyword] [:seon.error/message :string]]]
 :seon.print/hiccup [:vector :any]
 ;; a tool's answer, as seon.render/answer makes it for every tool whose schema says what brings more (docs/render.md#a-render-is-a-value-printed-once)
 :seon.print/is [:string {:description "What the answer is: the first sentence of its schema's :description."}]
 :seon.print/to-use [:vector {:description "The forms that act on a value, each [words form], read from its schema's :seon.render/more, with v (the value), path or id filled; a describe entry's are for its own path."} [:tuple :string :any]]
 ;; text (seon.print/plain): text shown as itself under a budget; a cut says what it
 ;; omitted (characters, lines) and, given a source form, the form that reads the rest
 :seon.print/plain-opts [:map [:source {:optional true} :any] [:one-line? {:optional true} :boolean]]
 :seon.print/plain [:map [:text :string] [:shown :string] [:truncated? :boolean]
                    [:omitted {:optional true} nat-int?] [:lines {:optional true} nat-int?]
                    [:offset {:optional true} nat-int?] [:continuation {:optional true} :any]]
 ;; the allotter's working node ({:kind :leaf|:string|:name|:map|:coll|:entry ...}) and its context (budget, width, config keys)
 :seon.print/alloc [:map [:kind [:enum :leaf :string :name :map :coll :entry]]]
 :seon.print/context [:map [:budget number?] [:max-depth number?]]
 ;; a print node (a face and its members), and one fipp operation
 :seon.print/node :map
 :seon.print/op [:map [:op :keyword]]
 ;; the printer's faces, the css class names and the node and op keys the emitter and allotter pass (keys-schemas sweep; docs/render.md#one-printer)
 :seon.print/class [:or {:description "On a print op, the css class keyword of its text; on a class or object node, the class name."} :keyword :string]
 :seon.print/code [:or {:description "Marked code: the one key of a map whose string is code shown exactly as written (seon.print/plain marks text); also the face and the mark naming it."} :string [:= :seon.print/code]]
 :seon.print/face [:enum {:description "What a print node is: the type of value it holds, which picks how it is laid out and its css class."} :seon.print/nil :seon.print/boolean :seon.print/number :seon.print/keyword :seon.print/symbol :seon.print/char :seon.print/string :seon.print/code :seon.print/inst :seon.print/uuid :seon.print/var :seon.print/class :seon.print/object :seon.print/rendered :seon.print/elided :seon.print/vector :seon.print/list :seon.print/set :seon.print/map :seon.print/throwable]
 :seon.print/value [:any {:description "The value a print node holds: any value, or for a throwable the map that prints it."}]
 :seon.print/text [:string {:description "A print node's text when it differs from the value's literal (a number too long to print, a cut name, a nested render's text)."}]
 :seon.print/html [:vector {:description "A nested value's own render as hiccup, kept on its rendered node."} :any]
 :seon.print/name [:string {:description "The name of a var (ns/name) or class node."}]
 :seon.print/rep [:string {:description "An object node's identity as hex, 0x..., printed after its class."}]
 :seon.print/items [:vector {:description "The member nodes of a vector, list or set node."} :seon.print/node]
 :seon.print/entries [:vector {:description "The entries of a map node, each [key-node value-node]."} [:tuple :seon.print/node :seon.print/node]]
 :seon.print/ordered? [:boolean {:description "True when a set node's members are shown in sorted order."}]
 :seon.print/lift [:string {:description "The namespace a map's keys share, printed once as #:ns{ ... }."}]
 :seon.print/indent [:int {:min 0 :description "The column of the code a node holds, so its later lines keep their place."}]
 :seon.print/code? [:maybe {:description "The mark of the text a node holds, :seon.print/code for code and :seon.print/plain for text, or nil for a plain string."} [:enum :seon.print/code :seon.print/plain]]
 :seon.print/name? [:boolean {:description "True when the node a cut belongs to is a keyword or symbol name, so its continuation reads (str ...)."}]
 :seon.print/elision-unit [:enum {:description "What an elided node counts: :characters of a string, :children of a collection, :left-out of a window, or :pending of a lazy seq not yet realized."} :characters :children :left-out :pending]
 :seon.print/omitted [:int {:min 0 :description "How many characters or members an elided node leaves out."}]
 :seon.print/left-out [:int {:min 0 :description "How many more members a window holds in the store than its value does."}]
 :seon.print/prefix [:string {:description "The characters of a cut string, name or code that are shown before its elision."}]
 :seon.print/lines [:int {:min 0 :description "How many lines of a cut string its elision leaves out."}]
 :seon.print/continuation [:any {:description "The form that reads what an elision omitted, from its next offset (seon.print.emit/continuation), or absent when the value has no result handle."}]
 :seon.print/requery-id [:or {:description "The handle cuts read through: a result/... symbol, or a form that reads the value."} :symbol [:sequential :any]]
 :seon.print/requery-refused [:string {:description "Why an elision has no continuation: the value has no result handle."}]
 :seon.print/path [:vector {:description "The path from a printed value's root to a node, in the steps of seon.render.data/path."} :any]
 :seon.print/width [:int {:min 0 :description "The print width in characters: the column the laid-out text wraps at, 0 for one line."}]
 :seon.print/budget [:int {:min 1 :description "In a value's metadata, the token budget its print uses in place of the caller's."}]
 :seon.print/full [:boolean {:description "In a value's metadata or a schema's properties, true when the value prints whole, however large: a page is. See docs/render.md#a-part-prints-as-its-render."}]
 :seon.print/charge [:int {:min 0 :description "The length the allotter charged a printed text, which the laid-out text may not exceed."}]
 :seon.print/open [:or {:description "On an emitter op :begin, what it opens: a collection node (with its path) or :seon.print/entry for a map entry."} :seon.print/node [:= :seon.print/entry]]
 :seon.print/close [:or {:description "On an emitter op :end, what it closes: the collection node or :seon.print/entry."} :seon.print/node [:= :seon.print/entry]]
 :seon.print/entry [:= {:description "A map entry: the marker of the :begin and :end ops around one, and the css class of its row."} :seon.print/entry]
 :seon.print/separator [:= {:description "The css class of a separator (a comma, a line break)."} :seon.print/separator]
 :seon.print/delimiter [:= {:description "The css class of a collection's delimiter."} :seon.print/delimiter]
 :seon.print/tag [:= {:description "The css class of a tag such as #error or an instant's literal."} :seon.print/tag]
 :seon.print/elision [:= {:description "The css class of the marker of a cut."} :seon.print/elision]
 :seon.print/cut [:= {:description "The css class of the button that reads what a cut left out."} :seon.print/cut]
 :seon.print/grid [:= {:description "The css class of a map shown as a definition grid."} :seon.print/grid]
 :seon.print/table [:= {:description "The css class of a vector of like maps shown as a table."} :seon.print/table]
 :seon.print/caption [:= {:description "The css class of a grid's caption, the namespace its keys share."} :seon.print/caption]
 :seon.print/key [:= {:description "The css class of a map entry's key."} :seon.print/key]
 :seon.print/val [:or {:description "On the hiccup of a map entry, in its metadata, the hiccup of its value (for a table or grid); also the css class of that value."} :seon.print/hiccup [:= :seon.print/val]]
 :seon.print/cells [:vector {:description "In the metadata of a grid's hiccup, each entry's [key value-hiccup], from which a table of like maps is built."} [:tuple :any :any]]
 :seon.print/rest [:vector {:description "In the metadata of a grid's hiccup, the rows that are not entries (an elision), kept after a table's cells."} :any]}
