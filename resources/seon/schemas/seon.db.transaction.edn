#:seon.db.transaction
{:process [:string {:min 1 :seon.db/index true
                    :description "Observed writer process generation (pid and start instant); retained after the process exits."}]
 :operation [:qualified-symbol {:seon.db/index true
                               :description "Caller-named operation, first named transaction function, or seon.db/transact! for an unnamed plain write."}]
 :agent [:string {:min 1 :seon.db/index true
                  :description "Observed calling agent id; absent for a system write with no agent world."}]
 ;; No producer: the work a world did is its cost entities (:seon.fn.cost/entity).
 ;; Kept declared only until they can be retired (task
 ;; seon.db/transaction-stamp-attributes-outlive-their-producer).
 :ms [:int {:min 0 :seon.db/no-history? true
            :description "No longer written: milliseconds a stamped transaction's world worked since its previous transaction."}]
 :calls [:int {:min 1 :seon.db/no-history? true
               :description "No longer written: armed calls a stamped transaction's world made since its previous transaction."}]
 :hot [:set {:seon.db/no-history? true :description "No longer written: a stamped transaction's top definitions by self time, each [sym digest calls self-ms]."}
       [:tuple :qualified-symbol :seon.program/definition-digest [:int {:min 1}] [:int {:min 0}]]]
 :repeated [:set {:seon.db/no-history? true :description "No longer written: each definition a stamped transaction's work called more than seon.batch/repeated-calls times, as [sym digest calls]."}
            [:tuple :qualified-symbol :seon.program/definition-digest [:int {:min 1}]]]}
