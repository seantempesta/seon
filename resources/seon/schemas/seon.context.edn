#:seon.context{:task
               [:map {:description "The task an agent holds as its effective task reads on its branch (seon.task/effective): the goal its chain shares and its step's own instructions."}
                [:seon.task/id :seon.task/id]
                [:seon.task/sym :seon.task/sym]
                [:seon.task/plan :seon.task/plan]
                [:seon.task/instructions {:optional true} :seon.task/instructions]],
               :merged [:map {:description "What main's merge of a step before the held task moved, by family, each name shown one level (seon.ref/brief): its summary and the form that reads it, never its content; families absent when empty. Producer: seon.context/merged."}
                        [:seon.context/functions {:optional true} :seon.context/functions]
                        [:seon.context/schemas {:optional true} :seon.context/schemas]
                        [:seon.context/tests {:optional true} :seon.context/tests]
                        [:seon.context/tasks {:optional true} :seon.context/tasks]]
               :functions [:vector {:description "The functions a merge moved, each shown one level."} [:or :seon.ref/brief :seon.ref/problem]]
               :schemas [:vector {:description "The schemas a merge moved, each shown one level."} [:or :seon.ref/brief :seon.ref/problem]]
               :tests [:vector {:description "The deftests a merge moved, each shown one level."} [:or :seon.ref/brief :seon.ref/problem]]
               :tasks [:vector {:description "The tasks a merge moved, each shown one level."} [:or :seon.ref/brief :seon.ref/problem]]
               :step-before [:map {:description "A step the held task needs: its kind and, once main merged an assignment of it, :seon.task/outcome :merged with what that merge moved. Producer: seon.context/step-before."}
                             [:seon.task/sym :seon.task/sym] [:seon.task/step {:optional true} :seon.task/step]
                             [:seon.task/outcome {:optional true} :seon.task/outcome]
                             [:seon.context/merged {:optional true} :seon.context/merged]]
               :step-after [:map {:description "A step that needs the held task: its symbol, the name a Prove step tags its product with, its kind and its instructions."}
                            [:seon.task/sym :seon.task/sym] [:seon.task/step {:optional true} :seon.task/step]
                            [:seon.task/instructions {:optional true} :seon.task/instructions]]
               :subject [:and {:description "The task whose :seon.task/children holds the held task: the owner of the goal its chain shares."} :seon.task/sym]
               :before [:vector {:description "The steps the held task needs, merged onto main before its branch forked when each shows :merged."} :seon.context/step-before]
               :after [:vector {:description "The steps that need the held task, each with its instructions."} :seon.context/step-after]
               :chain [:map {:description "The chain the held task is a task of: the tasks before it and after it along :seon.task/next, in chain order; absent when nothing links to or from it. Producer: seon.context/chain."}
                       [:seon.context/subject {:optional true} :seon.context/subject]
                       [:seon.context/before {:optional true} :seon.context/before]
                       [:seon.context/after {:optional true} :seon.context/after]]
               :send-backs [:vector {:description "The latest send-back to the held task: the step that sent it back and the reason its attempt recorded (seon.context/send-backs); absent when none was sent."}
                            [:map [:seon.task/sym :seon.task/sym] [:seon.task.attempt/reason :seon.task.attempt/reason]]]
               :attempt [:map {:description "One earlier attempt of the held task, as a rerun reads it: its number, how it ended, root's outcome and reason, the model calls its agent made and its last step. Producer: seon.context/earlier-attempts."}
                         [:seon.task.attempt/number :seon.task.attempt/number]
                         [:seon.task.attempt/end {:optional true} :seon.task.attempt/end]
                         [:seon.task/outcome {:optional true} :seon.task/outcome]
                         [:seon.task/reason {:optional true} :seon.task/reason]
                         [:seon.task/calls :seon.task/calls]
                         [:seon.context/last-step {:optional true} :seon.context/last-step]]
               :last-step [:string {:min 1 :description "The last step an earlier attempt's agent took: its last my.turn/wait note, else the prose it wrote with its last form, else that form's source. Producer: seon.context/last-step."}]
               :attempts [:vector {:description "The held task's attempts by other agents, by number; absent when none. Producer: seon.context/earlier-attempts."} :seon.context/attempt]
               :changes [:and {:description "Every declaration the agent's branch changed since its task's merge base, by family, each name one level with the form that reads it (seon.context/by-family): its earlier attempts' work and its own scratch, each a name to keep or to remove (my.program/ns-unmap!). Absent when nothing changed."} :seon.context/merged]
               :turns
               [:map {:description "Model calls left against the current wake and the held task's status."}
                [:my.agent/turns-left :my.agent/turns-left]
                [:seon.task/status {:optional true} :seon.task/status]
                [:seon.context/namespace {:optional true} :seon.context/namespace]],
               :namespace [:and {:description "The namespace the agent is in: where its latest evaluation ended, else its held task's namespace. Producer: seon.context/current-state."} :seon.ns/name],
               :must-reads [:vector {:description "Each reference the held task's attributes make (its effective intent's and instructions' code spans and links, its needs), resolved once by one rule or as its problem; a reference to one of its proofs is placed with that proof instead. The block shows each as its entity's own render: a function as its doc line and :seon.render.ns/source-lines (its source; at distance 0 only the doc line), with the forms that read its callers and tests."} [:or :seon.ref/resolved :seon.ref/problem]]
               :proof-status [:enum {:description "A proof's status by the basis rule: no result for the program it now reaches is pending."} :green :red :pending]
               :proof-failure [:map {:description "One failing assertion of a red proof. The expected and actual claims are the printer's shown text, stored by the test runner and handed on as printed values."}
                               [:seon.error/type {:optional true} :seon.error/type]
                               [:type {:optional true} :seon.test.failure/type] [:message {:optional true} :string]
                               [:testing {:optional true} :seon.test.failure/testing-contexts]
                               [:file {:optional true} :string] [:line {:optional true} :seon.test.failure/line]
                               [:expected {:optional true} :seon.print/printed] [:actual {:optional true} :seon.print/printed]]
               :proof-failures [:vector {:description "Every failing assertion of a red proof, in a stable order (file, line, report)."} :seon.context/proof-failure]
               :proof [:map {:description "One proof of the held task: its status, its failures when red, and, placed here once, its resolution as a reference (its source)."}
                       [:seon.test/sym :seon.test/sym] [:seon.test/source {:optional true} :seon.test/source]
                       [:seon.context/proof-status :seon.context/proof-status]
                       [:seon.context/proof-failures {:optional true} :seon.context/proof-failures]]
               :proofs [:map {:description "Counts by status, then each proof in symbol order."}
                        [:seon.context/counts [:map-of :seon.context/proof-status [:int {:min 1}]]]
                        [:seon.context/proof-list [:vector :seon.context/proof]]]
               :observed [:map {:description "One test at a step's head: its status at its current reach and, when red, its failing assertions. Producer: seon.context/head-entries."}
                          [:seon.context/proof-status :seon.context/proof-status]
                          [:seon.context/proof-failures {:optional true} :seon.context/proof-failures]]
               :head [:map-of {:description "The tests a step is judged by, as its branch's head holds them."} :seon.test/sym :seon.context/observed]
               :step-observation [:map {:description "What one step is judged by: its obligations, its product (the next task's proofs), its head (for display), the agent's branch as the candidate, main's head and the done rule's input over the branch's own recorded results. Producer: seon.context/step-observation; consumer: seon.context/step-status."}
                                  [:seon.task/step {:optional true} :seon.task/step] [:seon.task/proofs :seon.task/proofs]
                                  [:seon.task/product :seon.task/product]
                                  [:seon.context/head :seon.context/head]
                                  [:seon.context/chained {:optional true :description "True when :seon.task/next links the task into a chain: seon.context/step-status judges it by seon.cluster.source/done-refusals, any other by seon.cluster.source/results-verdict."} :boolean]
                                  [:seon.context/candidate :seon.db/database-value] [:seon.context/main :seon.db/database-value]
                                  [:seon.source/judged {:optional true :description "Absent while the branch has recorded no run to judge."} :seon.source/judged]
                                  [:seon.program/identities {:optional true :description "The declarations the branch changed since the task's merge base (seon.context/change)."} :seon.program/identity-set]]
               :step-status [:map {:description "A step judged by the done rule (seon.cluster.source/done-refusals) for a chain's task, else by its merge's preview (seon.cluster.source/results-verdict): done exactly when it refuses nothing. Producer: seon.context/step-status."}
                             [:seon.task/status [:enum :done :working]]
                             [:seon.source/refusals :seon.source/refusals]]
               :step-verdict [:and {:description "A step's observation with its status. Producer: seon.context/step-verdict."}
                              :seon.context/step-observation :seon.context/step-status]
               :test-entry [:map {:description "One test as a step section shows it: its status and, when red, its failing assertions."}
                            [:seon.test/sym :seon.test/sym] [:seon.context/proof-status :seon.context/proof-status]
                            [:seon.context/proof-failures {:optional true} :seon.context/proof-failures]]
               :start [:map {:description "Where a step begins: the form that enters the held task's namespace and the namespace of each test its instructions cite. Producer: seon.context/step-start."}
                       [:seon.render/operations [:vector :seon.render/read-form]]]
               :step [:map {:description "The held task's step as the done rule judges it (seon.context/step-status): its kind and status, a working step's done refusals, then the tests other than its proofs that keep it from done. Producer: seon.context/step-section."}
                      [:seon.task/step {:optional true} :seon.task/step] [:seon.task/status [:enum :done :working]]
                      [:seon.source/refusals {:optional true :description "A working step's refusals (seon.context/step-status), as data."} :seon.source/refusals]
                      [:seon.context/start {:optional true :description "A step's first forms to run: the (in-ns) of the held task's namespace and of the tests its instructions cite. Producer: seon.context/step-start."} :seon.context/start]
                      [:seon.context/red-tests {:optional true :description "The judged tests not green other than its proofs (shown under proofs), each with its status and, when red, its failing assertions."} [:vector :seon.context/test-entry]]
                      [:seon.context/product-tests {:optional true :description "The proofs of the task after it (its :seon.task/next) that are not its own, each with its status: a Prove task writes them red."} [:vector :seon.context/test-entry]]]
               :unread [:map {:description "The agent's undelivered messages, oldest first, each once with its identity, and the form that reads them again."}
                        [:seon.context/items :my.message/inbox]
                        [:seon.render/operations [:vector :seon.render/read-form]]]
               :task-sections
               [:map {:description "The held task's sections, one projection for the block and my.task/current: the task, its chain, its proofs each with its resolution, its step, the latest send-back and every other reference it makes, resolved. Producer: seon.context/task-sections."}
                [:seon.context/task {:optional true} :seon.context/task]
                [:seon.context/chain {:optional true} :seon.context/chain]
                [:seon.context/proofs {:optional true} :seon.context/proofs]
                [:seon.context/step {:optional true} :seon.context/step]
                [:seon.context/send-backs {:optional true} :seon.context/send-backs]
                [:seon.context/attempts {:optional true} :seon.context/attempts]
                [:seon.context/changes {:optional true} :seon.context/changes]
                [:seon.context/must-reads {:optional true} :seon.context/must-reads]]
               :current-state
               [:map {:description "The current-state block's data, derived at each model call from stored facts and never stored; sections are absent when empty."
                      :seon.render/ai seon.context/current-state-ai}
                [:seon.context/task {:optional true} :seon.context/task]
                [:seon.context/chain {:optional true} :seon.context/chain]
                [:seon.context/proofs {:optional true} :seon.context/proofs]
                [:seon.context/step {:optional true} :seon.context/step]
                [:seon.context/send-backs {:optional true} :seon.context/send-backs]
                [:seon.context/attempts {:optional true} :seon.context/attempts]
                [:seon.context/changes {:optional true} :seon.context/changes]
                [:seon.context/must-reads {:optional true} :seon.context/must-reads]
                [:seon.context/cost {:optional true} :seon.context/cost]
                [:seon.context/unread {:optional true} :seon.context/unread]
                [:seon.context/turns :seon.context/turns]],
               :cost [:vector {:description "The branch's stored function costs whose digest differs from main's beside main's value, most self time spent first, at most :seon.config.test.cost/top. Producer: seon.context/current-state."} :seon.cost/comparison]
               :exchanges :seon.ai/exchanges
               :age [:enum {:description "A history unit's age among the agent's model exchanges: the newest, one of the :seon.config.context/history-whole before it, or older. Producer: seon.context/exchanges."} :newest :recent :older]
               :reply-tokens [:int {:min 0 :description "The estimated tokens of the reply an older history unit shows by reference (seon.ai.tokens/estimate)."}]
               :reference [:map {:description "An older history unit's reply shown by reference: the evaluation's result handle, its reply's size in estimated tokens and the form that reads the value whole. Producer: seon.context/exchange-form."}
                           [:seon.repl/handle :seon.repl/handle]
                           [:seon.context/reply-tokens :seon.context/reply-tokens]
                           [:seon.render/operations :seon.render/operations]]
               :exchange-unit [:map {:description "One evaluation of a model exchange as a model pass shows it: its form, and its reply whole or by reference. Producer: seon.context/exchange-form."}
                               [:seon.ai/form :seon.ai/form]
                               [:seon.ai/reply {:optional true} :seon.ai/reply]
                               [:seon.context/reference {:optional true} :seon.context/reference]]
               :model-context
               [:map {:description "What one model pass sends: (help)'s shown text then the block's attempt sections as the system message, the agent's own model exchanges, then the block's turn sections' shown text."}
                [:seon.ai/system :seon.ai/system]
                [:seon.context/exchanges :seon.context/exchanges]
                [:seon.ai/prompt :seon.ai/prompt]]
               :attempt-view
               [:map {:description "The block's sections that hold for the whole attempt as the AI face shows them, laid before the history so they join the cached prefix. Producer: seon.context/block-views."}
                [:seon.context/task {:optional true}
                 [:map [:seon.task/sym :seon.task/sym] [:seon.task/plan :seon.task/plan]
                  [:seon.task/instructions {:optional true} :seon.task/instructions]]]
                [:seon.context/chain {:optional true} :seon.context/chain]
                [:seon.context/attempts {:optional true} :seon.context/attempts]
                [:seon.context/send-backs {:optional true} :seon.context/send-backs]
                [:seon.context/must-reads {:optional true} [:vector :seon.context/must-read-view]]]
               :current-state-view
               [:map {:description "The block as the AI face shows it: the task without its handle."}
                [:seon.context/task {:optional true}
                 [:map [:seon.task/sym :seon.task/sym] [:seon.task/plan :seon.task/plan]
                  [:seon.task/instructions {:optional true} :seon.task/instructions]]]
                [:seon.context/chain {:optional true} :seon.context/chain]
                [:seon.context/proofs {:optional true} :seon.context/proofs]
                [:seon.context/step {:optional true} :seon.context/step]
                [:seon.context/send-backs {:optional true} :seon.context/send-backs]
                [:seon.context/attempts {:optional true} :seon.context/attempts]
                [:seon.context/changes {:optional true} :seon.context/changes]
                [:seon.context/must-reads {:optional true} [:vector :seon.context/must-read-view]]
                [:seon.context/cost {:optional true} :seon.context/cost]
                [:seon.context/unread {:optional true} :seon.context/unread]
                [:seon.context/turns :seon.context/turns]]
               :must-read-view
               [:or {:description "One must-read as the AI face shows it: a problem as it is, else its entity through the render it declares beside its name and the references its content makes. Producer: seon.context/must-read-ai."}
                :seon.ref/problem
                [:map [:seon.ref/name {:optional true} :seon.ref/name]
                 [:seon.ref/references {:optional true} :seon.ref/references]
                 [:seon.context/rendered {:optional true} :seon.context/rendered]]]
               :rendered [:and {:description "A must-read's declared render output that is not a map, such as AI text."} :seon.schema/value]}
