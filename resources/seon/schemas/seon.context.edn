#:seon.context{:capture-request
               [:or
                [:map
                 [:seon.turn/id :seon.turn/id]
                 [:seon.cluster.prompt/rendered-context
                  :seon.cluster.prompt/rendered-context]
                 ]
                [:map
                 [:seon.turn/id :seon.turn/id]
                 [:seon.db/db :seon.db/database-value]
                 [:seon.error/value :seon.error/value]
                 ]],
               :contribution
               [:map
                [:seon.render.block/name :seon.render.block/name]
                [:seon.context.contribution/position
                 :seon.context.contribution/position]
                [:seon.context.contribution/text [:string {:min 1}]]
                [:seon.context.contribution/hash
                 :seon.context.contribution/hash]
                [:seon.context.contribution/tokens
                 :seon.context.contribution/tokens]
                [:seon.context.contribution/evaluations
                 {:optional true}
                 :seon.context.contribution/evaluations]
                [:seon.error/value
                 {:optional true}
                 :seon.error/value]],
               :contributions [:vector :seon.context/contribution],
               :selection [:vector :seon.context.contribution/contribution],
               :append-request
               [:map
                [:seon.agent/id :seon.agent/id]
                [:seon.turn/id :seon.turn/id]
                [:seon.context.contribution/id :seon.context.contribution/id]],
               :compact-request
               [:map
                [:seon.agent/id :seon.agent/id]
                [:seon.turn/id :seon.turn/id]
                [:seon.context.contribution/id :seon.context.contribution/id]
                [:seon.context.contribution/evaluations
                 :seon.context.contribution/evaluations]],
               :remove-request
               [:map
                [:seon.agent/id :seon.agent/id]
                [:seon.context.contribution/id :seon.context.contribution/id]],
               :comparison-request
               [:map
                [:seon.agent/id :seon.agent/id]
                [:seon.turn/id :seon.turn/id]
                [:seon.turn.loop/evaluated-sources {:optional true}
                 :seon.turn.loop/evaluated-sources]
                [:seon.context.contribution/id :seon.context.contribution/id]],
               :comparison
               [:or
                [:map
                 [:seon.context.comparison/status [:= :pending]]]
                [:map
                 [:seon.context.comparison/status [:= :different-source]]]
                [:map
                 [:seon.context.comparison/status [:= :ready]]
                 [:seon.context.comparison/baseline-evaluations [:vector :seon.db/ref]]
                 [:seon.turn.loop/evaluated-sources :seon.turn.loop/evaluated-sources]]
                [:map
                 [:seon.context.comparison/status [:= :ready]]
                 [:seon.context.comparison/baseline-evaluations
                  [:vector :seon.db/ref]]
                 [:seon.context.comparison/refreshed-evaluations
                  [:vector :seon.db/ref]]]],
               :selection-refused
               [:enum :seon.context/no-such-agent :seon.context/no-such-run
                :seon.context/foreign-run :seon.context/run-open
                :seon.context/no-evaluations :seon.context/unfinished-evaluation
                :seon.context/contribution-conflict
                :seon.context/no-such-contribution
                :seon.context/foreign-contribution
                :seon.context/stale-contribution
                :seon.context/contribution-run-ambiguous],
               :selection-agent-id :seon.agent/id
               :task
               [:map {:description "The task an agent holds as its current declaration reads at the task home."}
                [:seon.task/id :seon.task/id]
                [:seon.task/sym :seon.task/sym]
                [:seon.task/intent :seon.task/intent]
                [:seon.task/must-read {:optional true} :seon.task/must-read]],
               :turns
               [:map {:description "Model calls left against the current wake and the held task's status."}
                [:my.agent/turns-left :my.agent/turns-left]
                [:seon.task/status {:optional true} :seon.task/status]],
               :must-reads [:vector {:description "Each reference the held task makes, resolved or as its problem."} [:or :seon.ref/resolved :seon.ref/problem]]
               :proof-status [:enum {:description "A proof's status by the basis rule: no result for the program it now reaches is pending."} :green :red :pending]
               :proof-failure [:map {:description "One failing assertion of a red proof. The expected and actual claims are the printer's shown text, stored by the test runner as text."}
                               [:type {:optional true} :seon.test.failure/type] [:message {:optional true} :string]
                               [:testing {:optional true} :seon.test.failure/testing-contexts]
                               [:file {:optional true} :string] [:line {:optional true} :seon.test.failure/line]
                               [:expected-text {:optional true} :string] [:actual-text {:optional true} :string]]
               :proof-failures [:vector {:description "Every failing assertion of a red proof, in a stable order (file, line, report)."} :seon.context/proof-failure]
               :proof [:map [:seon.test/sym :seon.test/sym] [:seon.test/source :seon.test/source]
                       [:seon.context/proof-status :seon.context/proof-status]
                       [:seon.context/proof-failures {:optional true} :seon.context/proof-failures]]
               :proofs [:map {:description "Counts by status, then each proof in symbol order."}
                        [:seon.context/counts [:map-of :seon.context/proof-status [:int {:min 1}]]]
                        [:seon.context/proof-list [:vector :seon.context/proof]]]
               :current-state
               [:map {:description "The current-state block's data, derived at each model call from stored facts and never stored; sections are absent when empty."
                      :seon.render/ai seon.context/current-state-ai}
                [:seon.context/task {:optional true} :seon.context/task]
                [:seon.context/proofs {:optional true} :seon.context/proofs]
                [:seon.context/must-reads {:optional true} :seon.context/must-reads]
                [:seon.context/turns :seon.context/turns]],
               :current-state-view
               [:map {:description "The block as the AI face shows it: the task without its handle."}
                [:seon.context/task {:optional true}
                 [:map [:seon.task/sym :seon.task/sym] [:seon.task/intent :seon.task/intent]
                  [:seon.task/must-read {:optional true} :seon.task/must-read]]]
                [:seon.context/proofs {:optional true} :seon.context/proofs]
                [:seon.context/must-reads {:optional true} :seon.context/must-reads]
                [:seon.context/turns :seon.context/turns]],
               :selection-refused-error
               [:and :seon.error/base
                [:map
                 [:seon.context/selection-agent-id :seon.context/selection-agent-id]
                 [:seon.context/selection-refused :seon.context/selection-refused]]]}
