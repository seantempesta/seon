#:seon.cluster{:cluster
               [:map
                {:seon.db/attributes true
                 :seon.render/ai seon.cluster/render-ai
                 :seon.render/html seon.cluster/render-html
                 :seon.render/form seon.cluster/render-form :seon.program/partition :seon.data}
                [:seon.cluster/name :seon.cluster/name]
                [:seon.cluster/config :seon.cluster/config]
                [:seon.cluster/instructions {:optional true} :seon.cluster/instructions]
                [:seon.cluster/toolkit {:optional true} :seon.cluster/toolkit]],
               :config :seon.db/ref,
               :created? :boolean,
               :instructions [:set :seon.db/ref],
               :name [:string {:min 1, :seon.db/identity true :seon.program/row-schema :seon.cluster/cluster}],
               :toolkit [:set :seon.db/ref],
               :toolkit-namespaces [:vector :seon.ns/name]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.cluster/view
 [:map {:description "A cluster as its AI face shows it: its name and configuration, and how many shared instructions and toolkit namespaces it holds."}
  [:seon.cluster/name :seon.cluster/name]
  [:seon.config/cluster {:optional true} :seon.config/cluster]
  [:seon.cluster/instruction-count [:int {:min 0}]]
  [:seon.cluster/toolkit-count [:int {:min 0}]]]
 :seon.cluster/servable
 [:map {:description "What seon.cluster/serve! reads of an instance: its cluster name and root, the branch connection it records the web process on, and the view its web service taps (seon.render.web/start! validates the service built from it)."}
  [:seon.boot/advertisement [:map [:seon.boot/cluster-name :seon.boot/cluster-name]]]
  [:seon.boot/config [:map [:seon.boot/root :seon.boot/root]]]
  [:seon.boot/cluster-connection :seon.store/connection-object]
  [:seon.render.web/view :map]]
 :seon.cluster/served
 [:and {:description "An instance serve! has bound: its web descriptor published beside its advertisement."}
  :seon.cluster/servable
  [:map [:seon.render.web/served :seon.render.web/server]]]
 :seon.cluster/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.cluster/error-cluster-name :seon.cluster/error-cluster-name]
  [:seon.cluster/graph-operation :seon.cluster/graph-operation]]]

 :seon.cluster/error-cluster-name
 [:string {:min 1}]

 :seon.cluster/failure
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.failure/entity}
 :seon.db/ref]

 :seon.cluster/source-observer-closed :string

 :seon.cluster/source-observer-closed-error
 [:and :seon.error/base
  [:map {:seon.db/attributes true}
   [:seon.cluster/source-observer-closed :seon.cluster/source-observer-closed]]]

 :seon.cluster/graph-operation
 [:qualified-symbol {:seon.db/index true}]
}
