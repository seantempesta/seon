#:seon.cluster{:program-change-lock
               [:fn {:error/message "must be the read-write lock excluding test members from adoption"}
                seon.cluster/program-change-lock?]
               :program-validity
               [:fn {:error/message "must be the atom holding a program exclusion's validity"
                     :gen/gen seon.flow/atom-reference-generator}
                seon.cluster/program-validity?]
               :cluster
               [:map
                {:seon.db/attributes true
                 :seon.render/ai seon.cluster/render-ai
                 :seon.render/html seon.cluster/render-html :seon.program/partition :seon.data}
                [:seon.cluster/name :seon.cluster/name]
                [:seon.cluster/config :seon.cluster/config]
                [:seon.cluster/instructions {:optional true} :seon.cluster/instructions]
                [:seon.cluster/toolkit {:optional true} :seon.cluster/toolkit]],
               :config :seon.db/ref,
               :created? :boolean,
               :instructions [:set :seon.db/ref],
               :name [:string {:min 1, :seon.db/identity true}],
               :toolkit [:set :seon.db/ref],
               :toolkit-namespaces [:vector :seon.ns/name]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.cluster/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.cluster/error-cluster-name :seon.cluster/error-cluster-name]
  [:seon.cluster/graph-operation :seon.cluster/graph-operation]]]

 :seon.cluster/error-cluster-name
 [:string {:min 1}]

 :seon.cluster/failure
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.failure/entity}
 :seon.db/ref]

 :seon.cluster/source-observer-closed :string

 :seon.cluster/source-observer-closed-error
 [:and :seon.error/base
  [:map {:seon.db/attributes true}
   [:seon.cluster/source-observer-closed :seon.cluster/source-observer-closed]]]

 :seon.cluster/graph-operation
 [:qualified-symbol {:seon.db/index true}]
}
