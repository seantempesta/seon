#:seon.render.transcript{:history-request
                         [:map
                          {:description
                           "The named request for one agent's own evaluation history. Call preparation supplies both members, so the agent's ordinary call is (seon.render.transcript/agent-history {})."}
                          [:seon.db/db :seon.db/database-value]
                          [:seon.agent/id :seon.agent/id]],
                         :entries
                         [:vector
                          {:description
                           "The REPL entries of one run, as seon.render.transcript/history-entries derives them: form, printed value, and the exact bytes the run loop printed."}
                          :map],
                         :pulled-transaction
                         [:map
                          {:description
                           "A turn's opening or closing transaction as the history selector pulls it: the transaction entity, not the bare ref, because the heading states the instant it carries."}
                          [:db/id :int]
                          [:db/txInstant {:optional true} :inst]],
                         :run
                         [:map
                          {:description
                           "One run of an agent's history: the run's own facts plus the entries evaluated inside it."}
                          [:seon.turn/id :seon.turn/id]
                          [:seon.render.transcript/entries
                           :seon.render.transcript/entries]
                          [:seon.turn/opened-tx
                           {:optional true}
                           :seon.render.transcript/pulled-transaction]
                          [:seon.turn/closed-tx
                           {:optional true}
                           :seon.render.transcript/pulled-transaction]],
                         :runs
                         [:vector
                          {:description
                           "The bounded newest-first runs of one agent's history."}
                          :seon.render.transcript/run],
                         :history
                         [:map
                          {:description
                           "One agent's own submitted forms and their stored results, newest run first, bounded by the render profile's child count with an ordinary elision value for the rest."}
                          [:seon.agent/id :seon.agent/id]
                          [:seon.render.transcript/runs
                           :seon.render.transcript/runs]
                          [:seon.render.transcript/older-runs
                           {:optional true}
                           :seon.print/elision]]
 :selection-identities :map
 :refused-member :qualified-keyword

 :request-error [:and :seon.error/base [:map {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} [:seon.render.transcript/refused-member :seon.render.transcript/refused-member] [:seon.render.transcript/selection-identities {:optional true} :seon.render.transcript/selection-identities]]]

 :error-result [:or :seon.render.transcript/request-error :seon.db/error-result]
}
