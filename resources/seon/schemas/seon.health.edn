;; The health report (src/seon/health.clj): one value, never stored. Producer:
;; seon.health/report. Consumers: its AI face (MCP runtime_status, bin/seon
;; status) and its HTML face (the /health page).
;;
;; A FINDING IS THE NAMED SCHEMA ITS VALUE SATISFIES (health plan §2b). Any
;; registered schema declaring :seon.health/severity is a finding schema: its
;; matches are the values that validate against it, taken from the report
;; path its :seon.health/in names (process-local values) or, without one, from
;; the stored entities carrying its required attributes. Nothing stamps a kind.
#:seon.health
{:severity [:int {:min 1 :description "A finding schema's declared weight in the ranking: a property of the named schema, never of an entity."}]
 :impact [:qualified-keyword {:description "A finding schema property: the member of a match that counts how much of the system it affects (occurrences, calls, bytes)."}]
 :at [:qualified-keyword {:description "A finding schema property: the member of a match holding when it last happened; recency halves its score every half-life."}]
 :subject [:qualified-keyword {:description "A finding schema property: the member of a match naming what is wrong (a function, test, cache kind, proc); tasks join on it."}]
 :in [:vector {:min 1 :description "A finding schema property: the path in the report whose values are its candidates; absent, the candidates are the stored entities carrying its required attributes."} :qualified-keyword]
 :clues [:vector {:description "A finding schema property: the paths into a match that its AI face shows; the match stays whole in the report."} [:vector :qualified-keyword]]
 :inclusive [:boolean {:description "A finding schema property: its measure includes its callees', so a match that statically calls another match of the same schema is explained by it and folds into it."}]

 :cluster :seon.boot/cluster-name
 :observed-at :inst
 :basis [:map {:description "The database value the report read: its basis transaction and committed value identity."}
         [:seon.db/basis-t :int]
         [:datahike/commit-id {:optional true} :uuid]]
 :state [:enum {:description "Faulted when a finding reaches the ranking's faulted severity; unknown while any unit could not be read or is pending; degraded with any other finding; observed only when every unit was read and nothing matched."}
         :observed :degraded :unknown :faulted]
 :pending [:map {:description "A unit whose derivation is still running: it was started and never cancelled; its completion wakes the page. Never green."}
           [:seon.health/unit :qualified-keyword]
           [:seon.health/since :inst]
           [:seon.health/requery :seon.render/read-form]]
 :unit :qualified-keyword
 :since :inst
 :requery :seon.render/read-form
 :score [:int {:min 0 :description "severity × (1 + log2(1 + impact)) × 2^(−age/half-life), times ten, rounded."}]
 :tasks [:set :seon.task/handle]
 :schema [:qualified-keyword {:description "The named finding schema this match satisfies."}]
 :value [:map {:description "The matching value, whole."}]
 :finding [:map {:description "One match of a named finding schema, ranked."}
           [:seon.health/schema :seon.health/schema]
           [:seon.health/subject {:optional true} :any]
           [:seon.health/score :seon.health/score]
           [:seon.health/value :seon.health/value]
           [:seon.health/callers {:optional true} [:set :qualified-symbol]]
           [:seon.health/tasks {:optional true} :seon.health/tasks]]
 :callers [:set {:description "Matching subjects of the same schema that statically call this one: its cost or failure explains theirs, so they fold into it."} :qualified-symbol]
 :findings [:vector :seon.health/finding]

 :readiness :seon.boot/readiness
 :problems [:or :seon.problems/problems :seon.health/pending :seon.error/value]
 :fleet [:or :seon.oversight/fleet :seon.oversight/unavailable :seon.error/value]
 :status [:or :seon.cluster.status/value :seon.error/value]
 :cache :seon.cache/status
 :tested? [:boolean {:description "Whether any test reaches a function (seon.fn/functions-without-tests)."}]
 :refused [:or [:vector {:description "A refusal for each stored finding schema that constrains only identity attributes; its matches are never derived."} :seon.error/value] :seon.error/value]
 :profile [:or [:vector {:description "The observations of every armed definition with at least one second of inclusive time (the over-bound candidates), each saying whether a test reaches it; a definition that throws often in under a second of total time is not among them."} :seon.profile/observation] :seon.error/value]
 :maintenance [:or :seon.maintenance/report :seon.error/value]
 :replaced-roots [:vector {:description "Loaded first-party Vars whose root is not their namespace's own compile: a redefinition outside a reload, each as seon.instrument/replaced-roots reports it."} :seon.instrument/replaced-root]
 :program :seon.error/value

 :report
 [:map {:description "Everything wrong with one cluster now, ranked, with each owner's value whole."
        :seon.render/ai seon.health/render-ai
        :seon.render/html seon.health/render-html}
  [:seon.health/cluster :seon.health/cluster]
  [:seon.health/observed-at :seon.health/observed-at]
  [:seon.health/basis :seon.health/basis]
  [:seon.health/state :seon.health/state]
  [:seon.health/findings :seon.health/findings]
  [:seon.health/refused {:optional true} :seon.health/refused]
  [:seon.health/readiness {:optional true} :seon.health/readiness]
  [:seon.health/problems :seon.health/problems]
  [:seon.health/fleet {:optional true} :seon.health/fleet]
  [:seon.health/status :seon.health/status]
  [:seon.health/cache :seon.health/cache]
  [:seon.health/profile :seon.health/profile]
  [:seon.health/maintenance :seon.health/maintenance]
  [:seon.health/replaced-roots :seon.health/replaced-roots]
  [:seon.health/regressions :seon.health/regressions]
  [:seon.health/program {:optional true :description "Present when the loaded program is unknown: its last adoption failed."} :seon.health/program]]

 :request [:map {:description "What one report reads. The deadline bounds how long a unit's derivation is awaited before it shows as pending; the wake is offered when a pending derivation completes."}
           [:seon.boot/cluster-name :seon.boot/cluster-name]
           [:seon.db/db {:optional true} :seon.db/database-value]
           [:seon.health/deadline-ms {:optional true} [:int {:min 0}]]
           [:seon.health/wake {:optional true} [:fn {:error/message "must be a function of no arguments"} clojure.core/ifn?]]]
 :deadline-ms [:int {:min 0}]
 :wake [:fn clojure.core/ifn?]
 :missing-cluster-error [:and :seon.error/base [:map [:seon.health/cluster :seon.health/cluster]]]

 :view [:map {:description "The AI face: state, basis, each unit's counts, the top findings with their clues and tasks, and the reads that dig further."}
        [:seon.health/cluster :seon.health/cluster]
        [:seon.health/state :seon.health/state]]

 ;; Warnings over process-local observations. They move to their producers'
 ;; stored subjects when the recording lane stores judgments (plan §2).
 :over-bound-warning
 [:map {:seon.health/severity 6 :seon.health/impact :seon.profile/calls :seon.health/subject :seon.profile/sym
        :seon.health/in [:seon.health/profile] :seon.health/inclusive true
        :seon.health/clues [[:seon.profile/calls] [:seon.profile/mean-us] [:seon.profile/max-ms] [:seon.health/tested?]]
        :description "An armed definition (a profile observation) whose mean call exceeds one second: an ordinary operation over the bound (AGENTS.md). Inclusive: a slow callee is also its callers' time."}
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/mean-us [:int {:min 1000000}]]]
 :throwing-warning
 [:map {:seon.health/severity 2 :seon.health/impact :seon.profile/throws :seon.health/subject :seon.profile/sym
        :seon.health/in [:seon.health/profile] :seon.health/inclusive true
        :seon.health/clues [[:seon.profile/calls] [:seon.profile/throws]]
        :description "An armed definition (a profile observation) that threw at least a thousand times: throws used as control flow."}
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/throws [:int {:min 1000}]]]
 :untested-hot-warning
 [:map {:seon.health/severity 3 :seon.health/impact :seon.profile/calls :seon.health/subject :seon.profile/sym
        :seon.health/in [:seon.health/profile] :seon.health/inclusive true
        :seon.health/clues [[:seon.profile/calls] [:seon.profile/total-ms]]
        :description "An armed definition (a profile observation) called at least ten thousand times that no test reaches: hot in production, proven by nothing."}
  [:seon.profile/sym :seon.profile/sym]
  [:seon.profile/calls [:int {:min 10000}]]
  [:seon.health/tested? [:= false]]]
 :missing-layers-warning
 [:map {:seon.health/severity 9 :seon.health/in [:seon.health/readiness] :seon.health/clues [[:seon.boot/missing-layers]]
        :description "Boot (its readiness) has not acquired every layer."}
  [:seon.boot/missing-layers [:vector {:min 1} :qualified-keyword]]]
 ;; What regressed (health plan §3): each stored measure's newest value beside
 ;; its value before the change that moved it, derived from stored data by
 ;; seon.health/regressions, never stored. A regression is the named schema a
 ;; comparison satisfies, so it disappears when the numbers recover. Boot
 ;; phases: the newest boot's process record against the newest boot of the
 ;; previous distinct program (published source commit). Definitions: a
 ;; symbol's newest measured digest against its previous one.
 :regressions [:or [:vector {:description "Every comparison of a stored measure's newest value with its value before the change: boot phases per program, definition buckets per digest."}
                    [:or :seon.health/boot-comparison :seon.health/definition-comparison]]
               :seon.error/value]
 :phase [:qualified-keyword {:description "A boot layer (seon.cluster.boot/boot-layers) whose own cost is compared: its milliseconds since the layer before it; :seon.boot/layers is the whole stored timeline."}]
 :before-ms [:int {:min 0}]
 :after-ms [:int {:min 0}]
 :increase-ms [:int {:description "After minus before, in milliseconds; negative when it got faster."}]
 :increase-percent [:int {:description "The increase as a percentage of before, rounded down; 100 per doubling. A before of zero counts as one millisecond."}]
 :before-program [:uuid {:description "The published source commit (:seon.source/commit-id) the earlier boot ran."}]
 :after-program [:uuid {:description "The published source commit the newest boot ran: where the change is."}]
 :before-process :seon.db.process/id
 :after-process :seon.db.process/id
 :changed-at [:and {:description "When the newer value was observed: the newest boot's start, or its measurement's time."} :inst]
 :boot-comparison
 [:map {:description "One boot phase of the newest boot beside the same phase of the newest boot of the previous program."}
  [:seon.health/phase :seon.health/phase]
  [:seon.health/before-ms :seon.health/before-ms]
  [:seon.health/after-ms :seon.health/after-ms]
  [:seon.health/increase-ms :seon.health/increase-ms]
  [:seon.health/increase-percent :seon.health/increase-percent]
  [:seon.health/before-program :seon.health/before-program]
  [:seon.health/after-program :seon.health/after-program]
  [:seon.health/before-process :seon.health/before-process]
  [:seon.health/after-process :seon.health/after-process]
  [:seon.health/changed-at :seon.health/changed-at]]
 :quantile [:enum {:description "The measured quantile compared."} :seon.profile.measurement/p50 :seon.profile.measurement/p99]
 :before-bucket [:int {:min 0 :max 39}]
 :after-bucket [:int {:min 0 :max 39}]
 :buckets-up [:int {:description "After bucket minus before bucket: each one is a doubling (at least 1.41x past the measurement's hysteresis)."}]
 :before-calls [:int {:min 0 :description "Calls behind the previous digest's newest measurement."}]
 :before-digest :seon.program/definition-digest
 :after-digest :seon.program/definition-digest
 :before-us [:int {:min 0 :description "The before bucket's upper edge, 2^b ns, in microseconds."}]
 :after-us [:int {:min 0 :description "The after bucket's upper edge, 2^b ns, in microseconds."}]
 :definition-comparison
 [:map {:description "One quantile of a definition's newest measured digest beside its previous digest's."}
  [:seon.profile.measurement/sym :seon.profile.measurement/sym]
  [:seon.health/quantile :seon.health/quantile]
  [:seon.health/before-bucket :seon.health/before-bucket]
  [:seon.health/after-bucket :seon.health/after-bucket]
  [:seon.health/buckets-up :seon.health/buckets-up]
  [:seon.health/before-us :seon.health/before-us]
  [:seon.health/after-us :seon.health/after-us]
  [:seon.health/before-calls :seon.health/before-calls]
  [:seon.health/before-digest :seon.health/before-digest]
  [:seon.health/after-digest :seon.health/after-digest]
  [:seon.profile.measurement/calls :seon.profile.measurement/calls]
  [:seon.health/changed-at :seon.health/changed-at]]
 :boot-regression
 [:map {:seon.health/severity 5 :seon.health/in [:seon.health/regressions] :seon.health/subject :seon.health/phase
        :seon.health/impact :seon.health/increase-ms :seon.health/at :seon.health/changed-at
        :seon.health/clues [[:seon.health/before-ms] [:seon.health/after-ms] [:seon.health/increase-percent]
                            [:seon.health/before-program] [:seon.health/after-program]]
        :description "A boot phase over 20% and 50 ms slower than on the previous program (AGENTS.md hot-path rule): the after program is where it changed."}
  [:seon.health/phase :seon.health/phase]
  [:seon.health/increase-ms [:int {:min 51}]]
  [:seon.health/increase-percent [:int {:min 21}]]]
 :definition-regression
 [:map {:seon.health/severity 4 :seon.health/in [:seon.health/regressions] :seon.health/subject :seon.profile.measurement/sym
        :seon.health/impact :seon.profile.measurement/calls :seon.health/at :seon.health/changed-at
        :seon.health/clues [[:seon.health/quantile] [:seon.health/before-us] [:seon.health/after-us]
                            [:seon.health/before-digest] [:seon.health/after-digest]]
        :description "A definition whose median measures at least one bucket (a doubling) slower under its newest digest than under its previous one, each measured over at least 200 calls: the after digest is the change. A p99 move alone never counts (rare heavy calls dominate the tail; transact! p99 0.54 s -> 1.07 s was 68 vs 795 calls with a flat p50)."}
  [:seon.profile.measurement/sym :seon.profile.measurement/sym]
  [:seon.health/quantile [:= :seon.profile.measurement/p50]]
  [:seon.health/before-calls [:int {:min 200}]]
  [:seon.profile.measurement/calls [:int {:min 200}]]
  [:seon.health/buckets-up [:int {:min 1}]]]
 :program-unknown
 [:map {:seon.health/severity 10 :seon.health/subject :seon.error/operation
        :seon.health/in [:seon.health/program] :seon.health/clues [[:seon.error/message]]
        :description "The loaded program is unknown: an adoption failed, so what the JVM runs is not what the store holds."}
  [:seon.error/at :seon.error/at]
  [:seon.error/operation :seon.error/operation]]}
