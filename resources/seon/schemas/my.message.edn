{:my.message/read-request [:map [:my.message/id :my.message/id] [:seon.db/db :seon.db/database-value]]
 :my.message/about [:string {:min 1}],
 :my.message/assignment :seon.cluster.eval/id,
 :my.message/content [:string {:min 1}],
 :my.message/from :seon.agent/id,
 :my.message/at :inst,
 :my.message/id :seon.message/id,
 :my.message/inbox-entry
             [:map
              [:my.message/id :my.message/id]
              [:my.message/from {:optional true} :my.message/from]
              [:my.message/at :my.message/at]
              [:my.message/content :my.message/content]],
 :my.message/inbox [:vector :my.message/inbox-entry],
 :my.message/inbox-request
             [:map
              [:seon.db/db :seon.db/database-value]
              [:seon.agent/id :seon.agent/id]
              [:seon.db/since {:optional true} :seon.db/basis-t]],
 :my.message/inbox-options
             [:map
              [:seon.db/since :seon.db/basis-t]],
 :my.message/declination
             [:map
              [:my.message/to :my.message/to]
              [:my.message/assignment :my.message/assignment]
              [:my.message/reason :my.message/reason]],
 :my.message/message
             [:map
              [:my.message/to :my.message/to]
              [:my.message/content :my.message/content]
              [:my.message/about {:optional true} :my.message/about]
              [:my.message/assignment {:optional true} :my.message/assignment]],
 :my.message/send-request
             [:map
              [:my.message/to :my.message/to]
              [:my.message/content :my.message/content]
              [:my.message/about {:optional true} :my.message/about]
              [:my.message/assignment {:optional true} :my.message/assignment]
              [:seon.db/connection :seon.db/connection]
              [:seon.agent/id :seon.agent/id]
              [:seon.agent/context-source {:optional true :description "The running cluster's handle with its store: a recipient admitted on a listed branch no host runs (every agent after a restart) is hosted through it, then written to."} :seon.agent/context-source]],
 :my.message/reason [:string {:min 1}],
 :my.message/to :seon.agent/id,
 :my.message/value
             [:or
              :my.message/message
              :my.message/declination
              [:vector
               {:min 1}
               [:or :my.message/message :my.message/declination]]],
 :my.message/no-recipient [:= true]
 :my.message/no-recipient-error [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a message request with no recipient"} [:my.message/no-recipient :my.message/no-recipient] [:seon.error/message :seon.error/message]]
 :my.message/no-content [:= true]
 :my.message/no-content-error [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a message request with no content"} [:my.message/no-content :my.message/no-content] [:seon.error/message :seon.error/message]]
 :my.message/no-about [:= true]
 :my.message/no-about-error [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a message with an invalid subject token"} [:my.message/no-about :my.message/no-about] [:seon.error/message :seon.error/message]]
 :my.message/no-assignment [:= true]
 :my.message/no-reason [:= true]
 :my.message/not-found :seon.message/id
 ; Additive error declaration manifest, 2026-09-18.

 :my.message/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:my.message/error-request :my.message/error-request]]]

 :my.message/error-request
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]
}
