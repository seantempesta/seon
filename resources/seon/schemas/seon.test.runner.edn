#:seon.test.runner{:error-count [:int {:min 0}],
                   :fail-count [:int {:min 0}],
                   :namespaces [:vector :symbol],
                   :pass-count [:int {:min 0}],
                   :record-request
                   [:map
                    [:seon.test.runner/run-result
                     :seon.test.runner/run-result]
                    [:seon.boot/cluster-name :seon.boot/cluster-name]
                    [:seon.boot/root :seon.boot/root]],
                   :record-tx [:vector :map],
                   :recorded
                   [:map
                    [:seon.boot/cluster-name :seon.boot/cluster-name]
                    [:seon.test.run/id :seon.test.run/id]
                    [:seon.test.runner/recorded-count
                     [:int {:min 0}]]],
                   :result
                   [:map
                    [:seon.test/sym :seon.test/sym]
                    [:seon.ns/name :seon.ns/name]
                    [:seon.test.result/outcome
                     :seon.test.result/outcome]
                    [:seon.test.failure/message
                     {:optional true}
                     :seon.test.failure/message]],
                   :results [:vector :seon.test.runner/result],
                   :run-request
                   [:map
                    [:seon.test.runner/namespaces
                     :seon.test.runner/namespaces]
                    [:seon.test.run/id :seon.test.run/id]
                    [:seon.test.run/at :seon.test.run/at]
                    [:seon.test.run/git-sha :seon.test.run/git-sha]],
                   :run-result
                   [:map
                    [:seon.test.run/id :seon.test.run/id]
                    [:seon.test.run/at :seon.test.run/at]
                    [:seon.test.run/git-sha :seon.test.run/git-sha]
                    [:seon.test.runner/summary
                     :seon.test.runner/summary]
                    [:seon.test.runner/results
                     :seon.test.runner/results]],
                   :summary
                   [:map
                    [:seon.test.runner/test-count
                     :seon.test.runner/test-count]
                    [:seon.test.runner/pass-count
                     :seon.test.runner/pass-count]
                    [:seon.test.runner/fail-count
                     :seon.test.runner/fail-count]
                    [:seon.test.runner/error-count
                     :seon.test.runner/error-count]],
                   :test-count [:int {:min 0}],
                   :silence-seconds [:int {:min 0}],
                   :long-reason :string,
                   :selection-mode :keyword,
                   :invalid-silence-seconds :seon.test.runner/silence-seconds
                   :invalid-silence-seconds-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the invalid test-runner silence bound"} [:seon.test.runner/invalid-silence-seconds :seon.test.runner/invalid-silence-seconds] [:seon.error/message :seon.error/message]]
                   :invalid-long-reason :seon.test.runner/long-reason
                   :invalid-long-reason-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the invalid long-test reason"} [:seon.test.runner/invalid-long-reason :seon.test.runner/invalid-long-reason] [:seon.error/message :seon.error/message]]
                   :long-test-ns-hook :seon.ns/name
                   :long-test-ns-hook-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the namespace whose long-test hook failed"} [:seon.test.runner/long-test-ns-hook :seon.test.runner/long-test-ns-hook] [:seon.error/message :seon.error/message]]
                   :default-cluster-refused :seon.cluster/name
                   :default-cluster-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the default cluster refused by the test runner"} [:seon.test.runner/default-cluster-refused :seon.test.runner/default-cluster-refused] [:seon.error/message :seon.error/message]]
                   :invalid-selection-mode :seon.test.runner/selection-mode
                   :invalid-selection-mode-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the invalid test selection mode"} [:seon.test.runner/invalid-selection-mode :seon.test.runner/invalid-selection-mode] [:seon.error/message :seon.error/message]]}
