#:seon.test.runner{:error-count [:int {:min 0}],
                   :fail-count [:int {:min 0}],
                   :namespaces [:vector :symbol],
                   :pass-count [:int {:min 0}],
                   :captured-result
                   [:map
                    [:seon.test.failure/reports {:optional true} :seon.test.failure/reports]
                    [:seon.test/sym :seon.test/sym]
                    [:seon.test/pass-count :seon.test/pass-count]
                    [:seon.test/fail-count :seon.test/fail-count]
                    [:seon.test/error-count :seon.test/error-count]
                    [:seon.test/failing-assertions
                     {:optional true}
                     :seon.test/failing-assertions]
                    [:seon.test/failure-message
                     {:optional true}
                     :seon.test/failure-message]],
                   :captured-results
                   [:vector :seon.test.runner/captured-result],
                   :completion
                   [:map
                    [:seon.test.runner/results
                     :seon.test.runner/captured-results]
                    [:seon.test/run-basis-t :seon.test/run-basis-t]
                    [:seon.test/run-at :seon.test/run-at]],
                   :record-request
                   [:map
                    [:seon.test.runner/run-result
                     :seon.test.runner/run-result]
                    [:seon.boot/cluster-name :seon.boot/cluster-name]
                    [:seon.boot/root :seon.boot/root]],
                   :record-tx :seon.store/transaction-data,
                   :run-request
                   [:map
                    [:seon.test.runner/namespaces
                     :seon.test.runner/namespaces]
                    [:seon.test.run/id :seon.test.run/id]
                    [:seon.test.run/at :seon.test.run/at]
                    [:seon.test.run/git-sha :seon.test.run/git-sha]],
                   :run-result
                   [:map
                    [:seon.test.run/id :seon.test.run/id]
                    [:seon.test.run/at :seon.test.run/at]
                    [:seon.test.run/git-sha :seon.test.run/git-sha]
                    [:seon.test.runner/summary
                     :seon.test.runner/summary]
                    [:seon.test.runner/results
                     :seon.test.runner/captured-results]],
                   :summary
                   [:map
                    [:seon.test.runner/test-count
                     :seon.test.runner/test-count]
                    [:seon.test.runner/pass-count
                     :seon.test.runner/pass-count]
                    [:seon.test.runner/fail-count
                     :seon.test.runner/fail-count]
                    [:seon.test.runner/error-count
                     :seon.test.runner/error-count]],
                   :unchanged-count [:int {:min 0}],
                   :test-count [:int {:min 0}],
                   :silence-seconds [:int {:min 0}],
                   :long-reason :string,
                   :selection-mode :keyword,
                   :invalid-silence-seconds :seon.test.runner/silence-seconds
                   :invalid-silence-seconds-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the invalid test-runner silence bound"} [:seon.test.runner/invalid-silence-seconds :seon.test.runner/invalid-silence-seconds] [:seon.error/message :seon.error/message]]
                   :invalid-long-reason :seon.test.runner/long-reason
                   :invalid-long-reason-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the invalid long-test reason"} [:seon.test.runner/invalid-long-reason :seon.test.runner/invalid-long-reason] [:seon.error/message :seon.error/message]]
                   :long-test-ns-hook :seon.ns/name
                   :long-test-ns-hook-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the namespace whose long-test hook failed"} [:seon.test.runner/long-test-ns-hook :seon.test.runner/long-test-ns-hook] [:seon.error/message :seon.error/message]]
                   :default-cluster-refused :seon.cluster/name
                   :default-cluster-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the default cluster refused by the test runner"} [:seon.test.runner/default-cluster-refused :seon.test.runner/default-cluster-refused] [:seon.error/message :seon.error/message]]
                   :invalid-selection-mode :seon.test.runner/selection-mode
                   :invalid-selection-mode-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the invalid test selection mode"} [:seon.test.runner/invalid-selection-mode :seon.test.runner/invalid-selection-mode] [:seon.error/message :seon.error/message]]
 :marker-key [:qualified-keyword {:description "The test metadata key whose observed value was invalid."}]
 :worker-id [:string {:min 1 :description "The worker identity observed by the runner; a value that survives worker exit."}]
 :process-tree-exit-bound-ms [:int {:min 1 :description "The process-tree exit bound that fired, in milliseconds."}]
 :process-tree-phase [:keyword {:description "The runner phase observed when the process-tree exit bound fired."}]
 :worker-command-key [:keyword {:description "The command key observed before worker protocol dispatch."}]
 :worker-namespace [:and {:description "The namespace token in which the runner sought a test Var; a value that survives namespace deletion."} :seon.ns/name]
 :worker-error-log [:string {:min 1 :description "The worker error-log path observed when process launch failed."}]
 :invalid-marker-reason-error
 [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :seon.error/base
  [:map [:seon.test/sym :seon.test/sym]
   [:seon.test.runner/marker-key :seon.test.runner/marker-key]
   [:seon.error/offending :seon.schema/value]]]
 :process-tree-exit-backstop-error
 [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :seon.error/base
  [:map [:seon.test.runner/worker-id :seon.test.runner/worker-id]
   [:seon.test.runner/process-tree-exit-bound-ms :seon.test.runner/process-tree-exit-bound-ms]
   [:seon.test.runner/process-tree-phase :seon.test.runner/process-tree-phase]]]
 :unknown-worker-command-error
 [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :seon.error/base
  [:map [:seon.test.runner/worker-id :seon.test.runner/worker-id]
   [:seon.test.runner/worker-command-key :seon.test.runner/worker-command-key]
   [:seon.error/offending :seon.schema/value]]]
 :unresolved-test-var-error
 [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :seon.error/base
  [:map [:seon.test/sym :seon.test/sym]
   [:seon.test.runner/worker-namespace :seon.test.runner/worker-namespace]]]
 :worker-launch-failure-error
 [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :seon.error/base
  [:map [:seon.test.runner/worker-id :seon.test.runner/worker-id]
   [:seon.test.runner/worker-error-log :seon.test.runner/worker-error-log]
   [:seon.error/offending :seon.schema/value]]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.test.runner/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.test.runner/error-selection :seon.test.runner/error-selection]
  [:seon.test.runner/worker-observation
   :seon.test.runner/worker-observation]]]

 :seon.test.runner/error-selection
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :seon.test.runner/worker-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]
}
