#:seon.task
{:handle [:string {:min 12 :max 12}]
 :id [:and {:seon.db/identity true :seon.program/row-schema :seon.task/task
            :description "The task handle: seon.id/id over the ordered aspect [ns name] (spec 3b.6), derived at ingestion and never written by hand. seon.task/task-handle returns it."} :seon.task/handle]
 :sym [:qualified-symbol {:seon.db/unique true :seon.program/row-schema :seon.task/task
                          :description "The symbol ns/name naming a task, derived at ingestion beside its handle: what :seon/tasks tags and readers name. Unique: one ns holds one task of a name."}]
 :ns [:symbol {:description "The owning namespace: the task file's stem, resources/seon/tasks/<ns>.edn."}]
 :name [:and {:gen/elements ["a-task" "another-task"]
              :description "The readable name, one symbol's name (seon.task/symbol-name?); with :ns the identifying aspect and the task's symbol."}
         [:string {:min 1}] [:fn {:error/message "must be one symbol's name"} seon.task/symbol-name?]]
 :step [:enum {:description "The step kind: Prove supplies new red product tests; Implement makes its proofs green, its subject's tagged tests and its product among them. A task declaring none is judged by its own tagged tests (seon.task/obligations)."} :prove :implement]
 :plan [:string {:min 1 :description "The plan: Markdown that starts as the user's request and that every task improves, in blocks such as ## Problem, ## What exists and ## Approach, with the references it cites (seon.ref/names). Declared on the subject (required on a task with no parent), inherited down :seon.task/children, a child's own value overwriting (seon.task/effective)."}]
 :instructions [:string {:min 1 :seon.task/owned true :description "A step's own work, beside the goal it shares: declared on the step, never inherited past a task that declares its own (seon.task/effective); my.task/refine! writes it on the held step."}]
 :references [:set {:min 1 :seon.db/index true :seon.program/definition-edge true
                     :description "The qualified symbols the task's intent and instructions cite as code spans (seon.ref/names), derived by the task writer whenever either is written; never authored."}
              :seon.program/edge-symbol]
 :tasks [:set {:min 1 :seon.db/index true :seon.db/reference-to :seon.task/sym :description "The task symbols a definition's :seon/tasks names, as symbol values (never refs). On a deftest they are the tasks it proves; anywhere else the tasks it is subject to."} :qualified-symbol]
 :entry [:map {:closed true :description "Retired: the running JVM's task file schema until it reloads; seon.task/file-declarations now validates each entry as a closed :seon.task/declaration. Deleted with :seon.task/file by seon.task/retire-entry-schema."}
         [:seon.task/name :seon.task/name] [:seon.task/step {:optional true} :seon.task/step]
         [:seon.task/plan {:optional true} :seon.task/plan] [:seon.task/instructions {:optional true} :seon.task/instructions]
         [:seon.task/children {:optional true} :seon.task/children] [:seon.task/needs {:optional true} :seon.task/needs] [:seon.task/product {:optional true} :seon.task/product]]
 :file [:vector :seon.task/entry]
 :files [:map-of {:description "Task file path to its exact text; a deleted file is \"[]\", an empty declaration."} [:string {:min 1}] :string]
 :declaration [:map {:description "A task's declared content, compared as its revision (7.16), and the one list of its members (seon.task/declaration-members): a task file entry is one, closed, its :seon.task/ns the file's and empty sets absent; create! writes these members. Its handle and symbol derive from it."}
               [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name] [:seon.task/step {:optional true} :seon.task/step]
               [:seon.task/plan {:optional true} :seon.task/plan] [:seon.task/instructions {:optional true} :seon.task/instructions]
               [:seon.task/children {:optional true} :seon.task/children] [:seon.task/needs {:optional true} :seon.task/needs] [:seon.task/product {:optional true} :seon.task/product]
               [:seon.task/proofs {:optional true} :seon.task/proofs] [:seon.task/model {:optional true} :seon.task/model]]
 :basis [:map-of {:description "The declarations the caller read, by handle; an absent handle was read as absent."} :seon.task/handle :seon.task/declaration]
 :task [:map {:seon.db/attributes true :seon.program/partition :seon.cluster
              :seon.render/ai seon.render.ns/task-ai :seon.render/html seon.render.ns/task-html
              :seon.render/form seon.render.ns/task-form}
        [:seon.task/id :seon.task/id] [:seon.task/sym :seon.task/sym] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
        [:seon.task/step {:optional true} :seon.task/step]
        [:seon.task/plan {:optional true} :seon.task/plan] [:seon.task/instructions {:optional true} :seon.task/instructions]
        [:seon.task/references {:optional true} :seon.task/references]
        [:seon.task/created-by {:optional true} :seon.task/created-by] [:seon.task/outcome {:optional true} :seon.task/outcome] [:seon.task/reason {:optional true} :seon.task/reason]
        [:seon.task/faults {:optional true} :seon.task/faults]
        [:seon.task/landed {:optional true} :seon.task/landed] [:seon.task/landed-git {:optional true} :seon.task/landed-git]
        [:seon.task/refusal {:optional true} :seon.task/refusal] [:seon.task/refused-tests {:optional true} :seon.task/refused-tests]
        [:seon.task/verdict {:optional true} :seon.task/verdict]
        [:seon.task/children {:optional true} :seon.task/children] [:seon.task/needs {:optional true} :seon.task/needs] [:seon.task/product {:optional true} :seon.task/product]
        [:seon.task/proofs {:optional true} :seon.task/proofs] [:seon.task/model {:optional true} :seon.task/model]
        [:seon.task/execution {:optional true} :seon.task/execution]
        [:seon.task/next {:optional true} :seon.task/next]
        [:seon.task/branch {:optional true :description "On a chain task: the branch its attempts check out, else its chain's (TASK-CHAIN 2.2; a merge step names its kept merge branch)."} :seon.task/branch]
        [:seon.task/attempts-made {:optional true} :seon.task/attempts-made]
        [:seon.task/cron {:optional true} :seon.task/cron] [:seon.task/zone {:optional true} :seon.task/zone]
        [:seon.task/function {:optional true} :seon.task/function]]
 :children [:set {:seon.db/component true :seon.db/component-schema :seon.task/task
                  :description "The child tasks a parent owns (runtime-follows-db §2): a parent never runs and is done when no leaf under it is open (seon.task/done?); its intent, instructions and execution are what its children inherit unless they declare their own (seon.task/effective, seon.task/execution). Authored in task EDN as lookup refs [:seon.task/sym ns/name]."}
            :seon.db/ref]
 :needs [:set {:seon.db/index true :seon.wake/starts true
               :description "The tasks this one is ready only after (runtime-follows-db §2): each must be done; inherited by every descendant. Siblings without needs between them run in parallel. Authored in task EDN as lookup refs [:seon.task/sym ns/name]; a cycle is refused at the writer (seon.task/refuse-needs-cycle)."}
         :seon.db/ref]
 :owned [:boolean {:description "On a content member of a task: the chain's template sets it and an agent may change it, but it never flows to the next task (TASK-CHAIN 1). Exactly instructions, proofs and model carry it; every other content member flows."}]
 :model [:or {:seon.task/owned true :description "Who works this task (TASK-CHAIN 2.2): a provider model name, or :outside, an agent outside Seon (a Claude Code agent through MCP eval_clj as the attempt's agent id on the chain branch), whose graph takes no model turn (seon.turn/next-agent-work). Absent: the cluster's :seon.config.ai/model. A name is stored but not yet called (seon.task/a-task-model-name-reaches-its-agents-provider-request). Owned, never flowing."}
         [:string {:min 1}] [:= :outside]]
 :next [:and {:seon.db/index true :description "The one task that follows this one in its chain: a peer reference, never a component, absent on the last task. Written by the chain's writer, never declared in a task file; tasks linked by next are a chain."} :seon.db/ref]
 :execution [:enum {:seon.db/index true :seon.wake/starts true :default :held
                    :description "The task's execution (runtime-follows-db §3), inherited down :seon.task/children: a task runs under its own, else its nearest ancestor's (seon.task/execution). Ingestion and create! write :held on a new task with no parent, so one :running fact on a subject launches its steps, and a step's own value keeps it apart. :held is never launched, :paused is hosted without running, :stopped releases its graph keeping agent, branch and attempt, :cancelled ends it."}
             :held :running :paused :stopped :cancelled]
 :attempts-made [:int {:min 1 :description "How many attempts of this task were ever written (seon.task/attempt-tx writes it with each attempt): the next is one more, so a removed attempt never re-mints its identity or branch."}]
 :cron [:string {:min 1 :description "When a recurring task fires: a cron expression, parsed by the schedule's cron library (runtime-follows-db §6)."}]
 :zone [:string {:min 1 :description "The time zone a task's cron expression is read in."}]
 :function [:and {:seon.fn/reference-to :seon.fn/sym
                  :description "The function a firing of this task calls in the clock proc instead of creating an attempt (runtime-follows-db §6)."}
            :seon.db/ref]
 :effective [:map {:description "A step's effective task (seon.task/effective): its handle and symbol, and clojure.core/merge of the intent, instructions and product declared from its root subject down :seon.task/children to it, its own last."}
             [:seon.task/id :seon.task/id] [:seon.task/sym :seon.task/sym] [:seon.task/plan :seon.task/plan]
             [:seon.task/instructions {:optional true} :seon.task/instructions] [:seon.task/product {:optional true} :seon.task/product]]
 :attempt-of [:and {:seon.db/index true :description "The task an assignment row is an attempt of, as a ref, written beside the handle value :seon.task/assigned (runtime-follows-db §2)."} :seon.db/ref]
 :held-view [:map {:description "The task an agent holds as its opening shows it: name and intent, with the read of its proofs offered."}
             [:seon.task/id :seon.task/id] [:seon.task/name {:optional true} :seon.task/name]
             [:seon.task/plan {:optional true} :seon.task/plan]
             [:seon.render/operations :seon.render/operations]]
 :of-agent [:and {:seon.render/derived true
                  :description "The task an agent holds, derived from its latest assignment at main (seon.task/agent-task); no datom stores it. The agent's attachment, so its task stays in its opening across compaction."
                  :seon.render/ai seon.render.ns/held-task-ai :seon.render/html seon.render.ns/held-task-html
                  :seon.render/form seon.render.ns/held-task-form}
            :seon.db/ref]
 :faults [:set {:seon.db/index true :description "The fault signatures a task answers (seon.error/commit-call writes a producer's own task with each of its faults). The task is closed when every one is resolved (seon.task/resolution)."} :seon.db/ref]
 :created-by [:and {:description "The agent that wrote a runtime task (7.8); file reconciliation never retracts a task carrying it."} :seon.db/ref]
 :outcome [:enum {:description "How an attempt ended its task's part of a chain: done (its proofs passed and the chain moved on), merged (seon.merge/merge-tx, in the merge's transaction, for a :done end), or closed (another end merged, or root's decline with a reason, seon.task/close!); absence means open. A merge task generated before assignments carried it records it too."} :done :merged :closed]
 :landed [:uuid {:description "The main commit a merge task's landing made (seon.cluster.source/land! on a green end, seon.turn/end-task!)."}]
 :landed-git [:and {:description "The git commit a merge task's landing made in the checkout."} :seon.git/commit]
 :refusal [:qualified-keyword {:description "The error type of the refusal a merge task's landing, or an assignment's merge (seon.merge/merge! through db<->flow's :merge), returned (a red gate, a contract, lint or write-back refusal): the candidate's own, so the same db<->flow pass relaunches the assignment from its end commit while its allowance lasts and otherwise closes it for root (seon.cluster.agent/assignment-actions)."}]
 :publication-refusal [:qualified-keyword {:description "The error type of the refusal an assignment's publication (seon.merge/publish!) met (a write-back, index or commit refusal); the merge stays as it is for root, and no pass publishes it again until root retracts this."}]
 :verdict [:string {:min 1 :description "On root's problem task for a bailed chain attempt: the verdict that ended it, as the canonical EDN (seon.id/printed; clojure.edn reads it back) of a :seon.task/last-verdict. Producer: seon.cluster.agent/bail-chain!; reader: seon.render.ns/task-ai."}]
 :test-error [:map {:description "The error that stopped a bailed attempt's latest test run: its :seon.error/type, :seon.error/operation and :seon.error/message (:seon.test.run/stopped-error, carried by :seon.agent/end-test-error); the cause the stalled attempt's own reply gave no one."}
              [:seon.error/type :keyword] [:seon.error/operation :qualified-symbol] [:seon.error/message :string]]
 :last-verdict [:map {:description "The verdict that bailed a chain attempt, as data: its proofs' counts and red proofs when its agent recorded them (seon.context/end-summary-tx), and the refusals of the done rule (seon.cluster.source/done-refusals) or of the final merge, each with its :seon.source/red-tests."}
                [:seon.task/proof-counts {:optional true} :seon.task/proof-counts] [:seon.task/red-proofs {:optional true} :seon.task/red-proofs]
                [:seon.source/refusals {:optional true} [:vector :seon.context/refusal]]
                [:seon.task/test-error {:optional true} :seon.task/test-error]]
 :refused-tests [:set {:description "The tests whose red verdict refused a merge task's landing."} :seon.test/sym]
 :end [:enum {:description "How an agent's task ended: its proofs green (a merge decides; an empty delta merges as an accepted no-op), given back with my.task/send-back!, its turns spent, stalled (the loop stopped calling it before its proofs passed), or sent back to the task my.task/send-back! named as its :my.task/target. The end closes the agent's admission (seon.turn/end-task-call). Producer: seon.turn/task-end."} :done :given-back :capped :stalled :sent-back]
 :calls [:int {:min 0 :description "The model calls an ended task's agent took."}]
 :prompt-tokens [:int {:min 0 :description "The prompt tokens an ended task's model calls sent."}]
 :completion-tokens [:int {:min 0 :description "The completion tokens an ended task's model calls received."}]
 :proof-counts [:map-of {:description "An ended task's proofs by status on its agent's branch."} :seon.context/proof-status [:int {:min 1}]]
 :red-proofs [:vector {:description "An ended task's red proofs."} :seon.test/sym]
 :end-unknown [:= {:description "Present (true) when neither the ending agent's branch nor the outcome recorded when its task ended remains: calls, tokens and proofs are unknown, never zero."} true]
 :errors [:vector {:description "The errors an ended task's agent evaluated on its branch, grouped by signature (seon.problems/agent-errors-by-signature)."} :seon.problems/agent-error]
 :ended [:map {:description "What a task's end message stands for, derived when root reads it from the outcome recorded on the ending agent when its task ended (seon.context/end-summary-tx), else from its branch, else unknown; the message holds references only. Producer: seon.context/ended."}
         [:seon.task/id :seon.task/id] [:seon.task/end :seon.task/end] [:seon.agent/id :seon.agent/id]
         [:seon.task/sym {:optional true} :seon.task/sym] [:seon.agent/branch {:optional true} :seon.agent/branch]
         [:seon.task/merge {:optional true} :seon.task/merge]
         [:seon.task/landed {:optional true} :seon.task/landed] [:seon.task/landed-git {:optional true} :seon.task/landed-git]
         [:seon.task/refusal {:optional true} :seon.task/refusal] [:seon.task/refused-tests {:optional true} :seon.task/refused-tests]
         [:seon.task/proof-counts {:optional true} :seon.task/proof-counts] [:seon.task/red-proofs {:optional true} :seon.task/red-proofs]
         [:seon.task/errors {:optional true} :seon.task/errors]
         [:seon.task/calls {:optional true} :seon.task/calls] [:seon.task/prompt-tokens {:optional true} :seon.task/prompt-tokens]
         [:seon.task/completion-tokens {:optional true} :seon.task/completion-tokens]
         [:seon.task/end-unknown {:optional true} :seon.task/end-unknown]
         [:seon.render/operations [:vector :seon.render/read-form]]]
 :status [:enum {:description "Where an assigned task stands for its agent: derived from its assignment, proofs and turns, never stored."} :working :requested :done :bailed :capped]
 :revision [:string {:min 64 :max 64 :description "seon.id/digest over a task's declaration: the revision an assignment reviewed (7.16)."}]
 :assignment [:string {:min 12 :max 12 :seon.db/identity true :seon.program/row-schema :seon.task/assignment-row
                       :description "seon.id/id over [task attempt-number]: one attempt of a task by an agent on its branch (seon.task/attempt-tx), written on the cluster; rows written before attempts were numbered derive from [task agent branch]."}]
 :assigned [:and {:seon.db/index true :description "The assigned task's handle, a value, never a ref (7.2)."} :seon.task/handle]
 :agent [:and {:seon.db/index true :description "The agent an assignment names."} :seon.db/ref]
 :branch [:and {:description "The branch the work is on: an attempt's, and on a chain task the branch its attempts check out (MERGE-STEP)."} :seon.store/branch]
 :merge-base [:and {:description "Retired: the stored copy of an assignment's base, kept only as the attribute of values written before the commit graph answered it; nothing writes or reads it. A merge's base is the branch's fork point (seon.cluster.registry/fork-point) and whether it merged is main's ancestry (seon.merge/merge!). Phase 4 of the one-merge-base plan deletes it with the stored values."} :seon.source/commit-id]
 :merge-commit [:uuid {:description "The main commit root's merge of an assignment made (seon.merge/merge!), recorded once it committed: what publication of the merged declarations reads."}]
 :merged-declarations [:int {:min 1 :description "How many declarations, program and task, root's merge of an assignment moved onto main (seon.cluster.source/merge-accepted of its merge commit), written once beside :seon.task/merge-commit (seon.merge/merge!); absent when the merge moved none: a merge holding it is due for publication until its :seon.task/git-commit (seon.cluster.agent/next-actions)."}]
 :git-commit [:and {:seon.wake/starts true :description "The git commit publishing an assignment's merged declarations made in the checkout (seon.merge/publish!), written after it: it wakes db<->flow, whose next pass deletes the published assignment's branch; while a merge that moved declarations (:seon.task/merged-declarations) lacks it, its publication is due (seon.cluster.agent/next-actions)."} :seon.git/commit]
 :assignment-row [:map {:seon.db/attributes true :seon.program/partition :seon.cluster}
                  [:seon.task/assignment :seon.task/assignment] [:seon.task/assigned :seon.task/assigned]
                  [:seon.task/revision {:seon.cluster/conflict :ours :description "Derived from the task's declaration by the writer that revises it (seon.task/advance-assignments-tx), so main's own advance wins a concurrent one: the conflict that matters is the task's, reported once."} :seon.task/revision] [:seon.task/agent :seon.task/agent] [:seon.task/branch :seon.task/branch]
                  [:seon.task/attempt-of {:optional true} :seon.task/attempt-of] [:seon.task.attempt/number {:optional true} :seon.task.attempt/number]
                  [:seon.task.attempt/end {:optional true} :seon.task.attempt/end] [:seon.task.attempt/target {:optional true} :seon.task.attempt/target]
                  [:seon.task.attempt/reason {:optional true} :seon.task.attempt/reason] [:seon.task.attempt/commit {:optional true} :seon.task.attempt/commit]
                  [:seon.task/merge-base {:optional true} :seon.task/merge-base]
                  [:seon.task/outcome {:optional true} :seon.task/outcome] [:seon.task/reason {:optional true} :seon.task/reason]
                  [:seon.task/merge-commit {:optional true} :seon.task/merge-commit]
                  [:seon.task/merged-declarations {:optional true} :seon.task/merged-declarations]
                  [:seon.task/git-commit {:optional true} :seon.task/git-commit] [:seon.task/refusal {:optional true} :seon.task/refusal]
                  [:seon.task/publication-refusal {:optional true} :seon.task/publication-refusal]
                  [:seon.task.attempt/relaunch {:optional true} :seon.task.attempt/relaunch]]
 :merge [:and {:seon.db/index true :description "The merge task an end message names."} :seon.task/handle]
 :closed-by [:enum {:description "What closed a task (seon.task/resolution): root's merge outcome, or for a parent its children all done."} :seon.task/outcome :seon.task/children]
 :resolution [:map {:description "Why a task is closed: derived, never stored."}
              [:seon.task/closed-by :seon.task/closed-by]]
 :closed [:map {:description "An assignment root closed (seon.task/close!), with its outcome and reason."}
          [:seon.task/assignment :seon.task/assignment] [:seon.task/outcome :seon.task/outcome] [:seon.task/reason {:optional true} :seon.task/reason]
          [:seon.task/delete-refusals {:optional true :description "Each source branch deletion that refused, answered beside the closed request."} [:vector :seon.error/value]]]
 :reason [:string {:min 1 :description "Why root closed an assignment without merging it."}]
 :close-context [:map {:description "What closing a merge request reads and writes: the connection whose main it writes, and the store, routing and environment that delete a source branch with its agent."}
                 [:seon.db/connection :seon.db/connection] [:seon.store/store :seon.store/store]
                 [:seon.agent/routing {:optional true} :seon.agent/routing]
                 [:seon.env/environment {:optional true} :seon.env/environment]]
 :proof-run [:and {:description "The error that kept the task's proofs from running in the agent's world at assignment: the infrastructure failure that refused :proof-run-failed, never work."} :seon.schema/value]
 :assignment-view [:map {:description "An assignment as root's assign! answers it: the task, the agent and its branch; root's merge takes its proofs from the task, the deftests naming it (^{:seon/tasks #{'ns/task-name}})."}
                   [:seon.task/assignment :seon.task/assignment] [:seon.task/assigned :seon.task/assigned]
                   [:seon.agent/id :seon.agent/id] [:seon.task/branch :seon.task/branch]
                   [:seon.render/operations :seon.render/operations]]
 :assigned-work [:map {:description "What an agent's branch is assigned: the key naming its assignment, the owning namespace and the proofs."}
                 [:seon.task/key :seon.task/key] [:seon.task/ns :seon.task/ns] [:seon.task/proofs :seon.task/proofs]
                 [:seon.task/assigned {:optional true} :seon.task/assigned]
                 [:seon.task/sym {:optional true} :seon.task/sym]]
 :key [:string {:min 1 :description "What names a merge task: the assignment identity."}]
 :quoted-symbol [:cat [:= quote] :qualified-symbol]
 :annotation [:map {:description "Stage 1: the task member of one attribute map."}
              [:seon/tasks {:optional true} [:set :seon.task/quoted-symbol]]]
 :links [:map {:description "Stage 3: the edges one holder's annotation produces."}
         [:seon.task/tasks {:optional true} :seon.task/tasks]]
 :product [:set {:description "The deftests a Prove step supplies its successors, by symbol: authored on the step for each test it must write, joined at seon.task/obligations with the tests already tagged with a task that needs it, so a declared test no one wrote yet keeps the step from done."} :qualified-symbol]
 :obligations [:map [:seon.task/step {:optional true} :seon.task/step] [:seon.task/proofs :seon.task/proofs]
               [:seon.task/product :seon.task/product]]
 :subjects [:set :symbol] :referrers [:set :symbol]
 :proofs [:set {:seon.task/owned true :description "The deftests that must be green for this task to be done, by symbol: set from its template when its chain is created (seon.task/chain!), changed by an agent (Prove writes the next task's), joined with the task's own tagged tests until tags go; owned, never flowing."} :symbol]
 :task-map [:map {:description "One task of a chain as seon.task/chain! takes it: ordinary task members, a template's owned members merged with a plan. Only the first map's ns and name are read; identity, tempid and next are derived by position; an omitted execution is :running for the first and :held for the rest."}
            [:seon.task/ns {:optional true} :seon.task/ns] [:seon.task/name {:optional true} :seon.task/name]
            [:seon.task/plan {:optional true} :seon.task/plan] [:seon.task/instructions {:optional true} :seon.task/instructions]
            [:seon.task/proofs {:optional true} :seon.task/proofs] [:seon.task/model {:optional true} :seon.task/model]
            [:seon.task/execution {:optional true} :seon.task/execution]]
 :chain-context [:map {:description "What creating a chain writes through: main's connection, which holds the chain fact, and the store whose branches hold the chain's branch."}
                 [:seon.db/connection :seon.db/connection] [:seon.store/store :seon.store/store]]
 :chain-options [:map {:description "How a chain starts: :seon.chain/from names the branch whose head it forks from instead of main's; :seon.chain/config the chain's own config decisions over main's; :seon.chain/merge? false ends it at its last task's done with no merge."}
