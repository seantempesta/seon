#:seon.task
{:handle [:string {:min 12 :max 12}]
 :id [:and {:seon.db/identity true :seon.program/row-schema :seon.task/task
            :description "The task handle: seon.id/id over the ordered aspect [ns name kind] (spec 3b.6), written literally in task EDN, :seon/tasks annotations and rendered context. seon.issue/task-handle returns it."} :seon.task/handle]
 :ns [:symbol {:description "The owning namespace: the task file's stem, resources/seon/tasks/<ns>.edn."}]
 :name [:string {:min 1 :description "The readable name; with :ns and :kind the identifying aspect."}]
 :kind [:enum {:description "The subject kind the task concerns; part of its aspect. A :merge task is generated by a proposal (merge task design §1)."} :function :namespace :schema :merge]
 :intent [:string {:min 1}]
 :must-read [:set {:min 1 :description "Functions a task's worker reads first; bare qualified symbols in task EDN."} :seon.program/edge-symbol]
 :evidence [:set {:min 1 :description "Repository paths of evidence documents; linked, never parsed."} [:string {:min 1}]]
 :tasks [:set {:min 1 :seon.db/index true :description "Task handles a definition's :seon/tasks names, as string values (never refs). On a deftest they are the tasks it proves; anywhere else the tasks it is subject to."} :seon.task/handle]
 :entry [:map {:closed true :description "Stage 1: one authored entry of resources/seon/tasks/<ns>.edn; empty optional sets are absent."}
         [:seon.task/id {:optional true} :seon.task/id] [:seon.task/name :seon.task/name] [:seon.task/kind :seon.task/kind]
         [:seon.task/intent :seon.task/intent] [:seon.task/must-read {:optional true} :seon.task/must-read]
         [:seon.task/evidence {:optional true} :seon.task/evidence]]
 :file [:vector :seon.task/entry]
 :files [:map-of {:description "Task file path to its exact text; a deleted file is \"[]\", an empty declaration."} [:string {:min 1}] :string]
 :declaration [:map {:description "Stage 3: a task's declared content, compared as its revision (7.16)."}
               [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name] [:seon.task/kind :seon.task/kind]
               [:seon.task/intent :seon.task/intent] [:seon.task/must-read {:optional true} :seon.task/must-read]
               [:seon.task/evidence {:optional true} :seon.task/evidence]]
 :basis [:map-of {:description "The declarations the caller read, by handle; an absent handle was read as absent."} :seon.task/handle :seon.task/declaration]
 :task [:map {:seon.db/attributes true :seon.program/partition :seon.data
              :seon.render/ai seon.render.ns/task-ai :seon.render/html seon.render.ns/task-html}
        [:seon.task/id :seon.task/id] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name] [:seon.task/kind :seon.task/kind]
        [:seon.task/intent :seon.task/intent] [:seon.task/must-read {:optional true} :seon.task/must-read]
        [:seon.task/evidence {:optional true} :seon.task/evidence]
        [:seon.task/created-by {:optional true} :seon.task/created-by] [:seon.task/outcome {:optional true} :seon.task/outcome]]
 :created-by [:and {:description "The agent that wrote a runtime task (7.8); file reconciliation never retracts a task carrying it."} :seon.db/ref]
 :outcome [:enum {:description "Root's decision on a merge task; absence means open."} :accepted :declined]
 :revision [:string {:min 64 :max 64 :description "seon.id/digest over a task's declaration: the revision an assignment reviewed (7.16)."}]
 :assignment [:string {:min 12 :max 12 :seon.db/identity true :seon.program/row-schema :seon.task/assignment-row
                       :description "seon.id/id over [task agent branch]: root assigning a task to an agent's branch (2.8), written on the cluster."}]
 :assigned [:and {:seon.db/index true :description "The assigned task's handle, a value, never a ref (7.2)."} :seon.task/handle]
 :agent [:and {:seon.db/index true :description "The agent an assignment names."} :seon.db/ref]
 :branch [:and {:description "The branch the work is on."} :seon.store/branch]
 :assignment-row [:map {:seon.db/attributes true :seon.program/partition :seon.data}
                  [:seon.task/assignment :seon.task/assignment] [:seon.task/assigned :seon.task/assigned]
                  [:seon.task/revision :seon.task/revision] [:seon.task/agent :seon.task/agent] [:seon.task/branch :seon.task/branch]]
 :proposal [:string {:min 12 :max 12 :seon.db/identity true :seon.program/row-schema :seon.task/proposal-row
                     :description "seon.id/id over [assignment commit], the recurrence key: one proposal per assignment and proposed commit."}]
 :merge [:and {:seon.db/index true :description "The generated merge task a proposal records."} :seon.task/handle]
 :proposes [:and {:description "The assignment, or the legacy issue (:seon.issue/agent), the proposal answers."} :seon.db/ref]
 :commit [:uuid {:description "C: the proposing branch's commit its proofs ran on."}]
 :proved [:set {:min 1 :description "Each proof as [test symbol, definition digest] at C: references that outlive C."}
          [:tuple :symbol [:string {:min 64 :max 64}]]]
 :run-id [:and {:description "The test run on C that proved them."} :seon.test.run/id]
 :program [:and {:description "The run's tested program identity."} :seon.test.run/program-digest]
 :proposal-view [:map [:seon.task/proposal :seon.task/proposal] [:seon.task/merge :seon.task/merge]
                 [:seon.task/branch :seon.task/branch] [:seon.task/commit :seon.task/commit] [:seon.task/proved :seon.task/proved]
                 [:seon.task/run-id :seon.task/run-id] [:seon.task/program :seon.task/program]]
 :proposal-row [:map {:seon.db/attributes true :seon.program/partition :seon.data}
                [:seon.task/proposal :seon.task/proposal] [:seon.task/merge :seon.task/merge] [:seon.task/proposes :seon.task/proposes]
                [:seon.task/branch :seon.task/branch] [:seon.task/commit :seon.task/commit] [:seon.task/proved :seon.task/proved]
                [:seon.task/run-id :seon.task/run-id] [:seon.task/program :seon.task/program]]
 :assigned-work [:map {:description "What an agent's branch is assigned: the key naming its merge task, the owning namespace, the proofs and what the proposal answers."}
                 [:seon.task/key :seon.task/key] [:seon.task/ns :seon.task/ns] [:seon.task/proofs :seon.task/proofs]
                 [:seon.task/proposes :seon.task/proposes] [:seon.task/assigned {:optional true} :seon.task/assigned]]
 :key [:string {:min 1 :description "What names a merge task: the assignment identity, or a legacy issue's id."}]
 :quoted-symbol [:cat [:= quote] :qualified-symbol]
 :annotation [:map {:description "Stage 1: the task and link members of one attribute map."}
              [:seon/tasks {:optional true} :seon.task/tasks]
              [:seon/must-read {:optional true} [:or [:vector :seon.task/quoted-symbol] [:set :seon.task/quoted-symbol]]]
              [:seon/see-also {:optional true} [:or [:vector :seon.task/quoted-symbol] [:set :seon.task/quoted-symbol]]]]
 :links [:map {:description "Stage 3: the edges one holder's annotation produces."}
         [:seon.task/tasks {:optional true} :seon.task/tasks] [:seon.fn/must-read {:optional true} :seon.fn/must-read]
         [:seon.fn/see-also {:optional true} :seon.fn/see-also]]
 :subjects [:set :symbol] :proofs [:set :symbol] :referrers [:set [:or :symbol :seon.task/handle]]
 :edges [:map [:seon.task/subjects :seon.task/subjects] [:seon.task/proofs :seon.task/proofs] [:seon.task/referrers :seon.task/referrers]]
 :dangling [:map-of :seon.task/handle [:set :symbol]] :triage [:set :seon.task/handle]
 :findings [:map [:seon.task/dangling :seon.task/dangling] [:seon.task/triage :seon.task/triage]]
 :request [:map [:seon.db/connection :seon.db/connection] [:seon.task/files :seon.task/files] [:seon.task/basis {:optional true} :seon.task/basis]]
 :changed? :boolean
 :report [:map [:seon.task/changed? :seon.task/changed?] [:seon.db/transaction-report {:optional true} :seon.db/transaction-report]]
 :refused [:enum {:description "The ingestion rule one task entry or annotation broke."}
           :malformed-annotation :metadata-after-test-name :unreadable-file :not-one-vector :invalid-entry
           :handle-mismatch :duplicate-id :misplaced-file :revision-conflict :dangling-id
           :unknown-task :unassigned :revised-since-assignment :no-proofs :unproven]
 :holder [:symbol {:description "The definition or namespace whose annotation, or the owning namespace whose task file, was refused."}]
 :explanation :seon.schema/value
 :refused-error [:and :seon.error/base
                 [:map [:seon.task/refused :seon.task/refused] [:seon.task/holder :seon.task/holder] [:seon.error/offending {:optional true} :seon.schema/value]
                  [:seon.task/explanation {:optional true} :seon.task/explanation]]]
 :base :seon.task/declaration :current :seon.task/declaration :proposed :seon.task/declaration
 :conflict-error [:and :seon.task/refused-error
                  [:map [:seon.task/base {:optional true} :seon.task/base]
                   [:seon.task/current {:optional true} :seon.task/current] [:seon.task/proposed {:optional true} :seon.task/proposed]]]}
