#:seon.task
{:handle [:string {:min 12 :max 12}]
 :id [:and {:seon.db/identity true :seon.program/row-schema :seon.task/task
            :description "The task handle: seon.id/id over the ordered aspect [ns name kind] (spec 3b.6), derived at ingestion and never written by hand. seon.task/task-handle returns it."} :seon.task/handle]
 :sym [:qualified-symbol {:seon.db/unique true :seon.program/row-schema :seon.task/task
                          :description "The symbol ns/name naming a task, derived at ingestion beside its handle: what :seon/tasks tags and readers name. Unique: one ns holds one task of a name."}]
 :ns [:symbol {:description "The owning namespace: the task file's stem, resources/seon/tasks/<ns>.edn."}]
 :name [:string {:min 1 :description "The readable name, one symbol's name (seon.task/symbol-name?); with :ns and :kind the identifying aspect, with :ns the task's symbol."}]
 :kind [:enum {:description "The subject kind the task concerns; part of its aspect. A :merge task is generated by a proposal (merge task design §1); a :work task is an agent's own, made when it plans with no task."} :function :namespace :schema :merge :work]
 :intent [:string {:min 1}]
 :must-read [:set {:min 1 :seon.program/definition-edge true :description "Functions a task's worker reads first; bare qualified symbols in task EDN."} :seon.program/edge-symbol]
 :evidence [:set {:min 1 :description "Repository paths of evidence documents; linked, never parsed."} [:string {:min 1}]]
 :tasks [:set {:min 1 :seon.db/index true :seon.db/reference-to :seon.task/sym :description "The task symbols a definition's :seon/tasks names, as symbol values (never refs). On a deftest they are the tasks it proves; anywhere else the tasks it is subject to."} :qualified-symbol]
 :entry [:map {:closed true :description "Stage 1: one authored entry of resources/seon/tasks/<ns>.edn; empty optional sets are absent. Its handle and symbol are derived, never written."}
         [:seon.task/name :seon.task/name] [:seon.task/kind :seon.task/kind]
         [:seon.task/intent :seon.task/intent] [:seon.task/must-read {:optional true} :seon.task/must-read]
         [:seon.task/evidence {:optional true} :seon.task/evidence]]
 :file [:vector :seon.task/entry]
 :files [:map-of {:description "Task file path to its exact text; a deleted file is \"[]\", an empty declaration."} [:string {:min 1}] :string]
 :declaration [:map {:description "Stage 3: a task's declared content, compared as its revision (7.16). Its handle and symbol derive from it."}
               [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name] [:seon.task/kind :seon.task/kind]
               [:seon.task/intent :seon.task/intent] [:seon.task/must-read {:optional true} :seon.task/must-read]
               [:seon.task/evidence {:optional true} :seon.task/evidence]]
 :basis [:map-of {:description "The declarations the caller read, by handle; an absent handle was read as absent."} :seon.task/handle :seon.task/declaration]
 :task [:map {:seon.db/attributes true :seon.program/partition :seon.data
              :seon.render/ai seon.render.ns/task-ai :seon.render/html seon.render.ns/task-html
              :seon.render/form seon.render.ns/task-form}
        [:seon.task/id :seon.task/id] [:seon.task/sym :seon.task/sym] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
        [:seon.task/kind :seon.task/kind]
        [:seon.task/intent :seon.task/intent] [:seon.task/must-read {:optional true} :seon.task/must-read]
        [:seon.task/evidence {:optional true} :seon.task/evidence]
        [:seon.task/created-by {:optional true} :seon.task/created-by] [:seon.task/outcome {:optional true} :seon.task/outcome]
        [:seon.task/faults {:optional true} :seon.task/faults]
        [:seon.task/steps {:optional true} :seon.task/steps]
        [:seon.task/subject {:optional true} :seon.task/subject] [:seon.task/signal {:optional true} :seon.task/signal]]
 :steps [:set {:seon.db/component true :seon.db/component-schema :seon.step/step
         :description "A task's ordered steps: owned by the task and outside its declaration, so a step write never revises the task an assignment reviewed."} :seon.db/ref]
 :step-op [:or {:description "One step write, decided inside the transaction: replace every step, append one, or complete the current step and advance."}
           [:tuple [:= :plan] [:vector [:string {:min 1}]]] [:tuple [:= :append] [:string {:min 1}]] [:tuple [:= :done]]]
 :steps-view [:map {:description "A task's steps as the agent reads them: the ordered steps, the current one's text, progress done/total, and the calls offered."}
              [:seon.task/id :seon.task/id] [:seon.task/steps [:vector :seon.step/view]]
              [:seon.task/current-step {:optional true} [:string {:min 1}]]
              [:seon.task/progress {:optional true} [:string {:min 3}]]
              [:seon.render/operations :seon.render/operations]]
 :steps-request [:map [:seon.db/connection :seon.db/connection] [:seon.agent/id :seon.agent/id]]
 :held-view [:map {:description "The task an agent holds as its opening shows it: name, intent and its steps view."}
             [:seon.task/id :seon.task/id] [:seon.task/name {:optional true} :seon.task/name]
             [:seon.task/intent {:optional true} :seon.task/intent] [:seon.task/steps [:vector :seon.step/view]]
             [:seon.task/current-step {:optional true} [:string {:min 1}]]
             [:seon.task/progress {:optional true} [:string {:min 3}]]
             [:seon.render/operations :seon.render/operations]]
 :of-agent [:and {:seon.render/derived true
                  :description "The task an agent holds, derived from its latest assignment at the task home (seon.task/agent-task); no datom stores it. The agent's attachment, so its steps stay in its opening across compaction."
                  :seon.render/ai seon.render.ns/held-task-ai :seon.render/html seon.render.ns/held-task-html
                  :seon.render/form seon.render.ns/held-task-form}
            :seon.db/ref]
 :plan-request [:map [:seon.db/connection :seon.db/connection] [:seon.agent/id :seon.agent/id]
                [:seon.task/steps [:vector {:min 1} [:string {:min 1}]]] [:seon.task/intent {:optional true} :seon.task/intent]]
 :step-request [:map [:seon.db/connection :seon.db/connection] [:seon.agent/id :seon.agent/id]
                [:seon.step/text :seon.step/text] [:seon.task/intent {:optional true} :seon.task/intent]]
 :faults [:set {:seon.db/index true :description "The fault signatures a task answers (seon.error/commit-call writes a producer's own task with each of its faults). The task is closed when every one is resolved (seon.task/resolution)."} :seon.db/ref]
 :subject [:and {:description "The entity a task made from a warning signal concerns: the task is closed once it no longer satisfies :seon.task/signal."} :seon.db/ref]
 :signal [:qualified-keyword {:seon.db/reference-to :seon.schema/key :description "The named warning schema, a predicate over its subject's stored attributes, whose satisfaction the task answers."}]
 :created-by [:and {:description "The agent that wrote a runtime task (7.8); file reconciliation never retracts a task carrying it."} :seon.db/ref]
 :outcome [:enum {:description "Root's decision on a merge task; absence means open."} :accepted :declined]
 :end [:enum {:description "How an agent's task ended: its proofs green, given back with my.turn/complete, or its turns spent. The end closes the agent's admission (seon.turn/end-task-call). Producer: seon.turn/task-end."} :done :given-back :capped]
 :status [:enum {:description "Where an assigned task stands for its agent: derived from its assignment, proofs and turns, never stored."} :working :requested :done :bailed :capped]
 :revision [:string {:min 64 :max 64 :description "seon.id/digest over a task's declaration: the revision an assignment reviewed (7.16)."}]
 :assignment [:string {:min 12 :max 12 :seon.db/identity true :seon.program/row-schema :seon.task/assignment-row
                       :description "seon.id/id over [task agent branch]: root assigning a task to an agent's branch (2.8), written on the cluster."}]
 :assigned [:and {:seon.db/index true :description "The assigned task's handle, a value, never a ref (7.2)."} :seon.task/handle]
 :agent [:and {:seon.db/index true :description "The agent an assignment names."} :seon.db/ref]
 :branch [:and {:description "The branch the work is on."} :seon.store/branch]
 :assignment-row [:map {:seon.db/attributes true :seon.program/partition :seon.data}
                  [:seon.task/assignment :seon.task/assignment] [:seon.task/assigned :seon.task/assigned]
                  [:seon.task/revision :seon.task/revision] [:seon.task/agent :seon.task/agent] [:seon.task/branch :seon.task/branch]]
 :proposal [:string {:min 12 :max 12 :seon.db/identity true :seon.program/row-schema :seon.task/proposal-row
                     :description "seon.id/id over [assignment commit], the recurrence key: one proposal per assignment and proposed commit."}]
 :merge [:and {:seon.db/index true :description "The generated merge task a proposal records."} :seon.task/handle]
 :proposes [:and {:description "The assignment the proposal answers."} :seon.db/ref]
 :commit [:uuid {:description "C: the proposing branch's commit its proofs ran on."}]
 :proved [:set {:min 1 :description "Each proof as [test symbol, definition digest] at C: references that outlive C."}
          [:tuple :symbol [:string {:min 64 :max 64}]]]
 :refuted [:set {:description "Each proof observed red on the proposing branch before its change, as [test symbol, reach digest]: a proof must have failed at the old program (health plan §5)."}
           [:tuple :symbol [:string {:min 64 :max 64}]]]
 :run-id [:and {:description "The test run on C that proved them."} :seon.test.run/id]
 :program [:and {:description "The run's tested program identity."} :seon.test.run/program-digest]
 :proposal-answer [:and {:description "A proposal as propose-merge! answers it: the proposal on record, root's prepare offered, and the message failure when root was not told."}
            :seon.task/proposal-view
            [:map [:seon.render/operations :seon.render/operations]
             [:seon.task/undelivered {:optional true} :seon.error/value]]]
 :closed-by [:enum {:description "What closed a task (seon.task/resolution): every fault it answers resolved, its subject no longer satisfying its signal, or root's merge outcome."} :seon.task/faults :seon.task/signal :seon.task/outcome]
 :resolutions [:vector :seon.error/resolution]
 :resolution [:map {:description "Why a task is closed: derived, never stored."}
              [:seon.task/closed-by :seon.task/closed-by]
              [:seon.task/resolutions {:optional true} :seon.task/resolutions]]
 :claim-request [:map [:seon.db/connection :seon.db/connection] [:seon.agent/id :seon.agent/id]
                 [:seon.task/assigned :seon.task/assigned]]
 :open-view [:map {:description "An open task as the queue shows it (my.task/open): named, what it answers and how often, and the claim offered."}
             [:seon.task/id :seon.task/id] [:seon.task/sym {:optional true} :seon.task/sym]
             [:seon.task/name :seon.task/name] [:seon.task/ns :seon.task/ns]
             [:seon.task/intent :seon.task/intent]
             [:seon.task/faults {:optional true} [:vector :seon.error/signature]]
             [:seon.task/occurrences :seon.task/occurrences]
             [:seon.render/operations :seon.render/operations]]
 :occurrences [:int {:min 0 :description "How often the faults a task answers occurred, summed."}]
 :decided [:map {:description "A merge task root closed, with its outcome."} [:seon.task/id :seon.task/id] [:seon.task/outcome :seon.task/outcome]]
 :assignment-view [:map {:description "An assignment as root's assign! answers it: the task, the agent and its branch, and the agent's proposal offered: it runs once a deftest naming the task (^{:seon/tasks #{'ns/task-name}}) passes on the branch."}
                   [:seon.task/assignment :seon.task/assignment] [:seon.task/assigned :seon.task/assigned]
                   [:seon.agent/id :seon.agent/id] [:seon.task/branch :seon.task/branch]
                   [:seon.render/operations :seon.render/operations]]
 :proposal-view [:map [:seon.task/proposal :seon.task/proposal] [:seon.task/merge :seon.task/merge]
                 [:seon.task/branch :seon.task/branch] [:seon.task/commit :seon.task/commit] [:seon.task/proved :seon.task/proved]
                 [:seon.task/run-id :seon.task/run-id] [:seon.task/program :seon.task/program]]
 :proposal-row [:map {:seon.db/attributes true :seon.program/partition :seon.data}
                [:seon.task/proposal :seon.task/proposal] [:seon.task/merge :seon.task/merge] [:seon.task/proposes :seon.task/proposes]
                [:seon.task/branch :seon.task/branch] [:seon.task/commit :seon.task/commit] [:seon.task/proved :seon.task/proved]
                [:seon.task/refuted {:optional true} :seon.task/refuted]
                [:seon.task/run-id :seon.task/run-id] [:seon.task/program :seon.task/program]]
 :assigned-work [:map {:description "What an agent's branch is assigned: the key naming its merge task, the owning namespace, the proofs and what the proposal answers."}
                 [:seon.task/key :seon.task/key] [:seon.task/ns :seon.task/ns] [:seon.task/proofs :seon.task/proofs]
                 [:seon.task/proposes :seon.task/proposes] [:seon.task/assigned {:optional true} :seon.task/assigned]
                 [:seon.task/sym {:optional true} :seon.task/sym]]
 :key [:string {:min 1 :description "What names a merge task: the assignment identity."}]
 :quoted-symbol [:cat [:= quote] :qualified-symbol]
 :annotation [:map {:description "Stage 1: the task and link members of one attribute map."}
              [:seon/tasks {:optional true} [:set :seon.task/quoted-symbol]]
              [:seon/must-read {:optional true} [:or [:vector :seon.task/quoted-symbol] [:set :seon.task/quoted-symbol]]]
              [:seon/see-also {:optional true} [:or [:vector :seon.task/quoted-symbol] [:set :seon.task/quoted-symbol]]]]
 :links [:map {:description "Stage 3: the edges one holder's annotation produces."}
         [:seon.task/tasks {:optional true} :seon.task/tasks] [:seon.fn/must-read {:optional true} :seon.fn/must-read]
         [:seon.fn/see-also {:optional true} :seon.fn/see-also]]
 :subjects [:set :symbol] :proofs [:set :symbol] :referrers [:set :symbol]
 :edges [:map [:seon.task/subjects :seon.task/subjects] [:seon.task/proofs :seon.task/proofs] [:seon.task/referrers :seon.task/referrers]]
 :view [:map {:description "A task as its AI face shows it: named, and beyond distance zero its intent and must-reads. Its subjects and proofs are its related data."}
        [:seon.task/id :seon.task/id] [:seon.task/sym {:optional true} :seon.task/sym] [:seon.task/name {:optional true} :seon.task/name]
        [:seon.task/kind {:optional true} :seon.task/kind] [:seon.task/ns {:optional true} :seon.task/ns]
        [:seon.task/intent {:optional true} :seon.task/intent] [:seon.task/must-read {:optional true} :seon.task/must-read]
        [:seon.task/current-step {:optional true} [:string {:min 1}]] [:seon.task/progress {:optional true} [:string {:min 3}]]
        [:seon.task/steps {:optional true} [:vector :seon.step/view]]]
 :dangling [:map-of :seon.task/sym [:set :symbol]] :triage [:set :seon.task/sym]
 :findings [:map [:seon.task/dangling :seon.task/dangling] [:seon.task/triage :seon.task/triage]]
 :request [:map [:seon.db/connection :seon.db/connection] [:seon.task/files :seon.task/files] [:seon.task/basis {:optional true} :seon.task/basis]]
 :changed? :boolean
 :report [:map [:seon.task/changed? :seon.task/changed?] [:seon.db/transaction-report {:optional true} :seon.db/transaction-report]]
 :refused [:enum {:description "The ingestion rule one task entry or annotation broke."}
           :malformed-annotation :metadata-after-test-name :unreadable-file :not-one-vector :invalid-entry
           :invalid-name :duplicate-name :misplaced-file :revision-conflict :dangling-id
           :unknown-task :unassigned :revised-since-assignment :no-proofs :proofs-green :unproven :claimed :no-current-step]
 :holder [:symbol {:description "The definition or namespace whose annotation, or the owning namespace whose task file, was refused."}]
 :explanation :seon.schema/value
 :refused-error [:and :seon.error/base
                 [:map [:seon.task/refused :seon.task/refused] [:seon.task/holder :seon.task/holder] [:seon.error/offending {:optional true} :seon.schema/value]
                  [:seon.task/explanation {:optional true} :seon.task/explanation]]]
 :base :seon.task/declaration :current :seon.task/declaration :proposed :seon.task/declaration
 :conflict-error [:and :seon.task/refused-error
                  [:map [:seon.task/base {:optional true} :seon.task/base]
                   [:seon.task/current {:optional true} :seon.task/current] [:seon.task/proposed {:optional true} :seon.task/proposed]]]}
