;; Tasks, runs, the reconciler, the turn loop and the model, as values (sessions R1 and M1's
;; proto.agents.schema, renamed). The stored attributes are in seon.facts.edn; where a value's
;; shape differs from the stored one (needs as ids, results as a map, conflicts as a vector) the
;; map entry carries its schema inline.
{;; what happened to a task (seon.reconcile/task-state), in the tasks tile's order; each title
 ;; is its meaning (read with seon.contract/properties): a new state is one entry here
 :seon.task/state [:enum {:seon.status/title
                          {:running "running: a run works it now"
                           :blocked "blocked: a task it needs is not done (its blocked-by)"
                           :open "open: released, no run running yet"
                           :failed "failed: held for root with a failure: a run refused, its agent dead, its merge refused, or marked failed (my.task/fail!); root decides: (my.root/run! sys [id]) runs it again on its branch, from the evidence"
                           :held "held: declared in a task file and loaded (load-tasks! creates every task held), not yet released by root or the owner, who order the work; (my.root/run! sys [id]) releases it"
                           :done "done: its proofs pass on its branch; its merge task merges it"
                           :merged "merged into main"
                           :cancelled "cancelled: no task file declares it any more"}}
                   :running :blocked :open :failed :held :done :merged :cancelled]
 :seon.task/config [:map {:closed true} [:seon.config.agent/max-turns {:optional true} :seon.config.agent/max-turns]
                    ;; the model that answers its turns: a test's scripted reply or no provider (docs/config.md#the-resolver), read by seon.config/provider-at
                    [:seon.config.ai/provider {:optional true} :seon.config.ai/provider]
                    [:seon.config.ai/script {:optional true} :seon.config.ai/script]
                    [:seon.config.merge/max-conflicts {:optional true} nat-int?]
                    [:seon.config.merge/max-merge-turns {:optional true} nat-int?]
                    ;; the relevance at which a search shows an item (seon.context/search)
                    [:seon.config.render/relevance-summary {:optional true} :seon.config.render/relevance-summary]]
 :seon.task/need-ids [:set {:gen/max 4} :seon.task/id]
 :seon.task/declaration [:map {:closed true}
                         [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
                         [:seon.task/plan :seon.task/plan]
                         [:seon.task/instructions {:optional true} :seon.task/instructions]
                         [:seon.task/proofs {:optional true} :seon.task/proofs]
                         [:seon.task/needs {:optional true} :seon.task/need-ids]
                         [:seon.task/examples {:optional true} :seon.task/examples]
                         [:seon.task/branch {:optional true} :seon.task/branch]
                         [:seon.task/model {:optional true} :seon.task/model]
                         [:seon.task/config {:optional true} :seon.task/config]
                         [:seon.task/kind {:optional true} :seon.task/kind]
                         [:seon.task/evidence {:optional true} :seon.task/evidence]
                         [:seon.task/cause {:optional true} :seon.task/cause]]
 ;; a task as the reconciler reads it (needs as ids)
 :seon.task/own [:map
                 [:seon.task/id :seon.task/id] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
                 [:seon.task/plan :seon.task/plan] [:seon.task/execution [:enum :held :running :cancelled]]
                 [:seon.task/branch :seon.task/branch] [:seon.task/proofs :seon.task/proofs]
                 [:seon.task/needs :seon.task/need-ids]
                 [:seon.task/instructions {:optional true} :seon.task/instructions]
                 [:seon.task/model {:optional true} :seon.task/model]
                 [:seon.config.agent/max-turns {:optional true} :seon.config.agent/max-turns]
                 [:seon.task/kind :seon.task/kind]
                 [:seon.task/evidence {:optional true} :seon.task/evidence]
                 [:seon.task/failure {:optional true} :seon.task/failure]
                 ;; how its work stands and ended (judged by root, docs/reconcile.md#a-task-holds-how-its-work-ended), the agent as its key
                 [:seon.task/agent {:optional true} :string] [:seon.task/outcome {:optional true} :seon.task/outcome]
                 [:seon.task/reason {:optional true} :string] [:seon.task/reasons {:optional true} :seon.task/reasons]
                 [:seon.task/commit {:optional true} :string] [:seon.task/commit-error {:optional true} :string] [:seon.task/merged-t {:optional true} :int]
                 [:seon.task/error {:optional true} :map]
                 [:seon.task/deferred {:optional true} [:set :qualified-symbol]] [:seon.task/deferred-results {:optional true} :seon.proof/results]
                 [:seon.task/gate-unread {:optional true} :seon.task/gate-unread] [:seon.task/changed {:optional true} :seon.task/changed]
                 [:seon.task/conflicts {:optional true} [:vector :seon.merge/conflict]] [:seon.task/unmerged {:optional true} [:set :string]]]
 ;; its plan and proofs accumulated along :needs (derived by the reader)
 :seon.task/task [:and {:seon.render/html seon.render.ui/task-box} :seon.task/own [:map [:seon.task/accumulated [:map [:plan :string] [:proofs :seon.task/proofs]]]]]
 ;; the environment an agent works in; desired (the task's) = observed (the agent's), or restart
 :seon.task/env [:map {:closed true} [:branch :keyword] [:model [:maybe :string]] [:max-turns pos-int?]
                 ;; an outside run's: the client that attached it (seon.server/held)
                 [:holder {:optional true} :string]]
 :seon.proof/results [:map-of :qualified-symbol :seon.proof/status]
 ;; an agent as the reconciler's index holds it: what root decides on of its process and environment (the entity's attributes,
 ;; seon.task/agent-value)
 :seon.reconcile/agent [:map [:seon.agent/key :string] [:seon.agent/boot {:optional true} :string] [:seon.agent/taken {:optional true} :int]
                        [:seon.agent/env :seon.task/env] [:seon.agent/id {:optional true} :keyword]]
 ;; ---- the done rule and the reconciler's answer ----
 :seon.reconcile/merge-limits [:map [:max-conflicts nat-int?] [:max-merge-turns nat-int?]]
 ;; a released task not done at quiescence: a root cause (held for root with its failure, a
 ;; refused spawn, or cancelled or held)
 ;; and the released tasks it blocks, transitively
 :seon.reconcile/root-cause [:map {:closed true} [:task :seon.task/id] [:cause :string]
                            [:agent {:optional true} :string] [:blocks [:vector :seon.task/id]]]
 ;; the reconciler proc's state, and the steps of a flight
 :seon.reconcile/state [:map [:db :seon.host/db] [:boot :string]
                        [:rid :int] [:flights :map] [:pending :map] [:quiet {:optional true} :boolean]
                        ;; waits on main asked on :judge (seon.root/await-db), each answered once quiet at or after its :after,
                        ;; held across steps (an edge's promise outlives the step that took it); :report, the quiet
                        ;; spell's report until its write is answered
                        [:waits {:optional true} [:vector [:map [:after :int] [:p :seon.host/promise]]]] [:report {:optional true} :int]
                        ;; tasks root refused to spawn, waiting for main to move for another reason
                        [:refused {:optional true} [:set :seon.task/id]]
                        ;; answers to writes on main that main's commits have not reached yet (seon.reconcile/behind?),
                        ;; in the order they came, each taken when :main brings its t
                        [:behind {:optional true} [:vector [:map [:tag :int] [:r :map]]]]]
 ;; the incremental reconciler's index of main (session R3's seon.reconcile/index): desired and
 ;; observed state by id, the derived needs, depths and claims, and the sets the actions read.
 ;; Its parts agree with each other (every id in a set is a run it holds), which a
 ;; generator of the parts alone breaks: mg/check generates the empty index only, and the
 ;; index's laws are R3's oracle property test (test/r3/inc_test.clj, the same actions as a
 ;; full reconcile on generated dbs). Each part is checked shallowly: every helper of the
 ;; reconciler takes the index, so a check of its entries would cost tasks on every call and
 ;; tasks x tasks a listing; each entry is checked once, where it enters (put-task's
 ;; :seon.task/own, put-run's :seon.run/run, the ids of derive-needs and refresh-ready)
 :seon.reconcile/index [:map {:gen/elements [{:root nil :tasks {} :keys {} :needed-by {} :acc {} :depth {} :claims {}
                                              :agents {} :done {} :ready #{} :ready-key {}
                                              :live #{} :reap #{} :kill {} :judge #{} :merging #{} :msgs {}}]}
                        [:root [:maybe :map]] [:tasks :map] [:keys :map] [:needed-by :map]
                        [:acc :map] [:depth :map] [:claims :map]
                        [:agents :map] [:done :map]
                        [:ready set?] [:ready-key :map]
                        [:live set?] [:reap set?] [:kill :map]
                        [:judge set?] [:merging set?]
                        ;; messages main holds to each branch's agent (seon.reconcile/branch-messages): a parked session's wake
                        [:msgs {:optional true} :map]]
 :seon.reconcile/step [:enum :ignored :done :dead-read :spawned :started :briefed :worked :tested :read :diffed :merged :octopus-merged :write-back :main-read :committed :commit-recorded :built :gate-read :gated]
 ;; a task as Datahike pulls it (the readers' input)
 :seon.task/pulled [:map [:seon.task/id :seon.task/id] [:seon.task/ns :seon.task/ns] [:seon.task/name :seon.task/name]
                    [:seon.task/plan :seon.task/plan] [:seon.task/execution [:enum :held :running :cancelled]]
                    [:seon.task/branch :seon.task/branch]]
 :seon.reconcile/done-input [:map {:closed true}
                             [:proofs :seon.task/proofs] [:results :seon.proof/results]
                             [:main-green [:set :qualified-symbol]] [:allowed-red [:set :qualified-symbol]]
                             ;; the tests red here that main was red on too, at the branch's merge base: main's, no stray red
                             [:main-red {:optional true} [:set :qualified-symbol]]
                             [:uncontracted [:set :qualified-symbol]] [:unmerged {:optional true} [:vector :string]]
                             ;; the derived problems the branch's work made true (seon.problems/caused)
                             [:caused {:optional true} [:set :string]]
                             ;; the keys main changed since the branch's merge base (the writer's :theirs)
                             [:behind {:optional true} pos-int?]
                             [:kind {:optional true} :seon.task/kind]
                             ;; a :design task's accumulated plan now and as its branch began (its merge base's)
                             [:plan {:optional true} :seon.task/plan] [:plan-before {:optional true} :seon.task/plan]
                             ;; the process tests the work left to root's gate (neither red nor unknown)
                             [:deferred {:optional true} [:set :qualified-symbol]]]
 :seon.reconcile/not-done [:map {:closed true}
                          [:reason [:enum :no-proofs :proof-red :proof-unknown :regression :stray-red :contract-gap :unmerged :no-design :open-problem :behind]]
                          [:symbol {:optional true} :qualified-symbol] [:key {:optional true} :string] [:behind {:optional true} pos-int?]]
 :seon.reconcile/action [:multi {:dispatch :op}
                         [:reap [:map {:closed true} [:op [:= :reap]] [:task :seon.task/id]]]
                         [:kill [:map {:closed true} [:op [:= :kill]] [:task :seon.task/id]
                                 [:reason [:enum :cancelled :held :env-changed]]]]
                         ;; an octopus merge: every ready merge task whose keys are disjoint merges in one commit
                         [:octopus-merge [:map {:closed true} [:op [:= :octopus-merge]] [:task :seon.task/id]
                                        [:members [:vector [:map {:closed true} [:task :seon.task/id]]]]]]
                         ;; a ready merge whose change reaches process tests: they run on a checkout of the
                         ;; merge candidate first (seon.fx/run-tests), and gate it like proofs
                         [:gate [:map {:closed true} [:op [:= :gate]] [:task :seon.task/id]
                                 [:tests [:vector :qualified-symbol]]]]
                         ;; a judged task whose execution is no longer running: closed
                         [:close [:map {:closed true} [:op [:= :close]] [:task :seon.task/id]]]
                         [:spawn [:map {:closed true} [:op [:= :spawn]] [:task :seon.task/id] [:env :seon.task/env]]]
                         ;; a parked session's next work on its live process (agent): no fork
                         [:wake [:map {:closed true} [:op [:= :wake]] [:task :seon.task/id] [:env :seon.task/env]
                                 [:agent :string]]]]
 :seon.reconcile/actions [:vector :seon.reconcile/action]
 ;; ---- the model ----
 ;; a conversation message: an assistant's may carry its eval calls, a tool message answers one by its id
 :seon.model/tool-call [:map [:id :string] [:code :string] [:prose {:optional true} :string]]
 :seon.model/message [:map [:role [:enum "system" "user" "assistant" "tool"]] [:content :string]
                      [:tool-calls {:optional true} [:vector :seon.model/tool-call]] [:tool-call-id {:optional true} :string]
                      [:reasoning {:optional true} :string]
                      ;; an assistant message's reply (its model call's number): the provider's format folds the consecutive assistant
                      ;; messages of one reply into one, the reply's text first then each call; none stands alone. Never sent
                      [:reply {:optional true} :int]]
 :seon.model/provider [:multi {:dispatch :kind}
                       [:none [:map [:kind [:= :none]]]]
                       [:scripted [:map [:kind [:= :scripted]] [:script :qualified-symbol]]]
                       [:openai-compat [:map [:kind [:= :openai-compat]] [:base-url :string] [:model :string]
                                        [:api-key-env :string]
                                        [:max-tokens pos-int?]
                                        ;; DeepSeek's thinking mode and effort; absent: the provider's default
                                        [:thinking {:optional true} [:enum :enabled :disabled]]
                                        [:reasoning-effort {:optional true} [:enum :low :medium :high]]
                                        ;; earlier reasoning sent back (:seon.config.ai/replay-reasoning)
                                        [:replay-reasoning {:optional true} :boolean]]]]
 :seon.model/request [:map {:closed true} [:messages [:vector :seon.model/message]] [:task :seon.task/id] [:turn :int]]
 ;; what a scripted model (a test fixture, seon.model's :scripted provider) answers: a reply as the
 ;; provider's reply is read (docs/prompt.md), its text and its eval calls; no :calls is a message
 :seon.model/script-reply [:map {:closed true} [:text {:optional true} :string] [:calls {:optional true} [:vector [:map {:closed true} [:prose :string] [:code :string]]]]]
 :seon.model/completion [:map [:text :string] [:prompt-tokens {:optional true} :int] [:completion-tokens {:optional true} :int] [:ms number?]
                         ;; the counts are the scripted model's own estimate (seon.print.select/estimate), not a provider's measure
                         [:estimated {:optional true} :boolean]
                         ;; the reply's calls of the one tool, eval, in order
                         [:tool-calls {:optional true} [:vector :seon.model/tool-call]]
                         [:truncated? {:optional true} :boolean]
                         ;; what the call cost beyond them, when the provider says (session D2)
                         [:reasoning-tokens {:optional true} :int] [:cache-hit-tokens {:optional true} :int] [:cache-miss-tokens {:optional true} :int]
                         ;; how the reply stopped (the provider's finish_reason), the model that made it, its reasoning
                         [:finish-reason {:optional true} :string] [:model {:optional true} :string] [:reasoning {:optional true} :string]]
 :seon.model/provider-error [:map [:seon.error/type [:= :seon.model/provider-error]]
                             [:seon.error/operation :qualified-symbol] [:seon.error/message :string]
                             [:status {:optional true} :int] [:body {:optional true} :string]]
 ;; ---- the turn loop's end, as the agent writes it on its branch ----
 :seon.turn/end [:map {:closed true}
                 [:outcome :seon.agent/outcome] [:turns {:optional true} :int] [:model-calls {:optional true} :int] [:tokens {:optional true} :int]
                 [:results :seon.proof/results] [:uncontracted [:set :qualified-symbol]]
                 [:reason {:optional true} :string] [:ms {:optional true} number?]]}