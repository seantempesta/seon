#:seon.config.fn.cost{:min-calls
                      [:int
                       {:min 1, :seon.config/optional true, :seon.config/dial true, :seon.config/default 20,
                        :description "Calls a definition must make in a world's work since its previous transaction before that work's per-call means are stored on its cost entity (`:seon.fn.cost/entity`); fewer calls are noise."}]
                      :hysteresis
                      [:double
                       {:min 1.0, :seon.config/optional true, :seon.config/dial true, :seon.config/default 1.41,
                        :description "The factor a definition's per-call self time must move by, either way, before its stored cost entity is replaced (`seon.profile/moved?`): half a log2 bucket, so timing noise rewrites nothing."}]}
