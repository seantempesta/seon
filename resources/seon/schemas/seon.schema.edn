;; The named schemas of seon.schema.datahike (session D1) (Seon's :seon.db/ref, simplified) and its one error.
{:seon.db/ref [:or {:description "A Datahike reference: entity id, tempid, lookup ref, or nested entity map carrying :db/id."}
               :int :string [:tuple :keyword :any] [:map [:db/id :int]]]
 :seon.schema/declaration [:map {:description "A Datahike attribute map, as d/transact takes it."}
                            [:db/ident :keyword] [:db/valueType :keyword] [:db/cardinality :keyword]
                            [:db/unique {:optional true} :keyword] [:db/index {:optional true} :boolean]
                            [:db/isComponent {:optional true} :boolean] [:db/noHistory {:optional true} :boolean]]
 :seon.schema/reason [:enum :seon.schema.datahike/absent :seon.schema.datahike/cyclic
                       :seon.schema.datahike/nested-collection
                       :seon.schema.datahike/nilable :seon.schema.datahike/literal :seon.schema.datahike/enum :seon.schema.datahike/value-type-unavailable]
 ;; a schema an agent registers at its REPL (my.schema/register!; v1's seon.schema/register!)
 :seon.schema/key :qualified-keyword
 :seon.schema/definition :any
 ;; a registration of a stored attribute: its stored values on the branch, and how many the new
 ;; form refuses (v1's seon.db/registration-check)
 :seon.schema.usage/check [:map [:checked nat-int?] [:refused nat-int?]]
 :seon.schema/registration [:map {:description "A registered schema: its key and its form, and for a stored attribute how many stored values the form refuses."}
                             [:seon.schema/key :seon.schema/key] [:seon.schema/definition :seon.schema/definition]
                             [:seon.schema.usage/check {:optional true} :seon.schema.usage/check]
                             ;; the contracts reaching it that did not compile again against it (seon.program/rearm!)
                             [:seon.schema/rearm-errors {:optional true} [:vector :map]]]
 :seon.schema/refused-because [:enum {:description "Why a registration is refused: its form is no EDN data, does not compile against the population (a name resolving to nothing, or a key other schemas still name), or declares an attribute Datahike cannot store."}
                                :unreadable :invalid :unstorable]
 :seon.schema/registration-refused [:and :seon.error/base
                                     [:map [:seon.error/type [:enum :seon.schema/registration-refused]]
                                      [:seon.schema/key :seon.schema/key] [:seon.schema/refused-because :seon.schema/refused-because]]]
 ;; a key no schema registers, asked of my.schema/forms: the keys its namespace registers
 :seon.schema/unknown-key [:and :seon.error/base
                           [:map [:seon.error/type [:enum :seon.schema/unknown-key]] [:seon.schema/key :qualified-keyword]
                            [:seon.schema/registered [:vector :qualified-keyword]]]]
 :seon.schema/unstorable [:and :seon.error/base
                           [:map [:seon.error/type [:enum :seon.schema/unstorable]]
                            [:seon.schema/attribute :qualified-keyword] [:seon.schema/reason :seon.schema/reason]
                            [:seon.schema/form :any]]]}
