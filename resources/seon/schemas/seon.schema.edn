;; Co-located Malli schemas for `seon.schema` & `seon.schema.datahike`.
;; Stored `:seon.schema/*` entities hold plain Clojure forms natively via `:db.type/data`!
{:seon.schema/key
 [:and {:seon.db/identity true
        :seon.db/content-id true
        :description "Unique multi-segment qualified keyword naming a Malli schema."}
  :qualified-keyword]

 :seon.schema/form
 [:any {:seon.db/storable true
        :description "Malli schema form stored natively as plain Clojure data (:db.type/data)."
        :gen/elements [:int :string [:vector :keyword] [:double {:min 0.0}]]}]

 :seon.schema/doc
 [:string {:description "Human & agent documentation for this schema."}]

 :seon.schema/examples
 [:vector {:description "Explicit valid example values when custom host predicates have no built-in generator."}
  [:int {:min 0 :max 100}]]

 :seon.schema/render
 [:qualified-symbol {:description "Optional Hiccup component symbol `ns/fn` for rendering values of this schema."}]

 :seon.schema/entity
 [:map {:seon.db/attributes true
        :seon.render/hiccup seon.render.ui/schema-tile
        :description "First-class Malli schema entity stored in Datahike."}
  [:seon.schema/key :seon.schema/key]
  [:seon.schema/form :seon.schema/form]
  [:seon.schema/doc {:optional true} :seon.schema/doc]
  [:seon.schema/examples {:optional true} :seon.schema/examples]
  [:seon.schema/render {:optional true} :seon.schema/render]]

 :seon.schema/declaration
 [:map {:description "Derived Datahike attribute map."}
  [:db/ident :qualified-keyword]
  [:db/valueType :keyword]
  [:db/cardinality :keyword]
  [:db/unique {:optional true} :keyword]
  [:db/index {:optional true} :boolean]
  [:db/isComponent {:optional true} :boolean]
  [:db/noHistory {:optional true} :boolean]
  [:db/contentId {:optional true} :boolean]]}
