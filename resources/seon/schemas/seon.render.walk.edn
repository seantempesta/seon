#:seon.render.walk{:attribute :qualified-keyword,
                   :back-reference? :boolean,
                   :branch :seon.render.walk/path,
                   :connection
                   [:map
                    [:seon.render.walk/attribute
                     :seon.render.walk/attribute]
                    [:seon.render.walk/target
                     {:optional true}
                     :seon.render.walk/target]
                    [:seon.render.walk/lookup
                     {:optional true}
                     :seon.render.walk/lookup]
                    [:seon.error/value
                     {:optional true}
                     :seon.error/value]],
                   :found-depth [:int {:min 0}],
                   :lookup
                   [:any
                    {:seon.schema.admission/exemption
                     :seon.schema.admission/polymorphic-boundary
                     :seon.schema.admission/reason
                     "A walk lookup names an entity by any identity: an eid, a keyword/string/uuid identity value, or a [attribute value] lookup-ref tuple."
                     :gen/elements [1 :k "id" [:seon.db/id 1]]}],
                   :path [:vector [:or :keyword :int]],
                   :acquisition-request
                   [:map
                    [:seon.db/db :seon.db/database-value]
                    [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.sci.admit/caps :seon.sci.admit/caps]
                    [:seon.render/distance
                     {:optional true}
                     :seon.render/distance]],
                   :request
                   [:map
                    [:seon.db/db :seon.db/database-value]
                    [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                    [:seon.db/connection
                     {:optional true}
                     :seon.db/connection]
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.render/output
                     [:enum :seon.render/ai :seon.render/html
                      :seon.render/form]]
                    [:seon.sci.admit/caps :seon.sci.admit/caps]
                    [:seon.sci.eval/time-limit-ms
                     :seon.sci.eval/time-limit-ms]
                    [:seon.config/on-core-error
                     :seon.config/on-core-error]
                    [:seon.render/distance
                     {:optional true}
                     :seon.render/distance]],
                   :history-request
                   [:map
                    [:seon.db/db :seon.db/database-value]
                    [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                    [:seon.db/connection
                     {:optional true}
                     :seon.db/connection]
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.sci.admit/caps :seon.sci.admit/caps]
                    [:seon.sci.eval/time-limit-ms
                     :seon.sci.eval/time-limit-ms]
                    [:seon.config/on-core-error
                     :seon.config/on-core-error]
                    [:seon.render/distance
                     {:optional true}
                     :seon.render/distance]],
                   :target :int,
                   :unit
                   [:map
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.render/distance :seon.render/distance]
                    [:seon.render.walk/path :seon.render.walk/path]
                    [:seon.render.walk/found-depth
                     :seon.render.walk/found-depth]
                    [:seon.render.walk/attribute
                     {:optional true}
                     :seon.render.walk/attribute]
                    [:seon.render.walk/branch
                     {:optional true}
                     :seon.render.walk/branch]
                    [:seon.render/output
                     {:optional true}
                     :seon.render/rendered]
                    [:seon.error/value
                     {:optional true}
                     :seon.error/value]
                    [:seon.db/tx-data
                     {:optional true}
                     :seon.db/tx-data]],
                   :units [:vector :seon.render.walk/unit],
                   :elided [:= true]
                   :elided-error [:map {:seon.error/class true :seon.render/ai seon.error/elision-prose :seon.render/html seon.error/elision-html :error/message "must mark a bounded render walk that elided additional content"} [:seon.render.walk/elided :seon.render.walk/elided] [:seon.error/message :seon.error/message]]
                   :no-such-entity [:= true]
                   :no-such-entity-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a render walk whose requested entity does not exist"} [:seon.render.walk/no-such-entity :seon.render.walk/no-such-entity] [:seon.error/message :seon.error/message]]
                   :connections-failed [:= true]
                   :connections-failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a render walk whose connection discovery failed"} [:seon.render.walk/connections-failed :seon.render.walk/connections-failed] [:seon.error/message :seon.error/message]]}
