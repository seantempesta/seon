#:seon.render.walk{:attribute :qualified-keyword,
                   :back-reference? :boolean,
                   :branch :seon.render.walk/path,
                   :connection
                   [:map
                    [:seon.render.walk/attribute
                     :seon.render.walk/attribute]
                    [:seon.render.walk/target
                     {:optional true}
                     :seon.render.walk/target]
                    [:seon.render.walk/lookup
                     {:optional true}
                     :seon.render.walk/lookup]
                    [:seon.error/value
                     {:optional true}
                     [:or :seon.render.walk/elided-error :seon.render.walk/no-such-entity-error :seon.render/error-result :seon.db/error-result]]],
                   :found-depth [:int {:min 0}],
                   :lookup
                   [:or :seon.render.walk/entity-lookup
                    [:tuple :seon.render.walk/entity-lookup :qualified-keyword]],
                   :entity-lookup
                   [:or :int :keyword :string :uuid
                    [:tuple :qualified-keyword :seon.schema/value]],
                   :path [:vector [:or :keyword :int]],
                   :acquisition-request
                   [:map
                    [:seon.db/db :seon.db/database-value]
                    [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.sci.admit/caps :seon.sci.admit/caps]
                    [:seon.render/distance
                     {:optional true}
                     :seon.render/distance]],
                   :request
                   [:map
                    [:seon.db/db :seon.db/database-value]
                    [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                    [:seon.db/connection
                     {:optional true}
                     :seon.render.walk/read-connection]
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.render/output
                     [:enum :seon.render/ai :seon.render/html
                      :seon.render/form]]
                    [:seon.sci.admit/caps :seon.sci.admit/caps]
                    [:seon.sci.eval/time-limit-ms
                     :seon.sci.eval/time-limit-ms]
                    [:seon.render/distance
                     {:optional true}
                     :seon.render/distance]],
                   :history-request
                   [:map
                    [:seon.db/db :seon.db/database-value]
                    [:seon.sci.eval/ctx :seon.sci.eval/ctx]
                    [:seon.db/connection
                     {:optional true}
                     :seon.render.walk/read-connection]
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.sci.admit/caps :seon.sci.admit/caps]
                    [:seon.sci.eval/time-limit-ms
                     :seon.sci.eval/time-limit-ms]
                    [:seon.render/distance
                     {:optional true}
                     :seon.render/distance]],
                   :target :int,
                   :unit
                   [:map
                    [:seon.render.walk/lookup :seon.render.walk/lookup]
                    [:seon.render/distance :seon.render/distance]
                    [:seon.render.walk/path :seon.render.walk/path]
                    [:seon.render.walk/found-depth
                     :seon.render.walk/found-depth]
                    [:seon.render.walk/attribute
                     {:optional true}
                     :seon.render.walk/attribute]
                    [:seon.render.walk/branch
                     {:optional true}
                     :seon.render.walk/branch]
                    [:seon.render/output
                     {:optional true}
                     :seon.render/rendered]
                    [:seon.error/value
                     {:optional true}
                     [:or :seon.render.walk/elided-error :seon.render.walk/no-such-entity-error :seon.render/error-result :seon.db/error-result]]
                    [:seon.db/tx-data
                     {:optional true}
                     :seon.db/tx-data]],
                   :units [:vector :seon.render.walk/unit],

                   :elided-error [:and :seon.error/base [:map {:seon.db/attributes true :seon.render/ai seon.error/elision-prose :seon.render/html seon.error/elision-html}
 [:seon.print/bound-by :qualified-keyword]
 [:seon.render.walk/limit :seon.render.walk/limit]
 [:seon.render.walk/continuation-subject :seon.render.walk/continuation-subject]]]

                   :no-such-entity-error [:and :seon.error/base [:map {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html} [:seon.render.walk/missing-lookup :seon.render.walk/missing-lookup]]]

 ; Additive error declaration manifest, 2026-09-18.

 :seon.render.walk/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.render.walk/error-subject :seon.render.walk/error-subject]
  [:seon.render.walk/step-observation
   :seon.render.walk/step-observation]]]

 :seon.render.walk/error-subject
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :seon.render.walk/step-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :missing-lookup :seon.render.walk/lookup

 :limit [:int {:min 0}]

 :continuation-subject :seon.render.walk/lookup

 ; A cut's continuation over the walk's nodes (one-render-path design §3g):
 ; a node designator, the cut's path and absolute offset, the caller's custody.
 :seon.render.walk/continuation-node [:or :qualified-symbol [:tuple [:= :seon.blob/digest] :seon.blob/digest] :seon.render.walk/lookup]
 :seon.render.walk/continuation-reason [:enum :stale :gone :unavailable :malformed]
 :seon.render.walk/continue-request
 [:map
  [:seon.render.walk/continuation-node :seon.render.walk/continuation-node]
  [:seon.render.data/cursor :seon.render.data/cursor]
  [:seon.db/db {:optional true} :seon.db/db]
  [:seon.db/connection {:optional true} :seon.render.walk/read-connection]
  [:seon.sci.eval/ctx {:optional true} :seon.render.walk/read-ctx]]
 :seon.render.walk/read-connection
 [:and {:description "A render's connection: a render reads, so an absent one is never supplied from the calling evaluation's world (its absence keeps the render read-only)."}
  :seon.db/connection]
 :seon.render.walk/read-ctx
 [:and {:description "A continued render's context: absent, the continuation renders without evaluating, and it is never supplied from the calling evaluation's world."}
  :seon.sci.eval/ctx]
 :seon.render.walk/continuation-error
 [:and :seon.error/base
  [:map {:seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
   [:seon.render.walk/continuation-reason :seon.render.walk/continuation-reason]
   [:seon.render.walk/continuation-node :seon.render.walk/continuation-node]]]

 ; The linked graph (task-context S1): structure per projection, levels, nodes, edges, order and cuts.
 :seon.render.walk/ref-attributes [:vector :qualified-keyword]
 :seon.render.walk/value-attributes [:vector [:tuple :qualified-keyword :qualified-keyword]]
 :seon.render.walk/identity-owners [:map-of :qualified-keyword :qualified-keyword]
 :seon.render.walk/component-owners [:map-of :qualified-keyword :qualified-keyword]
 :seon.render.walk/rendered-schemas [:set :qualified-keyword]
 :seon.render.walk/required-attributes [:map-of :qualified-keyword [:set :qualified-keyword]]
 :seon.render.walk/attachments [:map-of {:description "Per owning schema, the reverse attributes (`:ns/_name`) its `:seon.render/units` declares: the reverse edges the forward walk follows."} :qualified-keyword [:set :qualified-keyword]]
 :seon.render.walk/forward-only? [:boolean {:description "Follow forward refs plus declared attachments only, not every ref and value edge both ways."}]
 :seon.render.walk/structure [:map [:seon.render.walk/ref-attributes :seon.render.walk/ref-attributes] [:seon.render.walk/value-attributes :seon.render.walk/value-attributes] [:seon.render.walk/identity-owners :seon.render.walk/identity-owners] [:seon.render.walk/component-owners :seon.render.walk/component-owners] [:seon.render.walk/rendered-schemas :seon.render.walk/rendered-schemas] [:seon.render.walk/required-attributes :seon.render.walk/required-attributes] [:seon.render.walk/attachments :seon.render.walk/attachments]]
 :seon.render.walk/edge [:tuple :int :qualified-keyword :int]
 :seon.render.walk/edges [:vector :seon.render.walk/edge]
 :seon.render.walk/owning-schemas [:map-of :int [:maybe :qualified-keyword]]
 :seon.render.walk/level-result [:map [:seon.render.walk/edges :seon.render.walk/edges] [:seon.render.walk/owning-schemas :seon.render.walk/owning-schemas]]
 :seon.render.walk/node-level [:int {:min 0}]
 :seon.render.walk/node-schema [:maybe :qualified-keyword]
 :seon.render.walk/node [:map [:seon.render.walk/node-level :seon.render.walk/node-level] [:seon.render.walk/node-schema :seon.render.walk/node-schema] [:seon.render.walk/attribute {:optional true} :seon.render.walk/attribute] [:seon.render/value {:optional true} [:maybe :map]]]
 :seon.render.walk/nodes [:map-of :int :seon.render.walk/node]
 :seon.render.walk/graph-root :int
 :seon.render.walk/graph-order [:vector :int]
 :seon.render.walk/back-references [:vector [:tuple :int :int]]
 :seon.render.walk/skipped [:map-of :qualified-keyword [:or :int [:set :int]]]
 :seon.render.walk/cut-bound :qualified-keyword
 :seon.render.walk/cut-count [:int {:min 0}]
 :seon.render.walk/cut-source :int
 :seon.render.walk/cut [:map [:seon.render.walk/cut-bound :seon.render.walk/cut-bound] [:seon.render.walk/node-level :seon.render.walk/node-level] [:seon.render.walk/cut-count :seon.render.walk/cut-count] [:seon.render.walk/cut-source {:optional true} :seon.render.walk/cut-source] [:seon.render.walk/attribute {:optional true} :seon.render.walk/attribute] [:seon.error/value {:optional true} :seon.db/invalid-read-error]]
 :seon.render.walk/cuts [:vector :seon.render.walk/cut]
 :seon.render.walk/graph [:map [:seon.render.walk/graph-root :seon.render.walk/graph-root] [:seon.render.walk/nodes :seon.render.walk/nodes] [:seon.render.walk/edges :seon.render.walk/edges] [:seon.render.walk/skipped :seon.render.walk/skipped] [:seon.render.walk/graph-order {:optional true} :seon.render.walk/graph-order] [:seon.render.walk/back-references {:optional true} :seon.render.walk/back-references] [:seon.render.walk/cuts {:optional true} :seon.render.walk/cuts]]
 :seon.render.walk/graph-request [:map [:seon.db/db :seon.db/database-value] [:seon.render.walk/lookup :seon.render.walk/lookup] [:seon.sci.admit/caps :seon.sci.admit/caps] [:seon.render/distance {:optional true} :seon.render/distance] [:seon.render.walk/forward-only? {:optional true} :seon.render.walk/forward-only?]]
}
