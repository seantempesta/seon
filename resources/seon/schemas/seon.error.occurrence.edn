#:seon.error.occurrence
{:id [:string {:min 12 :max 12 :seon.db/identity true :seon.program/row-schema :seon.error.occurrence/occurrence}]
 :count [:int {:min 1 :seon.db/no-history? true}]
 :first-at :inst
 :last-at [:and {:seon.db/no-history? true} :inst]
 :process :seon.db/ref
 :agent :seon.db/ref
 :turn :seon.db/ref
 :evaluation [:and {:seon.db/index true :seon.db/reference-to :seon.cluster.eval/id
                    :description "The evaluation that was running, by its id (seon.id/evaluation of turn and ordinal): a failing evaluation settles after its fault, so the reference joins at read time."}
              :seon.cluster.eval/id]
 :task [:and {:seon.db/index true :seon.db/reference-to :seon.task/id
              :description "The task the failing world was working on, by its handle."}
        :seon.task/handle]
 :slot [:int {:min 0 :description "Which of a signature's bounded occurrences per producer digest this is: part of the occurrence identity, never stored."}]
 :slots [:vector {:min 1 :description "The occurrence identities a recording may land on, in order (seon.error/recording); the writer takes the first not yet written, else bumps the last."}
         :seon.error.occurrence/id]
 :message :string
 ; the world by reference (lost-error seams §0.4): the failing request's effect, the occurrence it follows
 :effect :seon.db/ref
 :related :seon.db/ref
 ; the branch where the error happened; a core fault's cluster-branch copy names its origin
 :branch :seon.store/branch
 :occurrence
 [:map {:seon.db/attributes true :seon.program/partition :seon.cluster}
  [:seon.error.occurrence/id :seon.error.occurrence/id]
  [:seon.error.occurrence/count {:seon.cluster/conflict :add} :seon.error.occurrence/count]
  [:seon.error.occurrence/first-at :seon.error.occurrence/first-at]
  [:seon.error.occurrence/last-at :seon.error.occurrence/last-at]
  [:seon.error.occurrence/process :seon.error.occurrence/process]
  [:seon.error.occurrence/agent {:optional true} :seon.error.occurrence/agent]
  [:seon.error.occurrence/turn {:optional true} :seon.error.occurrence/turn]
  [:seon.error.occurrence/evaluation {:optional true} :seon.error.occurrence/evaluation]
  [:seon.error.occurrence/task {:optional true} :seon.error.occurrence/task]
  [:seon.error.occurrence/message :seon.error.occurrence/message]
  [:seon.error.occurrence/branch {:optional true} :seon.error.occurrence/branch]
  [:seon.error.occurrence/effect {:optional true} :seon.error.occurrence/effect]
  [:seon.error.occurrence/related {:optional true} :seon.error.occurrence/related]
  [:seon.error/process :seon.error/process]
  [:seon.instrument/fn {:optional true} :seon.instrument/fn]
  [:seon.error/proc {:optional true} :seon.error/proc]
  [:seon.error/op {:optional true} :seon.error/op]
  [:seon.error/cid {:optional true} :seon.error/cid]
  [:seon.error/throwable-class {:optional true} :seon.error/throwable-class]
  [:seon.error/shown {:optional true} :seon.error/shown]
  [:seon.error/shown-blob {:optional true} :seon.error/shown-blob]
  [:seon.error/shown-size {:optional true} :seon.error/shown-size]
  [:seon.error/data-edn :seon.error/data-edn]
  [:seon.error/data-size {:optional true} :seon.error/data-size]
  [:seon.error/capped? :seon.error/capped?]
  [:seon.instrument/arm {:optional true} :seon.instrument/arm]
  [:seon.instrument/expected {:optional true} :seon.instrument/expected]
  [:seon.instrument/args {:optional true} :seon.instrument/args]
  [:seon.instrument/actual {:optional true} :seon.instrument/actual]
  [:seon.instrument/actual-size {:optional true} :seon.instrument/actual-size]]
}
