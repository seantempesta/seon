{:seon.test.selection/request
 [:map
  [:seon.db/db :seon.db/database-value]
  [:seon.test/changed {:optional true} :seon.test/changed]
  [:seon.test.run/cluster {:optional true} :seon.test.run/cluster]
  [:seon.test.run/provenance {:optional true} :seon.test.run/provenance]
  [:seon.test.run/input-digest {:optional true} :seon.test.run/input-digest]
  [:seon.test.selection/input-evidence {:optional true} :seon.test.selection/input-evidence]
  [:seon.test.run/members {:optional true} [:vector :seon.test.member/member]]
  [:seon.test/namespaces {:optional true} [:set :symbol]]
  [:seon.test/identities {:optional true} [:set :qualified-symbol]]
  [:seon.test.run/change-basis-t {:optional true} :seon.db/basis-t]
  [:seon.test.run/policy {:optional true} :seon.test.run/policy]
  [:seon.test/include-long? {:optional true} :boolean]]
 :seon.test.selection/input-digest
 [:or :seon.source/digest [:= :seon.error/absent]]
 :seon.test.selection/input-difference
 [:map
  [:seon.test.selection/input-path [:string {:min 1}]]
  [:seon.test.selection/published-input-digest :seon.test.selection/input-digest]
  [:seon.test.selection/requested-input-digest :seon.test.selection/input-digest]]
 :seon.test.selection/input-differences [:vector :seon.test.selection/input-difference]
 :seon.test.selection/input-evidence
 [:map
  [:seon.test.selection/published-inputs [:map-of :string :seon.source/digest]]
  [:seon.test.selection/requested-inputs [:map-of :string :seon.source/digest]]]
 :seon.test.selection/widening [:enum :missing-basis :removed-file :outside-program-graph]
 :seon.test.selection/reused
 [:and :seon.test/result
  [:map
   [:seon.test/unchanged [:= true]]
   [:seon.test.run/basis-t :seon.test.run/basis-t]
   [:seon.test.run/program-digest :seon.test.run/program-digest]
   [:seon.test.run/input-digest :seon.test.run/input-digest]]]
 :seon.test.selection/unchanged [:vector :seon.test.selection/reused]
 :seon.test.selection/disposition
 [:enum {:description "Finite execution decisions recorded for excluded members; these describe the request decision, not an entity kind."}
  :long :destructive :deferred]
 :seon.test.selection/exclusion
 [:map {:seon.db/attributes true}
  [:seon.test.member/symbol :seon.test.member/symbol]
  [:seon.test.selection/disposition :seon.test.selection/disposition]]
 :seon.test.selection/result
 [:map
  [:seon.test.selection/unchanged {:optional true} :seon.test.selection/unchanged]
  [:seon.test/long-excluded {:optional true} :seon.test/long-excluded]
  [:seon.test.selection/widenings {:optional true} [:vector :seon.test.selection/widening]]
  [:seon.test.selection/removed {:optional true} [:vector :string]]
  [:seon.test.run/basis-t :seon.test.run/basis-t]
  [:seon.test.run/change-basis-t {:optional true} :seon.test.run/change-basis-t]
  [:seon.test.run/cluster {:optional true} :seon.test.run/cluster]
  [:seon.test.run/policy :seon.test.run/policy]
  [:seon.test.run/include-long? :seon.test.run/include-long?]
  [:seon.test.run/input-digest :seon.test.run/input-digest]
  [:seon.test.run/namespaces {:optional true} :seon.test.run/namespaces]
  [:seon.test.run/identities {:optional true} :seon.test.run/identities]
  [:seon.test.run/members
   [:vector [:map [:seon.test/sym :seon.test/sym]
             [:seon.test.member/reasons :seon.test.member/reasons]]]]]}
