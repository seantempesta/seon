#:seon.flow{:active-evals
            [:fn
             #:gen{:gen seon.flow/atom-reference-generator}
             seon.flow/atom-reference?],
            :active-work
            [:fn
             #:gen{:gen seon.flow/atom-reference-generator}
             seon.flow/atom-reference?],
            :admitted? :boolean,
            :attempt [:int {:min 0}],
            :buffer-capacity [:int {:min 1}],
            :callback-result
            [:or
             :nil
             :map
             [:vector :seon.schema/value]
             [:set :seon.schema/value]
             [:sequential :seon.schema/value]
             :string
             :keyword
             :symbol
             :boolean
             :int
             :double
             :uuid
             :inst],
            :capacity-observer-request
            [:map
             [:seon.flow/parallelism :seon.flow/parallelism]
             [:seon.flow/active-work :seon.flow/active-work]],
            :changed-namespace :symbol,
            :changed-namespace-request
            [:map
             [:seon.flow/changed-namespace
              :seon.flow/changed-namespace]
             [:seon.flow/changed-source :seon.flow/changed-source]],
            :changed-source :string,
            :channel
            [:fn
             #:gen{:gen seon.flow/channel-generator}
             seon.flow/channel?],
            :commit-drop!
            [:=>
             [:cat :seon.flow/core-fault]
             :seon.flow/callback-result],
            :commit-fault!
            [:=>
             [:cat :seon.flow/core-fault]
             :seon.flow/callback-result],
            :compile-namespace-fn
            [:=>
             [:cat :seon.flow/changed-namespace-request]
             :seon.store/transaction-operation],
            :completion :seon.flow/channel,
            :compute-timeout-ms [:int {:min 1}],
            :core-fault :map,
            :deliver!
            [:=>
             [:cat :seon.sci.admit/value]
             :seon.flow/callback-result],
            :error-fanout
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/fault-graph :seon.flow/graph]
             [:seon.flow/application-report-channel :seon.flow/channel]
             [:seon.flow/monitor-report-channel :seon.flow/channel]
             [:seon.flow/monitor-error-channel :seon.flow/channel]
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/completion :seon.flow/channel]],
            :error-fanout-request
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/started
              [:map
               [:report-chan :seon.flow/channel]
               [:error-chan :seon.flow/channel]]]
             [:seon.flow/fault-buffer-capacity
              :seon.flow/buffer-capacity]
             [:seon.flow/monitor-buffer-capacity
              :seon.flow/buffer-capacity]
             [:seon.flow/read-core-error-mode
              :seon.flow/read-core-error-mode]
             [:seon.flow/commit-fault! :seon.flow/commit-fault!]
             [:seon.flow/commit-drop! :seon.flow/commit-drop!]
             [:seon.flow/panic! :seon.flow/panic!]],
            :escalated? :boolean,
            :escalation-request
            [:map
             [:seon.flow/turn-count :seon.flow/turn-count]
             [:seon.flow/failure-count :seon.flow/failure-count]
             [:seon.flow/max-turns :seon.flow/max-turns]
             [:seon.flow/max-failures :seon.flow/max-failures]],
            :eval-proc-request
            [:map
             [:seon.flow/parallelism :seon.flow/parallelism]
             [:seon.flow/active-evals :seon.flow/active-evals]
             [:seon.flow/compute-timeout-ms
              :seon.flow/compute-timeout-ms]],
            :executor
            [:fn
             #:gen{:gen seon.flow/executor-generator}
             seon.flow/executor?],
            :failure-count [:int {:min 0}],
            :fault-committer-proc-request
            [:map
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/completion :seon.flow/channel]
             [:seon.flow/read-core-error-mode
              :seon.flow/read-core-error-mode]
             [:seon.flow/commit-fault! :seon.flow/commit-fault!]
             [:seon.flow/panic! :seon.flow/panic!]],
            :fix-outcome
            [:enum
             :seon.flow/fix-succeeds
             :seon.flow/fix-fails
             :seon.flow/fix-breaks-other-namespace
             :seon.flow/no-response],
            :fix-step-fn [:=> [:cat :map] :seon.flow/fix-outcome],
            :future
            [:fn
             #:gen{:gen seon.flow/java-future-generator}
             seon.flow/java-future?],
            :graph
            [:fn
             #:gen{:gen seon.flow/graph-generator}
             seon.flow/graph?],
            :indexer-proc-request
            [:map
             [:seon.flow/compile-namespace-fn
              :seon.flow/compile-namespace-fn]
             [:seon.flow/compute-timeout-ms
              :seon.flow/compute-timeout-ms]],
            :join-error-request
            [:map
             [:seon.flow/started
              [:map [:error-chan :seon.flow/channel]]]
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/tag [:map-of :qualified-keyword :string]]],
            :launcher
            [:fn
             #:gen{:gen seon.flow/proc-launcher-generator}
             seon.flow/proc-launcher?],
            :launcher-configuration
            [:map
             [:seon.config.flow.compute/queue-depth
              :seon.config.flow.compute/queue-depth]
             [:seon.config.flow.compute/concurrency
              :seon.config.flow.compute/concurrency]],
            :lineage-status
            [:enum
             :seon.flow/iterating
             :seon.flow/escalated
             :seon.flow/done],
            :lineage-status-request
            [:map
             [:seon.flow/owner-count :seon.flow/owner-count]
             [:seon.flow/successful-owners
              :seon.flow/successful-owners]
             [:seon.flow/escalated? :seon.flow/escalated?]
             [:seon.flow/admitted? :seon.flow/admitted?]],
            :mailbox-request
            [:map [:seon.flow/deliver! :seon.flow/deliver!]],
            :max-failures [:int {:min 1}],
            :max-turns [:int {:min 1}],
            :namespace-owner-proc-request
            [:map [:seon.flow/fix-step-fn :seon.flow/fix-step-fn]],
            :owner-count [:int {:min 1}],
            :owner-ordinal [:int {:min 0}],
            :panic!
            [:=>
             [:cat :seon.flow/core-fault]
             :seon.flow/callback-result],
            :parallelism [:int {:min 1}],
            :plan-step-fn [:=> [:cat :map] :map],
            :planner-proc-request
            [:map [:seon.flow/plan-step-fn :seon.flow/plan-step-fn]],
            :read-core-error-mode
            [:=> [:cat] :seon.config/on-core-error],
            :read-sources [:=> [:cat] :seon.flow/sources],
            :seed :int,
            :seeded-outcome-request
            [:map
             [:seon.flow/seed :seon.flow/seed]
             [:seon.flow/owner-ordinal :seon.flow/owner-ordinal]
             [:seon.flow/attempt :seon.flow/attempt]],
            :source-enumerator-proc-request
            [:map [:seon.flow/read-sources :seon.flow/read-sources]],
            :sources [:map-of :symbol :string],
            :started
            [:map
             [:report-chan :seon.flow/channel]
             [:error-chan :seon.flow/channel]],
            :started! [:=> [:cat] :nil],
            :submission-id [:or :uuid :keyword :string],
            :submission-wait-ms [:int {:min 0}],
            :successful-owners [:set :keyword],
            :turn-count [:int {:min 0}],
            :work-call
            [:or
             [:map [:seon.flow/started! :seon.flow/started!]]
             [:map
              [:seon.flow/interrupt-fn :seon.sci.admit/interrupt-fn]]],
            :work-fn
            [:=> [:cat :seon.flow/work-call] :seon.sci.admit/value],
            :work-launcher
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/started :seon.flow/started]
             [:seon.flow/active-work :seon.flow/active-work]
             [:seon.flow/compute-executor :seon.flow/executor]
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]],
            :work-launcher-request
            [:map
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]],
            :work-result
            [:or
             [:map
              [:seon.flow/outcome [:= :seon.flow/time-limit]]
              [:seon.flow/submission-wait-ms
               :seon.flow/submission-wait-ms]]
             [:map
              [:seon.flow/outcome [:= :seon.flow/completed]]
              [:seon.flow/value :seon.sci.admit/value]
              [:seon.flow/submission-wait-ms
               :seon.flow/submission-wait-ms]]],
            :work-submission
            [:map
             [:seon.flow/submission-id :seon.flow/submission-id]
             [:seon.flow/workload :seon.flow/workload]
             [:seon.flow/work-fn :seon.flow/work-fn]
             [:seon.flow/time-limit-ms :seon.flow/compute-timeout-ms]],
            :workload [:enum :compute]}
