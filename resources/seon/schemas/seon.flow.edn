#:seon.flow{
            :active-work
            [:fn
             {:error/message
              "must be a process-local atom containing active Flow work state"
              :gen/gen seon.flow/atom-reference-generator}
             seon.flow/atom-reference?],
            :buffer-capacity [:int {:min 1}],
            :callback-result
            [:or
             :nil
             :map
             [:vector :seon.schema/value]
             [:set :seon.schema/value]
             [:sequential :seon.schema/value]
             :string
             :keyword
             :symbol
             :boolean
             :int
             :double
             :uuid
             :inst],
            :capacity-observer-request
            [:map
             [:seon.flow/parallelism :seon.flow/parallelism]
             [:seon.flow/active-work :seon.flow/active-work]],
            :channel
            [:fn
             {:error/message "must be a core.async channel"
              :gen/gen seon.flow/channel-generator}
             seon.flow/channel?],
            :commit-drop!
            [:=>
             [:cat :seon.flow/core-fault]
             :seon.flow/callback-result],
            :commit-fault!
            [:=>
             [:cat :seon.flow/core-fault]
             :seon.flow/callback-result],
            :completion :seon.flow/channel,
            :compute-timeout-ms [:int {:min 1}],
            :core-fault :map,
            :error-fanout
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/fault-graph :seon.flow/graph]
             [:seon.flow/application-report-channel :seon.flow/channel]
             [:seon.flow/monitor-report-channel :seon.flow/channel]
             [:seon.flow/monitor-error-channel :seon.flow/channel]
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/completion :seon.flow/channel]],
            :error-fanout-request
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/started
              [:map
               [:report-chan :seon.flow/channel]
               [:error-chan :seon.flow/channel]]]
             [:seon.flow/fault-buffer-capacity
              :seon.flow/buffer-capacity]
             [:seon.flow/monitor-buffer-capacity
              :seon.flow/buffer-capacity]
             [:seon.flow/read-core-error-mode
              :seon.flow/read-core-error-mode]
             [:seon.flow/commit-fault! :seon.flow/commit-fault!]
             [:seon.flow/commit-drop! :seon.flow/commit-drop!]
             [:seon.flow/panic! :seon.flow/panic!]
             [:seon.env/environment :seon.env/environment]],
            :executor
            [:fn
             {:error/message "must be a java.util.concurrent Executor"
              :gen/gen seon.flow/executor-generator}
             seon.flow/executor?],
            :fault-committer-proc-request
            [:map
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/completion :seon.flow/channel]
             [:seon.flow/read-core-error-mode
              :seon.flow/read-core-error-mode]
             [:seon.flow/commit-fault! :seon.flow/commit-fault!]
             [:seon.flow/panic! :seon.flow/panic!]],
            :future
            [:fn
             {:error/message "must be a java.util.concurrent Future"
              :gen/gen seon.flow/java-future-generator}
             seon.flow/java-future?],
            :graph
            [:fn
             {:error/message "must be a core.async Flow graph"
              :gen/gen seon.flow/graph-generator}
             seon.flow/graph?],
            :join-error-request
            [:map
             [:seon.flow/started
              [:map [:error-chan :seon.flow/channel]]]
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/tag [:map-of :qualified-keyword :string]]],
            :launcher
            [:fn
             {:error/message "must implement core.async Flow ProcLauncher"
              :gen/gen seon.flow/proc-launcher-generator}
             seon.flow/proc-launcher?],
            :launcher-configuration
            [:map
             [:seon.config.flow.compute/queue-depth
              :seon.config.flow.compute/queue-depth]
             [:seon.config.flow.compute/concurrency
              :seon.config.flow.compute/concurrency]
             [:seon.config.flow.io/queue-depth
              :seon.config.flow.io/queue-depth]
             [:seon.config.flow.io/concurrency
              :seon.config.flow.io/concurrency]],
            :panic!
            [:=>
             [:cat :seon.flow/core-fault]
             :seon.flow/callback-result],
            :parallelism [:int {:min 1}],
            :read-core-error-mode
            [:=> [:cat] :seon.config/on-core-error],
            :started
            [:map
             [:report-chan :seon.flow/channel]
             [:error-chan :seon.flow/channel]],
            :started! [:=> [:cat] :nil],
            :step-var
            [:fn
             {:error/message
              "must be a Var so a running graph hot reloads its step"
              :gen/gen seon.flow/step-var-generator}
             seon.flow/step-var?],
            :submission-id [:or :uuid :keyword :string],
            :submission-wait-ms [:int {:min 0}],
            :io-complete! [:=> [:cat :map] :seon.flow/callback-result],
            :io-submission
            [:map
             [:seon.flow/submission-id :seon.flow/submission-id]
             [:seon.flow/workload [:= :io]]
             [:seon.flow/work-fn :seon.flow/work-fn]
             [:seon.flow/complete! :seon.flow/io-complete!]
             [:seon.env/environment :seon.env/environment]],
            :work-call
            [:or
             [:map [:seon.flow/started! :seon.flow/started!]]
             [:map
              [:seon.flow/interrupt-fn :seon.sci.admit/interrupt-fn]]],
            :work-fn
            [:=> [:cat :seon.flow/work-call] :seon.sci.admit/value],
            :work-launcher
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/started :seon.flow/started]
             [:seon.flow/active-work :seon.flow/active-work]
             [:seon.flow/compute-executor :seon.flow/executor]
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]],
            :work-launcher-request
            [:map
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]
             [:seon.env/environment :seon.env/environment]],
            :work-result
            [:or
             [:map
              [:seon.flow/outcome [:= :seon.flow/time-limit]]
              [:seon.flow/submission-wait-ms
               :seon.flow/submission-wait-ms]]
             [:map
              [:seon.flow/outcome [:= :seon.flow/completed]]
              [:seon.flow/value :seon.sci.admit/value]
              [:seon.flow/submission-wait-ms
               :seon.flow/submission-wait-ms]]],
            :work-submission
            [:map
             [:seon.flow/submission-id :seon.flow/submission-id]
             [:seon.flow/workload :seon.flow/workload]
             [:seon.flow/work-fn :seon.flow/work-fn]
             [:seon.flow/time-limit-ms :seon.flow/compute-timeout-ms]
             [:seon.env/environment :seon.env/environment]],
            :workload [:enum :compute :io],
            :proc-id :keyword,
            :submission-capacity :seon.flow/proc-id
            :submission-capacity-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the proc whose submission capacity was exhausted"} [:seon.flow/submission-capacity :seon.flow/submission-capacity] [:seon.error/message :seon.error/message]]
            :launcher-stopped :seon.flow/proc-id
            :launcher-stopped-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the proc whose launcher has stopped"} [:seon.flow/launcher-stopped :seon.flow/launcher-stopped] [:seon.error/message :seon.error/message]]
            :time-limit :seon.flow/proc-id
            :time-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the proc whose compute time limit was reached"} [:seon.flow/time-limit :seon.flow/time-limit] [:seon.error/message :seon.error/message]]
            :configuration [:= true]
            :configuration-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark an invalid flow configuration"} [:seon.flow/configuration :seon.flow/configuration] [:seon.error/message :seon.error/message]]
            :timeout :seon.flow/proc-id
            :timeout-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the proc whose observable completion timed out"} [:seon.flow/timeout :seon.flow/timeout] [:seon.error/message :seon.error/message]]}
