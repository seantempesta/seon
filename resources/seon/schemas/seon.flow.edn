#:seon.flow{
            :active-work
            [:fn
             {:error/message
              "must be a process-local atom containing active Flow work state"
              :gen/gen seon.flow/atom-reference-generator}
             seon.flow/atom-reference?],
            :buffer-capacity [:int {:min 1}],
            :callback-result
            [:or
             :nil
             :map
             [:vector :seon.schema/value]
             [:set :seon.schema/value]
             [:sequential :seon.schema/value]
             :string
             :keyword
             :symbol
             :boolean
             :int
             :double
             :uuid
             :inst],
            :capacity-observer-request
            [:map
             [:seon.flow/parallelism :seon.flow/parallelism]
             [:seon.flow/active-work :seon.flow/active-work]],
            :channel
            [:fn
             {:error/message "must be a core.async channel"
              :gen/gen seon.flow/channel-generator}
             seon.flow/channel?],
            :commit-drop!
            [:=>
             [:cat :seon.error/recording-observation]
             :seon.flow/callback-result],
            :commit-fault!
            [:=>
             [:cat :seon.error/recording-observation]
             :seon.flow/callback-result],
            :compute-timeout-ms [:int {:min 1}],
            :core-fault :map,
            :error-fanout
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/fault-graph :seon.flow/graph]
             [:seon.flow/application-report-channel :seon.flow/channel]
             [:seon.flow/monitor-report-channel :seon.flow/channel]
             [:seon.flow/monitor-error-channel :seon.flow/channel]
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/executor {:optional true} :seon.flow/executor]],
            :error-fanout-request
            [:map
             [:seon.flow/committer-step {:optional true} :seon.flow/step-var]
             [:seon.flow/report-loss {:optional true} :seon.flow/step-var]
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/started
              [:map
               [:report-chan :seon.flow/channel]
               [:error-chan :seon.flow/channel]]]
             [:seon.flow/fault-buffer-capacity
              :seon.flow/buffer-capacity]
             [:seon.flow/monitor-buffer-capacity
              :seon.flow/buffer-capacity]
             [:seon.flow/projection
              {:optional true}
              :seon.schema/projection]
             [:seon.flow/read-core-error-mode
              :seon.flow/read-core-error-mode]
             [:seon.flow/commit-fault! :seon.flow/commit-fault!]
             [:seon.flow/commit-drop! :seon.flow/commit-drop!]
             [:seon.flow/panic! :seon.flow/panic!]
             [:seon.env/environment :seon.env/environment]],
            :executor
            [:fn
             {:error/message "must be a java.util.concurrent Executor"
              :gen/gen seon.flow/executor-generator}
             seon.flow/executor?],
            :fault-committer-proc-request
            [:map
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/projection :seon.schema/projection]
             [:seon.flow/read-core-error-mode
              :seon.flow/read-core-error-mode]
             [:seon.flow/commit-fault! :seon.flow/commit-fault!]
             [:seon.flow/commit-drop! :seon.flow/commit-drop!]
             [:seon.flow/panic! :seon.flow/panic!]],
            :future
            [:fn
             {:error/message "must be a java.util.concurrent Future"
              :gen/gen seon.flow/java-future-generator}
             seon.flow/java-future?],
            :graph
            [:fn
             {:error/message "must be a core.async Flow graph"
              :gen/gen seon.flow/graph-generator}
             seon.flow/graph?],
            :join!
            [:fn
             {:error/message "must be a callable Flow graph join"
              :gen/schema [:=> [:cat :map] :map]}
             clojure.core/ifn?],
            :join-error-request
            [:map
             [:seon.flow/started
              [:map [:error-chan :seon.flow/channel]]]
             [:seon.flow/fault-channel :seon.flow/channel]
             [:seon.flow/tag [:map-of :qualified-keyword :string]]],
            :launcher
            [:fn
             {:error/message "must implement core.async Flow ProcLauncher"
              :gen/gen seon.flow/proc-launcher-generator}
             seon.flow/proc-launcher?],
            :launcher-configuration
            [:map
             [:seon.config.flow.compute/queue-depth
              :seon.config.flow.compute/queue-depth]
             [:seon.config.flow.compute/concurrency
              :seon.config.flow.compute/concurrency]
             [:seon.config.flow.io/queue-depth
              :seon.config.flow.io/queue-depth]
             [:seon.config.flow.io/concurrency
              :seon.config.flow.io/concurrency]
             [:seon.config.agent/turn-completion-backstop-ms
              :seon.config.agent/turn-completion-backstop-ms]],
            :panic!
            [:=>
             [:cat :seon.flow/core-fault]
             :seon.flow/callback-result],
            :parallelism [:int {:min 1}],
            :read-core-error-mode
            [:=> [:cat] :seon.config/on-core-error],
            :started
            [:map
             [:report-chan :seon.flow/channel]
             [:error-chan :seon.flow/channel]],
            :started! [:=> [:cat] :nil],
            :step-var
            [:fn
             {:error/message
              "must be a Var so a running graph hot reloads its step"
              :gen/gen seon.flow/step-var-generator}
             seon.flow/step-var?],
            :submission-id [:or :uuid :keyword :string],
            :submission-wait-ms [:int {:min 0}],
            :io-complete! [:=> [:cat :map] :seon.flow/callback-result],
            :io-submission
            [:map
             [:seon.flow/submission-id :seon.flow/submission-id]
             [:seon.flow/workload [:= :io]]
             [:seon.flow/work-fn :seon.flow/work-fn]
             [:seon.flow/complete! :seon.flow/io-complete!]
             [:seon.env/environment :seon.env/environment]],
            :work-call
            [:or
             [:map [:seon.flow/started! :seon.flow/started!]]
             [:map
              [:seon.flow/interrupt-fn :seon.sci.admit/interrupt-fn]]],
            :work-fn
            [:=> [:cat :seon.flow/work-call] :seon.sci.admit/value],
            :work-launcher
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/started :seon.flow/started]
             [:seon.flow/active-work :seon.flow/active-work]
             [:seon.flow/compute-executor :seon.flow/executor]
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]],
            :work-launcher-request
            [:map
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]
             [:seon.env/environment :seon.env/environment]
             [:seon.flow/launcher-step {:optional true} :seon.flow/step-var]],
            :work-result
            [:or
             [:map
              [:seon.flow/outcome [:= :seon.flow/time-limit]]
              [:seon.flow/submission-wait-ms
               :seon.flow/submission-wait-ms]]
             [:map
              [:seon.flow/outcome [:= :seon.flow/completed]]
              [:seon.flow/value :seon.sci.admit/value]
              [:seon.flow/submission-wait-ms
               :seon.flow/submission-wait-ms]]],
            :work-submission
            [:map
             [:seon.flow/submission-id :seon.flow/submission-id]
             [:seon.flow/workload :seon.flow/workload]
             [:seon.flow/work-fn :seon.flow/work-fn]
             [:seon.flow/time-limit-ms :seon.flow/compute-timeout-ms]
             [:seon.env/environment :seon.env/environment]],
            :workload [:enum :compute :io],
            :proc-id :keyword,
 :seon.flow/submission-capacity :seon.flow/proc-id
 :seon.flow/submission-capacity-error
 [:and :seon.error/base
  [:map
   [:seon.flow/submission-capacity :seon.flow/submission-capacity]
   [:seon.flow/submission-id :seon.flow/submission-id]
]]
 :seon.flow/launcher-stopped :seon.flow/proc-id
 :seon.flow/launcher-stopped-error
 [:and :seon.error/base
  [:map
   [:seon.flow/launcher-stopped :seon.flow/launcher-stopped]
   [:seon.flow/submission-id :seon.flow/submission-id]
]]
 :seon.flow/time-limit :seon.flow/proc-id
 :seon.flow/time-limit-error
 [:and :seon.error/base
  [:map
   [:seon.flow/time-limit :seon.flow/time-limit]
]]
 :seon.flow/missing-config-facts [:vector {:min 1} :qualified-keyword]
 :seon.flow/configuration-error
 [:and :seon.error/base
  [:map
   [:seon.flow/missing-config-facts :seon.flow/missing-config-facts]
]]
 :seon.flow/missing-launcher-submission :seon.flow/submission-id
 :seon.flow/missing-launcher-error
 [:and :seon.error/base
  [:map
   [:seon.flow/missing-launcher-submission :seon.flow/missing-launcher-submission]
]]
 :seon.flow/timeout :seon.flow/proc-id
 :seon.flow/timeout-error
 [:and :seon.error/base
  [:map
   [:seon.flow/timeout :seon.flow/timeout]
]]
 :seon.flow/dropped-fault-count [:int {:min 1}]
 :seon.flow/dropped-fault-digest :string
 :seon.flow/fault-channel-overflow-error
 [:and :seon.error/base
  [:map
   [:seon.flow/dropped-fault-count :seon.flow/dropped-fault-count]
   [:seon.flow/dropped-fault-digest :seon.flow/dropped-fault-digest]
]]
 :seon.flow/unsupported-implementation :qualified-symbol
 :seon.flow/unsupported-method :qualified-symbol
 :seon.flow/unsupported-command-error
 [:and :seon.error/base
  [:map
   [:seon.flow/unsupported-method :seon.flow/unsupported-method]
   [:seon.flow/unsupported-implementation {:optional true} :seon.flow/unsupported-implementation]
]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.flow/control-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.flow/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.flow/error-graph :seon.flow/error-graph]
  [:seon.flow/control-observation :seon.flow/control-observation]]]

 :seon.flow/error-graph
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]
 :seon.flow/exception-error
 [:and :seon.error/base [:map [:seon.error/exception-class :seon.error/exception-class]]]

}
