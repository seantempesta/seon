#:seon.flow{
            :active-work
            [:fn
             {:error/message
              "must be a process-local atom containing active Flow work state"
              :gen/gen seon.flow/atom-reference-generator}
             seon.flow/atom-reference?],
            :callback-result
            [:or
             :map
             [:vector :seon.schema/value]
             [:set :seon.schema/value]
             [:sequential :seon.schema/value]
             :string
             :keyword
             :symbol
             :boolean
             :int
             :double
             :uuid
             :inst],
            :channel
            [:fn
             {:error/message "must be a core.async channel"
              :gen/gen seon.flow/channel-generator}
             seon.flow/channel?],
            :write-port
            [:fn
             {:error/message "must be a core.async write port"
              :gen/gen seon.flow/channel-generator}
             seon.flow/write-port?],
            :commit-fault!
            [:=>
             [:cat :seon.error/recording-observation]
             [:maybe :seon.flow/callback-result]],
            :executor
            [:fn
             {:error/message "must be a java.util.concurrent Executor"
              :gen/gen seon.flow/executor-generator}
             seon.flow/executor?],
            :future
            [:fn
             {:error/message "must be a java.util.concurrent Future"
              :gen/gen seon.flow/java-future-generator}
             seon.flow/java-future?],
            :graph
            [:fn
             {:error/message "must be a core.async Flow graph"
              :gen/gen seon.flow/graph-generator}
             seon.flow/graph?],
            :join!
            [:fn
             {:error/message "must be a callable Flow graph join"
              :gen/schema [:=> [:cat :map] :map]}
             clojure.core/ifn?],
            :launcher
            [:fn
             {:error/message "must implement core.async Flow ProcLauncher"
              :gen/gen seon.flow/proc-launcher-generator}
             seon.flow/proc-launcher?],
            :launcher-configuration
            [:map
             [:seon.config.flow.io/queue-depth
              :seon.config.flow.io/queue-depth]
             [:seon.config.flow.io/concurrency
              :seon.config.flow.io/concurrency]
             [:seon.config.agent/turn-completion-backstop-ms
              :seon.config.agent/turn-completion-backstop-ms]],
            :plan-channel
            [:and {:description "db<->flow's in-port: a payload-free wake asking it to plan again (seon.cluster.wake/route! offers on it)."}
             :seon.flow/channel],
            :started
            [:map
             [:report-chan :seon.flow/channel]
             [:error-chan :seon.flow/channel]],
            :started! [:=> [:cat] :nil],
            :step-var
            [:fn
             {:error/message
              "must be a Var so a running graph hot reloads its step"
              :gen/gen seon.flow/step-var-generator}
             seon.flow/step-var?],
            :submission-id [:or :uuid :keyword :string],
            :io-complete! [:=> [:cat :map] [:maybe :seon.flow/callback-result]],
            :io-submission
            [:map
             [:seon.flow/submission-id :seon.flow/submission-id]
             [:seon.flow/workload [:= :io]]
             [:seon.flow/work-fn :seon.flow/work-fn]
             [:seon.flow/complete! :seon.flow/io-complete!]
             [:seon.env/environment :seon.env/environment]],
            :work-call
            [:or
             [:map [:seon.flow/started! :seon.flow/started!]]
             [:map
              [:seon.flow/interrupt-fn :seon.sci.admit/interrupt-fn]]],
            :work-fn
            [:=> [:cat :seon.flow/work-call] :seon.sci.admit/value],
            :work-launcher
            [:map
             [:seon.flow/graph :seon.flow/graph]
             [:seon.flow/started :seon.flow/started]
             [:seon.flow/active-work :seon.flow/active-work]
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]],
            :work-launcher-request
            [:map
             [:seon.flow/configuration
              :seon.flow/launcher-configuration]
             [:seon.env/environment :seon.env/environment]],
            :workload [:enum :compute :io],
            :proc-id :keyword,
 :seon.flow/submission-capacity :seon.flow/proc-id
 :seon.flow/submission-capacity-error
 [:and :seon.error/base
  [:map
   [:seon.flow/submission-capacity :seon.flow/submission-capacity]
   [:seon.flow/submission-id :seon.flow/submission-id]
]]
 :seon.flow/launcher-stopped :seon.flow/proc-id
 :seon.flow/missing-config-facts [:vector {:min 1} :qualified-keyword]
 :seon.flow/timeout :seon.flow/proc-id
 :seon.flow/unsupported-implementation :qualified-symbol
 :seon.flow/unsupported-method :qualified-symbol
 ; Additive error declaration manifest, 2026-09-18.

 :seon.flow/control-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

 :seon.flow/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.flow/error-graph :seon.flow/error-graph]
  [:seon.flow/control-observation :seon.flow/control-observation]]]

 :seon.flow/error-graph
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]
 :seon.flow/exception-error
 [:and :seon.error/base [:map [:seon.error/exception-class :seon.error/exception-class]]]

 :seon.flow/thread-counters
 [:tuple {:description "One thread's allocated bytes and CPU nanoseconds (seon.flow/thread-counters); an unavailable reading is -1."} :int :int]
 :seon.flow/step-start
 [:and {:description "The proc thread's counters when its running step began: seon.flow/var-process puts them in the step's world (seon.batch/*world*); seon.turn/step reads the step's cost from them (seon.flow/step-cost)."} :seon.flow/thread-counters]

}
