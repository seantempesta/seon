#:seon.cluster.message{:about
                       [:and #:seon.db{:index true} :seon.db/ref],
                       :at :inst,
                       :caused-by
                       [:and #:seon.db{:index true} :seon.db/ref],
                       :content
                       [:string {:min 1, :seon.db/no-history? true}],
                       :delivery
                       [:map
                        [:seon.cluster.message/rows [:vector :map]]
                        [:seon.error/values
                         [:vector :seon.error/value]]],
                       :delivery-request
                       [:map
                        [:my.message/value :my.message/value]
                        [:seon.cluster.agent/id :seon.cluster.agent/id]
                        [:seon.cluster.run/id :seon.cluster.run/id]
                        [:seon.cluster.run.form/ordinal
                         :seon.cluster.run.form/ordinal]
                        [:seon.cluster.message/at
                         :seon.cluster.message/at]
                        [:seon.config.message/max-chain
                         :seon.config.message/max-chain]
                        [:seon.cluster.message/trigger
                         {:optional true}
                         :seon.cluster.message/id]],
                       :from
                       [:and #:seon.db{:index true} :seon.db/ref],
                       :id [:string {:min 1, :seon.db/identity true}],
                       :inbound
                       [:or
                        [:vector {:min 1, :max 1} :map]
                        :seon.error/value],
                       :inbound-content :string,
                       :inbound-request
                       [:map
                        [:seon.cluster.agent/id :seon.cluster.agent/id]
                        [:seon.cluster.message/inbound-content
                         :seon.cluster.message/inbound-content]
                        [:seon.cluster.message/at
                         :seon.cluster.message/at]
                        [:seon.config.eval.result/max-string
                         :seon.config.eval.result/max-string]],
                       :message
                       [:map
                        {:seon.db/entity true,
                         :seon.render/ai
                         seon.cluster.message/render-ai,
                         :seon.render/html
                         seon.cluster.message/render-html}
                        [:seon.cluster.message/id
                         :seon.cluster.message/id]
                        [:seon.cluster.message/to
                         :seon.cluster.message/to]
                        [:seon.cluster.message/content
                         :seon.cluster.message/content]
                        [:seon.cluster.message/at
                         :seon.cluster.message/at]
                        [:seon.cluster.message/from
                         {:optional true}
                         :seon.cluster.message/from]
                        [:seon.cluster.message/caused-by
                         {:optional true}
                         :seon.cluster.message/caused-by]
                        [:seon.cluster.message/about
                         {:optional true}
                         :seon.cluster.message/about]
                        [:my.message/reason
                         {:optional true}
                         :my.message/reason]],
                       :reply-request
                       [:map
                        [:my.run/result :my.run/result]
                        [:seon.cluster.agent/id :seon.cluster.agent/id]
                        [:seon.cluster.message/trigger
                         {:optional true}
                         :seon.cluster.message/id]],
                       :to :seon.db/ref,
                       :size [:int {:min 0}],
                       :limit [:int {:min 0}],
                       :unknown-recipient :seon.cluster.agent/id
                       :unknown-recipient-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the unknown message recipient"} [:seon.cluster.message/unknown-recipient :seon.cluster.message/unknown-recipient] [:seon.error/message :seon.error/message]]
                       :unknown-about :seon.cluster.message/id
                       :unknown-about-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the unknown message named as context"} [:seon.cluster.message/unknown-about :seon.cluster.message/unknown-about] [:seon.error/message :seon.error/message]]
                       :ambiguous-about :seon.cluster.message/id
                       :ambiguous-about-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the ambiguous message context"} [:seon.cluster.message/ambiguous-about :seon.cluster.message/ambiguous-about] [:seon.error/message :seon.error/message]]
                       :blank-content [:= true]
                       :blank-content-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a message whose content is blank"} [:seon.cluster.message/blank-content :seon.cluster.message/blank-content] [:seon.error/message :seon.error/message]]
                       :content-too-large :seon.cluster.message/size
                       :content-too-large-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the size of message content that exceeds its limit"} [:seon.cluster.message/content-too-large :seon.cluster.message/content-too-large] [:seon.error/message :seon.error/message]]
                       :chain-limit :seon.cluster.message/limit
                       :chain-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the message-chain limit that was reached"} [:seon.cluster.message/chain-limit :seon.cluster.message/chain-limit] [:seon.error/message :seon.error/message]]
                       :no-limit [:= true]
                       :no-limit-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a message chain with no configured limit"} [:seon.cluster.message/no-limit :seon.cluster.message/no-limit] [:seon.error/message :seon.error/message]]}
