{:seon.schema.datahike/literal-not-storable [:= true]
 :seon.schema.datahike/enum-not-storable [:= true]
 :seon.schema.datahike/nilable-attribute :qualified-keyword
 :seon.schema.datahike/value-type-unavailable [:= true]
 :seon.schema.datahike/attribute-absent :qualified-keyword
 :seon.schema.datahike/invalid-secondary-attribute :qualified-keyword
 :seon.schema.datahike/schema-invalid :qualified-keyword
 :seon.schema.datahike/storage-not-string :qualified-keyword
 :seon.schema.datahike/malformed-edn :qualified-keyword
 :seon.schema.datahike/noncanonical-edn :qualified-keyword
 :seon.schema.datahike/vector-tempid-operation [:= true]
 :seon.schema.datahike/vector-value-not-sequential [:= true]
 ; A vector write the encoder hands the writer's transaction function:
 ; [entity-handle attribute operation argument]. `:assert` replaces the
 ; vector, `:add` appends, `:retract` removes every occurrence, `:clear`
 ; makes it absent (argument nil).
 :seon.schema.datahike/vector-request
 [:tuple :seon.schema/value :qualified-keyword [:enum :assert :add :retract :clear] :seon.schema/value]
 :seon.schema.datahike/vector-requests [:vector :seon.schema.datahike/vector-request]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.schema.datahike/declared-form
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :seon.schema.datahike/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.schema.datahike/error-attribute
   :seon.schema.datahike/error-attribute]
  [:seon.schema.datahike/declared-form
   :seon.schema.datahike/declared-form]]]

 :seon.schema.datahike/error-attribute
 :qualified-keyword
 :seon.schema.datahike/unstorable-attribute [:qualified-keyword {:description "The attribute seon.schema.datahike/attribute-declaration could not map to a native Datahike declaration."}]
 :seon.schema.datahike/unstorable-attribute-error
 [:and {:description "Why an attribute has no native Datahike declaration; the per-reason member (attribute-absent, literal-not-storable, enum-not-storable, nilable-attribute, value-type-unavailable, invalid-secondary-attribute) says which."}
  :seon.error/base
  [:map [:seon.schema.datahike/unstorable-attribute :seon.schema.datahike/unstorable-attribute]]]}
