#:seon.ref{:name [:or {:description "A referenced Seon or library definition: a qualified symbol, a schema key, or a namespace's name."} :qualified-symbol :qualified-keyword simple-symbol?]
           :path [:string {:min 1 :description "A checkout-relative path, an RFC 3986 relative reference."}]
           :anchor [:string {:min 1 :description "A heading's anchor, as GitHub and commonmark's heading-anchor extension derive it."}]
           :line [:int {:min 1 :description "A 1-based line in the text, as an editor shows it."}]
           :line-count [:int {:min 0}]
           :heading-level [:int {:min 1 :max 6 :description "A Markdown heading's level, 1 for `#`."}]
           :level [:enum {:description "The reference level its author chose with the delimiter (TASK-CHAIN §3a): a bare name is its summary (`seon.ref/brief`), one backtick or a link its doc, three or more backticks its code (`my.program/source`)."} :summary :doc :code]
           :width [:int {:min 1 :description "A code span's delimiter width: the backticks that open it, read from its source span."}]
           :heading :string
           :span :string
           :link :string
           :lines [:map {:description "The first and last line of a block, as an editor shows them."} [:seon.ref/line :seon.ref/line] [:seon.ref/end-line :seon.ref/end-line]]
           :lead-lines [:or {:description "The lines of a heading's own next block when it is a paragraph: its lead."} :seon.ref/lines]
           :opening-lines [:or {:description "The lines of a heading's own next block when it is not a paragraph (a list, a table, a code block): the section's opening, which is no lead."} :seon.ref/lines]
           :section-end [:int {:min 1 :description "The line after a heading's section: the next heading at or above its level, else the end of the text."}]
           :children [:vector {:description "The lines of the headings directly below a heading."} :seon.ref/line]
           :body-line [:int {:min 1 :description "The line a text starts at: the line after its front matter's closing delimiter, else 1."}]
           :heading-entry [:map [:seon.ref/heading-level :seon.ref/heading-level] [:seon.ref/heading :seon.ref/heading]
                           [:seon.ref/anchor :seon.ref/anchor] [:seon.ref/line :seon.ref/line]
                           [:seon.ref/lead-lines {:optional true} :seon.ref/lead-lines]
                           [:seon.ref/opening-lines {:optional true} :seon.ref/opening-lines]
                           [:seon.ref/section-end :seon.ref/section-end]
                           [:seon.ref/children {:optional true} :seon.ref/children]]
           :span-entry [:map [:seon.ref/span :seon.ref/span] [:seon.ref/width :seon.ref/width] [:seon.ref/line :seon.ref/line]]
           :link-entry [:map [:seon.ref/link :seon.ref/link] [:seon.ref/line :seon.ref/line]]
           :word [:string {:min 1 :description "A prose word with a `/`, the punctuation around it left off: a reference only when it names an entity."}]
           :word-entry [:map [:seon.ref/word :seon.ref/word] [:seon.ref/line :seon.ref/line]]
           :code [:string {:description "A fenced code block's code."}]
           :code-block [:map [:seon.ref/code :seon.ref/code] [:seon.ref/line :seon.ref/line]]
           :end-line :seon.ref/line
           :first-paragraph [:map {:description "The lines of a text's first paragraph."} [:seon.ref/line :seon.ref/line] [:seon.ref/end-line :seon.ref/end-line]]
           :document [:map {:description "Markdown text's headings, its code spans, links and prose words with a `/` in document order, its first paragraph's lines and its fenced code blocks; code contributes no candidate."}
                      [:seon.ref/headings [:vector :seon.ref/heading-entry]]
                      [:seon.ref/spans [:vector [:or :seon.ref/span-entry :seon.ref/link-entry :seon.ref/word-entry]]]
                      [:seon.ref/code-blocks [:vector :seon.ref/code-block]]
                      [:seon.ref/first-paragraph {:optional true} :seon.ref/first-paragraph]
                      [:seon.ref/body-line :seon.ref/body-line]
                      [:seon.ref/line-count :seon.ref/line-count]]
           :docstring [:map {:description "A docstring's summary (its first paragraph's first sentence), the body after it and its Example section's code; an empty part is absent. Producer: seon.ref/docstring."}
                       [:summary :string] [:body {:optional true} [:string {:min 1}]] [:example {:optional true} [:string {:min 1}]]]
           :resolve-only [:= {:description "The candidate is a prose word or an unqualified span: a reference only when it names an entity, else prose."} true]
           :subject [:or {:description "The entity whose own prose this is: it never cites itself."} :seon.ref/name]
           :problem-kind [:enum :unresolved :anchor-missing :line-reference :no-lead :no-summary]
           :candidate [:or
                       [:map [:seon.ref/name :seon.ref/name] [:seon.ref/line {:optional true} :seon.ref/line]
                        [:seon.ref/level {:optional true} :seon.ref/level]
                        [:seon.ref/resolve-only {:optional true} :seon.ref/resolve-only]]
                       [:map [:seon.ref/path :seon.ref/path] [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                        [:seon.ref/level {:optional true} :seon.ref/level]
                        [:seon.ref/problem-kind {:optional true} [:enum :line-reference]]
                        [:seon.ref/line {:optional true} :seon.ref/line]
                        [:seon.ref/resolve-only {:optional true} :seon.ref/resolve-only]]
                       [:map {:description "An anchor-only link in a text with no document: it names no heading."}
                        [:seon.ref/problem-kind [:enum :anchor-missing]] [:seon.ref/anchor {:optional true} :seon.ref/anchor]]]
           :source [:map {:description "Markdown text that can carry references (an intent or docstring alone, a doc with its path), with the names and paths held beside it."}
                    [:seon.ref/text :string]
                    [:seon.ref/names {:optional true} [:set :seon.ref/name]]
                    [:seon.ref/paths {:optional true :description "Held based paths with optional #anchors, each read as a code span is."} [:set [:string {:min 1}]]]
                    [:seon.ref/document-path {:optional true} :seon.ref/path]
                    [:seon.ref/subject {:optional true} :seon.ref/subject]]
           :problem [:map {:description "A reference that does not resolve, and why."}
                     [:seon.ref/problem-kind :seon.ref/problem-kind]
                     [:seon.ref/message :seon.ref/message]
                     [:seon.ref/line {:optional true} :seon.ref/line]
                     [:seon.ref/name {:optional true} :seon.ref/name]
                     [:seon.ref/path {:optional true} :seon.ref/path]
                     [:seon.ref/anchor {:optional true} :seon.ref/anchor]]
           :message [:string {:min 1 :description "What a problem kind means and what the agent does about it: short fixed text per kind."}]
           :project [:string {:min 1}]
           :revision [:string {:min 40 :max 40}]
           :pin [:map {:description "The reference-code project and pinned revision a library definition loads from."}
                 [:seon.ref/project :seon.ref/project] [:seon.ref/revision :seon.ref/revision]]
           :arglists [:sequential {:description "A function's parameter vectors, destructuring forms included."} [:vector :seon.schema/value]]
           :brief [:map {:description "A name a referent's own content cites, shown one level: its name, a one-line summary and the form that reads it, never its content. Producer: seon.ref/brief."}
                   [:seon.ref/name :seon.ref/name] [:doc {:optional true} :string]
                   [:seon.render/operations {:optional true} [:vector :seon.render/read-form]]]
           :references [:vector {:description "The names a referent's own content cites (a test's docstring, a task's intent, a namespace's docstring, a doc section's text), each one level."}
                        [:or :seon.ref/brief :seon.ref/problem :seon.error/value]]
           :resolved-name [:map {:description "A name identified at the level its citation asks for: a function, library Var or schema key as the value of brief, doc or source (seon.ref/at-level); a deftest, task or namespace as its entity, pulled as its identity attribute declares, with its row's render pair as its own :seon.render/ai and :seon.render/html keys and the names its content cites, one level (seon.ref/resolve-name)."}
                           [:seon.ref/level {:optional true} :seon.ref/level]
                           [:seon.ref/name :seon.ref/name]
                           [:seon.ref/references {:optional true} :seon.ref/references]
                           [:seon.ref/line {:optional true} :seon.ref/line]
                           [:arglists {:optional true} :seon.ref/arglists]
                           [:seon.ref/pin {:optional true} :seon.ref/pin]]
           :lead [:string {:min 1 :description "A section's lead: the paragraph that is its heading's own next block, whole."}]
           :opening [:string {:min 1 :description "A section's first block whole when it is not a paragraph (a list, a table, a code block); the structural fallback for a section with no lead."}]
           :resolved-doc [:map {:description "A based path resolved to its document or anchored section: heading, pin and the names its text cites, one level; never its text."
                                :seon.render/ai seon.ref/render-doc-ai :seon.render/html seon.ref/render-doc-html}
                          [:seon.ref/path :seon.ref/path]
                          [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                          [:seon.ref/heading :seon.ref/heading]
                          [:seon.ref/tokens {:optional true} :seon.ref/tokens]
                          [:seon.ref/lead {:optional true} :seon.ref/lead]
                          [:seon.ref/opening {:optional true} :seon.ref/opening]
                          [:seon.ref/below {:optional true} :seon.ref/below]
                          [:seon.ref/pin {:optional true} :seon.ref/pin]
                          [:seon.ref/line {:optional true} :seon.ref/line]
                          [:seon.ref/references {:optional true} :seon.ref/references]]
           :doc-view [:map {:description "A document reference as an agent reads it: the entry without its render keys, with the one read of its text. Producer: seon.ref/render-doc-ai."}
                      [:seon.ref/path :seon.ref/path]
                      [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                      [:seon.ref/heading :seon.ref/heading]
                      [:seon.ref/tokens {:optional true} :seon.ref/tokens]
                      [:seon.ref/lead {:optional true} :seon.ref/lead]
                      [:seon.ref/opening {:optional true} :seon.ref/opening]
                      [:seon.ref/below {:optional true} :seon.ref/below]
                      [:seon.ref/pin {:optional true} :seon.ref/pin]
                      [:seon.ref/line {:optional true} :seon.ref/line]
                      [:seon.render/operations [:vector :seon.render/read-form]]
                      [:seon.ref/references {:optional true} :seon.ref/references]]
           :render-pair [:map {:description "The renderers a schema declares for its values, as symbols."}
                         [:seon.render/ai {:optional true} :qualified-symbol] [:seon.render/html {:optional true} :qualified-symbol]]
           :pull [:vector {:description "The attributes an identity's entity is pulled as when it is referenced."} :qualified-keyword]
           :row :qualified-keyword
           :declaration [:map {:description "An identity attribute's reference declaration, read from the schema: what its entity is pulled as and its row schema. Producer: seon.ref/declarations."}
                         [:seon.ref/pull :seon.ref/pull] [:seon.ref/row :seon.ref/row]]
           :resolved [:or {:description "A reference resolved: a name to its definition, or a path to its document."}
                      :seon.ref/resolved-name :seon.ref/resolved-doc]
           :reference-text [:string {:min 1 :description "A based relative path with an optional #anchor, as an agent writes it."}]
           :file :string
           :location [:map {:description "A doc's file in the loaded commit, with its pin for a reference-code path."}
                      [:seon.ref/file :seon.ref/file] [:seon.ref/pin {:optional true} :seon.ref/pin]]
           :tokens [:int {:min 0}]
           :child [:map [:seon.ref/anchor :seon.ref/anchor] [:seon.ref/heading :seon.ref/heading] [:seon.ref/tokens :seon.ref/tokens]]
           :text :string
           :below [:vector :seon.ref/child]
           :section [:map {:description "A doc section's Markdown, the headings one level below it with their sizes, its size and its pin."}
                     [:seon.ref/path :seon.ref/path] [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                     [:seon.ref/heading :seon.ref/heading] [:seon.ref/text :seon.ref/text] [:seon.ref/tokens :seon.ref/tokens]
                     [:seon.ref/lead {:optional true} :seon.ref/lead] [:seon.ref/opening {:optional true} :seon.ref/opening]
                     [:seon.ref/below :seon.ref/below] [:seon.ref/pin {:optional true} :seon.ref/pin]]
           :section-missing [:enum :file :heading]
           :nearest [:vector [:or :string [:map [:seon.ref/anchor :seon.ref/anchor] [:seon.ref/heading :seon.ref/heading]]]]
           :section-error [:merge :seon.error/base
                           [:map [:seon.ref/section-missing :seon.ref/section-missing] [:seon.ref/path {:optional true} :seon.ref/path]
                            [:seon.ref/anchor {:optional true} :seon.ref/anchor] [:seon.ref/nearest :seon.ref/nearest]]]}
