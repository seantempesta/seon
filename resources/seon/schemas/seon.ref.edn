#:seon.ref{:name [:or {:description "A referenced Seon or library definition: a qualified symbol or a schema key."} :qualified-symbol :qualified-keyword]
           :path [:string {:min 1 :description "A checkout-relative path, an RFC 3986 relative reference."}]
           :anchor [:string {:min 1 :description "A heading's anchor, as GitHub and commonmark's heading-anchor extension derive it."}]
           :line [:int {:min 1 :description "A 1-based line in the text, as an editor shows it."}]
           :line-count [:int {:min 0}]
           :level [:int {:min 1 :max 6}]
           :heading :string
           :span :string
           :link :string
           :heading-entry [:map [:seon.ref/level :seon.ref/level] [:seon.ref/heading :seon.ref/heading]
                           [:seon.ref/anchor :seon.ref/anchor] [:seon.ref/line :seon.ref/line]]
           :span-entry [:map [:seon.ref/span :seon.ref/span] [:seon.ref/line :seon.ref/line]]
           :link-entry [:map [:seon.ref/link :seon.ref/link] [:seon.ref/line :seon.ref/line]]
           :document [:map {:description "Markdown text's headings and its code spans and links in document order; fenced and indented code contribute nothing."}
                      [:seon.ref/headings [:vector :seon.ref/heading-entry]]
                      [:seon.ref/spans [:vector [:or :seon.ref/span-entry :seon.ref/link-entry]]]
                      [:seon.ref/line-count :seon.ref/line-count]]
           :problem-kind [:enum :unresolved :anchor-missing :line-reference]
           :candidate [:or
                       [:map [:seon.ref/name :seon.ref/name] [:seon.ref/line {:optional true} :seon.ref/line]]
                       [:map [:seon.ref/path :seon.ref/path] [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                        [:seon.ref/problem-kind {:optional true} [:enum :line-reference]]
                        [:seon.ref/line {:optional true} :seon.ref/line]]]
           :source [:map {:description "Markdown text that can carry references (an intent or docstring alone, a doc with its path), with the names and paths held beside it."}
                    [:seon.ref/text :string]
                    [:seon.ref/names {:optional true} [:set :seon.ref/name]]
                    [:seon.ref/paths {:optional true :description "Held based paths with optional #anchors, each read as a code span is."} [:set [:string {:min 1}]]]
                    [:seon.ref/document-path {:optional true} :seon.ref/path]]
           :problem [:map {:description "A reference that does not resolve, and why."}
                     [:seon.ref/problem-kind :seon.ref/problem-kind]
                     [:seon.ref/message :seon.ref/message]
                     [:seon.ref/line {:optional true} :seon.ref/line]
                     [:seon.ref/name {:optional true} :seon.ref/name]
                     [:seon.ref/path {:optional true} :seon.ref/path]
                     [:seon.ref/anchor {:optional true} :seon.ref/anchor]]
           :message [:string {:min 1 :description "What a problem kind means and what the agent does about it: short fixed text per kind."}]
           :project [:string {:min 1}]
           :revision [:string {:min 40 :max 40}]
           :pin [:map {:description "The reference-code project and pinned revision a library definition loads from."}
                 [:seon.ref/project :seon.ref/project] [:seon.ref/revision :seon.ref/revision]]
           :schema-form :seon.schema/value
           :arglists [:sequential {:description "A function's parameter vectors, destructuring forms included."} [:vector :seon.schema/value]]
           :resolved-name [:map {:description "A name resolved to its own content by one rule: a function's docstring summary, arglists and contract as the agent writes it (:malli/schema), with the forms that read its source, callers and reaching tests; a schema key's form; a test's source; a task's intent."}
                           [:seon.ref/name :seon.ref/name]
                           [:seon.ref/line {:optional true} :seon.ref/line]
                           [:arglists {:optional true} :seon.ref/arglists]
                           [:malli/schema {:optional true} :seon.schema/value]
                           [:doc {:optional true} :string]
                           [:seon.ref/pin {:optional true} :seon.ref/pin]
                           [:seon.ref/schema-form {:optional true} :seon.ref/schema-form]
                           [:seon.test/source {:optional true} :seon.test/source]
                           [:seon.task/intent {:optional true} :seon.task/intent]
                           [:seon.render/operations {:optional true} [:vector :seon.render/read-form]]]
           :resolved-doc [:map {:description "A based path resolved to its document or anchored section: heading, pin and the one read operation, never its text."}
                          [:seon.ref/path :seon.ref/path]
                          [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                          [:seon.ref/heading :seon.ref/heading]
                          [:seon.ref/pin {:optional true} :seon.ref/pin]
                          [:seon.ref/line {:optional true} :seon.ref/line]
                          [:seon.render/operations [:vector :seon.render/read-form]]]
           :resolved [:or {:description "A reference resolved: a name to its definition, or a path to its document."}
                      :seon.ref/resolved-name :seon.ref/resolved-doc]
           :reference-text [:string {:min 1 :description "A based relative path with an optional #anchor, as an agent writes it."}]
           :file :string
           :location [:map {:description "A doc's file in the loaded commit, with its pin for a reference-code path."}
                      [:seon.ref/file :seon.ref/file] [:seon.ref/pin {:optional true} :seon.ref/pin]]
           :tokens [:int {:min 0}]
           :child [:map [:seon.ref/anchor :seon.ref/anchor] [:seon.ref/heading :seon.ref/heading] [:seon.ref/tokens :seon.ref/tokens]]
           :text :string
           :below [:vector :seon.ref/child]
           :section [:map {:description "A doc section's Markdown, the headings one level below it with their sizes, its size and its pin."}
                     [:seon.ref/path :seon.ref/path] [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                     [:seon.ref/heading :seon.ref/heading] [:seon.ref/text :seon.ref/text] [:seon.ref/tokens :seon.ref/tokens]
                     [:seon.ref/below :seon.ref/below] [:seon.ref/pin {:optional true} :seon.ref/pin]]
           :section-missing [:enum :file :heading]
           :nearest [:vector [:or :string [:map [:seon.ref/anchor :seon.ref/anchor] [:seon.ref/heading :seon.ref/heading]]]]
           :section-error [:and :seon.error/base
                           [:map [:seon.ref/section-missing :seon.ref/section-missing] [:seon.ref/path :seon.ref/path]
                            [:seon.ref/anchor {:optional true} :seon.ref/anchor] [:seon.ref/nearest :seon.ref/nearest]]]}
