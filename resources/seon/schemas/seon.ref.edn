;; References in Markdown text (seon.ref): the one parse's value, a document's sections and the
;; citations its text makes, read by one rule (docs/wiki.md#references). Lines are 1-based, as
;; an editor shows them.
{:seon.ref/line pos-int?
 ;; what a citation asks to be shown at, picked by its delimiter: a bare word its summary, one
 ;; backtick or a link its doc, three or more backticks its code
 :seon.ref/depth [:enum :summary :doc :code]
 ;; a qualified symbol or keyword, or a simple symbol naming a namespace
 :seon.ref/name [:or :qualified-symbol :qualified-keyword :symbol]
 ;; a path based at the checkout's top level (docs/flow.md), and a heading anchor in it
 :seon.ref/path :string
 :seon.ref/anchor :string
 ;; :line-reference, a path:N citation (line numbers go stale; cite the var); :anchor-missing, a
 ;; #anchor link in text that has no path of its own
 :seon.ref/problem-kind [:enum :line-reference :anchor-missing :no-lead]
 ;; one mention: what it names, the depth its delimiter asks for and the line it is on; a bare
 ;; prose word is resolve-only, a reference only when it names something
 :seon.ref/citation [:map {:closed true}
                     [:seon.ref/name {:optional true} :seon.ref/name]
                     [:seon.ref/path {:optional true} :seon.ref/path]
                     [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                     [:seon.ref/problem-kind {:optional true} :seon.ref/problem-kind]
                     [:seon.ref/depth :seon.ref/depth]
                     [:seon.ref/line :seon.ref/line]
                     [:seon.ref/resolve-only {:optional true} :boolean]]
 ;; one raw inline of the scan: a code span (its content and backtick width), a link's
 ;; destination, or a prose word holding a /
 :seon.ref/span [:or
                 [:map {:closed true} [:seon.ref/code :string] [:seon.ref/width pos-int?] [:seon.ref/line :seon.ref/line]]
                 [:map {:closed true} [:seon.ref/link :string] [:seon.ref/line :seon.ref/line]]
                 [:map {:closed true} [:seon.ref/word :string] [:seon.ref/line :seon.ref/line]]]
 ;; one block of the scan, by the kind its first line starts: an ATX heading (its level, its
 ;; text and the offsets of its content), a fenced or indented code block, a paragraph, a list,
 ;; a block quote, a table or a thematic break; :from and :to are offsets into the text, and the
 ;; block after a heading carries its own text
 :seon.ref/kind [:enum :heading :fence :code :para :list :quote :table :break]
 :seon.ref/block [:multi {:dispatch :seon.ref/kind}
                  [:heading [:map {:closed true}
                             [:seon.ref/kind [:= :heading]]
                             [:seon.ref/from nat-int?] [:seon.ref/to nat-int?]
                             [:seon.ref/line :seon.ref/line] [:seon.ref/end-line :seon.ref/line]
                             [:seon.ref/heading-level [:int {:min 1 :max 6}]]
                             [:seon.ref/heading :string]
                             [:seon.ref/text-from nat-int?] [:seon.ref/text-to nat-int?]]]
                  [:malli.core/default [:map {:closed true}
                                        [:seon.ref/kind [:enum :fence :code :para :list :quote :table :break]]
                                        [:seon.ref/from nat-int?] [:seon.ref/to nat-int?]
                                        [:seon.ref/line :seon.ref/line] [:seon.ref/end-line :seon.ref/line]
                                        [:seon.ref/text {:optional true} :string]]]]
 :seon.ref/scan [:map {:closed true}
                 [:seon.ref/blocks [:vector :seon.ref/block]]
                 [:seon.ref/spans [:vector :seon.ref/span]]
                 [:seon.ref/line-count nat-int?]]
 ;; a section: its address (path#anchor), heading, level, line, enclosing section, its lead (the
 ;; heading's next block when that is a paragraph) or else its opening block, and its own text
 ;; (the lines after its heading up to the next heading)
 :seon.ref/address :string
 :seon.ref/section [:map {:closed true}
                    [:seon.ref/address :seon.ref/address]
                    [:seon.ref/anchor :seon.ref/anchor]
                    [:seon.ref/heading :string]
                    [:seon.ref/heading-level [:int {:min 1 :max 6}]]
                    [:seon.ref/line :seon.ref/line]
                    [:seon.ref/parent {:optional true} :seon.ref/address]
                    [:seon.ref/lead {:optional true} :string]
                    [:seon.ref/opening {:optional true} :string]
                    [:seon.ref/text {:optional true} :string]]
 :seon.ref/document [:map {:closed true}
                     [:seon.ref/sections [:vector :seon.ref/section]]
                     [:seon.ref/citations [:vector :seon.ref/citation]]]
 ;; a section as a citation's depth shows it: at summary its heading and its lead's first
 ;; sentence, at doc its lead (or opening) and the sections below, at code its own text too;
 ;; with no lead, :no-lead at summary and doc
 ;; what a cited var shows at its citation's depth (seon.docs/resolve-ref)
 :seon.ref/var-view [:map
                     [:symbol :qualified-symbol] [:arglists {:optional true} :any] [:summary {:optional true} :string]
                     [:doc {:optional true} :string] [:contract {:optional true} :any] [:source {:optional true} :string]
                     [:left-out {:optional true} :string] [:read {:optional true} :any]]
 ;; what an edge of a stored section names, at summary depth: a section or a var
 :seon.ref/edge [:map [:seon.ref/address :string] [:seon.ref/heading :string] [:seon.ref/summary {:optional true} :string]]
 :seon.ref/view [:map
                 [:seon.ref/address :seon.ref/address]
                 [:seon.ref/heading :string]
                 [:seon.ref/summary {:optional true} :string]
                 ;; a summary that left part of its lead: how many characters, and the address that reads it at :doc
                 [:seon.ref/left {:optional true} pos-int?]
                 [:seon.ref/read-at {:optional true} :seon.ref/address]
                 [:seon.ref/lead {:optional true} :string]
                 [:seon.ref/opening {:optional true} :string]
                 [:seon.ref/below {:optional true} [:vector [:map [:seon.ref/address :seon.ref/address] [:seon.ref/heading :string]]]]
                 ;; a section's own text at code depth, or a file's whole text; the line count of a file
                 ;; that is not Markdown; the revision a reference-code file is pinned at
                 [:seon.ref/text {:optional true} :string]
                 [:seon.ref/lines {:optional true} nat-int?]
                 [:seon.ref/pin {:optional true} :string]
                 [:seon.ref/problem-kind {:optional true} :seon.ref/problem-kind]
                 ;; a stored section's edges, each at summary depth: what its text cites (sections and vars)
                 ;; and the sections that cite it (seon.docs/view)
                 [:seon.ref/references {:optional true} [:vector :seon.ref/edge]]
                 [:seon.ref/cited-by {:optional true} [:vector :seon.ref/edge]]
                 ;; a section of a page read by seon.docs/page: its depth in the page, 1 for the page's own
                 [:seon.ref/level {:optional true} pos-int?]]}
