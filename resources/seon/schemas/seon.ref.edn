;; References in Markdown text (seon.ref): the one parse's value, a document's sections and the
;; citations its text makes, read by one rule (docs/wiki.md#references). Lines are 1-based, as
;; an editor shows them.
{:seon.ref/line pos-int?
 ;; what a citation asks to be shown at, picked by its delimiter: a bare word its summary, one
 ;; backtick or a link its doc, three or more backticks its code
 :seon.ref/depth [:enum :summary :doc :code]
 ;; a qualified symbol or keyword, or a simple symbol naming a namespace
 :seon.ref/name [:or :qualified-symbol :qualified-keyword :symbol]
 ;; what a citation names, as the lookup of its identity ([attribute value]: seon.ref/target), whether or not a db holds it
 :seon.ref/target [:tuple :qualified-keyword :any]
 ;; a path based at the checkout's top level (docs/flow.md), and a heading anchor in it
 :seon.ref/path :string
 :seon.ref/anchor :string
 ;; :line-reference, a path:N citation (line numbers go stale; cite the var); :anchor-missing, a
 ;; #anchor link in text that has no path of its own
 :seon.ref/problem-kind [:enum :line-reference :anchor-missing :no-lead]
 ;; one mention: what it names, the depth its delimiter asks for and the line it is on; a bare
 ;; text word is resolve-only, a reference only when it names something
 :seon.ref/citation [:map {:closed true}
                     [:seon.ref/name {:optional true} :seon.ref/name]
                     [:seon.ref/path {:optional true} :seon.ref/path]
                     [:seon.ref/anchor {:optional true} :seon.ref/anchor]
                     [:seon.ref/problem-kind {:optional true} :seon.ref/problem-kind]
                     [:seon.ref/depth :seon.ref/depth]
                     [:seon.ref/line :seon.ref/line]
                     [:seon.ref/resolve-only {:optional true} :boolean]]
 ;; one raw inline of the scan: a code span (its content and backtick width), a link's
 ;; destination, or a text word holding a /
 :seon.ref/span [:or
                 [:map {:closed true} [:seon.ref/code :string] [:seon.ref/width pos-int?] [:seon.ref/line :seon.ref/line] [:seon.ref/from nat-int?] [:seon.ref/to nat-int?]]
                 [:map {:closed true} [:seon.ref/link :string] [:seon.ref/line :seon.ref/line] [:seon.ref/from nat-int?] [:seon.ref/to nat-int?] [:seon.ref/text-from nat-int?] [:seon.ref/text-to nat-int?]]
                 ;; :seon.ref/quoted, a word read inside a "..." string (a reproduction's data): no citation
                 [:map {:closed true} [:seon.ref/word :string] [:seon.ref/line :seon.ref/line] [:seon.ref/quoted {:optional true} :boolean]]]
 ;; one block of the scan, by the kind its first line starts: an ATX heading (its level, its
 ;; text and the offsets of its content), a fenced or indented code block, a paragraph, a list,
 ;; a block quote, a table or a thematic break; :from and :to are offsets into the text, and the
 ;; block after a heading carries its own text; a fence its content's offsets, a list its items
 :seon.ref/kind [:enum :heading :fence :code :para :list :quote :table :break]
 :seon.ref/block [:multi {:dispatch :seon.ref/kind}
                  [:heading [:map {:closed true}
                             [:seon.ref/kind [:= :heading]]
                             [:seon.ref/from nat-int?] [:seon.ref/to nat-int?]
                             [:seon.ref/line :seon.ref/line] [:seon.ref/end-line :seon.ref/line]
                             [:seon.ref/heading-level [:int {:min 1 :max 6}]]
                             [:seon.ref/heading :string]
                             [:seon.ref/text-from nat-int?] [:seon.ref/text-to nat-int?]]]
                  [:malli.core/default [:map {:closed true}
                                        [:seon.ref/kind [:enum :fence :code :para :list :quote :table :break]]
                                        [:seon.ref/from nat-int?] [:seon.ref/to nat-int?]
                                        [:seon.ref/line :seon.ref/line] [:seon.ref/end-line :seon.ref/line]
                                        [:seon.ref/text {:optional true} :string]
                                        ;; a fence's content: the offsets between its opening line and its closing one
                                        [:seon.ref/text-from {:optional true} nat-int?] [:seon.ref/text-to {:optional true} nat-int?]
                                        ;; a list's items, the offsets of each item's content after its marker, and
                                        ;; whether its first marker is a number
                                        [:seon.ref/items {:optional true} [:vector [:tuple nat-int? nat-int?]]]
                                        [:seon.ref/ordered {:optional true} :boolean]]]]
 :seon.ref/scan [:map {:closed true}
                 [:seon.ref/blocks [:vector :seon.ref/block]]
                 [:seon.ref/spans [:vector :seon.ref/span]]
                 [:seon.ref/line-count nat-int?]]
 ;; a section: its address (path#anchor), heading, level, line, enclosing section, its lead (the
 ;; heading's next block when that is a paragraph) or else its opening block, and its own text
 ;; (the lines after its heading up to the next heading); :seon.ref/written is the heading as its line writes it,
 ;; Markdown and all (a code span's backticks), which a page is drawn back with
 :seon.ref/address :string
 :seon.ref/section [:map {:closed true}
                    [:seon.ref/address :seon.ref/address]
                    [:seon.ref/anchor :seon.ref/anchor]
                    [:seon.ref/heading :string]
                    [:seon.ref/written {:optional true} :string]
                    [:seon.ref/heading-level [:int {:min 1 :max 6}]]
                    [:seon.ref/line :seon.ref/line]
                    [:seon.ref/parent {:optional true} :seon.ref/address]
                    [:seon.ref/lead {:optional true} :string]
                    [:seon.ref/opening {:optional true} :string]
                    [:seon.ref/text {:optional true} :string]]
 :seon.ref/document [:map {:closed true}
                     [:seon.ref/sections [:vector :seon.ref/section]]
                     [:seon.ref/citations [:vector :seon.ref/citation]]]
 ;; a section as a citation's depth shows it: at summary its heading and its lead's first
 ;; sentence, at doc its lead (or opening) and the sections below, at code its own text too;
 ;; with no lead, :no-lead at summary and doc
 ;; what a cited var shows at its citation's depth (seon.doc/resolve-ref)
 :seon.ref/var-view [:map
                     [:symbol :qualified-symbol] [:arglists {:optional true} :any] [:summary {:optional true} :string]
                     [:doc {:optional true} :string] [:contract {:optional true} :any] [:source {:optional true} :string]
                     [:left-out {:optional true} :string] [:read {:optional true} :any]]
 ;; what an edge of a stored section names, at summary depth: a section or a var
 :seon.ref/edge [:map [:seon.ref/address :string] [:seon.ref/heading :string] [:seon.ref/summary {:optional true} :string]]
 :seon.ref/view [:map
                 [:seon.ref/address :seon.ref/address]
                 [:seon.ref/heading :string]
                 [:seon.ref/summary {:optional true} :string]
                 ;; a summary that left part of its lead: how many characters, and the address that reads it at :doc
                 [:seon.ref/left {:optional true} pos-int?]
                 [:seon.ref/read-at {:optional true} :seon.ref/address]
                 [:seon.ref/lead {:optional true} :string]
                 [:seon.ref/opening {:optional true} :string]
                 [:seon.ref/below {:optional true} [:vector [:map [:seon.ref/address :seon.ref/address] [:seon.ref/heading :string]]]]
                 ;; a section's own text at code depth, or a file's whole text; the line count of a file
                 ;; that is not Markdown
                 [:seon.ref/text {:optional true} :string]
                 [:seon.ref/lines {:optional true} nat-int?]
                 [:seon.ref/problem-kind {:optional true} :seon.ref/problem-kind]
                 ;; a stored section's edges, each at summary depth: what its text cites (sections and vars)
                 ;; and the sections that cite it (seon.doc/view)
                 [:seon.ref/references {:optional true} [:vector :seon.ref/edge]]
                 [:seon.ref/cited-by {:optional true} [:vector :seon.ref/edge]]
                 ;; a section of a page read by seon.doc/page: its depth in the page, 1 for the page's own
                 [:seon.ref/level {:optional true} pos-int?]]
 ;; keys the schemas above use inside their own maps (keys-schemas sweep): each one's value, once
 :seon.ref/blocks [:vector {:description "The blocks of a scanned text, in order (seon.ref/scan). See docs/references.md#one-parse."} :seon.ref/block]
 :seon.ref/spans [:vector {:description "The raw inlines of a scanned text (code spans, link destinations, text words holding a /), in order."} :seon.ref/span]
 :seon.ref/line-count [:int {:min 0 :description "The number of lines of the scanned text."}]
 :seon.ref/citations [:vector {:description "The citations a document's text makes, in the order of their lines."} :seon.ref/citation]
 :seon.ref/sections [:vector {:description "A document's sections, in the order of their headings."} :seon.ref/section]
 :seon.ref/code [:string {:description "A code span's content, without its backticks."}]
 :seon.ref/width [:int {:min 1 :description "The width, in backticks, of the code span that holds the citation."}]
 :seon.ref/link [:string {:description "A link's destination, as written in the text."}]
 :seon.ref/word [:string {:description "A text word holding a /, read as a citation that only resolves (a reference when it names something)."}]
 :seon.ref/quoted [:boolean {:description "True when the word was read inside a quoted string (a reproduction's data), which makes no citation."}]
 :seon.ref/resolve-only [:boolean {:description "True when a citation is a bare text word, a reference only when it names something."}]
 :seon.ref/from [:int {:min 0 :description "The offset in the text at which a block or span starts."}]
 :seon.ref/to [:int {:min 0 :description "The offset in the text at which a block or span ends."}]
 :seon.ref/text-from [:int {:min 0 :description "The offset at which a block's content (a heading's text, a fence's body, a link's text) starts."}]
 :seon.ref/text-to [:int {:min 0 :description "The offset at which a block's content (a heading's text, a fence's body, a link's text) ends."}]
 :seon.ref/end-line [:int {:min 1 :description "The 1-based line a block ends on."}]
 :seon.ref/heading [:string {:description "A heading's text, or a section's or a view's heading line."}]
 :seon.ref/heading-level [:int {:min 1 :max 6 :description "The level of an ATX heading, 1 to 6."}]
 :seon.ref/items [:vector {:description "A list block's items, each the offsets [from to] of its content after its marker."} [:tuple nat-int? nat-int?]]
 :seon.ref/ordered [:boolean {:description "True when a list block's first marker is a number."}]
 :seon.ref/written [:string {:description "A section's heading as its line writes it, Markdown and all (a code span's backticks)."}]
 :seon.ref/parent [:string {:description "The address of the section that encloses a section."}]
 :seon.ref/lead [:string {:description "A section's lead: the block after its heading when that is a paragraph."}]
 :seon.ref/opening [:string {:description "A section's opening block, shown when it has no paragraph lead."}]
 :seon.ref/text [:string {:description "A block's, section's or file's own text: a section's lines up to the next heading, or a file's whole text."}]
 :seon.ref/summary [:string {:description "A view's summary: its lead's first sentence."}]
 :seon.ref/left [:int {:min 1 :description "How many characters of its lead a summary left out."}]
 :seon.ref/read-at [:string {:description "The address that reads at :doc depth what a summary left out."}]
 :seon.ref/lines [:int {:min 0 :description "The line count of a file that is not Markdown."}]
 :seon.ref/level [:int {:min 1 :description "A section's depth in the page seon.doc/page reads, 1 for the page's own."}]
 :seon.ref/below [:vector {:description "The sections below a view's section (or the vars of a namespace), each {address, heading}."} [:map [:seon.ref/address :string] [:seon.ref/heading :string]]]
 :seon.ref/references [:vector {:description "The edges, at summary depth, of what a stored section's text cites: sections and vars."} :seon.ref/edge]
 :seon.ref/cited-by [:vector {:description "The edges, at summary depth, of the sections that cite a stored section."} :seon.ref/edge]}
