#:seon.step{:position [:int {:min 0 :description "The step's place in its task's order; the order is by position."}]
            :text [:string {:min 1 :description "What the step is."}]
            :status [:enum {:description "At most one step of a task is :current; a step is :done once."} :open :current :done]
            :done-tx [:and {:description "The transaction that completed this step; its db/txInstant is the time. Optional ref: retracting the transaction sweeps the fact."} :seon.db/ref]
            :step [:map {:seon.db/attributes true :seon.program/partition :seon.data}
                   [:seon.step/position :seon.step/position] [:seon.step/text :seon.step/text] [:seon.step/status :seon.step/status]
                   [:seon.step/done-tx {:optional true} :seon.step/done-tx]]
            :view [:map {:description "A step as an agent reads it."}
                   [:seon.step/position :seon.step/position] [:seon.step/text :seon.step/text] [:seon.step/status :seon.step/status]
                   [:seon.step/done-tx {:optional true} :int]]}
