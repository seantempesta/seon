#:seon.ai.attempt{:basis-t [:int {:min 0 :description "The database basis the model request was assembled at: `seon.context/model-context` at this basis is what was sent." :seon.wake/context-inert true}],
                  :finish-reason [:and {:seon.wake/context-inert true} :seon.ai/finish-reason],
                  :response-model [:and {:description "The model id the provider reported in this attempt's response; absent when it reported none." :seon.wake/context-inert true} :seon.ai/response-model],
                  :reasoning-size [:int {:min 1 :seon.wake/context-inert true}],
                  :id [:string {:min 1, :seon.db/identity true :seon.program/row-schema :seon.ai/attempt :seon.wake/context-inert true}],
                  :ordinal [:int {:min 0 :seon.wake/context-inert true}],
                  :reasoning-blob [:and {:seon.wake/context-inert true} :seon.blob/digest],
                  :at [:and {:description "The provider attempt's observed time, which predates its recording transaction. Keep this external-event instant; it is not the recording transaction's time." :seon.wake/context-inert true} :inst],
                  :usage-edn [:string {:description "The exact opaque provider usage payload, including vendor fields absent from the normalized usage counters. These historical bytes survive descriptor deletion; later overwrites do not retain history." :seon.db/no-history? true :seon.wake/context-inert true}],
                  :truncation [:and {:seon.wake/context-inert true} :seon.db/ref],
                  :settings [:and {:description "The mutable settings owner used by this attempt, or the cluster config entity when no agent component exists. Optional peer ref: deleting that owner deliberately sweeps this link. The required settings-edn snapshot preserves the exact historical effective dials independently of the owner's later changes or deletion." :seon.wake/context-inert true} :seon.db/ref],
                  :settings-edn [:string {:description "The exact effective settings observed for this attempt, retained as opaque historical bytes rather than reconstructed from the mutable settings owner. Later overwrites do not retain history." :seon.db/no-history? true :seon.wake/context-inert true}],
                  :reasoning [:and {:seon.wake/context-inert true} :string],
                  :error [:and {:seon.wake/context-inert true} :seon.db/ref]}
