 :seon.db/ref]

 :seon.instrument.explanation/entity
 [:and
 [:map
  {:seon.db/attributes true}
  [:seon.instrument.explanation/ordinal
   :seon.instrument.explanation/ordinal]
  [:seon.instrument.explanation/schema-location
   :seon.instrument.explanation/schema-location]
  [:seon.instrument.explanation/value-location
   :seon.instrument.explanation/value-location]
  [:seon.instrument.explanation/expected-shape
   :seon.instrument.explanation/expected-shape]
  [:seon.instrument.explanation/problem-type
   {:optional true}
   :seon.instrument.explanation/problem-type]
  [:seon.instrument.explanation/actual
   {:optional true}
   :seon.instrument.explanation/actual]
  [:seon.instrument.explanation/humanized
   {:optional true}
   :seon.instrument.explanation/humanized]
  [:seon.instrument.explanation/humanization-unavailable
   {:optional true}
   :seon.instrument.explanation/humanization-unavailable]]
 [:fn
  {:error/message "explanation-complete?",
   :gen/gen seon.error/explanation-complete-generator}
  seon.error/explanation-complete?]]

 :seon.instrument.explanation/expected-shape
 [:string {:min 64, :max 64}]

 :seon.instrument.explanation/humanization-unavailable
 [:string {:min 1}]

 :seon.instrument.explanation/humanized
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.instrument.humanized/entity}
 :seon.db/ref]

