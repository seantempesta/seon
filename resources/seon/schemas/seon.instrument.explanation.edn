 {:seon.db/component true,
  :seon.db/component-schema :seon.error.location/entity}
 :seon.db/ref]

 :seon.instrument.explanation/value-location
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.location/entity}
 :seon.db/ref]
