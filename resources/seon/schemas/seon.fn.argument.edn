#:seon.fn.argument{:index [:int {:description "A contract slot's position in its arity, in call-preparation plans; a stored argument's position is its place in the arity's :seon.fn.arity/arguments vector."}],
                   :rest? :boolean,
                   :binding [:and {:seon.db/component true :seon.db/component-schema :seon.fn.binding/row} :seon.db/ref],
                   :label-edn :string,
                   :label-keyword :keyword,
                   :label-string :string,
                   :label-symbol :symbol,
                   :row
                   [:map
                    #:seon.db{:attributes true :seon.program/partition :seon.program}
                    [:seon.fn.argument/rest? :seon.fn.argument/rest?]
                    [:seon.fn.argument/binding :seon.fn.argument/binding]
                    [:seon.fn.argument/label-edn
                     {:optional true}
                     :seon.fn.argument/label-edn]
                    [:seon.fn.argument/label-keyword
                     {:optional true}
                     :seon.fn.argument/label-keyword]
                    [:seon.fn.argument/label-string
                     {:optional true}
                     :seon.fn.argument/label-string]
                    [:seon.fn.argument/label-symbol
                     {:optional true}
                     :seon.fn.argument/label-symbol]]}
