#:seon.env{:layer [:enum :store :branch :facts :graphs :turn],
           :environment
           [:and
            [:fn
             {:error/message
              "must be an environment value built by seon.env/environment"
              :gen/gen seon.env/environment-generator}
             seon.env/environment?]
            ;; Entry ORDER is the dependency order boot constructs in
            ;; (store -> branch -> facts -> graphs) and the order a refusal
            ;; reports. `:seon.env/layer` names the layer a refusal blames;
            ;; `:seon.env/boot :required` marks a member the 0->1 production
            ;; constructor must have, while ordinary subset construction
            ;; (store + facts, no graphs, no web) leaves it absent.
            [:map
             [:seon.boot/cluster-name
              {:seon.env/layer :store}
              :seon.boot/cluster-name]
             [:seon.db/connection
              {:optional true,
               :seon.env/layer :branch,
               :seon.env/boot :required}
              :seon.db/connection]
             [:seon.schema/projection
              {:optional true,
               :seon.env/layer :facts,
               :seon.env/boot :required}
              :seon.schema/projection]
             [:seon.sci.admit/caps
              {:optional true,
               :seon.env/layer :facts,
               :seon.env/boot :required}
              :seon.sci.admit/caps]
             [:seon.config/on-core-error
              {:optional true,
               :seon.env/layer :facts,
               :seon.env/boot :required}
              :seon.config/on-core-error]
             ;; PRD ruling 9: the read-evidence sink rides the environment as
             ;; an OPTIONAL declared member. The db read path offers evidence
             ;; to it when present; boot never requires one.
             [:seon.db/read-evidence-sink
              {:optional true, :seon.env/layer :facts}
              :seon.db/read-evidence-sink]
             [:seon.flow/work-launcher
              {:optional true,
               :seon.env/layer :graphs,
               :seon.env/boot :required}
              :seon.flow/work-launcher]
             ;; The interrupt arm travels exactly like every other member:
             ;; captured on the submitting thread, adopted on the running
             ;; one. Absent means the submitter was not inside an armed
             ;; evaluation, which is ordinary system-side work.
             [:seon.sci.kernel/arm
              {:optional true, :seon.env/layer :turn}
              :seon.sci.kernel/arm]
             [:seon.cluster.agent/id
              {:optional true, :seon.env/layer :turn}
              :seon.cluster.agent/id]
             [:seon.cluster.run/id
              {:optional true, :seon.env/layer :turn}
              :seon.cluster.run/id]
             [:seon.cluster.run.form/ordinal
              {:optional true, :seon.env/layer :turn}
              :seon.cluster.run.form/ordinal]]]}
