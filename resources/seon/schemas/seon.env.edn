#:seon.env{:layer [:enum :store :branch :facts :graphs :turn],
           :environment-reference
           [:fn
            {:error/message "must be an environment value built by seon.env/environment"
             :gen/gen seon.env/environment-generator
             :seon.schema/identity-only true
             :seon.schema/identity-projection seon.sci.admit/environment-identity}
            seon.env/environment?],
           :environment
           [:and
            [:fn
             {:error/message
              "must be an environment value built by seon.env/environment"
              :gen/gen seon.env/environment-generator}
             seon.env/environment?]
            ;; Entry ORDER is the dependency order boot constructs in
            ;; (store -> branch -> facts -> graphs) and the order a refusal
            ;; reports. `:seon.env/layer` names the layer a refusal blames;
            ;; `:seon.env/boot :required` marks a member the 0->1 production
            ;; constructor must have, while ordinary subset construction
            ;; (store + facts, no graphs, no web) leaves it absent.
            [:map
             [:seon.boot/cluster-name
              {:seon.env/layer :store}
              :seon.boot/cluster-name]
             [:seon.store/store
              {:optional true, :seon.env/layer :store}
              :seon.store/store]
             [:seon.agent/routing
              {:optional true, :seon.env/layer :branch}
              :seon.agent/routing]
             [:seon.db/connection
              {:optional true,
               :seon.env/layer :branch,
               :seon.env/boot :required}
              :seon.db/connection]
             [:seon.schema/projection
              {:optional true,
               :seon.env/layer :facts,
               :seon.env/boot :required}
              :seon.schema/projection]
             [:seon.db/basis-t
              {:optional true,
               :seon.env/layer :facts,
               :seon.env/boot :required}
              :seon.db/basis-t]
             [:seon.sci.admit/caps
              {:optional true,
               :seon.env/layer :facts,
               :seon.env/boot :required}
              :seon.sci.admit/caps]
             ;; The program the cluster booted and the JVM's loaded-program place
             ;; (`seon.sci.eval/projection-state` writes both): the projection
             ;; builder (`seon.db/loaded-builder`) reads them here.
             [:seon.source/commit-id
              {:optional true, :seon.env/layer :facts}
              :seon.source/commit-id]
             [:seon.sci.eval/loaded-identity
              {:optional true, :seon.env/layer :facts}
              :seon.sci.eval/loaded-identity]
             ;; PRD ruling 9: the read-evidence sink rides the environment as
             ;; an OPTIONAL declared member. The db read path offers evidence
             ;; to it when present; boot never requires one.
             [:seon.render/cache
              {:optional true, :seon.env/layer :facts}
              :seon.render/cache]
             [:seon.db/read-evidence-sink
              {:optional true, :seon.env/layer :facts}
              :seon.db/read-evidence-sink]
             [:seon.flow/work-launcher
              {:optional true,
               :seon.env/layer :graphs,
               :seon.env/boot :required}
              :seon.flow/work-launcher]
             ;; The interrupt arm travels exactly like every other member:
             ;; captured on the submitting thread, adopted on the running
             ;; one. Absent means the submitter was not inside an armed
             ;; evaluation, which is ordinary system-side work.
             [:seon.sci.kernel/arm
              {:optional true, :seon.env/layer :turn}
              :seon.sci.kernel/arm]
             [:seon.agent/id
              {:optional true, :seon.env/layer :turn}
              :seon.agent/id]
             [:my.program/executing-ctx
              {:optional true, :seon.env/layer :turn}
              :seon.sci.eval/ctx]
             [:seon.db/db
              {:optional true, :seon.env/layer :turn}
              :seon.db/database-value]
             [:seon.turn/id
              {:optional true, :seon.env/layer :turn}
              :seon.turn/id]
             [:seon.cluster.eval/ordinal
              {:optional true, :seon.env/layer :turn}
              :seon.cluster.eval/ordinal]]]
 :seon.env/boundary :qualified-keyword
 :seon.env/available-members [:set :qualified-keyword]
 :seon.env/provided-member-count [:int {:min 0}]
 :seon.env/absent-environment-error
 [:merge :seon.error/base
  [:map
   [:seon.env/boundary :seon.env/boundary]
   [:seon.env/provided-member-count :seon.env/provided-member-count]
   [:seon.env/available-members {:optional true} :seon.env/available-members]
]]
 :seon.env/agent-environment :seon.boot/cluster-name
 :seon.env/agent-id-absent-error
 [:merge :seon.error/base
  [:map
   [:seon.env/agent-environment :seon.env/agent-environment]
]]
 :seon.env/missing-member :qualified-keyword
 :seon.env/incomplete-environment-error
 [:merge :seon.error/base
  [:map
   [:seon.env/missing-member :seon.env/missing-member]
   [:seon.env/provided-member-count :seon.env/provided-member-count]
   [:seon.env/available-members {:optional true} :seon.env/available-members]
]]
 :seon.env/expected-schema :keyword
 :seon.env/invalid-value-error
 [:merge :seon.error/base
  [:map
   [:seon.env/expected-schema :seon.env/expected-schema]
]]
 :seon.env/missing-schema :qualified-keyword
 :seon.env/unscopable-members [:vector {:min 1} :qualified-keyword]
 :seon.env/unscopable-member-error
 [:merge :seon.error/base
  [:map
   [:seon.env/unscopable-members :seon.env/unscopable-members]
]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.env/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.env/error-member :seon.env/error-member]
  [:seon.env/member-expectation :seon.env/member-expectation]]]

 :seon.env/error-member
 :qualified-keyword

 :seon.env/member-expectation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]
}
