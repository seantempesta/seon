#:my.task{:current [:map {:description "The task an agent holds with its proofs and their status on its branch, and its step as judged (my.task/current); the task and proofs are absent when it holds none."}
                    [:seon.agent/id :seon.agent/id]
                    [:seon.context/task {:optional true} :seon.context/task]
                    [:seon.context/proofs {:optional true} :seon.context/proofs]
                    [:seon.context/step {:optional true} :seon.context/step]
                    [:seon.context/send-backs {:optional true} :seon.context/send-backs]
                    [:seon.context/must-reads {:optional true} :seon.context/must-reads]]
          :reason [:string {:min 1 :description "Why an agent gives its task back without green proofs: the reply root reads."}]
          :target [:and {:description "The task that owns the mistake a send-back names, by symbol."} :seon.task/sym]
          :counterexample [:and {:description "The data showing why the task cannot be made green as written."} :seon.schema/value]
          :send-back-request [:map {:description "A send-back's request: the reason, target and counterexample the caller named, and the database and agent the evaluation's world supplies."}
                              [:seon.db/db :seon.db/database-value] [:seon.agent/id :seon.agent/id] [:my.task/reason :my.task/reason] [:my.task/target {:optional true} :my.task/target]
                              [:my.task/counterexample {:optional true} :my.task/counterexample]]
          :sent-back [:and {:description "A send-back as my.task/send-back! answers it: the completed disposition whose reply is the reason, with the target and counterexample beside it."}
                      :my.turn/completed
                      [:map [:my.task/target {:optional true} :my.task/target]
                       [:my.task/counterexample {:optional true} :my.task/counterexample]]]
          :content-key [:enum {:description "The task members my.task/update! changes: its plan, its instructions and its proofs. Identity, link and control members are not content."} :seon.task/plan :seon.task/instructions :seon.task/proofs]
          :updated [:map {:description "An update as my.task/update! answers it: the task's handle, whether a declaration changed on the agent's branch, and each reference of the new text that does not resolve."}
                    [:seon.task/id :seon.task/id] [:seon.task/changed? :seon.task/changed?]
                    [:my.task/problems {:optional true} :my.task/problems]]
          :update-answer [:or :my.task/updated :my.task/unknown-task-error :my.task/invalid-member-error :seon.task/refused-error :seon.task/conflict-error :seon.error/value]
          :problems [:vector {:description "Each reference of an updated text that does not resolve on the agent's branch, as its problem."} :seon.ref/problem]
          :task [:and {:description "The task symbol a task verb named, as an observed value."} :seon.task/sym]
          :member [:and {:description "The content member my.task/update! changes, and the one whose new value it refused."} :my.task/content-key]
          :function [:fn {:description "The function my.task/update! applies to a member's value."} clojure.core/ifn?]
          :arguments [:vector {:description "The arguments my.task/update! passes to its function after the member's value."} :seon.schema/value]
          :update-request [:map {:description "An update's request: the task, member, function and arguments the caller named, and the connection and agent the evaluation's world supplies."}
                           [:seon.db/connection :seon.db/connection] [:seon.agent/id :seon.agent/id]
                           [:my.task/task :my.task/task] [:my.task/member :my.task/member]
                           [:my.task/function :my.task/function] [:my.task/arguments :my.task/arguments]]
          :no-task-error [:and {:description "my.task/send-back! was called by an agent that holds no task, so there is nothing to give back; it names the reason that went undelivered."} :seon.error/base [:map [:my.task/reason :my.task/reason]]]
          :invalid-member-error [:and {:description "my.task/update! computed a value that does not satisfy the task declaration's schema."} :seon.error/base [:map [:my.task/member :my.task/member]]]
          :unknown-task-error [:and {:description "my.task/update! named a task that does not exist."} :seon.error/base [:map [:my.task/task :my.task/task]]]}
