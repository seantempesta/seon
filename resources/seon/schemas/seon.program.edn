{:seon.program/analyzed-source-digest
 [:string {:min 64 :max 64
           :description "Digest of the exact analyzed input, including resolver context. Its presence records completed analysis even when the computed relations have no members."}]
 :seon.program/analyzed-count [:int {:min 0}]
 :seon.program/edge-symbol
 [:and
  {:description
   "A source-observed program edge name whose pr-str output reads back through clojure.edn/read-string as the same symbol. This refuses clj-kondo's :clj-kondo/unknown-namespace sentinel: a symbol minted from it prints as a keyword and corrupted calls, references, and recorded test reach across EDN boundaries."}
  :qualified-symbol
  [:fn
   {:error/message "must print and read back as the same qualified symbol"
    :gen/schema :qualified-symbol}
   seon.program/edn-round-trip-symbol?]]
 :seon.program/unresolved-callers
 [:vector [:map
           [:seon.program/identity :seon.program/identity]
           [:seon.fn/callee :seon.fn/callee]]]
 :seon.program/stale-test-reach
 [:vector [:map [:seon.test/sym :seon.test/sym]
                [:seon.fn/callee :seon.fn/callee]]]
 :seon.program/unresolved-report
 [:map [:seon.db/basis-t :seon.db/basis-t]
  [:seon.program/analyzed-count :seon.program/analyzed-count]
  [:seon.program/unresolved-callers :seon.program/unresolved-callers]
  [:seon.program/stale-test-reach :seon.program/stale-test-reach]]
 :seon.program/identity-attribute
 [:enum :seon.ns/name :seon.fn/sym :seon.schema/key :seon.test/sym
  :seon.fn.file/relative-path :seon.lint/id]
 :seon.program/source-attribute
 [:enum :seon.ns/source :seon.fn/source :seon.schema/form :seon.test/source
  :seon.fn.file/digest :seon.lint/message]
 :seon.program/row-schema
 [:qualified-keyword
  {:description
   "Declared on a program identity attribute: the entity schema whose map
    declares that family's row. Its declared attributes ARE the attributes the
    static indexer owns, so declaring one there is sufficient — there is no
    second list to extend (seon.program/shapes derives from this link)."}]
 :seon.program/written-by
 [:qualified-symbol
  {:description
   "Declared on one entry of a program entity map: the function that writes
    this attribute instead of the indexer, such as seon.test.runner/record-tx
    for a test's run outcome. The indexer neither keeps nor replaces it, so an
    exact re-index cannot retract another writer's fact."}]
 :seon.program/projected-properties
 [:=
  {:description
   "Declared on a program entity map whose rows also carry every qualified
    Malli property projected onto them, which no map can enumerate: the schema
    family. Its owned attributes are the row's own qualified keys."}
  true]
 :seon.program/schema-row-properties [:= :seon.program/schema-row-properties]
 :seon.program/owned-attributes
 [:or [:vector :qualified-keyword] :seon.program/schema-row-properties]
 :seon.program/identity
 [:tuple :seon.program/identity-attribute :seon.schema/value]
 :seon.program/declaration-row
 [:or {:description "A reader-stage declaration before analysis. Complete stored entity contracts are enforced at the final writer; this stage cannot claim analysis provenance that has not been produced."}
  :seon.ns/ns
  [:map
   [:seon.fn/sym :seon.fn/sym]
   [:seon.fn/ns :seon.fn/ns]
   [:seon.fn/source :seon.fn/source]
   [:seon.fn/arglists :seon.fn/arglists]
   [:seon.fn/private? :seon.fn/private?]
   [:seon.schema.admission/source :seon.schema.admission/source]]
  [:map
   [:seon.schema/key :seon.schema/key]
   [:seon.schema/form :seon.schema/form]]
  [:map
   [:seon.test/sym :seon.test/sym]
   [:seon.test/ns :seon.test/ns]
   [:seon.test/source :seon.test/source]
   [:seon.schema.admission/source :seon.schema.admission/source]]
  :seon.fn.file/file :seon.lint/finding]
 :seon.program/delete-identities [:vector :seon.program/identity]
 :seon.program/source [:string {:min 1}]
 :seon.program/ns [:tuple [:= :seon.ns/name] :seon.ns/name]
 :seon.program/deletion-row
 [:map
  [:seon.program/delete-identities :seon.program/delete-identities]
  [:seon.program/source :seon.program/source]
  [:seon.program/ns {:optional true} :seon.program/ns]]
 :seon.program/row
 [:or :seon.program/declaration-row :seon.program/deletion-row]
 :seon.program/rows [:vector :seon.program/row]
 :seon.program/shape
 [:map
  [:seon.program/identity-attribute :seon.program/identity-attribute]
  [:seon.program/source-attribute :seon.program/source-attribute]
  [:seon.program/owned-attributes :seon.program/owned-attributes]]
 :seon.program/shapes
 [:map-of
  {:description
   "The derived program-row shapes one operation owns its rows by, keyed by
    identity attribute (seon.program/shapes-in derives them from a declaration
    population). An operation resolves its population ONCE and hands THIS value
    to every per-row question, so the declaration world cannot be re-resolved
    per row. It is a distinct schema from the population itself: a population's
    keys are ordinary attribute keywords, so handing one where shapes are
    expected is a typed refusal instead of a row silently stripped of every
    attribute its family owns."}
  :seon.program/identity-attribute :seon.program/shape]
 :seon.program/position [:int {:min 0}]
 :seon.program/no-declaration-at [:= true]
 :seon.program/no-declaration-at-error
 [:map {:seon.error/class true
        :seon.render/ai seon.error/render-ai
        :seon.render/html seon.error/render-html
        :error/message "must name the position no declaration span contains"}
  [:seon.program/no-declaration-at :seon.program/no-declaration-at]
  [:seon.error/message :seon.error/message]]
 :seon.program/declaration-refused [:= true]
 :seon.program/declaration-refused-error
 [:map {:seon.error/class true
        :seon.render/ai seon.error/render-ai
        :seon.render/html seon.error/render-html
        :error/message "must mark a program declaration refused by canonical admission"}
  [:seon.program/declaration-refused :seon.program/declaration-refused]
  [:seon.error/message :seon.error/message]]
 :seon.program/subject
 [:or {:description "A function or test symbol, namespace symbol, or schema key."}
  :symbol :qualified-keyword]
 :seon.program/kind
 [:and {:description "The identity attribute that answered this read; never a stored entity discriminator."}
  :seon.program/identity-attribute]
 :seon.program/contract :seon.fn/spec
 :seon.program/callers [:set :qualified-symbol]
 :seon.program/references [:set :qualified-symbol]
 :seon.program/subject-of [:set :qualified-symbol]
 :seon.program/stale-reach [:set :qualified-symbol]
 :seon.program/gating [:vector :qualified-symbol]
 :seon.program/call-sites
 [:vector
  [:map
   [:seon.fn/sym :qualified-symbol]
   [:seon.fn/form-span {:optional true} :seon.fn/form-span]
   [:seon.fn/call-arity {:optional true} :seon.fn/call-arity]
   [:seon.fn/declared-arities {:optional true} :seon.fn/declared-arities]]]
 :seon.program/render-declared-by
 [:set [:map [:seon.schema/key :seon.schema/key]
        [:seon.schema/property [:enum :seon.render/ai :seon.render/html]]]]
 :seon.program/capability-of [:set :qualified-symbol]
 :seon.program/schedule-tasks [:set :seon.schedule.task/id]
 :seon.program/writes-of [:set :qualified-symbol]
 :seon.program/contract-refs [:set :qualified-symbol]
 :seon.program/schema-references [:set :qualified-keyword]
 :seon.program/requiring-namespaces [:set :symbol]
 :seon.program/owned-declarations [:set :seon.program/subject]
 :seon.program/mentions
 [:set {:description "Literal keyword membership; neither a read claim nor a refusal input."}
  :qualified-symbol]
 :seon.program/data-in-use
 [:map [:seon.schema/key :seon.schema/key]
  [:seon.schema/datoms [:int {:min 1}]]]
 :seon.program/gap
 [:enum {:description "Closed diagnostic categories for limitations of this program read, not entity kinds."}
  :dispatch-not-modelled :arity-unknown-sites :macro-mediated
  :unresolvable-callers :keyword-mentions :outside-graph
  :launch-unavailable :contract-shapes-unknown :provenance-unavailable]
 :seon.program/unknown
 [:vector {:min 1}
  [:map
   [:seon.program/gap :seon.program/gap]
   [:seon.program/message :string]
   [:seon.program/count {:optional true} [:int {:min 0}]]
   [:seon.program/macros {:optional true} [:set :qualified-symbol]]
   [:seon.program/subjects {:optional true} [:set :qualified-symbol]]]]
 :seon.program/plan
 [:map
  [:seon.program/issues [:vector :seon.issue/issue]]
  [:seon.program/launch
   [:sequential {:description "Unevaluated launch form. The read's unknowns state why launch is unavailable before value-edge admission."}
    :seon.schema/value]]]
 :seon.program/breakage
 [:map {:description "Pure program-fact read. Empty relation groups are absent; unknown coverage is always explicit."
        :seon.render/ai seon.render.value/render-ai
        :seon.render/html seon.render.value/render-html}
  [:seon.program/subject :seon.program/subject]
  [:seon.program/kind :seon.program/kind]
  [:seon.db/basis-t :seon.db/basis-t]
  [:seon.program/unknown :seon.program/unknown]
  [:seon.program/callers {:optional true} :seon.program/callers]
  [:seon.program/references {:optional true} :seon.program/references]
  [:seon.program/call-sites {:optional true} :seon.program/call-sites]
  [:seon.program/subject-of {:optional true} :seon.program/subject-of]
  [:seon.program/stale-reach {:optional true} :seon.program/stale-reach]
  [:seon.program/gating {:optional true} :seon.program/gating]
  [:seon.program/render-declared-by {:optional true} :seon.program/render-declared-by]
  [:seon.program/capability-of {:optional true} :seon.program/capability-of]
  [:seon.program/schedule-tasks {:optional true} :seon.program/schedule-tasks]
  [:seon.program/writes-of {:optional true} :seon.program/writes-of]
  [:seon.program/contract-refs {:optional true} :seon.program/contract-refs]
  [:seon.program/schema-references {:optional true} :seon.program/schema-references]
  [:seon.program/requiring-namespaces {:optional true} :seon.program/requiring-namespaces]
  [:seon.program/owned-declarations {:optional true} :seon.program/owned-declarations]
  [:seon.program/data-in-use {:optional true} :seon.program/data-in-use]
  [:seon.program/mentions {:optional true} :seon.program/mentions]
  [:seon.program/plan {:optional true} :seon.program/plan]]
 :seon.program/definition
 [:map-of {:description "A program row's exact attribute values at one basis. Families and authored contracts are polymorphic; refs remain datom entity ids."}
  :qualified-keyword :seon.schema/value]
 :seon.program/history-entry
 [:map
  [:seon.db/tx :seon.db/tx]
  [:seon.db/added? :boolean]
  [:seon.program/source :seon.program/source]
  [:seon.program/definition :seon.program/definition]
  [:seon.db/user {:optional true} :seon.db/ref]
  [:seon.db/process {:optional true} :seon.db/ref]]
 :seon.program/history [:vector :seon.program/history-entry]
 :seon.program/history-report
 [:map
  [:seon.program/subject :seon.program/subject]
  [:seon.program/kind :seon.program/kind]
  [:seon.db/basis-t :seon.db/basis-t]
  [:seon.db/tx {:optional true} :seon.db/tx]
  [:seon.program/unknown :seon.program/unknown]
  [:seon.program/history :seon.program/history]]
 :seon.program/read-refused [:= true]
 :seon.program/read-refused-error
 [:map {:seon.error/class true
        :seon.render/ai seon.error/render-ai
        :seon.render/html seon.error/render-html
        :error/message "must identify a program read that could not complete"}
  [:seon.program/read-refused :seon.program/read-refused]
  [:seon.error/message :seon.error/message]]
 :seon.program/not-found :seon.program/subject
 :seon.program/not-found-error
 [:map {:seon.error/class true
        :seon.render/ai seon.error/render-ai
        :seon.render/html seon.error/render-html
