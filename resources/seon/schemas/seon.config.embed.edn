#:seon.config.embed{:endpoint
                    [:string
                     {:min 1,
                      :description
                      "The embed server's embedding URL: POST texts, task, dim and encoding.",
                      :seon.config/dial true}],
                    :model
                    [:string
                     {:min 1,
                      :description
                      "The model the embed server serves; part of every embedding key, so new weights never reuse old vectors.",
                      :seon.config/dial true}],
                    :dimension
                    [:int
                     {:min 1,
                      :max 768,
                      :description
                      "The Matryoshka dimension stored per embedding.",
                      :seon.config/dial true}],
                    :request-bytes
                    [:int
                     {:min 1,
                      :description
                      "UTF-8 bytes of text per embed-server request: a pass sorts its backlog by length and cuts it at this budget (seon.embed/requests).",
                      :seon.config/dial true}],
                    :timeout-ms
                    [:int
                     {:min 1,
                      :description
                      "The deadline of one embed-server request.",
                      :seon.config/dial true}],
                    :wait-ms
                    [:int
                     {:min 0,
                      :description
                      "How long a call ranking texts by embedding waits for an index still being derived before it answers in progress (seon.embed/similar).",
                      :seon.config/dial true}]}
