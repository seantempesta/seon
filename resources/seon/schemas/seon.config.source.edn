;; Seon's own source as the program (session LOOP, seon.source tasks): which repository root
;; imports at boot and where merges that change it are committed. Values, units and provenance:
;; resources/seon/config/default.edn.
{:seon.config.source/root [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "The repository whose dirs main imports at boot (when main holds none of them) and whose merges branch receives the write-back; absent: no source is imported or written."}]
 :seon.config.source/dirs [:vector {:seon.config/place true :seon.db/data true :seon.config/unit "paths" :description "The source directories under the root that are the program, relative to it."} [:string {:min 1}]]
 :seon.config.source/branch [:string {:seon.config/place true :min 1 :seon.config/unit "branch" :description "The git branch of the root each merge that changes the source is committed on (never main, never pushed)."}]
 :seon.config.source/committer-name [:string {:min 1 :seon.config/unit "name" :description "The author and committer of Seon's commits on the merges branch."}]
 :seon.config.source/committer-email [:string {:min 1 :seon.config/unit "email" :description "The email of Seon's commits on the merges branch."}]
 :seon.config.source/generations-dir [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "Where each generation is built: <dir>/<commit>, a worktree of the merges commit whose target/seon the next root runs."}]
 :seon.config.source/test-results-dir [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "The one content-addressed directory of test results, shared by every checkout and worktree: one file per reach digest (seon.proofs/plan: bin/prove, bin/test)."}]}
