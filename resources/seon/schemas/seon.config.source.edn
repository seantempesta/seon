;; Seon's own source as the program (session LOOP, seon.source tasks): which repository root
;; imports at boot and where merges that change it are committed. Values, units and provenance:
;; resources/seon/config/default.edn.
{:seon.config.source/gate-checkout [:string {:min 1 :seon.config/unit "path" :description "The checkout a merge's deferred process tests run on (a worktree of it at the merges head, seon.fx/run-tests): the standing root's merges tree. Absent: a merge reaching process tests merges with them unrun, an open problem until they run (root's git merge runs them, bin/prove)."}]
 :seon.config.source/root [:string {:min 1 :seon.config/unit "path" :description "The repository whose dirs main imports at boot (when main holds none of them) and whose merges branch receives the write-back; absent: no source is imported or written."}]
 :seon.config.source/dirs [:vector {:seon.db/data true :seon.config/unit "paths" :description "The source directories under the root that are the program, relative to it."} [:string {:min 1}]]
 :seon.config.source/branch [:string {:min 1 :seon.config/unit "branch" :description "The git branch of the root each merge that changes the source is committed on (never main, never pushed)."}]
 :seon.config.source/committer-name [:string {:min 1 :seon.config/unit "name" :description "The author and committer of Seon's commits on the merges branch."}]
 :seon.config.source/committer-email [:string {:min 1 :seon.config/unit "email" :description "The email of Seon's commits on the merges branch."}]
 :seon.config.source/generations-dir [:string {:min 1 :seon.config/unit "path" :description "Where each generation is built: <dir>/<commit>, a worktree of the merges commit whose target/seon the next root runs."}]
 :seon.config.source/tests-dir [:string {:min 1 :seon.config/unit "path" :description "Where a merge's deferred process tests run: <dir>/<sha>-<uuid>, a worktree of the merges head with the candidate's files, removed after; its log beside it."}]
 :seon.config.source/test-results-dir [:string {:min 1 :seon.config/unit "path" :description "The one content-addressed directory of test results, shared by every checkout and worktree: one file per reach digest (seon.proofs/plan: bin/prove, bin/test)."}]}
