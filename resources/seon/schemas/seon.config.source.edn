;; Seon's own source as the program (session LOOP, seon.source tasks): which repository root
;; imports at boot and where merges that change it are committed. Values, units and provenance:
;; resources/seon/config/default.edn.
{:seon.config.source/gate-checkout [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "The checkout a merge's deferred process tests run on (a worktree of it at the merges head, seon.fx/run-tests): the standing root's merges tree. Absent: a merge reaching process tests merges with them unrun, an open problem until they run (root's git merge runs them, bin/prove)."}]
 :seon.config.source/root [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "The repository whose dirs main imports at boot (when main holds none of them) and whose merges branch receives the write-back; absent: no source is imported or written."}]
 :seon.config.source/dirs [:vector {:seon.config/place true :seon.config/unit "paths" :description "The source directories under the root that are the program, relative to it."} [:string {:min 1}]]
 :seon.config.source/program-dirs [:vector {:seon.config/unit "paths" :description "Of the source directories, those holding the program proper rather than its tests: a namespace whose file is under one is the program's."} [:string {:min 1}]]
 :seon.config.source/process-vars [:set {:seon.config/unit "vars" :description "The vars through which a test reaches a process of its own (a shell, a fork, a root, the binary): a test whose reach references one is a process test, never run automatically, only when named."} :qualified-symbol]
 :seon.config.source/process-entry [:set {:seon.config/unit "vars" :description "What the processes a test starts run for it: the server's answer (a multimethod on a request's :op, of which a form reaches only the methods of the ops it sends, its :form/ops) and the agent's turn loop, which root sends the agent as a quoted form; not a root's boot, which is every process test's. A form that uses a process var or a binary var has a reach edge to each (seon.program/reach-step), where a request over a socket and a quoted form would leave it out."} :qualified-symbol]
 :seon.config.source/runtime-pins [:set {:seon.config/unit "submodule paths" :description "The submodules the runtime every test and contract key runs on is built from (Jolt, Chez): their gitlinks (a dirty one's files as they are) are in every digest's :env (seon.fx/inputs), so a bump re-runs every test once. See docs/source.md#tests-run-by-reach."} [:string {:min 1}]]
 :seon.config.source/pin-namespaces [:map-of {:seon.config/unit "namespace prefix -> submodules" :description "The submodules (reference-code/NAME), the code of a namespace prefix runs on, its own and its dependencies: a form referencing a namespace under a prefix has a test take those classes (seon.config/pin-class, a :seon.pin/* entry of :config, seon.fx/inputs). A submodule no prefix names and no :seon.config.source/runtime-pins holds takes no pin. A library used through interop or a :require with no var reference is not seen (the daily full run is the net)."} :symbol [:set :string]]
 :seon.config.source/binary-vars [:set {:seon.config/unit "vars" :description "The vars through which a test reaches the built binary (target/seon): a test whose reach references one needs it built from the tree, so bin/test builds it first; nothing else triggers a build."} :qualified-symbol]
 :seon.config.source/tree-excludes [:vector {:seon.config/unit "paths" :description "Top-level paths of the checkout left out of its tree id (seon.fx/tree-id, bin/tree): none is read by a test or the build, so a commit to one moves no digest and rebuilds nothing."} [:string {:min 1}]]
 :seon.config.source/main [:string {:seon.config/place true :min 1 :seon.config/unit "branch" :description "Git's main branch, the one worktree branches merge into: a branch's health is what it caused since its merge base with it (seon.fx/base-commit)."}]
 :seon.config.source/branch [:string {:seon.config/place true :min 1 :seon.config/unit "branch" :description "The git branch of the root each merge that changes the source is committed on (never main, never pushed)."}]
 :seon.config.source/committer-name [:string {:min 1 :seon.config/unit "name" :description "The author and committer of Seon's commits on the merges branch."}]
 :seon.config.source/committer-email [:string {:min 1 :seon.config/unit "email" :description "The email of Seon's commits on the merges branch."}]
 :seon.config.source/generations-dir [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "Where each generation is built: <dir>/<commit>, a worktree of the merges commit whose target/seon the next root runs."}]
 :seon.config.source/tests-dir [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "Where a merge's deferred process tests run: <dir>/<sha>-<uuid>, a worktree of the merges head with the candidate's files, removed after; its log beside it."}]}
