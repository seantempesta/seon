{:seon.sci.reader/tag :symbol
 :seon.sci.reader/token :string
 :seon.sci.reader/token-kind [:enum :symbol :keyword]
 :seon.sci.reader/call :qualified-symbol
 :seon.sci.reader/argument-index [:int {:min 0}]
 :seon.sci.reader/prose-span? :boolean
 :seon.sci.reader/containers
 [:vector [:map
           [:edamame/opened-delimiter :string]
           [:edamame/row :int]
           [:edamame/column :int]
           [:edamame/elements [:vector :seon.schema/value]]]]

 :seon.sci.reader/fabricated-response-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.reader/response-keys :seon.sci.reader/response-keys]]]

 :seon.sci.reader/unreadable-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.reader/unreadable-member :seon.sci.reader/unreadable-member]]]

 :seon.sci.reader/oversize-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.reader/length :seon.sci.reader/length] [:seon.sci.reader/source-bound :seon.sci.reader/source-bound]]]

 :seon.sci.reader/refused-tag-error [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
 :seon.error/base
 [:map [:seon.sci.reader/refused-token :seon.sci.reader/refused-token]]]


 ; Additive error declaration manifest, 2026-09-18.

 :seon.sci.reader/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.reader/source-projection
   :seon.sci.reader/source-projection]
  [:seon.sci.reader/reader-location :seon.sci.reader/reader-location]]]

 :seon.sci.reader/reader-location
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.location/entity}
 :seon.db/ref]

 :seon.sci.reader/source-projection
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

:seon.sci.reader/unreadable-member :qualified-keyword
:seon.sci.reader/refused-token [:or :symbol :string]
:seon.sci.reader/length [:int {:min 0}]
:seon.sci.reader/source-bound [:int {:min 0 :description "The character bound actually supplied to this pure reader, including a zero bound."}]
:seon.sci.reader/response-keys [:set {:min 1} :qualified-keyword]
:seon.sci.reader/failure [:or :seon.sci.reader/unreadable-error :seon.sci.reader/refused-tag-error :seon.sci.reader/oversize-error :seon.sci.reader/fabricated-response-error]
}
