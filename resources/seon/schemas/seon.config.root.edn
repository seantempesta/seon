;; Root and its procs (new in next: v1's root was a JVM with other bounds). Values, units and
;; provenance: resources/seon/config/default.edn.
{:seon.config.root/max-agents [:int {:min 1 :seon.config/unit "agents" :description "Live agents at most; a spawn past it is refused (root holds a socket per agent)."}]
 :seon.config.root/api-writes [:int {:min 1 :seon.config/unit "requests" :description "Writer requests from the api in flight at most; at the bound the api reads only answers."}]
 :seon.config.root/api-batch [:int {:min 1 :seon.config/unit "messages" :description "Most messages one api step takes before applying its graph change."}]
 :seon.config.root/writer-batch [:int {:min 1 :seon.config/unit "requests" :description "Most requests one writer step drains and commits together (group commit)."}]
 :seon.config.root/writer-buf [:int {:min 1 :seon.config/unit "requests" :description "The writer's in-port; beyond it senders park."}]
 :seon.config.root/wiki-baseline [:boolean {:seon.config/unit "on/off" :description "Whether a load of the wiki takes, for each section with no record of the code it was written against, that record from git (the commit that last changed the section; seon.docs/baseline-reads). Off: such a section is recorded as of today."}]
 :seon.config.root/reconciler-buf [:int {:min 1 :seon.config/unit "commits" :description "Main's commits queued for the reconciler; a full buffer parks the writer."}]
 :seon.config.root/standby-every [:int {:min 1 :seon.config/unit "commits" :description "Main commits after which the fork server forks a fresh standby."}]
 :seon.config.root/runs-dir [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "Where kept runs live (never deleted)."}]
 :seon.config.root/store-path [:string {:seon.config/place true :min 1 :seon.config/unit "path" :description "The one store every root works in, on its own main branch."}]
 :seon.config.root/main [:string {:seon.config/place true :min 1 :seon.config/unit "branch" :description "Root's main branch, resumed at every boot; made from :db when the store has none."}]
 :seon.config.root/system-path [:string {:min 1 :seon.config/unit "path" :description "Root's system declaration (system.edn), read with aero."}]
 :seon.config.root/tasks-dir [:string {:min 1 :seon.config/unit "path" :description "The task files my.root/task-files reads."}]
 :seon.config.root/gc-sweepers [:int {:min 0 :seon.config/unit "threads" :description "Chez parallel-collector sweepers in root, fixed at boot after the fork server is forked; 0: collect on the triggering thread."}]}
