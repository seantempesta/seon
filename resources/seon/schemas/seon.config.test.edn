#:seon.config.test{:auto-check-cases
                   [:int {:min 0, :seon.config/dial true}]
                   :step-time-limit-ms
                   [:int
                    {:min 1, :seon.config/optional true,
                     :description
                     "Milliseconds the automatic test step may spend on one pass: the proofs, then the tests reaching the change. A started member runs to its exit and records; the members not yet started continue at the next pass.",
                     :seon.config/default 10000,
                     :seon.config/dial true}]
                   :step?
                   [:boolean
                    {:seon.config/display-label "Test step" :seon.config/optional true,
                     :description
                     "True: a pass that evaluated a form runs the held task's proofs and the tests reaching the branch's change before it answers. False: no automatic test step; an agent runs its tests by request.",
                     :seon.config/default true,
                     :seon.config/dial true}]}
