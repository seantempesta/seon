#:seon.config.agent{:inbox-size
                    [:int {:min 1 :seon.config/dial true
                           :seon.config/display-label "Inbox size"
                           :description "Message values an agent's Flow inbox accepts before a send answers full. Acquired when the graph starts."}],
:show-all-settings
                    [:=
                     {:seon.config/display-label "Show all settings" :seon.config/per-agent true,
                      :seon.config/optional true,
                      :description
                      "Show every effective agent setting in the settings read. Presence asserts true; absence shows model, no-provider, evaluation deadline, and turn budget. Clear this setting by retracting it.",
                      :seon.config/dial true} true],
                    :keep-ended-branches?
                    [:boolean
                     {:seon.config/display-label "Keep ended branches"
                      :description
                      "Keep every ended branch as history instead of deleting it: an assignment's branch once its merge request closes (seon.cluster.agent/next-actions, seon.task/close!), and a chain's branch with the merge branches its tasks name once the chain publishes (seon.cluster.agent/finish-chains!). Its work ends either way (seon.task/end-branch!: graphs joined, connections and root's route released); with this true the branch stays readable by its name, found from main by the rows naming it (:seon.task/branch), until root retires it (my.agent/retire-branch!). An error end's branch is always kept. Read through seon.config/keeps-ended-branches?.",
                      :seon.config/dial true}],
                    :max-running
                    [:int
                     {:seon.config/display-label "Running attempts" :min 0,
                      :description
                      "Open attempts db<->flow keeps running or paused at once on this cluster; a ready leaf beyond it waits for an end. Counted on facts (attempts with no end), so it holds across a restart. 0 starts nothing new while running work finishes.",
                      :seon.config/dial true}],
                    :write-refusal-bound
                    [:int
                     {:seon.config/display-label "Write refusal bound" :min 1,
                      :seon.config/per-agent true,
                      :description
                      "Consecutive REFUSED durable turn writes for one agent before its turn proc parks. A refused write still flushes dirty index leaves, so re-firing one fills the store without ever committing: at this bound the proc commits ONE fault naming the refusal, the agent, the consecutive count and this bound, and stops re-firing. A committed write resets the count to zero. Firing is a bug report, never a retry or a backoff.",
                      :seon.config/dial true}],
                    :turn-completion-backstop-ms
                    [:int
                     {:seon.config/display-label "Turn completion allowance" :seon.config/display-divisor 1000 :seon.config/display-unit "s" :min 1,
                      :seon.config/per-agent true,
                      :description
                      "Milliseconds allowed for turn lifecycle completion, including permit acquisition and orderly disarm. Active work adds its resolved provider attempt timeout, or each admitted form's evaluation limit. Expiry names the missing part and held turn.",
                      :seon.config/dial true}]}
