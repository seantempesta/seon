;; Agents (v1: seon.config.agent.edn's max-running and inbox-size, ported; max-turns was
;; next's task dial; the rest are new in next, where an agent is a forked process).
{:seon.config.agent/max-running [:int {:min 0 :seon.config/unit "attempts" :description "Attempts running at once; a ready task beyond it waits for an end. 0 starts nothing new."}]
 :seon.config.agent/max-turns [:int {:min 1 :seon.config/unit "turns" :description "Turns an attempt may take when its task sets none."}]
 :seon.config.agent/cwd [:string {:min 1 :seon.config/unit "path" :description "Every agent process's working directory, with no repository above it."}]
 :seon.config.agent/inbox-size [:int {:min 1 :seon.config/unit "messages" :description "Each agent channel's buffer; a full channel pushes back on its sender."}]
 :seon.config.agent/trip-bytes [:int {:min 65536 :seon.config/unit "bytes" :description "Chez's collect-trip-bytes in an agent: allocation between collections."}]
 :seon.config.agent/heap-extra-bytes [:int {:min 1048576 :seon.config/unit "bytes" :description "How far an agent's heap may grow past what it inherited; past it an allocation throws OutOfMemoryError."}]
 :seon.config.agent/sock-buf-bytes [:int {:min 4096 :seon.config/unit "bytes" :description "Each socket's send and receive buffer (root, fork server and agents)."}]
 :seon.config.agent/form-ticks [:int {:min 0 :seon.config/unit "engine ticks" :description "Work one form the model or an outside agent sends may do before it stops with :seon.repl/ticks-spent. 0: none."}]
 :seon.config.agent/test-ticks [:int {:min 0 :seon.config/unit "engine ticks" :description "Work one proof run may do before it stops with :seon.test/ticks-spent naming the running test. 0: none."}]
 :seon.config.agent/top-fns [:int {:min 1 :seon.config/unit "functions" :description "An evaluation's costliest contracted functions its record keeps (seon.repl/wrap-cost)."}]}
