;; How Seon's processes are built and compile (bin/env, bin/build). Values, units and provenance:
;; resources/seon/config/default.edn.
{:seon.config.build/inputs [:vector {:min 1 :seon.config/unit "paths and prefixes (ending in /)" :description "What only a build can change: the paths bin/build compiles or bakes into target/seon, beside every pin. The binary identity (bin/binary-digest) is their digest at a commit."} [:string {:min 1}]]
 :seon.config.build/jolt-compiler-options [:string {:min 2 :seon.config/unit "an EDN map, as text" :description "Jolt's compile options for everything a Seon process compiles, exported by bin/env as JOLT_COMPILER_OPTIONS."}]
 :seon.config.build/jolt-cache-mb [:int {:min 256 :seon.config/unit "megabytes" :description "The byte budget of Jolt's compiled-code cache, least recently used first, exported by bin/env as JOLT_CACHE_MB. See docs/source.md#shared-build-caches."}]}
