;; How Seon's processes are built and compile (bin/env, bin/build).
;; Each entry's :default is its shipped value, with its unit,
;; provenance and what happens at its bound in the comment above it; a value read from the process (#env, a path
;; under the checkout, a #profile choice) is resources/seon/config/default.edn's (docs/config.md#layers).
{
 ;; What only a build can change: the paths bin/build compiles or bakes into target/seon, besides every
 ;; pin (a gitlink .gitmodules names, read from the tree). The binary's identity is the digest of these at a
 ;; tree (seon.fx/binary-digest, recorded with the binary in target/seon.program); a process whose
 ;; branch's digest differs is built for, once (seon.fx/runtime-for). The program (src/'s forms) is not
 ;; here: a process loads it from its branch as a diff (docs/source.md#the-binary-records-its-program). Nor are the
 ;; config and schemas (a process holds its branch's: seon.program/hold-config!, seon.agent/schema-moved): only the config
 ;; keys a schema marks :seon.config/build (the compiler reads it), :seon.config/at-load or :seon.config/place (only a new
 ;; process acts on them) enter the digest, read as data. resources/seon/system.edn is: a
 ;; boot reads the binary's copy (seon.graph/read-decl's built-text), and nothing applies a changed one in place yet
 ;; (seon.system/apply!, uncalled), so a changed graph restarts on a build. INTERIM (root 2026-11-15): system.edn leaves this
 ;; list when G swaps changed procs through Flow's update! with no restart (task
 ;; seon.system/a-landing-restarts-root-only-for-a-binary-change). A path or prefix ending in /.
 :seon.config.build/native-libs [:map-of {:seon.config/unit "variable to file" :description "The native libraries a root loads from its build's target/lib, each by the environment variable the library's loader reads (JOLT_LMDB_LIB: konserve.jolt.lmdb-ffi; JOLT_LZ4_LIB, JOLT_ZSTD_LIB: the store's codecs). A switch-over's successor takes each from its own build (seon.fx/successor-env), never the old root's, whose generation may be removed. See docs/source.md#the-next-generation."} :string :string]
 :seon.config.build/inputs [:vector {:default ["deps.edn" "bin/build" ".gitmodules" "native/" "resources/public/" "resources/seon/system.edn" "resources/seon/schemas/"] :min 1 :seon.config/unit "paths and prefixes (ending in /)" :description "What only a build can change: the paths bin/build compiles or bakes into target/seon, beside every pin (the schemas too: seon.config/schema-forms bakes them at compile). The binary identity (seon.fx/binary-digest) is their digest at a tree."} [:string {:min 1}]]
 :seon.config.build/jolt-compiler-options [:string {:min 2 :seon.config/build true :seon.config/unit "an EDN map, as text" :description "Jolt's compile options for everything a Seon process compiles, exported by bin/env as JOLT_COMPILER_OPTIONS."}]
 :seon.config.build/jolt-cache-mb [:int {:min 256 :seon.config/unit "megabytes" :description "The byte budget of Jolt's compiled-code cache, least recently used first, exported by bin/env as JOLT_CACHE_MB. See docs/source.md#shared-build-caches."}]
 :seon.config.build/jolt-whole-program-inference [:boolean {:seon.config/build true :seon.config/unit "on/off" :description "Whether jolt build runs its whole-program type inference; false exports JOLT_NO_WP_INFER=1 (bin/env), and emit infers per namespace. See docs/source.md#shared-build-caches."}]}
