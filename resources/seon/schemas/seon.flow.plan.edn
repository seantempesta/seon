#:seon.flow.plan
{:startable [:set {:description "The ready leaves that validate (seon.task/ready ∩ valid): what db<->flow may start."} :seon.task/handle]
 :invalid [:set {:description "The :running leaves that do not validate: each becomes a problem task, never an attempt."} :seon.task/handle]
 :open-attempt [:map {:description "One attempt with no end, as db<->flow plans over it: its task, key, agent, branch and the task's intent now."}
                [:seon.task/assigned :seon.task/assigned]
                [:seon.task/assignment :seon.task/assignment]
                [:seon.agent/id :seon.agent/id]
                [:seon.task/branch :seon.task/branch]
                [:seon.task/execution :seon.task/execution]]
 :open [:vector {:description "Every attempt on main with no end."} :seon.flow.plan/open-attempt]
 :ended [:map-of {:description "Per task, its ended attempts: its next attempt is one more."} :seon.task/handle [:int {:min 0}]]
 :created [:map-of {:description "Per task, the transaction of its identity datom: the oldest starts first."} :seon.task/handle [:int {:min 0}]]
 :basis [:map-of {:description "Per task, the end commits of its done needs: the fork point of its next attempt."} :seon.task/handle [:set :uuid]]
 :cluster [:enum {:description "The cluster's intent: :paused starts nothing new and pauses every graph."} :running :paused]
 :facts [:map {:description "What db<->flow reads on main before it plans (seon.cluster.agent/plan-facts)."}
         [:seon.flow.plan/startable :seon.flow.plan/startable]
         [:seon.flow.plan/invalid :seon.flow.plan/invalid]
         [:seon.flow.plan/open :seon.flow.plan/open]
         [:seon.flow.plan/ended :seon.flow.plan/ended]
         [:seon.flow.plan/created :seon.flow.plan/created]
         [:seon.flow.plan/basis :seon.flow.plan/basis]
         [:seon.flow.plan/cluster :seon.flow.plan/cluster]]
 :started [:set {:description "The agents whose graph the registry holds."} :seon.agent/id]
 :paused? [:boolean {:description "Whether db<->flow left or put this started graph paused (its intent, or the cluster's, is not :running)."}]
 :paused [:set {:description "The started agents whose graph db<->flow paused."} :seon.agent/id]
 :registry [:map {:description "What db<->flow reads of the registry before it plans: the live graphs by agent."}
          [:seon.flow.plan/started :seon.flow.plan/started]
          [:seon.flow.plan/paused :seon.flow.plan/paused]]
 :op [:enum {:description "One effect db<->flow applies: write an attempt, start its flow, write a problem task, make a graph follow its intent; or, for an ended assignment (seon.cluster.agent/next-actions), write its missing merge base, squash-merge its branch, publish its merged declarations into the checkout, write its non-merged end on main, stop its graph, delete its branch."}
      :attempt :start-flow :problem :pause :resume :stop :cancel :merge-base :merge :publish :close :delete-branch]
 :fork-point [:or {:description "Where an attempt's branch forks: main's head, or the end commits of the task's done needs."}
              [:= :main] [:set {:min 1} :uuid]]
 :class [:enum {:description "Which problem a :problem action records."} :invalid-task]
 :action [:map {:description "One planned effect. :attempt carries the next attempt's number and fork point; :start-flow the intent its graph starts under; a taskless agent's :stop and :delete-branch name no task."}
          [:seon.flow.plan/op :seon.flow.plan/op]
          [:seon.task/assigned {:optional true} :seon.task/assigned]
          [:seon.task/assignment {:optional true} :seon.task/assignment]
          [:seon.task.attempt/number {:optional true} :seon.task.attempt/number]
          [:seon.agent/id {:optional true} :seon.agent/id]
          [:seon.task/branch {:optional true} :seon.task/branch]
          [:seon.task.attempt/end {:optional true} :seon.task.attempt/end]
          [:seon.task/execution {:optional true} :seon.task/execution]
          [:seon.flow.plan/fork-point {:optional true} :seon.flow.plan/fork-point]
          [:seon.flow.plan/class {:optional true} :seon.flow.plan/class]
          [:db/id {:optional true} :seon.db/entity-id]]
 :actions [:vector :seon.flow.plan/action]
 :main-end [:and {:description "The end main holds on an assignment, beside the end its branch holds."} :seon.task.attempt/end]
 :head [:and {:description "The commit an assignment's branch head names now."} :seon.source/commit-id]
 :started? [:boolean {:description "Whether the registry holds the assignment's agent's graph."}]
 :kept? [:boolean {:description "Whether a merged branch stays: its cluster keeps ended branches (:seon.config.agent/keep-ended-branches?), or a successor still forks from its end commit."}]
 :publish? [:boolean {:description "Present (true) when the assignment merged declarations main records no git commit or refusal for: its publication into the checkout is due (seon.merge/publish!)."}]
 :held-assignment [:map {:description "One assignment whose branch the store holds, as db<->flow derives its lifecycle from it (seon.cluster.agent/lifecycle-facts): its end (main's, else its branch head's), its merge base and head, whether its graph runs and whether its branch stays once merged."}
                   [:db/id :seon.db/entity-id]
                   [:seon.task/assignment :seon.task/assignment]
                   [:seon.task/assigned :seon.task/assigned]
                   [:seon.agent/id :seon.agent/id]
                   [:seon.task/branch :seon.task/branch]
                   [:seon.task.attempt/end {:optional true} :seon.task.attempt/end]
                   [:seon.flow.plan/main-end {:optional true} :seon.flow.plan/main-end]
                   [:seon.task/merge-base {:optional true} :seon.task/merge-base]
                   [:seon.flow.plan/head :seon.flow.plan/head]
                   [:seon.flow.plan/started? :seon.flow.plan/started?]
                   [:seon.flow.plan/kept? :seon.flow.plan/kept?]
                   [:seon.flow.plan/publish? {:optional true} :seon.flow.plan/publish?]]
 :unmerged [:int {:min 0 :description "How many declarations an ended taskless agent's branch changed that main lacks: the count of seon.cluster.source/compare-branch's added, changed-on-branch, retracted and conflict sets."}]
 :held-agent [:map {:description "One agent on main with a branch the store holds and no assignment (an MCP or schedule entrant), as db<->flow derives its end from it (seon.cluster.agent/lifecycle-facts): its end, main's row's else its branch head's, whether its graph runs and, once ended, what its branch holds unmerged."}
              [:db/id :seon.db/entity-id]
              [:seon.agent/id :seon.agent/id]
              [:seon.task/branch :seon.task/branch]
              [:seon.agent/admission-closed-tx {:optional true} :seon.agent/admission-closed-tx]
              [:seon.flow.plan/started? :seon.flow.plan/started?]
              [:seon.flow.plan/unmerged {:optional true} :seon.flow.plan/unmerged]]
 :held [:vector {:description "Every assignment whose branch the store holds, by key, then every taskless agent's, by id."}
        [:or :seon.flow.plan/held-assignment :seon.flow.plan/held-agent]]}
