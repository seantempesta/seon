#:seon.store{:branch :keyword,
             :backend :keyword,
             :path [:string {:min 1}],
             :id :uuid,
             :connection-object
             [:fn
              {:error/message
               "must be a Datahike connection object, live or released"
               :gen/gen seon.cluster.store/connection-generator}
              seon.cluster.store/connection-object?],
             :dir [:string {:min 1}],
             :lock-file [:string {:min 1}],
             :lock-object
             [:fn
              {:error/message
               "must be a java.nio FileLock object, held or released"
               :gen/gen seon.cluster.store/file-lock-generator}
              seon.cluster.store/file-lock-object?],
             ; THE STORE VALUE IS A RECORD OF WHAT THIS PROCESS OPENED, not an
             ; assertion that it is still open. Liveness is temporal state the
             ; authority re-decides: `release-store!` derives released-ness from
             ; the flock's own validity, and Datahike refuses a released
             ; connection at the transaction. Demanding liveness HERE made the
             ; retained value unrepresentable the moment it was released, which
             ; is why an armed `seon.cluster/stop!` refused its own stopped
             ; instance and lost its documented idempotence.
             :store
             [:map
              [:seon.store/dir :seon.store/dir]
              [:seon.store/lock-file :seon.store/lock-file]
              [:seon.store/connection-object :seon.store/connection-object]
              [:seon.store/lock :seon.store/lock-object]
              [:seon.store/created? :boolean]],
             :transaction
             [:or
              :seon.store/transaction-data
              [:map
               [:tx-data :seon.store/transaction-data]
               [:tx-meta {:optional true} :map]
               [:datahike/expected-basis-t {:optional true} :int]
               [:parents {:optional true} [:set {:min 1} :uuid]]]],
             :transaction-data
             [:vector :seon.store/transaction-operation],
             :transaction-operation
             [:or :map [:vector :seon.schema/value]]}
