;; Co-located Malli schemas for `seon.store` (LMDB + Datahike coordinates & references).
{:seon.store/ref
 [:or {:description "A Datahike reference: entity id, tempid, lookup ref, or nested entity map."}
  :int
  [:string {:min 1}]
  [:tuple :qualified-keyword :any]
  [:map [:db/id :int]]]

 :seon.store/branch
 [:keyword {:description "Datahike branch identifier (`:main` or `:branch/*`)."}]

 :seon.store/point
 [:map {:description "Immutable coordinate addressing any Datahike state across branches and time."}
  [:commit :uuid]
  [:tx :int]
  [:branch :seon.store/branch]]}
