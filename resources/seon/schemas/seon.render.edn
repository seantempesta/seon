#:seon.render{:cache :seon.call-preparation/state,
              :ai [:and {:seon.fn/reference-to :seon.fn/sym
                         :seon.db/index true
                         :description "A schema's AI renderer: a ref to the function entity its declaration names, own or inherited along Malli's reference chain (seon.schema.datahike/declared-reference). Authored as a symbol property; the schema bridge stores the ref. Optional peer ref: removing the function sweeps it and the writer refuses by name while the schema still declares it."}
                   :seon.db/ref],
              :viewer-functions [:vector :qualified-symbol],
              :call-request
              [:map
               #:seon.render{:ai seon.render.value/render-ai,
                             :html seon.render.value/render-html}
               [:seon.db/db :seon.db/database-value]
               [:seon.sci.eval/ctx :seon.sci.eval/ctx]
               [:seon.render/namespace
                {:optional true}
                :seon.render/namespace]
               [:seon.render/value :seon.render/value]
               [:seon.sci.admit/caps :seon.sci.admit/caps]
               [:seon.sci.eval/time-limit-ms
                :seon.sci.eval/time-limit-ms]
               [:seon.render/ai {:optional true} :qualified-symbol]
               [:seon.render/html {:optional true} :qualified-symbol]
               [:seon.render/form {:optional true} :qualified-symbol]
               [:seon.render/selection-inspection {:optional true} [:map]]
               [:seon.render/retained-calls
                {:optional true}
                [:map-of {:gen/return {}}
                 :seon.render.call/id :seon.render.call/entry]]
               [:seon.render/captured-calls
                {:optional true}
                :seon.call-preparation/state]
               [:seon.render/candidate-call-ids
                {:optional true}
                [:set :seon.render.call/id]]
               [:seon.render.call/id
                {:optional true}
                :seon.render.call/id]
               [:seon.render.call/selected-producer
                {:optional true}
                :qualified-symbol]
               [:seon.render.call/source-output?
                {:optional true}
                :boolean]
               [:seon.render.call/source-run-id
                {:optional true}
                :seon.turn/id]],
              :source [:string {:min 1}],
              :operations
              [:vector {:description "The REPL forms a rendered value offers its viewer (a message's (my.message/received! id)), as data: shown for the agent to run, never run by the render step."}
               :seon.repl/expression],
              :source-blocks
              [:map {:description "Generated source blocks retaining the entity whose renderer declared each read. This is source output, not an alternate evaluation path."}
               [:seon.render/source-blocks
                [:vector [:map
                          [:seon.render/source :seon.render/source]
                          [:seon.eval/origin {:optional true} :seon.eval/origin]]]]],
              :candidate-request
              [:map
               [:seon.db/db :seon.db/database-value]
               [:seon.sci.eval/ctx :seon.sci.eval/ctx]
               [:seon.render/namespace
                {:optional true}
                :seon.render/namespace]
               [:seon.render/value :seon.render/value]
               [:seon.render/output-schema
                :seon.render/output-schema]],
              :candidates [:vector {:min 2} :qualified-symbol],
              :selection-request
              [:merge
               :seon.render/call-request
               [:map [:seon.render/output :seon.render/output]]],
              :selection-candidate-status
              [:enum :compatible :rejected],
              :selection-candidate-reason
              [:= :no-same-arity-match],
              :selection-candidate
              [:map
               [:seon.render.selection.candidate/producer
                :qualified-symbol]
               [:seon.render.selection.candidate/status
                :seon.render/selection-candidate-status]
               [:seon.render.selection.candidate/reason
                {:optional true}
                :seon.render/selection-candidate-reason]],
              :selection-stage-name
              [:enum :explicit-value :namespace :declared :floor],
              :selection-stage-status
              [:enum :selected :no-match :ambiguous :not-consulted],
              :selection-stage
              [:map
               [:seon.render.selection.stage/name
                :seon.render/selection-stage-name]
               [:seon.render.selection.stage/status
                :seon.render/selection-stage-status]
               [:seon.render.selection.stage/value
                {:optional true}
                :seon.render/inline]
               [:seon.render.selection.stage/candidates
                {:optional true}
                [:vector :seon.render/selection-candidate]]
               [:seon.render.selection.stage/error
                {:optional true}
                :seon.render/ambiguous-error]],
              :selection
              [:map
               [:seon.render.selection/stages
                [:vector {:min 4 :max 4} :seon.render/selection-stage]]
               [:seon.render.selection/selected
                [:or :qualified-symbol :seon.render/rendered
                 :seon.render/ambiguous-error :seon.render/request-error :seon.config/error
                 :seon.render/inline]]],
              :distance [:int {:min 0}],
              :unknown-reason [:enum :time-limit :refused :unselected],
              :unknown-request
              [:map
               [:seon.render.unknown/reason :seon.render/unknown-reason]
               [:seon.render.unknown/producer
                {:optional true}
                :qualified-symbol]
               [:seon.render/output {:optional true} :seon.render/output]
               [:seon.render.call/id
                {:optional true}
                :seon.render.call/id]
               [:seon.error/value {:optional true} :seon.error/value]],
              :unknown
              [:merge :seon.error/base
 [:map {:seon.db/attributes true :seon.render/ai seon.render/unknown-ai :seon.render/html seon.render/unknown-html}
  [:seon.render.unknown/reason :seon.render/unknown-reason]
  [:seon.render.unknown/producer {:optional true} :qualified-symbol]
  [:seon.render.unknown/output {:optional true} :seon.render/output]
  [:seon.render.unknown/refused-operation {:optional true} :qualified-symbol]
  [:seon.render.unknown/throwable {:optional true} :string]
]],
              :failure
              [:map
               [:seon.render/ai :string]
               [:seon.render/html :seon.render/hiccup]
               [:seon.db/tx-data :seon.db/tx-data]],
              :failure-request
              [:map
               [:seon.db/db :seon.db/database-value]
               [:seon.render/namespace :seon.render/namespace]
               [:seon.error/value :seon.error/value]],
              :form [:and {:seon.fn/reference-to :seon.fn/sym
                           :seon.db/index true
                           :description "A schema's form renderer (how to find this data again): a ref to the function entity its declaration names, own or inherited, stored exactly as :seon.render/ai is."}
                     :seon.db/ref],
              :read-form
              [:or {:description "What a form renderer returns: the form that finds this data again, shown and never executed (one expression, one REPL entry, or entries)."}
               :seon.repl/expression :seon.repl/entry
               :seon.repl/entries],
              :hiccup
              [:fn
               {:error/message
                "must be Hiccup accepted by Seon's HTML serializer"
                :gen/gen seon.render.hiccup/hiccup-generator}
               seon.render.hiccup/hiccup?],
              :html [:and {:seon.fn/reference-to :seon.fn/sym
                           :seon.db/index true
                           :description "A schema's HTML renderer: a ref to the function entity its declaration names, own or inherited along Malli's reference chain, stored exactly as :seon.render/ai is."}
                     :seon.db/ref],
              :units
              [:vector
               {:description
                "Ordered forward attributes and reverse relationships rendered as self-contained entity-debug units."}
               :qualified-keyword],
              :namespace :symbol,
              :output
              [:enum :seon.render/ai :seon.render/html :seon.render/form],
              :rendered [:or :string :seon.render/hiccup :seon.render/read-form :seon.render/ai-data],
              :ai-data [:any {:description "An AI face: the pruned, processed data an agent cares about, printed by the value printer and never evaluated; offered operations and requery forms are data inside it."
                              :seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                              :seon.schema.admission/reason "A render's AI face is whatever data its schema-specific render selects."
                              :gen/elements [{:k 1} [1 2] "text"]}],
              :profile :seon.render.profile/profile,
              :output-schema :qualified-keyword,
              :package
              [:map
               [:seon.render.package/revision
                :seon.render.package/revision]
               [:seon.render.package/base-revision
                {:optional true}
                :seon.render.package/base-revision]
               [:seon.render.package/basis-transaction
                :seon.render.package/basis-transaction]
               [:seon.render.package/streaming?
                :seon.render.package/streaming?]
               [:seon.render.package/keyframe
                :seon.render.package/keyframe]
               [:seon.render.package/keyframe-bytes
                :seon.render.package/frame]
               [:seon.render.package/keyframe-size
                :seon.render.package/size]
               [:seon.render.package/delta :seon.render.package/delta]
               [:seon.render.package/delta-bytes
                :seon.render.package/frame]
               [:seon.render.package/delta-size
                :seon.render.package/size]],
              :page [:vector :seon.render/hiccup],
              :surface-id [:string {:min 9}],
              :unit
              [:map
               {:description "The open render unit: the value under :seon.render/value with the render inputs its function declares. The database is a required input: omitted, call preparation supplies it (the invocation's scoped database); a caller rendering with no evaluation world passes the database it has."}
               [:seon.db/db :seon.db/database-value]],
              :value
              [:any
               {:seon.schema.admission/exemption
                :seon.schema.admission/polymorphic-boundary
                :seon.schema.admission/reason
                "A rendered value is any admitted Clojure value; the value floor bounds what prints, not this schema."
                :gen/elements [nil true 0 "" :k [] {} #{}]}],
              :rendering [:set :qualified-symbol],
              :would-fall-to-floor? :boolean,

              :ambiguous-error [:merge :seon.error/base [:map {:seon.db/attributes true} [:seon.render/candidates :seon.render/candidates]]]
              :invalid-output :keyword
              :invalid-output-error [:merge :seon.error/base [:map {:seon.db/attributes true} [:seon.render/invalid-output :seon.render/invalid-output] [:seon.error/message :seon.error/message]]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.render/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.render/requested-output :seon.render/requested-output]
  [:seon.render/input-projection :seon.render/input-projection]]]

 :seon.render/input-projection
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.projection/entity}
 :seon.db/ref]

 :seon.render/requested-output
 [:enum :seon.render/ai :seon.render/html]

 :selection-observation :map
 :refused-member :qualified-keyword

 :request-error [:merge :seon.error/base [:map {:seon.db/attributes true} [:seon.render/refused-member :seon.render/refused-member] [:seon.render/selection-observation {:optional true} :seon.render/selection-observation]]]

 :walk-operation :qualified-symbol

 :inline
 [:any {:description "A value's own inline render for one face (:seon.render/ai or :seon.render/html): rendered data its face's emitter renders at the display edge. Any value may be one."
        :seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
        :seon.schema.admission/reason "An inline render is whatever data its value supplies for the face; the face's emitter renders it."
        :gen/elements [nil "" :k [] {}]}]

 :error-result [:or :seon.render/request-error :seon.render/ambiguous-error :seon.render/invalid-output-error :seon.render/unknown :seon.render.transcript/request-error :seon.config/error :seon.db/error-result]
}
