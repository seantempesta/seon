#:seon.render{:acquired-context
              [:map
               [:seon.cluster.prompt/text :seon.cluster.prompt/text]
               [:seon.db/db :seon.db/database-value]],
              :ai [:or :qualified-symbol :string],
              :call-request
              [:map
               #:seon.render{:ai seon.render.value/render-ai,
                             :html seon.render.value/render-html}
               [:seon.db/db :seon.db/database-value]
               [:seon.sci.eval/ctx :seon.sci.eval/ctx]
               [:seon.render/namespace
                {:optional true}
                :seon.render/namespace]
               [:seon.render/value :seon.render/value]
               [:seon.sci.admit/caps :seon.sci.admit/caps]
               [:seon.sci.eval/time-limit-ms
                :seon.sci.eval/time-limit-ms]
               [:seon.config/on-core-error :seon.config/on-core-error]
               [:seon.render/ai {:optional true} :qualified-symbol]
               [:seon.render/html {:optional true} :qualified-symbol]
               [:seon.render/form {:optional true} :qualified-symbol]],
              :candidate-request
              [:map
               [:seon.db/db :seon.db/database-value]
               [:seon.sci.eval/ctx :seon.sci.eval/ctx]
               [:seon.render/namespace
                {:optional true}
                :seon.render/namespace]
               [:seon.render/value :seon.render/value]
               [:seon.render/output-schema
                :seon.render/output-schema]],
              :candidates [:vector :seon.fn/sym],
              :distance [:int {:min 0}],
              :failure
              [:map
               [:seon.render/ai :string]
               [:seon.render/html :seon.render/hiccup]
               [:seon.db/tx-data :seon.db/tx-data]],
              :failure-request
              [:map
               [:seon.db/db :seon.db/database-value]
               [:seon.render/namespace :seon.render/namespace]
               [:seon.error/value :seon.error/value]],
              :form [:or :seon.repl/expression :seon.repl/entry],
              :hiccup
              [:fn
               {:error/message
                "must be Hiccup accepted by Seon's HTML serializer"
                :gen/gen seon.render.hiccup/hiccup-generator}
               seon.render.hiccup/hiccup?],
              :html [:or :qualified-symbol :seon.render/hiccup],
              :namespace :symbol,
              :output
              [:enum :seon.render/ai :seon.render/html :seon.render/form],
              :rendered [:or :string :seon.render/hiccup :seon.render/form],
              :profile :seon.render.profile/profile,
              :output-schema :qualified-keyword,
              :package
              [:map
               [:seon.render.package/revision
                :seon.render.package/revision]
               [:seon.render.package/base-revision
                {:optional true}
                :seon.render.package/base-revision]
               [:seon.render.package/basis-transaction
                :seon.render.package/basis-transaction]
               [:seon.render.package/streaming?
                :seon.render.package/streaming?]
               [:seon.render.package/keyframe
                :seon.render.package/keyframe]
               [:seon.render.package/keyframe-bytes
                :seon.render.package/frame]
               [:seon.render.package/keyframe-size
                :seon.render.package/size]
               [:seon.render.package/delta :seon.render.package/delta]
               [:seon.render.package/delta-bytes
                :seon.render.package/frame]
               [:seon.render.package/delta-size
                :seon.render.package/size]],
              :page [:vector :seon.render/hiccup],
              :surface-id [:string {:min 9}],
              :unit
              [:map-of :qualified-keyword
               [:any
                {:seon.schema.admission/exemption
                 :seon.schema.admission/polymorphic-boundary
                 :seon.schema.admission/reason
                 "A render unit is an open map from render keys to their own declared values; each key is bounded by its own schema, so the map-of value is genuinely heterogeneous here."
                 :gen/return nil}]],
              :value
              [:any
               {:seon.schema.admission/exemption
                :seon.schema.admission/polymorphic-boundary
                :seon.schema.admission/reason
                "A rendered value is any admitted Clojure value; the value floor bounds what prints, not this schema."
                :gen/elements [nil true 0 "" :k [] {} #{}]}],
              :rendering [:set :qualified-symbol],
              :would-fall-to-floor? :boolean,
              :ambiguous [:= true]
              :ambiguous-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a value matching more than one declared render producer"} [:seon.render/ambiguous :seon.render/ambiguous] [:seon.error/message :seon.error/message]]
              :invalid-output :keyword
              :invalid-output-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must identify the render projection whose producer returned invalid output"} [:seon.render/invalid-output :seon.render/invalid-output] [:seon.error/message :seon.error/message]]}
