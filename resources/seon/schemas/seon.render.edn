;; Renders (seon.render, session W2; W1's render contract, the session design papers in git history): a
;; render is a function of a value and its opts (props) answering its hiccup. A schema declares its
;; render in its own properties ({:seon.render/hiccup sym}); selection is
;; the value's own override key, else the declared render (the schema, then its parents),
;; else the one value printer (seon.print). The values below are what root's web renders.
{;; a value shown by its model render: its schema declares {:seon.render/model sym}, a function of opts and
 ;; the value answering the value to show in its place (seon.render/model), which the one printer
 ;; prints. The agent's process state: a Datahike db, the reach graph and host handles are shown by
 ;; name and size, each with the form that reads it (seon.agent/state-summary)
 :seon.agent/state [:map {:seon.render/model seon.agent/state-summary}]
 ;; the rows of my.agent/lines, shown as one block of numbered lines (my.agent/lines-text)
 :my.agent/lines [:vector {:seon.render/model my.agent/lines-text} :map]
 ;; my.agent/grep's [] for a string holding a regex's operators, shown with its regex form (my.agent/grep-none-text)
 ;; what my.agent/describe answers: a value's paths and what each holds, shown as every tool's answer is, with the forms that act on it
 ;; (seon.render/answer)
 :my.agent/described [:vector {:description "What a value holds, by path, without showing it: what (describe v) answers. See docs/agent.md#looking-at-what-you-pulled."
                               :seon.render/more [["read one" (get-in v path)] ["change one in your record" (swap! ctx assoc-in path x)]
                                                  ["go one level in" (describe v path)] ["what a key means" (doc :the/key)]]} :map]
 :my.agent/grep-none [:vector {:seon.render/model my.agent/grep-none-text} :map]
 ;; a prove's run (my.agent/prove): its verdict, each proof's status, the reds with their first
 ;; failing assertion and the deaths, and counts (my.agent/prove-summary); the lists are the value
 :seon.branch/merged [:map {:seon.render/model my.branch/merged-summary}]
 :seon.test/proved [:map {:seon.render/model my.agent/prove-summary :seon.render/hiccup seon.render.ui/proved}]
 ;; what draws what in a walk (seon.render/tree, my.render/tree): a component and those it drew, each with its own output's
 ;; tokens
 ;; an agent's page as an eval answers it: every component, [id form] in placed order, as the hiccup its request holds it, whole, (my.render/render-ctx), or what moved as edits (my.render/render-changes, docs/render.md#a-change-is-edits-by-name): a value that is a page prints whole, the stored one too
 :seon.render/parts [:map {:seon.print/full true} [:components {:optional true} [:vector :any]] [:edits {:optional true} [:vector :any]] [:shown-by {:optional true} :any]]
 :seon.render/tree [:map [:render :symbol] [:args [:vector :any]] [:id :string] [:tokens nat-int?]
                    [:reads? {:optional true} :boolean]
                    ;; each child is a tree too; a recursive schema cannot be built by the registry (a [:ref] overflows its eager parse)
                    [:children [:vector [:map [:render :symbol] [:children [:vector :any]]]]]]
 ;; how a value is shown: in one line, as a full panel, a tile, a row of a list
 :seon.render/as [:enum :inline :block :tile :row]
 ;; a render's props (its second argument), every one optional: like React's, a render that
 ;; does not care about one ignores it
 :seon.render/opts [:map
                    ;; the db the value was read on (an agent's branch, for a value recorded as its basis),
                    ;; read as of its basis (seon.render.ui/based-value)
                    [:db {:optional true} [:maybe :seon.host/db]]
                    ;; the room it is shown in: one line (a chat stream, a table cell), a full panel
                    ;; (the default), a compact live tile
                    [:as {:optional true} :seon.render/as]
                    ;; shown in an agent page's chat: an eval's one line leads with the agent's message
                    [:chat {:optional true} :boolean]
                    ;; tokens for the printer
                    [:budget {:optional true} pos-int?]
                    ;; what a cut reads the value through: its result handle (result/h3) or a form
                    [:handle {:optional true} :any]
                    ;; the producer's declared schema of the value, when known
                    [:schema {:optional true} [:maybe :qualified-keyword]]
                    ;; the unit the render proc renders it as: its element's id
                    [:unit {:optional true} [:maybe :string]]
                    ;; an eval row's cuts opened on the page, each its continuation form as EDN text (seon.web/open-form read it)
                    [:opened {:optional true} [:set :string]]
                    ;; the entity index (seon.db/index-of) a render that recognizes a value itself reads schemas in: the walk's, filled by
                    ;; emit and render!, passed on by hiccup. The interim docs/users.md#the-stages-agreed-2026-11-09 removes (a render running another render)
                    [:seon.render/index {:optional true} :map]
                    ;; drawn where a parent placed it (seon.render/entity-render: a joined entity), not as the page's top: a render that
                    ;; draws a whole page answers it with the entity's entry (owner, 2026-11-10: one render that knows top from nested)
                    [:seon.render/nested {:optional true} :boolean]]
 ;; what a citation reached (seon.doc/reached: a var, a namespace, a task, a section, a file, or nothing)
 :seon.render/kind [:enum :entity :value :var :schema :namespace :task :section :file :unresolved]
 ;; the schema a value is drawn by: its entity schema, or a value's attribute
 :seon.render/schema :qualified-keyword
 ;; an agent's proofs as its newest turn observed them (test -> {:status :failure}), its [:proofs]
 ;; part (seon.render/render-ctx)
 :seon.render/proofs [:map-of {:seon.render/hiccup seon.render.ui/proofs} :symbol [:map [:status :keyword] [:failure {:optional true} [:map [:assert :any] [:got :any]]]]]
 ;; hiccup marking a role or a field the tree's reading has no message for (seon.render/wire-parts): a typo is an error, not a silent drop
 :seon.render/unknown-mark [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/unknown-mark]] [:mark :string]]]
 ;; a page's location that main names no entity for (seon.render.proc/page-value): an agent's id of no agent in root's boot
 :seon.render/no-location [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/no-location]] [:view :string]]]
 ;; a value that draws itself, its render or the hiccup it is under :seon.render/hiccup (docs/render.md#a-value-draws-itself):
 ;; what an eval of one records as its :seon.eval/schema, so its eval is a tile as one a declared render draws
 :seon.render/drawn [:any {:seon.render/hiccup seon.render/hiccup}]
 ;; a component whose render threw (seon.render/render!, a failure point: renders are code, and agents write
 ;; them), a call of its render in the component's place: :seon.error/in the render, and the thrown error's own data
 :seon.render/component-defect [:and {:seon.render/openai-compat seon.ctx.wire/defect-msgs} :seon.error/base [:map [:seon.error/type [:= :seon.render/component-defect]] [:seon.error/in {:optional true} :symbol]
                                                      [:seon.render/threw {:optional true} :map]]]
 ;; a view whose render threw (seon.render.proc/view-pass, a failure point: renders are code, and agents
 ;; write them): its page is this error, recorded as a platform problem; :seon.error/in the function it threw in
 :seon.render/view-defect [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/view-defect]] [:view :string]
                                                    [:seon.error/in {:optional true} :symbol] [:class {:optional true} :string]]]
 ;; ---- root's process: its own data beside its db pull (seon.render.proc/process-value) ----
 ;; the writer's, fork server's and store's numbers, each proc's defects and the newest events,
 ;; part of root's ctx (:process), drawn by seon.render.ui/process-tile; never written
 :seon.render/process [:map [:writer [:maybe :map]] [:fork-server [:maybe :map]] [:store {:optional true} [:maybe :map]] [:boot {:optional true} [:maybe :map]]
                       [:root-errors-total :int] [:health :map] [:events [:vector :any]]]
 ;; ---- the parts of a page (seon.render.ui/page-chrome): each unit's input, its render declared here ----
 ;; (a unit names its input's schema, never a render function: docs/render.md#the-page)
 ;; the entity a page is of, its main pane
 ;; one request of the debug timeline as it went on the wire (seon.render.ui/debug-input, seon.render.proc/debug-value):
 ;; the body made again from its turn's basis, each message's records, which are new since the request before
 :seon.render/debug-turn [:map {:seon.render/hiccup seon.render.ui/debug-turn} [:at [:or pos-int? [:= :latest]]] [:to-come? :boolean]
                          [:turn :int] [:agent :string] [:origin :seon.model-call/origin] [:raw? :boolean] [:swept? {:optional true} :boolean] [:view {:optional true} :string] [:opened {:optional true} [:set :string]]
                          [:body :map] [:sources [:vector [:vector :any]]] [:new [:vector :boolean]]
                          [:usage [:map [:seon.model-call/tokens {:optional true} :int] [:seon.model-call/cache-hit-tokens {:optional true} :int]
                                   [:seon.model-call/cache-miss-tokens {:optional true} :int] [:seon.model-call/ms {:optional true} :int]
                                   [:seon.model-call/model {:optional true} :string]]]
                          [:error {:optional true} [:maybe :map]]]
 ;; its list's end: the older rows, counted and unrendered, and the view that asks for them
 ;; the input at the top of root's page
 :seon.render/root-input [:map {:seon.render/hiccup seon.render.ui/root-input}]
 ;; what root reads (seon.render.proc/debug-value): the system's value printed, as the render proc holds it
 :seon.render/root-context [:map {:seon.render/hiccup seon.render.ui/root-context} [:text :string] [:tokens nat-int?]]
 ;; the input at the top of an agent's page: its REPL, its messages, its held task's release
 :seon.render/agent-input [:map {:seon.render/hiccup seon.render.ui/agent-input} [:id :keyword] [:address {:optional true} :keyword] [:live? :boolean]]
 ;; a cost proof's report as the agent's test run holds it: the estimate's function, the
 ;; rows measured and the verdict (seon.cost/proof's :actual)
 :seon.render/cost-report [:map {:seon.render/hiccup seon.render.ui/cost-report}
                           [:rows [:vector :seon.cost/row]] [:verdict :seon.cost/verdict]]

 ;; a UI call naming a var not marked ^:seon/callable (seon.web/ui-call)
 :seon.render/not-callable [:and :seon.error/base [:map [:seon.render/fn :symbol]]]
 ;; the web listener that cannot bind its port (seon.web/web-proc): boot goes on without the web
 :seon.web/unbound [:and :seon.error/base [:map [:seon.error/type [:= :seon.web/unbound]] [:port :int]]]
 ;; ---- the procs' messages ----
 ;; a UI call: the /call route's payload (DECISIONS: callbacks are data naming a var)
 :seon.render/call [:map [:var :symbol] [:agent {:optional true} [:maybe :keyword]]
                    [:args {:optional true} [:maybe :map]] [:forms {:optional true} [:maybe :string]]]
 ;; what the render proc sends the web proc: per view, the fragments whose bytes changed
 ;; (element id -> html), the ones to remove, the ones added at a container's end or start, and
 ;; the ones placed after a sibling (#id -> html: a part that sorts into the middle)
 :seon.render/hiccup-value [:or {:seon.render/hiccup seon.render.ui/hiccup-value :description "What a render answers: an element [tag attrs? & children], a component call [#'var opts & args] (its var's symbol once stored), a string, a number, nil, or a seq of these; checked at its top only, a page's children are its renders' own. A function whose contract answers it has its values named by it (seon.contract/named), so an eval of one is drawn as html on the page and read by the model as the data it is. See docs/render.md#a-value-draws-itself."}
                            :nil :string number? [:and vector? [:cat [:or :keyword :symbol :seon.host/var :seon.host/fn] [:* :any]]] seq?]
 :seon.render/hiccup-attr-key [:and {:description "A key of a hiccup element's attributes as the intermediate means to hold it: an unqualified keyword, not :class or :style (a render's look is CSS keyed on its name, its :seon.render/style) and not a mark for one reader (:wire/*); renders that still write one are counted, render by render (seon.render/misfits-by-render), and those counts may only fall (seon.render-test/every-render-fits-the-hiccup). See docs/render.md#the-hiccup-is-checked."} :keyword [:not :qualified-keyword] [:not [:enum :class :style]]]
 :seon.render/hiccup-attrs [:map-of {:description "A hiccup element's attributes: plain values only (a :key the identity value of what it shows), never an entity map or another collection (a value with a render is a call of that render). See docs/render.md#the-hiccup-is-checked."} :seon.render/hiccup-attr-key [:or :string :int :double :boolean :nil :keyword :symbol :uuid]]
 :seon.render/misfits [:map-of {:description "What a hiccup output holds that the intermediate does not accept, counted by kind: :class, :style, :wire (a mark for one reader), :qualified (another qualified key), :value (an attribute holding no plain value); read per render by seon.render/misfits-by-render, whose counts may only fall. See docs/render.md#the-hiccup-is-checked."} [:enum :class :style :wire :qualified :value] pos-int?]
 :seon.render/patch [:map [:view :any] [:frags [:vector [:tuple :string :string]]]
                     [:removes {:optional true} [:vector :string]]
                     [:appends {:optional true} [:vector [:tuple :string :string]]]
                     [:prepends {:optional true} [:vector [:tuple :string :string]]]
                     [:afters {:optional true} [:vector [:tuple :string :string]]]
                     [:moves {:optional true :description "Units that changed place among the held ones of their container, in order: [id selector mode html], the element removed then put back after the unit now before it (mode after) or before the one now after it (mode before), so a reorder sends what moved, never its container whole. See docs/render.md#a-layout-places-its-lists."} [:vector [:tuple :string :string :string :string]]]]
 ;; keys of the render walk and the printer's budget errors (keys-schemas sweep)
 :seon.render/changes [:and {:description "In a render's opts, the pull's diff as a function (seon.ctx/changes for a ctx tree) by which a view reads a pull's collections; a function of two arguments, or absent."} :seon.host/fn]
 :seon.render/child [:= {:description "The marker [:seon.render/child key] standing in the walk's hiccup for a component drawn in its own place."} :seon.render/child]
 :seon.render/fn [:symbol {:description "The var symbol a UI call named that is not callable from the UI."}]
 :seon.render/for [:keyword {:description "In a walk's environment, the output (a keyword such as :seon.render/openai-compat) a component is run for when not the hiccup."}]
 :seon.render/form [:any {:description "In a hiccup element's metadata, the form it was read from, which a diff reads (seon.render/keyed)."}]
 :seon.render/kept [:any {:description "In a render output's metadata, the data its hiccup was made of, kept for a reader that decides from it (a turn, the status)."}]
 :seon.render/keys [:vector {:description "On a schema's properties, the keys of an entity map its render shows (its relevant keys), in order."} :keyword]
 :seon.render/list [:string {:description "On a render var's metadata, the id of the list region it draws (\"c-rows\"), whose members are placed by the layout."}]
 :seon.render/messages [:boolean {:description "On a render var's metadata, true when what it places is also the model's messages, not the page alone."}]
 :seon.render/model [:symbol {:description "On a schema's properties, the symbol of the render that prints a value for the model. See docs/render.md#a-part-prints-as-its-render."}]
 :seon.render/more [:vector {:description "On a schema's properties, the [words form] pairs that act on a value of it, the forms written once for every reader. See docs/render.md#a-render-is-a-value-printed-once."} [:tuple :string :any]]
 :seon.render/nested [:boolean {:description "In a render's opts, true when a parent placed the render (a joined entity), not the page's top."}]
 :seon.render/openai-compat [:or {:description "The output that is an entity drawn as the model's messages: the keyword naming it in a walk's outputs, and on a schema's properties the symbol of the render that answers it."} :qualified-symbol [:= :seon.render/openai-compat]]
 :seon.render/style [:string {:description "On a render var's metadata, the CSS rules (or Tailwind classes) of its states, added to the page when its html is. See docs/render.md#style."}]
 :seon.render/threw [:map {:description "On a render's defect error, the data of the exception its component threw."}]
 :seon.render/units [:vector {:description "A page render's answer beside its hiccup: the units (each a map with :id, :html or :input) the page is made of."} :map]
 :seon.render/index [:map {:description "The entity index (seon.db/index-of) a render reads schemas in: the walk's. See docs/render.md#what-a-render-is-handed."}]
 :seon.render.proc/read-failed [:= {:description "The :extra of a view's answer when its read failed (503): the page shows the error."} :seon.render.proc/read-failed]
 :seon.render.proc/root [:= {:description "The stand-in a view named :root or :home resolves to, meaning root's page: it moves the user's focus off any agent."} :seon.render.proc/root]
 :seon.render.value/insufficient-floor-budget-error [:and {:description "The error the value printer answers when its budget cannot show the root and its first member."} :seon.error/base [:map [:seon.error/type [:= :seon.render.value/insufficient-floor-budget-error]] [:seon.render.value/budget :seon.render.value/budget] [:seon.render.value/needed :seon.render.value/needed]]]
 :seon.render.value/charge-exceeded [:and {:description "The error raised when a printed text is longer than the charge the allotter made for it (a defect)."} :seon.error/base [:map [:seon.error/type [:= :seon.render.value/charge-exceeded]]]]
 :seon.render.value/budget [:and {:description "On the budget error, the characters the printer's budget allowed."} number?]
 :seon.render.value/needed [:and {:description "On the budget error, the characters the value's root and first member need."} number?]
 :seon.render.data/total [:int {:min 0 :description "The member count of a collection node, which a summary and a cut say."}]
 :seon.render.data/next-offset [:int {:min 0 :description "The offset a cut's continuation reads from: members or characters already shown."}]
 :seon.render.data/entry [:= {:description "A path step's tag: [:seon.render.data/entry index part] is the key or value of the map entry at index."} :seon.render.data/entry]
 :seon.render.data/nth [:= {:description "A path step's tag: [:seon.render.data/nth index] is the member at index of a collection read by position."} :seon.render.data/nth]
 :seon.render.data/key [:= {:description "A path step's part: the key of a map entry."} :seon.render.data/key]
 :seon.render.data/val [:= {:description "A path step's part: the value of a map entry."} :seon.render.data/val]
 :seon.render.data/path [:vector {:description "The steps from a printed value's root to a node: a position, [nth index], or [entry index key|val]; a cut's continuation form is made from it."} [:or nat-int? [:tuple :seon.render.data/nth nat-int?] [:tuple :seon.render.data/entry nat-int? [:enum :seon.render.data/key :seon.render.data/val]]]]}
