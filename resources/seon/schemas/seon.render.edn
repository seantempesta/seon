;; Renders (seon.render, session W2; W1's render contract, notes/option3-W1-render.md §1): a
;; render is a function of a value and its opts (props) answering its result for one face. A schema declares its
;; renders in its own properties ({:seon.render/html sym :seon.render/ai sym}); selection is
;; the value's own override key, else the declared render (the schema, then its parents),
;; else the one value printer (seon.print). The values below are what root's web renders.
{:seon.render/hiccup [:vector :any]
 :seon.render/face [:enum :ai :html]
 :seon.render/as [:enum :inline :block :tile]
 ;; a render's props (its second argument), every one optional: like React's, a render that
 ;; does not care about one ignores it
 :seon.render/opts [:map
                    ;; the face (:html, the default, or :ai), when rendering through seon.render/render
                    [:face {:optional true} :seon.render/face]
                    ;; the room it is shown in: one line (a chat stream, a table cell), a full panel
                    ;; (the default), a compact live tile
                    [:as {:optional true} :seon.render/as]
                    ;; tokens for the printer (the AI face's budget, and the HTML face's)
                    [:budget {:optional true} pos-int?]
                    ;; what a cut reads the value through: its result handle (result/h3) or a form
                    [:handle {:optional true} :any]
                    ;; the producer's declared schema of the value, when known
                    [:schema {:optional true} [:maybe :qualified-keyword]]
                    ;; the unit the render proc renders it as: its element's id
                    [:unit {:optional true} [:maybe :string]]]
 ;; an :ai render's result: its text, and whether it cut (each cut names what it left and how to read it)
 :seon.render/text [:map [:text :string] [:truncated? {:optional true} :boolean]]

 ;; ---- what root's dashboard shows: the whole system as one value ----
 ;; the api's view (agents, writer, fork server, store, boot, root errors) joined with every
 ;; proc's health, main's tasks and attempts, the series the tiles draw, and the events.
 ;; Its HTML face is root's layout; its AI face is root's context (a budgeted text).
 :seon.render/system [:map {:seon.render/html seon.render.ui/system-page :seon.render/ai seon.render.ai/system}
                      [:agents :map] [:health :map] [:writer :map] [:fork-server :map]
                      [:main :map] [:tasks :map] [:attempts :map] [:events [:vector :any]]]
 ;; one agent as root holds it (the api's view entry, its id added): its card in root's layout
 :seon.render/agent [:map {:seon.render/html seon.render.ui/agent-card}
                     [:id :keyword] [:status {:optional true} [:maybe :keyword]]]
 ;; one agent zoomed: the agent, its attempt and task on main, its evaluations on its branch,
 ;; the current-state block its model reads. Its HTML face is the agent's page.
 :seon.render/agent-page [:map {:seon.render/html seon.render.ui/agent-page}
                          [:agent :seon.render/agent]]
 ;; ---- the parts of root's layout: each unit's input, its render declared here ----
 ;; (a unit names its input's schema, never a render function: docs/render.md#the-frame-and-its-units)
 ;; what is wrong now, by area: the lines root's context leads with (seon.render.ai/problem-areas)
 :seon.render/problems-banner [:sequential {:seon.render/html seon.render.ui/tile-problems} [:tuple :keyword [:sequential :string]]]
 ;; a tile as data (seon.render.ui/load-tiles; every tile's own render builds one)
 :seon.render/tile [:map {:seon.render/html seon.render.ui/metric-tile} [:id :string]]
 ;; the swarm: one cell per agent shown [id status evals-seen], and how many ended off the grid
 :seon.render/swarm [:map {:seon.render/html seon.render.ui/tile-agents}
                     [:cells [:sequential [:tuple :any :any nat-int?]]] [:off :int]]
 ;; every declared root proc's health, by proc id
 :seon.render/procs-health [:map {:seon.render/html seon.render.ui/tile-health} [:health :map]]
 ;; the work: every task's row (seon.render.proc/task-rows), main's attempts, main's t
 :seon.render/work [:map {:seon.render/html seon.render.ui/tile-tasks}
                    [:rows [:maybe :map]] [:attempts [:maybe :map]]]
 ;; root's own defects, the boot's numbers and the store
 :seon.render/root-errors [:map {:seon.render/html seon.render.ui/tile-errors}]
 ;; root's context: the system's AI face as root reads it
 :seon.render/context [:map {:seon.render/html seon.render.ui/context-panel}
                       [:text {:optional true} [:maybe :string]]]
 ;; the stream's header: events kept, of those seen since boot
 :seon.render/events-count [:map {:seon.render/html seon.render.ui/events-count} [:kept nat-int?] [:seen nat-int?]]
 ;; the web proc's own numbers (tabs open)
 :seon.render/web [:map {:seon.render/html seon.render.ui/web-stats}]
 ;; the agent window's head: its view entry, attempt and task, the totals over its turns
 :seon.render/zoom-head [:map {:seon.render/html seon.render.ui/zoom-head} [:agent :map] [:turns :map]]
 ;; the attempt's turns, each row serialized ahead by its declared render (seon.render.ui/turn-row)
 :seon.render/turns [:map {:seon.render/html seon.render.ui/turns-list} [:turns nat-int?]]
 ;; the input at the bottom of the agent's window
 :seon.render/agent-input [:map {:seon.render/html seon.render.ui/agent-input} [:id :keyword] [:live? :boolean]]
 ;; the agent window's live tiles, the last changed first, each serialized ahead
 :seon.render/tiles [:map {:seon.render/html seon.render.ui/tiles-list} [:tiles [:sequential :string]]]
 ;; the agent's last test run, and main's results of its attempt
 :seon.render/proofs [:map {:seon.render/html seon.render.ui/proofs-box}]
 ;; what the agent's branch will carry to main, as its newest turn measured it
 :seon.render/branch [:map {:seon.render/html seon.render.ui/branch-box}]
 ;; the problems main recorded of an agent or its task, in root's context's words
 :seon.render/agent-problems [:map {:seon.render/html seon.render.ui/problems-box} [:rows [:vector :map]]]
 ;; one event of root's stream
 :seon.render/event [:map {:seon.render/html seon.render.ui/event-row} [:type :keyword]]
 ;; a declared proc's health as what flows: the defects root recorded of it (no ping)
 :seon.render/proc-health [:map {:seon.render/html seon.render.ui/proc-health}
                           [:pid :keyword] [:defects nat-int?] [:newest {:optional true} [:maybe :string]]]
 ;; a cost proof's report as the agent's test run holds it: the estimate's function, the
 ;; rows measured and the verdict (seon.cost/proof's :actual)
 :seon.render/cost-report [:map {:seon.render/html seon.render.ui/cost-report}
                           [:rows [:vector :seon.cost/row]] [:verdict :seon.cost/verdict]]

 ;; a UI call naming a var not marked ^:seon/callable (seon.web/ui-call)
 :seon.render/not-callable [:and :seon.error/base [:map [:seon.render/fn :symbol]]]
 ;; the web listener that cannot bind its port (seon.web/web-proc): boot goes on without the web
 :seon.web/unbound [:and :seon.error/base [:map [:seon.error/type [:= :seon.web/unbound]] [:port :int]]]
 ;; ---- the procs' messages ----
 ;; a UI call: the /call route's payload (DECISIONS: callbacks are data naming a var)
 :seon.render/call [:map [:var :symbol] [:agent {:optional true} [:maybe :keyword]]
                    [:args {:optional true} [:maybe :map]] [:forms {:optional true} [:maybe :string]]]
 ;; what the render proc sends the web proc: per view, the fragments whose bytes changed
 ;; (element id -> html), the ones to remove, and the ones appended to a container
 :seon.render/patch [:map [:view :any] [:frags [:vector [:tuple :string :string]]]
                     [:removes {:optional true} [:vector :string]]
                     [:appends {:optional true} [:vector [:tuple :string :string]]]
                     [:prepends {:optional true} [:vector [:tuple :string :string]]]]}
