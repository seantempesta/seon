;; Renders (seon.render, session W2; W1's render contract, notes/option3-W1-render.md §1): a
;; render is a function of a value and its opts (props) answering its result for one face. A schema declares its
;; renders in its own properties ({:seon.render/html sym :seon.render/ai sym}); selection is
;; the value's own override key, else the declared render (the schema, then its parents),
;; else the one value printer (seon.print). The values below are what root's web renders.
{:seon.render/face [:enum :ai :html]
 ;; how a value is shown: in one line, as the page's main pane, a tile of its column, a row of its
 ;; list (an entity schema's {:seon.render/as :row} puts its entities in the page's list, newest first)
 :seon.render/as [:enum :inline :block :tile :row]
 ;; a render's props (its second argument), every one optional: like React's, a render that
 ;; does not care about one ignores it
 :seon.render/opts [:map
                    ;; the face (:html, the default, or :ai), when rendering through seon.render/render
                    [:face {:optional true} :seon.render/face]
                    ;; the room it is shown in: one line (a chat stream, a table cell), a full panel
                    ;; (the default), a compact live tile
                    [:as {:optional true} :seon.render/as]
                    ;; tokens for the printer (the AI face's budget, and the HTML face's)
                    [:budget {:optional true} pos-int?]
                    ;; what a cut reads the value through: its result handle (result/h3) or a form
                    [:handle {:optional true} :any]
                    ;; the producer's declared schema of the value, when known
                    [:schema {:optional true} [:maybe :qualified-keyword]]
                    ;; the unit the render proc renders it as: its element's id
                    [:unit {:optional true} [:maybe :string]]]
 ;; an :ai render's result: its text, and whether it cut (each cut names what it left and how to read it)
 :seon.render/text [:map [:text :string] [:truncated? {:optional true} :boolean]]
 ;; ---- the walk (seon.render/walk): an entity, its units one hop away, what their prose cites ----
 ;; a schema whose values are prose ({:seon.render/prose true}: a plan, a message, a reply) is
 ;; parsed for its citations; any other string is a name or data
 ;; what a part is: an entity, a value of the walked entity, or what a citation reaches (a var, a
 ;; namespace, a task, a doc section path#anchor, a file, or nothing: unresolved)
 :seon.render/kind [:enum :entity :value :var :namespace :task :section :file :unresolved]
 ;; an entity schema's units (a schema property): the attributes a view of its entity shows, in
 ;; pull's syntax, a leading _ the reverse ref
 :seon.render/units [:vector :keyword]
 ;; an entity schema's units whose entities are part of its page (a schema property): each is walked
 ;; too, and its units join the page's (an agent's run: its task, turns and messages; seon.render/page)
 :seon.render/parts [:vector :keyword]
 :seon.render/depth :seon.ref/depth
 :seon.render/value :any
 ;; the schema of a node's value: its entity schema, or a value's attribute (absent: no entity schema names it)
 :seon.render/schema :qualified-keyword
 :seon.render/eid pos-int?
 ;; the transaction that made an entity a page shows (seon.render/page): what orders its list
 :seon.render/t pos-int?
 :seon.render/attr :keyword
 :seon.render/line pos-int?
 ;; where a node or a citation came from: the entity and the attribute that reached it (a unit's
 ;; ref, or the prose attribute that cites), and the citation's line in that text
 :seon.render/place [:map [:seon.render/eid :seon.render/eid] [:seon.render/attr :seon.render/attr]
                     [:seon.render/line {:optional true} :seon.render/line]]
 :seon.render/from :seon.render/place
 ;; every place a citation is cited
 :seon.render/cited-at [:vector :seon.render/place]
 ;; a ref's number, and the refs a node's prose cites by number
 :seon.render/n pos-int?
 :seon.render/cites [:vector :seon.render/n]
 :seon.render/address :string
 ;; an entity, or a value of the walked entity (a unit that is no entity: its schema its attribute)
 :seon.render/node [:map [:seon.render/kind :seon.render/kind] [:seon.render/value :seon.render/value]
                     [:seon.render/schema {:optional true} :seon.render/schema] [:seon.render/eid :seon.render/eid]
                     [:seon.render/from {:optional true} :seon.render/from] [:seon.render/cites {:optional true} :seon.render/cites]
                     [:seon.render/t {:optional true} :seon.render/t]]
 ;; a citation's content, pulled once at the depth it was first cited (seon.docs/cited), and every place citing it
 :seon.render/ref [:map [:seon.render/n :seon.render/n] [:seon.render/kind :seon.render/kind] [:seon.render/address :seon.render/address]
                    [:seon.render/depth :seon.ref/depth] [:seon.render/value :seon.render/value]
                    [:seon.render/cited-at :seon.render/cited-at]]
 :seon.render/root :seon.render/node
 :seon.render/nodes [:vector :seon.render/node]
 :seon.render/refs [:vector :seon.render/ref]
 ;; the walk's citation pass (seon.render/cite): the refs so far, each one's position by its address, the next number
 :seon.render/cite-state [:map [:refs :seon.render/refs] [:index [:map-of :string nat-int?]] [:next :seon.render/n]]
 :seon.render/walk [:map [:seon.render/root :seon.render/root] [:seon.render/nodes :seon.render/nodes] [:seon.render/refs :seon.render/refs]]
 :seon.render/no-entity [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/no-entity]] [:seon.render/eid :seon.render/eid]]]
 ;; a page's location that main names no entity for (seon.render.proc/page-value): an agent's id of no agent in root's boot
 :seon.render/no-location [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/no-location]] [:view :string]]]
 ;; ---- what root's context reads: the whole system as one value ----
 ;; the api's view (agents, writer, fork server, store, boot, root errors) joined with every
 ;; proc's health, main's tasks and runs, the series and the events. Its AI face is root's
 ;; context (a budgeted text); the page is root's entity's (seon.render/page), not this value's.
 :seon.render/system [:map {:seon.render/ai seon.render.ai/system}
                      [:agents :map] [:health :map] [:writer :map] [:fork-server :map]
                      [:main :map] [:tasks :map] [:runs :map] [:events [:vector :any]]]
 ;; ---- the parts of a page (seon.render.ui/page): each unit's input, its render declared here ----
 ;; (a unit names its input's schema, never a render function: docs/render.md#the-page-is-units)
 ;; the entity a page is of, its main pane
 ;; a model turn's request as it recorded it, for the debug page (seon.render.proc/debug-value):
 ;; each part [ref messages] beside the record that made it, and the turn's usage
 :seon.render/sent-request [:map {:seon.render/html seon.render.ui/sent-request} [:turn :int] [:run :string]
                            [:parts [:vector [:tuple :any [:vector :seon.model/message]]]]
                            [:seon.turn/tokens {:optional true} :int] [:seon.turn/cache-hit-tokens {:optional true} :int]
                            [:seon.turn/cache-miss-tokens {:optional true} :int] [:seon.turn/error {:optional true} :map]]
 :seon.render/page-head [:and {:seon.render/html seon.render.ui/head} :seon.render/node]
 ;; one row of its list: a turn and the evaluations it ran, or one evaluation or message
 :seon.render/page-row [:vector {:seon.render/html seon.render.ui/row :min 1} :seon.render/node]
 ;; one tile of its column: a unit that is not a row
 :seon.render/page-tile [:and {:seon.render/html seon.render.ui/tile} :seon.render/node]
 ;; its list's end: the older rows, counted and unrendered, and the view that asks for them
 :seon.render/page-more [:map {:seon.render/html seon.render.ui/more} [:older nat-int?] [:view :string]]
 ;; the input at the top of root's page
 :seon.render/root-input [:map {:seon.render/html seon.render.ui/root-input}]
 ;; the input at the top of an agent's page: its REPL, its messages, its held task's release
 :seon.render/agent-input [:map {:seon.render/html seon.render.ui/agent-input} [:id :keyword] [:live? :boolean]]
 ;; a cost proof's report as the agent's test run holds it: the estimate's function, the
 ;; rows measured and the verdict (seon.cost/proof's :actual)
 :seon.render/cost-report [:map {:seon.render/html seon.render.ui/cost-report}
                           [:rows [:vector :seon.cost/row]] [:verdict :seon.cost/verdict]]

 ;; a UI call naming a var not marked ^:seon/callable (seon.web/ui-call)
 :seon.render/not-callable [:and :seon.error/base [:map [:seon.render/fn :symbol]]]
 ;; the web listener that cannot bind its port (seon.web/web-proc): boot goes on without the web
 :seon.web/unbound [:and :seon.error/base [:map [:seon.error/type [:= :seon.web/unbound]] [:port :int]]]
 ;; ---- the procs' messages ----
 ;; a UI call: the /call route's payload (DECISIONS: callbacks are data naming a var)
 :seon.render/call [:map [:var :symbol] [:agent {:optional true} [:maybe :keyword]]
                    [:args {:optional true} [:maybe :map]] [:forms {:optional true} [:maybe :string]]]
 ;; what the render proc sends the web proc: per view, the fragments whose bytes changed
 ;; (element id -> html), the ones to remove, and the ones appended to a container
 :seon.render/patch [:map [:view :any] [:frags [:vector [:tuple :string :string]]]
                     [:removes {:optional true} [:vector :string]]
                     [:appends {:optional true} [:vector [:tuple :string :string]]]
                     [:prepends {:optional true} [:vector [:tuple :string :string]]]]}
