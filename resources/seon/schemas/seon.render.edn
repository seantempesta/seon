;; Renders (seon.render, session W2; W1's render contract, notes/option3-W1-render.md §1): a
;; render is a function of a value and its opts (props) answering its hiccup. A schema declares its
;; render in its own properties ({:seon.render/html sym}); selection is
;; the value's own override key, else the declared render (the schema, then its parents),
;; else the one value printer (seon.print). The values below are what root's web renders.
{;; how a value is shown: in one line, as the page's main pane, a tile of its column, a row of its
 ;; list (an entity schema's {:seon.render/as :row} puts its entities in the page's list, newest first)
 ;; :page, the whole page of the entity (opts :walk, its walk, and :dbs): a view that answers a layout
 ;; ({:seon.render/html :seon.render/units}) lays out its entity's page (an agent's, its conversation)
 :seon.render/as [:enum :inline :block :tile :row :page]
 ;; a render's props (its second argument), every one optional: like React's, a render that
 ;; does not care about one ignores it
 :seon.render/opts [:map
                    ;; shown :as :page: the page's walk, its dbs and its tab's state (seon.render.proc/page-value)
                    [:page {:optional true} :map]
                    ;; the db the value was read on (an agent's branch, for a value recorded as its basis),
                    ;; read as of its basis (seon.render.ui/based-value)
                    [:db {:optional true} [:maybe :seon.host/db]]
                    ;; the room it is shown in: one line (a chat stream, a table cell), a full panel
                    ;; (the default), a compact live tile
                    [:as {:optional true} :seon.render/as]
                    ;; shown in an agent page's chat: an eval's one line leads with the agent's prose
                    [:chat {:optional true} :boolean]
                    ;; tokens for the printer
                    [:budget {:optional true} pos-int?]
                    ;; what a cut reads the value through: its result handle (result/h3) or a form
                    [:handle {:optional true} :any]
                    ;; the producer's declared schema of the value, when known
                    [:schema {:optional true} [:maybe :qualified-keyword]]
                    ;; the unit the render proc renders it as: its element's id
                    [:unit {:optional true} [:maybe :string]]
                    ;; an eval row's cuts opened on the page, each its continuation form as EDN text (seon.web/open-form read it)
                    [:opened {:optional true} [:set :string]]]
 ;; ---- the walk (seon.render/walk): an entity and its units one hop away, the default view of any entity ----
 ;; a schema whose values are prose ({:seon.render/prose true}: a plan, a message, a reply) renders as markdown
 ;; what a node is: an entity, or a value of the walked entity; what a citation reached
 ;; (seon.docs/reached: a var, a namespace, a task, a section, a file, or nothing)
 :seon.render/kind [:enum :entity :value :var :namespace :task :section :file :unresolved]
 ;; an entity schema's units whose entities are part of its page (a schema property): their units
 ;; are walked one hop more and join the page's (an agent's run: its task, turns and messages)
 :seon.render/parts [:vector :keyword]
 :seon.render/value :any
 ;; the schema of a node's value: its entity schema, or a value's attribute (absent: no entity schema names it)
 :seon.render/schema :qualified-keyword
 :seon.render/eid pos-int?
 :seon.render/attr :keyword
 ;; where a node came from: the entity and the attribute that reached it
 :seon.render/from [:map [:seon.render/eid :seon.render/eid] [:seon.render/attr :seon.render/attr]]
 ;; the transaction of the datom that linked a neighbour to the entity walked: the order it was written
 :seon.render/tx pos-int?
 ;; the db a node was read from: its index in the dbs a page reads (main 0, an agent's branch 1)
 :seon.render/db nat-int?
 ;; an entity, or a value of the walked entity (a unit that is no entity: its schema its attribute)
 ;; a row a page does not show, listed from its ref's index alone (seon.render/one's limit): counted, never read
 :seon.render/listed :boolean
 :seon.render/node [:map [:seon.render/kind :seon.render/kind] [:seon.render/value :seon.render/value] [:seon.render/listed {:optional true} :boolean]
                     [:seon.render/schema {:optional true} :seon.render/schema] [:seon.render/eid :seon.render/eid]
                     [:seon.render/from {:optional true} :seon.render/from] [:seon.render/tx {:optional true} :seon.render/tx]
                     [:seon.render/db {:optional true} :seon.render/db]]
 ;; an agent's proofs as its newest turn observed them (test -> {:status :failure}), its [:proofs]
 ;; part (seon.render/render-ctx)
 :seon.render/proofs [:map-of {:seon.render/html seon.render.ui/proofs} :symbol [:map [:status :keyword] [:failure {:optional true} [:map [:assert :any] [:got :any]]]]]
 ;; root's page's tile of main's problems (seon.render.proc/page-value): the report, by its own view,
 ;; with the ids of the classes its tab opened (:open, the /open toggle's): only those render their rows
 :seon.render/problems [:and :seon.problems/report [:map [:open [:set :string]]]]
 ;; root's page's tile of main's runs (seon.render.ui/root): how many by status, and each running one
 :seon.render/runs [:map {:seon.render/html seon.render.ui/runs} [:by-status [:map-of :keyword nat-int?]] [:running [:vector :map]]]
 :seon.render/root :seon.render/node
 :seon.render/nodes [:vector :seon.render/node]
 :seon.render/walk [:map [:seon.render/root :seon.render/root] [:seon.render/nodes :seon.render/nodes]]
 :seon.render/no-entity [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/no-entity]] [:seon.render/eid :seon.render/eid]]]
 ;; a page's location that main names no entity for (seon.render.proc/page-value): an agent's id of no agent in root's boot
 :seon.render/no-location [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/no-location]] [:view :string]]]
 ;; a component whose render threw (seon.render/render!, a failure point: renders are code, and agents write
 ;; them): drawn in its place; :seon.error/in the render
 :seon.render/component-defect [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/component-defect]] [:seon.error/in {:optional true} :symbol]]]
 ;; a view whose render threw (seon.render.proc/view-pass, a failure point: renders are code, and agents
 ;; write them): its page is this error, recorded as a platform problem; :seon.error/in the function it threw in
 :seon.render/view-defect [:and :seon.error/base [:map [:seon.error/type [:= :seon.render/view-defect]] [:view :string]
                                                    [:seon.error/in {:optional true} :symbol] [:class {:optional true} :string]]]
 ;; ---- what root's context reads: the whole system as one value ----
 ;; the api's view (agents, writer, fork server, store, boot, root errors) joined with every
 ;; proc's health, main's tasks and runs, the series and the events, as root's context reads it
 ;; (seon.render.system); the page is root's entity's (seon.render/walk), not this value's.
 :seon.render/system [:map
                      [:agents :map] [:health :map] [:writer :map] [:fork-server :map]
                      [:main :map] [:tasks :map] [:runs :map] [:events [:vector :any]]]
 ;; ---- the parts of a page (seon.render.ui/page): each unit's input, its render declared here ----
 ;; (a unit names its input's schema, never a render function: docs/render.md#the-page-is-units)
 ;; the entity a page is of, its main pane
 ;; a model turn's request as it recorded it, for the debug page (seon.render.proc/debug-value):
 ;; what the turn added beside the records that made it, what it shares, its whole request when open, its usage or error
 :seon.render/sent-request [:map {:seon.render/html seon.render.ui/sent-request} [:turn :int] [:run :string] [:view :string] [:refs :int]
                            [:added [:vector [:tuple :any [:vector :seon.model/message]]]]
                            [:same {:optional true} [:map [:turn :int] [:parts :int]]]
                            [:split {:optional true} [:map [:system nat-int?] [:conversation nat-int?] [:page nat-int?]]]
                            [:whole {:optional true} [:vector [:tuple :any [:vector :seon.model/message]]]]
                            [:seon.turn/tokens {:optional true} :int] [:seon.turn/cache-hit-tokens {:optional true} :int]
                            [:seon.turn/cache-miss-tokens {:optional true} :int] [:seon.turn/error {:optional true} :map]]
 ;; one tile of its column that is a value, not an entity (an entity's tile is a component: seon.render.ui/component)
 :seon.render/page-tile [:and {:seon.render/html seon.render.ui/tile} :seon.render/node]
 ;; an agent's page: its ctx as components (seon.render.ui/render-ctx, drawn by the walk), which a branch may override
 :seon.render/render-ctx [:map {:seon.render/html seon.render.ui/render-ctx}]
 ;; its list's end: the older rows, counted and unrendered, and the view that asks for them
 :seon.render/page-more [:map {:seon.render/html seon.render.ui/more} [:older nat-int?] [:view :string] [:click? {:optional true} :boolean]]
 ;; the input at the top of root's page
 :seon.render/root-input [:map {:seon.render/html seon.render.ui/root-input}]
 ;; what root reads (seon.render.proc/debug-value): the system's value printed, as the render proc holds it
 :seon.render/root-context [:map {:seon.render/html seon.render.ui/root-context} [:text :string] [:tokens nat-int?]]
 ;; the input at the top of an agent's page: its REPL, its messages, its held task's release
 :seon.render/agent-input [:map {:seon.render/html seon.render.ui/agent-input} [:id :keyword] [:live? :boolean]]
 ;; a cost proof's report as the agent's test run holds it: the estimate's function, the
 ;; rows measured and the verdict (seon.cost/proof's :actual)
 :seon.render/cost-report [:map {:seon.render/html seon.render.ui/cost-report}
                           [:rows [:vector :seon.cost/row]] [:verdict :seon.cost/verdict]]

 ;; a UI call naming a var not marked ^:seon/callable (seon.web/ui-call)
 :seon.render/not-callable [:and :seon.error/base [:map [:seon.render/fn :symbol]]]
 ;; the web listener that cannot bind its port (seon.web/web-proc): boot goes on without the web
 :seon.web/unbound [:and :seon.error/base [:map [:seon.error/type [:= :seon.web/unbound]] [:port :int]]]
 ;; ---- the procs' messages ----
 ;; a UI call: the /call route's payload (DECISIONS: callbacks are data naming a var)
 :seon.render/call [:map [:var :symbol] [:agent {:optional true} [:maybe :keyword]]
                    [:args {:optional true} [:maybe :map]] [:forms {:optional true} [:maybe :string]]]
 ;; what the render proc sends the web proc: per view, the fragments whose bytes changed
 ;; (element id -> html), the ones to remove, the ones added at a container's end or start, and
 ;; the ones placed after a sibling (#id -> html: a part that sorts into the middle)
 :seon.render/patch [:map [:view :any] [:frags [:vector [:tuple :string :string]]]
                     [:removes {:optional true} [:vector :string]]
                     [:appends {:optional true} [:vector [:tuple :string :string]]]
                     [:prepends {:optional true} [:vector [:tuple :string :string]]]
                     [:afters {:optional true} [:vector [:tuple :string :string]]]]}
