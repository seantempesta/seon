   :seon.ai.model/openai-chat-completions]
  [:seon.ai.model/output-token-wire-key
   :seon.ai.model/output-token-wire-key]]

 :seon.ai.model/deepseek-window-entity
 [:map {:seon.db/attributes true}
  [:seon.ai.model/deepseek-window-id
   :seon.ai.model/deepseek-window-id]
  [:seon.ai.model/deepseek-utc-start
   :seon.ai.model/deepseek-utc-start]
  [:seon.ai.model/deepseek-utc-end
   :seon.ai.model/deepseek-utc-end]
