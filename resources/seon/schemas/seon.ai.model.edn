{:seon.ai.model/id
 [:and {:seon.db/identity true} :seon.config.ai/model]

 :seon.ai.model/provider :seon.db/ref
 :seon.ai.model/provider-id
 [:string {:min 1 :seon.db/identity true}]
 :seon.ai.model/openai-chat-completions [:= true]
 :seon.ai.model/output-token-wire-key [:string {:min 1}]

 :seon.ai.model/context-window-tokens [:int {:min 1}]
 :seon.ai.model/max-output-tokens :seon.ai/max-tokens
 :seon.ai.model/input-usd-per-mtok [:double {:min 0.0}]
 :seon.ai.model/output-usd-per-mtok [:double {:min 0.0}]
 :seon.ai.model/cached-input-usd-per-mtok [:double {:min 0.0}]
 :seon.ai.model/input-modalities [:set :keyword]
 :seon.ai.model/thinking-dials [:set :seon.ai/thinking]

 :seon.ai.model/last-tokens-per-second
 [:double {:min 0.0 :seon.db/no-history? true}]
 :seon.ai.model/last-latency-ms
 [:int {:min 0 :seon.db/no-history? true}]
 :seon.ai.model/last-used-at
 [:and {:seon.db/no-history? true} :inst]

 :seon.ai.model/deepseek-off-peak-windows [:set :seon.db/ref]
 :seon.ai.model/deepseek-window-id
 [:string {:min 1 :seon.db/identity true}]
 :seon.ai.model/deepseek-utc-start [:string {:min 1}]
 :seon.ai.model/deepseek-utc-end [:string {:min 1}]
 :seon.ai.model/deepseek-regular-price-factor [:double {:min 0.0}]
 :seon.ai.model/deepseek-peak-price-factor [:double {:min 0.0}]
 :seon.ai.model/deepseek-pricing-schedule-status
 [:enum :announced :active]

 :seon.ai.model/meta-search-usd-per-kquery [:double {:min 0.0}]
 :seon.ai.model/meta-free-requests-per-minute [:int {:min 1}]
 :seon.ai.model/meta-free-tokens-per-minute [:int {:min 1}]
 :seon.ai.model/meta-paid-requests-per-minute [:int {:min 1}]
 :seon.ai.model/meta-paid-tokens-per-minute [:int {:min 1}]

 :seon.ai.model/provider-entity
 [:map
  {:seon.db/attributes true
   :seon.render/ai seon.ai/provider-ai
   :seon.render/html seon.ai/provider-html}
  [:seon.ai.model/provider-id :seon.ai.model/provider-id]
  [:seon.config.ai/endpoint :seon.config.ai/endpoint]
  [:seon.config.ai/api-key-variable :seon.config.ai/api-key-variable]
