#:seon.config.eval.result{:blob-threshold
                          [:int {:min 1, :seon.config/dial true}],
                          :max-bytes
                          [:int
                           {:min 1,
                            :seon.config/dial true,
                            :description
                            "The ONE storage bound on an evaluation's value: UTF-8 bytes of its serialized print node. Admission streams the serialization under the evaluation's SCI interrupt and stops emitting at this bound; a value that reaches it is stored as :seon.eval/missing :over-bound with :seon.eval/size, never as a window of itself."}],
                          :max-collection [:int {:min 1}],
                          :max-depth [:int {:min 1}],
                          :max-nodes [:int {:min 1}],
                          :max-source [:int {:min 1}],
                          :max-string [:int {:min 1}]}
