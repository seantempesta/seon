#:seon.await{:requested-member :seon.schema/value
             :requested-layer :seon.schema/value
             :requested-operation :seon.schema/value
             :subject :map
             :elapsed-ms
             [:double {:min 0 :description "Elapsed monotonic milliseconds when the declared await bound fired. A value observation, retained after the awaited subject is gone."}]
             :closed-operation
             [:enum {:description "The actual channel operation that observed closure before completion; a bounded operation vocabulary, not an entity discriminator."} :put :take]
             :operation-index [:int {:min 0}]
             :timeout-error
             [:and {:seon.db/attributes true
                    :seon.render/ai seon.error/render-ai
                    :seon.render/html seon.error/render-html}
              :seon.error/base
              [:map
               [:seon.await/config-attribute :seon.await/config-attribute]
               [:seon.await/config-value :seon.await/config-value]
               [:seon.await/elapsed-ms :seon.await/elapsed-ms]
               [:seon.await/requested-layer {:optional true} :seon.await/requested-layer]
               [:seon.await/requested-operation {:optional true} :seon.await/requested-operation]
               [:seon.await/subject {:optional true} :seon.await/subject]
               [:seon.await/requested-member {:optional true} :seon.await/requested-member]]]
             :closed-error
             [:and {:seon.db/attributes true
                    :seon.render/ai seon.error/render-ai
                    :seon.render/html seon.error/render-html}
              :seon.error/base
              [:map
               [:seon.await/closed-operation :seon.await/closed-operation]
               [:seon.await/operation-index :seon.await/operation-index]
               [:seon.await/requested-layer {:optional true} :seon.await/requested-layer]
               [:seon.await/requested-operation {:optional true} :seon.await/requested-operation]
               [:seon.await/subject {:optional true} :seon.await/subject]
               [:seon.await/requested-member {:optional true} :seon.await/requested-member]]]
             :config-attribute :qualified-keyword
             :config-value
             [:or
              :seon.config.eval/time-limit-ms
              :seon.config.agent/turn-completion-backstop-ms]
             :bound
             [:map
              [:seon.await/config-attribute :seon.await/config-attribute]
              [:seon.await/config-value :seon.await/config-value]]
             :diagnostic
             [:map
              [:seon.error/layer :seon.schema/value]
              [:seon.error/operation :seon.schema/value]
              [:seon.error/member {:optional true} :seon.schema/value]
              [:seon.error/expected {:optional true} :seon.schema/value]
              [:seon.error/offending {:optional true} :seon.schema/value]
              [:seon.error/data {:optional true} :map]]
             :put-operation
             [:tuple :seon.flow/channel :seon.schema/value]
             :port-operation
             [:or :seon.flow/channel :seon.await/put-operation]
             :port-operations
             [:vector {:min 1} :seon.await/port-operation]
             :accept?
             [:fn
              {:error/message "must accept one completion value"
               :gen/schema [:=> [:cat :seon.schema/value] :boolean]}
              clojure.core/ifn?]
             :blocking-deref
             [:fn
              {:error/message "must support a bounded blocking dereference"
               :gen/gen seon.await/blocking-deref-generator}
              seon.await/blocking-deref?]
             :port-request
             [:map
              [:seon.await/bound :seon.await/bound]
              [:seon.await/diagnostic :seon.await/diagnostic]
              [:seon.await/port-operations :seon.await/port-operations]
              [:seon.await/accept? {:optional true} :seon.await/accept?]]
             :future-request
             [:map
              [:seon.await/bound :seon.await/bound]
              [:seon.await/diagnostic :seon.await/diagnostic]
              [:seon.await/future :seon.flow/future]]
             :deref-request
             [:map
              [:seon.await/bound :seon.await/bound]
              [:seon.await/diagnostic :seon.await/diagnostic]
              [:seon.await/blocking-deref :seon.await/blocking-deref]]
             :request
             [:or
              :seon.await/port-request
              :seon.await/future-request
              :seon.await/deref-request]}
