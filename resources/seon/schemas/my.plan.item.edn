#:my.plan.item{:id
               [:string
                {:min 1,
                 :seon.db/identity true,
                 :description
                 "The stable lookup identity of one authored plan step."}],
               :title
               [:string
                {:min 1,
                 :description "The current human-readable work title."}],
               :description
               [:string
                {:min 1,
                 :description "Optional detail about the work to perform."}],
               :agent
               [:and
                {:description
                 "A retained agent ref from the pre-component plan model. Ownership now derives from the component edges :my.plan/steps and :my.plan.item/steps; my.plan never writes this attribute. Optional peer ref: deleting its target sweeps this backlink."}
                :seon.db/ref],
               :needs
               [:set
                {:description
                 "Value edges naming prerequisite step identities. They survive prerequisite retraction: a missing prerequisite remains blocked until the author removes the dependency or restores and completes that step. Dependency is not ownership."
                 :seon.db/index true}
                :my.plan.item/id],
               :about-token [:or :symbol :qualified-keyword],
               :about
               [:or
                {:description
                 "Ordered function, namespace, and schema tokens this step's work concerns. The outer union selects the scalar EDN codec so authored vector order survives storage."}
                [:vector :my.plan.item/about-token]
                [:= []]],
               :completed-tx
               [:and
                {:description
                 "The transaction completing this step; its db/txInstant is the completion time. Absence means open. Optional ref: retracting the transaction sweeps this completion fact."}
                :seon.db/ref],
               :done-when
               [:string
                {:min 1,
                 :description
                 "Optional falsifiable evidence expected when work completes."}],
               :done-query
               [:and {:description "Completion query: a nonempty result or truthy scalar is evidence of completion; false, nil, or an empty result is not. Inputs are $ and, when subject is present, ?subject. Errors never complete the step."}
                :seon.db/query],
               :subject
               [:and {:description "Optional entity bound as the completion query's second input after $. Sweep: target deletion removes the binding."}
                :seon.db/ref],
               :position
               [:int
                {:min 0,
                 :description
                 "The zero-based order of this step among the siblings owned by one component parent. Cardinality-many is a set, so authored order is a stored fact."}],
               :steps
               [:set
                {:seon.db/component true :seon.db/component-schema :my.plan.item/item,
                 :description
                 "Nested steps owned by this step. Retracting this step retracts them, and the reverse component edge derives each child's parent."}
                :seon.db/ref],
               :item
               [:map
                {:seon.db/attributes true,
                 :seon.render/ai seon.plan/render-item-ai,
                 :seon.render/html seon.plan/render-item-html,
                 :description
                 "One plan step's own attributes. Ownership is the incoming component edge from :my.plan/steps or :my.plan.item/steps, never a stored backlink." :seon.program/partition :seon.data}
                [:my.plan.item/id :my.plan.item/id]
                [:my.plan.item/title :my.plan.item/title]
                [:my.plan.item/position {:optional true} :my.plan.item/position]
                [:my.plan.item/description
                 {:optional true}
                 :my.plan.item/description]
                [:my.plan.item/agent {:optional true} :my.plan.item/agent]
                [:my.plan.item/needs {:optional true} :my.plan.item/needs]
                [:my.plan.item/steps {:optional true} :my.plan.item/steps]
                [:my.plan.item/about {:optional true} :my.plan.item/about]
                [:my.plan.item/completed-tx
                 {:optional true}
                 :my.plan.item/completed-tx]
                [:my.plan.item/done-when
                 {:optional true}
                 :my.plan.item/done-when]
                [:my.plan.item/done-query {:optional true} :my.plan.item/done-query]
                [:my.plan.item/subject {:optional true} :my.plan.item/subject]],
               :add-request
               [:map
                {:description
                 "One step to add to an agent's plan, at the root or nested under a named parent step."}
                [:my.plan.item/id {:optional true} :my.plan.item/id]
                [:my.plan.item/title :my.plan.item/title]
                [:my.plan.item/description
                 {:optional true}
                 :my.plan.item/description]
                [:my.plan.item/needs {:optional true} :my.plan.item/needs]
                [:my.plan.item/about {:optional true} :my.plan.item/about]
                [:my.plan.item/done-when
                 {:optional true}
                 :my.plan.item/done-when]
                [:my.plan.item/done-query {:optional true} :my.plan.item/done-query]
                [:my.plan.item/subject {:optional true} :my.plan.item/subject]
                [:my.plan/parent-step {:optional true} :my.plan/parent-step]
                [:my.plan/current? {:optional true} :my.plan/current?]]}
