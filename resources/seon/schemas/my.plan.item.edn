#:my.plan.item{:id
               [:string
                {:min 1,
                 :seon.db/identity true,
                 :description
                 "The stable lookup identity of one authored plan item."}],
               :title
               [:string
                {:min 1,
                 :description "The current human-readable work title."}],
               :description
               [:string
                {:min 1,
                 :description "Optional detail about the work to perform."}],
               :agent
               [:and
                {:description
                 "The agent whose authored plan contains this item; reverse pull :my.plan.item/_agent finds that agent's items."}
                :seon.db/ref],
               :parent
               [:and
                {:description
                 "An optional plan-item ref expressing authored decomposition."}
                :seon.db/ref],
               :needs
               [:set
                {:description
                 "Plan-item refs whose open work currently blocks this item."}
                :seon.db/ref],
               :about-token [:or :symbol :qualified-keyword],
               ;; The subset branch keeps the outer `:or` structurally present
               ;; so the Datahike bridge uses its scalar EDN codec and preserves
               ;; authored vector order.
               :about
               [:or
                {:description
                 "Ordered function, namespace, and schema tokens this item's work concerns."}
                [:vector :my.plan.item/about-token]
                [:= []]],
               :completed-at
               [:and
                {:description
                 "The completion instant; absence means the item remains open."}
                :inst],
               :expected-result
               [:string
                {:min 1,
                 :description
                 "Optional falsifiable evidence expected when work completes."}],
               :item
               [:map
                {:seon.db/attributes true,
                 :seon.render/ai my.plan/render-item-ai,
                 :seon.render/html my.plan/render-item-html}
                [:my.plan.item/id :my.plan.item/id]
                [:my.plan.item/title :my.plan.item/title]
                [:my.plan.item/agent :my.plan.item/agent]
                [:my.plan.item/description
                 {:optional true}
                 :my.plan.item/description]
                [:my.plan.item/parent {:optional true} :my.plan.item/parent]
                [:my.plan.item/needs {:optional true} :my.plan.item/needs]
                [:my.plan.item/about {:optional true} :my.plan.item/about]
                [:my.plan.item/completed-at
                 {:optional true}
                 :my.plan.item/completed-at]
                [:my.plan.item/expected-result
                 {:optional true}
                 :my.plan.item/expected-result]],
               :add-request
               [:map
                [:my.plan.item/id :my.plan.item/id]
                [:my.plan.item/title :my.plan.item/title]
                [:my.plan.item/description
                 {:optional true}
                 :my.plan.item/description]
                [:my.plan.item/parent {:optional true} :my.plan.item/parent]
                [:my.plan.item/needs {:optional true} :my.plan.item/needs]
                [:my.plan.item/about {:optional true} :my.plan.item/about]
                [:my.plan.item/expected-result
                 {:optional true}
                 :my.plan.item/expected-result]
                [:my.plan/anchor? {:optional true} :my.plan/anchor?]]}
