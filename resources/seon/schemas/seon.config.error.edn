#:seon.config.error{:escalate-to
                    [:string
                     {:min 1,
                      :seon.config/optional true,
                      :seon.config/dial true}],
                    :max-evidence-bytes
                    [:int
                     {:min 1,
                      :description
                      "UTF-8 bytes of evidence one durable fault fact keeps INLINE. The fault's meaningful source goes through the same streaming admission every stored value does, with this bound in place of the storage bound; over it the fact records :seon.sci.admit/reason and the size reached, and the complete evidence stays in the fault's content blob.",
                      :seon.config/dial true}],
                    :recurrence-limit
                    [:int {:min 1, :seon.config/dial true}],
                    :agent-error-agents
                    [:int
                     {:min 1,
                      :description
                      "Distinct agents that must hit one agent-delivered error pattern before it is a defect in Seon's own context or tools and joins health's problems. One agent's mistake stays that agent's.",
                      :seon.config/dial true}]}
