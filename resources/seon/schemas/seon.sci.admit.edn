#:seon.sci.admit{:reason [:enum {:description "Why bounded external evidence could not be encoded; never an evaluation outcome."} :over-bound :unserializable :lost]
 :bytes [:int {:min 0 :description "UTF-8 bytes reached while encoding bounded external evidence."}]
:edn :string
                 :admitted
                 [:or
                  [:map
                   [:seon.sci.admit/print-node :seon.print/node]
                   [:seon.sci.admit/value :seon.sci.admit/value]
                   [:seon.sci.admit/edn
                    :seon.sci.admit/edn]
                   [:seon.sci.admit/record
                    {:optional true}
                    :seon.sci.admit/record]]
                  :seon.sci.admit/missing],
                 :missing
                 [:map
                  {:description
                   "The whole answer for a value admission stored nothing for: the reason, and the bytes reached when the storage bound is the reason. No print node, no value, no result EDN — a missing value ablates its handle rather than storing a window of itself."}
                  [:seon.sci.admit/reason :seon.sci.admit/reason]
                  [:seon.sci.admit/bytes {:optional true} :seon.sci.admit/bytes]
                  [:seon.sci.admit/record
                   {:optional true}
                   :seon.sci.admit/record]],
                 :unbounded? :boolean,
                 :caps
                 [:map
                  [:seon.config.eval.result/max-bytes
                   :seon.config.eval.result/max-bytes]
                  [:seon.config.eval.result/max-source
                   :seon.config.eval.result/max-source]
                  [:seon.config.eval/alloc-limit-bytes
                   {:optional true}
                   :seon.config.eval/alloc-limit-bytes]],
                 :interrupt-fn
                 [:fn
                  {:error/message
                   "must be a callable value for SCI interruption checks"
                   :gen/gen seon.sci.admit/interrupt-fn-generator}
                  seon.sci.admit/interrupt-fn?],
                 :print-node :seon.print/node,
                 :record
                 [:map
                  [:seon.eval/fn-entries :seon.eval/fn-entries]
                  [:seon.eval/host-interop-count
                   :seon.eval/host-interop-count]
                  [:seon.eval/duration-ms :seon.eval/duration-ms]
                  [:seon.eval/allocated-bytes
                   :seon.eval/allocated-bytes]
                  [:seon.eval/outcome :seon.eval/outcome]
                  [:seon.heap/crossing {:optional true :description "A critical heap crossing observed while the evaluation ran (seon.sci.kernel/mark-running!): its reply carries it as a diagnostic."} :seon.heap/crossing-error]],
                 :request
                 [:and
                  [:map
                  [:seon.sci.admit/value :seon.sci.admit/value]
                  [:seon.sci.admit/interrupt-fn
                   :seon.sci.admit/interrupt-fn]
                  [:seon.sci.admit/caps :map]
                  [:seon.sci.admit/unbounded?
                   {:optional true}
                   :seon.sci.admit/unbounded?]
                  [:seon.schema/projection
                   {:optional true}
                   :seon.schema/projection]
                  [:seon.sci.admit/record
                   {:optional true}
                   :seon.sci.admit/record]]
                  [:or
                   [:map [:seon.sci.admit/unbounded? [:= true]]]
                   [:map [:seon.sci.admit/caps :seon.sci.admit/caps]]]],
                 :value [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary
                               :seon.schema.admission/reason "MCP and error evidence may contain any Clojure value before their bounded external projection."
                               :gen/elements [nil true 0 "" :k [] {} #{}]}],
                 :admitted-value
                 [:or
                  [:map
                   [:seon.sci.admit/print-node :seon.print/node]
                   [:seon.sci.admit/value :seon.sci.admit/value]
                   [:seon.sci.admit/record
                    {:optional true}
                    :seon.sci.admit/record]]
                  :seon.sci.admit/missing]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.sci.admit/bound-bytes
 [:int {:min 1}]

 :seon.sci.admit/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.sci.admit/bound-bytes :seon.sci.admit/bound-bytes]
  [:seon.sci.admit/projection-observation
   :seon.sci.admit/projection-observation]]]

 :seon.sci.admit/projection-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]

:projection-failure-message :string
:failed-class :symbol
}
