;; Co-located Malli schemas for `seon.code`: namespaces, lossless forms, compiler-analyzed vars,
;; Markdown doc sections, and tracked files. Datahike schema is derived 100% automatically!
{;; --- Namespaces (`seon.code.ns/*`) ---
 :seon.code.ns/name     [:and {:seon.db/identity true :seon.db/content-id true} :symbol]
 :seon.code.ns/parent   [:and {:seon.db/index true} :seon.store/ref]
 :seon.code.ns/path     [:string {:seon.db/index true :min 1}]
 :seon.code.ns/doc      :string
 :seon.code.ns/requires [:set {:seon.db/index true} :symbol]
 :seon.code.ns/tail     :string

 :seon.code.ns/entity
 [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/ns-tile}
  [:seon.code.ns/name :seon.code.ns/name]
  [:seon.code.ns/parent {:optional true} :seon.code.ns/parent]
  [:seon.code.ns/path {:optional true} :seon.code.ns/path]
  [:seon.code.ns/doc {:optional true} :seon.code.ns/doc]
  [:seon.code.ns/requires {:optional true} :seon.code.ns/requires]
  [:seon.code.ns/tail {:optional true} :seon.code.ns/tail]]

 ;; --- Lossless Top-Level Forms (`seon.code.form/*`) ---
 :seon.code.form/key    [:and {:seon.db/identity true :seon.db/content-id true} [:string {:min 1}]]
 :seon.code.form/ns     [:and {:seon.db/index true} :symbol]
 :seon.code.form/order  :int
 :seon.code.form/lead   :string
 :seon.code.form/src    [:string {:min 1}]
 :seon.code.form/hash   [:string {:min 8}]
 :seon.code.form/deps   [:set {:seon.db/index true} :symbol]
 :seon.code.form/test?  :boolean

 :seon.code.form/entity
 [:map {:seon.db/attributes true}
  [:seon.code.form/key :seon.code.form/key]
  [:seon.code.form/ns :seon.code.form/ns]
  [:seon.code.form/order :seon.code.form/order]
  [:seon.code.form/lead {:optional true} :seon.code.form/lead]
  [:seon.code.form/src :seon.code.form/src]
  [:seon.code.form/hash :seon.code.form/hash]
  [:seon.code.form/deps {:optional true} :seon.code.form/deps]
  [:seon.code.form/test? {:optional true} :seon.code.form/test?]]

 ;; --- Structured Compiler-Analyzed Vars (`seon.code.var/*`) ---
 :seon.code.var/name           [:and {:seon.db/identity true :seon.db/content-id true} :qualified-symbol]
 :seon.code.var/ns             [:and {:seon.db/index true} :symbol]
 :seon.code.var/ns-ref         [:and {:seon.db/index true} :seon.store/ref]
 :seon.code.var/form           [:string {:seon.db/index true :min 1}]
 :seon.code.var/doc            :string
 :seon.code.var/arglists       [:vector [:vector :symbol]]
 :seon.code.var/private?       :boolean
 :seon.code.var/macro?         :boolean
 :seon.code.var/test?          [:and {:seon.db/index true} :boolean]
 :seon.code.var/platform-test? [:and {:seon.db/index true} :boolean]
 :seon.code.var/flow-edge?     :boolean
 :seon.code.var/schema         [:any {:gen/elements [[:=> [:cat :int] :int] [:=> [:cat :string] :boolean]]}]
 :seon.code.var/schema-refs    [:set {:seon.db/index true} :qualified-keyword]
 :seon.code.var/refs           [:set {:seon.db/index true} :qualified-symbol]
 :seon.code.var/ticks-budget   [:int {:min 1 :max 10000000000}]
 :seon.code.var/bytes-budget   [:int {:min 0 :max 10000000000}]
 :seon.code.var/big-o          :string

 :seon.code.var/entity
 [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/var-tile}
  [:seon.code.var/name :seon.code.var/name]
  [:seon.code.var/ns :seon.code.var/ns]
  [:seon.code.var/ns-ref {:optional true} :seon.code.var/ns-ref]
  [:seon.code.var/form :seon.code.var/form]
  [:seon.code.var/doc {:optional true} :seon.code.var/doc]
  [:seon.code.var/arglists {:optional true} :seon.code.var/arglists]
  [:seon.code.var/private? {:optional true} :seon.code.var/private?]
  [:seon.code.var/macro? {:optional true} :seon.code.var/macro?]
  [:seon.code.var/test? {:optional true} :seon.code.var/test?]
  [:seon.code.var/platform-test? {:optional true} :seon.code.var/platform-test?]
  [:seon.code.var/flow-edge? {:optional true} :seon.code.var/flow-edge?]
  [:seon.code.var/schema {:optional true} :seon.code.var/schema]
  [:seon.code.var/schema-refs {:optional true} :seon.code.var/schema-refs]
  [:seon.code.var/refs {:optional true} :seon.code.var/refs]
  [:seon.code.var/ticks-budget {:optional true} :seon.code.var/ticks-budget]
  [:seon.code.var/bytes-budget {:optional true} :seon.code.var/bytes-budget]
  [:seon.code.var/big-o {:optional true} :seon.code.var/big-o]]

 ;; --- Lossless Markdown Sections (`seon.code.doc/*`) ---
 :seon.code.doc/id      [:and {:seon.db/identity true :seon.db/content-id true} [:string {:min 1}]]
 :seon.code.doc/path    [:string {:seon.db/index true :min 1}]
 :seon.code.doc/order   :int
 :seon.code.doc/heading :string
 :seon.code.doc/body    :string

 :seon.code.doc/entity
 [:map {:seon.db/attributes true :seon.render/hiccup seon.render.ui/doc-tile}
  [:seon.code.doc/id :seon.code.doc/id]
  [:seon.code.doc/path :seon.code.doc/path]
  [:seon.code.doc/order :seon.code.doc/order]
  [:seon.code.doc/heading :seon.code.doc/heading]
  [:seon.code.doc/body :seon.code.doc/body]]

 ;; --- Non-Clojure / Non-Markdown Tracked Files (`seon.code.file/*`) ---
 :seon.code.file/path  [:and {:seon.db/identity true :seon.db/content-id true} [:string {:min 1}]]
 :seon.code.file/text  :string
 :seon.code.file/exec? :boolean

 :seon.code.file/entity
 [:map {:seon.db/attributes true}
  [:seon.code.file/path :seon.code.file/path]
  [:seon.code.file/text :seon.code.file/text]
  [:seon.code.file/exec? {:optional true} :seon.code.file/exec?]]}
