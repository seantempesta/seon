#:seon.cluster.wake{:attributes [:set :keyword],
                    :channels fn?,
                    :delivery
                    [:enum
                     :seon.cluster.wake/delivered
                     :seon.cluster.wake/fenced
                     :seon.cluster.wake/refused],
                    :fenced? fn?,
                    :key :keyword,
                    :offer-result [:enum true false nil],
                    :route-request
                    [:map
                     [:seon.cluster.wake/connection
                      :seon.db/connection]
                     [:seon.cluster.wake/channels
                      :seon.cluster.wake/channels]
                     [:seon.cluster.wake/fenced?
                      :seon.cluster.wake/fenced?]
                     [:seon.flow/plan-channel
                      :seon.flow/channel]
                     [:seon.cluster.wake/render-channel
                      {:optional true
                       :description "Where render wakes go; a route without one (a cluster serving no view) delivers none."}
                      :seon.flow/channel]
                     [:seon.render.web/interest
                      {:optional true}
                      :seon.render.web/interest]
                     [:seon.cluster.wake/key :seon.cluster.wake/key]],
                    :unlisten-request
                    [:map
                     [:seon.cluster.wake/connection
                      :seon.db/connection]
                     [:seon.cluster.wake/key :seon.cluster.wake/key]],
                    :undeliverable-wake [:or :seon.agent/id :seon.cluster.wake/key]
                    :undeliverable-wake-error [:and {:error/message "must identify the registration whose wake could not be delivered"} :seon.error/base [:map [:seon.cluster.wake/undeliverable-wake :seon.cluster.wake/undeliverable-wake]]]
 ; Additive error declaration manifest, 2026-09-18.

 :seon.cluster.wake/error
 [:and
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.cluster.wake/error-recipient
   :seon.cluster.wake/error-recipient]
  [:seon.cluster.wake/offer-observation
   :seon.cluster.wake/offer-observation]]]

 :seon.cluster.wake/error-recipient
 [:string {:min 1}]

 :seon.cluster.wake/unroutable-declarations-error
 [:and {:description "The installed wake declarations cannot carry a cluster (no listened or inside attribute, a listened attribute outside :avet) or can never arm a created agent; the attributes concerned. seon.cluster.wake/route! answers it and registers nothing."}
  :seon.error/base
  [:map [:seon.cluster.wake/attributes :seon.cluster.wake/attributes]]]

 :seon.cluster.wake/offer-observation
 [:and
 {:seon.db/component true,
  :seon.db/component-schema :seon.error.evidence/entity}
 :seon.db/ref]
}
