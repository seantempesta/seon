#:seon.db{:attributes :boolean,
          :component :boolean,
          :db :seon.db/database-value,
          :entity :boolean,
          :identity :boolean,
          :index :boolean,
          :no-history? :boolean,
          :unique :boolean,
          :connection
          [:fn
           {:error/message
            "must be a live unreleased Datahike connection from the calling cluster"
            :gen/gen seon.db/connection-generator
            :seon.schema/identity-only true
            :seon.schema/identity-projection seon.db/connection-identity}
           seon.db/connection?],
          :connection-id [:vector [:or :uuid :keyword]],
          :connection-identity
          [:map
           [:datahike/connection-id :seon.db/connection-id]],
          :database-value
          [:fn
           {:error/message "must be an immutable Datahike database value"
            :gen/gen seon.db/database-value-generator
            :seon.schema/identity-only true
            :seon.schema/identity-projection seon.db/database-value-identity}
           seon.db/database-value?],
          :database-name :keyword,
          :basis-t :int,
          :database-value-identity
          [:map
           {:seon.render/ai seon.render.value/render-database-identity-ai}
           [:db-name :seon.db/database-name]
           [:t :seon.db/basis-t]
           [:datahike/commit-id :uuid]],
          :datom
          [:map
           [:e :seon.schema/value]
           [:a :seon.schema/value]
           [:v :seon.schema/value]
           [:tx :int]
           [:added :boolean]],
          :datoms [:vector :seon.db/datom],
          :datom-count [:int {:min 0}],
          :entity-id
          [:or :int [:sequential :seon.schema/value] :keyword],
          :index-lookup
          [:map
           [:index [:enum :eavt :aevt :avet]]
           [:components
            {:optional true}
            [:or :nil [:sequential :seon.schema/value]]]],
          :process [:and #:seon.db{:index true} :seon.db/ref],
          :pull-many-options
          [:map
           [:selector :seon.db/pull-selector]
           [:eids [:sequential :seon.db/entity-id]]
           [:max-work {:optional true} [:int {:min 1}]]
           [:max-results {:optional true} [:int {:min 1}]]
           [:max-result-weight {:optional true} [:int {:min 1}]]],
          :pull-options
          [:map
           [:selector :seon.db/pull-selector]
           [:eid :seon.db/entity-id]
           [:max-work {:optional true} [:int {:min 1}]]
           [:max-results {:optional true} [:int {:min 1}]]
           [:max-result-weight {:optional true} [:int {:min 1}]]],
          :pull-selector [:vector :seon.schema/value],
          :query [:or [:vector :seon.schema/value] :map :string],
          :query-args
          [:map
           [:query :seon.db/query]
           [:args {:optional true} [:sequential :seon.schema/value]]
           [:request-id {:optional true} :string]
           [:limit {:optional true} :int]
           [:offset {:optional true} :int]
           [:max-work {:optional true} [:int {:min 1}]]
           [:max-results {:optional true} [:int {:min 1}]]
           [:max-result-weight {:optional true} [:int {:min 1}]]],
          :time-point [:or :inst :int],
          :tx-data :seon.store/transaction-data,
          :transaction-report
          [:map
           {:seon.render/ai seon.db/render-transaction-ai
            :seon.render/html seon.db/render-transaction-html}
           [:tx :int]
           [:datahike/commit-id :uuid]
           [:seon.db/datom-count :seon.db/datom-count]
           [:tx-data [:vector :seon.db/datom]]
           [:tempids :map]],
          :user [:and #:seon.db{:index true} :seon.db/ref],
          :conflict-attribute :qualified-keyword,
          :conflict-value :seon.schema/value,
          :conflict-owner :seon.db/entity-id,
          :transaction-refused [:= true]
          :transaction-refused-error [:map {:seon.error/class true :seon.render/ai seon.db/render-rejection-ai :seon.render/html seon.db/render-rejection-html :error/message "must mark a database transaction that was refused"} [:seon.db/transaction-refused :seon.db/transaction-refused] [:seon.error/message :seon.error/message]]
          :transaction-outcome-unknown [:= true]
          :transaction-outcome-unknown-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a database transaction whose outcome is unknown"} [:seon.db/transaction-outcome-unknown :seon.db/transaction-outcome-unknown] [:seon.error/message :seon.error/message]]}
