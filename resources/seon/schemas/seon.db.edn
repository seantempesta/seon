#:seon.db{:attributes [:boolean {:description "On a map schema, :seon.db/attributes true declares its entries as database attributes; the map stays open to extra keys and gains no identity constraint."}],
          :append-only-after [:qualified-keyword {:description "Schema property naming the assignment attribute whose history activates nonempty membership retention at database admission."}],
          :retraction-authority [:qualified-keyword {:description "Schema property naming the creator ref whose first historical assertion authorizes membership retraction."}],
          :lookup-ref-value
          [:or :string :uuid :keyword :symbol :int
           [:schema {:registry
                     {:seon.db/lookup-value
                      [:or :string :uuid :keyword :symbol :int
                       [:tuple :keyword [:ref :seon.db/lookup-value]]]}}
            [:tuple :keyword :seon.db/lookup-value]]],
          :ref [:or {:description "A Datahike reference: entity id, tempid, lookup ref, or nested entity map carrying :db/id. Datahike transaction/explode resolves the nested map to that entity; wildcard pull returns the same spelling."}
                :int :string [:tuple :keyword :seon.db/lookup-ref-value]
                [:map [:db/id :int]]],
          :component :boolean,
          ;; One component's OWN entity map, as Datahike's transaction-data
          ;; grammar accepts it in the place of a ref. Nothing declares this
          ;; key at a call site: the registry derives it as the second arm of
          ;; every child position whose enclosing form declares
          ;; `:seon.db/component true`, so a component-bearing row validates
          ;; as the transaction data it is.
          :component-entity
          [:map-of
           {:min 1
            :error/message
            "must be a component's own entity map of qualified attributes"}
           :qualified-keyword
           :seon.schema/value],
          :db :seon.db/database-value,
          :read-evidence-sink
          [:fn
           {:error/message
            "must be a process-local atom collecting database read evidence"
            :gen/gen seon.flow/atom-reference-generator}
           seon.flow/atom-reference?],
          :source-argument-position [:int {:min 0}],
          :pattern-entity :int,
          :pattern-attribute :qualified-keyword,
          :pattern-value :seon.schema/value,
          :read-index-pattern
          [:map
           [:seon.db/pattern-entity {:optional true} :seon.db/pattern-entity]
           [:seon.db/pattern-attribute {:optional true} :seon.db/pattern-attribute]
           [:seon.db/pattern-value {:optional true} :seon.db/pattern-value]],
          :read-index-patterns [:vector :seon.db/read-index-pattern],
          :read-basis-t :seon.db/basis-t,
          :read-dependency-attributes [:or [:= :all] [:set :qualified-keyword]],
          :read-dependency-source
          [:map
           [:datahike.query.source/symbol :symbol]
           [:datahike.query.source/argument-position [:int {:min 0}]]
           [:datahike.query.source/attributes :seon.db/read-dependency-attributes]
           [:seon.db/read-index-patterns {:optional true} :seon.db/read-index-patterns]
           [:seon.db/read-basis-t {:optional true} :seon.db/read-basis-t]],
          :read-dependency-plan
          [:or
           [:= :all]
           [:map
            [:datahike.query.dependency/sources
             [:vector :seon.db/read-dependency-source]]]],
          :read-operation [:enum :q :pull :pull-many :index-page],
          :read-evidence-options
          [:map
           [:seon.db/retain-read-results? {:optional true} :boolean]],
          :pull-arguments [:vector :seon.schema/value],
          :read-request
          [:or
           [:map
            [:seon.db/read-operation [:= :q]]
            [:seon.db/query-request :seon.db/query-args]]
           [:map
            [:seon.db/read-operation [:enum :pull :pull-many]]
            [:seon.db/pull-arguments :seon.db/pull-arguments]]
           [:map
            [:seon.db/read-operation [:= :index-page]]
            [:seon.db/index-page-options :seon.db/index-page-options]]],
          ;; Stable read results are optional process-local render evidence.
          ;; Durable evaluation evidence omits them and no database attribute
          ;; stores this key.
          :read-result :seon.schema/value,
          ;; Fixed-size semantic replay evidence for durable pull reads.
          :read-result-digest :seon.blob/digest,
          ;; A read's source is identified exactly as Datahike identifies its
          ;; own query-cache key (query.cljc:2658-2671): a committed raw DB by
          ;; its cache context, an as-of view by the ORIGIN's context plus its
          ;; fixed time point, and every remaining shape — since, history,
          ;; filtered, speculative — by nothing at all, because those values
          ;; carry no committed identity. The third arm states that absence
          ;; instead of silently producing nils.
          :dependency-revision
          [:or
           [:map
            [:datahike.cache/connection-id :seon.db/connection-id]
            [:datahike.cache/generation :uuid]
            [:datahike.read/time-point {:optional true} :int]
            [:datahike.read/attributes [:= :all]]
            [:datahike.read/revision :uuid]]
           [:map
            [:datahike.cache/connection-id :seon.db/connection-id]
            [:datahike.cache/generation :uuid]
            [:datahike.read/time-point {:optional true} :int]
            [:datahike.read/attributes [:set :qualified-keyword]]
            [:datahike.cache/conservative-revision {:optional true} :uuid]
            [:datahike.cache/attribute-revisions
             [:map-of :qualified-keyword :uuid]]]
           [:map
            [:datahike.read/attributes
             :seon.db/read-dependency-attributes]
            [:datahike.read/cache-eligible? [:= false]]]],
          :captured-read
          [:map
           [:seon.db/db :seon.db/database-value]
           [:seon.db/source-argument-position :seon.db/source-argument-position]
           [:datahike.read/dependency-plan :seon.db/read-dependency-plan]
           [:seon.db/read-index-patterns {:optional true} :seon.db/read-index-patterns]
           [:seon.db/read-request {:optional true} :seon.db/read-request]
           [:seon.db/read-result {:optional true} :seon.db/read-result]],
          :read-evidence
          [:map
           [:seon.db/source-argument-position :seon.db/source-argument-position]
           [:datahike.read/dependency-plan :seon.db/read-dependency-plan]
           [:datahike.read/revision :seon.db/dependency-revision]
           [:seon.db/read-request {:optional true} :seon.db/read-request]
           [:seon.db/read-result-digest {:optional true}
            :seon.db/read-result-digest]
           [:seon.db/read-result {:optional true} :seon.db/read-result]],
          :entity :boolean,
          :identity :boolean,
          :index :boolean,
          :no-history? :boolean,
          :unique :boolean,
          ; A CONNECTION IS A CONNECTION OBJECT, live or released. Its
          ; released-ness is temporal state the authority re-decides -- and
          ; already does: `seon.db/transact!` answers the typed value "The
          ; explicit transaction connection is not live."
          ; (src/seon/db.clj:3195) and Datahike refuses at the write. Declaring
          ; liveness here was a second, earlier, weaker copy of that decision,
          ; and it refused every RELEASE-time caller whose whole job is the
          ; released case: `seon.cluster/stop!` on a stopped instance and
          ; `seon.cluster.wake/unlisten!`, whose own docstring says stop "may
          ; arrive after a store release".
          :connection
          [:fn
           {:error/message
            "must be a Datahike connection object, live or released"
            :gen/gen seon.db/connection-generator
            :seon.schema/identity-only true
            :seon.schema/identity-projection seon.db/connection-identity}
           seon.db/connection-object?],
          :custody-request
          [:map
           {:description "The cluster custody one scope hands to another as a value. The connection present means the scope runs as that cluster's own work and the elided seon.db arities reach it; absent means no custody, and those arities refuse."}
           [:seon.db/connection {:optional true} :seon.db/connection]],
          :connection-id [:vector [:or :uuid :keyword]],
          :connection-identity
          [:map
           [:datahike/connection-id :seon.db/connection-id]],
          :database-value
          [:fn
           {:error/message "must be an immutable Datahike database value"
            :gen/gen seon.db/database-value-generator
            :seon.schema/identity-only true
            :seon.schema/identity-projection seon.db/database-value-identity}
           seon.db/database-value?],
          :database-name :keyword,
          :basis-t :int,
          :current-basis-t :seon.db/basis-t,
          :database-value-identity
          [:map
           {:seon.render/ai seon.render.value/render-database-identity-ai}
           [:db-name :seon.db/database-name]
           [:t :seon.db/basis-t]
           [:datahike/commit-id :uuid]],
          :datom
          [:map
           [:e :seon.schema/value]
           [:a :seon.schema/value]
           [:v :seon.schema/value]
           [:tx :int]
           [:added :boolean]],
          :transaction-datom
          [:tuple :seon.db/entity-id :qualified-keyword :seon.schema/value :boolean],
          :datoms [:vector [:or :seon.db/datom :seon.db/transaction-datom]],
          :tx :seon.db/basis-t,
          :transaction-result
          [:map
           [:seon.db/tx :seon.db/tx]
           [:seon.db/datoms :seon.db/datoms]],
          :index-page-cursor
          [:tuple :seon.schema/value :seon.schema/value :seon.schema/value
           :int :boolean],
          :index-page-options
          [:map
           [:index [:enum :eavt :aevt :avet]]
           [:components [:vector {:max 4} :seon.schema/value]]
           [:direction [:enum :forward :reverse]]
           [:limit [:int {:min 1 :max 200}]]
           [:cursor {:optional true} :seon.db/index-page-cursor]
           [:max-result-weight [:int {:min 1}]]],
          :index-page-result
          [:map
           [:datahike.index-page/datoms :seon.db/datoms]
           [:datahike.index-page/complete? :boolean]
           [:datahike.index-page/cursor {:optional true}
            :seon.db/index-page-cursor]],
          :datom-count [:int {:min 0}],
          :entity-id
          [:or :int [:sequential :seon.schema/value] :keyword],
          :index-lookup
          [:map
           [:index [:enum :eavt :aevt :avet]]
           [:components
            {:optional true}
            [:or :nil [:sequential :seon.schema/value]]]],
          :process [:and #:seon.db{:index true} :seon.db/ref],
          :receipt [:and #:seon.db{:index true} :seon.db/ref],
          :pull-many-options
          [:map
           [:selector :seon.db/pull-selector]
           [:eids [:sequential :seon.db/entity-id]]
           [:max-work {:optional true} [:int {:min 1}]]
           [:max-results {:optional true} [:int {:min 1}]]
           [:max-result-weight {:optional true} [:int {:min 1}]]],
          :pull-options
          [:map
           [:selector :seon.db/pull-selector]
           [:eid :seon.db/entity-id]
           [:max-work {:optional true} [:int {:min 1}]]
           [:max-results {:optional true} [:int {:min 1}]]
           [:max-result-weight {:optional true} [:int {:min 1}]]],
          :pull-selector [:vector :seon.schema/value],
          :query [:or [:vector :seon.schema/value] :map :string],
          :query-args
          [:map
           [:query :seon.db/query]
           [:args {:optional true} [:sequential :seon.schema/value]]
           [:request-id {:optional true} :string]
           [:limit {:optional true} :int]
           [:offset {:optional true} :int]
           [:max-work {:optional true} [:int {:min 1}]]
           [:max-results {:optional true} [:int {:min 1}]]
           [:max-result-weight {:optional true} [:int {:min 1}]]],
          :time-point [:or :inst :int],
          :tx-data :seon.store/transaction-data,
          :transaction-report
          [:map
           {:seon.render/ai seon.db/render-transaction-ai
            :seon.render/html seon.db/render-transaction-html}
           [:db-before
            [:or :seon.db/database-value
             :seon.db/database-value-identity]]
           [:db-after
            [:or :seon.db/database-value
             :seon.db/database-value-identity]]
           [:tx-data [:vector :seon.schema/value]]
           [:tempids :map]
           [:tx-meta :map]],
          :user [:and #:seon.db{:index true} :seon.db/ref],
          :conflict-attribute :qualified-keyword,
          :conflict-value :seon.schema/value,
          :conflict-owner :seon.db/entity-id,
          :transaction-refused [:= true]
          :transaction-refused-error [:map {:seon.error/class true :seon.render/ai seon.db/render-rejection-ai :seon.render/html seon.db/render-rejection-html :error/message "must mark a database transaction that was refused"} [:seon.db/transaction-refused :seon.db/transaction-refused] [:seon.error/message :seon.error/message]]
          :transaction-outcome-unknown [:= true]
          :transaction-outcome-unknown-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark a database transaction whose outcome is unknown"} [:seon.db/transaction-outcome-unknown :seon.db/transaction-outcome-unknown] [:seon.error/message :seon.error/message]]
 :seon.db/invalid-read [:= true]
 :seon.db/invalid-read-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.db/invalid-read class marker"} [:seon.db/invalid-read :seon.db/invalid-read] [:seon.error/message :seon.error/message]]
 :seon.db/invalid-request [:= true]
 :seon.db/invalid-request-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.db/invalid-request class marker"} [:seon.db/invalid-request :seon.db/invalid-request] [:seon.error/message :seon.error/message]]
 :seon.db/diff-refused [:= true]
 :seon.db/diff-refused-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must carry the :seon.db/diff-refused class marker"} [:seon.db/diff-refused :seon.db/diff-refused] [:seon.error/message :seon.error/message]]}
