#:seon.operator{:advertisements [:vector :seon.boot/advertisement],
                 :repository-root :seon.boot/root,
                 :managed-root :seon.boot/root,
                 :ephemeral? :boolean,
                 :control-lock-held? :boolean,
                 :root-request
                 [:map
                  [:seon.operator/repository-root :seon.operator/repository-root]
                  [:seon.operator/managed-root :seon.operator/managed-root]
                  [:seon.operator/ephemeral? {:optional true} :seon.operator/ephemeral?]
                  [:seon.boot/cluster-name {:optional true} :seon.boot/cluster-name]],
                 :cleanup-request
                 [:map
                 [:seon.operator/repository-root :seon.operator/repository-root]
                  [:seon.operator/managed-root :seon.operator/managed-root]
                  [:seon.operator/control-lock-held?
                   {:optional true}
                   :seon.operator/control-lock-held?]],
                 :footprint-request
                 [:map
                  [:seon.operator/repository-root :seon.operator/repository-root]
                  [:seon.operator/managed-root :seon.operator/managed-root]
                  [:seon.config.maintenance/min-usable-bytes
                   {:optional true}
                   :seon.config.maintenance/min-usable-bytes]
                  [:seon.config.maintenance/min-usable-ratio
                   {:optional true}
                   :seon.config.maintenance/min-usable-ratio]],
                 :log-request
                 [:map
                  [:seon.boot/log-dir :seon.boot/log-dir]
                  [:seon.config.maintenance/log-max-bytes
                   :seon.config.maintenance/log-max-bytes]
                  [:seon.config.maintenance/log-retained-files
                   :seon.config.maintenance/log-retained-files]],
                 :existence-request
                 [:map
                  [:seon.operator/repository-root :seon.operator/repository-root]],
                 :footprint
                 [:map
                  [:seon.operator.footprint/root :string]
                  [:seon.operator.footprint/bytes [:int {:min 0}]]
                  [:seon.operator.footprint/usable-bytes [:int {:min 0}]]
                  [:seon.operator.footprint/total-bytes [:int {:min 0}]]
                  [:seon.operator.footprint/usable-ratio :double]
                  [:seon.operator.footprint/observed-at :inst]],
                 :cleanup-result
                 [:map
                  [:seon.operator.cleanup/root :string]
                  [:seon.operator.cleanup/target :string]
                  [:seon.operator.cleanup/removed [:vector :string]]
                  [:seon.operator.cleanup/reclaimed-bytes [:int {:min 0}]]
                  [:seon.operator.cleanup/remaining [:vector :string]]
                  [:seon.operator.cleanup/complete? :boolean]],
                 :existence :map,
                 :log-result :map,
                 :branches :seon.cluster.registry/roster,
                 :census
                 [:map
                  [:seon.operator/advertisements
                   :seon.operator/advertisements]
                  [:seon.operator/branches :seon.operator/branches]],
                 :changed-paths [:vector :string],
                 :clusters [:vector :seon.operator/observation],
                 :flow [:or [:enum :unknown] :map],
                 :health [:enum :observed :unknown],
                 :observation
                 [:map
                  [:seon.boot/cluster-name :seon.boot/cluster-name]
                  [:seon.operator/health :seon.operator/health]
                  [:seon.operator/flow :seon.operator/flow]
                  [:seon.operator/readiness
                   {:optional true}
                   :seon.operator/readiness]],
                 :publish-request
                 [:map
                  [:seon.boot/root :seon.boot/root]
                  [:seon.operator/changed-paths
                   {:optional true}
                   :seon.operator/changed-paths]],
                 :readiness :seon.boot/readiness,
                 :status
                 [:map
                  [:seon.operator/clusters :seon.operator/clusters]],
                 :failed [:= true]
                 :failed-error [:map {:seon.error/class true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html :error/message "must mark an operator command that failed"} [:seon.operator/failed :seon.operator/failed] [:seon.error/message :seon.error/message]]}
