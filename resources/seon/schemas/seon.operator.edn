                   :seon.operator/low-space?]],
                 :footprint-observation
                 [:and
                  :seon.operator/footprint
                  [:map
                   [:seon.operator/low-space? :seon.operator/low-space?]]],
                 :cleanup-result
                 [:map
                  [:seon.operator.cleanup/root :string]
                  [:seon.operator.cleanup/target :string]
                  [:seon.operator.cleanup/removed [:vector :string]]
                  [:seon.operator.cleanup/removed-file-bytes
