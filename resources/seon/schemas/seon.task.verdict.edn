#:seon.task.verdict{:test-verdict
                    [:map
                     {:seon.db/attributes true,
                      :description
                      "One test's verdict in the gate run that refused a merge task's landing: the test, why it is not green, and the run that recorded its result there (seon.cluster.source/red-test-verdicts). References only: the result stays with its run.",
                      :seon.program/partition :seon.data}
                     [:seon.task.verdict/test :seon.task.verdict/test]
                     [:seon.task.verdict/verdict :seon.task.verdict/verdict]
                     [:seon.task.verdict/run :seon.task.verdict/run]],
                    :test [:and {:description "The test the verdict is on."} :seon.test/sym],
                    :verdict [:and {:description "Why the test is not green (:seon.source/verdict)."} :seon.source/verdict],
                    :run [:and {:description "The run that recorded the test's result on the merge's tested branch."} :seon.test.run/id]}
