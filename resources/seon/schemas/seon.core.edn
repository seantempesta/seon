;; The platform's shared named schemas (session A1; G1's proto/core 9f5100a names where the
;; concept is the same, renamed seon.*). Each name sits at its producer's namespace.
{;; host values with a plain data form
 :seon.lib/pid :int
 :seon.lib/fd :int
 :seon.lib/ms number?
 :seon.lib/summary [:map [:n nat-int?]]
 :seon.ffi/address [:any {:description "A foreign address (jolt.ffi's pointer or long, or ffi/null)."}]
 :seon.lib/ns-time :int
 :seon.lib/mb number?
 :seon.lib/sysmem [:map [:free-mb number?] [:inactive-mb number?] [:compressed-mb number?] [:available-mb number?]]
 :seon.lib/exit-status [:or [:map [:exit :int]] [:map [:signal :int]]]
 :seon.lib/pipe [:tuple :seon.lib/fd :seon.lib/fd]
 ;; the store and its values
 :seon.db/branch :keyword
 :seon.db/t :int
 :seon.db/cfg [:map [:store :map]]
 :seon.db/tx-data [:sequential :any]
 ;; an entity as history and at read it: its id, or a lookup ref of a unique attribute (seon.db/history)
 :seon.db/entity [:or :int [:tuple :keyword :any]]
 ;; one datom of an entity's history: attribute :a, value :v (a pulled map under :pull, ref attributes only), :added? false for a
 ;; retraction, :t its transaction, :at that transaction's :db/txInstant (docs/storage.md#history)
 :seon.db/history-row [:map [:a :keyword] [:v :any] [:added? :boolean] [:t :int] [:at inst?]]
 :seon.db/history-opts [:map {:closed true} [:attrs {:optional true} [:set :keyword]] [:pull {:optional true} [:vector :any]]]
 ;; where seon.db/at reads: a commit alone, or a branch and/or a t (docs/storage.md#history)
 :seon.db/at-opts [:or [:map {:closed true} [:commit :uuid]]
                   [:map {:closed true} [:branch {:optional true} :seon.db/branch] [:t {:optional true} :int]]]
 :seon.db/op [:tuple [:enum :db/add :db/retract] :int :keyword :any]
 :seon.db/resolved-tx [:vector :seon.db/op]
 :seon.db/tx-report [:map [:tx-data :any] [:db-after :seon.host/db]]
 :seon.db/open [:map [:cfg :seon.db/cfg] [:conn :seon.host/conn] [:recovered? :boolean]]
 ;; the program as facts
 ;; a checkout's inputs with no program facts (seon.fx/inputs): what every reach digest holds
 ;; beside the program's forms (seon.program/graph-index)
 :seon.program/inputs [:map [:env :string] [:tree :string] [:code {:optional true} :string] [:config [:map-of :qualified-keyword :string]] [:test-system-config {:optional true :description "The config a process test's root runs with (seon.config/test-system-config), as the planner renders it: a process test's config values, whichever process plans."} [:map-of :qualified-keyword :string]] [:data-refs {:optional true} [:map-of :qualified-symbol [:set :qualified-symbol]]]]
 :seon.program/error [:map [:ns :symbol] [:message [:maybe :string]] [:form {:optional true} :string] [:lead {:optional true} :string]]
 :seon.program/load-report [:map [:loaded nat-int?] [:errors [:vector :seon.program/error]]]
 ;; processes: the step-fn contract (seon.step)
 :seon.step/describe [:map
                      [:workload [:enum :io :mixed :compute]]
                      [:ins {:optional true} [:map-of :keyword :string]]
                      [:outs {:optional true} [:map-of :keyword :string]]
                      [:params {:optional true} [:map-of :keyword :string]]
                      [:ping-map-fn :seon.host/fn]]
 :seon.step/outputs [:maybe [:map-of [:or :keyword [:tuple :keyword :keyword]] [:sequential :any]]]
 :seon.step/transition [:enum :clojure.core.async.flow/stop :clojure.core.async.flow/pause :clojure.core.async.flow/resume]
 :seon.step/step-fn [:function
                     [:=> [:cat] :seon.step/describe]
                     [:=> [:cat :map] :map]
                     [:=> [:cat :map :seon.step/transition] :map]
                     [:=> [:cat :map :keyword :any] [:tuple :map :seon.step/outputs]]]
 :seon.step/control [:maybe [:enum :pause :resume :ping :stop]]
 ;; the writer's state and requests (seon.writer)
 :seon.writer/state [:map [:conn :seon.host/conn] [:cfg :seon.db/cfg]]
 :seon.writer/request [:map [:op :keyword]]
 ;; an effect owner's token bucket (seon.fx, session R3): tokens now, capacity, the refill rate
 ;; per ms now and as configured, the ms it was last refilled at
 :seon.fx/bucket [:map [:tokens number?] [:cap number?] [:per-ms number?] [:rate-ms {:optional true} number?] [:at :int]]
 ;; the fork server (seon.fork-server)
 :seon.fork-server/event [:map [:ev :keyword]]
 :seon.fork-server/forked [:map [:pid :seon.lib/pid] [:fd :seon.lib/fd]]
 ;; the wire: nREPL messages (string keys on the wire; keyword keys are in-process values)
 :seon.sock/conn [:map [:fd :seon.lib/fd] [:fds :seon.host/volatile]]
 :seon.sock/sent [:or :boolean [:= :epipe]]
 :seon.wire/msg [:map-of [:or :string :keyword] :any]
 :seon.wire/seon-msg [:map [:op :keyword]]
 ;; agents
 ;; an agent's lifecycle as root's view holds it, in the dashboard's order: live, then gone
 ;; (stopped by root: a kill, or the end of its run; or dead). The sets are the
 ;; lifecycle's one declaration (seon.system/gone, seon.render.ui/live): a new status is one entry
 :seon.agent/status [:enum {:seon.status/live #{:spawning :busy :idle} :seon.status/stopped #{:ended :killed}
                            :seon.status/gone #{:ended :killed :dead}}
                     :spawning :busy :idle :ended :killed :dead]
 :seon.agent/tx-result [:map [:t :int] [:datoms nat-int?]]
 ;; an eval's response (nREPL's keys): its handle (result/ and a hash of its answer, bound to it in the agent), the last
 ;; form's value (kept in its record when it is plain data; :text, the response printed under its
 ;; handle for its caller), what its forms wrote, the error that stopped it (the one error map), its summed cost;
 ;; each key only when present. Beside them as answered: its record's id and the vars it recorded
 ;; each repair of a model's code: where (line, column, the whole line of the code as it ran) and what was dropped or inserted
 :seon.eval/repairs [:vector [:map [:near [:map [:line pos-int?] [:column pos-int?] [:text :string]]] [:dropped {:optional true} :string] [:inserted {:optional true} :string]]]
 ;; seon.repl/edit! refused, nothing changed: the var has no recorded source, the old text is not in
 ;; it, or it is there more than once; each line the error names [line text] (the near or the candidates)
 :seon.repl/no-eval [:and :seon.error/base [:map [:seon.error/type [:enum :seon.repl/no-eval]] [:seon.eval/id :string]]]
 :seon.repl/edit-refused [:and :seon.error/base
                          [:map [:seon.error/type [:enum :seon.repl/edit-refused]] [:seon.repl/var [:or :symbol :string]]
                           [:seon.repl/refused-because [:enum :no-source :not-found :ambiguous :overlap :empty :unreadable]]
                           [:seon.repl/lines {:optional true} [:vector [:tuple pos-int? :string]]]
                           ;; :not-found: at each candidate, the line where old stops matching (seon.repl/differs)
                           [:seon.repl/differs {:optional true} [:vector :map]]
                           ;; :not-found on a namespace (its place is its ns form): the definitions whose recorded source holds the old text (seon.repl/ns-not-found)
                           [:seon.repl/held-by {:optional true} :seon.repl/held-by]]]
 :seon.repl/held-by [:vector {:description "The definitions of a namespace whose recorded source holds an edit's old text, which its ns form, the namespace's place, does not (seon.repl/ns-not-found)."} :qualified-symbol]
 :seon.repl/said [:string {:description "The sentence an edit's refusal ends with when its namespace's ns form lacks the old text: the edit on the definition that holds it, or how a new definition is made (seon.repl/ns-not-found)."}]
 :seon.repl/program-def [:vector {:description "The vars an eval made new in a program namespace: said beside its answer as program on the branch (seon.repl's :program-def finding)."} :symbol]
 ;; where a text is and what it holds, plain data any function working on text takes (docs/agent.md#changing-a-file): at, a var or a path or a doc's address
 :seon.text/at [:or :qualified-symbol :string]
 :seon.text/text :string
 :seon.text/place [:map [:seon.text/at :seon.text/at] [:seon.text/text :seon.text/text]]
 ;; seon.repl/edit! of a place that is no definition, written: the place and the lines around each change; for a plain path, what it wrote where
 :seon.text/edited [:map [:edited [:map [:lines [:vector :any]]]] [:seon.text/said {:optional true} :string]]
 ;; an eval's answer while it is live: its value is whatever the form answered, a var or a fn among them (seon.repl/response).
 ;; What is stored of it is :seon.eval/response, plain data
 ;; each key says what it is in its own :description: what an agent reads by (doc :seon.repl/answer), in place of a list in the
 ;; standing prompt (docs/prompt.md)
 :seon.repl/answer [:map {:seon.render/hiccup seon.render.ui/evaluation :description "What an eval answers: a map under a handle. A key appears only when it has something to say."}
                      ;; none on a call of root's from the page, recorded with what root answered (seon.render.proc/web-answered)
                      [:handle {:optional true :description "The name this result is kept under. Use it like any value: (:value result/a3f9c1d2)."} :qualified-symbol]
                      [:value {:optional true :description "What the code answered. With :forms, a vector holding one value per form."} :any]
                      ;; the namespace the REPL is in after it, as every nREPL response carries: where the next eval runs
                      [:ns {:optional true :description "The namespace your next call runs in."} :symbol]
                      ;; code of several top-level forms: how many ran, its :value each one's in order (seon.repl/response)
                      [:forms {:optional true :description "How many top-level forms ran, when more than one."} [:int {:min 2}]]
                      ;; what the forgiving reader changed of the call's code before it ran (seon.ctx.search/repaired)
                      [:repaired {:optional true :description "What the reader changed of your code before it ran."} :seon.eval/repairs]
                      ;; each existing var whose contract or docstring this eval changed, its before and
                      ;; after and the wiki sections citing it (seon.program/meaning-changes); absent when none
                      [:redefined {:optional true :description "Each function whose contract or docstring this eval changed, before and after, with the wiki sections that cite it."} [:vector :seon.program/meaning-change]]
                      ;; what its definitions warn (seon.repl/instrument): an uncontracted definition, a contract not armed
                      [:warnings {:optional true :description "Problems with your definitions, each with its fix."} [:vector [:map [:seon.repl/finding :keyword]]]]
                      [:out {:optional true :description "What it printed."} [:map [:seon.print/code :string]]]
                      [:err {:optional true :description "What it printed to the error stream."} [:map [:seon.print/code :string]]] [:ex {:optional true :description "The error that stopped it."} :seon.error/base]
                      [:ms {:optional true} number?] [:ticks {:optional true} :int] [:bytes {:optional true} :int]
                      ;; the branch refused this eval's record (seon.repl/record!, :seon.agent/unrecorded), or the commit that followed its writes (seon.agent/commit!, :seon.agent/commit-refused: the writes were dropped)
                      [:unrecorded {:optional true :description "Your result was not recorded on your branch, and why."} :seon.error/base]
                      [:text {:optional true} :string] [:record {:optional true} :string]
                      [:recorded {:optional true :description "The vars this eval made program on your branch (a method as [multi dispatch]); they merge with your task. If you only meant to try something, take it back with (ns-unmap 'the.ns 'the-name) and define such things in your own namespace."} [:vector [:or :symbol [:vector :any]]]]
                      [:unmapped {:optional true :description "The vars it removed from your branch's program."} [:vector :qualified-symbol]] [:fns {:optional true} [:vector :map]]
                      ;; seon.repl/edit!'s: the var it changed and the lines around the change, [line text] each
                      [:edited {:optional true :description "What an edit changed: the var and the lines around the change."} [:map [:var :symbol] [:lines [:vector [:tuple pos-int? :string]]]]]]
 ;; what an eval changed of an existing var's meaning (seon.program/meaning: its contract, its
 ;; docstring): what it was, what it is now (a removed one absent), and each wiki section citing
 ;; the var with the form that reads it, so the agent sees the change it made and what text to update
 :seon.program/meaning-change [:map [:var :qualified-symbol] [:was [:map-of :keyword :string]] [:now [:map-of :keyword :string]]
                               [:cited-by [:vector [:map [:section :string] [:read :any]]]]]
 :seon.test/result [:map [:pass nat-int?] [:fail nat-int?] [:error nat-int?]]
 ;; root's API
 :seon.system/sys [:map [:graph :any] [:ext :seon.host/chan] [:conn :seon.host/conn]]
 :seon.system/api-state [:map [:agents :map] [:pending :map] [:rid :int] [:boot :string]]
 :seon.system/request [:map [:op :keyword]]
 ;; root's system declaration (resources/seon/system.edn, seon.graph): procs by id, effect
 ;; kinds, the conns between them
 :seon.graph/decl [:map [:procs [:map-of :keyword [:map [:proc :qualified-symbol] [:args {:optional true} :map] [:chan-opts {:optional true} :map]]]]
                    [:fx {:optional true} [:map-of :keyword :map]] [:conns [:vector [:tuple [:tuple :keyword :keyword] [:tuple :keyword :keyword]]]]]
 :seon.system/spawn-opts [:maybe [:map [:branch {:optional true} :seon.db/branch] [:task {:optional true} [:maybe :string]] [:run {:optional true} [:maybe :string]]
                                     ;; the session's agent the process continues (seon.task/agent-key)
                                     [:key {:optional true} :string]
                                     ;; evals run on its REPL queue before anything else, intent and code each, recorded as evals any
                                     ;; reader reads (docs/turn.md#an-eval-can-be-inserted)
                                     [:evals {:optional true} [:vector [:tuple :string :string]]]
                                     ;; restore the session at this commit of its branch, onto the new :branch (docs/storage.md#compiled-code)
                                     [:commit {:optional true} :uuid]]]
 ;; contracts (seon.contract, from G1)
 :seon.contract/arm-result [:enum :armed :unchanged :off :uncontracted]
 :seon.contract/invalid [:and :seon.error/base [:map [:seon.error/type [:enum :seon.contract/invalid]] [:seon.contract/var :qualified-symbol]]]
 :seon.contract/report [:map [:invalid [:vector :seon.contract/invalid]] [:uncontracted [:vector :qualified-symbol]] [:ms number?]]
 ;; the api proc's state keys (seon.system; keys-schemas sweep): in the proc's memory, never stored. A caller is a promise or a proc's reply route {:route :tag}
 :seon.system/backing [:map-of {:description "The agents going back to an earlier point (back!), each with its caller and the branch asked for."} :keyword [:map [:p [:or :seon.host/promise :map]] [:branch :seon.db/branch]]]
 :seon.system/busy [:set {:description "The agents with an eval in flight: the stall check's set (a gone one never)."} :keyword]
 :seon.system/dying [:map-of {:description "A killed agent's process by pid, with the agent, its end as it will be recorded, and the requests it died in, until the fork server reports its exit."} :seon.lib/pid [:tuple :keyword :map :any]]
 :seon.system/errors [:map-of {:description "The error occurrences folded by cause (seon.error/fold), each cause's entry, until flushed to the store."} :any :seon.error/entry]
 :seon.system/errors-dirty [:boolean {:description "True when the folded errors hold an entry not yet written to the store."}]
 :seon.system/errors-flight [:boolean {:description "True while a write of the folded errors is in flight, so a second is not made."}]
 :seon.system/inserting [:map-of {:description "The evals given at an agent's spawn, kept by agent until its REPL queue is sent them as one write."} :keyword [:sequential :any]]
 :seon.system/killers [:map-of {:description "The callers of each agent's stop, answered when its end is recorded."} :keyword [:vector [:or :seon.host/promise :map]]]
 :seon.system/lost [:vector {:description "The messages the api's step took when it threw, which the stall check answers as lost."} :any]
 :seon.system/prove [:map {:description "What the prove service last reported it holds (its state-view): runs in flight, the queue, free workers, the asks it has open."}]
 :seon.system/respawn [:map-of {:description "The agents ended for a respawn, with the caller and the spawn opts that start the next in their place."} :keyword [:map [:p [:or :seon.host/promise :map]] [:opts :map]]]
 :seon.system/restored [:map-of {:description "The agents whose spawn restores a commit, whose answer then says what was not restored."} :keyword [:= true]]
 :seon.system/spawning [:map-of {:description "The callers of each agent's spawn, answered at its hello or the end it met first."} :keyword [:or :seon.host/promise :map]]
 :seon.system/stall-armed [:boolean {:description "True when the api's stall-check timer is armed (what the stall task reads)."}]
 :seon.system/stall-timer [:and {:description "The stall check's armed flag: a host volatile the proc's state holds, so a thrown step does not undo it (seon.step/timer)."} :seon.host/volatile]
 :seon.system/taken [:and {:description "A host volatile of the messages the api's step took, kept so a throw can still answer them (seon.step)."} :seon.host/volatile]
 :seon.system/update [:boolean {:description "True when the agent procs changed and the flow graph is yet to be updated with them."}]
 ;; keys the code names with no entry before (keys-schemas sweep): schema properties, metadata keys, map keys and the sentinels a function answers
 ;; a property a schema carries, read by seon.schema.datahike when it declares the attribute (docs/storage.md)
 :seon.db/component [:boolean {:description "On an attribute's schema, true when it is a component: what its entity references is owned by it (Datahike's :db/isComponent)."}]
 :seon.db/content-id [:boolean {:description "On the schema of an identity attribute, true when its value names its entity's id in every branch (Datahike's :db/contentId)."}]
 :seon.db/no-history? [:boolean {:description "On an attribute's schema, true when the store keeps no history of its values (Datahike's :db/noHistory)."}]
 :seon.db/unique [:boolean {:description "On an attribute's schema, true when its value is unique across entities, a value key (Datahike's :db.unique/value)."}]
 :seon.db/db [:and {:description "In a render's opts, the db value the render reads its entity on."} :seon.host/db]
 :seon.db/retired [:map-of {:description "On the error that refuses a store at open, the stored names a rename retired, each to the name that replaced it."} :keyword :keyword]
 :seon.db/schemas [:map {:description "In a write's argument map, a branch's own schema changes, which the per-datom check reads: the key forms and the registry they compile in."} [:forms :map] [:registry :seon.host/registry]]
 ;; processes
 :seon.agent-proc/streams [:map-of {:description "An agent proc's in-flight eval output by stream id: the pieces of text of that stream so far, sent whole to the web proc's :streams in-port."} :any [:vector :string]]
 :seon.agent/threw [:and {:description "A child test run's result when it threw: what it threw, which the run rethrows once every child was taken."} :seon.host/throwable]
 :seon.agent/env [:and {:description "A task's agent as the reconciler reads it: the env (branch, model, turn bound) its run started with."} :seon.task/env]
 :seon.contract/wrapper [:and {:description "In a var's metadata, the contract's wrapper fn as installed, so the var is known as wrapped while its root still is it."} :seon.host/fn]
 :seon.contract/raw [:and {:description "In a var's metadata, the fn the var held before instrument! wrapped it; a var with it has its source read from the recorded form."} :seon.host/fn]
 :seon.contract/checked-at [:= {:description "In a var's metadata, :definition when its contract is checked from the definition on."} :definition]
 :seon.contract/var [:qualified-symbol {:description "On a contract error, the var whose contract was refused."}]
 :seon.lib/load-refused [:map {:description "The error data when the OS refuses the machine's load average (getloadavg)."} [:seon.error/type [:= :seon.lib/load-refused]] [:seon.error/message :string]]
 :seon.lib/sysmem-refused [:map {:description "The error data when the OS refuses the machine's memory figures (host_statistics64)."} [:seon.error/type [:= :seon.lib/sysmem-refused]] [:seon.error/message :string]]
 :seon.fork-server/not-single-threaded [:map {:description "The error data when the fork server cannot fork because root boots with more than one thread: how many are active."} [:seon.error/type [:= :seon.fork-server/not-single-threaded]] [:active-threads :int]]
 :seon.warm/tidy [:= {:description "The name of the held task the warm boot makes to pull a var's refs, so a first pull is warm."} :seon.warm/tidy]
 :seon.program/expr [:= {:description "What a node's literal value answers when the node is neither a constant nor a quote."} :seon.program/expr]
 :seon.program/unbound [:= {:description "What a var's root answers when the var has none (seon.program/root-of), so a readback compares it by identity."} :seon.program/unbound]
 :seon.ratom/paths [:= {:description "The key of the watch a source ref holds while a reaction reads paths of it."} :seon.ratom/paths]
 :seon.ratom/reached [:= {:description "The reason a handle is told a source changed: a path it read was reached by the change."} :seon.ratom/reached]
 :seon.value/gone [:map {:description "The marker in place of a value too large to keep (or a copy cannot rebuild): its type name and the bound it was over."} [:type :string] [:over {:optional true} nat-int?]]
 :seon.value/type [:string {:description "The class name of a host object plain data stands for (a fn, an atom, a db, a throwable)."}]
 :seon.value/message [:string {:description "A throwable's message, beside its type, when it is a string."}]
 :seon.text/said [:string {:description "The sentence a text edit answers beside what it changed: where it was written and what carries it."}]
 ;; the page's call attributes, on an element: what a click or submit calls (seon.web)
 :seon/call [:qualified-symbol {:description "On a hiccup element, the var (marked ^:seon/callable) a click or submit of it calls in the system."}]
 :seon/agent [:keyword {:description "On a hiccup element, the agent that its :seon/call is made in: its address or id."}]
 :seon/args [:map {:description "On a hiccup element, the arguments its :seon/call is made with."}]
 :seon/callable [:boolean {:description "On a var's metadata, true when the page may call it by name (seon.web/ui-call)."}]
 ;; the effect owner's outcome stamps and queue key (seon.fx)
 :seon.fx/us [:int {:min 0 :description "On an effect's outcome, the microseconds it ran."}]
 :seon.fx/queue-us [:int {:min 0 :description "On an effect's outcome, the microseconds it waited in its owner's queue."}]
 :seon.fx/at-ms [:int {:description "On an effect's outcome, the wall time in ms at which it ended."}]
 :seon.fx/qk [:tuple {:description "A queued request's place in its owner's queue: [negative priority, arrival number], so the least runs first."} :int :int]
 :seon.fx/end [:= {:description "What a read answers at the end of its input, so the loop stops."} :seon.fx/end]
 ;; status sets: a schema's properties naming which of its enum's values are which (docs/render.md#how-the-work-stands)
 :seon.status/live [:set {:description "On :seon.agent/status, the statuses of an agent that lives."} :keyword]
 :seon.status/stopped [:set {:description "On :seon.agent/status, the statuses of an agent stopped on purpose."} :keyword]
 :seon.status/gone [:set {:description "On :seon.agent/status, the statuses of an agent whose process is gone."} :keyword]
 :seon.status/finished [:set {:description "On :seon.task/outcome, the outcomes of finished work."} :keyword]
 :seon.status/judged [:set {:description "On :seon.task/outcome, the outcomes root has the next step to take on."} :keyword]
 :seon.status/failed [:set {:description "On :seon.task/outcome, the outcomes of a death (its agent died or was lost)."} :keyword]
 :seon.status/ended [:set {:description "On :seon.task/outcome, the outcomes that end a run, whatever came of it: what :seon.task/after waits for."} :keyword]
 :seon.status/title [:map-of {:description "On an enum, the words a person and the model read for each of its values, said before their count."} :keyword :string]
 :seon.status/explain [:map-of {:description "On an enum, each value's explanation in Markdown: what it means and what to do next."} :keyword :string]
 ;; the repl's edit refusal and findings (seon.repl)
 :seon.repl/eof [:= {:description "What the reader answers at the end of an eval's text."} :seon.repl/eof]
 :seon.repl/finding [:keyword {:description "On a warning beside an eval's answer, what it found: :invalid-contract, :uncontracted-definition, :not-program, :program-def or :unknown-var."}]
 :seon.repl/fix [:string {:description "On a warning, what to do about it."}]
 :seon.repl/var [:or {:description "On an edit's refusal, the var or the path whose edit was refused."} :symbol :string]
 :seon.repl/refused-because [:enum {:description "On an edit's refusal, why it changed nothing."} :no-source :not-found :ambiguous :overlap :empty :unreadable]
 :seon.repl/lines [:vector {:description "On an edit's refusal, the lines it names, each [line text]."} [:tuple pos-int? :string]]
 :seon.repl/differs [:vector {:description "On a :not-found edit, at each candidate, the line where the old text stops matching."} :map]
 ;; the test run's lines over a socket (seon.agent, seon.proofs)
