{:my.program/context
 [:map [:seon.db/connection :seon.db/connection]
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:my.program/base-ctx :seon.sci.eval/ctx]
  [:seon.cluster/name {:optional true} :seon.cluster/name]
  [:seon.store/store {:optional true} :seon.store/store]
  [:seon.agent/routing {:optional true} :seon.agent/routing]
  [:seon.env/environment {:optional true} :seon.env/environment]]
 :my.program/declaration-source
 [:map {:description "One declaration's source and where it lives: shown as its code text." :seon.render/ai my.program/render-source-ai}
  [:sym :qualified-symbol] [:kind :keyword] [:source :string]
  [:line {:optional true} :int] [:file {:optional true} :string] [:doc {:optional true} :string]
  [:contract {:optional true} :seon.schema/value]]
 :my.program/read-request [:map [:seon.db/db :seon.db/database-value]]
 :my.program/subject-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.program/subject :seon.program/subject]]
 :my.program/breaks-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.program/subject :seon.program/subject]
  [:seon.program/contract {:optional true} :seon.program/contract]]
 :my.program/key-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.schema/key :seon.schema/key]]
 :my.program/history-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.program/subject :seon.program/subject]
  [:seon.db/tx {:optional true} :seon.db/tx]]
 :my.program/candidate-tokens
 [:int {:min 0 :description "The tokens a candidate's AI face costs when expanded (my.program/source), estimated before the agent picks it."}]
 :my.program/producer :seon.program/declaration-identity
 :my.program/search-query
 [:or :string :keyword [:map [:text [:or :string :keyword]] [:limit {:optional true} [:int {:min 1}]]]]
 :my.program/search-match
 [:or {:description "One search candidate: a declaration with its first matching line, or a schema key with the declaration producing it."}
  [:map [:sym :qualified-symbol] [:line {:optional true} :int] [:snippet {:optional true} :string]
   [:my.program/candidate-tokens :my.program/candidate-tokens]]
  [:map [:seon.schema/key :seon.schema/key] [:my.program/producer :my.program/producer]
   [:my.program/candidate-tokens :my.program/candidate-tokens]]]
 :my.program/search-result
 [:map [:count [:int {:min 0}]] [:matches [:vector :my.program/search-match]] [:more {:optional true} :seon.render/read-form]]
}
