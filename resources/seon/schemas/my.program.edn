  [:seon.agent/routing {:optional true} :seon.agent/routing]
  [:seon.env/environment {:optional true} :seon.env/environment]]
 :my.program/declaration-source
 [:map {:description "One declaration's source and where it lives: shown as its code text." :seon.render/ai my.program/render-source-ai}
  [:sym :qualified-symbol] [:kind :keyword] [:source :string]
  [:line {:optional true} :int] [:file {:optional true} :string] [:doc {:optional true} :string]
  [:contract {:optional true} :seon.schema/value]]
 :my.program/read-request [:map [:seon.db/db :seon.db/database-value]]
 :my.program/subject-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.program/subject :seon.program/subject]]
 :my.program/breaks-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.program/subject :seon.program/subject]
  [:seon.program/contract {:optional true} :seon.program/contract]]
 :my.program/key-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.schema/key :seon.schema/key]]
 :my.program/history-request
 [:map [:seon.db/db :seon.db/database-value]
  [:seon.program/subject :seon.program/subject]
  [:seon.db/tx {:optional true} :seon.db/tx]]
 :my.program/merge-proposal
 [:map [:seon.source/candidate :seon.store/branch] [:seon.test.run/id :seon.test.run/id]
  [:seon.test/passed? {:optional true} :boolean] [:seon.source/tally {:optional true} :string]
  [:seon.task/proofs :seon.task/proofs] [:seon.source/red {:optional true} :seon.source/red]
  [:seon.task/merge :seon.task/merge] [:seon.task/branch {:optional true} :seon.task/branch]
  [:seon.fn/root {:optional true} :seon.fn/root] [:seon.render/operations {:optional true} :seon.render/operations]
  [:seon.source/expected-digests :seon.source/expected-digests] [:parents [:set :seon.source/commit-id]]
  [:seon.source/advanced-base :seon.source/advanced-base]]
 :my.program/prepare-request
 [:map {:description "The merge task whose open proposal (my.program/proposals) root prepares, optionally narrowed to declarations and proven against a checkout."}
  [:my.program/context :my.program/context]
  [:seon.task/merge :seon.task/merge]
  [:seon.program/identities {:optional true} :seon.program/identity-set]
  [:seon.fn/root {:optional true} :seon.fn/root]]
 :my.program/accept-request
 [:map [:my.program/context :my.program/context]
  [:seon.source/candidate :seon.store/branch] [:seon.test.run/id :seon.test.run/id]
  [:seon.test/passed? {:optional true} :boolean] [:seon.source/tally {:optional true} :string]
  [:seon.task/proofs :seon.task/proofs] [:seon.source/red {:optional true} :seon.source/red]
  [:seon.task/merge :seon.task/merge] [:seon.task/branch {:optional true} :seon.task/branch]
  [:seon.fn/root {:optional true} :seon.fn/root] [:seon.render/operations {:optional true} :seon.render/operations]
  [:seon.source/expected-digests :seon.source/expected-digests] [:parents [:set :seon.source/commit-id]]
  [:seon.source/advanced-base :seon.source/advanced-base]]
}
