{:my.program/context
 [:map [:seon.db/connection :seon.db/connection]
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:my.program/base-ctx :seon.sci.eval/ctx]
  [:seon.cluster/name {:optional true} :seon.cluster/name]
