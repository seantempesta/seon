#:seon.config.db{:validation-node-limit [:int {:min 1 :seon.config/dial true :seon.config/default 250000 :description "Maximum distinct before/after entity nodes visited by final owning-value validation in one transaction. Exhaustion refuses the complete transaction; projection acquisition carries this policy. Every asserted branch policy applies, so the smallest configured limit governs all writers."}]
                 :write-time-limit-ms [:int {:seon.config/display-label "Database write deadline" :seon.config/display-divisor 1000 :seon.config/display-unit "s" :min 1 :seon.config/dial true :seon.config/default 600000 :description "Maximum milliseconds seon.db/transact! waits for Datahike's writer promise. The smallest asserted branch value governs a submission; firing returns :seon.db/write-bound-exceeded with :seon.db/transaction-outcome-unknown true because the queued transaction is not cancelled and may still commit."}]
                 :snapshot-window-ms [:int {:min 0 :seon.config/optional true :seon.config/dial true :description "Commit snapshot window in milliseconds before the newest observed store head. All branch heads survive. Every cluster configuration must declare this before implicit whole-store collection; the largest window governs. Temporal datoms in retained heads are unaffected."}]
                 :keep-history? [:boolean #:seon.config{:dial true}]}
