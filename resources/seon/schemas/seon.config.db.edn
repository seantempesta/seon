#:seon.config.db{:validation-node-limit [:int {:min 1 :seon.config/dial true :seon.config/default 250000 :description "Maximum distinct before/after entity nodes visited by final owning-value validation in one transaction. Exhaustion refuses the complete transaction; projection acquisition carries this policy. Every asserted branch policy applies, so the smallest configured limit governs all writers."}]
                 :write-time-limit-ms [:int {:min 1 :seon.config/dial true :seon.config/default 30000 :description "Maximum milliseconds seon.db/transact! waits for Datahike's writer promise. The smallest asserted branch value governs a submission; firing returns :seon.db/write-bound-exceeded with :seon.db/transaction-outcome-unknown true because the queued transaction is not cancelled and may still commit."}]
                 :keep-history? [:boolean #:seon.config{:dial true}]}
