 :seon.boot/error
 [:merge
 {:seon.db/attributes true}
 :seon.error/base
 [:map
  {:seon.db/attributes true}
  [:seon.boot/failed-phase :seon.boot/failed-phase]
  [:seon.boot/process-root :seon.boot/process-root]]]

