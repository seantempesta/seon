             [:seon.boot/store-dir :seon.boot/store-dir]],
            :failure
            [:and {:description "Why this start's boot refused: its operator diagnostic (references only). Retained on the partial instance so status and the MCP entrance say the boot failed instead of reporting it as still starting."}
             :seon.cluster.boot/operation-error]
            :instance-ctx
            [:and {:description "A boot instance's cluster context: absent during a partial boot (the REPL opens before the store), so it is never supplied from the calling evaluation's world."}
             :seon.sci.eval/ctx]
            :instance
            [:map
             [:seon.boot/config :seon.boot/config]
             [:seon.boot/advertisement :seon.boot/advertisement]
             [:seon.boot/prepl-server
              [:fn
               {:error/message
                "must be a java.net.ServerSocket serving the cluster io-prepl"
                :gen/gen seon.cluster/socket-server-generator}
               seon.cluster/socket-server?]]
             [:seon.config/manifest
              {:optional true
               :description "The sparse overlay this instance applied (the development overlay under any --config manifest); a reset re-applies it."}
              :seon.config/manifest]
             [:seon.config/environment
              {:optional true}
              :seon.config/manifest]
             [:seon.store/store {:optional true} :seon.store/store]
