             [:seon.render.web/url
              {:optional true}
              :seon.render.web/url]
             [:seon.render.web/wanted-port
              {:optional true}
              :seon.render.web/wanted-port]
             [:seon.boot/recovered-runs
              {:optional true}
              :seon.boot/recovered-runs]
             [:seon.boot/ready-ms {:optional true} [:int {:min 0}]]
             [:seon.boot/failure {:optional true} :seon.boot/failure]
             [:seon.boot/layers {:optional true} :seon.boot/layers]
             [:seon.agent/chain-routes
              {:optional true
               :description "The chain branches root holds a wake route on (seon.cluster.agent/route-chain!)."}
              [:vector :seon.store/branch]]
             [:seon.instrument/instrumented
              {:optional true}
              [:int {:min 0}]]],
            :recovered-runs [:int {:min 0}],
            :recovery-operations [:int {:min 0}],
            :root [:string {:min 1}],
            :start-instant :inst,
            :start-request
            [:map
             [:seon.turn.loop/complete {:optional true} :seon.turn.loop/complete]
             [:seon.boot/cluster-name
              {:optional true}
              :seon.boot/cluster-name]
             [:seon.boot/root {:optional true} :seon.boot/root]
             [:seon.boot/prepl-host
              {:optional true}
              :seon.boot/prepl-host]
