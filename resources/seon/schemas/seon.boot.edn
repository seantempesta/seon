              {:optional true}
              :seon.boot/prepl-port]
             [:seon.boot/log-dir {:optional true} :seon.boot/log-dir]
             [:seon.boot/store-dir
              {:optional true}
              :seon.boot/store-dir]
             [:seon.config/manifest
              {:optional true}
              :seon.config/manifest]
             [:seon.config/environment
              {:optional true}
              :seon.config/manifest]],
            :store-dir [:string {:min 1}],
            :refused [:= true]
