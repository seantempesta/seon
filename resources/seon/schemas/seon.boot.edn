              {:optional true}
              :seon.store/connection-object]
             [:seon.sci.eval/ctx {:optional true} :seon.boot/instance-ctx]
             [:seon.boot/config-result
              {:optional true}
              :seon.reconcile/result]
             [:seon.boot/recovered-runs
              {:optional true}
              :seon.boot/recovered-runs]
             [:seon.boot/recovery-operations
              {:optional true}
              :seon.boot/recovery-operations]
             [:seon.turn.loop/cluster
              {:optional true}
              :seon.turn.loop/cluster]
             [:seon.flow/graph {:optional true} :seon.flow/graph]
             [:seon.heap/watch {:optional true} :seon.heap/watch]
             [:seon.render.web/view
              {:optional true}
              :seon.render.web/view]
             [:seon.render.web/served
              {:optional true}
              :seon.render.web/server]
             [:seon.agent/routing
              {:optional true}
              :seon.agent/routing]
             [:seon.boot/ready-ms {:optional true} [:int {:min 0}]]
             [:seon.boot/failure {:optional true} :seon.boot/failure]
             [:seon.boot/layers {:optional true} :seon.boot/layers]
             [:seon.boot/stopping {:optional true} [:= true]]],
            :layers [:vector {:description "Each boot layer with the cumulative milliseconds since the start began when it was first published, in acquisition order."}
                     [:map [:seon.boot/layer :qualified-keyword] [:seon.boot/at-ms [:int {:min 0}]]]],
            :log-dir [:string {:min 1}],
            :overrides
            [:map
             [:seon.turn.loop/complete {:optional true} :seon.turn.loop/complete]
             [:seon.boot/cluster-name
              {:optional true}
              :seon.boot/cluster-name]
             [:seon.boot/root {:optional true} :seon.boot/root]
             [:seon.boot/prepl-host
              {:optional true}
              :seon.boot/prepl-host]
             [:seon.boot/prepl-port
              {:optional true}
              :seon.boot/prepl-port]
             [:seon.boot/log-dir {:optional true} :seon.boot/log-dir]
             [:seon.boot/store-dir
              {:optional true}
              :seon.boot/store-dir]],
            :pid [:int {:min 1}],
            :prepl-host [:string {:min 1}],
            :prepl-port [:int {:min 0, :max 65535}],
            :readiness
            [:map
             [:seon.boot/cluster-name :seon.boot/cluster-name]
             [:seon.boot/pid :seon.boot/pid]
             [:seon.boot/prepl-port [:int {:min 1, :max 65535}]]
