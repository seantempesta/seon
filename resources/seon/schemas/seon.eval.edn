#:seon.eval{:origin [:string {:min 1 :description "The identity of the entity whose declaration generated this evaluation. A value carries forward unchanged through since-diff reads; absent on agent-authored reads." :seon.wake/context-inert true}],
            :renderer [:qualified-symbol {:description "The declared AI renderer that produced the saved shown text. History emits it directly without selecting or invoking a renderer again." :seon.wake/context-inert true}],
            :renderer-fn [:and {:description "The stable program identity of the renderer that produced the saved shown text." :seon.wake/context-inert true} :seon.db/ref],
            :host-interop-count [:int {:min 0 :seon.wake/context-inert true}],
            :entity
            [:map
             [:db/id {:optional true} :int]
             [:t {:optional true} :seon.db/basis-t]
             [:seon.cluster.eval/id :seon.cluster.eval/id]
             [:seon.cluster.eval/run :seon.cluster.eval/run]
             [:seon.cluster.eval/ordinal :seon.cluster.eval/ordinal]
             [:seon.cluster.eval/source
              {:optional true}
              :seon.cluster.eval/source]
             [:seon.cluster.eval/at {:optional true} :inst]
             [:seon.cluster.eval/ns
              {:optional true}
              [:or :seon.cluster.eval/ns
               [:map [:seon.ns/name :seon.ns/name]]]]
             [:seon.cluster.eval/read-basis-transaction
              {:optional true}
              :seon.db/basis-t]
             [:seon.eval/origin {:optional true} :seon.eval/origin]
             [:seon.eval/renderer {:optional true} :seon.eval/renderer]
             [:seon.eval/renderer-fn {:optional true} :seon.eval/renderer-fn]
             [:seon.eval/shown {:optional true} :string]
             [:seon.cluster.eval/output {:optional true} :string]
             [:seon.cluster.eval/error {:optional true} :string]
             [:seon.cluster.eval/interrupted-at
              {:optional true}
              :inst]],
            :duration-ms [:and {:seon.wake/context-inert true} :int],
            :print-length [:int {:min 0 :seon.wake/context-inert true :description "The *print-length* a form ended with; the agent's session opens its next form under the latest one set."}],
            :print-budget [:int {:min 1 :seon.wake/context-inert true :description "The seon.print/*budget* a form ended with, recorded on each form while the session holds one; the agent's session opens its next form under its latest evaluation's, and none when that evaluation recorded none."}],
            :print-level [:int {:min 0 :seon.wake/context-inert true :description "The *print-level* a form ended with; the agent's session opens its next form under the latest one set."}],
            :acquisition-ms [:int {:min 0 :seon.wake/context-inert true :description "Milliseconds of Seon's own SCI program acquisition inside one evaluation's arm, excluded from :seon.eval/duration-ms (the agent's reply time) and recorded beside it."}],
            :fn-entries [:and {:seon.wake/context-inert true} :int],
            :allocated-bytes [:and {:seon.wake/context-inert true :description "Heap bytes allocated while the evaluation ran (seon.sci.kernel): the evaluating platform thread's own count (an arm opened on a virtual thread runs on a platform worker, seon.sci.kernel/with-arm) plus the platform threads that adopted its arm (seon.sci.kernel/future-call), so work on other threads (Flow procs, the Datahike writer, an unadopted future) is not in it. -1: not measured, as when an arm's owning thread is virtual; then the reply shows no :seon.repl/alloc-mb. Never every thread's total. Past :seon.config.eval/bounds a :large-allocation finding."} :int],
            :value-tokens [:int {:min 0 :seon.wake/context-inert true :description "Estimated tokens of the evaluation's whole value, from the floor's cut counts (seon.render.value/whole-characters), never a second print; absent for a value that printed whole under its own :seon.print/budget metadata. Past :seon.config.eval/bounds the reply says LARGE VALUE."}],
            :shown-tokens [:int {:min 0 :seon.wake/context-inert true :description "Estimated tokens of the evaluation's shown text."}],
            :budget-override [:int {:min 1 :seon.wake/context-inert true :description "The display budget in tokens the evaluation's value printed under when the session's seon.print/*budget* or the value's :seon.print/budget metadata raised it past the render profile's, capped at the profile's ceiling; absent at the profile's budget and for a value that printed whole under its own metadata budget. Past :seon.config.eval/bounds the reply names it."}],
            :private [:set {:seon.wake/context-inert true :description "The Vars this evaluation's batch classed as the agent's private state, not program (seon.turn.batch/write-entity: a def of a value that is not a function, or a function capturing locals). They live only in the agent's SCI context; the reply's :note reads this set."} :qualified-symbol],
            :uncontracted [:set {:seon.wake/context-inert true :description "The functions this evaluation defined without a :malli/schema contract (rows with no :seon.fn/spec). With :seon.eval/uncontracted-count a declared bound (:seon.config.eval/bounds) makes it a finding in the reply map."} :qualified-symbol],
            :contract-gaps [:set {:seon.wake/context-inert true :description "Each unjustified :any or :some slot or missing contract this evaluation's definitions leave (seon.cluster.source/contract-gaps), as [function finding position-kind input-index]: the position kind is :seon.fn.contract.position/contract, /output or /input, and the index of an input slot, -1 for the others. With :seon.eval/uncontracted-count the :uncontracted finding names the slot to fix."}
                           [:tuple :qualified-symbol :qualified-keyword :qualified-keyword [:int {:min -1}]]],
            :auto-required [:set {:seon.wake/context-inert true :description "The namespaces this evaluation required in its namespace because its definition names them fully qualified without the namespace requiring them (seon.turn.batch/auto-require!): SCI resolves them, and the merged ns form must require them for the file to analyze. Shown in the reply map as an :auto-required entry under :seon.repl/findings (:seon.config.eval/bounds)."} :symbol],
            :uncontracted-count [:int {:min 1 :seon.wake/context-inert true :description "The agent's uncontracted function definitions on its branch after this evaluation (those its evaluations recorded as :seon.eval/uncontracted whose rows still have no :seon.fn/spec). Recorded only on an evaluation that defined an uncontracted function."}],
            :elisions [:int {:min 0 :seon.wake/context-inert true :description "How many cuts the floor made showing the evaluation's value; the data that says whether the token budget elides too often."}],
            :value-digest [:and {:seon.wake/context-inert true :description "Retired 2026-10-07: an evaluation's value is never stored (it lives only in the context that evaluated it); evaluations settled before then may hold the blob digest of a cut value's artifact, which nothing reads."} :seon.blob/digest],
            :unstored [:enum {:seon.wake/context-inert true :description "Why a handle bound in a fresh context holds no value: :live-only (values live only in the context that evaluated them and are never stored; seon.sci.eval/fork-for-turn binds this marker). Evaluations settled before 2026-10-07 may hold the other kinds as a fact; nothing writes them now."} :live-only :printed-whole :over-bound :not-recorded :unreadable],
            :value-class [:string {:min 1 :seon.wake/context-inert true :description "The class name of an evaluation's value, which its handle's marker names in a fresh context (after a restart)."}],
            :unstored-note [:string {:min 1 :description "The marker's sentence for a handle bound in a fresh context, which holds no value; never stored."}],
            :full [:boolean {:seon.wake/context-inert true :description "The evaluation opted into printing its value whole (seon.print/full)."}],
            :outcome [:enum {:seon.wake/context-inert true} :ok :time :error],
            :shown
            [:string
             {:description
              "Exact shown text produced once by the evaluation's value renderer under its render profile. It is an observation, not a serialization of the live object." :seon.wake/context-inert true}]}
