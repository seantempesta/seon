{:seon.plan/current-line
 [:string {:description "The current plan step's position, state, title, and completion criterion in the compact AI projection."}]
 :seon.plan/step-lines
 [:map-of :my.plan.item/id :string]
 :seon.plan/update-example
 [:string {:description "One executable plan update example shown with the opening plan."}]
 :seon.plan/non-test-entity
 [:int {:description "The entity id read from an issue test relation that no longer identified a test at the observed basis. This is a value, not a reference that protects the entity."}]
 :seon.plan/non-test-error
 [:and {:seon.db/attributes true :seon.render/ai seon.error/render-ai :seon.render/html seon.error/render-html}
  :my.plan/request-error [:map [:seon.plan/non-test-entity :seon.plan/non-test-entity]]]
 :seon.plan/refusal
 [:or :seon.db/invalid-read-error :seon.db/transaction-refused-error
  :seon.schema/validation-refusal :my.plan/request-error]}
