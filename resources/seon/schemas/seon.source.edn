               [:seon.source/candidate :seon.store/branch] [:seon.source/judged-commit :seon.source/judged-commit]
               [:seon.test.run/id {:optional true} :seon.test.run/id]
               [:seon.test/passed? :boolean] [:seon.source/tally :string]
               [:seon.program/identities :seon.program/identity-set]
               [:seon.source/refusals :seon.source/refusals]
               [:seon.source/red-tests {:optional true} :seon.source/red-tests]
               [:seon.source/platform-run {:optional true} :seon.source/platform-run]
