              :change-classes [:set :seon.source/change-class],
              :previous-database :seon.db/database-value,
              :path [:string {:min 1}],
              :changed-paths [:vector :seon.source/path],
              :population
              [:map
               [:seon.db/connection
                :seon.db/connection]
               [:seon.source/digest :seon.source/digest]],
              :populate-request
              [:map
               [:seon.source/relative-file-digests {:optional true} :seon.source/relative-file-digests]
               [:seon.source/change-classes {:optional true} :seon.source/change-classes]
               [:seon.fn/manifest
                {:optional true}
                :seon.fn.manifest/manifest]],
              :progress! [:=> [:cat :string] :nil],
              :publish-request
              [:map
               [:seon.source/relative-file-digests {:optional true} :seon.source/relative-file-digests]
               [:seon.source/changed-paths {:optional true} :seon.source/changed-paths]
               [:seon.source/test-input-digest {:optional true} :seon.source/test-input-digest]
               [:seon.source/analyzer-digest {:optional true} :seon.source/analyzer-digest]
               [:seon.fn/root {:optional true} :seon.fn/root]
               [:seon.source/expected-commit-id {:optional true} :seon.source/expected-commit-id]
               [:seon.db/process {:optional true} :seon.db/ref]
               [:seon.store/store :seon.store/store]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/populate :seon.source/populate]
               [:seon.source/progress! {:optional true} :seon.source/progress!]
               [:seon.db/writer {:optional true :description "The writer of publication's scratch schema and seal transactions."} :seon.db/writer]
               [:seon.source/populate-request
                {:optional true}
                :seon.source/populate-request]],
              :reloaded-namespaces [:vector {:description "Namespaces whose require :reload completed in this request, in reload order."} :symbol],
