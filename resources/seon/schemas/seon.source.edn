               [:parents [:set :seon.source/commit-id]]],
              :judged-commit [:uuid {:description "The commit of a merge branch its judgment read (seon.cluster.source/prepare-merge!): accept-merge! carries exactly that value, never the branch's later head."}],
              :platform-run [:and {:description "The run of a merge gate's isolated members on the candidate's platform host (seon.cluster/reaching-run, seon.test.platform/check-files!), recorded on the merge branch beside the gate run."} :seon.test.run/id],
              :refusals [:vector {:description "Every refusal the done rule (seon.cluster.source/done-refusals) gives a judged branch, a merge branch included; empty only for done and acceptance."} :seon.error/value],
              :merging [:map {:description "Transaction data and metadata accept-merge! carries in its transaction: root's merge of the assignment's facts (seon.merge/merge!), and the assignment whose :seon.task/merged-declarations the same transaction writes (seon.cluster.source/moving)."}
                        [:tx-data :seon.store/transaction-data] [:tx-meta {:optional true} :map]
                        [:counted {:optional true} :seon.db/entity-id]],
              :next-proofs [:set {:description "The proofs of the task that follows the judged one (its :seon.task/next): seon.cluster.source/done-refusals leaves them red, the next task's work. Absent on the chain's last task."} :seon.test/sym],
              :verdict [:enum {:description "Why a test of a merge's run is not green: an executed failure, or no executed outcome."} :red :unknown],
              :red-test [:map {:description "A judged test that is not green, the run that recorded its result (the judged run when none did) and its verdict."} :seon.test/sym :seon.test.run/id :seon.source/verdict],
              :members [:set {:description "The tests a results judgment covers: a merge's run members, or a branch's proofs, product and the tests reaching its change (seon.cluster.source/done-refusals)."} :seon.test/sym],
              :deferred [:set {:description "The members of a member list that run only on a platform host (seon.test/host-exclusions of an isolated run): the merge's platform run answers them, so the done rule waits for none of them."} :seon.test/sym],
              :member-list [:map {:description "The one member list of a merge (seon.cluster.source/merge-members): what the attempt's test step runs, the done rule judges and the merge gate runs."}
                            [:seon.source/members :seon.source/members] [:seon.source/deferred :seon.source/deferred]
                            [:seon.source/reaching {:optional true} :seon.source/reaching]],
              :reaching [:map-of {:description "Each changed declaration a member list was selected from, with the tests reaching it (its own contribution to the members, seon.cluster.source/merge-members): what a changed declaration's test status is read from (seon.context/branch-changes)."} :seon.program/declaration-identity [:set :seon.test/sym]],
              :results [:vector {:description "The recorded results a results judgment reads, one per test at most."} [:or :seon.test/result :seon.test/result-unknown]],
              :judged [:map {:description "What seon.cluster.source/done-refusals judges, for every task and for the merge: the covered tests and their recorded results, the proofs, the next task's proofs (a Prove step's product), the candidate's changed identities and the run and branch the refusals name (a branch's newest run its results came from)."}
                       [:seon.source/members :seon.source/members] [:seon.source/results :seon.source/results]
                       [:seon.task/proofs :seon.task/proofs]
                       [:seon.source/next-proofs {:optional true} :seon.source/next-proofs]
                       [:seon.source/deferred {:optional true} :seon.source/deferred]
                       [:seon.source/merge-identities {:optional true} :seon.source/merge-identities]
                       [:seon.source/file-refusal {:optional true} :seon.source/file-refusal]
                       [:seon.program/identities :seon.program/identity-set]
                       [:seon.test.run/id :seon.test.run/id] [:seon.test.run/branch :seon.store/branch]],
              :red-tests [:vector {:min 1} :seon.source/red-test],
              :red-test-error [:and {:description "The done rule (seon.cluster.source/done-refusals, the merge's judge too) refused: a proof, or a member that is not one of the next task's proofs, is not green on the judged branch, whatever main or the merge base holds."} :seon.source/test-evidence-error [:map [:seon.source/red-tests {:optional true :description "Always present; optional because a stored error keeps only storable members, and this vector of maps has no attribute."} :seon.source/red-tests]]],
              :uncontracted [:vector {:min 1 :description "The functions a merge carries with no complete :malli/schema (no contract, or an unjustified :any or :some slot), private ones included, by symbol. Producer: seon.cluster.source/uncontracted."} :seon.fn/sym],
              :contract-gaps [:vector {:min 1 :description "Each missing contract and unjustified :any or :some slot of the functions a merge carries, with its position. Producer: seon.cluster.source/contract-gaps."} :seon.fn.contract/finding-row],
              :uncontracted-error [:and {:description "accept-merge! refused: a function the merge carries declares no complete :malli/schema, or one with an unjustified :any or :some slot; the agent contracts it on its branch."} :seon.source/test-evidence-error [:map [:seon.source/uncontracted {:optional true :description "Always present; optional because a stored error keeps only storable members."} :seon.source/uncontracted] [:seon.source/contract-gaps {:optional true :description "Always present; optional because a stored error keeps only storable members, and this vector of maps has no attribute."} :seon.source/contract-gaps]]],
              :lint-finding [:map {:description "One clj-kondo error, under the checkout's .clj-kondo configuration, in a file a merge would publish. Producer: seon.cluster.source/lint-errors."} [:seon.source/path :seon.source/path] [:seon.lint/row :seon.lint/row] [:seon.lint/col :seon.lint/col] [:seon.lint/type :seon.lint/type] [:seon.lint/message :seon.lint/message]],
              :lint-findings [:vector {:min 1 :description "The clj-kondo errors in the files a merge would publish, in file and position order."} :seon.source/lint-finding],
              :merge-identities [:and {:description "The declarations a merge of the judged branch would carry: its whole change since its merge base but an agent's own namespace (seon.cluster.source/merge-changes). Producer: seon.cluster.source/publication; seon.cluster.source/done-refusals refuses, on the last task, each function of it no green test reaches."} :seon.program/identity-set],
              :file-refusal [:or {:description "Why the files a merge of the judged branch would write cannot publish, refused as the merge gate refuses them: the file proof's own refusal (a change with no file, a conflict, a candidate that does not analyze), else their clj-kondo errors. Producer: seon.cluster.source/file-refusal, through seon.cluster.source/publication; seon.cluster.source/done-refusals refuses it."} :seon.source/lint-error :seon.source/write-back-error :seon.error/value],
              :publication [:map {:description "What a merge of a branch would publish, judged from the branch alone (seon.cluster.source/publication): the done rule's input."} [:seon.source/merge-identities :seon.source/merge-identities] [:seon.source/file-refusal {:optional true} :seon.source/file-refusal]],
              :lint-error [:merge {:description "prepare-merge! or the done rule refused (seon.cluster.source/lint-refusal): clj-kondo reports an error in a file the merge would publish, the bar a lane commit holds; the agent fixes it on its branch."} :seon.error/base [:map [:seon.source/path {:description "The first file with an error."} :seon.source/path] [:seon.source/lint-findings {:optional true :description "Always present; optional because a stored error keeps only storable members, and this vector of maps has no attribute."} :seon.source/lint-findings]]],
              :candidate-bytes [:and {:description "The proven file bytes a write-back installs."} :seon.source/file-bytes],
              :proof-rows [:sequential {:description "Each written declaration with its entity before and after the merge (absent: nil)."}
                           [:tuple :seon.program/declaration-identity [:maybe :map] [:maybe :map]]],
              :proof
              [:map {:description "A write-back proven before installation: the file, the bytes it was analyzed from, the candidate and its entities."}
               [:seon.source/path :seon.source/path] [:seon.source/base-digest :seon.source/base-digest]
               [:seon.source/candidate-bytes :seon.source/candidate-bytes] [:seon.source/proof-rows :seon.source/proof-rows]
               [:seon.program/rows {:optional true :description "A source file's: the analysis of its candidate bytes, which reindexes main once it is written (seon.merge/indexed!)."} :seon.program/rows]],
              :file-proofs [:vector {:description "Each file a merge writes, proven (seon.cluster.source/proven-files)."} :seon.source/proof],
              :file-proof [:map {:description "The one file proof of a merge's files, held by the content it reads (seon.cluster.source/file-proof): taken by the done rule, the merge and its write-back."}
                           [:seon.source/file-proofs :seon.source/file-proofs] [:seon.source/lint-findings {:optional true} :seon.source/lint-findings]],
              :conflict-error [:merge {:description "seon.merge/merge! refused: the source branch and main changed the same declarations since the merge base (seon.program/three-way); or the done rule refused a branch's unresolved unmerged entries (seon.cluster.source/unmerged-refusal)."} :seon.error/base
                               [:map [:seon.program/conflict :seon.program/conflict] [:seon.program/conflict-digests {:optional true :description "Always present on a merge's refusal; optional because a stored error keeps only storable members, and this map has no attribute."} :seon.program/conflict-digests]
                                [:seon.unmerged/entries {:optional true :description "The done rule's: each unresolved unmerged entry with the commits its versions are read at."} :seon.unmerged/entries]]],
              :base-commit-id [:uuid {:description "The branch's commit a merge was transacted onto."}],
              :expected-digests
              [:map-of {:description "The digest each merged declaration held on the destination when the merge was prepared; a merge's basis."}
               :seon.program/declaration-identity :seon.program/digest-or-absence],
              :write-back-request
              [:map
               [:seon.db/connection :seon.db/connection]
               [:seon.source/accepted :seon.source/accepted]
               [:seon.fn/root :seon.fn/root]
               [:seon.source/stage {:optional true} :seon.source/stage]],
              :stage [:=> {:description "Writes one proven candidate beside the file at a path and answers the staged file's path, which write-back renames onto it once every candidate is staged. seon.cluster.source/stage! when absent."}
                      [:cat :string :seon.source/file-bytes] :string],
              :write-back-refused
              [:enum {:description "Why a write-back installed nothing."}
               :root-refused :commit-absent :no-replacement :one-file :file-absent :file-changed :span-mismatch :conflict :not-analyzable :not-equivalent :install-failed],
              :write-back-error
              [:merge :seon.error/base
               [:map [:seon.source/write-back-refused :seon.source/write-back-refused]
                [:seon.source/path {:optional true} :seon.source/path]
                [:seon.program/conflict-digests {:optional true :description "A :conflict's declarations: the merge base (the branch's base), head (the file now, ours) and branch (theirs) digest of each."}
                 :seon.program/conflict-digests]]],
              :base-digest [:string {:min 1 :description "The file digest the replaced declarations were analyzed from."}],
              :candidate-digest [:string {:min 1 :description "The digest of the installed, proven candidate bytes."}],
              :replaced [:vector {:description "The declarations a write-back replaced, by identity."} :seon.program/identity],
              :added [:vector {:description "The declarations a write-back appended to their namespace's file, by identity."} :seon.program/identity],
              :retracted [:vector {:description "The declarations a write-back removed with their spans, by identity."} :seon.program/identity],
              :written
              [:map
               [:seon.source/changed-paths :seon.source/changed-paths]
               [:seon.program/rows {:optional true :description "The held analysis of the written source files (seon.cluster.source/file-proof), which seon.merge/indexed! reindexes main from."} :seon.program/rows]
               [:seon.source/files [:vector {:min 1 :description "One entry per file a write-back installed, in path order: a merge writes each change into its one file."}
                                    :seon.source/file-written]]],
              :file-written
              [:map
               [:seon.source/path :seon.source/path]
               [:seon.source/base-digest :seon.source/base-digest]
               [:seon.source/candidate-digest :seon.source/candidate-digest]
               [:seon.source/replaced :seon.source/replaced]
               [:seon.source/added {:optional true} :seon.source/added]
               [:seon.source/retracted {:optional true} :seon.source/retracted]],
              :refresh-result [:or [:and :seon.source/published :seon.source/adoption-result]
                               :seon.source/publication-error],
              :published
              [:map
               [:seon.source/branch :seon.source/branch]
               [:seon.source/commit-id :seon.source/commit-id]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/built? :seon.source/built?]
               [:seon.program/unresolved-report {:optional true} :seon.program/unresolved-report]],
              :roots [:vector [:string {:min 1}]],
              :snapshot
              [:map
               [:seon.source/test-input-digest {:optional true} :seon.source/test-input-digest]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/relative-file-digests :seon.source/relative-file-digests]]
              :paths [:vector {:min 1} :seon.source/path],
              :accepted-red-before [:set {:description "Tests red before a branch's change that root accepts at its commit."} :seon.test/sym],
              :branch-evidence-request
              [:map {:description "What the commit gate asks of a store: does this branch prove these working-tree files of the checkout at root, against the head it forked from?"}
               [:seon.store/branch :seon.store/branch]
               [:seon.source/head :seon.source/head] [:seon.fn/root :seon.fn/root] [:seon.source/paths :seon.source/paths]
               [:seon.source/accepted-red-before {:optional true} :seon.source/accepted-red-before]],
              :head [:and {:description "The branch whose head a lane's changes are judged against: its cluster's branch."} :seon.store/branch],
              :declaration :seon.program/declaration-identity,
              :file-digest :seon.program/digest-or-absence,
              :branch-digest :seon.program/digest-or-absence,
              :differing-declaration
              [:map {:description "A declaration whose working-tree file digest is not the branch head's."}
               [:seon.source/path :seon.source/path] [:seon.source/declaration :seon.source/declaration]
               [:seon.source/file-digest :seon.source/file-digest] [:seon.source/branch-digest :seon.source/branch-digest]],
              :proven? :boolean,
              :branch-commit-id :seon.source/commit-id,
              :head-commit-id :seon.source/commit-id,
              :changed [:vector :seon.program/declaration-identity],
              :differing [:vector :seon.source/differing-declaration],
              :unanalyzable [:vector :seon.source/path],
