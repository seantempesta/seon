               [:seon.test.selection/input-evidence {:optional true} :seon.test.selection/input-evidence]
               [:seon.test.run/members [:vector :seon.test.member/member]]
               [:seon.test.run/policy :seon.test.run/policy]
               [:seon.test/include-long? {:optional true} :boolean]
