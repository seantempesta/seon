               [:seon.source/branch :seon.source/branch]
               [:seon.source/commit-id :seon.source/commit-id]],
              :digest
              [:re #:seon.db{:identity true} "^[0-9a-f]{64}$"],
              :digest-request
              [:map [:seon.source/roots :seon.source/roots]],
              :expected-commit-id :uuid,
              :file-digests [:map-of :string :seon.source/digest],
              :populate :qualified-symbol,
              :activation :qualified-symbol,
              :activation-closure
              [:and {:seon.db/component true} :seon.db/ref],
              :path [:string {:min 1}],
              :population
              [:map
               [:seon.db/connection
                :seon.db/connection]
               [:seon.source/digest :seon.source/digest]],
              :populate-request
              [:map
               [:seon.fn/manifest
                {:optional true}
                :seon.fn.manifest/manifest]],
              :publish-request
              [:map
               [:seon.store/store :seon.store/store]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/populate :seon.source/populate]
               [:seon.source/activation :seon.source/activation]
               [:seon.source/populate-request
                {:optional true}
                :seon.source/populate-request]],
              :published
              [:map
               [:seon.source/branch :seon.source/branch]
               [:seon.source/commit-id :seon.source/commit-id]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/built? :seon.source/built?]],
              :roots [:vector [:string {:min 1}]],
