#:seon.source{:branch :keyword,
              :operator-root :string,
              :refused-test-run [:and {:seon.db/identity false :description "Identity of the test request whose admission or completion the source authority refused."} :seon.test.run/id],
              :test-evidence-error
              [:and :seon.error/base
               [:map [:seon.source/refused-test-run :seon.source/refused-test-run]
                [:seon.source/operator-root {:optional true} :seon.source/operator-root]
                [:seon.test.run/branch {:optional true} :seon.test.run/branch]]],
              :test-selection-request
              [:map
               [:seon.test.run/provenance [:and :seon.test.run/provenance :seon.test.run/snapshot]]
               [:seon.test.run/input-digest :seon.test.run/input-digest]
               [:seon.test.selection/input-evidence {:optional true} :seon.test.selection/input-evidence]
               [:seon.test.run/members [:vector :seon.test.member/member]]
               [:seon.test.run/policy :seon.test.run/policy]
               [:seon.test/include-long? {:optional true} :boolean]
               [:seon.test/namespaces {:optional true} [:set :symbol]]
               [:seon.test/identities {:optional true} [:set :qualified-symbol]]
               [:seon.test/remaining-ms {:optional true} [:int {:min 1}]]],
              :test-recording-request [:or :seon.test.run/completion :seon.source/test-selection-request],
              :test-recording-result
              [:or :seon.test.run/admission :seon.test/results :seon.source/test-evidence-error :seon.source/publication-error],
              :built-at :inst,
              :built? :boolean,
              :commit-id :uuid,
              :database :seon.db/database-value,
              :current
              [:map
               [:seon.source/branch :seon.source/branch]
               [:seon.source/commit-id :seon.source/commit-id]],
              :digest
              [:re #:seon.db{:identity true} "^[0-9a-f]{64}$"],
              :test-input-digest
              [:and {:seon.db/identity false :description "Digest of the sorted publication input inventory outside the program graph, including pinned gitlink identities. Observed value survives its input files."} :seon.source/digest],
              :analyzer-digest
              [:and {:seon.db/identity false :description "The identity of the code that derives program entities: the digest of the definition digests seon.cluster/analyzer-reach reaches (from seon.fn/analyze-entities and seon.fn/desired-entities, outside the database and error owners) in the program this JVM loaded. Each file's derivation key names it (:seon.fn.file/derivation-digest)."} :seon.source/digest],
              :test-input-digests [:map-of :string :seon.source/digest],
              :digest-request
              [:map [:seon.source/roots :seon.source/roots]
                    [:seon.fn/root {:optional true} :string]],
              :expected-commit-id :uuid,
              :expected-head
              [:map
               [:seon.source/branch :seon.source/branch]
               [:seon.source/expected-commit-id :seon.source/expected-commit-id]],
              :relative-file-digests [:map-of :string :seon.source/digest],
              :populate :qualified-symbol,
              ;; The owner that installs one changed input's facts: a Clojure
              ;; file's program entities, a schema resource's declarations, the
              ;; shipped config document's initialization entities, or nothing at
              ;; all. An incremental publication runs exactly the named owners.
              :change-class
              [:enum :program :schema-resource :config :no-program-facts],
              :change-classes [:set :seon.source/change-class],
              :previous-database :seon.db/database-value,
              :path [:string {:min 1}],
              :changed-paths [:vector :seon.source/path],
              :population
              [:map
               [:seon.db/connection
                :seon.db/connection]
               [:seon.source/digest :seon.source/digest]],
              :populate-request
              [:map
               [:seon.source/relative-file-digests {:optional true} :seon.source/relative-file-digests]
               [:seon.source/change-classes {:optional true} :seon.source/change-classes]
               [:seon.fn/manifest
                {:optional true}
                :seon.fn.manifest/manifest]],
              :progress! [:=> [:cat :string] :nil],
              :publish-request
              [:map
               [:seon.source/relative-file-digests {:optional true} :seon.source/relative-file-digests]
               [:seon.source/changed-paths {:optional true} :seon.source/changed-paths]
               [:seon.source/test-input-digest {:optional true} :seon.source/test-input-digest]
               [:seon.source/analyzer-digest {:optional true} :seon.source/analyzer-digest]
               [:seon.fn/root {:optional true} :seon.fn/root]
               [:seon.source/expected-commit-id {:optional true} :seon.source/expected-commit-id]
               [:seon.db/process {:optional true} :seon.db/ref]
               [:seon.store/store :seon.store/store]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/populate :seon.source/populate]
               [:seon.source/progress! {:optional true} :seon.source/progress!]
               [:seon.db/writer {:optional true :description "The writer of publication's scratch schema and seal transactions."} :seon.db/writer]
               [:seon.source/populate-request
                {:optional true}
                :seon.source/populate-request]],
              :reloaded-namespaces [:vector {:description "Namespaces whose require :reload completed in this request, in reload order."} :symbol],
              :arming-identities [:and {:description "Reloaded Var and schema-referrer identities supplied to instrumentation by this adoption; empty for an unchanged adoption."} :seon.reconcile/adopt-identities],
              :adoption-result
              [:map
               [:seon.source/reloaded-namespaces :seon.source/reloaded-namespaces]
               [:seon.source/arming-identities :seon.source/arming-identities]],
              :publication-error
              [:and :seon.error/base
               [:map
                [:seon.source/branch :seon.source/branch]
                [:seon.source/expected-commit-id :seon.source/expected-commit-id]
                [:seon.source/commit-id :seon.source/commit-id]]],
              :publish-result [:or :seon.source/published :seon.source/publication-error],
              :file-bytes [:fn {:error/message "must be a byte array"} clojure.core/bytes?],
              :accepted
              [:map {:description "An accepted merge: the declarations it merged, the branch commit before it, its merge commit and the run that tested it."}
               [:seon.program/identities :seon.program/identity-set]
               [:seon.source/base-commit-id :seon.source/commit-id]
               [:seon.source/commit-id :seon.source/commit-id]
               [:seon.test.run/id {:optional true} :seon.test.run/id]],
              :proposal
              [:map {:description "A prepared merge accept-merge! takes: the tested intermediate branch, its run and verdict, the digest each merged declaration held on the destination, and the candidate's commit."}
               [:seon.source/candidate :seon.store/branch] [:seon.test.run/id :seon.test.run/id]
               [:seon.test/passed? :boolean] [:seon.source/tally :string]
               [:seon.source/expected-digests :seon.source/expected-digests]
               [:parents [:set :seon.source/commit-id]]],
              :candidate-bytes [:and {:description "The proven file bytes a write-back installs."} :seon.source/file-bytes],
              :proof-rows [:sequential {:description "Each written declaration with its entity before and after the merge (absent: nil)."}
                           [:tuple :seon.program/declaration-identity [:maybe :map] [:maybe :map]]],
              :proof
              [:map {:description "A write-back proven before installation: the file, the bytes it was analyzed from, the candidate and its entities."}
               [:seon.source/path :seon.source/path] [:seon.source/base-digest :seon.source/base-digest]
               [:seon.source/candidate-bytes :seon.source/candidate-bytes] [:seon.source/proof-rows :seon.source/proof-rows]],
              :base-commit-id [:uuid {:description "The branch's commit a merge was transacted onto."}],
              :expected-digests
              [:map-of {:description "The digest each merged declaration held on the destination when the merge was prepared; a merge's basis."}
               :seon.program/declaration-identity :seon.program/digest-or-absence],
              :write-back-request
              [:map
               [:seon.db/connection :seon.db/connection]
               [:seon.source/accepted :seon.source/accepted]
               [:seon.fn/root :seon.fn/root]],
              :write-back-refused
              [:enum {:description "Why a write-back installed nothing."}
               :row-changed :commit-absent :no-replacement :one-file :file-absent :file-changed :span-mismatch :not-analyzable :not-equivalent :install-failed],
              :write-back-error
              [:and :seon.error/base
               [:map [:seon.source/write-back-refused :seon.source/write-back-refused]
                [:seon.source/path {:optional true} :seon.source/path]]],
              :base-digest [:string {:min 1 :description "The file digest the replaced declarations were analyzed from."}],
              :candidate-digest [:string {:min 1 :description "The digest of the installed, proven candidate bytes."}],
              :replaced [:vector {:description "The declarations a write-back replaced, by identity."} :seon.program/identity],
              :added [:vector {:description "The declarations a write-back appended to their namespace's file, by identity."} :seon.program/identity],
              :retracted [:vector {:description "The declarations a write-back removed with their spans, by identity."} :seon.program/identity],
              :written
              [:map
               [:seon.source/changed-paths :seon.source/changed-paths]
               [:seon.source/written
                [:map
                 [:seon.source/path :seon.source/path]
                 [:seon.source/base-digest :seon.source/base-digest]
                 [:seon.source/candidate-digest :seon.source/candidate-digest]
                 [:seon.source/replaced :seon.source/replaced]
                 [:seon.source/added {:optional true} :seon.source/added]
                 [:seon.source/retracted {:optional true} :seon.source/retracted]]]],
              :refresh-result [:or [:and :seon.source/published :seon.source/adoption-result]
                               :seon.source/publication-error],
              :published
              [:map
               [:seon.source/branch :seon.source/branch]
               [:seon.source/commit-id :seon.source/commit-id]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/built? :seon.source/built?]
               [:seon.program/unresolved-report {:optional true} :seon.program/unresolved-report]],
              :roots [:vector [:string {:min 1}]],
              :snapshot
              [:map
               [:seon.source/test-input-digest {:optional true} :seon.source/test-input-digest]
               [:seon.source/digest :seon.source/digest]
               [:seon.source/relative-file-digests :seon.source/relative-file-digests]]}
