               [:seon.program/identities :seon.program/identity-set]
               [:seon.source/base-commit-id :seon.source/commit-id]
               [:seon.source/commit-id :seon.source/commit-id]
               [:seon.test.run/id {:optional true} :seon.test.run/id]],
              :acceptance
              [:map {:description "What a merge's git commit names: the assignment, the merge commit, and the run that gated it, the task, agent and the models it called when they are known."}
               [:seon.task/assignment :seon.task/assignment] [:seon.test.run/id {:optional true} :seon.test.run/id] [:seon.source/commit-id :seon.source/commit-id]
               [:seon.task/sym {:optional true} :seon.task/sym] [:seon.agent/id {:optional true} :seon.agent/id]
               [:seon.source/models {:optional true} :seon.source/models]],
