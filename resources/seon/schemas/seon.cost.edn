;; Costs (idea 16: estimate first; an overrun is a failing proof) and what each contracted
;; function cost (seon.profile). A cost proof (seon.cost/proof) states an estimate: what N
;; counts, the least work the data requires, how that work grows, and what each unit of it
;; costs; it measures the function at three or more sizes and is red when it costs more.
{:seon.profile/fn-cost [:map {:closed true} [:var :qualified-symbol] [:calls nat-int?] [:ticks :int] [:self-ticks :int] [:bytes :int] [:self-bytes :int]]
 ;; how the least work grows with N: W(n) = 1, log2 n, n, n log2 n, n², n³
 :seon.cost/growth [:enum :constant :log :linear :n-log-n :quadratic :cubic]
 ;; the measured dimensions: engine ticks (the work done, counted), this thread's CPU ns (min over
 ;; repeats; shown, never red), allocated bytes, calls of contracted functions
 ;; an estimate may state whole numbers; measurements are doubles
 :seon.cost/amount [:or nat-int? [:double {:min 0.0}]]
 :seon.cost/dims [:map {:closed true}
                  [:ticks {:optional true} :seon.cost/amount]
                  [:ns {:optional true} :seon.cost/amount]
                  [:bytes {:optional true} :seon.cost/amount]
                  [:calls {:optional true} :seon.cost/amount]]
 :seon.cost/dim [:enum :ticks :ns :bytes :calls]
 ;; one unit operation of the unit table (seon.cost/units): its measured cost on this runtime
 :seon.cost/unit [:map {:closed true} [:ticks {:optional true} [:double {:min 0.0}]] [:ns [:double {:min 0.0}]] [:bytes [:double {:min 0.0}]] [:what :string]]
 ;; an estimate: sized (stated per unit of W(n), measured at sizes of a built input), or
 ;; generated (the function's contract's bound, on cases drawn from a generator)
 :seon.cost/estimate [:or :seon.cost/sized :seon.cost/generated]
 :seon.cost/generated [:map {:closed true}
                       ;; the function measured: its contract carries :seon.cost/bound (seon.cost/bound)
                       [:of :qualified-symbol]
                       [:n :string]
                       [:work :string]
                       ;; how many cases, and the var of a test.check generator of argument vectors
                       ;; (none: the contract's input, by malli's generator)
                       [:cases pos-int?]
                       [:gen {:optional true} :qualified-symbol]]
 ;; a generated estimate of a function whose contract carries no bound (seon.cost/bound)
 :seon.cost/no-bound [:and :seon.error/base [:map [:seon.error/type [:= :seon.cost/no-bound]] [:var :qualified-symbol]]]
 ;; what prices an estimate (per-unit, expected): its growth and costs, a proof's whole estimate or the part of its form that states them
 :seon.cost/priced [:map [:growth :seon.cost/growth] [:ops {:optional true} [:map-of :keyword :seon.cost/amount]] [:per-n {:optional true} :seon.cost/dims] [:fixed {:optional true} :seon.cost/dims]]
 :seon.cost/sized [:map {:closed true}
                      ;; the function measured, and the function of n answering its argument vector
                      [:of :qualified-symbol]
                      [:input :qualified-symbol]
                      ;; what N counts, and the least work the data requires (the floor, in words)
                      [:n :string]
                      [:work :string]
                      [:growth :seon.cost/growth]
                      ;; unit operations per unit of W(n), from seon.cost/units (derived), and/or
                      ;; costs per unit of W(n) stated directly; the stated ones win
                      [:ops {:optional true} [:map-of :keyword :seon.cost/amount]]
                      [:per-n {:optional true} :seon.cost/dims]
                      ;; costs that do not grow with n
                      [:fixed {:optional true} :seon.cost/dims]
                      ;; ascending, at least three, spanning at least 100x
                      [:sizes [:vector {:min 3} pos-int?]]
                      ;; an overrun accepted while its task is open: the task (a task-file entry), the size it was
                      ;; taken at (:n, the proof's largest) and what that size measured when it was filed; red again
                      ;; past ratchet x that. A task no file declares, a missing :n or one that is not the largest
                      ;; size makes the proof red (:waiver-fault of its verdict)
                      [:overrun {:optional true} :seon.cost/overrun]]
 :seon.cost/overrun [:map {:closed true} [:task :string] [:n {:optional true} pos-int?] [:measured :seon.cost/dims]]
 ;; one size measured: n, what it cost, what the estimate allows there
 ;; (a generated case: n its place, :args the arguments that reproduce it)
 :seon.cost/row [:map {:closed true} [:n pos-int?] [:measured :seon.cost/dims] [:expected :seon.cost/dims] [:args {:optional true} [:vector {:gen/max 3} :any]] [:calls {:optional true} pos-int?]]
 :seon.cost/over [:map {:closed true} [:dim :seon.cost/dim] [:n pos-int?] [:ratio [:double {:min 0.0}]]]
 ;; how a measured dimension grew over the sizes, against what the estimate's growth allows
 :seon.cost/fit [:map {:closed true} [:dim :seon.cost/dim] [:exponent :double] [:allowed :double]]
 :seon.cost/verdict [:map {:closed true :seon.render/hiccup seon.render.ui/verdict-box}
                     [:ok? :boolean]
                     ;; a size whose measure exceeds its slack times the estimate
                     [:over [:vector {:gen/max 3} :seon.cost/over]]
                     ;; a dimension that grew faster than the estimate's growth allows
                     [:steeper [:vector {:gen/max 3} :seon.cost/fit]]
                     ;; the largest size under a third of its estimate: the estimate is loose (a finding, not red)
                     [:under [:vector {:gen/max 3} :seon.cost/over]]
                     ;; a dimension the estimate states that was not measured (contracts off: no calls)
                     [:unmeasured [:vector {:gen/max 3} :seon.cost/dim]]
                     ;; no counted dimension (ticks, bytes, calls) both estimated and measured: red, the proof could not fail
                     [:uncounted {:optional true} :boolean]
                     ;; the over and steeper findings an open overrun task accepts (still shown, not red)
                     [:accepted {:optional true} [:map [:task :string] [:over [:vector {:gen/max 3} :seon.cost/over]] [:steeper [:vector {:gen/max 3} :seon.cost/fit]]]]
                     ;; a broken waiver, red: its :overrun names no task entry (:no-task), states no size (:no-size) or one
                     ;; that is not the proof's largest (:wrong-size, :largest the size measured)
                     [:waiver-fault {:optional true} [:map [:fault [:enum :no-task :no-size :wrong-size]] [:task :string] [:n {:optional true} pos-int?] [:largest {:optional true} pos-int?]]]]
 ;; keys-schemas sweep
 :seon.cost/bound [:and {:description "In a function's metadata beside its :malli/schema, the cost bound of one call: a function of the same arguments answering {:ticks :bytes :calls} and :out. See docs/cost.md#a-bound-in-the-contract."} :seon.host/fn]}
