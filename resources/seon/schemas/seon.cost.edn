{:seon.cost/ms
 [:double {:min 0.0 :description "Wall milliseconds: for a request, to 0.1, from the eval entrance to the observation before printing its cost. JVM-window CPU and allocation use their counter precision."}]
 :seon.cost/stages
 [:map-of {:description "Named wall intervals rounded down to 0.1 ms, plus :unattributed (submission, queue wait, unbracketed work and rounding), summing to the observed total. A negative :unattributed exposes overlapping stage intervals instead of hiding them."}
  :keyword :double]
 :seon.cost/jvm-window
 [:map {:description "Counter deltas between two observations of this JVM. Includes concurrent unrelated work; never causal request attribution. Allocation is an approximate HotSpot counter; CPU includes all process threads, GC and compilation. Unavailable counters are absent and named in unmeasured."}
  [:seon.cost/scope [:= :jvm-window]]
  [:seon.cost/attribution [:= :includes-unrelated-work]]
  [:seon.cost/alloc-accuracy [:= :approximate-counter]]
  [:seon.cost/cpu-accuracy [:= :os-counter]]
  [:seon.cost/alloc-mb {:optional true} :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms {:optional true} :seon.cost/cpu-ms]
  [:seon.cost/unmeasured {:optional true} :seon.cost/unmeasured]]
 :seon.cost/calls
 [:int {:min 0 :description "Armed calls the request's pass made in its own worlds (the turn proc's pass, its batch, the bodies its test step ran), each entry counted once in the world it entered; the entrance's custody and print are outside them."}]
 :seon.cost/reads
 [:int {:min 0 :description "The calls among :seon.cost/calls to a seon.db read entrance (seon.profile/read-entrances)."}]
 :seon.cost/transactions
 [:int {:min 0 :description "The commit attempts among :seon.cost/calls (seon.profile/transaction-entrances)."}]
 :seon.cost/alloc-mb
 [:double {:min 0.0 :description "Megabytes (to 0.1) the request's forms allocated in their evaluation arms: the platform worker each form's arm ran on (seon.sci.kernel/with-arm) and the platform threads that adopted the arm (seon.sci.kernel/adopt-arm), from HotSpot's per-thread counter, independent of other threads. Outside it: the pass's fork, settlement and test step on the agent's virtual thread, the Datahike writer, unadopted futures."}]
 :seon.cost/cpu-ns
 [:int {:min 0 :description "CPU nanoseconds of one evaluation arm's threads, as :seon.cost/alloc-mb scopes them."}]
 :seon.cost/cpu-ms
 [:double {:min 0.0 :description "CPU milliseconds (to 0.1) of the request's evaluation arms, scoped as :seon.cost/alloc-mb."}]
 :seon.cost/unmeasured
 [:map-of {:description "A measure the request could not take, by its key, and why: :unmeasured-arm (a form's arm ran where HotSpot keeps no count), :no-form (nothing evaluated)."}
  :qualified-keyword :keyword]
 :seon.cost/counts
 [:map [:seon.cost/calls :seon.cost/calls] [:seon.cost/reads :seon.cost/reads]
  [:seon.cost/transactions :seon.cost/transactions]
  [:seon.cost/alloc-mb {:optional true} :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms {:optional true} :seon.cost/cpu-ms]
  [:seon.cost/unmeasured {:optional true} :seon.cost/unmeasured]]
 :seon.cost/request
 [:map {:description "Request wall time and armed call counts; top-level allocation and CPU cover evaluation arms only. jvm-window covers every thread in the observation window, including unrelated work. Causal all-thread attribution is unavailable; unavailable counters are absent."}
  [:seon.cost/ms :seon.cost/ms]
  [:seon.cost/arm-scope [:= :evaluation-arms-only]]
  [:seon.cost/causal-attribution [:= :unavailable]]
  [:seon.cost/jvm-window {:optional true} :seon.cost/jvm-window]
  [:seon.cost/stages {:optional true} :seon.cost/stages]
  [:seon.cost/calls {:optional true} :seon.cost/calls]
  [:seon.cost/reads {:optional true} :seon.cost/reads]
  [:seon.cost/transactions {:optional true} :seon.cost/transactions]
  [:seon.cost/alloc-mb {:optional true} :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms {:optional true} :seon.cost/cpu-ms]
  [:seon.cost/unmeasured {:optional true} :seon.cost/unmeasured]]}
