{:seon.cost/ms
 [:double {:min 0.0 :description "Wall milliseconds: for a request, to 0.1, from the eval entrance to the observation before printing its cost. JVM-window CPU and allocation use their counter precision."}]
 :seon.cost/stages
 [:map-of {:description "Named wall intervals rounded down to 0.1 ms, plus :unattributed (submission, queue wait, unbracketed work and rounding), summing to the observed total. A negative :unattributed exposes overlapping stage intervals instead of hiding them."}
  :keyword :double]
 :seon.cost/jvm-window
 [:map {:description "Counter deltas between two observations of this JVM. Includes concurrent unrelated work; never causal request attribution. Allocation is an approximate HotSpot counter; CPU includes all process threads, GC and compilation. Unavailable counters are absent and named in unmeasured."}
  [:seon.cost/scope [:= :jvm-window]]
  [:seon.cost/attribution [:= :includes-unrelated-work]]
  [:seon.cost/alloc-accuracy [:= :approximate-counter]]
  [:seon.cost/cpu-accuracy [:= :os-counter]]
  [:seon.cost/alloc-mb {:optional true} :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms {:optional true} :seon.cost/cpu-ms]
  [:seon.cost/unmeasured {:optional true} :seon.cost/unmeasured]]
 :seon.cost/calls
 [:int {:min 0 :description "Armed calls the request's pass made in its own worlds (the turn proc's pass, its batch, the bodies its test step ran), each entry counted once in the world it entered; the entrance's custody and print are outside them."}]
 :seon.cost/reads
 [:int {:min 0 :description "The calls among :seon.cost/calls to a seon.db read entrance (seon.profile/read-entrances)."}]
 :seon.cost/transactions
 [:int {:min 0 :description "The commit attempts among :seon.cost/calls (seon.profile/transaction-entrances)."}]
 :seon.cost/alloc-mb
 [:double {:min 0.0 :description "Megabytes (to 0.1) the request's forms allocated in their evaluation arms: the platform worker each form's arm ran on (seon.sci.kernel/with-arm) and the platform threads that adopted the arm (seon.sci.kernel/adopt-arm), from HotSpot's per-thread counter, independent of other threads. Outside it: the turn step's fork, settlement and test step (on its proc's platform thread, counted as :seon.cost/step), the Datahike writer, unadopted futures."}]
 :seon.cost/cpu-ns
 [:int {:min 0 :description "CPU nanoseconds of one evaluation arm's threads, as :seon.cost/alloc-mb scopes them."}]
 :seon.cost/cpu-ms
 [:double {:min 0.0 :description "CPU milliseconds (to 0.1) of the request's evaluation arms, scoped as :seon.cost/alloc-mb."}]
 :seon.cost/unmeasured
 [:map-of {:description "A measure the request could not take, by its key, and why: :unmeasured-arm (a form's arm ran where HotSpot keeps no count), :no-form (nothing evaluated), :counter-unavailable (a JVM counter answered -1), :overlapping-parts (the attributed parts exceed the window: a residual never clamped)."}
  :qualified-keyword :keyword]
 :seon.cost/counts
 [:map [:seon.cost/calls :seon.cost/calls] [:seon.cost/reads :seon.cost/reads]
  [:seon.cost/transactions :seon.cost/transactions]
  [:seon.cost/alloc-mb {:optional true} :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms {:optional true} :seon.cost/cpu-ms]
  [:seon.cost/unmeasured {:optional true} :seon.cost/unmeasured]
  [:seon.cost/step {:optional true} :seon.cost/step]
  [:seon.cost/writer {:optional true} :seon.cost/writer]
  [:seon.cost/commit {:optional true} :seon.cost/commit]
  [:seon.cost/live {:optional true} :seon.cost/live]
  [:seon.cost/tests {:optional true} :seon.cost/tests]
  [:seon.cost/live-tests {:optional true} :seon.cost/live-tests]]
 :seon.cost/step
 [:map {:description "The agent's turn step as the proc thread counted it: bytes allocated and CPU time between the step's start and its end, on a platform thread (exact, unlike a virtual thread, which has no counter). Producer: seon.flow/var-process. Consumer: the reply."}
  [:seon.cost/alloc-mb :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms :seon.cost/cpu-ms]]
 :seon.cost/writer-meter
 [:and {:description "A world's writer meter (seon.db/writer-meter), six slots: transactions, processing bytes and CPU nanoseconds, commit-share bytes and CPU nanoseconds, the largest batch. seon.db/transact! adds each committed report's writer cost; seon.db/writer-cost reads it. Producer: seon.flow/var-process, one per step."}
  :seon.profile/world-counter]
 :seon.cost/writer
 [:map {:description "The Datahike writer's processing of the request's transactions, as the writer thread counted it (`:datahike/processing` on each report, seon.cluster.store/processing-measured): megabytes allocated, CPU milliseconds, and how many transactions. Producer: seon.db/writer-cost. Consumer: the reply."}
  [:seon.cost/alloc-mb :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms :seon.cost/cpu-ms]
  [:seon.cost/transactions :seon.cost/transactions]]
 :seon.cost/commit
 [:map {:description "The commits that made the request's transactions durable, as their one platform thread counted them (`:datahike/commit` on each report): megabytes and CPU milliseconds. A commit shared by a batch of transactions (Datahike group commit) is charged in equal shares; batch-size is the largest batch, so above 1 the values are shares. Producer: seon.db/writer-cost. Consumer: the reply."}
  [:seon.cost/alloc-mb :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms :seon.cost/cpu-ms]
  [:seon.cost/batch-size :seon.cost/batch-size]]
 :seon.cost/batch-size [:int {:min 1 :description "The most transactions one commit made durable together."}]
 :seon.cost/comparison
 [:map {:description "One subject's live value beside main's stored value. Only a definition the agent changed (interpreted, or its digest differs from main's) is shown; an unchanged definition is never an entry, whatever its ratio. A test reaching a changed definition is shown when main has none or its allocation moved by the hysteresis either way."}
  [:seon.cost.comparison/subject :seon.cost.comparison/subject]
  [:seon.cost.comparison/measure :seon.cost.comparison/measure]
  [:seon.cost.comparison/live :seon.cost.comparison/live]
  [:seon.cost.comparison/main {:optional true} :seon.cost.comparison/main]
  [:seon.cost.comparison/ratio {:optional true} :seon.cost.comparison/ratio]
  [:seon.cost.comparison/flags :seon.cost.comparison/flags]]
 :seon.cost/diff
 [:vector {:description "The request's comparisons against main, at most :seon.config.test.cost/top. Producer: seon.batch/cost-diff. Consumer: the reply."}
  :seon.cost/comparison]
 :seon.cost/live
 [:vector {:description "The request's own per-definition values from its sink: what the reply compares. Producer: seon.profile/live-costs."}
  :seon.fn.cost/entity]
 :seon.cost/tests
 [:map {:description "The test step's members this request ran, summed from their cost attributes (:seon.test.member/*): allocation in megabytes on their body threads, wall milliseconds of their bodies, and how many. Producer: seon.turn/test-step. Consumer: the reply."}
  [:seon.cost/alloc-mb :seon.cost/alloc-mb]
  [:seon.cost/ms :seon.cost/ms]
  [:seon.cost/count :seon.cost/count]]
 :seon.cost/count [:int {:min 0 :description "How many members the test step ran in this request."}]
 :seon.cost/live-tests
 [:vector {:description "The members the test step ran in this request, with their cost attributes: what the reply compares with main's latest results for the same tests. Producer: seon.turn/test-step."}
  [:map [:seon.test/sym :seon.test/sym] [:seon.test.member/alloc-bytes :seon.test.member/alloc-bytes]]]
 :seon.cost/subjects
 [:set {:description "The definitions and tests a request defined or ran, and the schemas it measured: what cost-diff pulls from main by identity."}
  :seon.cost.comparison/subject]
 :seon.cost/entrance
 [:map {:description "The entrance thread (the MCP caller) as its counters measured the request: custody acquisition, a JVM-mode form's host evaluation, the diff and the print; a platform thread, exact. Producer: seon.mcp/eval-clj. Consumer: the reply and :seon.cost/shared."}
  [:seon.cost/alloc-mb :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms :seon.cost/cpu-ms]]
 :seon.cost/gc-ms
 [:double {:min 0.0 :description "Garbage-collection CPU milliseconds of the whole JVM in the request's window (java.lang.management.MemoryMXBean/getTotalGcCpuTime)."}]
 :seon.cost/jit-ms
 [:double {:min 0.0 :description "JIT compilation milliseconds of the whole JVM in the request's window (java.lang.management.CompilationMXBean/getTotalCompilationTime)."}]
 :seon.cost/shared
 [:map {:description "The request's JVM window less its attributed parts (entrance, step, tests, writer, commit), with the window's GC CPU and JIT time beside it: work shared with the JVM, labelled and never apportioned. Producer: seon.batch/shared-cost. Consumer: the reply."}
  [:seon.cost/attribution [:= :shared-never-apportioned]]
  [:seon.cost/alloc-mb {:optional true} :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms {:optional true} :seon.cost/cpu-ms]
  [:seon.cost/gc-ms {:optional true} :seon.cost/gc-ms]
  [:seon.cost/jit-ms {:optional true} :seon.cost/jit-ms]
  [:seon.cost/unmeasured {:optional true} :seon.cost/unmeasured]]
 :seon.cost/request
 [:map {:description "Request wall time and armed call counts; top-level allocation and CPU cover evaluation arms (whose owning thread is the step's or the entrance's), step the turn step's proc thread, entrance the MCP caller's thread, shared the window's residual. jvm-window covers every thread in the observation window, including unrelated work; unavailable counters are absent."}
  [:seon.cost/ms :seon.cost/ms]
  [:seon.cost/jvm-window {:optional true} :seon.cost/jvm-window]
  [:seon.cost/step {:optional true} :seon.cost/step]
  [:seon.cost/writer {:optional true} :seon.cost/writer]
  [:seon.cost/commit {:optional true} :seon.cost/commit]
  [:seon.cost/entrance {:optional true} :seon.cost/entrance]
  [:seon.cost/shared {:optional true} :seon.cost/shared]
  [:seon.cost/tests {:optional true} :seon.cost/tests]
  [:seon.cost/diff {:optional true} :seon.cost/diff]
  [:seon.cost/stages {:optional true} :seon.cost/stages]
  [:seon.cost/calls {:optional true} :seon.cost/calls]
  [:seon.cost/reads {:optional true} :seon.cost/reads]
  [:seon.cost/transactions {:optional true} :seon.cost/transactions]
  [:seon.cost/alloc-mb {:optional true} :seon.cost/alloc-mb]
  [:seon.cost/cpu-ms {:optional true} :seon.cost/cpu-ms]
  [:seon.cost/unmeasured {:optional true} :seon.cost/unmeasured]]}
