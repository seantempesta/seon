;; The test service (seon.prove, docs/merging.md#the-test-service): its requests and answers. A run's
;; verdicts are not stored here: they are a cache by digest outside the store (seon.fx/write-verdicts!,
;; docs/merging.md#verdicts-are-a-cache), since a verdict is derived data (owner, 2026-10-28).
{ ;; a run could not read the verdicts at its digests (test-runner/read-results): why, never zero greens
 :seon.proofs/unread [:and :seon.error/base [:map [:seon.error/type [:= :seon.proofs/unread]] [:why :any]]]
 ;; the request a session or an agent's turn makes of the service, and its answer
 :seon.prove/request [:map [:branch :keyword] [:t :int] [:agent {:optional true} [:maybe :keyword]] [:proofs {:optional true} [:set :qualified-symbol]]]
 ;; a batch's tag: what every process it starts carries as SEON_PROVE_BATCH (seon.prove/batch-tag)
 :seon.prove/batch [:string {:description "The test service's tag of a batch it granted, its process's pid and the batch's number: every process the batch starts carries it as SEON_PROVE_BATCH, so seon.prove/held-processes counts what each running batch holds. See docs/merging.md#the-test-service."}]
 :seon.prove/answer [:map [:key :string] [:ran :boolean] [:pass nat-int?] [:fail nat-int?] [:error nat-int?]]}
