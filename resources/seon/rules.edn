                      [$wm :ctx/lineage :view/fn _]
                      [(ground :ctx/lineage) ?e]
                      [(ground :seon.rule/nil) ?zone]
                      [(ground :seon.rule/nil) ?layout]
                      [(ground :seon.rule/nil) ?pri]
                      [(ground :view.param/omit-templates?) ?p1k]
                      [(ground true) ?p1v]
                      [(ground :seon.rule/nil) ?p2k]
                      [(ground :seon.rule/nil) ?p2v]
                      [(ground :seon.rule/nil) ?why])
                     (and
                      [$wm ?v :rel/scope ?e]
                      [$wm ?v :rel/task ?t]
                      [$wm ?t :rel/mentions-ns ?tns]
                      [(not= ?e ?tns)]
                      [(ground :seon.rule/nil) ?zone]
                      [(ground :summary-strip) ?layout]
                      [(ground 45) ?pri]
                      [(ground :view.param/max-vars) ?p1k]
                      [(ground 0) ?p1v]
                      [(ground :seon.rule/nil) ?p2k]
                      [(ground :seon.rule/nil) ?p2v]
                      [(ground "Demoted to summary strip (task names specific target ns)") ?why])
                     (and
                      [$wm ?v :rel/scope ?sc]
                      [$wm ?v :rel/task ?t]
                      [$wm ?t :rel/mentions-ns ?e]
                      [(not= ?sc ?e)]
                      [(ground :seon.rule/nil) ?zone]
                      [(ground :expanded-card) ?layout]
                      [(ground 95) ?pri]
                      [(ground :seon.rule/nil) ?p1k]
                      [(ground :seon.rule/nil) ?p1v]
                      [(ground :seon.rule/nil) ?p2k]
                      [(ground :seon.rule/nil) ?p2v]
                      [(ground :seon.rule/nil) ?why])
                     (and
                      [$wm ?e :ctx/kind ?sk]
                      [$wm ?e :view/fn _]
                      [$wm ?e :ctx/source ?src]
                      [(contains? #{:pinned :eval} ?src)]
                      [(not= ?sk :seon.ctx/snapshot)]
                      [(not= ?sk :seon.task/lineage)]
                      [(ground :seon.rule/nil) ?zone]
                      [(ground :seon.rule/nil) ?layout]
                      [(ground :seon.rule/nil) ?pri]
                      [(ground :view.param/show-breadcrumbs?) ?p1k]
                      [(ground true) ?p1v]
                      [(ground :seon.rule/nil) ?p2k]
                      [(ground :seon.rule/nil) ?p2v]
                      [(ground :seon.rule/nil) ?why])
                     (and
                      [$wm ?e :ctx/kind :seon.code.var/entity]
                      [$wm ?e :ctx.match/via :search]
                      [$wm ?e :ctx.match/score ?s]
                      [(>= ?s 0.25)]
                      [$wm ?e :ctx/recency :recent]
                      [(ground :ephemeral-tail) ?zone]
                      [(ground :expanded-card) ?layout]
                      [(ground 91) ?pri]
                      [(ground :view.param/show-source?) ?p1k]
                      [(ground true) ?p1v]
                      [(ground :view.param/show-diff?) ?p2k]
                      [(ground true) ?p2v]
                      [(ground "Recently modified search hit") ?why])
                     (and
                      [$wm ?e :ctx/kind :seon.code.var/entity]
                      [$wm ?e :ctx/score ?s]
                      [(>= ?s 0.94)]
                      [(ground :seon.rule/nil) ?zone]
                      [(ground :expanded-card) ?layout]
                      [(ground 93) ?pri]
                      [(ground :view.param/show-source?) ?p1k]
                      [(ground true) ?p1v]
                      [(ground :view.param/show-callers?) ?p2k]
                      [(ground true) ?p2v]
                      [(ground :seon.rule/nil) ?why]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?e :view/zone ?zone]
                     [?e :view/layout ?layout]
                     [?e :view/priority ?pri]
                     [?e ?p1k ?p1v]
                     [?e ?p2k ?p2v]
                     [?e :ctx/why ?why]],
  :seon.rule/doc "Situational layout refinements: dedup lineage plan/templates, demote broad scope when target ns mentioned, enable breadcrumbs on pinned/eval, and promote recent search or high-score vars.",
  :seon.rule/stratum 52,
  :seon.rule/category :layout,
  :seon.rule/id :rule.layout/context-refinements}]
