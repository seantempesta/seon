                             :seon.error/source
                             :seon.error/message
                             :seon.error/status
                             :seon.error/agent
                             :seon.error/branch
                             :seon.error/var
                             :seon.error/data],
                      :zone :ephemeral-tail,
                      :priority 99,
                      :tx ?tx}
                     {:entity ?fix,
                      :parent ?err,
                      :fn seon.render/render-entity-value,
                      :pull [:seon.fix/id
