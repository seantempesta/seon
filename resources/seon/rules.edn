                             :seon.test/var
                             :seon.test/kind
                             :seon.test/pass?
                             :seon.test/report
                             :seon.test/ms],
                      :zone :ephemeral-tail,
                      :priority 97,
                      :rank/boost 0.2,
                      :params {:seon.ui/expand-section :report, :rank/boost 0.2},
                      :tx ?tx}
                     {:entity ?form,
                      :parent ?tv,
                      :fn seon.render/render-entity-value,
                      :pull [:seon.code.form/key :seon.code.form/src],
                      :zone :ephemeral-tail,
                      :priority 96,
                      :tx ?tx}],
  :seon.rule/doc "Project failing test verdicts (:seon.test/pass? false) linked via :seon.test/var-ref with report and test source.",
  :seon.rule/stratum 21,
  :seon.rule/category :context,
  :seon.rule/id :rule.ctx/failing-reach-tests}
 {:seon.rule/query [:find
                    ?s
                    ?tx
                    :in
                    $branch
                    ?agent
                    :where
                    [$branch ?ev :seon.agent.eval/agent ?agent ?tx]
                    (or-join
                     [?ev ?s]
                     [$branch ?ev :seon.agent.eval/result-schemas ?s]
                     (and
                      [$branch ?ev :seon.agent.eval/result-schema ?sk]
