                    [(>= ?t2 2)]
                    [(dec ?t2) ?t1]
                    [$branch ?ev2 :seon.agent.eval/agent ?agent]
                    [$branch ?ev2 :seon.agent.eval/turn ?t2]
                    [$branch ?ev2 :seon.agent.eval/error _ ?tx]
                    [$branch ?ev1 :seon.agent.eval/agent ?agent]
                    [$branch ?ev1 :seon.agent.eval/turn ?t1]
