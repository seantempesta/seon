 {:seon.rule/query [:find
                    ?agent
                    ?ag
                    ?n
                    ?tx
                    :in
                    $main
                    $branch
                    ?agent
                    :where
                    [$branch ?ag :seon.agent/id ?agent]
                    [(not= $main $branch)]
                    (not-join
                     [?agent]
                     [$main ?m :seon.agent.message/to ?agent]
                     [$main ?m :seon.agent.message/type :review-note])
                    [(seon.rule/edited-form-eids $main $branch) ?eds]
                    [(count ?eds) ?ec]
                    [(zero? ?ec)]
                    [(seon.store/config-val $main ?agent :seon.config/unwritten-review-turns) ?lim]
                    [(seon.rule/agent-eval-turn-count $branch ?agent) ?n]
                    [(>= ?n ?lim)]
                    [$branch ?ag :seon.agent/id ?agent ?tx]],
  :seon.rule/target :wire,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?agent :agent/needs-review :no-writes]],
  :seon.rule/doc "Pure Datalog stall detection: fires when distinct surviving eval turns on $branch reach :seon.config/unwritten-review-turns with zero edited forms vs $main; stops automatically once edits land or hunting evals are pruned.",
  :seon.rule/stratum 24,
  :seon.rule/category :diagnosis,
  :seon.rule/id :rule.ctx/unwritten-session-turns}
