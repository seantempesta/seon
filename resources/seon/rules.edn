;; Declarative Seon logic rules (resources/seon/rules.edn — loaded on fresh install, written back on green merge).
[{:seon.rule/id :rule.seed/agent-multi-tasks,
  :seon.rule/doc "Surface all tasks assigned to an agent via cardinality-many :seon.agent/tasks refs.",
  :seon.rule/category :seed,
  :seon.rule/stratum 10,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :rel/task ?t]
                     [?t :ctx/kind :seon.task/entity]
                     [?t :ctx/source :walk]
                     [?t :seon.task/id ?tid]
                     [?t :seon.task/title ?title]
                     [?t :seon.task/plan ?plan]
                     [?t :ctx/score 1.0]
                     [?t :ctx/why "Assigned agent task (:seon.agent/tasks ref)"]]}
 {:seon.rule/id :rule.seed/agent-scope,
  :seon.rule/doc "Connect viewer agent to its :seon.agent/scope namespace entity.",
  :seon.rule/category :seed,
  :seon.rule/stratum 10,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :rel/scope ?ns]
                     [?ns :ctx/kind :seon.code.ns/entity]
                     [?ns :ctx/source :walk]
                     [?ns :seon.code.ns/name ?sc]
                     [?ns :ctx/score 0.78]
                     [?ns :ctx/why "Agent namespace scope"]]}
 {:seon.rule/id :rule.seed/agent-task,
  :seon.rule/doc "Connect viewer agent to its assigned :seon.task/* entity (resolved branch-first, then :main).",
  :seon.rule/category :seed,
  :seon.rule/stratum 10,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :rel/task ?t]
                     [?t :ctx/kind :seon.task/entity]
                     [?t :ctx/source :walk]
                     [?t :seon.task/id ?tid]
                     [?t :seon.task/title ?title]
                     [?t :seon.task/plan ?plan]
                     [?t :seon.task/template? ?tpl]
                     [?t :ctx/score 1.0]
                     [?t :ctx/why "Assigned agent task"]]}
 {:seon.rule/id :rule.seed/child-agents,
  :seon.rule/doc "Surface non-archived direct child agents via reverse :seon.agent/parent lookup.",
  :seon.rule/category :seed,
  :seon.rule/stratum 10,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :rel/child-agent ?c]
                     [?c :ctx/kind :seon.agent/entity]
                     [?c :ctx/source :child]
                     [?c :seon.agent/id ?cid]
                     [?c :ctx/score 0.82]
                     [?c :ctx/why "Direct child sub-agent"]]}
 {:seon.rule/id :rule.seed/ctx-snapshot,
  :seon.rule/doc "Always surface the viewer agent's own @ctx snapshot tile.",
  :seon.rule/category :seed,
  :seon.rule/stratum 10,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[:ctx/self :ctx/kind :seon.ctx/snapshot]
                     [:ctx/self :ctx/source :ctx]
                     [:ctx/self :ctx/score 1.0]
                     [:ctx/self :ctx/why "Agent @ctx runtime snapshot"]]}
 {:seon.rule/id :rule.seed/extra-namespaces,
  :seon.rule/doc "Surface namespaces explicitly tuned via :seon.agent/context-prefs :extra-namespaces.",
  :seon.rule/category :seed,
  :seon.rule/stratum 10,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :rel/extra-ns ?ns]
                     [?ns :ctx/kind :seon.code.ns/entity]
                     [?ns :ctx/source :tuned]
                     [?ns :seon.code.ns/name ?nsym]
                     [?ns :ctx/score 0.88]
                     [?ns :ctx/why "Tuned extra namespace"]]}
 {:seon.rule/id :rule.seed/task-lineage,
  :seon.rule/doc "Attach derived task DAG lineage (parents, subtasks, history, fixes) for the viewer.",
  :seon.rule/category :seed,
  :seon.rule/stratum 10,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[:ctx/lineage :ctx/kind :seon.task/lineage]
                     [:ctx/lineage :ctx/source :walk]
                     [:ctx/lineage :ctx/score 0.92]
                     [:ctx/lineage :ctx/why "Task DAG lineage & historical context"]]}
 {:seon.rule/id :rule.error/surface-open-agent-error,
  :seon.rule/category :health,
  :seon.rule/stratum 15,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :rel/open-error ?err]
                     [?v :error/has-open-error? true]
                     [?err :ctx/kind :seon.error/entity]
                     [?err :ctx/source :rule]
                     [?err :seon.error/agent ?aid]
                     [?err :seon.error/kind ?kind]
                     [?err :seon.error/severity ?sev]
                     [?err :seon.error/message ?msg]
                     [?err :ctx/score 0.99]
                     [?err :view/tag :tag/open-error]
                     [?err :ctx/why ?why]]}
 {:seon.rule/id :rule.diag/collect-tree-discoveries,
  :seon.rule/doc "Collect vars, namespaces, and schemas discovered/curated across child and subtask agents in the tree.",
  :seon.rule/category :diagnosis,
  :seon.rule/stratum 20,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :ctx/need-effect {:op :collect/tree-discoveries, :agent ?aid, :task ?tid}]]}
 {:seon.rule/id :rule.diag/request-task-grounding,
  :seon.rule/doc "Request boundary entity grounding over task title & custom plan (stripping template boilerplate).",
  :seon.rule/category :diagnosis,
  :seon.rule/stratum 20,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?t :ctx/need-effect {:op :ground/task-text, :title ?title, :plan ?plan}]]}
 {:seon.rule/id :rule.gate/task-needs-open,
  :seon.rule/doc "Block task when any :seon.task/needs prerequisite is open.",
  :seon.rule/category :health,
  :seon.rule/stratum 20,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?t :gate/blocked? true]
                     [?t :gate/blocker {:task ?t, :reason :task-needs-open, :detail {:need ?need}}]]}
 {:seon.rule/id :rule.gate/test-failing,
  :seon.rule/doc "Block task when a required test var's latest digest failed.",
  :seon.rule/category :health,
  :seon.rule/stratum 20,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?t :gate/blocked? true]
                     [?t
                      :gate/blocker
                      {:task ?t,
                       :reason :test-failing,
                       :detail {:var ?sym, :digest ?dg, :report ?rep}}]]}
 {:seon.rule/id :rule.gate/test-missing,
  :seon.rule/doc "Block task when a required test var or verdict is missing.",
  :seon.rule/category :health,
  :seon.rule/stratum 20,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?t :gate/blocked? true]
                     [?t
                      :gate/blocker
                      {:task ?t, :reason :test-missing, :detail {:var ?sym, :cause ?cause}}]]}
 {:seon.rule/id :rule.diag/underspecified-task,
  :seon.rule/doc "Detect an underspecified task lacking tests, concrete ns/var mentions, and a detailed plan.",
  :seon.rule/category :diagnosis,
  :seon.rule/stratum 21,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?t :ctx/specificity :underspecified]
                     [?t :ctx/why "Underspecified task (missing tests & concrete symbols)"]]}
 {:seon.rule/id :rule.diag/search-on-underspecified,
  :seon.rule/doc "Trigger boundary relevance search (lexical today, :vectors embedding ready) when task is underspecified.",
  :seon.rule/category :diagnosis,
  :seon.rule/stratum 22,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?t :ctx/need-effect {:op :search/relevant, :query ?title, :k 6}]]}
 {:seon.rule/id :rule.error/rate-limit-backpressure,
  :seon.rule/category :health,
  :seon.rule/stratum 25,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?v :error/backpressure? true]
                     [?v :error/backpressure-kind :model/rate-limit]
                     [?v :error/backpressure-error ?err]
                     [?v :error/retry-after-ms ?retry-ms]
                     [?err :view/tag :tag/rate-limit-backpressure]
                     [?err :ctx/why "Model 429 backpressure active"]]}
 {:seon.rule/id :rule.expand/schema-renderer,
  :seon.rule/doc "When a task mentions a schema with :seon.schema/render, surface its renderer function so the agent sees the exact entity data shape.",
  :seon.rule/category :expand,
  :seon.rule/stratum 25,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?s :rel/schema-renderer ?rv]
                     [?rv :ctx/kind :seon.code.var/entity]
                     [?rv :ctx/source :rule]
                     [?rv :seon.code.var/name ?rfn]
                     [?rv :ctx/score 0.86]
                     [?rv :view/tag :tag/schema-renderer]
                     [?rv :ctx/why "Renderer for mentioned schema (shows entity data shape)"]]}
 {:seon.rule/id :rule.expand/scope-schema-consumer,
  :seon.rule/doc "When a task mentions a schema, surface an in-scope function whose :seon.code.var/keywords already read or write attributes in that schema's namespace.",
  :seon.rule/category :expand,
  :seon.rule/stratum 25,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?s :rel/scope-consumer ?var]
                     [?var :ctx/kind :seon.code.var/entity]
                     [?var :ctx/source :rule]
                     [?var :seon.code.var/name ?vsym]
                     [?var :ctx/score 0.87]
                     [?var :view/tag :tag/schema-consumer]
                     [?var :ctx/why "In-scope function already reading/writing this schema"]]}
 {:seon.rule/id :rule.expand/eval-schema-fn,
  :seon.rule/doc "When an eval returns an entity of schema ?sk, discover public non-test functions whose :malli/schema references ?sk (pure data-driven function discovery, zero tool tags).",
  :seon.rule/category :expand,
  :seon.rule/stratum 26,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :rel/eval-schema-fn ?fn]
                     [?fn :ctx/kind :seon.code.var/entity]
                     [?fn :ctx/source :rule]
                     [?fn :seon.code.var/name ?vsym]
                     [?fn :ctx/score 0.8]
                     [?fn :view/tag :tag/eval-schema-fn]
                     [?fn :ctx/why ?why]]}
 {:seon.rule/id :rule.expand/schema-contract-fn,
  :seon.rule/doc "Discover public functions whose :malli/schema inputs/outputs reference a task-relevant schema (pure data modeling, zero special tool tags).",
  :seon.rule/category :expand,
  :seon.rule/stratum 26,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?s :rel/schema-contract-fn ?fn]
                     [?fn :ctx/kind :seon.code.var/entity]
                     [?fn :ctx/source :rule]
                     [?fn :seon.code.var/name ?vsym]
                     [?fn :ctx/score 0.85]
                     [?fn :view/tag :tag/schema-contract-fn]
                     [?fn :ctx/why ?why]]}
 {:seon.rule/id :rule.expand/eval-schema-doc,
  :seon.rule/doc "When an eval returns an entity of schema ?sk, surface documentation sections referencing that schema entity.",
  :seon.rule/category :expand,
  :seon.rule/stratum 27,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :rel/eval-schema-doc ?d]
                     [?d :ctx/kind :seon.code.doc/entity]
                     [?d :ctx/source :rule]
                     [?d :seon.code.doc/id ?did]
                     [?d :ctx/score 0.77]
                     [?d :view/tag :tag/eval-doc-ref]
                     [?d :ctx/why ?why]]}
 {:seon.rule/id :rule.gate/agent-blocked,
  :seon.rule/doc "Block agent whenever any assigned task is blocked.",
  :seon.rule/category :health,
  :seon.rule/stratum 30,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?ag :gate/blocked? true] [?ag :gate/blocker ?b]]}
 {:seon.rule/id :rule.rank/curated-boost,
  :seon.rule/doc "Give top relevance to entities explicitly curated via (user/curate! ...) on agent or task.",
  :seon.rule/category :rank,
  :seon.rule/stratum 30,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :ctx/score 0.98]
                     [?e :ctx/source :curated]
                     [?e :ctx/why "Curated for task context"]]}
 {:seon.rule/id :rule.rank/mentioned-ns-boost,
  :seon.rule/doc "Promote namespaces explicitly named in the task's title or custom plan.",
  :seon.rule/category :rank,
  :seon.rule/stratum 30,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?ns :ctx/score 0.95]
                     [?ns :ctx/source :rule]
                     [?ns :ctx/why "Explicitly named in task"]]}
 {:seon.rule/id :rule.rank/mentioned-schema-boost,
  :seon.rule/doc "Promote Malli entity schemas whose domain matches the task (prevents attribute hallucination).",
  :seon.rule/category :rank,
  :seon.rule/stratum 30,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?sc :ctx/score 0.9]
                     [?sc :ctx/source :rule]
                     [?sc :ctx/why "Schema matched from task domain"]]}
 {:seon.rule/id :rule.rank/mentioned-var-boost,
  :seon.rule/doc "Promote vars explicitly named in the task's title or custom plan.",
  :seon.rule/category :rank,
  :seon.rule/stratum 30,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?ve :ctx/score 0.96]
                     [?ve :ctx/source :rule]
                     [?ve :ctx/why "Explicitly named in task"]]}
 {:seon.rule/id :rule.rank/tag-recent-entity,
  :seon.rule/doc "Tag entities modified after initial store bootstrap (no volatile :env/max-tx).",
  :seon.rule/category :rank,
  :seon.rule/stratum 30,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :ctx/recency :recent] [?e :ctx/why "Modified recently"]]}
 {:seon.rule/id :rule.rank/tree-overlap-boost,
  :seon.rule/doc "Compute multi-agent discovery overlap across the delegation tree; >= 2 agents strongly promotes entity.",
  :seon.rule/category :rank,
  :seon.rule/stratum 30,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :ctx/tree-count ?n]
                     [?e :ctx/score 0.94]
                     [?e :ctx/source :tree]
                     [?e :ctx/why "Multi-agent tree overlap"]]}
 {:seon.rule/id :rule.expand/covering-tests-for-hot-var,
  :seon.rule/doc "Automatically surface covering deftest vars referencing any high-relevance target var.",
  :seon.rule/category :expand,
  :seon.rule/stratum 32,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?te :ctx/kind :seon.code.var/entity]
                     [?te :seon.code.var/name ?tsym]
                     [?te :ctx/source :rule]
                     [?te :ctx/score 0.82]
                     [?te :ctx/why ?why]]}
 {:seon.rule/id :rule.expand/doc-by-ref,
  :seon.rule/doc "Surface doc sections linking via :seon.code.doc/references to active entities.",
  :seon.rule/category :expand,
  :seon.rule/stratum 32,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :rel/cited-by-doc ?d]
                     [?d :ctx/kind :seon.code.doc/entity]
                     [?d :ctx/source :rule]
                     [?d :seon.code.doc/id ?did]
                     [?d :ctx/score 0.8]
                     [?d :view/tag :tag/doc-ref]
                     [?d :ctx/why "Cited by doc"]]}
 {:seon.rule/id :rule.expand/direct-callee-fn,
  :seon.rule/doc "Follow compiler-analyzed :seon.code.var/calls true refs from hot vars to pull in direct public callees.",
  :seon.rule/category :expand,
  :seon.rule/stratum 33,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?ve :rel/callee ?ce]
                     [?ce :ctx/kind :seon.code.var/entity]
                     [?ce :ctx/source :rule]
                     [?ce :seon.code.var/name ?csym]
                     [?ce :ctx/score 0.78]
                     [?ce :view/tag :tag/callee]
                     [?ce :ctx/why "Direct callee via :seon.code.var/calls"]]}
 {:seon.rule/id :rule.preview/nested-sub-schema,
  :seon.rule/doc "Map depth to sub-schema renderer layout (:expanded-card -> :compact-row -> :ref-pill) and priority key order.",
  :seon.rule/category :present,
  :seon.rule/stratum 34,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?p :policy/depth-0-layout :expanded-card]
                     [?p :policy/depth-1-layout :compact-row]
                     [?p :policy/deep-layout :ref-pill]
                     [?p :policy/max-depth 2]
                     [?p :policy/priority-keys [:error :status :title :ok?]]]}
 {:seon.rule/id :rule.preview/errors-by-kind,
  :seon.rule/doc "Group large (> 10) :seon.error/entity collections by :seon.error/kind and surface the newest 5 items.",
  :seon.rule/category :present,
  :seon.rule/stratum 35,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?p :policy/errors-by-kind? true]
                     [?p :policy/errors-threshold 10]
                     [?p :policy/errors-newest 5]]}
 {:seon.rule/id :rule.tags/tag-mentioned,
  :seon.rule/doc "Tag namespaces explicitly named in the task with :tag/mentioned.",
  :seon.rule/category :rank,
  :seon.rule/stratum 35,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?ns :view/tag :tag/mentioned]]}
 {:seon.rule/id :rule.tags/tag-modifiers,
  :seon.rule/doc "Apply composable modifier tag :tag/recent onto recent entities.",
  :seon.rule/category :rank,
  :seon.rule/stratum 35,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :view/tag :tag/recent]]}
 {:seon.rule/id :rule.tags/tag-tree-overlap,
  :seon.rule/doc "Tag any entity discovered by >= 2 agents in the delegation tree with :tag/tree-overlap.",
  :seon.rule/category :rank,
  :seon.rule/stratum 35,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :view/tag :tag/tree-overlap]]}
 {:seon.rule/id :rule.preview/large-collection,
  :seon.rule/doc "Force bounded smart preview + expand hint whenever a collection exceeds 20 items.",
  :seon.rule/category :present,
  :seon.rule/stratum 36,
  :seon.rule/enabled? true,
  :seon.rule/target :any,
  :seon.rule/assert [[?e :view/tag :tag/preview-sliced]
