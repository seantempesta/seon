;; Declarative Seon logic rules (resources/seon/rules.edn — loaded on fresh install, written back on green merge).
[{:seon.rule/query [:find
                    ?v
                    ?t
                    ?tid
                    ?title
                    ?plan
                    ?tpl
                    :in
                    $main
                    $task
                    $wm
                    :where
                    [$wm ?v :ctx/viewer ?aid]
                    (or-join
                     [?v ?aid ?t ?tid]
                     (and [$wm ?v :ctx/task-id ?tid] [$task ?t :seon.task/id ?tid])
                     (and
                      [$main ?ag :seon.agent/id ?aid]
                      [$main ?ag :seon.agent/tasks ?t]
                      [$task ?t :seon.task/id ?tid]))
                    [(get-else $task ?t :seon.task/title :seon.rule/nil) ?title]
                    [(get-else $task ?t :seon.task/plan :seon.rule/nil) ?plan]
                    [(get-else $task ?t :seon.task/template? :seon.rule/nil) ?tpl]],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?v :rel/task ?t]
                     [?t :ctx/kind :seon.task/entity]
                     [?t :ctx/source :walk]
                     [?t :seon.task/id ?tid]
                     [?t :seon.task/title ?title]
                     [?t :seon.task/plan ?plan]
                     [?t :seon.task/template? ?tpl]
                     [?t :ctx/score 1.0]
                     [?t :ctx/why "Assigned agent task"]],
  :seon.rule/doc "Connect viewer agent to its assigned :seon.agent/task and cardinality-many :seon.agent/tasks refs.",
  :seon.rule/stratum 10,
  :seon.rule/category :seed,
  :seon.rule/id :rule.seed/agent-tasks}
 {:seon.rule/query [:find
                    ?v
                    ?e
                    ?kind
                    ?src
                    ?score
                    ?why
                    ?rel
                    ?attr
                    ?val
                    :in
                    $main
                    $code
                    $wm
                    :where
                    [$wm ?v :ctx/viewer ?aid]
                    (or-join
                     [?v ?aid ?e ?kind ?src ?score ?why ?rel ?attr ?val]
                     (and
                      [(ground :ctx/self) ?e]
                      [(ground :seon.ctx/snapshot) ?kind]
                      [(ground :ctx) ?src]
                      [(ground 1.0) ?score]
                      [(ground "Agent @ctx runtime snapshot") ?why]
                      [(ground :seon.rule/nil) ?rel]
                      [(ground :seon.rule/nil) ?attr]
                      [(ground :seon.rule/nil) ?val])
                     (and
                      [$wm ?v :ctx/has-lineage? true]
                      [(ground :ctx/lineage) ?e]
                      [(ground :seon.task/lineage) ?kind]
                      [(ground :walk) ?src]
                      [(ground 0.92) ?score]
                      [(ground "Task DAG lineage & historical context") ?why]
                      [(ground :seon.rule/nil) ?rel]
                      [(ground :seon.rule/nil) ?attr]
                      [(ground :seon.rule/nil) ?val])
                     (and
                      [$wm ?v :ctx/scope ?val]
                      [$code ?e :seon.code.ns/name ?val]
                      [(ground :seon.code.ns/entity) ?kind]
                      [(ground :walk) ?src]
                      [(ground 0.78) ?score]
                      [(ground "Agent namespace scope") ?why]
                      [(ground :rel/scope) ?rel]
                      [(ground :seon.code.ns/name) ?attr])
                     (and
                      [$wm ?v :ctx/extra-ns ?val]
                      [$code ?e :seon.code.ns/name ?val]
                      [(ground :seon.code.ns/entity) ?kind]
                      [(ground :tuned) ?src]
                      [(ground 0.88) ?score]
                      [(ground "Tuned extra namespace") ?why]
                      [(ground :rel/extra-ns) ?rel]
                      [(ground :seon.code.ns/name) ?attr])
                     (and
                      [$wm ?v :ctx/include-children? true]
                      [$main ?e :seon.agent/parent ?aid]
                      [$main ?e :seon.agent/id ?val]
                      (not [$main ?e :seon.agent/archived? true])
                      [(ground :seon.agent/entity) ?kind]
                      [(ground :child) ?src]
                      [(ground 0.82) ?score]
                      [(ground "Direct child sub-agent") ?why]
                      [(ground :rel/child-agent) ?rel]
                      [(ground :seon.agent/id) ?attr]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?v ?rel ?e]
                     [?e :ctx/kind ?kind]
                     [?e :ctx/source ?src]
                     [?e ?attr ?val]
                     [?e :ctx/score ?score]
                     [?e :ctx/why ?why]],
  :seon.rule/doc "Seed viewer @ctx snapshot, task DAG lineage, scope/extra namespaces, and active direct child agents.",
  :seon.rule/stratum 10,
  :seon.rule/category :seed,
  :seon.rule/id :rule.seed/agent-world}
 {:seon.rule/query [:find
                    ?err
                    ?fix
                    ?tx
                    :in
                    $main
                    $branch
                    ?agent
                    :where
                    (or-join
                     [?err ?kind ?tx]
                     (and
                      [$main ?err :seon.error/status :open ?tx]
                      [$main ?err :seon.error/agent ?agent]
                      [$main ?err :seon.error/kind ?kind])
                     (and
                      [$branch ?err :seon.error/status :open ?tx]
                      [$branch ?err :seon.error/agent ?agent]
                      [$branch ?err :seon.error/kind ?kind]))
                    (or-join
                     [?kind ?fix]
                     [$main ?fix :seon.fix/error-class ?kind]
                     [$branch ?fix :seon.fix/error-class ?kind]
                     (and
                      (not-join [?kind] [$main ?f1 :seon.fix/error-class ?kind])
                      (not-join [?kind] [$branch ?f2 :seon.fix/error-class ?kind])
                      [(ground :seon.rule/nil) ?fix]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [{:entity ?err,
                      :fn seon.error/render,
                      :pull [:seon.error/id
                             :seon.error/kind
                             :seon.error/severity
                             :seon.error/source
                             :seon.error/message
                             :seon.error/status
                             :seon.error/agent
                             :seon.error/branch
                             :seon.error/var
                             :seon.error/data],
                      :zone :ephemeral-tail,
                      :priority 99,
                      :rank/boost 0.25,
                      :params {:seon.ui/expand-section :fix, :rank/boost 0.25},
                      :tx ?tx}
                     {:entity ?fix,
                      :parent ?err,
                      :fn seon.render/render-entity-value,
                      :pull [:seon.fix/id
                             :seon.fix/error-class
                             :seon.fix/symptom
                             :seon.fix/root-cause
                             :seon.fix/change-summary
                             :seon.fix/regression-test
                             :seon.fix/before-after],
                      :zone :ephemeral-tail,
                      :priority 98,
                      :tx ?tx}],
  :seon.rule/doc "Surface open :seon.error/* entities linked to the agent plus matching :seon.fix/* recommended fixes nested under :parent ?err.",
  :seon.rule/stratum 15,
  :seon.rule/category :context,
  :seon.rule/id :rule.ctx/fault-with-recommended-fix}
 {:seon.rule/query [:find
                    ?v
                    ?err
                    ?aid
                    ?kind
                    ?sev
                    ?msg
                    ?why
                    :in
                    $main
                    $wm
                    :where
                    [$wm ?v :ctx/viewer ?aid]
                    [$main ?err :seon.error/status :open]
                    [$main ?err :seon.error/agent ?aid]
                    [$main ?err :seon.error/kind ?kind]
                    [$main ?err :seon.error/severity ?sev]
                    [$main ?err :seon.error/message ?msg]
                    [(str "Open error on " ?aid ": " ?kind) ?why]],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?v :rel/open-error ?err]
                     [?v :error/has-open-error? true]
                     [?err :ctx/kind :seon.error/entity]
                     [?err :ctx/source :rule]
                     [?err :seon.error/agent ?aid]
                     [?err :seon.error/kind ?kind]
                     [?err :seon.error/severity ?sev]
                     [?err :seon.error/message ?msg]
                     [?err :ctx/score 0.99]
                     [?err :view/tag :tag/open-error]
                     [?err :ctx/why ?why]],
  :seon.rule/stratum 15,
  :seon.rule/category :health,
  :seon.rule/id :rule.error/surface-open-agent-error}
 {:seon.rule/query [:find
                    ?t
                    ?prereq
                    ?tx
                    :in
                    $
                    $main
                    $branch
                    ?agent
                    %
                    :where
                    (or-join
                     [?agent ?t ?tx]
                     (and
                      [$branch ?ag :seon.agent/id ?agent]
                      [$branch ?ag :seon.agent/task ?tid]
                      [$branch ?t :seon.task/id ?tid ?tx])
                     (and
                      [$main ?ag :seon.agent/id ?agent]
                      [$main ?ag :seon.agent/task ?tid]
                      [$main ?t :seon.task/id ?tid ?tx])
                     (and
                      [$branch ?ag :seon.agent/id ?agent]
                      [$branch ?ag :seon.agent/tasks ?t ?tx])
                     (and [$main ?ag :seon.agent/id ?agent] [$main ?ag :seon.agent/tasks ?t ?tx]))
                    (or-join
                     [?t ?prereq]
                     (needs* ?t ?prereq)
                     (and (not-join [?t] (needs* ?t ?p2)) [(ground :seon.rule/nil) ?prereq]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?t :ctx/touched-entity true]
                     {:entity ?t,
                      :fn seon.render.tiles/task-tile,
                      :pull [:seon.task/id
                             :seon.task/title
                             :seon.task/scope
                             :seon.task/plan
                             :seon.task/done?
                             :seon.task/needs
                             :seon.task/tests
                             :seon.task/summary],
                      :zone :static-prefix,
                      :priority 96,
                      :tx ?tx}
                     {:entity ?prereq,
                      :parent ?t,
                      :fn seon.render.tiles/task-tile,
                      :pull [:seon.task/id :seon.task/title :seon.task/done? :seon.task/summary],
                      :zone :static-prefix,
                      :priority 88,
                      :tx ?tx}],
  :seon.rule/doc "Project the agent's active task(s) and transitive :seon.task/needs prerequisites via recursive needs* rule.",
  :seon.rule/stratum 16,
  :seon.rule/category :context,
  :seon.rule/id :rule.ctx/active-task-and-lineage}
 {:seon.rule/query [:find
                    ?e
                    ?tx
                    :in
                    $wm
                    :where
                    [$wm ?e :world/connected true]
                    (or-join
                     [?e ?tx]
                     [$wm ?e :world/tx ?tx]
                     (and (not [$wm ?e :world/tx _]) [(ground 0) ?tx]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?e :ctx/touched-entity true]
                     {:entity ?e,
                      :fn seon.render/render-entity-value,
                      :pull [*],
                      :zone :static-prefix,
                      :priority 92,
                      :tx ?tx}],
  :seon.rule/doc "Project all entities pinned or attached to the agent via generic 2-read :eavt / :seon.schema/ref-targets discovery.",
  :seon.rule/stratum 18,
  :seon.rule/category :context,
  :seon.rule/id :rule.ctx/pinned-entities}
 {:seon.rule/query [:find
                    ?e
                    ?pri
                    ?tx
                    :in
                    $main
                    ?agent
                    :where
                    [$main ?sys :seon.system/id ?agent]
                    (or-join
                     [?e ?pri ?tx]
                     (and [$main ?e :seon.error/status :open ?tx] [(ground 98) ?pri])
                     (and
                      [$main ?e :seon.task/done? false ?tx]
                      (not [$main ?e :seon.task/template? true])
                      [(ground 88) ?pri])
                     (and
                      [$main ?e :seon.agent/id ?aid ?tx]
                      (not [$main ?e :seon.agent/archived? true])
                      (not [$main ?e :seon.agent/role :repl])
                      [(ground 90) ?pri]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [{:entity ?e, :zone :workspace, :priority ?pri, :tx ?tx}],
  :seon.rule/doc "When focused on [:seon.system/id :root], surface active agents, open tasks, and open errors.",
  :seon.rule/stratum 18,
  :seon.rule/category :context,
  :seon.rule/id :rule.ctx/system-overview}
 {:seon.rule/query [:find
                    ?ev
                    ?pull
                    ?zone
                    ?pri
                    ?tx
                    :in
                    $branch
                    ?agent
                    :where
                    [$branch ?ev :seon.agent.eval/agent ?agent ?tx]
                    [$branch ?ev :seon.agent.eval/turn ?turn]
                    (or-join
                     [?agent ?turn ?pull ?zone ?pri]
                     (and
                      (not-join
                       [?agent ?turn]
                       [$branch ?ev2 :seon.agent.eval/agent ?agent]
                       [$branch ?ev2 :seon.agent.eval/turn ?t2]
                       [(+ ?turn 2) ?lim]
                       [(> ?t2 ?lim)])
                      [(ground
                        [:seon.agent.eval/handle
                         :seon.agent.eval/turn
                         :seon.agent.eval/code
                         :seon.agent.eval/value
                         :seon.agent.eval/error
                         :seon.agent.eval/result-schema
                         :seon.agent.eval/ms])
                       ?pull]
                      [(ground :ephemeral-tail) ?zone]
                      [(ground 90) ?pri])
                     (and
                      [$branch ?ev2 :seon.agent.eval/agent ?agent]
                      [$branch ?ev2 :seon.agent.eval/turn ?t2]
                      [(+ ?turn 2) ?lim]
                      [(> ?t2 ?lim)]
                      [(ground
                        [:seon.agent.eval/handle
                         :seon.agent.eval/turn
                         :seon.agent.eval/intent
                         :seon.agent.eval/result-schema])
                       ?pull]
                      [(ground :workspace) ?zone]
                      [(ground 55) ?pri]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [{:entity ?ev,
                      :fn seon.render/render-entity-value,
                      :pull ?pull,
                      :zone ?zone,
                      :priority ?pri,
                      :tx ?tx}],
  :seon.rule/doc "Project recent eval results in full and older evals as 1-line handle signposts using native Datahike ?tx / :turn.",
  :seon.rule/stratum 19,
  :seon.rule/category :context,
  :seon.rule/id :rule.ctx/recent-eval-results}
 {:seon.rule/query [:find
                    ?v
                    ?form
                    ?tx
                    :in
                    $main
                    $branch
                    :where
                    [(seon.rule/edited-form-eids $main $branch) [?form ...]]
                    [$branch ?form :seon.code.form/key ?fk]
                    [$branch ?form :seon.code.form/hash _ ?tx]
                    [$branch ?v :seon.code.var/form ?fk]],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?v :ctx.branch/edited? true]
                     [?v :ctx/touched-entity true]
                     {:entity ?v,
                      :fn seon.render.tiles/var-tile,
                      :pull [:seon.code.var/name
                             :seon.code.var/ns
                             :seon.code.var/doc
                             :seon.code.var/arglists
                             :seon.code.var/schema
                             {:seon.code.var/calls [:seon.code.var/name]}],
                      :zone :workspace,
                      :priority 95,
                      :rank/boost 0.15,
                      :params {:show-source? true, :seon.ui/show-callers? true, :rank/boost 0.15},
                      :tx ?tx}
                     {:entity ?form,
                      :parent ?v,
                      :fn seon.render/render-entity-value,
                      :pull [:seon.code.form/key :seon.code.form/src :seon.code.form/hash],
                      :zone :workspace,
                      :priority 94,
                      :tx ?tx}],
  :seon.rule/doc "Surface vars modified on branch vs main with full :form/src, :schema, and :calls.",
  :seon.rule/stratum 20,
  :seon.rule/category :context,
  :seon.rule/id :rule.ctx/edited-var-on-branch}
 {:seon.rule/query [:find
                    ?src
                    ?op
                    ?title
                    ?plan
                    ?aid
                    ?tid
                    ?q
                    ?k
                    ?spec
                    ?why
                    :in
                    $task
                    $wm
                    :where
                    (or-join
                     [?src ?op ?title ?plan ?aid ?tid ?q ?k ?spec ?why]
                     (and
                      [$wm _ :rel/task ?src]
                      [$wm ?src :seon.task/title ?title]
                      (not [$wm ?src :seon.task/template? true])
                      (not [$wm ?src :ctx/grounded? true])
                      (or-join
                       [?src ?plan]
                       [$wm ?src :seon.task/plan ?plan]
                       (and (not [$wm ?src :seon.task/plan _]) [(ground :seon.rule/nil) ?plan]))
                      [(ground :ground/task-text) ?op]
                      [(ground :seon.rule/nil) ?aid]
                      [(ground :seon.rule/nil) ?tid]
                      [(ground :seon.rule/nil) ?q]
                      [(ground :seon.rule/nil) ?k]
                      [(ground :seon.rule/nil) ?spec]
                      [(ground :seon.rule/nil) ?why])
                     (and
                      [$wm ?src :ctx/viewer ?aid]
                      [$wm ?src :ctx/has-tree-peers? true]
                      (not [$wm ?src :ctx/tree-collected? true])
                      (or-join
                       [?src ?tid]
                       [$wm ?src :ctx/task-id ?tid]
                       (and (not [$wm ?src :ctx/task-id _]) [(ground :seon.rule/nil) ?tid]))
                      [(ground :collect/tree-discoveries) ?op]
                      [(ground :seon.rule/nil) ?title]
                      [(ground :seon.rule/nil) ?plan]
                      [(ground :seon.rule/nil) ?q]
                      [(ground :seon.rule/nil) ?k]
                      [(ground :seon.rule/nil) ?spec]
                      [(ground :seon.rule/nil) ?why])
                     (and
                      [$wm _ :rel/task ?src]
                      [$wm ?src :ctx/grounded? true]
                      [$wm ?src :seon.task/title ?q]
                      [$wm ?src :ctx/custom-plan-len ?plen]
                      [(< ?plen 80)]
                      (not [$wm ?src :seon.task/template? true])
                      (not [$wm ?src :ctx/searched? true])
                      (not [$task ?src :seon.task/tests _])
                      (not [$wm ?src :rel/mentions-ns _])
                      (not [$wm ?src :rel/mentions-var _])
                      [(ground :search/relevant) ?op]
                      [(ground 6) ?k]
                      [(ground :underspecified) ?spec]
                      [(ground "Underspecified task (missing tests & concrete symbols)") ?why]
                      [(ground :seon.rule/nil) ?title]
                      [(ground :seon.rule/nil) ?plan]
                      [(ground :seon.rule/nil) ?aid]
                      [(ground :seon.rule/nil) ?tid]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?src
                      :ctx/need-effect
                      {:op ?op,
                       :title ?title,
                       :plan ?plan,
                       :agent ?aid,
                       :task ?tid,
                       :query ?q,
                       :k ?k}]
                     [?src :ctx/specificity ?spec]
                     [?src :ctx/why ?why]],
  :seon.rule/doc "Request boundary effects for task grounding, delegation-tree discovery collection, and relevance search on underspecified tasks.",
  :seon.rule/stratum 20,
  :seon.rule/category :diagnosis,
  :seon.rule/id :rule.diag/request-effects}
 {:seon.rule/query [:find
                    ?t
                    ?need
                    :in
                    $wm
                    :where
                    [$wm ?t :gate/needs ?need]
                    (not [$wm ?need :gate/task-done? true])],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?t :gate/blocked? true]
                     [?t :gate/blocker {:task ?t, :reason :task-needs-open, :detail {:need ?need}}]],
  :seon.rule/doc "Block task when any :seon.task/needs prerequisite is open.",
  :seon.rule/stratum 20,
  :seon.rule/category :health,
  :seon.rule/id :rule.gate/task-needs-open}
 {:seon.rule/query [:find
                    ?t
                    ?sym
                    ?dg
                    ?rep
                    :in
                    $wm
                    :where
                    [$wm ?t :gate/requires-test ?sym]
                    [$wm ?sym :gate/var-exists? true]
                    [$wm ?sym :gate/latest-pass? false]
                    (or-join
                     [?sym ?dg]
                     [$wm ?sym :gate/latest-digest ?dg]
                     (and (not [$wm ?sym :gate/latest-digest _]) [(ground :seon.rule/nil) ?dg]))
                    (or-join
                     [?sym ?rep]
                     [$wm ?sym :gate/latest-report ?rep]
                     (and (not [$wm ?sym :gate/latest-report _]) [(ground :seon.rule/nil) ?rep]))],
  :seon.rule/target :any,
  :seon.rule/enabled? true,
  :seon.rule/assert [[?t :gate/blocked? true]
                     [?t
                      :gate/blocker
                      {:task ?t,
                       :reason :test-failing,
                       :detail {:var ?sym, :digest ?dg, :report ?rep}}]],
  :seon.rule/doc "Block task when a required test var's latest digest failed.",
  :seon.rule/stratum 20,
  :seon.rule/category :health,
  :seon.rule/id :rule.gate/test-failing}
 {:seon.rule/query [:find
                    ?t
                    ?sym
                    ?cause
                    :in
                    $wm
                    :where
                    [$wm ?t :gate/requires-test ?sym]
                    (or-join
                     [?sym ?cause]
                     (and (not [$wm ?sym :gate/var-exists? true]) [(ground :var-missing) ?cause])
                     (and
                      [$wm ?sym :gate/var-exists? true]
                      (not [$wm ?sym :gate/latest-pass? _])
