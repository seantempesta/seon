{
;; ===========================================================================
;; ADMIT
;; ===========================================================================
; The output caps. Every one is a registered DIAL — a config fact the
 ; caller reads from the database and passes in; never a literal in code.
 ; Wiring them into :seon.config/manifest + config/default.edn is a
 ; seal-side edit named in the draft report.
 :seon.config.eval.result/max-collection [:int {:min 1}]
 :seon.config.eval.result/max-depth [:int {:min 1}]
 :seon.config.eval.result/max-nodes [:int {:min 1}]
 :seon.config.eval.result/max-string [:int {:min 1}]

 ; The recorded diagnostics. NEVER limits (the vocabulary table's word):
 ; 271M fn-entries in 500 ms reads as a spin, 12 reads as blocked in a
 ; host call. First registered here because admission is the fresh tree's
 ; first producer; the seon.sci.interrupt adoption REFERENCES these keys
 ; and must not re-declare them (the loader refuses duplicates by design).
 :seon.eval/allocated-bytes :int
 :seon.eval/duration-ms :int
 :seon.eval/fn-entries :int
 :seon.eval/host-interop-count [:int {:min 0}]
 :seon.eval/outcome [:enum :ok :time :error]

 :seon.sci.admit/caps [:map {:closed true} [:seon.config.eval.result/max-depth :seon.config.eval.result/max-depth] [:seon.config.eval.result/max-collection :seon.config.eval.result/max-collection] [:seon.config.eval.result/max-string :seon.config.eval.result/max-string] [:seon.config.eval.result/max-nodes :seon.config.eval.result/max-nodes]]
 :seon.sci.admit/capped? :boolean
 :seon.sci.admit/interrupt-fn [:fn {:gen/gen seon.sci.admit/interrupt-fn-generator} seon.sci.admit/interrupt-fn?]
 :seon.sci.admit/record [:map {:closed true} [:seon.eval/fn-entries :seon.eval/fn-entries] [:seon.eval/host-interop-count :seon.eval/host-interop-count] [:seon.eval/duration-ms :seon.eval/duration-ms] [:seon.eval/allocated-bytes :seon.eval/allocated-bytes] [:seon.eval/outcome :seon.eval/outcome]]
 ; :any twice, both at the one genuine third-party boundary: IN, whatever
 ; object a sci evaluation produced; OUT, the projection, whose grammar is
 ; the admit docstring's and is deliberately NOT a second predicate
 ; (n3-plan §6.1: ordinary-wire-value? collapses into this operation).
 ; The dial rides IN the request (owner ruling, 2026-07-27, reversing
 ; the drafted marker-only taste call): a projection failure is a core
 ; degradation, so R41 decides it — :panic throws hard and loud in
 ; development, :record degrades reasonably in production. It is a
 ; required key because a caller that has not decided has not thought
 ; about it.
 ; The DIAGNOSTICS are optional (seal revision, 2026-07-27): they are
 ; eval-shaped, and admission now has a caller that is not an eval —
 ; `seon.error/normalize` projects an arbitrary error source through
 ; this same one codec, and fabricating a zeroed `fn-entries` /
 ; `duration-ms` / `allocated-bytes` record for it would be inventing
 ; measurements nobody took. Absent in, absent out: admission carries
 ; the record through untouched, and an absent record stays absent
 ; rather than becoming a stored nil.
 :seon.sci.admit/request [:map {:closed true} [:seon.sci.admit/value :any] [:seon.sci.admit/interrupt-fn :seon.sci.admit/interrupt-fn] [:seon.sci.admit/caps :seon.sci.admit/caps] [:seon.config/on-core-error :seon.config/on-core-error] [:seon.sci.admit/record {:optional true} :seon.sci.admit/record]]
 :seon.sci.admit/admitted [:map {:closed true} [:seon.sci.admit/value :any] [:seon.cluster.eval/result-edn :seon.cluster.eval/result-edn] [:seon.sci.admit/capped? :seon.sci.admit/capped?] [:seon.sci.admit/record {:optional true} :seon.sci.admit/record]]
 :seon.sci.admit/value :any

;; ===========================================================================
;; AGENT
;; ===========================================================================
; An agent's current namespace is a connection to the canonical
 ; `:seon.ns` entity. Cardinality one means an agent has at most one;
 ; unique-value means a namespace has at most one agent. Reassignment
 ; is an ordinary cardinality-one transact, never a second identity.
 :seon.cluster.agent/namespace
 [:and {:seon.db/unique true} :seon.db/ref]

 ; Every agent is its own entity and points to its branch's cluster entity.
 ; Cluster-global facts never move onto the agent; per-agent instructions are
 ; an additive connection whose ordinary empty state is absence.
 :seon.cluster.agent/cluster :seon.db/ref

 :seon.cluster.agent/context-links
 [:map {:seon.db/entity true}
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.cluster.agent/cluster :seon.cluster.agent/cluster]
  [:seon.cluster.agent/instructions
   {:optional true}
   :seon.cluster.agent/instructions]]

 ; The one formal creation shape. It creates the namespace row and the
 ; agent row in one transaction so a newly created agent is never
 ; ownerless at any committed basis.
 :seon.cluster.agent/creation-request
 [:map {:closed true}
 [:seon.cluster.agent/id :seon.cluster.agent/id]
 [:seon.ns/name :seon.ns/name]
  [:seon.cluster/name :seon.cluster/name]]

 ; Pure transaction data is heterogeneous Datahike input by definition.
 :seon.cluster.agent/creation-tx [:vector :map]

 ; THE ONE BLUEPRINT'S REQUEST: a pure function of (agent-id, handle).
 ; Two agents differ only in the agent-id their procs carry and the
 ; mailbox channel routed to them — there is no per-agent variation.
 :seon.cluster.agent/blueprint-request [:map {:closed true} [:seon.cluster.loop/cluster :seon.cluster.loop/cluster] [:seon.cluster.agent/id :seon.cluster.agent/id]]

 ; THE ROUTING ENTRY: process-local map atom held on the cluster
 ; instance beside the connection — the sanctioned kind of process
 ; state (a disposable artifact, rebuilt by arming at boot). It is not
 ; a fact: it names live channels. ::armed is keyed by agent id;
 ; ::channels by the recipient's ENTITY id, because that is what a
 ; committed `:seon.cluster.message/to` datom carries, so the wake
 ; handler's delivery is one map lookup — no query, no park.
 :seon.cluster.agent/routing [:fn {:gen/gen seon.flow/atom-reference-generator} seon.flow/atom-reference?]

 :seon.cluster.agent/arm-request [:map {:closed true} [:seon.cluster.loop/cluster :seon.cluster.loop/cluster] [:seon.cluster.agent/id :seon.cluster.agent/id] [:seon.cluster.agent/routing :seon.cluster.agent/routing]]

 :seon.cluster.agent/disarm-request [:map {:closed true} [:seon.cluster.agent/id :seon.cluster.agent/id] [:seon.cluster.agent/routing :seon.cluster.agent/routing]]

 ; One armed agent's process-local entry: its graph, its mailbox, the
 ; orderly-stop completion, and the entity id its routing rides on.
 :seon.cluster.agent/armed [:map {:closed true} [:seon.cluster.agent/id :seon.cluster.agent/id] [:seon.cluster.agent/eid :int] [:seon.flow/graph :seon.flow/graph] [:seon.cluster.wake/channel :seon.flow/channel] [:seon.cluster.loop/completion :seon.flow/channel]]

 :seon.cluster.agent/eid :int

;; ===========================================================================
;; AI
;; ===========================================================================
; ONE PROVIDER, ONE ATTEMPT, ONE DEADLINE. Authentication is exactly
 ; one of two explicit shapes: the NAME of the environment variable
 ; holding the credential, or the literal no-auth fact. The credential
 ; itself is read at the leaf and never becomes a datom.
 :seon.ai/api-key-variable [:string {:min 1}]
 ; Literal true rather than boolean: false would be a second spelling
 ; for the authenticated shape. The target/request unions below make
 ; both and neither unrepresentable.
 :seon.config.ai/no-auth
 [:= {:seon.config/optional true :seon.config/per-agent true} true]
 :seon.ai/endpoint [:string {:min 1}]
 :seon.ai/model [:string {:min 1}]
 ; One value makes contradictory toggle/effort pairs unrepresentable.
 ; Absence leaves the provider default untouched; :disabled sends an
 ; explicit off switch; every other value sends enabled + that effort.
 :seon.ai/thinking [:enum :disabled :low :high :max]
 :seon.ai/temperature :seon.config.ai/temperature
 :seon.ai/top-p :seon.config.ai/top-p
 :seon.ai/frequency-penalty :seon.config.ai/frequency-penalty
 :seon.ai/presence-penalty :seon.config.ai/presence-penalty
 :seon.ai/stop :seon.config.ai/stop
 :seon.ai/response-format :seon.config.ai/response-format
 :seon.ai/extra-body-edn :seon.config.ai/extra-body-edn
 ; The provider's output budget. This bounds reasoning and visible
 ; completion together on the OpenAI-compatible wire; keeping thinking
 ; enabled is safe only when the request carries this positive cap.
 :seon.ai/max-tokens [:int {:min 1}]
 :seon.ai/prompt [:string {:min 1}]
 :seon.ai/system [:string {:min 1}]
 ; The one legitimate deadline in the rung: a remote HTTP call is
 ; genuinely unobservable external state. Its firing is an ordinary
 ; error value, never a bug report.
 :seon.ai/timeout-ms [:int {:min 1}]
 :seon.ai/text [:string {:min 1}]
 ; Provider reasoning is a separate projection from visible reply text.
 ; The settled value is persisted on the attempt; the partial exists only
 ; while the same lossy stream snapshot is in flight.
 :seon.ai/reasoning-content [:string {:min 1}]
 :seon.ai/reasoning-partial :string
 ; STREAMING is a transport choice and nothing more
 ; (docs/seon/reference/llm-adapters.md:545-563: wire transport and reply
 ; evaluation are independent). Its one invariant, quoted from that
 ; authority because it is the thing a partial-display feature always
 ; breaks: "Partial display is presentation-only and cannot affect
 ; transport, parsing, usage, or evaluation." A streamed call and a
 ; one-shot call return the SAME completion value.
 :seon.ai/stream? :boolean

 ; Where partials GO, injected by the caller rather than known here.
 ; `seon.ai` owns the wire and the fold; it does not own the database,
 ; so it cannot be the thing that decides a partial becomes a datom.
 ; The sink is called with a snapshot and its return value is ignored —
 ; presentation may lag or drop, and it may never slow the call.
 :seon.ai/sink [:fn {:gen/gen seon.ai/sink-generator} seon.ai/sink?]

 ; The provider's own usage map, retained as the NEWEST seen. Kept
 ; independently of choices because Gemini attaches cumulative usage to
 ; content chunks while OpenAI-compatible providers emit one final
 ; choices-empty chunk — the portable fold must not assume either.
 :seon.ai/usage [:map-of :string :any]
 :seon.ai/tokens [:int {:min 0}]
 :seon.ai/finish-reason [:string {:min 1}]

 ; Request settings are canonical Clojure data until this one projection
 ; applies the registration's [wire-key coercion] pairs.
 :seon.ai/sent [:map-of :string :any]
 :seon.ai/inert [:set :qualified-keyword]
 :seon.ai/wire-settings
 [:map {:closed true}
  [:seon.ai/sent :seon.ai/sent]
  [:seon.ai/inert :seon.ai/inert]]
 :seon.ai/request-body [:or :seon.ai/sent :seon.error/value]
 :seon.ai/settings :seon.config/effective

 ; Open provider usage stays open on the attempt; these comparable counts are
 ; derived at read and never stored beside their source document.
 :seon.ai.usage/prompt-tokens :seon.ai/tokens
 :seon.ai.usage/completion-tokens :seon.ai/tokens
 :seon.ai.usage/total-tokens :seon.ai/tokens
 :seon.ai.usage/cached-tokens :seon.ai/tokens
 :seon.ai/normalized-usage
 [:map {:closed true}
  [:seon.ai.usage/prompt-tokens {:optional true} :seon.ai.usage/prompt-tokens]
  [:seon.ai.usage/completion-tokens {:optional true} :seon.ai.usage/completion-tokens]
  [:seon.ai.usage/total-tokens {:optional true} :seon.ai.usage/total-tokens]
  [:seon.ai.usage/cached-tokens {:optional true} :seon.ai.usage/cached-tokens]]

 ; One snapshot handed to the sink: everything so far, plus the live
 ; token count derived from the SAME fold rather than counted twice.
 :seon.ai/partial
 [:map {:closed true}
  [:seon.ai/text :string]
  [:seon.ai/reasoning-partial {:optional true} :seon.ai/reasoning-partial]
  [:seon.ai/tokens :seon.ai/tokens]
  [:seon.ai/usage {:optional true} :seon.ai/usage]
  [:seon.ai/finish-reason {:optional true} :seon.ai/finish-reason]]

 :seon.ai/request
 [:or
  [:map {:closed true} [:seon.ai/endpoint :seon.ai/endpoint] [:seon.ai/model :seon.ai/model] [:seon.ai/max-tokens :seon.ai/max-tokens] [:seon.ai/api-key-variable :seon.ai/api-key-variable] [:seon.ai/thinking {:optional true} :seon.ai/thinking] [:seon.ai/temperature {:optional true} :seon.ai/temperature] [:seon.ai/top-p {:optional true} :seon.ai/top-p] [:seon.ai/frequency-penalty {:optional true} :seon.ai/frequency-penalty] [:seon.ai/presence-penalty {:optional true} :seon.ai/presence-penalty] [:seon.ai/stop {:optional true} :seon.ai/stop] [:seon.ai/response-format {:optional true} :seon.ai/response-format] [:seon.ai/extra-body-edn {:optional true} :seon.ai/extra-body-edn] [:seon.ai/system {:optional true} :seon.ai/system] [:seon.ai/prompt :seon.ai/prompt] [:seon.ai/timeout-ms :seon.ai/timeout-ms] [:seon.ai/stream? {:optional true} :seon.ai/stream?] [:seon.ai/sink {:optional true} :seon.ai/sink]]
  [:map {:closed true} [:seon.ai/endpoint :seon.ai/endpoint] [:seon.ai/model :seon.ai/model] [:seon.ai/max-tokens :seon.ai/max-tokens] [:seon.config.ai/no-auth :seon.config.ai/no-auth] [:seon.ai/thinking {:optional true} :seon.ai/thinking] [:seon.ai/temperature {:optional true} :seon.ai/temperature] [:seon.ai/top-p {:optional true} :seon.ai/top-p] [:seon.ai/frequency-penalty {:optional true} :seon.ai/frequency-penalty] [:seon.ai/presence-penalty {:optional true} :seon.ai/presence-penalty] [:seon.ai/stop {:optional true} :seon.ai/stop] [:seon.ai/response-format {:optional true} :seon.ai/response-format] [:seon.ai/extra-body-edn {:optional true} :seon.ai/extra-body-edn] [:seon.ai/system {:optional true} :seon.ai/system] [:seon.ai/prompt :seon.ai/prompt] [:seon.ai/timeout-ms :seon.ai/timeout-ms] [:seon.ai/stream? {:optional true} :seon.ai/stream?] [:seon.ai/sink {:optional true} :seon.ai/sink]]]
 :seon.ai/completion [:or [:map {:closed true} [:seon.ai/text :seon.ai/text] [:seon.ai/reasoning-content {:optional true} :seon.ai/reasoning-content] [:seon.ai/usage {:optional true} :seon.ai/usage] [:seon.ai/tokens {:optional true} :seon.ai/tokens] [:seon.ai/finish-reason {:optional true} :seon.ai/finish-reason]] :seon.error/value]

 ; ---------------------------------------------------------------------
 ; THE DESCRIPTOR ROW. A target is one callable model: the four wire
 ; facts and nothing else. A `:seon.ai/request` IS a target plus what to
 ; say, which is why `complete` takes `(assoc target :seon.ai/prompt …)`
 ; and no adapter sits between them.
 ; The two ROLES are registered in their own right so every key in
 ; `:seon.ai/targets` resolves through the registry like every other
 ; key here. Neither carries a persistence facet, so neither becomes a
 ; database attribute — the roles are a shape, not a row.
 :seon.ai/primary :seon.ai/target
 :seon.ai/backup :seon.ai/target
 :seon.ai/target
 [:or
  [:map {:closed true} [:seon.ai/endpoint :seon.ai/endpoint] [:seon.ai/model :seon.ai/model] [:seon.ai/max-tokens :seon.ai/max-tokens] [:seon.ai/api-key-variable :seon.ai/api-key-variable] [:seon.ai/thinking {:optional true} :seon.ai/thinking] [:seon.ai/temperature {:optional true} :seon.ai/temperature] [:seon.ai/top-p {:optional true} :seon.ai/top-p] [:seon.ai/frequency-penalty {:optional true} :seon.ai/frequency-penalty] [:seon.ai/presence-penalty {:optional true} :seon.ai/presence-penalty] [:seon.ai/stop {:optional true} :seon.ai/stop] [:seon.ai/response-format {:optional true} :seon.ai/response-format] [:seon.ai/extra-body-edn {:optional true} :seon.ai/extra-body-edn] [:seon.ai/timeout-ms :seon.ai/timeout-ms]]
  [:map {:closed true} [:seon.ai/endpoint :seon.ai/endpoint] [:seon.ai/model :seon.ai/model] [:seon.ai/max-tokens :seon.ai/max-tokens] [:seon.config.ai/no-auth :seon.config.ai/no-auth] [:seon.ai/thinking {:optional true} :seon.ai/thinking] [:seon.ai/temperature {:optional true} :seon.ai/temperature] [:seon.ai/top-p {:optional true} :seon.ai/top-p] [:seon.ai/frequency-penalty {:optional true} :seon.ai/frequency-penalty] [:seon.ai/presence-penalty {:optional true} :seon.ai/presence-penalty] [:seon.ai/stop {:optional true} :seon.ai/stop] [:seon.ai/response-format {:optional true} :seon.ai/response-format] [:seon.ai/extra-body-edn {:optional true} :seon.ai/extra-body-edn] [:seon.ai/timeout-ms :seon.ai/timeout-ms]]]
 ; TWO ROLES, and the backup is ABSENT rather than nil when there is
 ; none — absence is the state, and `:seon.ai/backup?` downstream is
 ; literally `(contains? targets :seon.ai/backup)`.
 :seon.ai/targets [:map {:closed true} [:seon.ai/primary :seon.ai/target] [:seon.ai/backup {:optional true} :seon.ai/target]]

 ; ---------------------------------------------------------------------
 ; THE BACKOFF STRATEGY, as data. Composed the way `again` composes it
 ; (multiplicative → randomize → clamp → max-retries → max-duration),
 ; but DERIVED rather than executed: `seon.ai/delays` turns these six
 ; facts plus injected randomness into a finite vector of waits, so the
 ; whole schedule is one value a seeded property can pin.
 :seon.ai.retry/base-delay-ms [:int {:min 1}]
 :seon.ai.retry/multiplier [:double {:min 1.0}]
 :seon.ai.retry/jitter-fraction [:double {:min 0.0 :max 1.0}]
 :seon.ai.retry/maximum-delay-ms [:int {:min 1}]
 ; zero retries is a legitimate configuration: it turns `:backoff` into
 ; `:fail` by data rather than by a code branch.
 :seon.ai.retry/maximum-retries [:int {:min 0}]
 :seon.ai.retry/maximum-total-delay-ms [:int {:min 0}]
 :seon.ai.retry/strategy [:map {:closed true} [:seon.ai.retry/base-delay-ms :seon.ai.retry/base-delay-ms] [:seon.ai.retry/multiplier :seon.ai.retry/multiplier] [:seon.ai.retry/jitter-fraction :seon.ai.retry/jitter-fraction] [:seon.ai.retry/maximum-delay-ms :seon.ai.retry/maximum-delay-ms] [:seon.ai.retry/maximum-retries :seon.ai.retry/maximum-retries] [:seon.ai.retry/maximum-total-delay-ms :seon.ai.retry/maximum-total-delay-ms]]
 :seon.ai.retry/delays [:vector [:int {:min 0}]]

 ; ---------------------------------------------------------------------
 ; THE ATTEMPT FACT — one durable row per model call, and the reason the
 ; whole failover story is a query rather than a log grep. Without it,
 ; a successful backup ERASES the primary's failure and "nothing retried
 ; a paid call" is unprovable after the fact.
 ;
 ; It is warranted despite the crash model's aversion to replay ledgers,
 ; and the distinction is exact: a remote call's OCCURRENCE and its
 ; payment-safety evidence are not derivable from anything else we hold.
 ; The row authorizes no replay — nothing reads it to decide what to do
 ; next, only to say what happened.
 ;
 ; ONE ROW PER ATTEMPT, WRITTEN AFTER THE CALL, deliberately. A
 ; before-the-call `:running` row would be a second interruption
 ; mechanism for a fact nothing reads: a process that dies mid-call
 ; already leaves a claimed run that `work/interruption` finds and the
 ; loop settles, and nothing re-calls either way. The honest cost is
 ; named: a crash mid-call leaves NO attempt row, so the chain says
 ; "the call was never recorded", not "the call never happened".
 :seon.ai.attempt/id [:string {:min 1 :seon.db/identity true}]
 ; DERIVED as <run-id>-attempt-<ordinal>, so a re-entered `:call` pass
 ; appends rather than overwriting, and the chain reads in order.
 :seon.ai.attempt/run [:and {:seon.db/index true} :seon.db/ref]
 :seon.ai.attempt/ordinal [:int {:min 0}]
 :seon.ai.attempt/at :inst
 ; The provider's open usage document after JSON decoding. Persisted as
 ; EDN because its string-keyed, provider-owned shape is deliberately
 ; open; cached-token normalization remains a read-time derivation.
 :seon.ai.attempt/usage-edn :string
 ; The SAME inline/blob split as eval results, using the same configured
 ; threshold. Digest shape is direct so schema-derived history GC reaches it.
 :seon.ai.attempt/reasoning :string
 :seon.ai.attempt/reasoning-blob :seon.blob/digest
 :seon.ai.attempt/reasoning-size [:int {:min 1}]
 ; The complete resolved config map used for this attempt. It is an
 ; observation of the call, not a provider usage field or derived warning.
 :seon.ai.attempt/settings-edn :string
 :seon.ai.attempt/finish-reason :seon.ai/finish-reason
 ; The error FACT this attempt produced — the whole normalized record
 ; with its signature, prose projection and evidence, never a copy of
 ; its message. ITS PRESENCE IS THE OUTCOME (owner ruling 2026-07-28):
 ; an attempt failed exactly when it points at an error fact, and there
 ; is no stored :success/:error label restating that.
 :seon.ai.attempt/error :seon.db/ref
 ; ROLE BY CONNECTION, never a `:primary`/`:backup` stamp: an attempt is
 ; the backup exactly when it points at the attempt it replaced. That
 ; ref is also the proof of WHICH failure supplied its context.
 :seon.ai.attempt/failover-from :seon.db/ref
 ; The wait that preceded this attempt, present only on a backoff retry.
 :seon.ai.attempt/delay-ms [:int {:min 0}]
 ; The descriptor fields and the transport evidence keep the names the
 ; PRODUCERS already use — `seon.ai/target`'s own endpoint/model and the
 ; leaf's own `:seon.error/data` evidence keys — so reading a row back
 ; needs no translation table. The row stores OBSERVATIONS only (owner
 ; ruling 2026-07-28): the disposition acted on and the error class are
 ; pure functions of the durable evidence (`seon.ai/disposition`,
 ; `status-class`, the error fact's data-edn), derived at read rather
 ; than frozen beside the facts they restate.
 :seon.ai/attempt [:map {:closed true :seon.db/entity true} [:seon.ai.attempt/id :seon.ai.attempt/id] [:seon.ai.attempt/run :seon.ai.attempt/run] [:seon.ai.attempt/ordinal :seon.ai.attempt/ordinal] [:seon.ai.attempt/at :seon.ai.attempt/at] [:seon.ai/endpoint :seon.ai/endpoint] [:seon.ai/model :seon.ai/model] [:seon.ai.attempt/settings-edn :seon.ai.attempt/settings-edn] [:seon.ai.attempt/usage-edn {:optional true} :seon.ai.attempt/usage-edn] [:seon.ai.attempt/reasoning {:optional true} :seon.ai.attempt/reasoning] [:seon.ai.attempt/reasoning-blob {:optional true} :seon.ai.attempt/reasoning-blob] [:seon.ai.attempt/reasoning-size {:optional true} :seon.ai.attempt/reasoning-size] [:seon.ai.attempt/finish-reason {:optional true} :seon.ai.attempt/finish-reason] [:seon.ai/http-status {:optional true} :seon.ai/http-status] [:seon.ai/request-transmitted? {:optional true} :seon.ai/request-transmitted?] [:seon.ai/response-started? {:optional true} :seon.ai/response-started?] [:seon.ai/output-observed? {:optional true} :seon.ai/output-observed?] [:seon.ai.attempt/error {:optional true} :seon.ai.attempt/error] [:seon.ai.attempt/failover-from {:optional true} :seon.ai.attempt/failover-from] [:seon.ai.attempt/delay-ms {:optional true} :seon.ai.attempt/delay-ms]]

 ; ---------------------------------------------------------------------
 ; THE EVIDENCE A FAILOVER DECISION NEEDS, and the reason it lives here:
 ; only the leaf knows what actually happened on the wire. The five flat
 ; kinds are unchanged and stay the agent-facing shape; these are
 ; namespaced fields inside `:seon.error/data`, never a nested envelope.
 ;
 ; `error-class` is NORMALIZED — derived from the JDK's own exception
 ; taxonomy and the HTTP status, which is the dependency's vocabulary
 ; rather than a list we invented. The three phase booleans are what
 ; make "did this cost anything?" answerable instead of guessed, and
 ; that question is the whole no-retry ruling.
 :seon.ai/error-class [:enum :credential :transport-before-send :transport-unknown :timeout :rate-limit :server :authentication :authorization :model :request :response]
 :seon.ai/http-status [:int {:min 100 :max 599}]
 ; TRANSMITTED means the request left this machine, so the provider may
 ; have done paid work. UNKNOWN counts as transmitted: the ruling is
 ; strict, and "we cannot prove it was free" is not "it was free".
 :seon.ai/request-transmitted? :boolean
 :seon.ai/response-started? :boolean
 :seon.ai/output-observed? :boolean

 ; ONE DISPOSITION, computed. Three ordinary values, and the reducer
 ; that produces them is pure over the evidence above plus whether a
 ; backup exists.
 :seon.ai/disposition [:enum :failover-now :backoff :fail]
 :seon.ai/backup? :boolean
 :seon.ai/disposition-request [:map {:closed true} [:seon.error/value :seon.error/value] [:seon.ai/backup? :seon.ai/backup?]]

;; ===========================================================================
;; BLOCK
;; ===========================================================================
; The retained block vocabulary belongs to in-memory render values and stable
 ; DOM ids. Namespace-page membership and ordering come from `render.walk`;
 ; nothing here declares or stores an agent-owned block set.
 :seon.render.block/name :keyword

 ; Temporary dependency of the in-flight context-contribution schema. The
 ; context lane removes both together; no render code reads this attribute.
 :seon.render.block/band [:enum :anchor :program :authored :continuity :dynamic]

 ; An in-memory named render declaration accepted by the retained direct
 ; `unit`/`surface` helpers. It is not a database entity family.
 :seon.render.block/block
 [:map
  [:seon.render.block/name :seon.render.block/name]
  [:seon.render/ai {:optional true} :seon.render/ai]
  [:seon.render/html {:optional true} :seon.render/html]]

 ; ---------------------------------------------------------------------------
 ; THE HTML KIND
 ; ---------------------------------------------------------------------------

 ; One more kind on the open set. Its consumer is a surface in the
 ; browser, and its output grammar is hiccup — stated by the consumer,
 ; per the router's rule that a kind's grammar belongs to the kind's
 ; consumer and never to the router.
 :seon.render/html :seon.render/projection

 ; HICCUP IS A NAMED PREDICATE, and that is a limitation being paid for
 ; honestly rather than a preference. Hiccup is a tree, and a
 ; self-referential declaration currently overflows the stack in
 ; `seon.schema/bind-predicates` (issue
 ; a-self-referential-schema-overflows-the-stack). The supported idiom
 ; for a shape this registry cannot express is a registered core
 ; predicate with an honest generator, which is strictly better than
 ; `:any` here anyway: the grammar belongs to the serializer that
 ; enforces it, the predicate IS that grammar, and the generator's
 ; output domain is the serializer's input domain so every totality
 ; property generates against the real thing.
 :seon.render/hiccup [:fn {:gen/gen seon.render.hiccup/hiccup-generator} seon.render.hiccup/hiccup?]

 ; ---------------------------------------------------------------------------
 ; THE RENDERED PAGE
 ; ---------------------------------------------------------------------------

 ; The DOM element id, derived from the name by ONE function so the hole
 ; and the patch can never drift apart. `surface-` prefixed because the
 ; id shares a document with ids nobody here owns.
 :seon.render/surface-id [:string {:min 9}]

 ; ONE RENDERED BLOCK. Success carries the output; failure carries the
 ; flat error value INSTEAD — never merged beside it, because
 ; `:seon.error/value` is a closed shape registered once and a map that
 ; is both is neither. The surface always carries its name and id, so a
 ; failed block still has a place to put its error card and its
 ; neighbours are unaffected: per-block isolation is structural here, not
 ; a try/catch somebody remembered.
 ;
 ; A UNION OF TWO CLOSED MAPS rather than one map with two optional keys,
 ; and no discriminator: closedness already makes the two disjoint, and
 ; `:seon.error/value` presence is the same "did this render?" test the
 ; router's own wrap contract established. This is not the `:close`
 ; precedent — there the FOLD's end had to be visible in the value
 ; because an absent ordinal meant two different things; here nothing is
 ; inferred from an absence, only read from a presence.
 :seon.render/surface
 [:or
  [:map {:closed true}
   [:seon.render.block/name :seon.render.block/name]
   [:seon.render/surface-id :seon.render/surface-id]
   [:seon.render/kind :seon.render/kind]
   [:seon.render/output :seon.render/output]]
  [:map {:closed true}
   [:seon.render.block/name :seon.render.block/name]
   [:seon.render/surface-id :seon.render/surface-id]
   [:seon.render/kind :seon.render/kind]
   [:seon.error/value :seon.error/value]]]

 ; Rendered values supplied to the retained bounded slot expander.
 :seon.render/surfaces [:vector :seon.render/surface]

 ; ---------------------------------------------------------------------------
 ; DISTANCE — how many hops of the neighborhood one render reaches
 ; (owner ruling, 2026-07-28 post-midnight; seal revision to the request
 ; shapes below).
 ;
 ; NO NEW NOUN AND NO NEW KIND: distance is a REQUEST PARAMETER threaded
 ; to the renderers and to the one bounded expansion, exactly as caps and
 ; the trusted inputs already are. "The neighborhood view" is therefore
 ; the same page mechanism asked a different question, not a second one.
 ;
 ; THE CALL CONVENTION, and it is the whole design: distance is an
 ; argument TO the renderer, never a property OF it. The renderer is
 ; CALLED with the distance (present on the unit; IMPLIED 1 when absent,
 ; and never required — a projection that ignores it is correct).
 ; Reaching past its own unit is the renderer'S OWN COMPOSITIONAL ACT: it
 ; includes a neighbor by DELEGATING to that neighbor's renderer —
 ; mechanically, by emitting the ref hole `seon.render.block/entity-slot`
 ; already produces — and the expansion DECREMENTS distance per hop, so
 ; the neighbor is rendered at distance-1 and distance 0 is identity
 ; only: no expansion at all.
 ;
 ; REDIRECTION AT THE SLOT: a ref hole may carry an explicit projection
 ; symbol, and the neighbor is then rendered through that projection
 ; instead of its own declaration — the "override at any point" half of
 ; the ruling, routed through the ONE router like every other
 ; declaration, and recorded where every projection choice is recorded:
 ; in the emitting renderer's own output.
 ;
 ; ACCRETION, strictly. Absent means exactly today's behaviour: the
 ; admission caps alone bound the walk. Distance never overrides those
 ; caps — the depth and node dials remain the absolute bound, and
 ; distance SELECTS WITHIN them.
 :seon.render/distance [:int {:min 0}]

 ; The retained direct unit builder's input.
 :seon.render/unit-request
 [:map {:closed true}
  [:seon.db/db :seon.db/database-value]
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.sci.admit/caps :seon.sci.admit/caps]
  [:seon.render/distance {:optional true} :seon.render/distance]
  [:seon.ai/partial {:optional true} :seon.ai/partial]
  [:seon.cluster.run/live-processes {:optional true}
   :seon.cluster.run/live-processes]]

 ; What one bounded expansion needs. The database value is OPTIONAL
 ; because block-slot expansion needs none; an entity ref without one is
 ; refused in place, naming what it needed, rather than silently
 ; rendering an empty hole.
 ;
 ; DISTANCE is optional: absent means the caps alone bound the expansion;
 ; present means each ref hop spends one.
 :seon.render/expansion
 [:map {:closed true}
  [:seon.render/surfaces :seon.render/surfaces]
  [:seon.sci.admit/caps :seon.sci.admit/caps]
  [:seon.render/distance {:optional true} :seon.render/distance]
  [:seon.db/db {:optional true} :seon.db/database-value]]

 ; The shell's ordered hiccup fragment.
 :seon.render/page [:vector :seon.render/hiccup]

 ; ---------------------------------------------------------------------------
 ; GENERIC DEFAULT + SPECIALIST — the reusable selection shape
 ; (owner architectural ruling, 2026-07-27 night)
 ;
 ; Every output kind has a GENERIC default renderer that can project any
 ; value of the family. A producer that knows more about a particular
 ; value points that value's key at a SPECIALIST instead — and the
 ; choice is made WHERE THE UNIT IS BUILT, computed from the value's own
 ; attributes.
 ;
 ; The two halves of the ruling are one design. Because the key on the
 ; unit is the whole answer, a CONSUMER never branches: it hands the
 ; unit to the one router and receives whatever the producer decided.
 ; That is what makes "consumers reach an error's renderings only
 ; through the router" enforceable rather than a convention — there is
 ; no second call site to reach for, because the specialist's name never
 ; leaves the producer.
 ;
 ; It also keeps hot reload: the specialist is a SYMBOL resolved late by
 ; the router on every render, so re-evaluating it changes the next
 ; render, exactly as the generic default does.
 ; ---------------------------------------------------------------------------

 ; ONE RULE: a pure predicate over the value's own attributes, and the
 ; projection to use when it accepts. Both are qualified symbols
 ; resolved late — a rule is as hot-reloadable as the renderer it picks.
 :seon.render/specialist [:tuple :qualified-symbol :seon.render/projection]

 ; What a producer asks for. `specialists` is ORDERED and first match
 ; wins, because "more specific" is a judgement its owner makes and not
 ; something a scoring function should guess. An empty vector is the
 ; ordinary case and yields the default, so a family with no specialists
 ; writes no special code.
 ;
 ; This is NOT a registry: the vector belongs to the ONE producer that
 ; owns the family, is built from that family's own attributes, and is
 ; never consulted by anybody rendering. A second family's rules are
 ; invisible here, which is the difference between a producer's rules
 ; and a dispatch table.
 :seon.render/selection
 [:map {:closed true}
  [:seon.render/kind :seon.render/kind]
  [:seon.render/default :seon.render/projection]
  [:seon.render/specialists [:vector :seon.render/specialist]]]

