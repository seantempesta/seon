  [:seon.boot/pid :seon.boot/pid]
  [:seon.boot/prepl-port [:int {:min 1 :max 65535}]]
  [:seon.cluster.agent/count :seon.cluster.agent/count]
  [:seon.problems/problems :seon.problems/problems]
