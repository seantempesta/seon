  [:seon.config/manifest {:optional true} :seon.config/manifest]
  [:seon.config/environment {:optional true} :seon.config/manifest]
  [:seon.boot/cluster-name {:optional true} :seon.boot/cluster-name]]

 :seon.config/compiled
 [:map {:closed true}
  [:seon.config/effective :seon.config/effective]
  [:seon.config/applied-manifest-digest
   :seon.config/applied-manifest-digest]
  [:seon.config/desired-row :seon.config/entity]
  [:seon.config/resolved-attributes [:set :qualified-keyword]]]

 :seon.boot/start-request
 [:map {:closed true}
  [:seon.boot/cluster-name {:optional true} :seon.boot/cluster-name]
  [:seon.boot/root {:optional true} :seon.boot/root]
  [:seon.boot/prepl-host {:optional true} :seon.boot/prepl-host]
  [:seon.boot/prepl-port {:optional true} :seon.boot/prepl-port]
  [:seon.boot/log-dir {:optional true} :seon.boot/log-dir]
  [:seon.boot/store-dir {:optional true} :seon.boot/store-dir]
  [:seon.config/manifest {:optional true} :seon.config/manifest]
  [:seon.config/environment {:optional true} :seon.config/manifest]]

;; ===========================================================================
;; CONTEXT
;; ===========================================================================
; ---------------------------------------------------------------------------
 ; CONTEXT CAPTURE — what was sent, durable BEFORE the provider call.
 ;
 ; Owner ruling 2026-07-28 (Decision 4, Option A): the turn owner commits
 ; the exact prompt text, the rendered database basis, the ordered
 ; contribution records, and the trusted-input snapshot in ONE
 ; transaction before the unobservable remote call. Writer ordering then
 ; guarantees: no capture → the prompt was never derived; capture with no
 ; attempt row → the call may never have fired — the receipt-before-
 ; dispatch pattern applied to context evidence.
 ; ---------------------------------------------------------------------------

 ; Identity is DERIVED from provenance, never allocated:
 ; "<run-id>-context-<basis-t>". Re-deriving the same prompt at the same
 ; basis upserts the same capture; a released run re-entering :call at a
 ; new basis creates a new capture, which is the honest record — the
 ; prompt genuinely differs.
 :seon.context.capture/id [:string {:min 1 :seon.db/identity true}]
 :seon.context.capture/run :seon.db/ref

 ; The rendered database basis transaction (:t of the database value
 ; every projection read). The branch is the cluster's own and the
 ; prompt path never renders as-of/history values, so :t identifies the
 ; value exactly (the exact-database-identity oracle still generates the
 ; other axes to prove no cross-identity reuse — in memory, not here).
 :seon.context.capture/basis-t [:int {:min 0}]

 ; THE BYTE GROUND TRUTH — the exact string handed to :seon.ai/prompt.
 ; Ruled blob-backed; the blob archive is quarry order Q1 and does not
 ; exist in the fresh tree yet, so this ships as a string attribute with
 ; the blob-ref cutover named as an accretion at that rung (§9 of the
 ; owning contract package). Never admitted/capped: capping the capture
 ; would make the evidence lie about what was sent.
 :seon.context.capture/prompt [:string {:min 1}]

 ; The one honest non-database input, recorded so the projection is
 ; reproducible. Present exactly when the membership required it —
 ; absence means no block needed liveness, never "assumed alive".
 :seon.cluster.run/live-processes [:set :seon.cluster.run/process]

 ; Ordered by each child's own position (L13: order is never a
 ; collection-type property; component children carry ordinals).
 :seon.context.capture/contributions [:set {:seon.db/component true} :seon.db/ref]

 :seon.context.capture/capture
 [:map {:seon.db/entity true
        :seon.render/ai seon.context/capture-ai
        :seon.render/html seon.context/capture-html}
  [:seon.context.capture/id :seon.context.capture/id]
  [:seon.context.capture/run :seon.context.capture/run]
  [:seon.context.capture/basis-t :seon.context.capture/basis-t]
  [:seon.context.capture/prompt :seon.context.capture/prompt]
  [:seon.context.capture/contributions :seon.context.capture/contributions]
  [:seon.cluster.run/live-processes {:optional true}
   :seon.cluster.run/live-processes]]

 ; ---------------------------------------------------------------------------
 ; ONE CONTRIBUTION ROW — evidence, not content.
 ;
 ; The prompt blob is the byte ground truth; rows explain how it was
 ; built: name, hash, tokens, position, projection. NO stored
 ; :seon.render/kind — the 2026-07-28 presence ruling exempts kind as
 ; "a request argument, never stored", and on a prompt capture it is the
 ; constant :seon.render/ai anyway (derivable, so storing it would be a
 ; stored derivation). NO stored text — hash + position + the blob
 ; reconstruct it. A FAILED contribution is presence of the error keys.
 ; An OMITTED block writes no row: its omission is re-derivable from the
 ; captured basis and membership (derive, don't store).
 ; ---------------------------------------------------------------------------

 ; "<capture-id>-<position>" — provenance-derived, upsert-idempotent.
 :seon.context.contribution/id [:string {:min 1 :seon.db/identity true}]
 :seon.context.contribution/position [:int {:min 0}]
 ; SHA-256 hex of the contribution's exact UTF-8 text (schema/sha-256 —
 ; the one digest owner; the queued schema/digest helper lands here).
 :seon.context.contribution/hash [:string {:min 1}]
 ; ESTIMATED tokens (house rule: human-visible sizes are estimated
 ; tokens, never raw characters). The estimator is a named adopt (§9).
 :seon.context.contribution/tokens [:int {:min 0}]
 ; The bounded message of the flat error value, when the block failed.
 ; The full flat value stays in memory on the rendered-context record;
 ; the durable row keeps the open :seon.error/kind (already registered,
 ; ERROR section) plus this bounded message — never a second error shape.
 :seon.context.contribution/error [:string {:min 1}]

 :seon.context.contribution/contribution
 [:map {:seon.db/entity true}
  [:seon.context.contribution/id :seon.context.contribution/id]
  [:seon.context.contribution/position :seon.context.contribution/position]
  [:seon.render.block/name :seon.render.block/name]
  [:seon.context.contribution/hash :seon.context.contribution/hash]
  [:seon.context.contribution/tokens :seon.context.contribution/tokens]
  [:seon.render/projection {:optional true} :seon.render/projection]
  [:seon.error/kind {:optional true} :seon.error/kind]
  [:seon.context.contribution/error {:optional true}
   :seon.context.contribution/error]]

 ; ---------------------------------------------------------------------------
 ; IN-MEMORY SHAPES — never transacted, so [:maybe]/nil are legal here.
 ; ---------------------------------------------------------------------------

 ; One in-memory contribution record. Text is ALWAYS present — a failed
 ; block contributes a bounded, block-named error statement rather than
 ; silence (silent omission is confabulation fuel). :seon.error/value
 ; presence IS "failed"; :seon.render/kind rides here (request-argument
 ; territory) even though the durable row drops it.
 :seon.context/contribution
 [:map {:closed true}
  [:seon.render.block/name :seon.render.block/name]
  [:seon.render/kind :seon.render/kind]
  [:seon.context.contribution/position :seon.context.contribution/position]
  [:seon.context.contribution/text [:string {:min 1}]]
  [:seon.context.contribution/hash :seon.context.contribution/hash]
  [:seon.context.contribution/tokens :seon.context.contribution/tokens]
  [:seon.render/projection {:optional true} :seon.render/projection]
  [:seon.error/value {:optional true} :seon.error/value]]

 :seon.context/contributions [:vector :seon.context/contribution]

 ; What capture-tx receives: the rendered context plus the run it is
 ; evidence for. Pure in, tx-data out; the LOOP commits.
 :seon.context/capture-request
 [:map {:closed true}
  [:seon.cluster.run/id :seon.cluster.run/id]
  [:seon.cluster.prompt/rendered-context :seon.cluster.prompt/rendered-context]
  [:seon.cluster.run/live-processes {:optional true}
   :seon.cluster.run/live-processes]]

;; ===========================================================================
;; DATA
;; ===========================================================================
; ---------------------------------------------------------------------------
 ; THE /data DRILL. Bounded expansion whose cursor says where to resume
 ; instead of eliding — the same caps and the same walk as a panel, one
 ; keeping the tail and one throwing it away.
 ;
 ; Process-local only. A cursor lives in a URL, not in the database: a
 ; drilled position is a link somebody can send, and storing it would
 ; make "where is this reader looking" a fact somebody has to retract.
 ; ---------------------------------------------------------------------------

 ; A `get-in` path — the quarry's own vocabulary for this, deliberately
 ; not a new noun. Steps are ordinary values because the things they
 ; index are: a keyword key, a string key, an integer index.
 :seon.render.data/path [:vector :any]
 :seon.render.data/offset [:int {:min 0}]

 :seon.render.data/cursor
 [:map {:closed true}
  [:seon.render.data/path :seon.render.data/path]
  [:seon.render.data/offset :seon.render.data/offset]]

 ; One page, and the honest count beside it. `total` is present always
 ; because a reader must know a window is a window; the two resume
 ; offsets are present exactly when there IS somewhere to resume, so
 ; "is there a next page?" is key presence rather than arithmetic
 ; repeated at every call site.
 :seon.render.data/window
 [:map {:closed true}
  [:seon.render.data/entries [:vector [:tuple :any :any]]]
  [:seon.render.data/offset :seon.render.data/offset]
  [:seon.render.data/total [:int {:min 0}]]
  [:seon.render.data/next-offset {:optional true} :seon.render.data/offset]
  [:seon.render.data/previous-offset {:optional true} :seon.render.data/offset]]

;; ===========================================================================
;; DISPOSITIONS
;; ===========================================================================
; The agent-facing disposition VALUES. Exactly two (owner ruling,
 ; 2026-07-27 night): no start!, no pause/resume/terminate until an
 ; agent-lifecycle entity exists. These are values the driver
 ; interprets — the first of the three agent-facing shapes — and they
 ; are pure: `my.run` commits nothing and reads nothing.
 :my.run/disposition [:enum :wait :completed]
 :my.run/note [:string {:min 1}]
 :my.run/result [:string {:min 1}]
 :my.run/wait [:map {:closed true} [:my.run/disposition [:= :wait]] [:my.run/note :my.run/note]]
 :my.run/completed [:map {:closed true} [:my.run/disposition [:= :completed]] [:my.run/result :my.run/result]]
 ; what an agent's last form may evaluate to and the loop will act on
 :my.run/value [:or :my.run/wait :my.run/completed]

;; ===========================================================================
;; ERROR
;; ===========================================================================
; ---------------------------------------------------------------------------
 ; ONE FAMILY. `:seon.fault/*` merged in here 2026-07-27 (orchestrator
 ; ruling) BEFORE anything referenced those names: an error is an error
 ; whether it arrived as a flat value an agent reads, a transition's
 ; refusal, or a Throwable that escaped our own code onto flow's error
 ; channel. Two shapes in one family, and the relation between them is
 ; a projection, not a conversion:
 ;
 ;   :seon.error/value — the FLAT value. Nothing throws into the run
 ;     loop, so this is what a caller branches on and what an agent is
 ;     shown. Producers keep their own closed maps under `data`.
 ;   :seon.error/fact  — the DURABLE fact. One committed entity per
 ;     error worth remembering, carrying the projected evidence and
 ;     refs to what it interrupted. `seon.error/value` projects a fact
 ;     back down to the flat shape, which is why the totality property
 ;     asserts both of one normalization.
 ;
 ; KINDS ARE NEVER ENUMERATED HERE. `:seon.error/kind` stays `:keyword`
 ; on purpose: the kind population is the set of namespaced keywords the
 ; producing sites already carry (`::no-credential`, `:seon.db/rejected`,
 ; `:seon.cluster.run/refused`, …). A `[:enum]` here would be a
 ; hand-maintained list of everyone else's vocabulary and would go stale
 ; the first time a site is added. N5's program graph makes the real
 ; enumeration QUERYABLE from the corpus; until then it is discoverable
 ; by reading the producers, and neither answer is a list in this file.
 ; ---------------------------------------------------------------------------

 ; --- the flat value -------------------------------------------------------
 ; `kind` is the namespaced rule that failed, `message` is what a reader
 ; (agent or human) is told, and `data` carries whatever the owner of
 ; that rule attached. Producers stay closed maps of their own; this is
 ; the shared floor.
 :seon.error/data :map
 :seon.error/kind :keyword
 :seon.error/message [:string {:min 1}]
 :seon.error/value [:map {:closed true} [:seon.error/kind :seon.error/kind] [:seon.error/message :seon.error/message] [:seon.error/data {:optional true} :seon.error/data]]

 ; --- the durable fact -----------------------------------------------------
 ; Classification is the CHANNEL, not a predicate — `seon.sci.eval/evaluate`
 ; never throws, so an agent's mistake is a VALUE and can only become a
 ; receipt; anything arriving on ::flow/error is definitionally ours. No
 ; kind list, no ambient scope, no authorship inference.
 :seon.error/id [:string {:min 1 :seon.db/identity true}]
 :seon.error/at :inst
 ; the ONE holder string, `seon.cluster/process-identity`
 :seon.error/process [:string {:min 1}]
 :seon.error/proc :keyword
 :seon.error/op :keyword
 :seon.error/cid :keyword
 :seon.error/class [:string {:min 1}]
 :seon.error/basis-t [:int {:min 0}]
 ; the projected source, printed. NEVER a raw pr-str: two of flow's three
 ; report shapes carry ::flow/state, which for the run loop holds a live
 ; Datahike connection and executors. One codec — `seon.sci.admit/admit`.
 :seon.error/data-edn :string
 ; the honest signal that `data-edn` is not the whole source, so a reader
 ; never has to guess whether an elision marker was the original value
 :seon.error/capped? :boolean
 ; a derivation of the error's OWN content, committed with it — never a
 ; mutable tally. Recurrence is counted by query. Deliberately excludes
 ; the message: a message carrying an id or a timestamp would make every
 ; occurrence unique and recurrence undetectable.
 :seon.error/signature [:re {:seon.db/index true} "^[0-9a-f]{64}$"]
 :seon.error/occurrence [:int {:min 1}]
 :seon.error/occurrences [:int {:min 1}]
 :seon.error/notification-limit [:int {:min 1}]
 :seon.error/notification [:enum :final]
 :seon.error/agent [:and {:seon.db/index true} :seon.db/ref]
 :seon.error/run [:and {:seon.db/index true} :seon.db/ref]

 ; The entity map is not decoration: canonical-database-attributes
 ; installs entity-map entries BY CONSTRUCTION, and a family declared
 ; only as standalone leaves installs nothing but its identity —
 ; the fixture-vs-live-boot class that cost the N3 drive two rounds.
 :seon.error/fact
 [:map {:seon.db/entity true
        :seon.render/ai seon.error/render-ai
        :seon.render/html seon.error/render-html}
  [:seon.error/id :seon.error/id]
  [:seon.error/at :seon.error/at]
  [:seon.error/process :seon.error/process]
  ; REQUIRED, where the merged draft had it optional: normalization is
  ; fail-closed, so a source carrying no discoverable kind gets
  ; `:seon.error/unclassified` rather than an absent key. That is what
  ; makes "every fact projects to a valid flat value" true by
  ; construction, and it means a kind query can never silently miss.
  [:seon.error/kind :seon.error/kind]
  [:seon.error/message :seon.error/message]
  [:seon.error/signature :seon.error/signature]
  [:seon.error/data-edn :seon.error/data-edn]
  [:seon.error/capped? :seon.error/capped?]
  ; absent when the error was never a Throwable — a flat value and a
  ; transition refusal have no class, and absence is the state
  [:seon.error/class {:optional true} :seon.error/class]
  ; absent for everything that did not arrive on flow's error channel,
  ; and `op`/`cid` are absent for two of its three report shapes
  [:seon.error/proc {:optional true} :seon.error/proc]
  [:seon.error/op {:optional true} :seon.error/op]
  [:seon.error/cid {:optional true} :seon.error/cid]
  ; absent when no database value was pinned at the error
  [:seon.error/basis-t {:optional true} :seon.error/basis-t]
  ; absent when no claimed-open run existed at the error's basis
  [:seon.error/run {:optional true} :seon.error/run]
  [:seon.error/agent {:optional true} :seon.error/agent]
  [:seon.instrument/fn {:optional true} :seon.instrument/fn]
  [:seon.instrument/arm {:optional true} :seon.instrument/arm]
  [:seon.instrument/expected {:optional true} :seon.instrument/expected]
  [:seon.instrument/args {:optional true} :seon.instrument/args]]

 ; --- normalization --------------------------------------------------------
 ; `:any` at the ONE genuine third-party boundary of this family: the
 ; source is whatever went wrong — a Throwable from any library, one of
 ; core.async.flow's three incompatible report maps, a flat value, or a
 ; transition's ex-data. A schema here would be a second classifier, and
 ; the whole point of one normalizer is that there is no second one.
 :seon.error/source :any
 ; NOTE what is NOT a key here: `:seon.config/on-core-error`. The error
 ; path may not panic — a panic while recording an error destroys the
 ; one record of the original failure (the quarry's recursion fence,
 ; src-old/seon/error.cljc:738-745). Admission is therefore called in
 ; `:record` mode unconditionally, and a codec hole stays visible as a
 ; projection marker plus `capped?` rather than as a throw.
 :seon.error/normalize-request [:map {:closed true} [:seon.error/source :seon.error/source] [:seon.error/id :seon.error/id] [:seon.error/at :seon.error/at] [:seon.error/process :seon.error/process] [:seon.sci.admit/caps :seon.sci.admit/caps] [:seon.error/basis-t {:optional true} :seon.error/basis-t] [:seon.cluster.run/id {:optional true} :seon.cluster.run/id] [:seon.cluster.agent/id {:optional true} :seon.cluster.agent/id]]

 ; --- the notice: the derived routing unit ---------------------------------
 ; WHY an agent is being told. A derived clause, never boilerplate — and
 ; the reason IS the escalation rule, so the two cannot drift. It is not
 ; an attribute of the fact because it is per-RECIPIENT: one fact can be
 ; :your-run to the interrupted agent and :recurring to the escalation
 ; owner in the same transaction.
 ; `:failover` is the fourth recipient reason and it is NOT a message
 ; reason: nobody is mailed, the backup model READS it as the system
 ; segment of the very request that replaces the failed one. Adding it
 ; here rather than writing a bespoke failover notice is the whole
 ; point — the primary's why-clause is the SAME derivation the agent,
 ; the escalation owner and the log already get.
 :seon.error/reason [:enum :your-run :no-attributable-agent :recurring :failover]
 ; Machine-readable projection structure. The durable fact remains the
 ; evidence owner; the notice carries its lookup ref, the derived kind,
 ; every route it declares, and the selected human presentation.
 :seon.error/evidence [:tuple [:enum :seon.error/id] :seon.error/id]
 :seon.error/presentation :seon.render/projection
 :seon.error/notice-request [:map {:closed true} [:seon.error/fact :seon.error/fact] [:seon.error/reason {:optional true} :seon.error/reason] [:seon.error/occurrence {:optional true} :seon.error/occurrence] [:seon.error/occurrences {:optional true} :seon.error/occurrences] [:seon.error/notification-limit {:optional true} :seon.error/notification-limit] [:seon.error/notification {:optional true} :seon.error/notification] [:seon.cluster.agent/id {:optional true} :seon.cluster.agent/id]]
 ; The notice is DERIVED and never stored: a fact plus the projection
 ; declarations, which is what makes it routable through the one generic
 ; router (`seon.render`). The projection keys ride on the notice rather
 ; than on the entity because a stored symbol identical on every row is
 ; stored-derived data, and because the ai projection needs the reason
 ; the entity cannot carry.
 :seon.error/notice [:map {:closed true} [:seon.error/fact :seon.error/fact] [:seon.error/kind :seon.error/kind] [:seon.error/evidence :seon.error/evidence] [:seon.error/presentation :seon.error/presentation] [:seon.render/kinds :seon.render/kinds] [:seon.render/ai :seon.render/projection] [:seon.render/log :seon.render/projection] [:seon.error/reason {:optional true} :seon.error/reason] [:seon.error/occurrence {:optional true} :seon.error/occurrence] [:seon.error/occurrences {:optional true} :seon.error/occurrences] [:seon.error/notification-limit {:optional true} :seon.error/notification-limit] [:seon.error/notification {:optional true} :seon.error/notification] [:seon.cluster.agent/id {:optional true} :seon.cluster.agent/id]]

 ; How many faults the fan-out's bounded buffer had to DROP in this
 ; process. Process-local by nature — it counts what never became a
 ; fact, so it cannot itself be a fact — and it is on the instance so
 ; "did we lose any?" is answerable rather than assumed. Dropping is
 ; ADMITTED, never silent: the quarry's own lesson was that an unread
 ; error channel forgets quietly.
 :seon.error/drops [:fn {:gen/gen seon.flow/atom-reference-generator} seon.flow/atom-reference?]

 ; --- the commit ------------------------------------------------------------
 ; `commit-tx` is PURE over a database value and returns transaction
 ; data, which is what keeps this family free of the store: the
 ; dependency runs `store -> error` (store's `transact!` uses this
 ; family's `refusal`), never both ways. The caller commits through the
 ; one door. Slice 1's `commit-request`/`committed` shapes are GONE —
 ; they described an effectful function that no longer exists, and
 ; keeping them would have been a second contract for one mechanism.
 :seon.error/commit-tx-request [:map {:closed true} [:seon.error/source :seon.error/source] [:seon.error/id :seon.error/id] [:seon.error/at :seon.error/at] [:seon.error/process :seon.error/process] [:seon.sci.admit/caps :seon.sci.admit/caps] [:seon.config.error/recurrence-limit :seon.config.error/recurrence-limit] [:seon.error/basis-t {:optional true} :seon.error/basis-t] [:seon.cluster.run/id {:optional true} :seon.cluster.run/id] [:seon.cluster.agent/id {:optional true} :seon.cluster.agent/id] [:seon.config.error/escalate-to {:optional true} :seon.config.error/escalate-to]]

 ; An explanation message carries a ref to what it explains. A user
 ; message has none — absence is the state, and it is what makes the
 ; storm fence computable without a flag. The `:and` wrap is the one
 ; idiom for a facet on a referenced form, and the facet is not
 ; decoration: a BARE `:seon.db/ref` carries no persistence facet and
 ; would never install as a canonical database attribute (the computed
 ; rule the PROVENANCE section documents). Slice 1 declared it bare, so a
 ; fault-explanation message would have been untransactable on the live
 ; boot path and no fixture would have seen it. Indexed because the
 ; storm fence and "which messages explain this error" both query BY
 ; the ref.
 :seon.cluster.message/about [:and {:seon.db/index true} :seon.db/ref]

;; ===========================================================================
;; EVAL
;; ===========================================================================
; THE ONE LIMIT. Time, and nothing else: sci counts no steps and has no
 ; step concept, so a wall-clock deadline read at every interpreted fn
 ; body entrance is the whole mechanism (reference-code/sci/doc/
 ; interrupt.md:23-35). :seon.eval/fn-entries is RECORDED beside it and
 ; is never a limit — 271M entries in 500ms reads as a spin, 12 reads as
 ; blocked in a host call.
 :seon.sci.eval/time-limit-ms [:int {:min 1}]
 ; sci's own word for an interpreter context; one live context belongs to
 ; each cluster, so every agent in that cluster shares definitions while
 ; another cluster remains isolated.
 :seon.sci.eval/ctx [:fn {:gen/gen seon.sci.eval/ctx-generator} seon.sci.eval/ctx?]
 :seon.sci.eval/program-row :map
 :seon.sci.eval/referenced-vars [:set :symbol]
 :seon.sci.eval/unproven-called-vars [:set :symbol]
 :seon.sci.eval/nondeterministic-calls [:set :symbol]
 :seon.sci.eval/impure-calls [:set :symbol]
 :seon.sci.eval/session-def
 [:map {:closed true}
  [:seon.code.def/id :seon.code.def/id]
  [:seon.code.def/ns :seon.code.def/ns]
  [:seon.code.def/name :seon.code.def/name]
  [:seon.code.def/source :seon.code.def/source]
  [:seon.sci.eval/value :any]
  [:seon.sci.eval/referenced-vars :seon.sci.eval/referenced-vars]
  [:seon.sci.eval/unproven-called-vars
   :seon.sci.eval/unproven-called-vars]
  [:seon.sci.eval/nondeterministic-calls
   :seon.sci.eval/nondeterministic-calls]
  [:seon.sci.eval/impure-calls :seon.sci.eval/impure-calls]]
 :seon.sci.eval/session-defs [:vector :seon.sci.eval/session-def]
 :seon.sci.eval/install-request
 [:map {:closed true}
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:seon.db/db :seon.db/database-value]
  [:seon.sci.eval/program-row :seon.sci.eval/program-row]]
 :seon.sci.eval/acquire-request
 [:map {:closed true}
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:seon.db/db :seon.db/database-value]]
 :seon.sci.eval/session-install-request
 [:map {:closed true}
  [:seon.sci.eval/ctx :seon.sci.eval/ctx]
  [:seon.db/db :seon.db/database-value]
  [:seon.store/branch-connection {:optional true}
   :seon.store/branch-connection]]
 ; The error disposition is REQUIRED and is passed straight to
 ; admission: R41 decides what a projection failure does, and a caller
 ; that has not decided has not thought about it.
 :seon.sci.eval/request [:map {:closed true} [:seon.cluster.run.form/source :seon.cluster.run.form/source] [:seon.cluster.run.form/ns {:optional true} :seon.cluster.run.form/ns] [:seon.sci.admit/caps :seon.sci.admit/caps] [:seon.sci.eval/time-limit-ms :seon.sci.eval/time-limit-ms] [:seon.config/on-core-error :seon.config/on-core-error] [:seon.sci.eval/ctx {:optional true} :seon.sci.eval/ctx] [:seon.cluster.agent/id {:optional true} :seon.cluster.agent/id] [:seon.store/branch-connection {:optional true} :seon.store/branch-connection]]
 ; What one evaluation leaves behind: the terminal facts the receipt
 ; stores (result-edn always; error when it failed; interrupted-at when
 ; the time limit fired), the admitted value the loop reads a
 ; disposition out of, the printed projection, and the diagnostics.
 ; Nothing here is optional-by-nil — an absent key means the evaluation
 ; had no such thing, and PRESENCE IS THE STATE: there is no status
 ; label restating which keys exist (owner ruling 2026-07-28).
