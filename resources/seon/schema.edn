 :seon.boot/recovered-runs [:int {:min 0}]
 :seon.boot/recovery-operations [:int {:min 0}]

 :seon.boot/root [:string {:min 1}]
 :seon.boot/start-instant :inst
 :seon.boot/store-dir [:string {:min 1}]
 :seon.cluster.agent/count [:int {:min 0}]

 ; THE BOOT BANNER'S data, derived from a started instance. Optional
