     [:seon.print/vector
      [:map {:closed true}
       [:seon.print/face [:= :seon.print/vector]]
       [:seon.print/items [:vector [:ref :seon.print/node*]]]]]
     [:seon.print/list
      [:map {:closed true}
       [:seon.print/face [:= :seon.print/list]]
       [:seon.print/items [:vector [:ref :seon.print/node*]]]]]
     [:seon.print/set
      [:map {:closed true}
       [:seon.print/face [:= :seon.print/set]]
