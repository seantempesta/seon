  [:seon.problems/id {:optional true} :seon.problems/id]
  [:seon.error/kind {:optional true} :seon.error/kind]
  [:seon.cluster.eval/output {:optional true} :seon.cluster.eval/output]]

 :seon.blob/content :string
 :seon.blob/digest :seon.cluster.eval/result-blob

 :seon.cluster.run.form/id [:string {:min 1 :seon.db/identity true}]
 :seon.cluster.run.form/ns :seon.db/ref
 :seon.cluster.run.form/ordinal [:int {:min 0}]
 :seon.cluster.run.form/run :seon.db/ref
 :seon.cluster.run.form/source [:string {:min 1}]

