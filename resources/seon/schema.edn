;; ===========================================================================
;; WAKE
;; ===========================================================================
; The wake channel carries no information: it says "look", never
 ; "here is what changed". Work is derived from facts, so a wake that
 ; lost its payload lost nothing.
 :seon.cluster.wake/attributes [:set :keyword]
 :seon.cluster.wake/key :keyword
 ; THE ROUTING DELIVERY (F1 §4): one registration per cluster whose
 ; handler ROUTES each committed wake datom to its recipient's mailbox
 ; instead of one global channel. `channels` is a zero-arg fn returning
 ; the CURRENT process-local routing map (recipient entity id →
 ; mailbox channel) — a fn, not a snapshot, because arming grows the
 ; map while the listener lives.
 :seon.cluster.wake/channels fn?
 ; A two-arg predicate over recipient eid + the exact mailbox route.
 ; The agent routing owner derives quarantine from its current route;
 ; no fenced-id set or stored lifecycle flag exists.
 :seon.cluster.wake/fenced? fn?
 ; Delivery combines `offer!`'s answer with that derived route fact.
 ; A closed channel alone is not a fence: a closed render route is a
 ; genuine delivery failure and remains loud.
 :seon.cluster.wake/offer-result [:enum true false nil]
 :seon.cluster.wake/delivery [:enum :seon.cluster.wake/delivered :seon.cluster.wake/fenced :seon.cluster.wake/refused]
 ; `render-channel` is the THIRD delivery (F2 §1.4): one payload-free
 ; wake per REPORT, unconditionally, into the render proc's `::interest`
 ; in-port. Required, not optional — a cluster whose commits reach no
 ; render pass would serve a page that silently stops updating.
 :seon.cluster.wake/route-request [:map {:closed true} [:seon.cluster.wake/connection :seon.store/branch-connection] [:seon.cluster.wake/channels :seon.cluster.wake/channels] [:seon.cluster.wake/fenced? :seon.cluster.wake/fenced?] [:seon.cluster.wake/armer-channel :seon.flow/channel] [:seon.cluster.wake/render-channel :seon.flow/channel] [:seon.cluster.wake/fault-channel :seon.flow/channel] [:seon.cluster.wake/key :seon.cluster.wake/key]]
 :seon.cluster.wake/unlisten-request [:map {:closed true} [:seon.cluster.wake/connection :seon.store/branch-connection] [:seon.cluster.wake/key :seon.cluster.wake/key]]

;; ===========================================================================
;; WALK
;; ===========================================================================
; ---------------------------------------------------------------------------
 ; THE NEIGHBOURHOOD TRAVERSAL — `seon.render.walk`.
 ;
 ; Every shape here is IN-MEMORY: a walk transacts nothing, and the
 ; rendered neighbourhood is a value the consumer assembles and drops.
 ; The durable half of this mechanism is elsewhere and already exists —
 ; the family default renderers are `:seon.render/ai`/`:seon.render/html`
 ; properties on the registered ENTITY maps, which is where a family
 ; declares everything else about itself.
 ; ---------------------------------------------------------------------------

 ; Anything `d/pull` accepts as an eid: an entity id, or a lookup ref
 ; like `[:seon.cluster.run/id "run-7f21"]`. `:any` at a genuinely
 ; polymorphic dependency boundary — the admissible forms are Datahike's
 ; and restating them here would be a second contract to drift from the
 ; database's own (`seon.render.block/entity-slot` takes the same value
 ; under the same rule).
 :seon.render.walk/lookup :any
 :seon.render.walk/target :int
 :seon.render.walk/back-reference? :boolean
 :seon.render/would-fall-to-floor? :boolean
 :seon.render.walk/changed-at [:int {:min 0}]

 ; WHICH CONNECTION a neighbour was reached through. Named on the node
 ; so a reader never has to re-query to learn why a neighbour is there,
 ; and so a consumer can group by relationship without a second walk.
 :seon.render.walk/attribute :qualified-keyword

 :seon.render.walk/connection
 [:map {:closed true}
  [:seon.render.walk/attribute :seon.render.walk/attribute]
  [:seon.render.walk/target {:optional true} :seon.render.walk/target]
  [:seon.render.walk/lookup {:optional true} :seon.render.walk/lookup]
  [:seon.error/value {:optional true} :seon.error/value]]

 ; ---------------------------------------------------------------------------
 ; THE RESOLUTION CHAIN (owner ruling 2026-07-28 post-midnight #3),
 ; most specific first. Each step is DATA the caller already holds, so
 ; "why did it render that way?" is answered by reading one map.
 ; ---------------------------------------------------------------------------

 ; step 1 — the VIEWER's local override for a data type, keyed by the
 ; registered schema key the value matches. It rides the REQUEST rather
 ; than the unit precisely because the viewer is constant through the
 ; whole walk: every hop renders through the original agent's overrides, and
 ; perspective never silently shifts to an intermediate namespace.
 :seon.render/overrides [:map-of :qualified-keyword :seon.render/projection]

 ; step 3 — the kind's floor. Required, because a kind whose floor could
 ; be absent would make some value unrenderable, and the floor exists
 ; precisely so none is: "code is a good fallback as it's the truth of
 ; the system."
 :seon.render/floor :seon.render/projection

 :seon.render.walk/resolution
 [:map {:closed true}
  [:seon.render/kind :seon.render/kind]
  [:seon.render/floor :seon.render/floor]
  [:seon.render/overrides {:optional true} :seon.render/overrides]]

 ; ---------------------------------------------------------------------------
 ; THE WALK
 ; ---------------------------------------------------------------------------

 ; DISTANCE is optional for the same reason it is optional on every
 ; other render request: implied 1, never required, written in one place
 ; (`seon.render.block/distance`). Caps are REQUIRED — a walk over a
 ; graph that fans out and genuinely cycles needs the node budget, and
 ; the reverse-neighbour width is the same collection dial rather than a
 ; second one to drift from it.
 :seon.render.walk/request
 [:map {:closed true}
  [:seon.db/db :seon.db/database-value]
  [:seon.store/branch-connection {:optional true} :seon.store/branch-connection]
  [:seon.render.walk/lookup :seon.render.walk/lookup]
  [:seon.render/kind :seon.render/kind]
  [:seon.render/floor :seon.render/floor]
  [:seon.render/namespace {:optional true} :seon.render/namespace]
  [:seon.sci.admit/caps :seon.sci.admit/caps]
  [:seon.render/distance {:optional true} :seon.render/distance]
  [:seon.render/overrides {:optional true} :seon.render/overrides]]

 ; One rendered node. `:seon.render/output` and `:seon.error/value` are
 ; SIBLINGS, never a key beside each other: a node either rendered or
 ; said why it could not, and both are values — nothing here throws,
 ; because the prompt path is an error path.
 ;
 ; `:seon.render.walk/neighbours` is `[:vector :map]` rather than a
 ; self-reference: the population admits no recursive form today, and a
 ; consumer walks the tree with `get`, so a nominally recursive
 ; declaration would buy nothing the reader does not already have.
 :seon.render.walk/neighbours [:vector :map]

 :seon.render.walk/node
 [:map {:closed true}
  [:seon.render.walk/lookup :seon.render.walk/lookup]
  [:seon.render/distance :seon.render/distance]
  [:seon.render.walk/changed-at :seon.render.walk/changed-at]
  [:seon.render.walk/attribute {:optional true} :seon.render.walk/attribute]
  [:seon.render.walk/back-reference? {:optional true}
   :seon.render.walk/back-reference?]
  [:seon.render/would-fall-to-floor? {:optional true}
   :seon.render/would-fall-to-floor?]
  [:seon.render/projection {:optional true} :seon.render/projection]
  [:seon.render/output {:optional true} :seon.render/output]
  [:seon.error/value {:optional true} :seon.error/value]
  [:seon.render.walk/neighbours {:optional true}
   :seon.render.walk/neighbours]]

 ; A projection-neutral flattened walk unit. `output` remains the raw render
 ; value; consumers decide whether to serialize it as prose or HTML.
 :seon.render.walk/path [:vector [:or :keyword :int]]
 :seon.render.walk/found-depth [:int {:min 0}]
 :seon.render.walk/branch :seon.render.walk/path
 :seon.render.walk/unit
 [:map {:closed true}
  [:seon.render.walk/node :seon.render.walk/node]
  [:seon.render.walk/path :seon.render.walk/path]
  [:seon.render.walk/found-depth :seon.render.walk/found-depth]
  [:seon.render.walk/branch {:optional true} :seon.render.walk/branch]
  [:seon.render.walk/changed-at :seon.render.walk/changed-at]
  [:seon.render/output {:optional true} :seon.render/output]]
 :seon.render.walk/units [:vector :seon.render.walk/unit]

;; ===========================================================================
;; WEB
;; ===========================================================================
; ---------------------------------------------------------------------------
 ; THE PAGE ON A SOCKET. Process-local shapes only: a server descriptor,
 ; a request, a repaint. Nothing here is a database attribute, because
 ; nothing rendered is stored (O14) and a socket is not a fact.
 ; ---------------------------------------------------------------------------

 ; `:seon.config.render/coalesce-ms` is DECLARED in the CONFIG section, with the
 ; other dials and inside the config singleton entity. It is a
 ; coalescing FLOOR honored at the RENDER PROC (F2 §1.2), read from the
 ; config facts per pass — not a timer standing in for an unobservable
 ; event: the observable event is the commit and the routing listener
 ; already delivers it.

 :seon.render.web/port [:int {:min 0 :max 65535}]

 ; The fan-out the complete page snapshots ride: the render proc's
 ; `::pages` out-port, multed, tapped per tab with a sliding-1.
 :seon.render.web/pages-mult [:fn {:gen/gen seon.render.web/mult-generator} seon.render.web/mult?]

 ; The watched-agent registration: a process-local atom
 ; `{agent-id → open-tab count}`, written by the feed's
 ; on-open/on-close, read by the render pass. Disposable by the
 ; transport law — it names live sockets, and reconnect = repaint.
 :seon.render.web/registration [:fn {:gen/gen seon.flow/atom-reference-generator} seon.flow/atom-reference?]
 :seon.render.web/url [:string {:min 1}]
 :seon.render.web/root-agent-id :seon.cluster.agent/id

 ; The http-kit server object. A `[:fn]` with an honest generator, the
 ; supported idiom for a host object — the same shape `seon.store` uses
 ; for a connection and `seon.flow` for a channel.
 :seon.render.web/http-server [:fn {:gen/gen seon.render.web/server-generator} seon.render.web/server?]

 ; The port the derivation ASKED for, present exactly when it is not the
 ; port we got. Key presence answers "did this fall back?" so no reader
 ; has to remember to compare two numbers.
 :seon.render.web/wanted-port :seon.render.web/port

 :seon.render.web/server
 [:map {:closed true}
  [:seon.render.web/server :seon.render.web/http-server]
  [:seon.render.web/port :seon.render.web/port]
  [:seon.render.web/url :seon.render.web/url]
  [:seon.render.web/wanted-port {:optional true} :seon.render.web/wanted-port]]

 ; The render proc's process-local view, constructed once by
 ; `seon.cluster/arm-agents!`. Every opaque member references the existing
 ; predicate schema with its real generator: channels carry wakes, pages, and
 ; completion; the atom counts watched agents; the mult fans pages to tabs.
 ; Loss is free by the transport law, so none of this is database data.
 :seon.render.web/view
 [:map {:closed true}
  [:seon.render.web/render-channel :seon.flow/channel]
  [:seon.render.web/pages-channel :seon.flow/channel]
  [:seon.render.web/registration :seon.render.web/registration]
  [:seon.render.web/completion :seon.flow/channel]
  [:seon.render.web/root-agent-id :seon.render.web/root-agent-id]
  [:seon.cluster.run/process :seon.cluster.run/process]
  [:seon.render.web/pages-mult :seon.render.web/pages-mult]]

 ; What the handler needs. The database CONNECTION rather than a
 ; database value, because a page derives at whatever basis is current
 ; when the request arrives and a feed derives again on every commit —
 ; a value captured at start would freeze the page at boot.
 ; `:seon.cluster.run/process` is THIS process's run-holder identity,
 ; and it is REQUIRED rather than optional on purpose. It is the one
 ; input the database cannot answer — which processes are alive — and
 ; the problems block refuses to guess it, correctly: an absent set
 ; makes every held run look wedged and an assumed-alive default hides
 ; a real wedge. A service that cannot say who is alive cannot render an
 ; honest page, so the refusal belongs at construction, not per card.
 :seon.render.web/service
 [:map {:closed true}
  [:seon.store/connection :seon.store/connection]
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.sci.admit/caps :seon.sci.admit/caps]
  [:seon.cluster.run/process :seon.cluster.run/process]
  [:seon.render.web/pages-mult :seon.render.web/pages-mult]
  [:seon.render.web/registration :seon.render.web/registration]
  [:seon.render.web/render-channel :seon.flow/channel]
  [:seon.render.web/port {:optional true} :seon.render.web/port]]

 :seon.render.web/feed-request
 [:map {:closed true}
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.render.web/root-agent-id :seon.render.web/root-agent-id]
  [:seon.store/connection :seon.store/connection]
  [:seon.sci.admit/caps :seon.sci.admit/caps]
  [:seon.cluster.run/process :seon.cluster.run/process]
  [:seon.render.web/pages-mult :seon.render.web/pages-mult]
  [:seon.render.web/registration :seon.render.web/registration]
  [:seon.render.web/render-channel :seon.flow/channel]]

 :seon.render.web/page-request
 [:map {:closed true}
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.render/page :seon.render/page]
  [:seon.render.web/feed-url [:string {:min 1}]]]

 ; The parsed body handed from the Ring dispatcher to the one inbound
 ; boundary. Content is optional at the wire because a missing field is
 ; a 422 refusal, not a schema/instrumentation throw. When present it may
 ; still be blank; the message family owns that refusal.
 :seon.render.web/inbound
 [:map {:closed true}
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.cluster.message/inbound-content
   {:optional true}
   :seon.cluster.message/inbound-content]]

 ; What ONE agent's paint needs. A map rather than five positional
 ; arguments because the two optional members carry meaning by
 ; PRESENCE: an agent that is not streaming has no `:seon.ai/partial`
 ; at all, and absent is not the same as empty. The database VALUE is
 ; here, not the connection — a paint is derived at one basis and the
 ; whole page must be that basis.
 :seon.render.web/paint-request
 [:map {:closed true}
  [:seon.db/db :seon.db/database-value]
  [:seon.store/branch-connection {:optional true} :seon.store/branch-connection]
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.render.web/root-agent-id :seon.render.web/root-agent-id]
  [:seon.sci.admit/caps :seon.sci.admit/caps]
  [:seon.cluster.run/live-processes :seon.cluster.run/live-processes]
  [:seon.ai/partial {:optional true} :seon.ai/partial]]

 ; One repaint: what to send, and what the connection has now seen.
 ; Keyed by surface id and holding the BYTES, because bytes are what the
 ; socket costs and what suppression must compare — two values that
 ; serialize identically are the same page.
 :seon.render.web/repaint
 [:map {:closed true}
  [:seon.render.web/patches [:vector [:tuple :seon.render/surface-id :string]]]
  [:seon.render.web/delivered [:map-of :seon.render/surface-id :string]]]

;; ===========================================================================
;; WORK
;; ===========================================================================
; WHAT THE LOOP SHOULD DO NEXT, as one derived value. The four
 ; situations below are total and mutually exclusive over any database
 ; value; `nil` is idle, and nothing else is representable.
 :seon.cluster.work/situation [:enum :resume :call :open :close]
 ; :resume — an open run THIS process already holds, with a plan: fold
 ;           on at the first ordinal lacking a terminal receipt. An
 ;           unheld plan never resumes; recovery closes interrupted work.
 ; :call   — an open run this process holds, no plan: derive the prompt,
 ;           call the model, freeze the plan (the ONE paid call, never
 ;           retried)
 ; :open   — an unanswered trigger and an idle agent: open + claim first,
 ;           model second (the claim-early fence)
 ; :close  — an open run whose every form has a terminal receipt: the
 ;           fold is done. Its own situation rather than a :resume with
 ;           a missing ordinal, because fold-vs-close is a different
 ;           instruction and must be visible in the VALUE, never inferred
 ;           from an absent key (seal revision, 2026-07-27)
 :seon.cluster.work/next [:multi {:dispatch :seon.cluster.work/situation}
                          [:resume [:map {:closed true} [:seon.cluster.work/situation [:= :resume]] [:seon.cluster.run/id :seon.cluster.run/id] [:seon.cluster.agent/id :seon.cluster.agent/id] [:seon.cluster.run.form/ordinal :seon.cluster.run.form/ordinal]]]
                          [:call [:map {:closed true} [:seon.cluster.work/situation [:= :call]] [:seon.cluster.run/id :seon.cluster.run/id] [:seon.cluster.agent/id :seon.cluster.agent/id]]]
                          [:open [:map {:closed true} [:seon.cluster.work/situation [:= :open]] [:seon.cluster.agent/id :seon.cluster.agent/id] [:seon.cluster.message/id :seon.cluster.message/id]]]
                          [:close [:map {:closed true} [:seon.cluster.work/situation [:= :close]] [:seon.cluster.run/id :seon.cluster.run/id] [:seon.cluster.agent/id :seon.cluster.agent/id]]]]
 ; THE PER-AGENT DERIVATION'S REQUEST (F1): the same request narrowed
 ; to one agent. The episode dial is deliberately NOT here — it is a
 ; config fact the derivation reads from the database value itself, so
 ; a live dial change applies at the next pass with no handle rebuild.
 :seon.cluster.work/agent-request [:map {:closed true} [:seon.cluster.agent/id :seon.cluster.agent/id] [:seon.cluster.run/process :seon.cluster.run/process] [:seon.cluster.work/now :inst]]
 ; Runs since (and including) the one answering the last OUTSIDE
 ; trigger — the episode, derived purely from committed facts.
 :seon.cluster.work/episode-runs [:int {:min 0}]
 :seon.cluster.work/now :inst

 ; THE SEVEN STATES OF ONE FROZEN FORM. These are derived values, never
 ; stored status attributes. Run closure is intentionally absent.
 :seon.cluster.work/form-state
 [:enum :unevaluated :running :succeeded :routed :unrouted-red
  :owner-fixed :owner-declared-cant]
 :seon.cluster.work/settled? :boolean
 :seon.cluster.work/form-settlement
 [:map {:closed true}
  [:seon.cluster.run.form/id :seon.cluster.run.form/id]
  [:seon.cluster.run.form/ordinal :seon.cluster.run.form/ordinal]
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.cluster.eval/id {:optional true} :seon.cluster.eval/id]
  [:seon.problems/id {:optional true} :seon.problems/id]
  [:seon.cluster.work/form-state :seon.cluster.work/form-state]
  [:seon.cluster.work/settled? :seon.cluster.work/settled?]]
 :seon.cluster.work/plan-settlement
 [:map {:closed true}
  [:seon.cluster.run/id :seon.cluster.run/id]
  [:seon.cluster.work/forms [:vector :seon.cluster.work/form-settlement]]
  [:seon.cluster.work/settled? :seon.cluster.work/settled?]]
 :seon.cluster.work/forms [:vector :seon.cluster.work/form-settlement]
}
