  [:seon.render.value/options :seon.print/options]]

;; ===========================================================================
;; REPLY
;; ===========================================================================
; One model reply, as text, and the ordered form SOURCES read out of it.
 ; Sources are strings, not forms: the stored source is exactly what the
 ; agent wrote (comments and all), and the evaluator parses inside its
 ; own armed context — parsing twice on two readers is how a `#=` scar
 ; comes back.
 ; One plan form: the exact source the agent wrote, plus the namespace
 ; that form was written under when THE ONE READER attributed one.
 ; Absence is a real answer (a malformed declaration yields absence
 ; rather than inheritance), and it routes a red form to its author.
 :seon.cluster.reply/form
 [:map {:closed true}
  [:seon.cluster.run.form/source :seon.cluster.run.form/source]
  [:seon.ns/name {:optional true} :seon.ns/name]]
 :seon.cluster.reply/sources [:vector :seon.cluster.reply/form]
 :seon.cluster.reply/text :string

;; ===========================================================================
;; RUN
;; ===========================================================================
:seon.cluster.agent/id [:string {:min 1 :seon.db/identity true}]
 :seon.cluster.agent/run :seon.db/ref

 ; The agent entity. FOUND BY THE SUBSET CHECK, not by the drive: the
 ; loop asserts `/run` when it opens a run and retracts it when it
 ; closes one, and without this map only `/id` installed — so the live
 ; path would have failed at run-open, one step past the trigger. Same
 ; class, same commit. `/run` is optional because an idle agent has no
 ; current run, and absence IS idle (there is no status to read).
 ; The family lens is declared WHERE THE FAMILY IS (the `:seon.fn` /
 ; `:seon.ns` / `:seon.schema` idiom in seon.schema.cljc):
 ; `seon.render.walk/projection` reads it off the matched entity map, so
 ; a family gains a default render by adding one line here and writing
 ; one plain function. No registry, no table, no dispatch.
 :seon.cluster.agent/agent
 [:map {:seon.db/entity true
        :seon.render/ai seon.render.agent/agent-ai
        :seon.render/html seon.render.agent/agent-html}
  [:seon.cluster.agent/id :seon.cluster.agent/id]
  [:seon.cluster.agent/namespace
   {:optional true}
   :seon.cluster.agent/namespace]
  [:seon.cluster.agent/run {:optional true} :seon.cluster.agent/run]]
 :seon.cluster.eval/at :inst
 :seon.cluster.eval/error :string
 ; What the form PRINTED. Agent-visible evidence about its own work, so
 ; it is durable rather than dropped on the floor; bounded by the same
 ; string cap the projection uses.
 :seon.cluster.eval/output [:string {:min 1}]
 :seon.cluster.eval/id [:string {:min 1 :seon.db/identity true}]
 :seon.cluster.eval/ordinal [:int {:min 0}]
 :seon.cluster.eval/ns :seon.db/ref
 :seon.cluster.eval/result-edn :string
 ; Full result text moves to a content-addressed blob once it crosses the
 ; configured threshold. The receipt retains a presentation projection and
 ; these primitive facts; capped state is derived at render time.
 :seon.cluster.eval/result-blob [:re "^[0-9a-f]{64}$"]
 :seon.cluster.eval/result-size [:int {:min 0}]
 :seon.cluster.eval/run :seon.db/ref
 ; When this eval was cut instead of settling: the time limit fired, or
 ; boot recovery found the receipt dangling after its process died.
 ; STATE IS PRESENCE (owner ruling 2026-07-28): a receipt with none of
 ; result-edn/error/interrupted-at is running, and there is no stored
 ; status restating which of those facts exist.
 :seon.cluster.eval/interrupted-at :inst
 :seon.cluster.run/agent :seon.db/ref
 :seon.cluster.run/closed-at :inst
 :seon.cluster.run/forms [:set {:seon.db/component true} :seon.db/ref]
 :seon.cluster.run/id [:string {:min 1 :seon.db/identity true}]
 :seon.cluster.run/missing-results [:int {:min 0}]
 :seon.cluster.run/opened-at :inst
 ; Why a run ended before it had a plan — a lost model call, an
 ; unreadable reply. Without it the error value EVAPORATED: the live
 ; drive sat claimed-with-no-plan for 120 s and the operator had to
 ; reproduce the call by hand to learn it was a missing credential.
 :seon.cluster.run/error [:string {:min 1}]

 :seon.cluster.run/plan-digest [:string {:min 1}]
 :seon.cluster.run/process [:string {:min 1}]
 ; Custody IS presence (custody revision 2026-07-28): `/process`
 ; present = held, absent = unheld. There is no claim epoch and no
 ; lease clock — the flock + single writer make a competing claimant
 ; unrepresentable, and the settle-once presence fences carry the rest.
 :seon.cluster.run/run [:map {:seon.db/entity true :seon.render/ai seon.cluster.run/render-ai :seon.render/html seon.cluster.run/render-html} [:seon.cluster.run/id :seon.cluster.run/id] [:seon.cluster.run/agent :seon.cluster.run/agent] [:seon.cluster.run/opened-at :seon.cluster.run/opened-at] [:seon.cluster.run/closed-at {:optional true} :seon.cluster.run/closed-at] [:seon.cluster.run/process {:optional true} :seon.cluster.run/process] [:seon.cluster.run/plan-digest {:optional true} :seon.cluster.run/plan-digest] [:seon.cluster.run/error {:optional true} :seon.cluster.run/error]]
 ; The ordered form entity. Same reason as the message map: without it
 ; only `/id` installed, so a frozen plan could not be transacted on the
 ; live boot path. Every entry is required — `plan-call` writes all four
 ; together or writes none (run.cljc:409-417).
 :seon.cluster.run.form/form
 [:map {:seon.db/entity true
        :seon.render/ai seon.cluster.run/render-form-ai
        :seon.render/html seon.cluster.run/render-form-html}
  [:seon.cluster.run.form/id :seon.cluster.run.form/id]
  [:seon.cluster.run.form/run :seon.cluster.run.form/run]
  [:seon.cluster.run.form/ordinal :seon.cluster.run.form/ordinal]
  [:seon.cluster.run.form/source :seon.cluster.run.form/source]
  ; Parse-time namespace-in-effect. Optional until the one reader's
  ; plan-row integration lands; absence routes a red form to its author.
  [:seon.cluster.run.form/ns
   {:optional true}
   :seon.cluster.run.form/ns]]

 ; The eval receipt entity. The optionals ARE the states — absence is
 ; the state, never a stored nil and never a status label: a running
 ; receipt has no result, no error and no interrupted-at; a settled one
 ; has a result; a failed or time-limited one has an error and the flat
 ; error value as its result; a cut one has interrupted-at. There is no
 ; fourth fact for a discriminator to restate (owner ruling 2026-07-28).
 :seon.cluster.eval/receipt
 [:map {:seon.db/entity true
        :seon.render/ai seon.cluster.run/render-receipt-ai
        :seon.render/html seon.cluster.run/render-receipt-html}
  [:seon.cluster.eval/id :seon.cluster.eval/id]
  [:seon.cluster.eval/run :seon.cluster.eval/run]
