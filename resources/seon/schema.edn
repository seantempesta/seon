   :seon.cluster.eval/result-blob]
  [:seon.cluster.eval/result-size {:optional true}
   :seon.cluster.eval/result-size]
  [:seon.cluster.eval/error {:optional true} :seon.cluster.eval/error]
  [:seon.cluster.eval/interrupted-at {:optional true}
   :seon.cluster.eval/interrupted-at]
  ; An unambiguous agent-held identity for the derived problem. The
  ; receipt and form identities intentionally share `[run ordinal]`, so
