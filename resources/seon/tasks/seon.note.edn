[{:seon.task/id        :seon.note.task/about-is-a-value
  :seon.task/intent    "What a note is about is an observed name (a function, key or task), not a ref: as a ref it can only name stored entities and is swept when its target goes. One value attribute per value type."
  :seon.task/subjects  #{seon.note/add! seon.note/add-note-call}
  :seon.task/schemas   {:my.note/about-symbol [:qualified-symbol {:description "The function, test or namespace this note is about; survives the target's deletion."}]
                        :my.note/about-key    [:qualified-keyword {:description "The schema key or task this note is about."}]}
  :seon.task/done-when [(true? (seon.schema/valid? :my.note/about-symbol 'seon.db/pull))
                        (true? (seon.schema/valid? :my.note/about-key :my.note/content))]}

 {:seon.task/id        :seon.note.task/render-any-subject
  :seon.task/intent    "Note renderers are hard-wired to plan items; a note about anything else renders as \"a related record\"."
  :seon.task/subjects  #{seon.note/render-note-ai seon.note/render-note-html seon.note/note-line seon.note/note-html}
  :seon.task/done-when [(clojure.string/includes?
                         (seon.note/render-note-ai #:my.note{:id "n1" :agent [:seon.agent/id "root"] :content "slow"
                                                             :about-symbol 'seon.db/pull})
                         "seon.db/pull")]}

 {:seon.task/id        :seon.note.task/declared-refusals
  :seon.task/intent    "Refusals are hand-built ex-info maps although my.note.edn declares each refusal's schema; they should be the declared values."
  :seon.task/subjects  #{seon.note/add-note-call seon.note/forget-note-call}
  :seon.task/done-when [(true? (seon.schema/valid? :my.note/agent-not-found-error
                                                   (seon.note/add! "n1" "content" seon.db/*conn* "no-such-agent")))]}

 {:seon.task/id        :seon.note.task/one-read-for-many-notes
  :seon.task/intent    "notes and note-html read once per note; one query can return every row. RAISED: its first proof, (vector? (notes db \"root\")), already held on the base and proved nothing; triage must write a proof that fails today (a read count or a bound)."
  :seon.task/subjects  #{seon.note/notes seon.note/note-html}}

 {:seon.task/id        :seon.note.task/guarantees
  :seon.task/intent    "No test reaches seon.note; add guarantees for add!, forget! and notes through the real writers."
  :seon.task/subjects  #{seon.note seon.note-test}
  :seon.task/done-when [(some #{'seon.note-test/add-then-forget-round-trips} (seon.fn/tests-reaching (seon.db/db) 'seon.note/add!))]}]
