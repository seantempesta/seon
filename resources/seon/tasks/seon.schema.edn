  :seon.task/subjects  #{seon.schema}
  :seon.task/requirements
  [(true?  (seon.schema/valid? :my.note/id "n1"))
   (false? (seon.schema/valid? :my.note/id 42))
   (map?   (seon.schema/explain :my.note/id 42))
   (nil?   (seon.schema/explain :my.note/id "n1"))]
  :seon.task/delivers  #{seon.schema/valid? seon.schema/explain}
  :seon.task/context   seon.task/implement}]
