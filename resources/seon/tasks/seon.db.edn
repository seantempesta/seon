[#:seon.task{:id "d6e3b775f474"
             :name "the-query-wrapper-costs-36x-datahike"
             :kind :function
             :intent "seon.db/q costs 107 us and 472 KB for a two-clause query against d/q's 3 us and 6 KB (36x time, 76x allocation): query-patterns/parsed-nodes are tree-seq walked 5 times per call, query-input-values 4 times, and armed private checks add about 70 us (encode-query-request 18, decode-query-result 16, query-value-type-error 12, query-attribute-error 9 us). A trivial root run issues 62 q and 43 pull, 10-35 ms. Compute patterns and input values once per call; db? was fixed in the fork (cefd8a2bf)."
             :must-read #{seon.db/q}
             :evidence #{"docs/research/agent-platform/landing/fix-write-cost-2026-09-26.md"
                         "docs/research/agent-platform/perf-profile-2026-09-26.md"}}
 #:seon.task{:id "991ce24cca22"
             :name "call-reach-is-recomputed-per-render"
             :kind :function
             :intent "stored-call-reach is recomputed on every render call (about 4 ms each; 2.2 GB in one debug-page window). Memoize it per commit and call identity."
             :must-read #{seon.db/stored-call-reach seon.render/render-call}
             :evidence #{"docs/research/agent-platform/landing/debug-context-page-2026-09-26.md"
                         "docs/research/agent-platform/perf-profile-2026-09-26.md"}}
 #:seon.task{:id "a8e1644f2c19"
             :name "the-sci-call-hook-pays-armed-database-resolution"
             :kind :function
             :intent "The call-preparation hook costs 4.8 us and 14 KB per SCI Var call, 77% of it inside db/db's armed internals (resolve-database-value), measured over 100,000 calls. It runs on every interpreted call. Resolve the database unarmed on the hook path."
             :must-read #{seon.call-preparation/hook seon.db/db seon.db/resolve-database-value}
             :evidence #{"docs/research/agent-platform/perf-profile-2026-09-26.md"}}
 #:seon.task{:id "0caf995ddc22"
             :name "arity-caches-copy-the-indexes"
             :kind :function
             :intent "seon.db/arity-commit-cache holds 92.6 MB at idle: two bases of 54 and 38 MB (one with 99,659 edges, 7,518 callers, 4,927 callees), whose edge-set, by-caller and by-callee copy what the EAVT index and the :seon.fn/calls AVET index already hold; bases evicted from arity-base-cache (LRU 4) stay alive in the commit cache (LRU 16); the content key holds 78k-datom vectors that keep loose datoms alive (1.48 M loose datoms, 160 MB heap-wide). Keep only candidates, checked, edges and bounds per value and read callers and callees from the indexes."
             :must-read #{seon.db/arity-mismatches}
             :evidence #{"docs/research/agent-platform/landing/mem-idle-2026-09-26.md"}}
 #:seon.task{:id "d46e436e65f4"
             :name "custody-scopes-widen"
             :kind :function
             :intent "Held custody is not a positive value: call-with-custody rebinds *conn* to any connection, including one conjured by branch-connection, seon.cluster.boot/connection or registry/active-branch-connection, all reachable from agent SCI. A branch agent read :cluster-default and its 23 agents; foreign-connection-error then compares the cluster with itself; call-without-custody clears *conn* so agent code looks like a JVM REPL; the db.clj:325 refusal teaches agents (seon.cluster.boot/connection 'default'); capability handlers such as seon.shell.jvm/run run without admission. Violates 'Authority comes only from held custody'. Needs the owner's delivery ruling (options: refuse delivery out of a branch, declared deliveries at the writer, or root pulling)."
             :must-read #{seon.db/branch-connection seon.db/call-with-custody seon.db/call-without-custody}
             :evidence #{"docs/research/agent-platform/landing/custody-authority-2026-09-26.md"
                         "docs/research/agent-platform/landing/fix-dogfood-api-2026-09-26.md"}}
 #:seon.task{:id "b2c9509deb26"
             :name "deletion-error-has-no-caller"
             :kind :function
             :intent "seon.db/deletion-error (18 lines) has zero callers in src, test, script and default's program graph (agent-centric F01 residue). Delete it."
             :must-read #{seon.db/deletion-error}
             :evidence #{"docs/research/agent-platform/landing/delete-r8-r6-r10-2026-09-26.md"
                         "docs/research/agent-platform/landing/standing-deletion-2026-09-26.md"}}
 #:seon.task{:id "126f25106b63"
             :name "a-query-refusal-holds-a-parser-object"
             :kind :function
             :intent "A seon.db/q refusal's :seon.error/offending holds a datalog.parser.type.Placeholder host object instead of the authored clause, so an honest [:or [:vector ...] :seon.db/error-result] contract still refuses the returned refusal."
             :must-read #{seon.db/q}
             :evidence #{"docs/research/agent-platform/dogfood-report-2026-09-26.md"
                         "docs/research/agent-platform/landing/agent-test-worlds-2026-09-26.md"}}
 #:seon.task{:id "4bb788513862"
             :name "the-checked-writer-is-slow-on-a-fresh-branch"
             :kind :function
             :intent "A test request's 8-datom overlay write takes 480-620 ms, 211 ms of it write-report-error; root runs pay 8-9 ms of it over 3 transactions. Make the checked writer's report validation cost follow the written datoms. Named cause (2026-09-26, commit-floor): every agent settlement adds its turn to :seon.runtime/turns, a cardinality-many component, so write-owned-values-error expands the runtime's whole owning value, every turn the agent ever ran: 10.8 ms at 179 turns, 12.3 ms at 219 (about 37 us per turn, on the writer, per form), unbounded until :seon.config.db/validation-node-limit refuses the agent's writes. Validate the changed children and the owner's own attributes, or drop the runtime->turns edge that :seon.turn/agent already derives."
             :must-read #{seon.db/transact! seon.db/write-report-error seon.db/write-owned-values-error}
             :evidence #{"docs/research/agent-platform/commit-floor-2026-09-26.md"
                         "docs/research/agent-platform/landing/fix-test-request-cost-2026-09-26.md"
                         "docs/research/agent-platform/landing/fix-write-cost-2026-09-26.md"
                         "docs/research/agent-platform/landing/perf-admit-tests-opus-2026-09-26.md"}}
 #:seon.task{:name "admission-without-projection-embeds-its-error"
             :kind :function
             :intent "Since 9b8c5b405 the writer no longer carries the schema projection on a report's :db-before/:db-after; admitting such a report with no projection named returns {:opaque ... :projection-error ...} embedded in the value instead of refusing. AGENTS: derive missing profiles at entry or refuse explicitly. Admission derives the projection from the database value it is handed, or refuses naming the missing projection (rearm-scope-2, 0e63403d2)."
             :evidence #{"docs/research/agent-platform/red-triage-3-2026-09-27.md"}}
 #:seon.task{:name "a-report-db-before-names-a-stale-commit"
             :kind :function
             :intent "A transaction report's :db-before is the writer's uncommitted previous value, whose commit id is the branch point (three writes on one branch: every :db-before named the same commit, E2; writer.cljc:210). accept-merge! records (db/commit-id (:db-before report)) as :seon.source/base-commit-id, so the accepted value names a stale base (merge-test). Derive the base from the committed :db-after's parents minus the merged parents, and make commit-id refuse or name an uncommitted value instead of answering a stale id."
             :must-read #{seon.db/commit-id seon.cluster.source/accept-merge!}
             :evidence #{"docs/research/agent-platform/red-triage-r6-2026-09-27.md"}}
 #:seon.task{:name "q-lets-a-dependency-throw-escape"
             :kind :function
             :intent "seon.db/q threw a raw NullPointerException from Datahike's post-filter-not-joins instead of answering an error value (lowering fixed in f7a664c2f, E3). Catch the dependency's throw at the owner and answer the declared read refusal carrying the whole cause chain."
             :must-read #{seon.db/q}
             :evidence #{"docs/research/agent-platform/red-triage-r6-2026-09-27.md"}}
 #:seon.task{:name "read-evidence-carries-result-digests"
             :kind :function
             :intent "Per-file derivation keys (seon.cluster/derivation-keys) name the deriving code but not the database owner's read path: a read-path change that alters logical read results would leave reused entities derived from the old results. Retain a result digest in the read evidence a publication's derivation captures (seon.db/read-evidence with :seon.db/retain-read-results?) and replay it at the next publication, so such a change re-derives exactly the files whose reads answer differently."
             :must-read #{seon.db/read-evidence seon.db/read-evidence-current? seon.cluster/derivation-keys}
             :evidence #{"tmp/boot-source-perf/evidence.md"}}
 #:seon.task{:name "encoding-only-storage-changes-migrate-reused-entities"
             :kind :function
             :intent "A publication reuses every file entity whose derivation key is unchanged (seon.cluster/derivation-keys), so a storage encoding change without a schema change (seon.schema.datahike's codec, vector cells) leaves reused entities in the old encoding. Storage migration owns it: an encoding change ships its migration transaction (as seon.db/vector-migration-tx did), never a re-derivation."
             :must-read #{seon.db/vector-migration-tx seon.cluster/derivation-keys}
             :evidence #{"tmp/boot-source-perf/evidence.md"}}
 #:seon.task{:name "a-root-pull-past-the-pattern-bound-invalidates-on-any-write-of-its-attributes"
             :kind :function
             :intent "Since 9ac21b93f a captured read keeps at most 128 index patterns. The render walk's root pull selects every installed attribute (1,279 on default), so its evidence carries 1,280 entity-bound patterns, drops them all and keeps only the attribute set: any write of any of those attributes on ANY entity invalidates the root. root-pull-test unrelated-entity-change-keeps-root-read-current is red on default at 18:07 local 2026-09-27 (candidate-call-ids non-empty after writing ::value on an unrelated entity; the evidence source has no :seon.db/read-index-patterns). Keep a bounded read precise when its patterns share an entity: collapse them to {:seon.db/pattern-entity eid} per pulled entity before applying the bound."
             :must-read #{seon.db/read-evidence seon.db/read-evidence-current? seon.render.walk/root-acquisition}
             :evidence #{"test/seon/render/root_pull_test.clj"}}
 #:seon.task{:name "the-first-population-regression-still-refuses"
             :kind :function
             :intent "cfa78ac98 (r6 E5) landed seon.db-test/a-first-population-is-judged-by-the-declarations-it-installs, and that regression errors on default (r8 at 7533e982d and again at 18:07 local 2026-09-27): the fixture's first program write is refused 'This operation requires a carried schema projection' from seon.db/construction-projection (db.clj:1554) inside the writer, :seon.db/refused-read-operation seon.db/carried-projection. Separately, declaration-population-test reads-require-their-carried-projection-including-transaction-results: seon.db/pull on a raw value with no projection now answers instead of refusing, and no projection-fallback warning is written."
             :must-read #{seon.db/transact! seon.db/carried-projection seon.db/pull}
             :evidence #{"test/seon/db_test.clj" "test/seon/db/declaration_population_test.clj"}}]
