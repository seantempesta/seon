             :evidence #{"docs/research/agent-platform/landing/agent-path-2-2026-09-26.md"}}
 #:seon.task{:name "host-bound-class-list-copies-interpreter-config"
             :kind :function
             :intent "Class usage marks a declaration host-bound from a copied SCI class list although the interpreter resolves every class; (java.util.Date.) refuses on later calls. Executability must come from the configured interpreter (Astra M1)."
             :must-read #{seon.fn/host-bound-callers seon.sci.eval/build-base-ctx}
