             :evidence #{"docs/research/agent-platform/landing/program-test-candidate-projection-2026-09-27.md"}}
 #:seon.task{:name "interpreted-rows-lack-own-namespace-class-imports"
             :kind :function
             :intent "A deftype/defrecord imports its class into its own namespace implicitly, but no `:seon.ns/imports` fact names it, so SCI cannot resolve its short class name: `seon.cluster.agent/graph-definition` (CountedSlidingBuffer., agent.clj:596) fails to interpret in any branch whose change reaches it and, since the root-applied probe-acq fix, refuses by name when called instead of running. install-caller-host-bindings! (eval.clj ~2320) also carries the loaded namespace's own-class imports; then update the graph-definition assertion in branch_execution_test (an-unoverridden-host-bound...)."
             :must-read #{seon.sci.eval/install-caller-host-bindings!}
             :evidence #{"docs/research/agent-platform/landing/whole-acquisition-refusal-2026-09-27.md"}}
 #:seon.task{:name "copied-jvm-import-hides-sci-import"
             :kind :function
             :intent "F1: defrecord, deftype and import fail in agent namespaces because the JVM import macro is copied into the SCI context (sci/eval.clj ~2370-2400) and shadows SCI's own import special form (sci analyzer.cljc:1843, records.cljc:474, deftype.cljc:663); plain SCI runs them. Stop copying SCI's special-form names into namespaces (11 corpus items)."
             :evidence #{"docs/research/agent-platform/valid-clojure-corpus-probe-2026-09-27.md"}}
 #:seon.task{:name "non-defn-definitions-store-no-entity"
             :kind :function
             :intent "F11: defmacro, defmulti, defprotocol and defonce evaluate but silently store no program entity (15 corpus items); only defn/def are recorded. Every definition SCI interns is observed and recorded (the eval-path redesign's invariant: SCI is the authority for what was defined)."
             :evidence #{"docs/research/agent-platform/valid-clojure-corpus-probe-2026-09-27.md"}}
 #:seon.task{:name "defmacro-in-let-loses-its-location"
