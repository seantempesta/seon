 :seon.flow/changed-source :string
 :seon.flow/channel [:fn {:gen/gen seon.flow/channel-generator} seon.flow/channel?]
 ; Callback contracts are function schemas, not predicate-shaped escape
 ; hatches. Malli therefore constructs real functions from their output
 ; schemas and the recurring flow gate invokes them with generated inputs.
 :seon.flow/callback-result
 [:or :nil :map
  [:vector :seon.schema/value]
  [:set :seon.schema/value]
  [:sequential :seon.schema/value]
  :string :keyword :symbol :boolean :int :double :uuid :inst]
 :seon.flow/core-fault :map
 :seon.flow/commit-drop!
 [:=> [:cat :seon.flow/core-fault] :seon.flow/callback-result]
 :seon.flow/commit-fault!
 [:=> [:cat :seon.flow/core-fault] :seon.flow/callback-result]
 :seon.flow/changed-namespace-request
 [:map {:closed true}
  [:seon.flow/changed-namespace :seon.flow/changed-namespace]
  [:seon.flow/changed-source :seon.flow/changed-source]]
 :seon.flow/compile-namespace-fn
 [:=> [:cat :seon.flow/changed-namespace-request]
  :seon.store/transaction-operation]
 :seon.flow/compute-timeout-ms [:int {:min 1}]
 :seon.flow/deliver!
 [:=> [:cat :seon.sci.admit/value] :seon.flow/callback-result]
 :seon.flow/error-fanout [:map [:seon.flow/graph :seon.flow/graph] [:seon.flow/fault-graph :seon.flow/graph] [:seon.flow/application-report-channel :seon.flow/channel] [:seon.flow/monitor-report-channel :seon.flow/channel] [:seon.flow/monitor-error-channel :seon.flow/channel] [:seon.flow/fault-channel :seon.flow/channel] [:seon.flow/completion :seon.flow/channel]]
 :seon.flow/error-fanout-request [:map [:seon.flow/graph :seon.flow/graph] [:seon.flow/started [:map [:report-chan :seon.flow/channel] [:error-chan :seon.flow/channel]]] [:seon.flow/fault-buffer-capacity :seon.flow/buffer-capacity] [:seon.flow/monitor-buffer-capacity :seon.flow/buffer-capacity] [:seon.flow/read-core-error-mode :seon.flow/read-core-error-mode] [:seon.flow/commit-fault! :seon.flow/commit-fault!] [:seon.flow/commit-drop! :seon.flow/commit-drop!] [:seon.flow/panic! :seon.flow/panic!]]
 :seon.flow/escalated? :boolean
