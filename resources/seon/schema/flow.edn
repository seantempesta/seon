 :seon.flow/eval-proc-request [:map [:seon.flow/parallelism :seon.flow/parallelism] [:seon.flow/active-evals :seon.flow/active-evals] [:seon.flow/compute-timeout-ms :seon.flow/compute-timeout-ms]]
 :seon.flow/executor [:fn {:gen/gen seon.flow/executor-generator} seon.flow/executor?]
 :seon.flow/failure-count [:int {:min 0}]
 :seon.flow/fault-committer-proc-request [:map [:seon.flow/fault-channel :seon.flow/channel] [:seon.flow/completion :seon.flow/channel] [:seon.flow/read-core-error-mode :seon.flow/read-core-error-mode] [:seon.flow/commit-fault! :seon.flow/commit-fault!] [:seon.flow/panic! :seon.flow/panic!]]
 :seon.flow/completion :seon.flow/channel
 :seon.flow/fix-outcome [:enum :seon.flow/fix-succeeds :seon.flow/fix-fails :seon.flow/fix-breaks-other-namespace :seon.flow/no-response]
 :seon.flow/fix-step-fn
 [:=> [:cat :map] :seon.flow/fix-outcome]
