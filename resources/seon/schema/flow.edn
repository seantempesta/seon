{:seon.config.flow.compute/concurrency [:int {:min 1 :description "Concurrent compute submissions. Default equals the acquired :seon.hardware/cores fact, preserving the measured pre-Flow availableProcessors bound without a runtime fallback."}]
 :seon.config.flow.compute/queue-depth [:int {:min 1 :description "Queued compute submissions. Default 10 preserves core.async.flow's fixed per-channel default at alpha3; a full channel parks the submitter and loses no work."}]
 :seon.flow/active-evals [:fn {:gen/gen seon.flow/atom-reference-generator} seon.flow/atom-reference?]
 :seon.flow/active-work [:fn {:gen/gen seon.flow/atom-reference-generator} seon.flow/atom-reference?]
 :seon.flow/admitted? :boolean
 :seon.flow/attempt [:int {:min 0}]
 :seon.flow/buffer-capacity [:int {:min 1}]
