 :seon.flow/mailbox-request [:map [:seon.flow/deliver! :seon.flow/deliver!]]
 :seon.flow/max-failures [:int {:min 1}]
 :seon.flow/max-turns [:int {:min 1}]
 :seon.flow/namespace-owner-proc-request [:map [:seon.flow/fix-step-fn :seon.flow/fix-step-fn]]
 :seon.flow/owner-count [:int {:min 1}]
 :seon.flow/owner-ordinal [:int {:min 0}]
 :seon.flow/panic!
 [:=> [:cat :seon.flow/core-fault] :seon.flow/callback-result]
 :seon.flow/parallelism [:int {:min 1}]
 :seon.flow/plan-step-fn [:=> [:cat :map] :map]
 :seon.flow/planner-proc-request [:map [:seon.flow/plan-step-fn :seon.flow/plan-step-fn]]
 :seon.flow/read-core-error-mode [:=> [:cat] :seon.config/on-core-error]
 :seon.flow/read-sources [:=> [:cat] :seon.flow/sources]
 :seon.flow/seed :int
 :seon.flow/seeded-outcome-request [:map [:seon.flow/seed :seon.flow/seed] [:seon.flow/owner-ordinal :seon.flow/owner-ordinal] [:seon.flow/attempt :seon.flow/attempt]]
 :seon.flow/source-enumerator-proc-request [:map [:seon.flow/read-sources :seon.flow/read-sources]]
 :seon.flow/sources [:map-of :symbol :string]
 :seon.flow/submission-id [:or :uuid :keyword :string]
 :seon.flow/submission-wait-ms [:int {:min 0}]
 :seon.flow/work-result
 [:or
  [:map {:closed true}
   [:seon.flow/outcome [:= :seon.flow/time-limit]]
   [:seon.flow/submission-wait-ms :seon.flow/submission-wait-ms]]
  [:map {:closed true}
   [:seon.flow/outcome [:= :seon.flow/completed]]
   [:seon.flow/value :seon.sci.admit/value]
   [:seon.flow/submission-wait-ms :seon.flow/submission-wait-ms]]]
 :seon.flow/successful-owners [:set :keyword]
 :seon.flow/turn-count [:int {:min 0}]
 :seon.flow/started! [:=> [:cat] :nil]
 :seon.flow/work-call
 [:or
  [:map {:closed true}
   [:seon.flow/started! :seon.flow/started!]]
  [:map {:closed true}
   [:seon.flow/interrupt-fn :seon.sci.admit/interrupt-fn]]]
 :seon.flow/work-fn
 [:=> [:cat :seon.flow/work-call] :seon.sci.admit/value]
 :seon.flow/work-launcher-request [:map {:closed true} [:seon.flow/configuration :seon.flow/launcher-configuration]]
 :seon.flow/work-submission [:map {:closed true} [:seon.flow/submission-id :seon.flow/submission-id] [:seon.flow/workload :seon.flow/workload] [:seon.flow/work-fn :seon.flow/work-fn] [:seon.flow/time-limit-ms :seon.flow/compute-timeout-ms]]
 :seon.flow/workload [:enum :compute]}
