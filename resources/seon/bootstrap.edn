 {:seon.cluster.run.form/source
  "(defn largest
  \"The row with the largest :amount.\"
  {:malli/schema [:=> [:cat [:sequential :any]]
                  [:map [:label :string] [:amount :int]]]}
  [rows]
  (last (sort-by :amount rows)))"
  :seon.bootstrap.plan.form/namespace-source :agent}
 {:seon.cluster.run.form/source
  "(defn largest
  \"The row with the largest :amount; {} when there are none.\"
  {:malli/schema [:=> [:cat [:sequential [:map [:label :string] [:amount :int]]]]
                  [:map [:label {:optional true} :string] [:amount {:optional true} :int]]]}
  [rows]
  (or (last (sort-by :amount rows)) {}))"
  :seon.bootstrap.plan.form/namespace-source :agent}
