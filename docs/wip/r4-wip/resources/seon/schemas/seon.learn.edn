;; The learning loop (lane R4): templates as data with a version and an estimate, the facts that
;; tie a task to the template version that made it, the judge's refusals on the attempt, the
;; derived grade and row values, the verdict between two arms; and recorded errors (one
;; entity per signature, its count, the task that answers it, its resolution).
;; Stored attributes are the members of the maps marked {:seon.db/attributes true}.
{;; ---- templates (values; a template lives in code, its version is its content digest) ----
 :seon.template/name :keyword
 :seon.template/version [:string {:min 16 :max 16}]
 :seon.template/estimate [:map {:closed true} [:turns pos-int?] [:tokens pos-int?]]
 :seon.template/embed [:map {:closed true}
                       [:from [:vector [:enum :instructions :plan :red :conflicts :error]]]
                       [:search [:enum :code :tests :tasks :near-dup]]
                       [:k pos-int?]]
 :seon.template/template [:map {:closed true}
                          [:seon.template/name :seon.template/name]
                          [:seon.task/kind :seon.task/kind]
                          [:seon.task/instructions :seon.task/instructions]
                          [:seon.template/estimate :seon.template/estimate]
                          [:seon.template/embed {:optional true} :seon.template/embed]
                          [:seon.template/replaces {:optional true} :seon.template/version]]
 ;; ---- stored on the task by the one task writer; the attempt's judge stores the refusals ----
 :seon.task/template [:and {:seon.db/index true} :keyword]
 :seon.task/template-version [:and {:seon.db/index true} :seon.template/version]
 :seon.task/about [:and {:seon.db/index true} :string]
 ;; K1's reference facts on a definition (stage 8 stores them; the name is this lane's stand-in)
 :var/refs [:set :qualified-symbol]
 :seon.learn/var-refs-fact [:map {:seon.db/attributes true} [:var/refs {:optional true} :var/refs]]
 :seon.learn/task-fact [:map {:seon.db/attributes true}
                        [:seon.task/template {:optional true} :seon.task/template]
                        [:seon.task/template-version {:optional true} :seon.task/template-version]
                        [:seon.task/about {:optional true} :seon.task/about]]
 :seon.attempt/refusals [:set :keyword]
 ;; waste charged to the producer of what the agent was shown (census idea 14): producer -> counts
 :seon.learn/waste [:map-of {:seon.db/edn true} :any [:map [:forms :int] [:turns :int]]]
 :seon.attempt/waste :seon.learn/waste
 :seon.end/waste :seon.learn/waste
 :seon.learn/end-fact [:map {:seon.db/attributes true} [:seon.end/waste {:optional true} :seon.end/waste]]
 :seon.attempt/prompt-tokens :int
 :seon.attempt/completion-tokens :int
 :seon.learn/attempt-fact [:map {:seon.db/attributes true}
                           [:seon.attempt/refusals {:optional true} :seon.attempt/refusals]
                           [:seon.attempt/waste {:optional true} :seon.attempt/waste]
                           [:seon.attempt/prompt-tokens {:optional true} :seon.attempt/prompt-tokens]
                           [:seon.attempt/completion-tokens {:optional true} :seon.attempt/completion-tokens]]
 ;; ---- derived values (never stored) ----
 :seon.learn/grade [:map {:closed true}
                    [:task :seon.task/id] [:kind :seon.task/kind]
                    [:template [:maybe :keyword]] [:version [:maybe :string]]
                    [:done? :boolean] [:attempts nat-int?] [:turns nat-int?] [:tokens nat-int?] [:ms nat-int?]
                    [:outcome [:maybe :keyword]] [:refusals [:map-of :keyword pos-int?]]]
 :seon.learn/row [:map {:closed true}
                  [:kind :seon.task/kind] [:template [:maybe :keyword]] [:version [:maybe :string]]
                  [:n nat-int?] [:done nat-int?] [:open nat-int?] [:rate [:maybe number?]]
                  [:ttg-p50 [:maybe number?]] [:ttg-p90 [:maybe number?]] [:tokens-p50 [:maybe number?]]
                  [:over nat-int?] [:outcomes [:map-of :keyword pos-int?]] [:refusals [:map-of :keyword pos-int?]]
                  [:worst [:vector :seon.task/id]]]
 :seon.learn/dials [:map {:closed true}
                    [:window pos-int?] [:min-n pos-int?] [:floor number?] [:slack number?]
                    [:trial-n pos-int?] [:z number?]]
 :seon.learn/flag [:map {:closed true} [:rule [:enum :success-below-floor :turns-over-estimate]] [:reason :string]]
 :seon.learn/verdict [:map {:closed true}
                      [:decided? :boolean] [:winner {:optional true} :seon.template/version]
                      [:loser {:optional true} :seon.template/version]
                      [:by {:optional true} [:enum :success :turns :no-gain]]
                      [:z {:optional true} number?] [:n [:tuple nat-int? nat-int?]]]
 :seon.learn/hit [:map {:closed true} [:symbol :qualified-symbol] [:score number?] [:found [:= true]]]

 ;; ---- recorded errors: one entity per signature (main, written by root's api proc) ----
 :seon.error/signature [:and {:seon.db/identity true} [:string {:min 16 :max 16}]]
 :seon.error/count :int
 :seon.error/agents :int
 :seon.error/first-ms :int
 :seon.error/last-ms :int
 :seon.error/producer :qualified-symbol
 :seon.error/producer-src :string
 :seon.error/example :string
 :seon.error/form :string
 :seon.error/task :seon.db/ref
 :seon.error/generation :int
 :seon.error/resolved-ms :int
 :seon.error/recorded-fact [:map {:seon.db/attributes true}
                            [:seon.error/signature :seon.error/signature]
                            [:seon.error/count :seon.error/count]
                            [:seon.error/type {:optional true} :seon.error/type]
                            [:seon.error/operation {:optional true} :seon.error/operation]
                            [:seon.error/message {:optional true} :seon.error/message]
                            [:seon.error/agents {:optional true} :seon.error/agents]
                            [:seon.error/first-ms :seon.error/first-ms] [:seon.error/last-ms :seon.error/last-ms]
                            [:seon.error/producer {:optional true} :seon.error/producer]
                            [:seon.error/producer-src {:optional true} :seon.error/producer-src]
                            [:seon.error/example :seon.error/example]
                            [:seon.error/form {:optional true} :seon.error/form]
                            [:seon.error/task {:optional true} :seon.error/task]
                            [:seon.error/generation {:optional true} :seon.error/generation]
                            [:seon.error/resolved-ms {:optional true} :seon.error/resolved-ms]]
 ;; one occurrence, as the entrant boundary sees it (value; never stored whole)
 :seon.error/occurrence [:map
                         [:error :map] [:cause [:vector :any]] [:producer [:maybe :qualified-symbol]]
                         [:agent [:maybe :keyword]] [:form [:maybe :string]] [:ms :int]]
 ;; the fold in the recording proc's state: signature -> its running record
 :seon.error/fold [:map-of [:vector :any]
                   [:map [:signature :seon.error/signature] [:count pos-int?] [:agents [:set :keyword]] [:first-ms :int] [:last-ms :int]
                    [:example :map] [:producer [:maybe :qualified-symbol]] [:form [:maybe :string]] [:dirty? :boolean]]]
 :seon.error/dials [:map {:closed true} [:min-count pos-int?] [:min-agents pos-int?] [:max-generation nat-int?]]
 :seon.error/record [:map
                     [:seon.error/signature :seon.error/signature] [:seon.error/count :int]
                     [:seon.error/first-ms :int] [:seon.error/last-ms :int] [:seon.error/example :string]
                     [:seon.error/type {:optional true} :qualified-keyword]
                     [:seon.error/operation {:optional true} :qualified-symbol]
                     [:seon.error/agents {:optional true} :int]
                     [:seon.error/producer {:optional true} :qualified-symbol]
                     [:seon.error/producer-src {:optional true} :string]
                     [:seon.error/form {:optional true} :string]
                     [:seon.error/task {:optional true} [:maybe :seon.task/id]]
                     [:seon.error/generation {:optional true} :int]
                     [:seon.error/resolved-ms {:optional true} :int]]
 :seon.error/action [:multi {:dispatch :op}
                     [:file [:map {:closed true} [:op [:= :file]] [:signature :seon.error/signature]]]
                     [:resolve [:map {:closed true} [:op [:= :resolve]] [:signature :seon.error/signature]
                                [:why [:enum :producer-deleted :producer-changed-green]]]]]}
