+(def templates
+  "Every template as a value (lane R4): its kind, its instructions and its estimate of
+  turns-to-green and tokens, stated before any task ran (method.md: estimate first). The
+  version a task was made from is stamped on it (seon.learn/stamp); a candidate names the
+  version it :seon.template/replaces and runs beside it until seon.learn/verdict."
+  (let [m {:merge {:seon.template/name :merge :seon.task/kind :merge :seon.task/instructions (instructions :merge)
+           :seon.template/estimate {:turns 2 :tokens 6000}
+           :seon.template/embed {:from [:conflicts] :search :near-dup :k 5}}
+   :design {:seon.template/name :design :seon.task/kind :design :seon.task/instructions (instructions :design)
+            :seon.template/estimate {:turns 3 :tokens 9000}
+            :seon.template/embed {:from [:instructions :plan] :search :tasks :k 5}}
+   :implement {:seon.template/name :implement :seon.task/kind :implement :seon.task/instructions (instructions :implement)
+               :seon.template/estimate {:turns 3 :tokens 9000}
+               :seon.template/embed {:from [:red :plan] :search :code :k 5}}
+   :test {:seon.template/name :test :seon.task/kind :test :seon.task/instructions (instructions :test)
+          :seon.template/estimate {:turns 2 :tokens 6000}
+          :seon.template/embed {:from [:plan] :search :tests :k 5}}
+   ;; lane R4's measured pair: the same work instructions, without and with the embedding query
+   :work {:seon.template/name :work :seon.task/kind :work
+          :seon.task/instructions "Make the proofs pass by defining the functions the plan names, in their namespaces."
+          :seon.template/estimate {:turns 2 :tokens 6000}}
+   :defect-prove {:seon.template/name :defect-prove :seon.task/kind :design
+                  :seon.task/instructions
+                  (str "Seon itself failed: the evidence holds the signature, the printed error, the failing form, the "
+                       "producer's definition and its callers. Write one deftest that reproduces the failure through the "
+                       "producer's caller that passes the bad value, add it to the proofs "
+                       "(my.task/update! :seon.task/proofs conj 'ns/test-name), and say in the plan which producer must "
+                       "change and why. Then (my.turn/wait).")
+                  :seon.template/estimate {:turns 3 :tokens 9000}
+                  :seon.template/embed {:from [:error] :search :tests :k 5}}
+   :defect-fix {:seon.template/name :defect-fix :seon.task/kind :work
+                :seon.task/instructions
+                (str "Fix the producer the plan names so the reproducing proof passes: tighten its contract at the "
+                     "producer so this class of error is refused at its source, and change its body. Never add a check "
+                     "beside it. Improve the plan with what you learn.")
+                :seon.template/estimate {:turns 3 :tokens 9000}
+                :seon.template/embed {:from [:red :plan] :search :code :k 5}}}]
+    ;; lane R4's measured candidate: :work plus the embedding query; it replaces :work's
+    ;; version (its version is a digest, so it is computed, never typed)
+    (assoc m :work-found (assoc (:work m) :seon.template/embed {:from [:plan :red] :search :code :k 5}
+                                :seon.template/replaces
+                                (learn/version (:work m))))))
