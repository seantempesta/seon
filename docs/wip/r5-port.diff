+(defn proc-failure
+  "Lane R5's finding: a root proc whose step throws must read as failed, not running. A
+  malformed message makes the flusher's step throw; then health says :failed for it (with
+  its error) and :running for the others, and the error is in the view."
+  []
+  (let [sys (c/start! {:datoms 2000})
+        before (:status (:flusher (c/health sys)))
+        _ @(flow/inject (:graph sys) [:flusher :in] [{:op :dirty :since "not a number"}])
+        h (loop [k 0] (let [h (c/health sys)] (if (or (= :failed (:status (:flusher h))) (> k 200)) h (do (Thread/sleep 10) (recur (inc k))))))
+        res {:before before :flusher (select-keys (:flusher h) [:status :error]) :writer (:status (:writer h))
+             :root-errors (count (:root-errors (c/state sys)))}
+        ok (and (= :running before) (= :failed (get-in res [:flusher :status])) (= :running (:writer res)) (pos? (:root-errors res)))]
+    (pprint res)
+    (c/stop! sys)
+    (out! (if ok "PROC-FAILURE OK" "PROC-FAILURE FAIL"))
+    (lib/c-exit (if ok 0 1))))
+
