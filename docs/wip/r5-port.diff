+(defn- changed-keys
+  "The program keys this branch changed since its merge base (seon.merge/three-way's :ours),
+  and that base."
+  {:malli/schema [:=> [:cat] [:tuple [:set :any] :seon.host/db]]}
+  []
+  (let [base (pdb/branch-base (:store-conn @agent/state) (:branch @agent/state))
+        bp (pm/program base #{})]
+    [(set (keys (:ours (pm/three-way bp (pm/program (agent/db) #{}) bp)))) base]))
+
