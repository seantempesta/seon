+(defn- phases
+  "Where an attempt's time went, from its facts (ms after release t1): when work and merge
+  attempts started and ended (p50 / max), and how long each ran."
+  [d t1]
+  (let [ts (task/tasks d)
+        as (vals (task/attempts d))
+        kind #(get-in ts [(:seon.attempt/task %) :seon.task/kind] :work)
+        q (fn [xs] (let [v (vec (sort xs))] (when (seq v) [(v (quot (count v) 2)) (peek v)])))
+        of (fn [k] (let [xs (filter #(= k (kind %)) as)]
+                     {:n (count xs)
+                      :start (q (map #(- (:seon.attempt/start-ms %) t1) xs))
+                      :end (q (keep #(some-> (:seon.attempt/end-ms %) (- t1)) xs))
+                      :ran (q (keep #(some-> (:seon.attempt/end-ms %) (- (:seon.attempt/start-ms %))) xs))}))]
+    {:work (of :work) :merge (of :merge)}))
