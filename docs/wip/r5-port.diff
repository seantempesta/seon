+    ;; each commit's datoms move the index (observe); a commit that is not main's next t
+    ;; lists main again (index), k8s's relist after a gap
+    :main (let [db (:db m) t (:max-tx db)
+                t0 (lib/now-ns)
+                idx (if (and (:idx st) (= t (inc (:t st))))
+                      (observe (:idx st) db (:ops m))
+                      (index db))
+                st (assoc st :db db :t t :idx idx :seen (inc (:seen st)) :lists (cond-> (:lists st 0) (not= t (inc (:t st -2))) inc))
+                st (update-in st [:busy-ms :observe] (fnil + 0.0) (lib/ms-since t0))
+                [st outs] (pass st)]
+            [st {:to-api (into [{:op :stat :k :main-seen-us :v (/ (- (sock/now-ns) (:ns m)) 1000.0)}] outs)}])
+    ;; a merge train's combined run ended (its agent's last frame)
+    :ci (let [[st outs] (ci-answer (update st :ci-ends #(vec (take-last 8 (conj (or % []) (ci-summary m))))) (:ci m) (:end m))]
+          [st {:to-api outs}])
+    :answers (let [tag (get-in st [:pending (:tag m)])
