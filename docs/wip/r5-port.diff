+(defn hand-back!
+  "An outside agent (seon.entrance) hands its attempt back: the task observed now (its
+  proofs and the tests reaching the branch's changes), and the attempt's end written and
+  sent to root's judge, as a turn loop's end is. Green when the done rule has no refusal.
+  The agent then stops (the entrance asks root), and its death delivers the end."
+  {:malli/schema [:=> [:cat :seon.task/id :seon.attempt/id] :seon.turn/end]}
+  [task attempt]
+  (swap! agent/state assoc :turn {:task task :attempt attempt})
+  (let [obs (observe task (base-gaps))
+        rs (:refusals obs)]
+    (end! {:turn 0 :tokens 0 :t0 (System/nanoTime) :attempt attempt :task task
+           :plan0 (:seon.task/plan (task/task (agent/db) task))}
+          obs (if (empty? rs) :green :cap) (when (seq rs) (str "handed back by an outside agent: " (r/refusals-text rs))))))
+
