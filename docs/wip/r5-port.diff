+(defn reaching-tests
+  "The program's tests on db whose definition reaches one of syms (fully qualified var
+  names): the tests among the vars that reach them, walked backwards once over the
+  references each recorded :var/src names (an unqualified symbol names its own namespace's
+  var, a qualified one a var of its namespace or alias). Static: a var reached only through
+  eval, resolve or a macro's expansion is not seen (the dragon of reach-by-source).
+  O(the program's definitions and references)."
+  {:malli/schema [:=> [:cat :seon.host/db [:set :qualified-symbol]] [:set :qualified-symbol]]}
+  [db syms]
+  (let [vars (vec (for [[n src] (d/q '[:find ?n ?src :where [?e :var/name ?n] [?e :var/src ?src]] db)] [n src (read-string src)]))
+        names (into #{} (map first) vars)
+        aliases (into {} (for [[ns a] (d/q '[:find ?ns ?a :where [?x :ns/name ?ns] [?x :ns/alias ?a]] db)
+                               :let [[al target] (read-string a)]]
+                           [[ns al] target]))
+        refs (fn [n form]
+               (let [own (symbol (namespace n))]
+                 (into #{} (keep (fn [s]
+                                   (let [q (if-let [sn (namespace s)]
+                                             (symbol (str (get aliases [own (symbol sn)] sn)) (name s))
+                                             (symbol (str own) (name s)))]
+                                     (when (and (names q) (not= q n)) q))))
+                       (filter symbol? (tree-seq coll? seq form)))))
+        back (reduce (fn [m [n _ form]] (reduce #(update %1 %2 (fnil conj #{}) n) m (refs n form))) {} vars)
+        reached (loop [front (vec (filter names syms)) seen (set (filter names syms))]
+                  (if-let [[x & more] (seq front)]
+                    (let [ns (remove seen (get back x))] (recur (into (vec more) ns) (into seen ns)))
+                    seen))
+        ;; a test is a deftest form (seeded definitions carry no :var/kind)
+        tests (into #{} (keep (fn [[n _ form]] (when (and (seq? form) (= "deftest" (some-> (first form) name))) n))) vars)]
+    (into #{} (filter tests) reached)))
