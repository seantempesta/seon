+(defn ci!
+  "A merge train's combined run (git's CI after the merge, for every member at once; R3's
+  slice 3): this agent's branch is main's head; every member's change since its merge base
+  merges onto it in one commit (clean by construction: the members are disjoint and each
+  holds main's program head), the changed definitions load here, and the tests reaching
+  any changed definition run (seon.program/reaching-tests: a test reaching none of them
+  cannot change). The run's results are written on this branch and sent to root's
+  reconciler in this process's last frame. Answers {:green :results :selected}."
+  {:malli/schema [:=> [:cat [:map [:ci [:map [:run :string] [:branches [:vector :seon.db/branch]]]]]] :map]}
+  [{{:keys [run branches]} :ci}]
+  (let [conn (:store-conn @agent/state)
+        main @conn
+        ours (fn [b] (let [bp (pm/program (pdb/branch-base conn b) #{})] (:ours (pm/three-way bp (pm/program (pdb/head conn b) #{}) bp))))
+        changes (into {} (for [b branches [k [_ ov]] (ours b)] [k ov]))
+        rep (d/merge-db conn (set branches) (pm/apply-tx main changes))
+        errs (program/load-changes! (:db-after rep) (pdb/report->tx rep))
+        _ (swap! agent/state assoc :db @conn)
+        syms (into #{} (keep (fn [[k s]] (when (= :var k) s))) (keys changes))
+        sel (program/reaching-tests (agent/db) syms)
+        results (if (seq sel) (proofs/results (agent/run-tests-forked 30000 sel)) {})
+        green? (and (empty? errs) (not-any? #{:fail :error} (vals results)))
+        end {:green green? :results results :selected (count sel) :load-errors (count errs) :changed (count syms)}]
+    (agent/transact! [{:seon.end/attempt run :seon.end/outcome (if green? :green :red)
+                       :seon.end/results (vec (for [[t st] results] {:seon.proof/test t :seon.proof/status st}))}])
+    (agent/commit!)
+    (agent/send! {:op :end :ci run :end end})
+    end))
+
