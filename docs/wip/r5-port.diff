+(defn- watch
+  "One line of root's own observation (each root proc's ping, live agents, root's MB, main's
+  t), at most every 10 s: a run that stops moving shows which proc stopped."
+  [sys]
+  (when (zero? (rem (quot (now) 250) 40))
+    (let [h (c/health sys 2000)]
+      (println :watch (now) :mb (lib/r2 (lib/real-mb)) :main-t (:max-tx (db sys))
+               (into {} (for [[k v] h] [k (if (map? v) (assoc (:state v) :status (:status v)) v)])))
+      (when-let [es (seq (:root-errors (c/state sys)))] (println :root-errors (count es) (pr-str (last es))))
+      (when (System/getenv "R5_PING")
+        (doseq [ag (keys (:agents (c/state sys)))] (println :agent-ping ag (c/agent-ping sys ag 1000) (c/agent-health sys ag 1000))))
