+(defn- answer
+  "The api's answer r to the request tagged tag. Answers [st outputs]."
+  {:malli/schema [:=> [:cat :map [:maybe [:vector :any]] :any] [:tuple :map [:vector :map]]]}
+  [st [aid kind members rest] r]
+  (case kind
+    :written [(-> st (update :writing disj aid) (update :starting disj aid)) []]
+    ;; no agent for the attempt (no room, or its branch held): its attempt is dead
+    :spawned (if (:error r)
+               (let [[st o] (write st aid (cas-tx aid :running :dead {:seon.attempt/end-ms (System/currentTimeMillis)
+                                                                      :seon.attempt/reason (str "no agent: " (:error r))}))]
