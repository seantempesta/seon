# W2 needs (root's src/seon/agent.clj): a cost proof's report keeps its rows and verdict as data.
#
# Why: the agent prints every report's :actual to a 256-token string (print/text ... :part).
# A cost proof's :actual is {:rows [...] :verdict {...}} (seon.cost/proof); printed and cut, it
# cannot be read back, so the dashboard's agent page cannot render it by its declared render
# (:seon.render/cost-report -> seon.render.ui/cost-report: a measured/estimate table per size
# and the verdict's OVER/STEEPER). Today the page shows the report's :message (cost/explain's
# text) instead. The data is small: one row per size (3-5) of three numbers each, plus the
# verdict. seon.render.ui/proof-row already reads :cost when present.
--- a/src/seon/agent.clj
+++ b/src/seon/agent.clj
@@ -241,5 +241,8 @@
-                                      (swap! reports conj {:type (:type m) :var (some-> (first t/*testing-vars*) str)
-                                                           :message (:message m)
-                                                           :expected (print/text (:expected m) (:part print/budgets)) :actual (print/text (:actual m) (:part print/budgets))}))
+                                      (swap! reports conj (cond-> {:type (:type m) :var (some-> (first t/*testing-vars*) str)
+                                                                   :message (:message m)
+                                                                   :expected (print/text (:expected m) (:part print/budgets)) :actual (print/text (:actual m) (:part print/budgets))}
+                                                            ;; a cost proof's measurements stay data (W2: the agent page renders them)
+                                                            (and (map? (:actual m)) (:verdict (:actual m))) (assoc :cost (:actual m)))))
                                     (orig m))
