+(defn- nearest-declared
+  "At most three functions or tests the namespace of `reference` declares on `database`, nearest it by their words and
+  spelling (`seon.error/nearest-names`): what a renamed name may be called now. Empty when the namespace declares none."
+  {:malli/schema [:=> [:cat :seon.db/database-value :qualified-symbol] [:vector :qualified-symbol]]}
+  [database reference]
+  (let [owner (symbol (namespace reference))
+        functions (db/q '[:find [?sym ...] :in $ ?ns :where [?n :seon.ns/name ?ns] [?f :seon.fn/ns ?n] [?f :seon.fn/sym ?sym]]
+                        database owner)
+        tests (db/q '[:find [?sym ...] :in $ ?ns :where [?n :seon.ns/name ?ns] [?t :seon.test/ns ?n] [?t :seon.test/sym ?sym]]
+                    database owner)]
+    (error/nearest-names reference (distinct (concat functions tests)) 3)))
+
