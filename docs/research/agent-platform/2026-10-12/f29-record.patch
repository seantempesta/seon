+(deftest ^{:seon/tasks #{'seon.merge/a-publication-that-throws-a-seon-error-is-refused-and-releases-its-claim}
+           :seon.test/long "One own-branch agent's first request and assignment, one gate (one prepare-merge!: a nested seon.test/run on a new candidate commit, 60 s is this namespace's measured bound for one), one facts merge and two db<->flow passes."
+           :seon.test/long-ms 180000}
+  a-publication-that-throws-a-seon-error-is-refused-and-releases-its-claim
+  (support/with-running-agent
+   (fn [running _ connection]
+     (let [member (get-in (db/db connection) [:config :branch])
+           cluster-name (:seon.cluster/name (support/execution-handle nil))
+           _ (db/transact! connection [[:db.fn/call #'host/home-call "root" member 'user cluster-name]])
+           path "test/tq/land.clj"
+           root (checkout! "throw-test" {path land-source})
+           _ (checkout-dial! connection root)
+           entities (fn/analyze-entities {:seon.fn/root root :seon.fn/roots ["test"]})
+           _ (support/transacted! connection (fn/reconcile-tx (db/db connection) entities (mapv program/row-identity entities)))
+           execution (support/running-cluster running)
+           ledger (io/file root "tmp/orchestrator/lanes")]
+       (try
+         (let [request (assigned! running connection "area"
+                                  "(defn area\n  \"The area.\"\n  {:malli/schema [:=> [:cat :int] :int]}\n  [r]\n  (* r r))")
+               merged (merge! execution request)
+               lane-file (io/file ledger (str "merge-" request ".paths"))]
+           (is (nil? (:seon.error/message merged)) "the merge answers no refusal")
+           ;; git cannot take the index: the publication's commit fails
+           (spit (io/file root ".git/index.lock") "")
+           (pass! running)
+           (let [{git-commit :seon.task/git-commit refused :seon.task/refusal} (assignment-row connection request)]
+             (is (= :seon.git/commit-error refused) "the thrown Seon error is recorded as the assignment's refusal")
+             (is (nil? git-commit) "and nothing is published"))
+           (is (not (.exists lane-file)) "the merge's claim is released")
+           (io/delete-file (io/file root ".git/index.lock"))
+           (pass! running)
+           (is (= :seon.git/commit-error (:seon.task/refusal (assignment-row connection request)))
+               "the refusal is final: a later pass neither retries nor changes it"))
+         (finally (support/delete-root! root)))))))
+
 (def ^:private refine-tasks
   ;; two entries, each over two lines; a namespace no other test of this JVM creates tasks in
   (str "[#:seon.task{:name \"area\"\n             :intent \"Fix.\"}\n"
