diff --git a/test/seon/publication_cost_test.clj b/test/seon/publication_cost_test.clj
new file mode 100644
index 000000000..6fb2d6ab3
--- /dev/null
+++ b/test/seon/publication_cost_test.clj
@@ -0,0 +1,56 @@
+(ns seon.publication-cost-test
+  (:require [clojure.java.io :as io]
+            [clojure.test :refer [deftest is]]
+            [seon.cache :as cache]
+            [seon.cluster :as cluster]
+            [seon.cluster.store :as store]
+            [seon.db :as db]
+            [seon.fs :as fs]
+            [seon.profile :as profile]
+            [seon.render.value :as value]
+            [seon.test-support :as support]))
+
+(deftest ^{:seon/tasks #{'seon.publication-cost/reuse-source-names}
+           :seon.test/long "Publishes eight namespaces through the resume publication path on a private overlay."
+           :seon.test/long-ms 60000}
+  publication-cost-follows-changed-inputs
+  (let [root (str "tmp/publication-cost-" (random-uuid))
+        directory (str root "/checkout")
+        parent (support/execution-handle db/*conn*)
+        paths ["src/seon/cluster.clj" "src/seon/fn.clj" "src/seon/db.clj"
+               "src/seon/turn.clj" "src/seon/instrument.clj" "src/seon/context.clj"
+               "src/seon/ref.clj" "src/seon/schema.clj"]]
+    (try
+      (doseq [path ["src" "test" "script" "resources" ".clj-kondo"]]
+        (#'support/clone-directory! (io/file (fs/source-directory) path)
+                                   (io/file directory path)))
+      (doseq [path ["deps.edn" "dependency-pins.txt" "test-input-paths.txt"]]
+        (io/copy (io/file (fs/source-directory) path) (io/file directory path)))
+      (java.nio.file.Files/delete (.toPath (io/file directory ".clj-kondo/.cache")))
+      (#'support/clone-directory!
+       (.getCanonicalFile (io/file (fs/source-directory) ".clj-kondo/.cache"))
+       (io/file directory ".clj-kondo/.cache"))
+      (doseq [path paths]
+        (let [file (io/file directory path)]
+          (.setWritable file true)
+          (spit file (str "; Publication cost probe.\n" (slurp file)))))
+      (doseq [sample (range 3)]
+       (let [held (store/open-overlay! (:seon.store/store parent))]
+        (try
+         (let [measured (profile/measure
+                      #(#'cluster/full-source-refresh!
+                         root held
+                         (assoc (#'cluster/publication-roots)
+                                :seon.fn/root directory
+                                :seon.source/changed-paths paths
+                                :seon.source/branch :publication-cost
+                                :seon.fn.analyzer/cache-root (str directory "/.clj-kondo/.cache"))))]
+        (let [output (str "/private/tmp/claude-501/-Users-sean-src-seon/a5acff01-0859-40f4-bc50-1424bc5205cf/scratchpad/publish-cost/repeat-" sample ".edn")]
+          (spit output (value/core-text (select-keys measured [:seon.profile/ms :seon.profile/alloc-bytes :seon.cost/jvm-window])))
+          (doseq [entry (:seon.profile/ranked-by-self measured)]
+            (spit output (str "\n" (value/core-text entry)) :append true))
+          (spit output (str "\n" (value/core-text (get-in (cache/status) [:seon.cache/kinds :seon.program/source-names]))) :append true))
+        (is (true? (:seon.source/built? (:seon.profile/value measured))))
+        (is (< (:seon.profile/ms measured) 5000)))
+         (finally (store/release-store! held)))))
+      (finally (support/delete-recursively! root)))))
