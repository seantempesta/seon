diff --git a/src/datahike/store.cljc b/src/datahike/store.cljc
index 4a9251e2..30966cbb 100644
--- a/src/datahike/store.cljc
+++ b/src/datahike/store.cljc
@@ -134,17 +134,22 @@
 ;; so every overlay of one store would share ONE frontend, and `ready-store
 ;; :tiered` copies the whole backend into it (`sync-on-connect`, above).
 
-(defn- overlay-frontend [overlay]
-  (or (km/connect-mem-store overlay {:sync? true})
-      (km/new-mem-store (atom {}) {:sync? true :id overlay})))
+(defn- overlay-frontend-config [{:keys [overlay frontend-config]}]
+  (or frontend-config {:backend :memory :id overlay}))
+
+(defn- overlay-frontend [config]
+  (let [frontend (overlay-frontend-config config)]
+    (if (ks/store-exists? frontend {:sync? true})
+      (ks/connect-store frontend {:sync? true})
+      (ks/create-store frontend {:sync? true}))))
 
 (defmethod ks/-connect-store :datahike/overlay
-  [{:keys [backend-config overlay]} opts]
+  [{:keys [backend-config] :as config} opts]
   (async+sync (:sync? opts) *default-sync-translation*
               (go-try-
                (let [backend (<?- (ks/connect-store backend-config opts))]
                  (<?- (kt/connect-tiered-store
-                       (overlay-frontend overlay)
+                       (overlay-frontend config)
                        backend
                        :write-policy :frontend-only
                        :read-policy :frontend-first
@@ -155,10 +160,13 @@
   (ks/store-exists? backend-config opts))
 
 (defmethod ks/-release-store :datahike/overlay
-  [{:keys [backend-config]} store opts]
-  (ks/release-store backend-config (:backend-store store) opts))
+  [{:keys [backend-config] :as config} store opts]
+  (async+sync (:sync? opts) *default-sync-translation*
+              (go-try-
+               (<?- (ks/release-store (overlay-frontend-config config)
+                                     (:frontend-store store) opts))
+               (<?- (ks/release-store backend-config (:backend-store store) opts)))))
 
 (defmethod ks/-delete-store :datahike/overlay
-  [{:keys [overlay]} opts]
-  (async+sync (:sync? opts) *default-sync-translation*
-              (go-try- (km/delete-mem-store overlay))))
+  [config opts]
+  (ks/delete-store (overlay-frontend-config config) opts))
