+(deftest an-existing-agent-rehosts-without-a-transaction
+  (with-host-world {}
+    (fn [{:keys [handle connection branch!]}]
+      (let [branch (branch!)
+            hosted (host-on! handle branch "mcp/rehost")
+            before [(db/basis-t (db/db connection)) (db/basis-t (branch-db handle branch))]]
+        (host/stop! hosted)
+        (host-on! handle branch "mcp/rehost")
+        (is (= before [(db/basis-t (db/db connection)) (db/basis-t (branch-db handle branch))]))))))
+
 (deftest stopping-the-cluster-releases-every-host-connection
   ;; A reset stops the instance in this JVM: a host left running kept its
   ;; branch connection, so its branch outlived the reforked cluster.
