+
+(deftest a-branch-judges-its-step-at-its-merge-base
+  ;; the merge base is written on main only (`seon.cluster.agent/start-attempt!`); the assignment row copied onto the
+  ;; branch (`seon.task/attempt-rows-tx`) carries it, so the branch's step is judged at it
+  (support/with-database
+   (fn [connection]
+     (task/index-tasks! {:seon.db/connection connection
+                         :seon.task/files {"resources/seon/tasks/tq.base.edn"
+                                           "[#:seon.task{:name \"a\" :kind :work :intent \"Do a.\"}]"}})
+     (let [h (task/task-handle 'tq.base "a" :work)
+           agent-id "tq-base-agent"
+           _ (doseq [id ["root" agent-id]] (support/transacted! connection (support/agent-tx (db/db connection) id)))
+           branch-db (db/db connection)
+           _ (support/transacted! connection (task/attempt-tx (db/db connection) h agent-id :tq-base))
+           base (random-uuid)
+           _ (support/transacted! connection [[:db/add [:seon.task/assignment (id/id [h 1])] :seon.task/merge-base base]])
+           rows (task/attempt-rows-tx (db/db connection) branch-db (id/id [h 1]))]
+       (is (= base (turn/fork-commit (db/with branch-db rows) agent-id))
+           "the branch reads the merge base written on main")))))
