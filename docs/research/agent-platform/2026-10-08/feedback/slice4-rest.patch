+(defn sink-top
+  "A call sink's `n` definitions with the most self time, each
+  `[sym self-ms calls]`, its executed digests summed."
+  {:malli/schema [:=> [:cat :seon.batch/sink pos-int?] :seon.cost/top]}
+  [^ConcurrentHashMap sink n]
+  (->> sink
+       (reduce (fn [by-sym [[sym _] ^AtomicLongArray c]]
+                 (let [[self calls] (get by-sym sym [0 0])]
+                   (assoc by-sym sym [(+ self (.get c 2)) (+ calls (.get c 0))])))
+               {})
+       (sort-by (comp - first val))
+       (into [] (comp (take n) (map (fn [[sym [self calls]]] [sym (seon.batch/tenths (/ self 1e6)) calls]))))))
+
