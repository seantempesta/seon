    "[\"(defn- ends-in-comment?\\n  \\\"True when `text`'s last token is a line comment (the floor's elision legend,\\n  a diagnostic line): anything written after it on the same line would be\\n  read as part of the comment, so the reply map must end that line first.\\\"\\n  {:malli/schema [:=> [:cat :string] :boolean]}\\n  [text]\\n  (= \\\"comment\\\" (first (peek (into [] (remove (comp #{\\\"space\\\"} first))\\n                                   (syntax-tokens text))))))\"\n \"(deftest ^{:seon/tasks #{\\\"18c37812b5bc\\\"}} the-reply-is-one-edn-map-whatever-the-value\\n  ;; Owner 2026-09-27: \\\"The repl should be returning the timing and the result\\n  ;; so it's already a map\\\" — \\\"return data whenever possible so it's\\n  ;; unambiguous.\\\" Value, error, findings, handle and time are keys of the one\\n  ;; map; nothing is printed above or around it.\\n  (let [handle (admit/result-handle \\\"e7b3\\\")]\\n    (testing \\\"an elided value keeps its cut and continuation as data\\\"\\n      (let [reply (one-map (repl/response\\n                            {:seon.cluster.eval/source \\\"(vec (range 3000))\\\"\\n                             :seon.repl/handle handle\\n                             :seon.eval/duration-ms 711\\n                             :seon.eval/shown \\\"[0 1 2 …2997 (drop 3 result/ee7b3)]\\\"}))]\\n        (is (= [0 1 2 (symbol \\\"…2997\\\") '(drop 3 result/ee7b3)] (:seon.repl/value reply)))\\n        (is (= handle (:seon.repl/result reply)))\\n        (is (= 711 (:seon.repl/ms reply)))))\\n    (testing \\\"a comment-ended text still leave\"…+1586 (subs (get-in result/eb31949a42cec [1]) 1024)\n \"(defn findings\\n  \\\"One map per declared bound the evaluation's cost exceeds: what it is\\n  (`:seon.repl/finding`), the measure and what was observed, the other\\n  measures the bound reports, and its fix. Empty within every bound, which is\\n  the normal reply: nothing is added to it.\\\"\\n  {:malli/schema [:=> [:cat :seon.repl/emission] [:vector :seon.repl/finding-value]]}\\n  [emission]\\n  (let [{explainer ::explainer declared ::declared} @bounds\\n        measured (cost emission)\\n        values (merge (select-keys emission (::named @bounds)) measured)]\\n    (into []\\n          (map (fn [{[measure] :in observed :value}]\\n                 (let [{kind :seon.repl/finding with :seon.repl/with fix :seon.repl/fix} (get declared measure)]\\n                   (cond-> (merge {:seon.repl/finding kind measure observed}\\n                                  (select-keys values with))\\n                     fix (assoc :seon.repl/fix fix)))))\\n          (:errors (explainer measured)))))\"]",
