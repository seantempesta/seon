+(deftest ^{:seon.test/long "Arms one agent graph and settles its opening run and one model turn, each a Flow pass and its settlement commits."
+           :seon.test/long-ms 30000}
+  a-model-turn-reads-the-transcript-and-appends-its-forms
+  (let [target (support/execution-handle nil)
+        connection (:seon.db/connection target)
+        cluster-name (:seon.cluster/name target)
+        agent-id "loop-fixture"
+        environment (support/environment cluster-name connection)
+        ctx (support/fork-cluster-ctx connection cluster-name)
+        routing (support/attempt-routing connection)]
+    (with-open [launcher (support/closeable
+                          (flow/start-work-launcher!
+                           {:seon.env/environment environment
+                            :seon.flow/configuration (select-keys (config/effective (db/db connection) cluster-name)
+                                                                  flow/flow-workload-attributes)})
+                          flow/stop-work-launcher!)]
+      (let [handle (assoc (support/cluster-handle
+                           {:seon.env/environment environment :seon.db/connection connection :seon.cluster/name cluster-name
+                            :seon.sci.eval/ctx ctx :seon.flow/work-launcher @launcher
+                            :seon.flow/executor (cluster/projection-executor (:seon.sci.eval/projection-state ctx))
+                            :seon.db.process/id cluster/boot-process-identity})
+                          :seon.ai/send! (fn [_request] {:seon.ai/text reply :seon.ai/finish-reason "stop"}))
+            request {:seon.turn.loop/cluster handle :seon.agent/routing routing :seon.agent/id agent-id}]
+        (support/transacted! connection (support/agent-tx @connection agent-id))
+        (is (map? (seon.agent/settings! {:seon.config.ai/no-provider false :seon.config.ai/no-auth true
+                                          :seon.config.run/max-episode-runs 2}
+                                         connection agent-id))
+            "the agent's provider is enabled with no credential: the fixture leaf answers")
+        (let [created (task/create! {:seon.db/connection connection :seon.agent/id agent-id :seon.task/ns 'seon.agent.loop
+                                     :seon.task/name "loop-fixture-task" :seon.task/kind :function
+                                     :seon.task/intent "Read `seon.task/task-edges` and add two numbers."
+                                     :seon.task/must-read #{'seon.task/task-edges}})]
+          (task/assign! {:seon.db/connection connection :seon.task/assigned (:seon.task/id created)
+                         :seon.task/agent [:seon.agent/id agent-id] :seon.task/branch (get-in @connection [:config :branch])}))
+        (testing "an agent with no opened task refuses its context by name"
+          (is (= :seon.agent.loop/no-task-error (:seon.error/type (loop/context @connection agent-id)))))
+        (support/transacted! connection (loop/opening-tx @connection agent-id))
+        (agent/arm! request)
+        (try
+          (support/transacted! connection (message/inbound-tx @connection {:seon.agent/id agent-id
+                                                                            :seon.message/inbound-content "Work on your task."
+                                                                            :seon.config.eval.result/max-string 1000}))
+          (support/await-event! connection ::model-form-settled #(:seon.eval/shown (evaluation-of % agent-id "(+ 1 2)")))
+          (let [database @connection
+                prompt (:seon.ai/prompt (loop/context database agent-id))
+                added (evaluation-of database agent-id "(+ 1 2)")]
+            (testing "the context opens with help, the task and its references as forms that ran"
+              (is (every? #(str/includes? prompt (str "user=> " %))
+                          ["(help)" "(seon.agent.loop/task 'seon.agent.loop/loop-fixture-task)"
+                           "(doc seon.task/task-edges)" "(clojure.repl/source-fn 'seon.task/task-edges)"])))
+            (testing "the reply's form ran as the agent's own, its attempt recorded on its run"
+              (is (= :agent (:seon.cluster.eval/author added)))
+              (is (= "3" (:seon.eval/shown added)))
+              (is (seq (get-in added [:seon.cluster.eval/run :seon.turn/attempts]))))
+            (testing "the next context appends the form and its stored result"
+              (is (str/includes? prompt "user=> (+ 1 2)\n3"))))
+          (finally
+            (agent/disarm! request)))))))
