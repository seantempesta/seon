+(defn- quoted-symbol
+  "`text` as the qualified symbol it spells, or nil when it spells none."
+  {:malli/schema [:=> [:cat :string] [:maybe :qualified-symbol]]}
+  [text]
+  (let [slash (str/last-index-of text "/")]
+    (when (and slash (pos? slash)
+               (task/symbol-name? (subs text 0 slash))
+               (task/symbol-name? (subs text (inc slash))))
+      (symbol (subs text 0 slash) (subs text (inc slash))))))
+
+(defn- backticked-symbols
+  "The qualified symbols `text` writes between single backticks, in order."
+  {:malli/schema [:=> [:cat :string] [:vector :qualified-symbol]]}
+  [text]
+  (let [parts (mapv #(apply str %) (partition-by #{\`} text))]
+    (into [] (keep (fn [[before inside after]]
+                     (when (= "`" before after) (quoted-symbol inside))))
+          (partition 3 1 parts))))
+
+(defn opening-sources
+  "The forms an agent's task opens with, in order: `(help)`, the task, then
+  each named definition's `doc` and source, then each proof test's source.
 
   Example:
-  (seon.agent.loop/task-context (seon.db/db) (seon.task/task-handle 'seon.db \"the-query-wrapper-costs-36x-datahike\" :function))
-
-  ## Costs
+  (seon.agent.loop/opening-sources (seon.db/db) 'scratch.add/add-one-returns-its-argument-plus-one)"
+  {:malli/schema [:=> [:cat :seon.db/database-value :seon.task/sym]
+                  [:or [:vector :string] :seon.db/invalid-read-error]]}
+  [database task-sym]
+  (let [view (task database task-sym)]
+    (if (:seon.error/at view)
+      view
+      (let [proofs (set (keys (:seon.agent.loop/proofs view)))
+            named (remove proofs (distinct (concat (sort (:seon.task/must-read view))
+                                                   (backticked-symbols (:seon.task/intent view "")))))
+            defined (set (db/q '[:find [?s ...] :in $ [?s ...] :where [_ :seon.fn/sym ?s]] database (vec named)))]
+        (into ["(help)" (str "(seon.agent.loop/task '" task-sym ")")]
+              (concat (mapcat (fn [sym] [(str "(doc " sym ")") (str "(clojure.repl/source-fn '" sym ")")])
+                              (filter defined named))
+                      (map #(str "(clojure.repl/source-fn '" % ")") (sort proofs))))))))
