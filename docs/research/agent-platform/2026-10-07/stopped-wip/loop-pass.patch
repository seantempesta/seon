+;;; THE CONTEXT: the transcript since the opening.
+
+(def ^:private transcript-selector
+  "What one transcript block prints, and the run it belongs to."
+  [:seon.cluster.eval/source :seon.cluster.eval/comment :seon.cluster.eval/author :seon.cluster.eval/output
+   :seon.cluster.eval/error :seon.eval/shown {:seon.cluster.eval/run [:seon.turn/id]}])
+
+(defn- block
+  "One evaluation as the REPL showed it: its comment lines, `user=>` and its
+  source, its printed output, then its value or error as stored."
+  {:malli/schema [:=> [:cat :seon.db/pulled-entity] :string]}
+  [{source :seon.cluster.eval/source note :seon.cluster.eval/comment output :seon.cluster.eval/output
+    error :seon.cluster.eval/error shown :seon.eval/shown}]
+  (str/join "\n" (cond-> []
+                   (seq note) (conj (str/join "\n" (map #(str ";; " %) (str/split-lines note))))
+                   :always (conj (str "user=> " source))
+                   (seq output) (conj (str/trim-newline output))
+                   :always (conj (or shown error "")))))
+
+(defn transcript
+  "The evaluations `agent-id`'s context shows, in order: its opening run's,
+  then every later form its replies carried. Outside runs made as the agent
+  are not shown."
+  {:malli/schema [:=> [:cat :seon.db/database-value :seon.agent/id :seon.turn/id]
+                  [:or [:vector :seon.db/pulled-entity] :seon.db/invalid-read-error :seon.agent/no-such-agent-error]]}
+  [database agent-id opening]
+  (let [evaluations (evaluation/of-agent database agent-id transcript-selector)]
+    (if (:seon.error/at evaluations)
+      evaluations
+      (let [opened? #(= opening (get-in % [:seon.cluster.eval/run :seon.turn/id]))]
+        (into [] (comp (drop-while (complement opened?))
+                       (filter #(or (opened? %) (= :agent (:seon.cluster.eval/author %)))))
+              evaluations)))))
+
+(defn context
+  "The request members `agent-id`'s next model call sends: the prompt, its
+  REPL transcript since its task opened. Refuses when the agent holds no
+  task or its task never opened.
 
   Example:
-  (seon.agent.loop/context-text (seon.agent.loop/task-context (seon.db/db) \"d6e3b775f474\") false)"
-  {:malli/schema [:=> [:cat [:vector :seon.agent.loop/unit] :boolean] :string]}
-  [units annotated?]
-  (str/join "\n" (map #(unit-text % annotated?) units)))
+  (seon.agent.loop/context (seon.db/db) \"lp-add-1\")"
+  {:malli/schema [:=> [:cat :seon.db/database-value :seon.agent/id]
+                  [:or [:map [:seon.ai/prompt :seon.ai/prompt]]
+                   :seon.db/invalid-read-error :seon.agent/no-such-agent-error :seon.agent.loop/no-task-error]]}
+  [database agent-id]
+  (let [handle (task/agent-task (task-database database) agent-id)
+        shown (when (string? handle) (transcript database agent-id (opening-id agent-id handle)))]
+    (cond
+      (:seon.error/at handle) handle
+      (nil? handle) (no-task agent-id 'seon.agent.loop/context)
+      (:seon.error/at shown) shown
+      (empty? shown) (no-task agent-id 'seon.agent.loop/context)
+      :else {:seon.ai/prompt (str/join "\n\n" (map block shown))})))
