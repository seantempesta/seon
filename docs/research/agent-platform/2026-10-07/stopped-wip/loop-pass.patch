-(defn context-text
-  "The units as the text an agent reads, in order.
-
-  `annotated?` precedes each with why it is there and its estimated tokens.
+      (:seon.error/at handle) handle
+      (nil? task-sym) (no-task agent-id 'seon.agent.loop/opening-tx)
+      (:seon.error/at sources) sources
+      :else (turn/system-run-tx database {:seon.agent/id agent-id :seon.turn/id (opening-id agent-id handle)
+                                          :seon.turn/opened-tx "datomic.tx"
+                                          :seon.turn/sources (mapv #(hash-map :seon.cluster.eval/source %) sources)}))))
