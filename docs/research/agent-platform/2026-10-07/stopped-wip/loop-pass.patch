-(defn task-context
-  "The context task `handle` seeds, as units.
-
-  The task; its edges (subjects
-  and proof tests); each proof's status, recorded failures and source; each
-  must-read or subject function's documentation and source; the schemas
-  their contracts name; each namespace subject's directory; other tasks and
-  recorded errors touching the same functions. A handle naming no task
-  refuses `:unknown-task`.
+  (seon.agent.loop/task 'scratch.add/add-one-returns-its-argument-plus-one)"
+  {:malli/schema [:=> [:cat :seon.db/database-value :seon.task/sym]
+                  [:or :seon.agent.loop/task-view :seon.db/invalid-read-error]]}
+  [database task-sym]
+  (let [row (db/pull (task-database database) [:seon.task/sym :seon.task/intent :seon.task/must-read]
+                     [:seon.task/sym task-sym])
+        edges (task/task-edges database task-sym)
+        proofs (sort (:seon.task/proofs edges))]
+    (cond
+      (:seon.error/at row) row
+      (:seon.error/at edges) edges
+      :else (cond-> (assoc row :seon.agent.loop/proofs (into (sorted-map)
+                                                             (map (juxt identity #(test/recorded-result database %)))
+                                                             proofs))
+              (seq proofs) (assoc :seon.render/operations
+                                  [(list 'my.test/check {:seon.test/changed (list 'quote (vec proofs))})])))))
