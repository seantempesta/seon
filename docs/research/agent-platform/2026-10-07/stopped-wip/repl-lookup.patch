+(defn- proof-status
+  "One test's status from its latest recorded result on this branch: green,
+  red with its first failing assertion, unknown, or never run."
+  {:malli/schema [:=> [:cat :qualified-symbol [:or :nil :map]] :seon.sci.eval/proof-status]}
+  [sym result]
+  (cond
+    (nil? result) {:sym sym :status :never-run}
+    (not (contains? result :seon.test/fail-count)) {:sym sym :status :unknown}
+    (zero? (+ (:seon.test/fail-count result) (:seon.test/error-count result))) {:sym sym :status :green}
+    :else (cond-> {:sym sym :status :red}
+            (seq (:seon.test/failures result)) (assoc :failure (first (:seon.test/failures result))))))
+
+(defn- proof-statuses
+  "Each test's status, in the order given, from one read of their latest results."
+  {:malli/schema [:=> [:cat :seon.db/database-value [:vector :qualified-symbol]]
+                  [:or [:vector :seon.sci.eval/proof-status] :seon.test/execution-error]]}
+  [database tests]
+  (let [results (if (seq tests) (test.runner/latest-results database tests) [])
+        by-sym (when (vector? results)
+                 (into {} (map (juxt #(or (:seon.test/sym %) (:seon.test/error-test-symbol %)) identity)) results))]
+    (if (vector? results) (mapv #(proof-status % (by-sym %)) tests) results)))
+
