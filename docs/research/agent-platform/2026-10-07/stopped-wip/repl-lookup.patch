+  [database {sym :seon.task/sym intent :seon.task/intent}]
+  (let [edges (task/task-edges database sym)
+        proofs (when-not (db/read-refusal? edges) (proof-statuses database (vec (sort (:seon.task/proofs edges)))))]
+    (cond
+      (db/read-refusal? edges) edges
+      (map? proofs) proofs
+      :else {:sym sym :intent intent :subjects (vec (sort (:seon.task/subjects edges))) :proofs proofs})))
