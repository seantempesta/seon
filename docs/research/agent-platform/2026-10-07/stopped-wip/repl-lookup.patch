+  `clojure.repl/source-fn`, else the typed unavailable error naming `requested`."
+  {:malli/schema [:=> [:cat :seon.db/database-value :symbol :symbol]
+                  [:or :string :seon.sci.eval/documentation-unavailable-error]]}
+  [database requested reference]
+  (or (stored-source database reference)
+      (when (and (qualified-symbol? reference) (sci-meta reference)) (repl/source-fn reference))
+      (documentation-unavailable requested)))
+
+(defn reference-in
+  "`requested` as the evaluating SCI namespace names it: a qualified symbol
+  with its namespace alias expanded, an unqualified symbol that resolves to a
+  var as that var's qualified symbol, anything else unchanged."
+  {:malli/schema [:=> [:cat :seon.sci.eval/reference] :seon.sci.eval/reference]}
+  [requested]
+  (let [ctx (sci.ctx-store/get-ctx)]
+    (cond
+      (qualified-symbol? requested)
+      (let [aliases (get-in @(:env ctx) [:namespaces (sci.utils/current-ns-name) :aliases])]
+        (symbol (str (get aliases (symbol (namespace requested)) (namespace requested))) (name requested)))
+      (simple-symbol? requested)
+      (let [resolved (sci/resolve ctx requested)]
+        (if (instance? sci.lang.Var resolved) (sci/var->symbol resolved) requested))
+      :else requested)))
+
+(defn directory
+  "What `dir` shows: SCI's `dir-fn` names of the namespace `requested` names
+  (an alias or a namespace), each with its arglists and summary sentence."
+  {:malli/schema [:=> [:cat :symbol] [:or :seon.sci.eval/var-summaries :seon.sci.eval/documentation-unavailable-error]]}
+  [requested]
+  (let [ctx (sci.ctx-store/get-ctx)
+        target (get-in @(:env ctx) [:namespaces (sci.utils/current-ns-name) :aliases requested] requested)]
+    (if (sci/find-ns ctx target)
+      (mapv #(let [sym (symbol (str target) (str %))] (var-summary sym (sci-meta sym)))
+            (sci.namespaces/dir-fn requested))
+      (documentation-unavailable requested))))
+
+(defn- agent-apropos
+  "SCI's `apropos` over the evaluating context, as a vector."
+  {:malli/schema [:=> [:cat :seon.sci.eval/lookup-pattern] [:vector :qualified-symbol]]}
+  [pattern]
+  (vec (sci.namespaces/apropos pattern)))
+
+(defn- agent-find-doc
+  "The public vars of the evaluating context whose name or docstring the
+  regular expression `pattern` finds, with their summaries."
+  {:malli/schema [:=> [:cat :seon.sci.eval/lookup-pattern] :seon.sci.eval/var-summaries]}
+  [pattern]
+  (let [ctx (sci.ctx-store/get-ctx)
+        expression (re-pattern pattern)]
+    (into [] (for [sci-ns (sort-by str (sci.namespaces/sci-all-ns))
+                   [local v] (sort-by key (sci.namespaces/sci-ns-publics* ctx sci-ns))
+                   :let [metadata (meta v)]
+                   :when (or (re-find expression (str local))
+                             (and (string? (:doc metadata)) (re-find expression (:doc metadata))))]
+               (var-summary (symbol (str sci-ns) (str local)) metadata)))))
+
+(defn- agent-source-fn
+  "`clojure.repl/source-fn` for the evaluating context: what `source` shows, or nil."
+  {:malli/schema [:=> [:cat :symbol] [:or :nil :string]]}
   [requested]
-  (let [resolved (sci/resolve (sci.ctx-store/get-ctx) requested)
-        {var-ns :ns var-name :name} (meta resolved)]
-    (stored-source (db/db) (if resolved (symbol (str var-ns) (str var-name)) requested))))
+  (let [shown (source-value (db/db) requested (reference-in requested))]
+    (when (string? shown) shown)))
+
+(defn- lookup-macro
+  "A `clojure.repl` macro var whose call `(name x)` becomes `(expansion 'x)`."
+  {:malli/schema [:=> [:cat :symbol ifn?] :seon.schema/value]}
+  [macro-name expansion]
+  (sci/new-macro-var macro-name (fn [_form _env requested] (expansion requested))
+                     {:ns (sci/create-ns 'clojure.repl)}))
 
