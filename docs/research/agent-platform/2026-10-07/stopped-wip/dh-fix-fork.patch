+(defn- rule-arg-scalar?
+  "True for a const that rule-call substitution inlines into the call's args."
+  [v]
+  (or (number? v) (string? v) (keyword? v) (boolean? v) (nil? v) (uuid? v) (inst? v)))
+
+(defn- rule-call-args
+  "Every argument of every rule call in `clauses`, nested or/and/not bodies included."
+  [clauses rule-names]
+  (letfn [(walk [form]
+            (cond
+              (and (seq? form) (contains? rule-names (first form))) (rest form)
+              (sequential? form) (mapcat walk form)
+              :else nil))]
+    (mapcat walk clauses)))
+
+(defn- bind-rule-arg-consts
+  "Context whose non-scalar scalar-input consts used as rule-call args are also
+   one-row relations, so the planner sees them bound. Rule-call substitution
+   inlines only scalars; without this a lookup-ref input such as
+   `[:p/id \"p6\"]` passed to `(reach ?a ?b)` leaves `?a` unbound."
+  [context-in where-clauses]
+  (let [consts (:consts context-in)
+        rule-names (set (keys (:rules context-in)))
+        vars (when (and (seq consts) (seq rule-names))
+               (into #{}
+                     (filter #(and (contains? consts %) (not (rule-arg-scalar? (get consts %)))))
+                     (rule-call-args where-clauses rule-names)))]
+    (reduce (fn [ctx v]
+              (update ctx :rels conj (rel/->Relation {v 0} [(object-array [(get consts v)])])))
+            context-in
+            vars)))
+
