+(def ^:private clojure-fence-tags
+  "The first info-string words of a fence whose body is Clojure; an untagged fence is Clojure too."
+  #{"" "clojure" "clj" "cljc" "cljs" "edn"})
+
+(defn- fence-open
+  "The fence `line` opens, or nil: three or more backticks or tildes and an
+  info string, which holds no backtick after backticks (CommonMark)."
+  {:malli/schema [:=> [:cat :string] [:maybe [:map [::fence-char char?] [::fence-length pos-int?] [::clojure? :boolean]]]]}
+  [line]
+  (let [l (str/trim line)
+        c (first l)
+        n (count (take-while #(= c %) l))
+        info (str/trim (subs l n))]
+    (when (and (contains? #{\` \~} c) (>= n 3) (not (and (= \` c) (str/includes? info "`"))))
+      {::fence-char c ::fence-length n
+       ::clojure? (contains? clojure-fence-tags
+                             (str/lower-case (apply str (take-while #(not (Character/isWhitespace ^char %)) info))))})))
+
+(defn- fence-close?
+  "Whether `line` closes the fence `open`: only its character, at least as many."
+  {:malli/schema [:=> [:cat :string [:map [::fence-char char?] [::fence-length pos-int?]]] :boolean]}
+  [line {c ::fence-char n ::fence-length}]
+  (let [l (str/trim line)]
+    (and (>= (count l) n) (every? #(= c %) l))))
+
+(defn- text-lines
+  "`text`'s lines without their newlines; joined with newlines they are `text`."
+  {:malli/schema [:=> [:cat :string] [:vector :string]]}
+  [^String text]
+  (let [starts (line-starts text)]
+    (mapv #(subs text %1 %2) starts (conj (mapv dec (rest starts)) (count text)))))
+
+(defn- fenced-line
+  "One line of a fenced reply and the fence open after it: prose outside a
+  Clojure fence's body becomes a `;` comment; fence lines stay, as delimiters."
+  {:malli/schema [:=> [:cat [:map [::lines [:vector :string]]] :string] [:map [::lines [:vector :string]]]]}
+  [{open ::open :as acc} line]
+  (let [prose? (not (or (str/blank? line) (str/starts-with? (str/triml line) ";")))
+        add (fn [l] (update acc ::lines conj l))]
+    (cond
+      (nil? open) (if-let [opened (fence-open line)]
+                    (assoc (add line) ::open opened)
+                    (add (if prose? (str "; " line) line)))
+      (fence-close? line open) (dissoc (add line) ::open)
+      (or (::clojure? open) (not prose?)) (add line)
+      :else (add (str "; " line)))))
+
+(defn fenced
+  "`text` read as Markdown, or nil when it holds no fence.
+
+  Only the bodies of its Clojure fences (untagged, clojure, clj, cljc, cljs,
+  edn) stay code; every other line becomes a `;` comment. An unclosed fence
+  runs to the text's end."
+  {:malli/schema [:=> [:cat :string] [:maybe :string]]}
+  [text]
+  (let [lines (text-lines text)]
+    (when (some fence-open lines)
+      (str/join "\n" (::lines (reduce fenced-line {::lines []} lines))))))
+
+(defn- markdown-line?
+  "Whether `line` is a Markdown heading (one to six `#`, then whitespace or
+  the line's end) or opens with a code span (`` `name` ``): neither is Clojure."
+  {:malli/schema [:=> [:cat :string] :boolean]}
+  [line]
+  (let [l (str/triml line)
+        hashes (count (take-while #(= \# %) l))
+        after (get l hashes)
+        span (take-while #(not (or (= \` %) (Character/isWhitespace ^char %))) (rest l))]
+    (boolean
+     (or (and (<= 1 hashes 6) (or (nil? after) (Character/isWhitespace ^char after)))
+         (and (= \` (first l)) (seq span) (= \` (get l (inc (count span)))))))))
+
+(def ^:private prompt #"^[A-Za-z][\w.\-]*=>[ \t]*")
+
+(defn- prompt-line?
+  "Whether `line` opens like a REPL transcript: `ns=>` or `=>`, then
+  whitespace or the line's end."
+  {:malli/schema [:=> [:cat :string] :boolean]}
+  [line]
+  (let [l (str/triml line)
+        marker (if (str/starts-with? l "=>") "=>" (re-find prompt l))]
+    (boolean (and marker (or (= (count marker) (count l))
+                             (Character/isWhitespace ^char (last marker))
+                             (Character/isWhitespace ^char (get l (count marker))))))))
+
+(defn- imitation-end
+  "The end of the imitated transcript block whose prompt line starts at
+  `line-start`: before the next blank or fence line, else the text's end."
+  {:malli/schema [:=> [:cat :string nat-int?] nat-int?]}
+  [^String text line-start]
+  (loop [[_ e] (line-bounds text line-start)]
+    (if (>= e (count text))
+      e
+      (let [[s' e'] (line-bounds text (inc e))
+            line (subs text s' e')]
+        (if (or (str/blank? line) (fence-line? line)) e (recur [s' e']))))))
+
