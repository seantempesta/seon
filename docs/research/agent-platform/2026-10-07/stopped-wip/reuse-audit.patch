+(deftest a-throw-of-a-registered-error-variant-is-the-law
+  ;; CLAUDE.md "Nothing crashes": a function whose job is not to answer throws
+  ;; the one error map inside ex-info and declares only its success value.
+  (let [edited "(ns seon.probe (:require [seon.error.refusal :as refusal]))
+(defn literal {:malli/schema [:=> [:cat :int] :int]} [x] (throw (ex-info \"m\" {:seon.error/type :seon.id/unhashable-error :seon.error/operation 'seon.probe/literal})))
+(defn constructed {:malli/schema [:=> [:cat :int] :int]} [x] (throw (ex-info \"m\" (refusal/error :seon.id/unhashable-error {:seon.error/operation 'seon.probe/constructed}))))
+(defn bound {:malli/schema [:=> [:cat :int] :int]} [x] (let [e (refusal/error :seon.id/unhashable-error {:seon.error/operation 'seon.probe/bound})] (throw (ex-info (:seon.error/message e) e))))
+(defn unregistered {:malli/schema [:=> [:cat :int] :int]} [x] (throw (ex-info \"m\" {:seon.error/type :seon.probe/made-up-error})))
+(defn bare-map {:malli/schema [:=> [:cat :int] :int]} [x] (throw (ex-info \"m\" {:x x})))
+(defn non-error {:malli/schema [:=> [:cat :int] :int]} [x] (throw (Exception. \"m\")))
+(defn bound-elsewise {:malli/schema [:=> [:cat :int] :int]} [x] (let [e {:x x}] (throw (ex-info \"m\" e))))
+(defn wraps-caught {:malli/schema [:=> [:cat :int] :int]} [x] (try (inc x) (catch Exception c (throw (ex-info \"m\" (refusal/error :seon.id/unhashable-error {:seon.error/operation 'seon.probe/wraps-caught}) c)))))"
+        refused (into #{} (comp (filter #(= :uncontained-throw (:type %)))
+                                (map #(symbol (first (str/split (:message %) #" ")))))
+                      (check {::sources {"src/seon/probe.clj" edited}
+                              ::baselines {"src/seon/probe.clj" "(ns seon.probe)"}}))]
+    (are [function refused?] (= refused? (contains? refused function))
+      'seon.probe/literal        false
+      'seon.probe/constructed    false
+      'seon.probe/bound          false
+      'seon.probe/unregistered   true
+      'seon.probe/bare-map       true
+      'seon.probe/non-error      true
+      'seon.probe/bound-elsewise true
+      'seon.probe/wraps-caught   true)))
+
