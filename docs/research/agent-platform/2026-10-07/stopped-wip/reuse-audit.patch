+;; A throw of the one error map is the law, not a crash: CLAUDE.md "every
+;; other function throws the same map inside `ex-info` and declares only its
+;; success value". Its data is a registered variant: a constructor call
+;; `(seon.error.refusal/error :variant ...)`, a literal map whose
+;; `:seon.error/type` is registered (a namespace the constructor's own
+;; requires cannot call it), or a local every binding of which is one. A
+;; throw inside a catch clause wraps a caught cause and is judged as before.
+
+(def ^:private error-constructors
+  "The installed error constructors."
+  #{'seon.error.refusal/error})
+
+(defn- local-inits
+  "Every init form a `let`-family binding vector in `form` gives each simple symbol."
+  {:malli/schema [:=> [:cat [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary, :seon.schema.admission/reason "A definition form is arbitrary read data.", :gen/elements [nil 0 :k [] {}]}]] [:map-of :symbol [:vector [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary, :seon.schema.admission/reason "A binding's init is arbitrary read data.", :gen/elements [nil 0 :k [] {}]}]]]]}
+  [form]
+  (reduce (fn [m [k init]] (if (simple-symbol? k) (update m k (fnil conj []) init) m))
+          {}
+          (for [node (tree-seq coll? seq form)
+                :when (and (seq? node) ('#{let let* when-let if-let when-some if-some loop} (first node))
+                           (vector? (second node)))
+                pair (partition 2 (second node))]
+            pair)))
+
+(defn- error-data-form?
+  "True when `node` builds a registered error variant of `forms`: a constructor
+  call naming one, or a literal map whose `:seon.error/type` is one; call
+  heads resolve through `qualify`."
+  {:malli/schema [:=> [:cat [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary, :seon.schema.admission/reason "Any source node.", :gen/elements [nil 0 :k [] {}]}] :map [:=> [:cat :symbol] :symbol]] :boolean]}
+  [node forms qualify]
+  (boolean
+   (cond (map? node) (let [t (get node :seon.error/type)] (and (keyword? t) (contains? forms t)))
+         (and (seq? node) (symbol? (first node)))
+         (and (error-constructors (qualify (first node))) (keyword? (second node)) (contains? forms (second node)))
+         :else false)))
+
+(defn- lawful-throw?
+  "True when the throw `node` raises `(ex-info message data ...)` whose data is
+  a registered error variant (`error-data-form?`), directly or through a local
+  of `inits` every binding of which is one."
+  {:malli/schema [:=> [:cat [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary, :seon.schema.admission/reason "Any source node.", :gen/elements [nil 0 :k [] {}]}] [:map-of :symbol [:vector [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary, :seon.schema.admission/reason "A binding's init is arbitrary read data.", :gen/elements [nil 0 :k [] {}]}]]] :map [:=> [:cat :symbol] :symbol]] :boolean]}
+  [node inits forms qualify]
+  (let [raised (second node)
+        data (when (and (seq? raised) ('#{ex-info clojure.core/ex-info} (first raised))) (nth raised 2 nil))]
+    (boolean (or (error-data-form? data forms qualify)
+                 (and (symbol? data) (seq (get inits data))
+                      (every? #(error-data-form? % forms qualify) (get inits data)))))))
+
