+(defn- own-binding?
+  "Whether `ctx` wrote its own binding of `sci-var` since its fork."
+  {:malli/schema [:=> [:cat :seon.sci.eval/ctx :seon.sci.eval/sci-var] :boolean]}
+  [ctx sci-var]
+  (let [env @(:env ctx)
+        bound (get-in env [:sci/var-bindings sci-var] absent-intern)]
+    (not (or (identical? bound absent-intern)
+             (identical? bound (get-in env [::inherited-var-bindings sci-var]))))))
+
 (defn- turn-interns
   "This context's own definitions: the Vars it wrote since its fork.
 
