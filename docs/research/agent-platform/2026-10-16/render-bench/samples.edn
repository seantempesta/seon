ion (Astra F5, 2026-09-26): a retained branch's entity, written by a\n  ;; program older than a declared-default dial, lacks it. The reader requires\n  ;; nothing of it: the dial answers its declared default by schema name, and\n  ;; every dial the entity holds reads as held.\n  (test-support/with-database\n   (fn [connection]\n     (config/apply! {:seon.db/connection connection :seon.boot/cluster-name \"older-row\"\n                     :seon.config/manifest {:seon.config.eval/time-limit-ms 4321}})\n     (let [dial :seon.config.cache/max-bytes\n           declared (get (schema.edn/packaged-forms) dial)\n           older (:db-after (datahike.api/with\n                             (db/db connection)\n                             [[:db/retract [:seon.config/cluster \"older-row\"] dial\n                               (get (db/pull (db/db connection) [dial] [:seon.config/cluster \"older-row\"]) dial)]]))\n           effective (config/effective older \"older-row\")]\n       (is (nil? (get (db/pull older [dial] [:seon.config/cluster \"older-row\"]) dial))\n           \"the entity genuinely lacks the dial\")\n       (is (nil? (:seon.error/at effective)))\n       (is (= (:seon.config/default (malli.core/properties (schema/structural-schema declared)))\n              (get effective dial)))\n       (is (= 4321 (:seon.config.eval/time-limit-ms effective)))))))", :seon.fn/file #:db{:id 7633}, :seon.fn/form-span [27059 28485], :seon.program/definition-digest "aaa26a02fc0bed5e451dcb1a1b43322d4eaeaa2adbb6e02a935e5c0688f7495d", :seon.program/analyzed-source-digest "e98fede90c3bf754e9ee5925622fbdf954fa086cd8390890afa38d726be88598", :seon.fn/keywords #{:seon.config.eval/time-limit-ms :seon.config.cache/max-bytes :seon.config/cluster :seon.config/default :seon.config/manifest :seon.boot/cluster-name :db/retract :seon.db/connection :seon.error/at}, :db/id 13956, :seon.schema.admission/source :core, :seon.test/ns #:db{:id 9450}, :seon.fn/call-arities #{[clojure.test/deftest 2] [seon.sch