+(defn- used-prefix-bytes
+  "Bytes of the mmap file holding header + stored vectors (count*dim*4)."
+  ^long [^File file]
+  (with-open [raf (java.io.RandomAccessFile. file "r")]
+    (let [header (byte-array 32)]
+      (.readFully raf header)
+      (let [bb (doto (ByteBuffer/wrap header) (.order ByteOrder/LITTLE_ENDIAN))
+            _ (.position bb 8)
+            cnt (.getLong bb)
+            dim (.getLong bb)]
+        (min (.length file) (+ 64 (* cnt dim 4)))))))
+
