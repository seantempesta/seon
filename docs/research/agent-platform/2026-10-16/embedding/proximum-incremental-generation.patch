-          (when (pos? n)
-            (.update digest buffer 0 n)
-            (recur)))))
+      (loop [remaining (used-prefix-bytes file)]
+        (when (pos? remaining)
+          (let [n (.read input buffer 0 (int (min remaining (alength buffer))))]
+            (when (pos? n)
+              (.update digest buffer 0 n)
+              (recur (- remaining n)))))))
     (apply str (map #(format "%02x" (bit-and 0xff %)) (.digest digest)))))
 
