 ;; Reflink (COW copy) support for branch isolation
 
+;; macOS cp has no --reflink; its copy-on-write flag is -c (clonefile on APFS).
+(defn- clone-cp-args
+  [mode src dst]
+  (if (.contains (str/lower-case (System/getProperty "os.name")) "mac")
+    (if (= mode "always") ["/bin/cp" "-c" src dst] ["/bin/cp" "-c" src dst])
+    [ "cp" (str "--reflink=" mode) src dst]))
+
