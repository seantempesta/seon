{:category 3, :render-pair "schema-selected domain AI/HTML pair; HTML consumer", :symbol seon.render.web/shell, :source-sha256 "5a85016745c435a812724c120d3ddb99159d3c497076560c19fb9ec492257a45", :file "src/seon/render/web.clj", :evidence [{:file "src/seon/render/web.clj", :symbol "seon.render.web/shell", :row 363, :col 15, :target "clojure.core/str", :arity 2, :source "              :content \"width=device-width, initial-scale=1.0\"}]\n      [:title (str \"seon · \" (or viewer-namespace id))]\n      [:link {:rel \"stylesheet\""} {:file "src/seon/render/web.clj", :symbol "seon.render.web/shell", :row 397, :col 25, :target "clojure.core/str", :arity 4, :source "       [:div {:style \"display:none\"\n             :data-init (str \"@get('\" feed-url\n                             \"', {retryMaxCount: Infinity, \"\n                             \"openWhenHidden: false})\")}])]])))\n"} {:file "src/seon/render/web.clj", :symbol "seon.render.web/shell", :row 355, :col 3, :target "clojure.core/str", :arity 2, :source "           :seon.render.debug/viewer-namespace] :as request}]\n  (str\n   \"<!doctype html>\"\n   (hiccup/->string\n    [:html {:lang \"en\" :data-theme \"phosphor\"}\n     [:head\n      [:meta {:charset \"utf-8\"}]\n      [:meta {:name \"viewport\"\n              :content \"width=device-width, initial-scale=1.0\"}]\n      [:title (str \"seon · \" (or viewer-namespace id))]\n      [:link {:rel \"stylesheet\"\n              :href (route/path ::route/css {:path \"output.css\"})}]\n      (when viewer-namespace\n        [:script {:src (route/path ::route/js {:path \"cytoscape.min.js\"})}])\n      [:script {:type \"module\"\n                :src (route/path ::route/js {:path \"datastar.js\"})}]\n      (when viewer-namespace\n        [:script {:type \"module\"\n                  :src (route/path ::route/js {:path \"seon-graph.js\"})}])]\n     ;; SEMANTIC CLASSES, not utility strings, for the same reason the\n     ;; render surfaces already use them (the note above `.seon-problems`\n     ;; in `input.css`): the document frame is one thing, it is styled in\n     ;; one place, and restyling the page does not mean editing Clojure.\n     [:body {:class \"seon-body\"}\n      ;; `seq`, not the vector: a page is a VECTOR OF ELEMENTS, and a\n      ;; vector whose head is a vector is not hiccup — the grammar\n      ;; refuses it, correctly, and the first live page came back empty\n      ;; until this said `seq`. A seq is a fragment and splices.\n      [:main {:class \"seon-main\"}\n       (when-not (::session? request)\n         [:nav {:class \"seon-agent-routes\"}\n          (when (and id (not (::agent-header? request)))\n            (list [:a {:href (route/path ::route/agent {:id id})} \"agent\"]\n                  [:a {:href (route/path ::route/agent-debug {:id id})} \"debug\"]))\n          [:a {:href (route/path ::route/chains)} \"chains\"]\n          [:a {:href (route/path ::route/health)} \"health\"]])\n       (when (and id (not (::session? request)) (not (::agent-header? request))) (message-bar-html (with-database {:seon.agent/id id} request)))\n       (seq page)]\n      ;; OUTSIDE every morph target. A data-init inside one is stripped\n      ;; by that element's first whole-element morph, and the tab then\n      ;; looks alive while receiving nothing.\n      (when (and feed-url (not (::session? request)))\n       [:div {:style \"display:none\"\n             :data-init (str \"@get('\" feed-url\n                             \"', {retryMaxCount: Infinity, \"\n                             \"openWhenHidden: false})\")}])]])))\n"}], :shown "Domain facts, values or failures on web/debug pages", :one-render-lane false, :status :VERIFIED, :id "A351", :missing-option "structured composition / source mode / structural mode at the same entrance", :finding "Constructs domain text or diagnostic text from values before the common print stage.", :conversion "Keep the values as data until seon.sci.eval/shown-result. Use schema-selected domain AI/HTML pair; HTML consumer. Return error details as members beside fixed message text. Emit the selected text or hiccup once; avoid composing independently printed fields.", :owner seon.render.web}
