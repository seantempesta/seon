+        row (fn [connection identity source]
+              (test-support/transacted! connection (test-support/replacement-tx (db/db connection) identity source {})))
+        _ (row (:seon.db/connection base) [:seon.fn/sym answer]
+               "(defn base-answer {:malli/schema [:=> [:cat] :int]} [] 1)")
+        _ (doseq [[test-symbol source] [[proof "(clojure.test/deftest evaluator-proof (clojure.test/is (= 1 1)))"]
+                                        [same-red "(clojure.test/deftest red-at-the-base-and-after (clojure.test/is (= 1 2)))"]
+                                        [uses-f "(clojure.test/deftest green-at-the-base-red-after (clojure.test/is (= 1 (base-answer))))"]]]
+            (row (:seon.db/connection base) [:seon.test/sym test-symbol] source))
+        commit (db/commit-id (db/db (:seon.db/connection base)))
+        _ (registry/fork! {:seon.store/store store :seon.store/branch agent-branch
+                           :seon.cluster.registry/from commit :seon.db/db (db/db (:seon.db/connection base))})
+        candidate (cluster.agent/acquire-context! target nil {:seon.agent/branch agent-branch})
+        conn (:seon.db/connection candidate)]
+    (try
+      (let [own-run (fn [execution identities]
+                      (binding [sut/*member* nil]
+                        (db/with-branch {:seon.db/connection (:seon.db/connection execution)}
+                          #(sut/run {:seon.test/policy :named :seon.test/execution execution
+                                     :seon.test/recording-connection (:seon.db/connection execution)
+                                     :seon.test/identities identities :seon.test/rerun? true}))))
+            base-run (own-run base #{same-red uses-f})
+            _ (row conn [:seon.fn/sym answer] "(defn base-answer {:malli/schema [:=> [:cat] :int]} [] 2)")
+            run (own-run candidate #{proof same-red uses-f})
+            results (vec (:seon.test/results run))
+            asked (sut/red-evaluators results #{proof})
+            branch (db/db conn)
+            base-db (db/commit-database branch commit)
+            judged (fn [members on-base]
+                     (cond-> {:seon.source/members members :seon.task/proofs #{proof} :seon.source/results results
+                              :seon.program/identities #{} :seon.test.run/id (:seon.test.run/id run)
+                              :seon.test.run/branch agent-branch}
