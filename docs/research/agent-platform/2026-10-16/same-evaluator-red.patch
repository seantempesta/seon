+                 (into {} (map (juxt :seon.test/sym :seon.test.member/evaluator)) (remove #(= proof (:seon.test/sym %)) results)))
+              "a program-row test runs interpreted on the branch")
+          (is (= {same-red :interpreted uses-f :interpreted} asked) "each red asks the base under its own evaluator")
+          (is (= {same-red true uses-f false}
+                 (sut/held-red base-db (db/db (:seon.db/connection base)) asked))
+              "the base's interpreted results answer the interpreted reds")
+          (is (= {} (sut/held-red base-db (db/db (:seon.db/connection base)) {same-red :compiled uses-f :compiled}))
+              "a result another evaluator recorded answers nothing")
+          (is (= {same-red true uses-f false} (binding [sut/*member* nil] (sut/fork-point-red candidate commit asked nil)))
+              "the merge's question, from the agent's branch")
+          (let [on-base ((requiring-resolve 'seon.cluster.source/red-at-merge-base) branch commit results #{proof})
+                done (requiring-resolve 'seon.cluster.source/done-refusals)
+                verdict (requiring-resolve 'seon.cluster.source/results-verdict)
+                still-red (judged #{proof same-red} on-base)
+                broken (judged #{proof same-red uses-f} on-base)]
+            (is (= #{same-red} on-base) "done reads the red held at the merge base under the same evaluator")
+            (is (= [] (types (done branch still-red)) (types (verdict branch branch still-red)))
+                "red at the merge base and red after: done and merge both accept")
+            (is (= [:seon.source/red-test-error] (types (done branch broken)) (types (verdict branch branch broken)))
+                "green at the merge base and red after: done and merge both refuse"))
+          (is (not (:seon.error/at base-run)) "the base run recorded")
+          (finally ((requiring-resolve 'seon.cluster.source/release!) [base-db]))))
+      (finally
+        (cluster.agent/release-context! candidate)
+        (cluster.agent/release-context! base)
+        (registry/retire-branch! {:seon.store/store store :seon.store/branch agent-branch})
+        (registry/retire-branch! {:seon.store/store store :seon.store/branch base-branch})))))
