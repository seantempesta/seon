+                               resolved (read! (error/resolution database (:seon.error/signature pulled)))
+                               fact (error/latest-fact pulled)]
+                           (cond-> (merge (error/value fact)
+                                          (select-keys fact [:seon.error.occurrence/count :seon.error.occurrence/branch]))
+                             resolved (assoc :seon.error/resolution resolved))))
