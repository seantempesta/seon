+  ;; differently; the writer's advanced projection is held by the context-bound
+  ;; base, so neither sees the other's callable.
+  ((requiring-resolve 'seon.test-support/with-running-agent)
+   (fn [running agent-id _]
+     (let [sibling (str agent-id "-sibling")
+           define (fn [agent predicate]
+                    (eval! "(in-ns 'f40.two-contexts)" agent running)
+                    (eval! (str "(defn same? {:malli/schema [:=> [:cat :int] :boolean]} [x] " predicate ")
+                                 (defn halve {:malli/schema [:=> [:cat [:fn {:gen/elements [0 2]} f40.two-contexts/same?]] :int]} [x] (quot x 2))")
+                           agent running))
+           call (fn [agent code] ((requiring-resolve 'seon.test-support/mcp-reply) (eval! code agent running)))
+           refused? (fn [reply] (= :seon.instrument/contract-error (get-in reply [:seon.repl/error :seon.error/type])))]
+       (is (false? (get (define agent-id "(even? x)") "isError")) "the first context's definitions are admitted")
+       (is (false? (get (define sibling "(odd? x)") "isError")) "the second context's definitions are admitted")
+       (is (= 2 (:seon.repl/value (call agent-id "(halve 4)"))) "the first context calls its own predicate")
+       (is (refused? (call agent-id "(halve 3)")) "the first context refuses what its predicate refuses")
+       (is (= 1 (:seon.repl/value (call sibling "(halve 3)"))) "the second context calls its own predicate")
+       (is (refused? (call sibling "(halve 4)")) "the second context refuses what its predicate refuses")))))
+
 (def ^:private form-request-taker
   "An interpreted function contracted on `:my.edit/form-request`, whose predicate
   `seon.edit/valid-form-operation?` the registry reaches."
