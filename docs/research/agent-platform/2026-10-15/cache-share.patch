+(defn- strip-error-instants
+  "Project any nested error map inside an attempt-level must-read through `seon.error/reply-value` so no per-call
+  wall-clock `:seon.error/at` enters the attempt's cached prefix."
+  [database value]
+  (cond
+    (and (map? value) (:seon.error/at value) (:seon.error/message value))
+    (error/reply-value database value)
+    (map? value)
+    (into (empty value) (map (fn [[k v]] [k (strip-error-instants database v)])) value)
+    (vector? value)
+    (mapv #(strip-error-instants database %) value)
+    :else value))
+
