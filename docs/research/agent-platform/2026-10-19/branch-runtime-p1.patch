+(defn- analyse-loaded-functions!
+  "Root each `src` function of the loaded program SCI can run at its analysed
+  definition in `ctx`, armed with its contract; the acquisition summary.
+
+  A call resolves its callees late, through the Var each analysed body holds,
+  in the executing context's own binding: a branch that redefines a helper
+  changes every caller it reaches on that branch, compiled entrance or not.
+  The namespace's other compiled interns (private state, `def`/`defonce`
+  values) are bound as the host's, so interpreting adds no second copy of
+  process state. A host-bound declaration (`:seon.fn/host-bound?`), a macro,
+  a value definition and a test-root or unloaded namespace keep their compiled
+  copy; so does one SCI cannot analyse, which the summary answers as a refusal."
+  {:malli/schema [:=> [:cat :seon.sci.eval/ctx :seon.db/database-value :seon.schema/projection] :map]}
+  [ctx database projection]
+  (let [test-names (::test-namespaces @(::kernel/program-snapshot ctx))
+        rows (db/q '[:find ?sym ?source ?spec ?digest
+                     :where [?f :seon.fn/host-bound? false]
+                     [?f :seon.schema.admission/source :core]
+                     [?f :seon.fn/arglists ?arglists] [(not= "()" ?arglists)]
+                     (not [?f :seon.fn/macro? true])
+                     [?f :seon.fn/ns ?namespace] [?namespace :seon.fn/file ?file]
+                     [?file :seon.fn.file/relative-root "src"]
+                     [?f :seon.fn/sym ?sym] [?f :seon.fn/source ?source]
+                     [(get-else $ ?f :seon.fn/spec "") ?spec]
+                     [(get-else $ ?f :seon.program/definition-digest "") ?digest]]
+                   database)
+        _ (when (db/read-refusal? rows) (throw (ex-info (:seon.error/message rows) rows)))
+        rows (sort-by (comp str first)
+                      (filter (fn [[sym]] (let [namespace-name (symbol (namespace sym))]
+                                            (and (find-ns namespace-name) (not (contains? test-names namespace-name)))))
+                              rows))]
+    (doseq [namespace-name (distinct (map (comp symbol namespace first) rows))
+            :let [present (get-in @(:env ctx) [:namespaces namespace-name])]]
+      (install-host-namespace! ctx namespace-name
+                               (remove (fn [[local-name]] (contains? present local-name))
+                                       (ns-interns (find-ns namespace-name)))))
+    (let [outcomes (binding [sci.lang/*write-observer* nil sci.lang/*expansion-observer* nil]
+                     (sci.ctx-store/with-ctx ctx
+                       (mapv (fn [[sym source]]
+                               (let [namespace-name (symbol (namespace sym))]
+                                 (try
+                                   (let [form (:seon.sci.reader/form (one-event source namespace-name ctx (count source)))]
+                                     (sci/binding [sci/ns (context-namespace ctx namespace-name)]
+                                       (sci/eval-form ctx form))
+                                     sym)
+                                   (catch Exception failure
+                                     (interpretation-failure sym failure)))))
+                             rows)))
+          analysed (set (filter symbol? outcomes))]
+      ;; Armed as the compiled Vars are without a supplied cluster: the base is
+      ;; a function of the loaded program alone (`cluster-base-key`).
+      (let [caps (config/result-caps config/defaults)
+            current (call-preparation/snapshot database projection)]
+        (when (db/read-refusal? current)
+          (throw (ex-info (:seon.error/message current) current)))
+        (sci.ctx-store/with-ctx ctx
+          (doseq [[sym _ spec digest] rows
+                  :when (and (analysed sym) (seq spec))
+                  :let [contract (edn/read-string spec)
+                        sci-var (sci/resolve ctx sym)]]
+            (sci/bind-root!
+             ctx sci-var
+             (instrument/wrap-interpreted
+              sym contract (kernel/context-bound-projection ctx projection contract) caps @sci-var
+              (cond-> {:seon.call-preparation/snapshot current}
+                (seq digest) (assoc :seon.program/definition-digest digest)))))))
+      {::analysed-count (count analysed)
+       ::analysis-refusals (filterv map? outcomes)})))
+
