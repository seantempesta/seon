+(defn- leaves
+  "The functions in `database` that behave the same in every runtime: their
+  indexed calls (`:seon.fn/calls`, analysis complete) name no program
+  definition but their own and no run-time name resolution, so the compiled
+  Var is their definition on every branch that has not changed them."
+  {:malli/schema [:=> [:cat :seon.db/database-value] [:set :qualified-symbol]]}
+  [database]
+  (let [read! (fn [result] (when (db/read-refusal? result) (throw (ex-info (:seon.error/message result) result))) result)
+        resolving '#{clojure.core/resolve clojure.core/ns-resolve clojure.core/requiring-resolve clojure.core/find-var
+                     clojure.core/eval clojure.core/load-string clojure.core/load-file clojure.core/intern
+                     clojure.core/var-get clojure.core/the-ns clojure.core/ns-publics clojure.core/ns-interns}
+        program (set (read! (db/q '[:find [?sym ...] :where [_ :seon.fn/sym ?sym]] database)))
+        analysed (set (read! (db/q '[:find [?sym ...] :where [?f :seon.program/analyzed-source-digest] [?f :seon.fn/sym ?sym]]
+                                   database)))
+        calls (read! (db/q '[:find ?sym ?callee :where [?f :seon.fn/sym ?sym] [?f :seon.fn/calls ?callee]] database))]
+    (reduce (fn [held [sym callee]]
+              (cond-> held (or (resolving callee) (and (not= sym callee) (program callee))) (disj sym)))
+            analysed calls)))
+
