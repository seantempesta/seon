+(deftest an-own-definition-keys-its-derivations-after-every-re-rooting
+  ;; F7's arm gap: a write `seon.sci.arm/arm!` takes as behavior held, or a
+  ;; re-arm of a dependent on a predicate held apart, re-roots the agent's own
+  ;; definition; its derivations stay keyed by the branch's changes
+  ;; (`seon.sci.runtime/reaching`), so main never reads them.
+  (test-support/with-running-agent
+   (fn [running agent-id _connection]
+     (let [answer (fn [code] (test-support/mcp-replies
+                              (json/read-str (mcp/call (json/write-str {"name" "eval_clj"
+                                                                        "arguments" {"cluster" running "agent" agent-id
+                                                                                     "mode" "sci" "code" code}})))))
+           derive-source (str "(in-ns 'seon.batch) (defn rr-derive \"P.\" {:malli/schema [:=> [:cat [:or :seon.profile/ordinal :int]] :int]}"
+                              " [n] (seon.cache/lookup :rr/derive [n] (constantly 1) (fn [] n)))")
+           derived (fn [n]
+                     (seon.cache/evict-kinds! #{:rr/derive})
+                     (is (= n (:seon.repl/value (last (answer (str "(seon.batch/rr-derive " n ")"))))) "the agent's definition answers")
+                     (seon.cache/present :rr/derive [n]))]
+       (answer derive-source)
+       (is (nil? (derived 7)) "a first write keys its derivation by the branch's changes")
+       (answer derive-source)
+       (is (nil? (derived 8)) "a write of the definition the branch holds keeps the key")
+       (answer (str "(in-ns 'seon.batch) (defn stamped-clock? \"P.\" {:malli/schema [:=> [:cat :any] :boolean]}"
+                    " [x] (boolean (instance? java.util.concurrent.atomic.AtomicLong x)))"))
+       (is (nil? (derived 9)) "a re-arm on a predicate held apart keeps the key")))))
+
