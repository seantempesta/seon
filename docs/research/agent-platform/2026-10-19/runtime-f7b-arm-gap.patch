+(defn keep-reaching!
+  "Wrap again, as `seon.sci.runtime/reaching`, each of `syms` that `ctx`'s
+  runtime wrapped (`bind-analysed!`) and whose Var a write or a re-arm has
+  re-rooted since, so the derivations it makes keep the key of the changes
+  its code reaches; nil."
+  {:malli/schema [:=> [:cat :seon.sci.eval/ctx [:sequential :qualified-symbol]] :nil]}
+  [ctx syms]
+  (let [snapshot (::kernel/program-snapshot ctx)
+        wrapped (::wrapped @snapshot)
+        rewrapped (sci.ctx-store/with-ctx ctx
+                    (into {} (keep (fn [sym]
+                                     (when-let [{wrapper ::wrapper reached ::reached} (get wrapped sym)]
+                                       (let [sci-var (sci/resolve ctx sym)
+                                             root @sci-var]
+                                         (when-not (identical? root wrapper)
+                                           (let [again (runtime/reaching root reached)]
+                                             (sci/bind-root! ctx sci-var again)
+                                             [sym {::raw root ::wrapper again ::reached reached}]))))))
+                          syms))]
+    (swap! snapshot update ::wrapped merge rewrapped)
+    nil))
+
 (defn- acquire-program!
   "Acquire the loaded program into its base context. Compiled definitions bind
   their JVM roots; namespaces the JVM has not loaded interpret their source.
