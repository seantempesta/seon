+(defn- bind-analysed!
+  "Bind each loaded `src` function SCI can run (`::runtime-rows`) in `ctx` to
+  its analysed definition (`seon.sci.runtime/analysed`), once per context; the
+  analysis summary. Main runs its compiled Vars; a runtime whose program
+  differs (an overlay, an agent's own change) binds these, so a call resolves
+  its callees late, through the Var each analysed body holds, in the executing
+  context's own binding: a branch that redefines a helper changes every caller
+  it reaches on that branch, compiled entrance or not. An analysis is keyed by
+  content and shared by every context of the process; one SCI cannot analyse
+  keeps its compiled copy and is answered as a refusal."
+  {:malli/schema [:=> [:cat :seon.sci.eval/ctx] :map]}
+  [ctx]
+  (let [snapshot (::kernel/program-snapshot ctx)]
+    (if (::analysed-roots @snapshot)
+      (::analysis @snapshot)
+      (let [space (runtime/program-space ctx)
+            outcomes (binding [sci.lang/*write-observer* nil sci.lang/*expansion-observer* nil]
+                       (sci.ctx-store/with-ctx ctx
+                         (mapv (fn [{sym :seon.fn/sym :as row}]
+                                 (try
+                                   (let [analysed (runtime/analysed space row)]
+                                     (sci/bind-root! ctx (sci/resolve ctx sym) analysed)
+                                     [sym analysed])
+                                   (catch Exception failure
+                                     (interpretation-failure sym failure))))
+                               (::runtime-rows @snapshot))))
+            roots (into {} (filter vector?) outcomes)
+            analysis {::analysed-count (count roots) ::analysis-refusals (filterv map? outcomes)}
+            vars (sci.ctx-store/with-ctx ctx (mapv #(sci/resolve ctx %) (keys roots)))]
+        ;; the program's own definitions, never this context's: its own
+        ;; definitions differ from these (`own-bindings`)
+        (swap! (:env ctx) (fn [env] (update env ::inherited-var-bindings merge
+                                            (select-keys (:sci/var-bindings env) vars))))
+        (swap! snapshot assoc ::analysed-roots roots ::analysis analysis)
+        analysis))))
