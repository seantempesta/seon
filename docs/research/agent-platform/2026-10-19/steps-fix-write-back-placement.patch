+        replaced-calls (keep (fn [[_ was now]] (when (and was now (not (:seon.ns/name was)))
+                                                 [(first (span-of was)) (set (:seon.fn/calls now))]))
+                             changes)
+        added-calls (keep (fn [[[_ declared] was now]] (when (and now (not was)) [declared (set (:seon.fn/calls now))]))
+                          changes)
+        anchor (fn anchor [declared seen]
+                 (some->> (concat (keep (fn [[start calls]] (when (calls declared) start)) replaced-calls)
+                                  (keep (fn [[caller calls]] (when (and (calls declared) (not (seen caller)))
+                                                               (anchor caller (conj seen caller))))
+                                        added-calls))
+                          seq (apply min)))
         ;; Additions first, each after the additions it calls: one inserted at the anchor precedes the
         ;; replacement starting there.
