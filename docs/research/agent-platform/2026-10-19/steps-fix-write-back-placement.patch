         from-blank (fn [start] (loop [begin start n 0]
                                  (if (and (< n 2) (pos? begin) (= 10 (aget ^bytes base-bytes (dec begin))))
                                    (recur (dec begin) (inc n)) begin)))
-        ;; An addition goes before the earliest function or test this write
