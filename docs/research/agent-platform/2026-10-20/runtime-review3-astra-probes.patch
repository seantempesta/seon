+(deftest a-loaded-value-initializer-executes-the-whole-branch
+ (s/with-database
+  (fn [conn]
+    (let [before (db/db conn)
+          a-db (#'seon.sci.eval-test/branch-replacing! conn 'seon.review3-fixture/h "\\[\\] 1\\)" "[] 2)")
+          a (e/base-ctx a-db)
+          b-db (#'seon.sci.eval-test/branch-replacing! conn 'seon.review3-fixture/h "\\[\\] 2\\)" "[] 3)")
+          b (e/base-ctx b-db)
+          continued (doto (e/base-ctx a-db) (#(e/acquire! {:seon.sci.eval/ctx % :seon.db/db b-db})))
+          query "[seon.review3-fixture/a-value (seon.review3-fixture/f) (seon.review3-fixture/g)]"
+          actual (mapv #(p/in % query) [a b continued (e/base-ctx before)])]
+      (p/record! "real-value-production" {:actual actual :expected [[2 2 2] [3 3 3] [3 3 3] [1 1 1]]})
+      (is (= [[2 2 2] [3 3 3] [3 3 3] [1 1 1]] actual))))))
+(deftest a-branch-cache-reader-cannot-read-the-entry-it-replaced
+ (s/with-database
+  (fn [conn]
+   (let [database (#'seon.sci.eval-test/branch-replacing! conn 'seon.render/invocation-weight
+                        "(?s)\\[entry\\].*$" "[entry] 2048)")
+         b (e/base-ctx database)
+         evidence {:seon.render/program-snapshot {} :seon.render/program-evidence {} :seon.render/projection {}}
+         key [:review3 (id/id)]
+         _ (seon.render/retain-invocation! key (assoc evidence :review3/value :main))
+         f (p/in b "(fn [key evidence] [(seon.render/retain-invocation! key (assoc evidence :review3/value :branch)) (seon.render/invocation key evidence)])")
+         actual (mapv :review3/value (sci.ctx-store/with-ctx b (f key evidence)))]
+     (p/record! "real-stale-invocation" {:actual actual :expected [:branch :branch]})
+     (is (= [:branch :branch] actual))))))
+(deftest a-loaded-open-macro-executes-the-whole-branch
+ (s/with-database
+  (fn [conn]
+   (let [database (#'seon.sci.eval-test/branch-replacing! conn 'seon.review3-fixture/h "\\[\\] 1\\)" "[] 2)")
+         b (e/base-ctx database)
+         actual (p/in b "[(seon.review3-fixture/h) (seon.review3-fixture/open-macro) (seon.review3-fixture/open-caller)]")
+         flags (db/pull database [:seon.fn/host-bound? :seon.fn/macro?] [:seon.fn/sym 'seon.review3-fixture/open-macro])]
+    (p/record! "real-open-macro" {:actual actual :expected [2 2 2] :flags flags})
+    (is (= [2 2 2] actual))))))
+(deftest a-multimethod-change-is-local-to-an-acquired-fork
+ (s/with-database
+  (fn [conn]
+   (let [database (db/db conn)
+         c (e/base-ctx database)
+         _ (p/in c "(ns review3) (defmulti mm identity) (defmethod mm :a [_] 1)")
+         a (e/fork-cluster-ctx c database conn)
+         b (e/fork-cluster-ctx c database conn)
+         _ (p/in a "(in-ns 'review3) (defmethod mm :a [_] 2)")
+         actual (mapv #(p/in % "(review3/mm :a)") [a b c])]
+    (p/record! "real-multimethod-local" {:actual actual :expected [2 1 1]})
+    (is (= [2 1 1] actual))))))
+(deftest a-protocol-extension-is-local-to-an-acquired-fork
+ (s/with-database
+  (fn [conn]
+   (let [database (db/db conn) c (e/base-ctx database)
+         _ (p/in c "(ns review3protocol) (defprotocol P (m [this])) (defrecord R [] P (m [_] 1)) (def r (->R))")
+         a (e/fork-cluster-ctx c database conn) b (e/fork-cluster-ctx c database conn)
+         _ (p/in a "(in-ns 'review3protocol) (extend-type R P (m [_] 2))")
+         actual (mapv #(p/in % "(review3protocol/m review3protocol/r)") [a b c])]
+    (p/record! "real-protocol-local" {:actual actual :expected [2 1 1]})
+    (is (= [2 1 1] actual))))))
diff --git a/test/seon/zz_runtime_review3_astra_pressure_test.clj b/test/seon/zz_runtime_review3_astra_pressure_test.clj
new file mode 100644
index 000000000..d443bdcc9
--- /dev/null
+++ b/test/seon/zz_runtime_review3_astra_pressure_test.clj
@@ -0,0 +1,24 @@
+(ns seon.zz-runtime-review3-astra-pressure-test
+ (:require [clojure.test :refer [deftest is]] [clojure.string :as str]
+           [sci.core :as sci] [sci.ctx-store] [seon.cache :as cache]
+           [seon.sci.runtime :as runtime] [seon.sci.runtime-test]))
+(deftest ^{:seon.test/long "Replay 100 branches under the shipped shared cache budget" :seon.test/long-ms 30000}
+ analyses-under-budget-pressure
+ (let [before (cache/status)
+       names (mapv #(symbol (str "f" %)) (range 1000))
+       scaled (fn [n v] (#'seon.sci.runtime-test/row 'rt.scale (str "(defn " n " [x] (+ x " v "))")))
+       main (runtime/bind (#'seon.sci.runtime-test/fresh-space (str "(ns rt.scale) (declare " (str/join " " names) ")"))
+                          (mapv #(scaled % 0) names))
+       rewrites (fn [b] (into (mapv #(scaled (nth names (mod (+ (* 7 b) %) 1000)) 1) (range 50))
+                              (mapv #(scaled (nth names (mod (+ (* 13 b) 500 %) 1000)) (+ 2 b)) (range 50))))
+       branches (mapv #(runtime/bind main (rewrites %)) (range 100))
+       distinct-digests (into #{} (comp (mapcat rewrites) (map :seon.program/definition-digest)) (range 100))
+       n (reduce + (map (comp count ::runtime/analysed) branches))
+       call (fn [ctx sym] (sci.ctx-store/with-ctx ctx (sci/eval-string* ctx (str "(" sym " 0)"))))
+       actual [(call main 'rt.scale/f0) (call main 'rt.scale/f500)
+               (call (first branches) 'rt.scale/f0) (call (first branches) 'rt.scale/f500)]
+       observation {:before before :after (cache/status) :distinct (count distinct-digests) :analysed n :answers actual}]
+   (spit "/Users/sean/src/seon/tmp/runtime-review3-astra/out/cache-pressure3.edn" (pr-str observation))
+   (is (= 1000 (count (::runtime/analysed main))))
+   (is (= (count distinct-digests) n))
+   (is (= [0 0 1 2] actual))))
