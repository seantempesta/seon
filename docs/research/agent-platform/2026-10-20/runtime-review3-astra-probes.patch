new file mode 100644
index 000000000..58451dc3e
--- /dev/null
+++ b/test/seon/runtime_review3_astra_new_test.clj
@@ -0,0 +1,68 @@
+(ns seon.runtime-review3-astra-new-test
+  (:require [clojure.test :refer [deftest is]] [clojure.pprint] [clojure.string]
+            [sci.core :as sci] [sci.ctx-store]
+            [seon.cache :as cache] [seon.id :as id] [seon.sci.eval :as e]
+            [seon.sci.runtime :as r] [seon.sci.kernel :as k]
+            [seon.sci.eval-test] [seon.test-support :as s] [seon.db :as db] [seon.render]))
+(defn record! [label x]
+  (spit (str "/Users/sean/src/seon/tmp/runtime-review3-astra/out/" label ".edn")
+        (with-out-str (clojure.pprint/pprint x))))
+(defn in [c text] (sci.ctx-store/with-ctx c (sci/eval-string* c text)))
+(defn shaped [sources calls roots]
+  (let [c (sci/fork (sci/init {:namespaces {'seon.cache
+                 {'lookup (sci/copy-var* #'cache/lookup (sci/create-ns 'seon.cache))
+                  'present (sci/copy-var* #'cache/present (sci/create-ns 'seon.cache))}}}))
+        rows (mapv (fn [[sym kind source]] {:seon.fn/sym sym :seon.fn/source source
+                    :seon.program/definition-digest (id/digest 64 [source])
+                    ::r/kind kind ::r/calls (get calls sym) ::r/macro-digests []}) sources)]
+    (in c (str "(ns review3) (declare " (clojure.string/join " " (map (comp name first) sources)) ")"))
+    (sci.ctx-store/with-ctx c
+      (doseq [[sym v] roots] (sci/bind-root! c (sci/resolve c sym) v)))
+    (assoc c ::k/program-snapshot (atom {::e/runtime-rows rows ::e/reach-index (r/reach-index calls #{})}))))
+(defn branch [c source sym]
+  (let [b (assoc (sci/fork c) ::k/program-snapshot (atom @(::k/program-snapshot c)))]
+    (in b (str "(in-ns 'review3) " source))
+    (#'e/bind-analysed! b {sym (id/digest 64 [source])} #{}) b))
+(deftest cache-reader-and-writer-agree-in-one-runtime
+  (cache/evict-kinds! #{:review3/value})
+  (let [sources [['review3/helper :function "(defn helper [] 1)"]
+                 ['review3/write-value :function "(defn write-value [] (seon.cache/lookup :review3/value :x (constantly 1) (fn [] (helper))))"]
+                 ['review3/read-value :function "(defn read-value [] (seon.cache/present :review3/value :x))"]]
+        main (shaped sources {'review3/helper #{} 'review3/write-value #{'review3/helper 'seon.cache/lookup}
+                              'review3/read-value #{'seon.cache/present}}
+                     {'review3/helper (fn [] 1)
+                      'review3/write-value (fn [] (cache/lookup :review3/value :x (constantly 1) (fn [] 1)))
+                      'review3/read-value (fn [] (cache/present :review3/value :x))})
+        b (branch main "(defn helper [] 2)" 'review3/helper)
+        before [(in b "(review3/write-value)") (in b "(review3/read-value)")]
+        _ (in main "(review3/write-value)")
+        after [(in b "(review3/write-value)") (in b "(review3/read-value)")]]
+    (record! "cache-read-write" {:expected [2 2] :before before :after after})
+    (is (= [2 2] before after))))
+(deftest a-value-executes-its-whole-runtime-during-production
+  (let [sources [['review3/a-value :value "(def a-value (f))"]
+                 ['review3/f :function "(defn f [] (g))"]
+                 ['review3/g :function "(defn g [] (h))"]
+                 ['review3/h :function "(defn h [] 1)"]]
+        main (shaped sources {'review3/a-value #{'review3/f} 'review3/f #{'review3/g}
+                              'review3/g #{'review3/h} 'review3/h #{}}
+                     {'review3/a-value 1 'review3/f (fn [] 1) 'review3/g (fn [] 1) 'review3/h (fn [] 1)})
+        b (branch main "(defn h [] 2)" 'review3/h)
+        actual (in b "[review3/a-value (review3/f) (review3/g)]")]
+    (record! "value-production-order" {:expected [2 2 2] :actual actual})
+    (is (= [2 2 2] actual))))
+(deftest real-invocation-cache-reader-and-writer
+  (s/with-database
+    (fn [conn]
+      (let [database (#'seon.sci.eval-test/branch-replacing! conn 'seon.render/invocation-weight
+                       "(?s)\\[entry\\].*$" "[entry] 2048)")
+            b (e/base-ctx database)
+            evidence {:seon.render/program-snapshot {} :seon.render/program-evidence {} :seon.render/projection {}}
+            key [:review3 (id/id)]
+            f (#'seon.sci.eval-test/in-context b
+                 "(fn [key evidence] [(seon.render/retain-invocation! key evidence) (seon.render/invocation key evidence)])")
+            actual (sci.ctx-store/with-ctx b (f key evidence))
+            expected [(dissoc evidence :seon.render/program-snapshot :seon.render/projection)
+                      (dissoc evidence :seon.render/program-snapshot :seon.render/projection)]]
+        (record! "real-invocation-cache" {:actual actual :expected expected})
+        (is (= expected actual))))))
