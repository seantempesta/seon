--- /dev/null
+++ b/test/seon/runtime_review3_astra_capacity_test.clj
@@ -0,0 +1,20 @@
+(ns seon.runtime-review3-astra-capacity-test
+ (:require [clojure.test :refer [deftest is]] [seon.db :as db] [seon.cache :as cache]
+           [seon.schema.internal :as internal] [seon.test-support :as s] [seon.profile :as profile]))
+(deftest projection-query-cache-retention-is-observable
+ (s/with-database
+  (fn [conn]
+   (let [p (db/carried-projection (db/db conn))
+         holder (internal/projection-cache p)
+         query (fn [i] (#'db/lowered-where p {} [[(symbol (str "?review3" i)) :seon.fn/sym '?value]]))
+         _ (query -1)
+         before {:entries (count @holder) :central (cache/status)}
+         first-batch (profile/measure #(dotimes [i 1000] (query i)))
+         middle {:entries (count @holder) :central (cache/status)}
+         second-batch (profile/measure #(dotimes [i 1000] (query (+ 1000 i))))
+         after {:entries (count @holder) :central (cache/status)}]
+    (spit "/Users/sean/src/seon/tmp/runtime-review3-astra/out/projection-capacity.edn"
+          (pr-str {:before before :middle middle :after after :holder-class (str (class @holder))
+                   :first (dissoc first-batch :seon.profile/value) :second (dissoc second-batch :seon.profile/value)}))
+    (is (= 1000 (- (:entries middle) (:entries before))))
+    (is (= 1000 (- (:entries after) (:entries middle))))))))
diff --git a/test/seon/runtime_review3_astra_extra_test.clj b/test/seon/runtime_review3_astra_extra_test.clj
