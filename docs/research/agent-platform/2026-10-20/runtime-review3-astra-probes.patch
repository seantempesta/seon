index 000000000..a17f5204a
--- /dev/null
+++ b/test/seon/runtime_review3_astra_extra_test.clj
@@ -0,0 +1,73 @@
+(ns seon.runtime-review3-astra-extra-test
+ (:require [clojure.test :refer [deftest is]] [clojure.pprint] [clojure.string]
+           [sci.core :as sci] [sci.ctx-store]
+           [seon.runtime-review3-astra-new-test :as p]
+           [seon.test-support :as s] [seon.db :as db] [seon.sci.eval :as e]
+           [seon.sci.runtime :as r] [seon.sci.kernel :as k]
+           [seon.sci.eval-test] [seon.schema.internal :as internal]))
+(deftest projection-cache-holds-the-executing-program
+ (s/with-database
+  (fn [conn]
+   (let [before (db/db conn)
+         projection (db/carried-projection before)
+         main (e/base-ctx before)
+         database (#'seon.sci.eval-test/branch-replacing! conn 'seon.schema.datahike/lower-where
+                      "(?s)\\[projection bound clauses\\].*$" "[projection bound clauses] [])")
+         b (e/base-ctx database)
+         caller (fn [ctx clauses]
+                  (let [f (p/in ctx "(fn [p clauses] (seon.db/lowered-where p {} clauses))")]
+                    (sci.ctx-store/with-ctx ctx (f projection clauses))))
+         ca '[[?review3-a :seon.fn/sym ?review3-b]]
+         cb '[[?review3-c :seon.fn/sym ?review3-d]]
+         branch-first [(caller b ca) (caller main ca)]
+         main-first (let [m (caller main cb)] [(caller b cb) m])]
+     (p/record! "projection-cache" {:branch-first branch-first :main-first main-first
+                                  :holder? (some? (internal/projection-cache projection))})
+     (is (= [[] ca] branch-first))
+     (is (= [[] cb] main-first))))))
+(deftest failed-production-does-not-bind-a-partial-runtime
+ (let [sources [['review3/a :function "(defn a [] (h))"]
+                ['review3/z :function "(defn z [] (UNRESOLVED))"]
+                ['review3/h :function "(defn h [] 1)"]]
+       main (p/shaped sources {'review3/a #{'review3/h} 'review3/z #{'review3/h} 'review3/h #{}}
+                             {'review3/a (fn [] 1) 'review3/z (fn [] 1) 'review3/h (fn [] 1)})
+       b (assoc (sci/fork main) ::k/program-snapshot (atom @(::k/program-snapshot main)))
+       _ (p/in b "(in-ns 'review3) (defn h [] 2)")
+       old @(::k/program-snapshot b)
+       result (try (#'e/bind-analysed! b {'review3/h "changed"} #{}) :no-error
+                   (catch Exception ex {:error (.getMessage ex)}))
+       actual (p/in b "[(review3/a) (review3/z) (review3/h)]")]
+   (p/record! "atomic-production" {:result result :actual actual :snapshot-equal? (= old @(::k/program-snapshot b))})
+   (is (map? result)) (is (= [1 1 2] actual)) (is (= old @(::k/program-snapshot b)))))
+(deftest record-protocol-and-multimethod-follow-a-childs-helper
+ (let [c (sci/init {})
+       _ (p/in c "(ns review3) (defn h [] 1) (defprotocol P (m [this])) (defrecord R [] P (m [_] (h))) (defmulti mm identity) (defmethod mm :a [_] (h)) (def r (->R))")
+       a (sci/fork c) _ (p/in a "(in-ns 'review3) (defn h [] 2)")
+       b (sci/fork a) _ (p/in b "(in-ns 'review3) (defn h [] 3)")
+       query "[(review3/m review3/r) (review3/mm :a)]"
+       actual (mapv #(p/in % query) [b a c b c])]
+   (p/record! "record-protocol-multi" {:actual actual :expected [[3 3] [2 2] [1 1] [3 3] [1 1]]})
+   (is (= [[3 3] [2 2] [1 1] [3 3] [1 1]] actual))))
+(deftest changing-a-multimethod-is-local-to-the-fork
+ (let [c (sci/init {})
+       _ (p/in c "(ns review3) (defmulti mm identity) (defmethod mm :a [_] 1)")
+       a (sci/fork c) b (sci/fork c)
+       _ (p/in a "(in-ns 'review3) (defmethod mm :a [_] 2)")
+       actual (mapv #(p/in % "(review3/mm :a)") [a b c])]
+   (p/record! "multimethod-local" {:actual actual :expected [2 1 1]})
+   (is (= [2 1 1] actual))))
+(deftest a-loaded-open-macro-reads-its-branches-helper
+ (let [sources [['review3/f :function "(defn f [] (m))"]
+                ['review3/m :macro "(defmacro m [] ((resolve 'review3/h)))"]
+                ['review3/h :function "(defn h [] 1)"]]
+       c (p/shaped sources {'review3/f #{'review3/m} 'review3/m #{'clojure.core/resolve} 'review3/h #{}}
+                           {'review3/f (fn [] 1) 'review3/h (fn [] 1)})
+       _ (p/in c "(in-ns 'review3) (defmacro m [] 1)")
+       _ (swap! (::k/program-snapshot c)
+                (fn [snap] (-> snap
+                  (assoc ::e/reach-index (r/reach-index {'review3/f #{'review3/m} 'review3/m #{'clojure.core/resolve} 'review3/h #{}} #{'clojure.core/resolve}))
+                  (update ::e/runtime-rows (fn [rows] (mapv #(if (= 'review3/f (:seon.fn/sym %)) (assoc % ::r/macro-digests [['review3/m "m0"]]) %) rows))))))
+       b (p/branch c "(defn h [] 2)" 'review3/h)
+       actual (p/in b "[(review3/h) (review3/f)]")]
+   (p/record! "open-macro" {:actual actual :expected [2 2]})
+   (is (= [2 2] actual))))
