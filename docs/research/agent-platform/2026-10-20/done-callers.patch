+(ns seon.fixture.loaded-chain
+  "A loaded chain `f` -> `g` -> `h`: a branch change to `h` reaches its unchanged callers, which a branch runs with it.")
+
+(defn h "The leaf." {:malli/schema [:=> [:cat] :int]} [] 1)
+(defn g "The middle caller." {:malli/schema [:=> [:cat] :int]} [] (h))
+(defn f "The top caller." {:malli/schema [:=> [:cat] :int]} [] (g))
