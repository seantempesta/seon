--- /dev/null
+++ b/src/seon/review3_fixture.clj
@@ -0,0 +1,13 @@
+(ns seon.review3-fixture (:require [seon.health]))
+(defn h "The leaf." {:malli/schema [:=> [:cat] :int]} [] 1)
+(defn g "The middle." {:malli/schema [:=> [:cat] :int]} [] (h))
+(defn f "The caller." {:malli/schema [:=> [:cat] :int]} [] (g))
+(def a-value (f))
+(defmacro open-macro "The helper found by name." [] ((resolve 'seon.review3-fixture/h)))
+(defn open-caller "The expanded helper." {:malli/schema [:=> [:cat] :int]} [] (open-macro))
+
+(defn h-dynamic "The dynamic leaf." {:malli/schema [:=> [:cat] :int]} [] 1)
+(defn open-handed "A supplied derivation resolving its helper at execution."
+ {:malli/schema [:=> [:cat :seon.db/database-value :seon.schema/value] :seon.schema/value]}
+ [database key]
+ (seon.health/derived database key (fn [_] ((resolve 'seon.review3-fixture/h-dynamic)))))
