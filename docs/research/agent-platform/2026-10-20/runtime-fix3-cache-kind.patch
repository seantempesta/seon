+(defn- cache-kinds
+  "The cache kinds `source` names at its entry-point calls: a `seon.cache`
+  call's kind, or a projection cache key or its head, as the qualified
+  keywords the definition holds (`keywords`, its `:seon.fn/keywords`) spell
+  them in `namespace-name`."
+  {:malli/schema [:=> [:cat :symbol [:set :keyword] :string] [:set :qualified-keyword]]}
+  [namespace-name keywords source]
+  (let [entry-names (into #{} (map name) cache-entry-points)
+        ;; an auto-resolved keyword reads with its alias (or this namespace) as its namespace
+        forms (edamame/parse-string-all source {:all true :read-cond :allow :features #{:clj}
+                                                :auto-resolve (fn [alias] (if (= :current alias) namespace-name alias))})
+        named (into #{} (comp (filter (fn [form] (and (seq? form) (symbol? (first form))
+                                                      (contains? entry-names (name (first form))))))
+                              (keep (fn [[_ a b]] (let [k (if (keyword? a) a b)
+                                                        k (if (vector? k) (first k) k)]
+                                                    (when (qualified-keyword? k) k)))))
+                    (tree-seq coll? seq forms))]
+    (into #{} (filter (fn [held] (some (fn [k] (and (= (name held) (name k))
+                                                    (or (= (namespace held) (namespace k))
+                                                        (not= (namespace k) (str namespace-name)))))
+                                       named)))
+          keywords)))
+
 (defn- callable-schema?
