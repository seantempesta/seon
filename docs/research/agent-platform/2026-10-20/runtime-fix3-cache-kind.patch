+(defn- followed
+  "`kept` less every name that follows ([[compiled-names]]) a name `kept` does
+  not hold, transitively; costs the followed names, never the program."
+  {:malli/schema [:=> [:cat [:map-of :qualified-symbol [:set :qualified-symbol]] [:set :qualified-symbol]]
+                  [:set :qualified-symbol]]}
+  [followers kept]
+  (loop [held kept todo (into [] (remove kept) (keys followers))]
+    (if-let [sym (peek todo)]
+      (let [fresh (filter held (get followers sym))]
+        (recur (reduce disj held fresh) (into (pop todo) fresh)))
+      held)))
