+(defn- release-at-exit!
+  "Release what one request acquired once every member it started has exited: its world (the handle,
+  then its overlay), then the request view that world stands on. At once when no member is live, else
+  on the last member's release, where a failure goes to `failed!`."
+  {:malli/schema [:=> [:cat [:maybe :seon.agent/execution-handle] [:sequential :seon.flow/future]
+                       [:maybe [:map [:seon.db/connection :seon.db/connection] [:seon.store/store :seon.store/store]]] [:=> [:cat :seon.error/throwable] :any]]
+                  :nil]}
+  [request-handle exits view failed!]
+  (let [release! (fn []
+                   (try (when request-handle
+                          (try (@release-context! request-handle)
+                               (finally (store/release-store! (:seon.store/store request-handle)))))
+                        (finally
+                          (when view
+                            (try (store/release-branch! (:seon.db/connection view))
+                                 (finally (store/release-store! (:seon.store/store view))))))))
+        live (into-array CompletableFuture (remove #(.isDone ^CompletableFuture %) exits))]
+    (if (zero? (alength live))
+      (release!)
+      ;; The release's own failure arrives on its stage's completion, as data.
+      (.whenComplete (.thenRun (CompletableFuture/allOf live) ^Runnable release!)
+                     (reify java.util.function.BiConsumer
+                       (accept [_ _ failure] (when failure (failed! (or (ex-cause failure) failure)))))))
+    nil))
+
