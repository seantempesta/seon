@@ -1828,6 +1828,19 @@
         "the producer's own message survives in the diagnostic")
     (is (= "#'my.x/lint3" (:seon.eval/shown receipt)) "the value stands")))
 
+(deftest a-refused-form-that-bound-no-var-does-not-claim-a-bound-var
+  ;; frictions-a, 2026-10-14: a refused `(require ...)` bound no Var yet read "any Var it bound exists in your
+  ;; SCI context only". The message describes what the refused form did.
+  (let [refusal {:seon.error/message "The namespace's requires close a cycle."
+                 :seon.error/at (java.util.Date.)
+                 :seon.error/layer :seon.turn.batch/program
+                 :seon.error/operation 'seon.turn.batch/program-facts}
+        no-var (#'turn/not-admitted {:seon.eval/shown "nil"} refusal)
+        bound (#'turn/not-admitted {:seon.eval/shown "#'my.x/f" :seon.sci.eval/bindings {'my.x/f {}}} refusal)]
+    (is (not (str/includes? (:seon.cluster.eval/error no-var) "Var")) "a form that bound no Var names none")
+    (is (str/includes? (:seon.cluster.eval/error no-var) "cycle") "the producer's message survives")
+    (is (str/includes? (:seon.cluster.eval/error bound) "SCI context only") "a form that bound a Var says where it lives")))
+
