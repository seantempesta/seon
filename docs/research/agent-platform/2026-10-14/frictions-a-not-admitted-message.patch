--- a/src/seon/turn.clj
+++ b/src/seon/turn.clj
@@ -2812,13 +2812,16 @@
 (defn- not-admitted
   "`receipt` whose form's program facts were refused: the value stands, the
   refusal is delivered whole beside it as one flat error whose message says
-  the declaration was NOT admitted to the program (a Var the form bound
-  exists in the agent's SCI context only), and the receipt's error names it."
+  the form's change was NOT admitted to the program, and, when the form bound a
+  Var (`:seon.sci.eval/bindings`), that the Var exists in the agent's SCI
+  context only; the receipt's error names it."
   {:malli/schema [:=> [:cat :map :seon.error/base] :map]}
   [receipt refusal]
-  (let [message (str "Not admitted to the program: its program facts were refused, so any Var it "
-                     "bound exists in your SCI context only and my.program/history has no such "
-                     "declaration. " (:seon.error/message refusal))]
+  (let [message (str "Not admitted to the program: its program facts were refused, so "
+                     (if (seq (:seon.sci.eval/bindings receipt))
+                       "any Var it bound exists in your SCI context only and my.program/history has no such declaration. "
+                       "my.program/history has no record of what it changed. ")
+                     (:seon.error/message refusal))]
     (-> receipt
         (update :seon.cluster.eval/error #(or % message))
         (with-diagnostic (assoc refusal :seon.error/message message)))))
--- a/test/seon/turn_test.clj
