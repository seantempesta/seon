diff --git a/test/seon/fn/reconcile_cost_test.clj b/test/seon/fn/reconcile_cost_test.clj
new file mode 100644
index 000000000..dc38edaff
--- /dev/null
+++ b/test/seon/fn/reconcile_cost_test.clj
@@ -0,0 +1,40 @@
+(ns seon.fn.reconcile-cost-test
+  (:require [clojure.java.io :as io]
+            [clojure.string :as str]
+            [clojure.test :refer [deftest is]]
+            [seon.db :as db]
+            [seon.fn :as functions]
+            [seon.profile :as profile]
+            [seon.test-support :as support]))
+
+(defn- unchanged-reconciliation
+  "The transaction and measured cost of reconciling `n` indexed functions
+  against the database that already holds them."
+  {:malli/schema [:=> [:cat [:int {:min 1}]] [:map [:tx :seon.schema/value] [:projections [:int {:min 0}]]]]}
+  [n]
+  (let [root (io/file "tmp" "reconcile-cost-test" (str (random-uuid)))
+        file (io/file root "sample/reconcile_cost.clj")]
+    (try
+      (.mkdirs (.getParentFile file))
+      (spit file (str "(ns sample.reconcile-cost)\n"
+                      (str/join "\n" (for [i (range n)]
+                                       (str "(defn f" i " [x] (inc x))")))
+                      "\n"))
+      (support/with-database
+       (fn [connection]
+         (let [entities (functions/program-entities {:seon.fn/roots [(.getPath root)]})]
+           (support/transacted! connection (functions/reconcile-tx (db/db connection) entities []))
+           (let [database (db/db connection)
+                 measured (profile/measure #(functions/reconcile-tx database entities []))]
+             {:tx (:seon.profile/value measured)
+              :projections (profile/calls-of measured 'seon.db/carried-projection)}))))
+      (finally (support/delete-recursively! root)))))
+
+(deftest ^{:seon/tasks #{'seon.fn/reconciliation-normalizes-against-one-projection}}
+  an-unchanged-population-reconciles-to-nothing-at-a-cost-independent-of-its-size
+  (let [small (unchanged-reconciliation 2)
+        large (unchanged-reconciliation 12)]
+    (is (= [] (:tx small)) "an unchanged population writes nothing")
+    (is (= [] (:tx large)) "an unchanged population writes nothing")
+    (is (= (:projections small) (:projections large))
+        "the projection is read once per reconciliation, never once per entity attribute")))
