+(defn- harness-closure
+  "The static call, reference and subject symbol closure of `harness-entries` on `tested`,
+  cached in `seon.cache` under the edge attributes' content revisions so body-only edits reuse it."
+  {:malli/schema [:=> [:cat :seon.db/database-value] [:set :qualified-symbol]]}
+  [tested]
+  (let [revisions (db/content-revisions tested [:seon.fn/sym :seon.test/sym :seon.fn/calls :seon.fn/references :seon.test/subject])]
+    (seon.cache/lookup
+     (::harness-closure (or (db/cache-owner tested) (seon.cache/default-cache)))
+     revisions
+     #(let [calls (reach-attribute tested :seon.fn/sym :seon.fn/calls)
+            refs (reach-attribute tested :seon.fn/sym :seon.fn/references)
+            test-calls (reach-attribute tested :seon.test/sym :seon.fn/calls)
+            test-refs (reach-attribute tested :seon.test/sym :seon.test/references)
+            subjects (reach-attribute tested :seon.test/sym :seon.test/subject)
+            edges (merge-with into calls refs test-calls test-refs subjects)]
+        (into #{} (mapcat val) (reach-fixed-point (vec harness-entries) edges))))))
