+(defn- host-namespace?
+  "Does `space` name a namespace the host knows without a database: a loaded one, a dependency-cache one, or one
+  whose source the loaded commit holds? The knowledge `names` and `alias-form?` share."
+  {:malli/schema [:=> [:cat :symbol] :boolean]}
+  [space]
+  (let [source (fs/source-directory)
+        stem (str/replace (munge space) "." "/")]
+    (boolean
+     (or (find-ns space)
+         (analyzer/cached-namespace space)
+         (some (fn [[root extension]] (.isFile (java.io.File. (io/file source root) (str stem extension))))
+               (for [root ["src" "test" "script"] extension [".clj" ".cljc"]] [root extension]))))))
+
