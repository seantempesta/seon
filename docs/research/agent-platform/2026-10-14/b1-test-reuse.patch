+(defn- carried-greens
+  "Each of `test-symbols` whose reuse identity `[sym reach-digest input-digest
+  evaluator]` (`reach` holds the digests) names a green another branch recorded,
+  with that run's id and pass count: retained in `seon.cache` when a run recorded
+  it (`seon.test.runner/retain-greens!`), else read from main's head
+  (`seon.task/main-head`) in one batched query. Only greens cross branches."
+  {:malli/schema [:=> [:cat :seon.db/database-value [:sequential :seon.test/sym] :map
+                       :seon.test.run/input-digest :seon.test.run/evaluator]
+                  [:map-of :seon.test/sym [:map [:seon.test.run/id :seon.test.run/id]
+                                           [:seon.test/pass-count :seon.test/pass-count]]]]}
+  [database test-symbols reach inputs evaluator]
+  (let [keyed (filterv #(string? (get reach %)) test-symbols)
+        cached (into {} (keep #(when-let [green (seon.cache/present :seon.test.runner/green [% (get reach %) inputs evaluator])]
+                                 [% green]))
+                     keyed)
+        missed (remove cached keyed)
+        main (when (seq missed) (task/main-head database))]
+    (into cached
+          (map (fn [[test-symbol run-id pass]] [test-symbol {:seon.test.run/id run-id :seon.test/pass-count pass}]))
+          (when main
+            (selection-read!
+             (db/q '[:find ?symbol ?id ?pass :in $ [[?symbol ?digest] ...] ?inputs ?evaluator
+                     :where [?member :seon.test.member/symbol ?symbol]
+                            [?member :seon.test.member/reach-digest ?digest]
+                            [?member :seon.test.member/terminated-tx]
+                            [?member :seon.test.member/pass-count ?pass] [(> ?pass 0)]
+                            [?member :seon.test.member/fail-count 0]
+                            [?member :seon.test.member/error-count 0]
+                            (not [?member :seon.test.member/error])
+                            [?run :seon.test.run/members ?member]
+                            [?run :seon.test.run/input-digest ?inputs]
+                            [?run :seon.test.run/evaluator ?evaluator]
+                            [?run :seon.test.run/id ?id]]
+                   main (mapv #(vector % (get reach %)) missed) inputs evaluator))))))
+
