+(defn bound-projection
+  "`projection` with each predicate it binds, and each `form` names, bound as
+  `ctx` resolves it: a predicate `ctx` holds apart from its compiled Var (its
+  branch defines or interprets it) binds `ctx`'s SCI Var, whose call reads
+  `ctx`'s binding, so a later redefinition needs no recompile; every other
+  keeps its compiled Var. Binding nothing new answers `projection` itself
+  (`seon.schema/with-bound-predicates`)."
+  {:malli/schema [:=> [:cat :seon.sci.eval/ctx :seon.schema/projection :seon.schema/value]
+                  :seon.schema/projection]}
+  [ctx projection form]
+  (let [held (schema/predicate-functions-in projection)
+        compiled (fn [predicate]
+                   (let [bound (get held predicate)]
+                     (if (var? bound)
+                       @bound
+                       (some-> (find-ns (symbol (namespace predicate)))
+                               (ns-resolve (symbol (name predicate)))
+                               deref))))
+        rebound (sci.ctx-store/with-ctx ctx
+                  (into {}
+                        (keep (fn [predicate]
+                                (when-let [sci-var (sci/resolve ctx predicate)]
+                                  (let [callable @sci-var]
+                                    (when (and (ifn? callable)
+                                               (not (identical? sci-var (get held predicate)))
+                                               (not (identical? callable (compiled predicate))))
+                                      [predicate sci-var])))))
+                        (into (set (keys held)) (#'schema/predicate-symbols-in form))))]
+    (schema/with-bound-predicates projection rebound)))
 
