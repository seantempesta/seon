+(deftest a-context-recompiles-only-for-a-predicate-it-interprets
+  ;; the same request on main and on a branch interpreting no predicate, then the
+  ;; branch's redefinition of one registered predicate and a request after it
+  (support/with-running-agent
+   (fn [running agent-id _]
+     (let [call (fn [agent-name code]
+                  (support/mcp-reply (json/read-str (mcp/call (json/write-str
+                                                               {"name" "eval_clj"
+                                                                "arguments" {"cluster" running "agent" agent-name "code" code}})))))
+           recompiles #(profile/calls-of % 'seon.schema/projection-with-declarations)]
+       (call "root" "(+ 1 1)")
+       (call agent-id "(+ 1 1)")
+       (let [main (measured ::main-request #(call "root" "(+ 1 1)"))
+             branch (measured ::branch-request #(call agent-id "(+ 1 1)"))
+             changed (measured ::predicate-change
+                               #(call agent-id "(in-ns 'seon.edit)
+                                  (defn valid-form-operation? {:malli/schema [:=> [:cat [:any {:seon.schema.admission/exemption :seon.schema.admission/polymorphic-boundary, :seon.schema.admission/reason \"A total predicate accepts arbitrary objects.\", :gen/elements [nil {}]}]] :boolean]} [request] false)"))
+             after (measured ::after-predicate-change #(call agent-id "(+ 1 1)"))]
+         (is (= 2 (:seon.repl/value (:seon.profile/value main))))
+         (is (zero? (recompiles main)) "main binds every predicate as compiled")
+         (is (zero? (recompiles branch)) "a branch interpreting no predicate recompiles nothing")
+         (is (pos? (recompiles changed)) "the branch's predicate recompiles what names it")
+         (is (zero? (recompiles after)) "a held binding needs no recompile"))))))
