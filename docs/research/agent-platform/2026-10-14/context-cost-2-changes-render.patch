+(defn- branch-changes
+  "The declaration `identities` the branch changed since its merge base, shown on `database` by family in name order,
+  each by its name and the form that reads it; a function no test of the branch reaches
+  (`seon.test.runner/tests-reaching` over the branch's tests' reach graph) says so, with the form that removes it;
+  a declaration the branch removed is named under `:seon.context/removed`. Families are absent when empty."
+  {:malli/schema [:=> [:cat :seon.db/database-value :seon.program/identity-set] [:or :seon.context/changes :seon.error/value]]}
+  [database identities]
+  (let [tests (db/q '[:find [?s ...] :where [_ :seon.test/sym ?s]] database)
+        entry (fn [[attribute value]]
+                (let [read-form (list 'my.program/source (if (keyword? value) value (list 'quote value)))
+                      reaching (when (= :seon.fn/sym attribute) (runner/tests-reaching database (vec (sort tests)) value))]
+                  (cond (:seon.error/at reaching) reaching
+                        (and (set? reaching) (empty? reaching))
+                        {:seon.ref/name value :seon.context/reached-by-no-test true
+                         :seon.render/operations [read-form (list 'my.program/ns-unmap! (list 'quote value))]}
+                        :else {:seon.ref/name value :seon.render/operations [read-form]})))
+        shown (reduce (fn [shown [attribute value :as identity]]
+                        (if-let [family (merged-families attribute)]
+                          (if (seq (db/datoms database :avet attribute value))
+                            (update shown family (fnil conj []) (entry identity))
+                            (update shown :seon.context/removed (fnil conj []) {:seon.ref/name value}))
+                          shown))
+                      {} (sort-by (comp str second) identities))]
+    (or (when (:seon.error/at tests) tests) (some #(when (:seon.error/at %) %) (mapcat val shown)) shown)))
+
 (defn- merged
   "What main's merge `commit` moved (`seon.cluster.source/merge-accepted`), shown on `database` by family
   (`by-family`)."
