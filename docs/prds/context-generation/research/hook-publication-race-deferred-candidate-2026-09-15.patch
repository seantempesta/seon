Candidate regression evaluated in seon.test-reaching-test, NOT LANDED:
(deftest adoption-check-runs-ordinary-tests-and-defers-declared-observations
  (support/with-database
    (fn [connection]
      (with-test connection '(clojure.test/is (= 4 (+ 2 2)))
        (fn [ordinary _]
          (with-test connection '(clojure.test/is (= 9 (* 3 3)))
            (fn [observation _]
              (let [reason "Observe external fixture lifecycle after ordinary reaching feedback."
                    admitted (db/transact!
                               connection
                               [{:seon.test/sym observation
                                 :seon.schema.admission/source :core
                                 :seon.test/fixture-observation reason}
                                {:db/id "datomic.tx"
                                 :seon.test/adoption-cluster [:seon.cluster/name "default"]
                                 :seon.test/adoption-identities [[:seon.test/sym ordinary]
                                                                 [:seon.test/sym observation]]
                                 :seon.test/adoption-inputs ["src/seon/id.clj"]}])
                    _ (is (:db-after admitted) (pr-str admitted))
                    result (sut/check-adoption connection "default")
                    feedback (sut/feedback result)]
                (is (= [ordinary] (:seon.test/passed result)) (pr-str result))
                (is (= [] (:seon.test/failed result)) (pr-str result))
                (is (= [{:seon.test/sym observation :seon.test/fixture-observation reason}]
                       (:seon.test/deferred result)))
                (is (= ["bin/test-check" "default" "--tests" observation]
                       (:seon.test/deferred-command result)))
                (is (.contains feedback (str "deferred " observation ": " reason)))
                (is (nil? (:seon.test/run (db/pull (db/db connection) [:seon.test/run]
                                                  [:seon.test/sym observation]))))
                (let [explicit (sut/check {:seon.db/connection connection
                                           :seon.test/changed [observation]
                                           :seon.test/check-time-limit-ms 120000})]
                  (is (= [observation] (:seon.test/passed explicit)) (pr-str explicit))
                  (is (empty? (:seon.test/deferred explicit))))))))))))
