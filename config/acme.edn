;; The Acme harness's OWN config manifest — proof of the per-cluster config
;; seam: bin/acme exports SEON_CONFIG=config/acme.edn, so the acme cluster
;; curates its loadout/routes/skills independently of the default cluster with
;; ZERO src edit (read by seon.config via the same aero reader as system.edn).
;;
;; Acme is the maximal-context downstream shape: the `:default` profile primes
;; the FULL agent skill corpus always-on (every body in `seon-skills/`), so an
;; acme agent boots with the richest context the harness can offer. The
;; `#profile` seam mirrors system.edn so the SAME cluster can flip to a lean
;; context with one env flag — no second file, no rebuild:
;;
;;   bin/acme restart pod                       ; :default → MAX features
;;   SEON_PROFILE=minimal bin/acme restart pod  ; :minimal → tight context (no skill body)
;;
;; aero falls back to `:default` for any unmatched profile, so a bare boot is
;; the maximal loadout. To prove retract-on-drop against a third-party shape,
;; point at a different manifest at the shell:
;;   SEON_CONFIG=config/test.edn bin/acme restart pod
{;; ── LLM PROVIDER is NOT set in this manifest ──
 ;; Same as the default cluster: the LLM provider/model is the `seon.ai`
 ;; env→DB surface (`:seon.ai/config` row), not this loadout manifest. For
 ;; the acme cluster set it in .env.acme (bin/acme sources it):
 ;;   SEON_AI_PROVIDER=diffusiongemma            ; deepseek (default) | anthropic
 ;;   SEON_DG_ENDPOINT=<runpod-endpoint-id>      ;   | openai-compat | diffusiongemma
 ;;   RUNPOD_API_KEY=<key>
 ;; Full var docs: .env.example (DIFFUSIONGEMMA block). A live switch is a
 ;; transact: {:seon.ai/id "config" :seon.ai/provider :diffusiongemma}.

 ;; ── per-role context loadouts (merged over default-seed-blocks at create) ──
 ;; `:default` profile = MAXIMUM features: every agent-corpus skill body is
 ;; always-on, each seeded as a :skill/<name> block at the cached-prefix
 ;; priority (16) via my.skills/skill-block, so the rich context is part of the
 ;; byte-stable cache prefix. `:minimal` profile = tight context control: an
 ;; empty loadout seeds NO always-on skill body (default-seed-blocks only).
 :seon.config/loadouts
 #profile {:default [{:seon.config/role         :default
                      :seon.config/default-load [:repl
                                                 :data-oriented-clojure
                                                 :datahike
                                                 :data-modeling
                                                 :clojurescript
                                                 :ui-live-tiles]}]
           :minimal []}}
