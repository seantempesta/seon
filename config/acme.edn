;; The Acme harness's OWN config manifest — proof of the per-cluster config
;; seam: bin/acme exports SEON_CONFIG=config/acme.edn, so the acme cluster
;; configures its whole agent context independently of the default cluster with
;; ZERO src edit (read by seon.config via the same aero reader as system.edn).
;;
;; Acme is the maximal-context downstream shape: the FULL agent skill corpus is
;; always-on, and it demonstrates the PER-CLUSTER overrides the v3 two-level
;; model unlocks (a per-agent LLM, a pinned full-source ns set, a custom eval
;; decay schedule) — every dial settable from THIS file, no src/seon edit. To
;; flip to the lean variant, point SEON_CONFIG at a SEPARATE file (no #profile):
;;
;;   bin/acme restart pod                                   ; MAX context (this file)
;;   SEON_CONFIG=config/acme-minimal.edn bin/acme restart pod   ; lean context
;;   SEON_CONFIG=config/test.edn bin/acme restart pod       ; the test manifest
{;; ── LLM PROVIDER cluster default is the env→DB row (kept) ──
 ;; The cluster's default provider/model is the `seon.ai` env→DB surface
 ;; (`:seon.ai/config` row), set in .env.acme (bin/acme sources it):
 ;;   SEON_AI_PROVIDER=diffusiongemma            ; deepseek (default) | anthropic
 ;;   SEON_DG_ENDPOINT=<runpod-endpoint-id>      ;   | openai-compat | diffusiongemma
 ;;   RUNPOD_API_KEY=<key>
 ;; The per-agent `:seon.ai/agent-*` keys below DEFAULT :inherit → the global
 ;; row → .env.acme's value (the env→DB dual-default is preserved), and can
 ;; OVERRIDE per agent in the agent-context.

 ;; ── AGENT-CONTEXT (v3) — the two-level context the generic loader consumes ──
 :seon.config/agent-context
 {;; the MAX skill corpus always-on (the old :default-load, now a presence-set
  ;; expanded into :skill/<name> body blocks at seed).
  :my.skills/load [:repl
                   :data-oriented-clojure
                   :datahike
                   :data-modeling
                   :clojurescript
                   :ui-live-tiles]

  ;; per-agent LLM — :inherit honors .env.acme's global row (dual-default);
  ;; an explicit value here would OVERRIDE just that agent's setting. Shown
  ;; :inherit to prove the seam is present + safe (byte-parity with the
  ;; cluster default).
  :seon.ai/agent-provider :inherit

  ;; home-requires toolbelt — DELIBERATELY DIFFERENT from config/system.edn's
  ;; 10-ns default. Acme (the third party) picks its OWN agent toolset from
  ;; THIS file, zero src/seon edits: a trimmed core-verb subset (message/plan/
  ;; lifecycle/schema/db — drops my.kb/my.data/my.ui/my.tile/search) PLUS acme's
  ;; own toolkit namespaces (acme.helpers, acme.notes). Since the :namespaces
  ;; block renders "the current ns's :require's as compact cards", THESE ARE the
  ;; verb surface a fresh acme agent sees — proving per-cluster ns selection is
  ;; config-driven. Each entry carries :as/:refer (bare [ns] is rejected by
  ;; :seon.eval/require-spec).
  :seon.eval/home-requires
  [[seon.agent.message :as message]
   [my.plan :as plan]
   [seon.agent.lifecycle :refer [wait complete pause resume terminate]]
   [seon.schema :as schema]
   [seon.db :as db]
   [acme.helpers :as helpers]
   [acme.notes :as notes]]

  ;; The FULL default block tree (mirrors seon.config/default-ctx-blocks) with
  ;; acme's OWN eval-decay schedule on the transcript (proves a per-cluster
  ;; decay is settable from the file — a shorter 2-band shrink). LOAD-BEARING:
  ;; a manifest that supplies :seon.agent/ctx REPLACES the schema default tree
  ;; wholesale (malli default-fill only fills ABSENT keys; vectors don't merge).
  ;; So to customize ONE block (the transcript) acme must re-list EVERY default
  ;; block it wants to keep — otherwise :namespaces (priority 20) and the rest
  ;; silently vanish and the namespaces-render feature never fires. This is the
  ;; per-cluster context surface: acme owns its whole block set from THIS file.
  :seon.agent/ctx
  [{:seon.agent.ctx/name :shared-instructions :seon.agent.ctx/priority 10
    :seon.render/ai my.kb.shared/instructions-block}
   {:seon.agent.ctx/name :skills-catalog :seon.agent.ctx/priority 12
    :seon.render/ai my.skills/catalog-block}
   {:seon.agent.ctx/name :namespaces :seon.agent.ctx/priority 20
    :seon.render/ai seon.agent.ctx.namespaces/namespaces-block}
   {:seon.agent.ctx/name :live-tile :seon.agent.ctx/priority 35
    :seon.render/ai seon.agent.ctx.live-tile/live-tile-block}
   {:seon.agent.ctx/name :warnings :seon.agent.ctx/priority 40
    :seon.render/ai seon.agent.ctx.warnings/warnings-block}
   {:seon.agent.ctx/name :plan :seon.agent.ctx/priority 45
    :seon.render/ai my.plan.internal/plan-block}
   {:seon.agent.ctx/name :relevant-source :seon.agent.ctx/priority 48
    :seon.render/ai seon.agent.ctx.relevant/relevant-source-block}
   {:seon.agent.ctx/name :findings :seon.agent.ctx/priority 97
    :seon.render/ai seon.agent.ctx.findings/findings-block}
   {:seon.agent.ctx/name :transcript :seon.agent.ctx/priority 100
    :seon.render/ai seon.agent.ctx.transcript/transcript-block
    :seon.render/html seon.agent.ctx.transcript/transcript-block-html
    :seon.agent.ctx.transcript/result-decay
    [{:seon.agent.ctx.transcript/from-turn-offset 0 :seon.agent.ctx.transcript/token-cap 16384}
     {:seon.agent.ctx.transcript/from-turn-offset 3 :seon.agent.ctx.transcript/token-cap 800}]}]}

 ;; ── NAMESPACES render policy — acme pins its OWN full-source ns set (incl.
 ;; its acme.* third-party code proves per-cluster ns render is configurable).
 :seon.config/namespaces
 {:seon.config/always     [my.kb my.data my.ui my.tile
                           my.plan seon.agent.message seon.agent.lifecycle]
  :seon.config/current-ns :full}}
