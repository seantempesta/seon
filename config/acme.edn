;; The Acme harness's config manifest — MINIMAL overrides over the default
;; cluster's config/system.edn (owner directive 2026-07-02: acme stays ALIGNED
;; with the default cluster while it is the live-testing/dev harness; per-cluster
;; configurability is proven + documented, and demo divergences cost fidelity —
;; the my.kb toolkit-trim blocker was exactly such a divergence, 978782d7).
;;
;; Structure: aero `#include` pulls in system.edn VERBATIM (resolved relative to
;; this file), then `#merge` (shallow, top-level keys) applies acme's deltas.
;; System.edn edits flow to acme automatically — there is no second copy to
;; drift. The ONLY delta is the agent-context toolbelt: system's list PLUS the
;; acme.* extra-src namespaces (structurally necessary — the overlay's own
;; toolkit must appear in home-requires or its cards never render and agents
;; can't see the verbs). Isolation (ports/store/sockets/logs/bundle) lives in
;; bin/acme env, not here.
;;
;; NOTE `#merge` replaces whole top-level keys: `:seon.config/agent-context`
;; below REPLACES system.edn's (which carries only :seon.eval/home-requires) —
;; keep this block a superset of system's agent-context if system grows keys.
#merge
[#include "system.edn"

 {:seon.config/agent-context
  {;; system.edn's default toolbelt VERBATIM + the acme.* overlay toolkit.
   ;; WHY kept: acme.helpers / acme.notes are the SEON_EXTRA_SRC namespaces —
   ;; the one structural acme addition. Everything else (skills corpus, render
   ;; caps, namespaces policy, root-context, block tree, decay) inherits from
   ;; system.edn via the #include above.
   :seon.eval/home-requires
   [[seon.agent.message :as message]
    [my.plan :as plan]
    [seon.agent.lifecycle :refer [wait complete pause resume terminate]]
    [seon.schema :as schema]
    [seon.db :as db]
    [my.kb :as kb]
    [my.data :as data]
    [my.ui :as ui]
    [my.tile :as tile]
    [my.blob :as blob]
    [seon.agent.search :as search]
    [seon.agent.shell :as shell]
    [seon.agent.web :as web]
    [acme.helpers :as helpers]
    [acme.notes :as notes]]}}]
