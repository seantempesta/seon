#!/usr/bin/env bash
# build-guest — client-runtime guest build orchestrator.
#
# Pipeline:
#   1. Build the seon CLJS guest-agent bundle (clj -M:cljs release guest-agent
#      → out/guest-agent/main.js).
#   2. Generate the wasm-rquickjs wrapper crate from guest-cljs/build/agent.mjs +
#      client-runtime/host/wit/. Embeds the CLJS bundle as virtual module
#      `client-runtime/main`.
#   3. Build to wasm32-wasip2 (release).
#
# Output:
#   guest-cljs/build/crate/target/wasm32-wasip2/release/*.wasm
#
# To run the multi-agent smoke after building:
#   cd client-runtime/host
#   cargo run --release -- \
#     --guest-wasm ../../guest-cljs/build/crate/target/wasm32-wasip2/release/*.wasm \
#     --multi-agent --multi-duration-ms 300000

set -euo pipefail

cd "$(dirname "$0")"
ROOT="$(pwd)"                 # client-runtime/
SEON_ROOT="$ROOT/.."         # repo root
GUEST="$SEON_ROOT/guest-cljs/build"

WANT_RUN=false
DURATION_MS=300000

for arg in "$@"; do
  case "$arg" in
    --run) WANT_RUN=true ;;
    --duration-ms=*) DURATION_MS="${arg#*=}" ;;
    --help|-h)
      cat <<EOF
Usage: ./build-guest [--run] [--duration-ms=<ms>]

  --run            After building, run the Rust host with --multi-agent.
  --duration-ms=N  Duration of multi-agent run (default 300000 = 5min).
EOF
      exit 0 ;;
    *) echo "x unknown arg: $arg" >&2; exit 2 ;;
  esac
done

# ----- 1. CLJS bundle ------------------------------------------------------
echo "> Building seon CLJS guest-agent bundle..."
(cd "$SEON_ROOT" && clj -M:cljs release guest-agent)
test -f "$SEON_ROOT/out/guest-agent/main.js" \
  || { echo "x bundle missing at $SEON_ROOT/out/guest-agent/main.js"; exit 1; }
echo "  bundle: $SEON_ROOT/out/guest-agent/main.js ($(wc -c < "$SEON_ROOT/out/guest-agent/main.js") bytes)"

# ----- 2. wasm-rquickjs wrapper crate --------------------------------------
echo "> Generating wasm-rquickjs wrapper crate..."
rm -rf "$GUEST/crate"
wasm-rquickjs generate-wrapper-crate \
  --js-modules "bundle/script_module=$GUEST/agent.mjs" \
  --js-modules "client-runtime/main=$SEON_ROOT/out/guest-agent/main.js" \
  --wit        "$ROOT/host/wit" \
  --output     "$GUEST/crate" \
  --world      client-runtime-guest

# ----- 3. cargo wasm32-wasip2 release --------------------------------------
echo "> Compiling to wasm32-wasip2 (release)..."
(cd "$GUEST/crate" && cargo build --release --target wasm32-wasip2 \
  --no-default-features \
  --features="lite,node-http,crypto,zlib,encoding,logging")

GUEST_WASM=$(ls "$GUEST"/crate/target/wasm32-wasip2/release/*.wasm 2>/dev/null | head -1)
test -n "$GUEST_WASM" \
  || { echo "x wasm not produced under $GUEST/crate/target/wasm32-wasip2/release/"; exit 1; }
echo "OK built: $GUEST_WASM ($(wc -c < "$GUEST_WASM") bytes)"

# ----- 4. Optional run -----------------------------------------------------
if [[ "$WANT_RUN" == "true" ]]; then
  echo "> Running Rust host with --multi-agent (duration ${DURATION_MS}ms)..."
  (cd host && cargo run --release -- \
    --guest-wasm "$GUEST_WASM" \
    --multi-agent \
    --multi-duration-ms "$DURATION_MS")
fi
