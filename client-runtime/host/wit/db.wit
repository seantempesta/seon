// db.wit — the client-runtime DB-access WIT contract.
//
// The wasm guest imports `seon:client-runtime/db` (and nothing else from us; WASI
// imports come through wasm-rquickjs's standard set). All db calls fan out to
// the JVM wire-server (sole datahike master) via the Rust host WriterClient.
//
// EDN-string in / EDN-string out keeps the WIT surface tiny. CBOR is the wire
// format between the Rust host and the JVM writer; it doesn't need to leak to
// the guest.
//
// Phase B additions (2026-05-25):
//   - entity-pull, pull-many, schema, reverse-schema, db-filter,
//     q-filtered, filter-release
//   - q / pull accept an optional `basis-t` for snapshot reads
//   - pull's `eid` relaxed from `s64` to `string` (EDN — accepts ints,
//     lookup-refs, and `:db/ident` keywords as EDN strings)
//   - next-tx-event for polling tx events (Phase 4 host→guest delivery)

package seon:client-runtime@0.1.0;

interface db {
  variant db-error {
    internal(string),
    protocol(string),
    not-found(string),
    invalid-query(string),
  }

  /// One wire datom: [e a v t op]. `a` is the attribute keyword as
  /// `"namespace/name"`. `v` is the EDN print form of the value.
  record wire-datom {
    e: s64,
    a: string,
    v: string,
    t: s64,
    added: bool,
  }

  /// A tx event delivered via next-tx-event. Mirrors the pub-socket shape.
  record tx-event {
    basis-t: s64,
    basis-t-before: s64,
    db-name: string,
    datoms-added: s64,
    datoms-retracted: s64,
    tx-data: list<wire-datom>,
    /// EDN map string with tx-meta (`db/txInstant`, `db/commitId`, ...)
    tx-meta: string,
    /// Caller-supplied request-id (own-tx dedup). Empty string if absent.
    request-id: string,
  }

  /// Run a Datalog query. `query` and each arg are EDN strings; the result is
  /// the EDN print form of the Datalog rows. If `basis-t` is non-zero, the
  /// writer reads against `(d/as-of db basis-t)` for consistent snapshot reads.
  q: func(query: string, args: list<string>, basis-t: s64) -> result<string, db-error>;

  /// Transact tx-data (EDN vector string). `tx-meta` and `request-id` are
  /// optional — pass empty string to omit. Returns the EDN print of the tx
  /// report map (basis-t, basis-t-before, tempids, tx-data, tx-meta).
  transact: func(tx-data: string, tx-meta: string, request-id: string)
            -> result<string, db-error>;

  /// Submit N tx-datas in one wire call. Each becomes its own datahike
  /// commit; failures stop the rest (partial success returned in the
  /// reports). `tx-meta-list` and `request-ids` are optional: empty list
  /// means "none", otherwise length MUST equal tx-data-list. Per-entry
  /// nulls are represented by empty strings.
  ///
  /// Returns an EDN-printed vector of per-tx report maps, one entry per
  /// applied tx (matching `applied` from the batch response). For partial
  /// failures, the EDN map includes `:failed-at` and `:error`.
  transact-batch: func(tx-data-list: list<string>,
                       tx-meta-list:  list<string>,
                       request-ids:   list<string>)
                  -> result<string, db-error>;

  /// Pull. `eid` is an EDN string carrying either an integer eid or a
  /// lookup-ref like `[:person/name "alice"]`. `basis-t` of 0 means "current".
  pull: func(selector: string, eid: string, basis-t: s64) -> result<string, db-error>;

  /// Eager entity replacement for `d/entity`. Selector defaults to `[*]` if
  /// empty. `depth` controls component-ref recursion (typical: 1). Missing
  /// entities return an EDN `"nil"` string, not an error.
  entity-pull: func(reference: string, selector: string, depth: s32, basis-t: s64)
               -> result<string, db-error>;

  /// Batched pull. `eids` is a list of EDN strings (ints or lookup-refs).
  pull-many: func(selector: string, eids: list<string>, basis-t: s64)
             -> result<string, db-error>;

  /// Read the schema (attr -> attr-schema map) as an EDN string.
  schema: func() -> result<string, db-error>;

  /// Read the reverse-schema (property -> attrs set) as an EDN string.
  reverse-schema: func() -> result<string, db-error>;

  /// Build a filtered-db. `pred-query` is an EDN Datalog query returning
  /// rows of `[?e]` — the eids to retain. Returns a handle valid until
  /// `filter-release` or writer restart.
  db-filter: func(pred-query: string, args: list<string>) -> result<u32, db-error>;

  /// Query a previously-built filtered db.
  q-filtered: func(handle: u32, query: string, args: list<string>)
              -> result<string, db-error>;

  /// Drop a filtered-db handle (idempotent).
  filter-release: func(handle: u32) -> result<bool, db-error>;

  /// Register interest in tx events. Returns a subscription handle that
  /// can be passed to `next-tx-event`. Phase 4 wires actual delivery.
  subscribe-tx: func(key: string) -> result<u32, db-error>;

  /// Drop a subscription. Idempotent.
  unsubscribe-tx: func(handle: u32) -> result<bool, db-error>;

  /// Block until the next tx event is available for this subscription
  /// (or for the host's broadcast channel, if subscriptions are pooled).
  /// Returns one event. Used by the CLJS overlay's listener fan-out loop.
  next-tx-event: func(handle: u32) -> result<tx-event, db-error>;
}

world client-runtime-guest {
  import db;
  // Standard WASI imports the wasm-rquickjs runtime expects.
  import wasi:clocks/monotonic-clock@0.2.3;
  import wasi:clocks/wall-clock@0.2.3;
  import wasi:filesystem/preopens@0.2.3;
  import wasi:filesystem/types@0.2.3;
  import wasi:io/error@0.2.3;
  import wasi:io/poll@0.2.3;
  import wasi:io/streams@0.2.3;
  import wasi:random/random@0.2.3;
  import wasi:sockets/instance-network@0.2.3;
  import wasi:sockets/network@0.2.3;
  import wasi:sockets/tcp@0.2.3;
  // wasm-rquickjs's bundled console.* maps to wasi:logging/logging.
  // Unversioned (still draft upstream); the deps/ vendored package matches.
  import wasi:logging/logging;

  /// Guest entry point — host calls this once to run the smoke. Returns the
  /// guest's report (EDN string) or an error string. Retained for Phase B/C
  /// JS-guest compatibility.
  export run-smoke: func() -> result<string, string>;

  /// Phase D entry point — host calls this with an agent identity and role.
  /// The guest runs its workload loop for `duration-ms` and returns a final
  /// report. `role` is one of "writer", "reader", "mixed".
  export run-agent: func(agent-id: string, role: string, duration-ms: u32)
                    -> result<string, string>;
}
