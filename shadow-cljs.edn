;; CLJS build config — lives at seon root.
;; Builds pull from the :cljs alias in deps.edn for CLJS deps.
;;
;; nREPL pinned to :7889 so editor + bin/mcp-server-cljs can find it
;; without port discovery. JVM nREPL stays on :7888 (separate process,
;; seon.runner).
{:deps  {:aliases [:cljs]}

 :nrepl {:port 7889}

 :builds
 {;; The V0 pod entry. One long-running Node process; stays alive via
  ;; the agent loop's pending operations (or, in this skeleton, a
  ;; heartbeat setInterval). `:devtools {:enabled true}` is the default
  ;; for :node-script — listed here for visibility.
  :client
  {:target           :node-script
   :output-to        "out/client/main.js"
   :main             seon.client/-main
   :devtools         {:enabled true}
   :compiler-options {:warnings-as-errors false}}

  ;; Bootstrap-CLJS bundle. The :target :bootstrap output is the
  ;; analysis-cache + compiled-js for each namespace listed in
  ;; :entries, suitable for runtime loading via
  ;; `shadow.cljs.bootstrap.node/init`. This is what the agent's
  ;; eval uses — once loaded, the compiler is IN the pod, and
  ;; `(cljs.js/eval-str ...)` works against arbitrary forms in
  ;; *agent-ns*. The pod becomes self-contained: no shadow watcher
  ;; involvement at agent-eval time, no external compiler. That's
  ;; the Wasmer-pod-correct shape — when we eventually ship to
  ;; sandboxed pods, this bundle goes with the pod and nothing
  ;; external is needed for the loop to run.
  ;;
  ;; cljs.core is implicit. We list every namespace the agent's
  ;; eval might reference: seon.agent (verbs), seon.agents.alice
  ;; (the playground), seon.db (DB access), seon.session (chat/
  ;; lifecycle the agent may want to introspect), seon.schema
  ;; (registry).
  ;;
  ;; To build: `clj -M:cljs compile bootstrap`
  ;; Output:  out/bootstrap/
  ;; Includes cljs.js (the in-runtime compiler itself), reader, and
  ;; the supporting standard libs the agent might use. The agent's
  ;; namespaces (seon.agent, seon.agents.alice, seon.db, …) are NOT
  ;; in the bundle — they're already loaded in the Node runtime
  ;; from the :client bundle. The agent's eval references them via
  ;; fully-qualified names, which compile to JS that resolves the
  ;; already-loaded globalThis vars at runtime.
  ;;
  ;; CRITICAL — `:analyze-deps false` MUST be passed to cljs.js/
  ;; eval-str. Otherwise the analyzer tries to walk seon.* during
  ;; compile and fails because those namespaces aren't in the
  ;; bundle's `index.transit.json`. With :analyze-deps false, the
  ;; analyzer emits :undeclared-var warnings but still compiles
  ;; the calls — and the calls resolve against the already-loaded
  ;; Node globals at runtime, which is exactly what we want.
  ;;
  ;; Sidesteps the core.async-in-bootstrap problem: by not pulling
  ;; seon.* into the bundle, we never analyze core.async's macro
  ;; namespaces that depend on JVM-only types.
  ;;
  ;; To build: `clj -M:cljs compile bootstrap`
  ;; Output:  out/bootstrap/ (~11M)
  :bootstrap
  {:target  :bootstrap
   :output-dir "out/bootstrap"
   :entries [cljs.js
             cljs.reader
             cljs.pprint
             clojure.set
             clojure.string
             clojure.walk]
   ;; :exclude on cljs.js skips re-analyzing its deps (which include
   ;; the JVM-only cljs.env.macros and cljs.tagged-literals). The
   ;; bundle still ships cljs.js's compiled JS; :exclude is purely
   ;; an analyzer-walker directive. This is exactly what shadow's
   ;; own :bootstrap-script-support demo does — see
   ;; reference/thheller-shadow-cljs/shadow-cljs.edn:500.
   :exclude #{cljs.js}
   :macros []
   :js-options {:js-provider :require}
   :compiler-options {:warnings-as-errors false}}}}
