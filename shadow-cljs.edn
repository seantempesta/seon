;; CLJS build config — lives at seon root.
;; Builds pull from the :cljs alias in deps.edn for CLJS deps.
;;
;; Shadow binds an available loopback port and publishes the actual value under
;; this checkout's cache root for the development MCP adapter and editors.
{:deps  {:aliases [:cljs]}

 :nrepl {:port 0}

 ;; npm package roots for the COMPILE-TIME resolver (shadow's npm
 ;; service probes each dir in order — build/npm.clj:1049-1089 +
 ;; find-package* npm.clj:227-235; duplicates are harmless). The
 ;; #shadow/env reader tag (config.clj:103-108, config_env.cljc) makes
 ;; the second entry the SEON_EXTRA_NPM downstream node_modules when
 ;; that env var is set, defaulting to "node_modules" (= today's
 ;; behavior byte-identical) when unset. RUNTIME resolution is a
 ;; different machine: :node-script leaves require("pkg") for Node, so
 ;; bin/seon's pod command additionally exports NODE_PATH=$SEON_EXTRA_NPM.
 ;; Task #36 (SEON_EXTRA_SRC) — see
 ;; docs/prds/agent-runtime/research/extra-src-research-2026-06-12.md §c.
 :js-package-dirs ["node_modules" #shadow/env ["SEON_EXTRA_NPM" "node_modules"]]

 ;; When a runtime connects (e.g. the pod's websocket client after
 ;; `bin/seon restart`), make it the default REPL target. Without
 ;; this, shadow keeps the first-ever runtime's id as :default-runtime-id
 ;; and a restarted pod isn't auto-routable — MCP eval fails with
 ;; "No available JS runtime" until the session is manually recreated.
 ;; Per worker/impl.clj:787-788 in /Users/sean/src/shadow-cljs.
 :repl  {:runtime-select :latest}

 ;; NOTE on :source-paths (corrected 2026-06-09, unit 2.2): this file runs
 ;; in DEPS MODE (`:deps {:aliases [:cljs]}` above), and in deps mode
 ;; shadow-cljs takes the classpath ENTIRELY from deps.edn — this
 ;; :source-paths vector is IGNORED. Proven live: the 2026-06-09 watcher
 ;; restart built :client green (0 warnings) with the real
 ;; `src/seon/db.cljs`, even though an earlier revision listed
 ;; an overlay shim first here. The REAL path set is deps.edn's `:cljs`
 ;; alias (`src` + `test` + `resources`). Kept in sync with deps.edn for
 ;; documentation value only.
 :source-paths ["src" "test"]

 :builds
 {;; The pod entry. One long-running Bun process; stays alive via
  ;; the agent loop's pending operations (or, in this skeleton, a
  ;; heartbeat setInterval). `:devtools {:enabled true}` is the default
  ;; for :node-script — listed here for visibility.
  ;;
  ;; Stays on :target :node-script (NOT :esm). A previous push toward
  ;; ESM ran into pain: shadow.cljs.bootstrap.node does `(:require ["fs"])`
  ;; and environ.core (transitive via datahike) does `(js/require "fs")`
  ;; at namespace-load time; both work cleanly under :node-script and
  ;; require ESM-glue (createRequire polyfill, __dirname shim, externs
  ;; for closure-renamed fs.existsSync under :advanced) under :esm.
  ;; Downstream consumers that need an ESM entry can wrap this CJS
  ;; bundle in a one-line `.mjs` shim — cheap at the boundary, no cost
  ;; here.
  :client
  {:target           :node-script
   :output-to        "out/client/main.js"
   :main             seon.client/-main
   :build-hooks      [[seon.dev.program-artifact/publish!
                       "out/client/program-sources.edn"]]
   ;; Normal pods ship runtime code, not the platform test graph. Agent-authored
   ;; tests still run through seon.test.runner once their vars are defined.
   :devtools         {:enabled      true
                      :preloads     [seon.demo]
                      :build-notify seon.client/shadow-build-notify!}
   ;; The pod resolves compiled Vars from qualified Clojure symbols at runtime,
   ;; so production must preserve namespace and member property names. Simple
   ;; optimization retains that contract; advanced optimization renames or
   ;; removes the properties and makes routes, renders, and instrumentation
   ;; unresolvable. `externs/node_fs.js` also preserves Node interop names for
   ;; environ.core's load-time `.lein-env` probe. Originally shipped
   ;; in datahike's tree but its deps.cljs points at the wrong path
   ;; (`datahike/externs.js` vs the real `externs/node_fs.js`), so we
   ;; vendor the file directly here. Both settings matter under :release.
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; Acme (third-party harness) pod bundle. A BYTE-FOR-BYTE MIRROR of
  ;; :client EXCEPT :output-to → "out-acme/client/main.js" (its own
  ;; output dir, so the live :client watch's "out/client/main.js" is
  ;; never clobbered). bin/acme `build` runs a one-off COMPILE of this
  ;; build (not a second watch) — that avoids two watchers contending for the
  ;; same Shadow cache/server ownership — injecting SEON_EXTRA_SRC (acme/)
  ;; + SEON_EXTRA_PRELOAD (acme.pod) exactly as cljs-watch does for
  ;; :client. The acme.* surface compiles INTO this bundle; bin/acme's
  ;; pod runs it via SEON_CLIENT_OUT=out-acme/client/main.js.
  ;;
  ;; The running :client watcher IGNORES unwatched builds, so adding this
  ;; block is safe for the live cluster. Keep it in sync with :client if
  ;; :client's :devtools/:compiler-options ever change.
  :acme-client
  {:target           :node-script
   :output-to        "out-acme/client/main.js"
   :main             seon.client/-main
   :build-hooks      [[seon.dev.program-artifact/publish!
                       "out-acme/client/program-sources.edn"]]
   ;; `acme.pod` is listed DIRECTLY in :preloads (not only via bin/acme's
   ;; --config-merge) so acme's registration ALWAYS runs at boot — no
   ;; doubt about whether deep-merge concats vs replaces the preload
   ;; vector. acme.pod is on the classpath whenever :acme-client builds
   ;; (bin/acme injects SEON_EXTRA_SRC=acme/ as a :local/root dep), so
   ;; this is safe. The :client build is left untouched (no acme there).
   :devtools         {:enabled  true
                      :preloads [seon.demo acme.pod]}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; FROZEN bench-pod bundle. A BYTE-FOR-BYTE MIRROR of :client EXCEPT
  ;; :output-to → "out-bench/client/main.js" (its own output dir + its own
  ;; BUILD ID). Frozen clusters (bin/seon cluster create — the default for
  ;; --ephemeral) exec THIS bundle so the live :client watcher can never
  ;; hot-patch a bench pod mid-sample (first dev pass 2026-07-03:
  ;; `reloading…` → `run-turn! error` voided the whole web_fetch row). The
  ;; distinct build id is the isolation mechanism — shadow's devtools worker
  ;; pushes reloads per build id, and no watch runs for :bench-client (same
  ;; proof as :acme-client: the acme pod is never hot-patched). Built one-off
  ;; by bin/seon's ensure_bench_bundle (staleness-guarded at cluster create;
  ;; the build step writes out-bench/client/main.js.sha256 — the bundle
  ;; identity bench runs pin + assert against, seon_inspect.cluster). Keep in
  ;; sync with :client if :client's :devtools/:compiler-options ever change.
  :bench-client
  {:target           :node-script
   :output-to        "out-bench/client/main.js"
   :main             seon.client/-main
   :devtools         {:enabled  true
                      :preloads [seon.demo]}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; Per-agent execution child for the DEFAULT artifact flavor. It is compiled
  ;; once and started lazily by the Bun host. A downstream flavor must declare
  ;; its own build id and output path (as :acme-client does); it must never
  ;; publish or watch this default output. The child talks to the database
  ;; authority directly; parent IPC carries only bounded Transit data.
  ;; It deliberately has no devtools connection: a child is supervised runtime
  ;; capacity, not another REPL target, and dormant agents retain no process.
  :execution
  {:target           :node-script
   :output-to        "out/execution/main.js"
   :main             seon.execution.runtime/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; Test-only real-process client for the JVM authority retained-state proof.
  ;; It uses the canonical `seon.db` Bun session and never constructs a local
  ;; database. `seon.authority-density-test` owns orchestration and assertions;
  ;; this build is not a production entrypoint or a second test runner.
  :authority-density-client
  {:target           :node-script
   :output-to        "out/authority-density/client.js"
   :main             seon.db.authority-density-child/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; Test-only controller for the real two-child program publication proof.
  ;; The maintained writer test owns the JVM authority and assertions; this
  ;; build only drives the production execution host and children.
  :execution-integration-client
  {:target           :node-script
   :output-to        "out/execution-integration/client.js"
   :main             seon.execution.integration-driver/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; ACME owns a distinct execution artifact just as it owns :acme-client.
  ;; bin/acme supplies the downstream source root and preload through the same
  ;; flavor-selected Shadow cache; no default watcher writes this output.
  :acme-execution
  {:target           :node-script
   :output-to        "out-acme/execution/main.js"
   :main             seon.execution.runtime/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; LEAN worker-side PARSE/SYNTACTIC oracle — CO-LOCATED on the diffusion
  ;; GPU worker (diffusion-dynamic-context). The eval-renoise loop
  ;; validates a partial canvas every checkpoint; co-located this is a
  ;; ~0.4ms local Bun call instead of a ~100ms internet round-trip.
  ;;
  ;; ONLY compiles seon.worker-validator + its minimal transitive deps
  ;; (seon.repl.internal → clojure.string + rewrite-clj — pure CLJC, NO
  ;; datahike / malli / pod state). A SINGLE standalone bundle the Python
  ;; worker spawns as a subprocess: code on stdin → one JSON line on
  ;; stdout. `:optimizations :simple` for a small bundle + fast cold
  ;; start (NOT :advanced — keeps require("fs") names + skips the slow
  ;; advanced pass; the bundle is leaf code with no live REPL runtime).
  ;; :devtools disabled — run-to-exit subprocess, never a shadow runtime.
  ;;
  ;; Build:  clj -M:cljs compile worker-validator
  ;; Run:    echo -n '(def x [)' | bun out/worker-validator/main.js
  ;; Output: out/worker-validator/main.js
  ;;
  ;; The running :client watcher IGNORES unwatched builds, so adding this
  ;; block is safe for the live cluster.
  :worker-validator
  {:target           :node-script
   :output-to        "out/worker-validator/main.js"
   :main             seon.worker-validator/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs            ["externs/node_fs.js"]}}

  ;; EVAL/CORRECTNESS oracle — the EVAL-TIER sibling of :worker-validator,
  ;; CO-LOCATED on the diffusion GPU worker (diffusion-dynamic-context).
  ;; Parse asks \"is it well-formed?\"; this asks \"does it actually RUN?\"
  ;; (compile + bounded eval → ok?/error) — the verdict that gates the
  ;; denoise loop's short-circuit (stop-when-correct) vs renoise.
  ;;
  ;; SEPARATE bundle ON PURPOSE: it pulls cljs.js (the self-host CLJS
  ;; compiler) so it can faithfully compile the CLJS the worker emits
  ;; (^:async/await, js interop) — bb-SCI/cljs-SCI throw false negatives on
  ;; that surface. cljs.js is HEAVY (loads the ~15MB out/bootstrap analysis
  ;; cache at init), so it must NOT bloat the lean parse bundle. NO seon.db /
  ;; seon.eval / pod state — leaf bundle (cljs.js + shadow bootstrap loader +
  ;; cljs.analyzer only).
  ;;
  ;; Non-termination is BOUNDED via Bun's `node:vm` compatibility module (the
  ;; compiled JS is native, so SCI's interpreter interrupt cannot fence it).
  ;;
  ;; :simple (not :advanced) — keeps require(\"fs\"/\"vm\"/\"readline\")
  ;; names + the cljs.js/shadow-bootstrap runtime intact; :advanced would
  ;; munge the self-host machinery. :devtools off — run-to-exit subprocess.
  ;;
  ;; Needs out/bootstrap present (clj -M:cljs compile bootstrap).
  ;; Build:  clj -M:cljs compile worker-oracle-eval
  ;; Run:    bun out/worker-oracle-eval/main.js --serve   (or one-shot via stdin)
  ;; Output: out/worker-oracle-eval/main.js
  ;;
  ;; The running :client watcher IGNORES unwatched builds, so adding this
  ;; block is safe for the live cluster.
  :worker-oracle-eval
  {:target           :node-script
   :output-to        "out/worker-oracle-eval/main.js"
   :main             seon.worker-eval/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs            ["externs/node_fs.js"]}}

  ;; Bootstrap-CLJS bundle (spec-02 §6.1). The :target :bootstrap
  ;; output is the analysis-cache + per-namespace compiled JS for
  ;; each namespace in :entries, suitable for runtime loading via
  ;; `shadow.cljs.bootstrap.node/init`. During initialization,
  ;; `seon.eval/init-bootstrap!` exposes the exact module-scoped root objects
  ;; enumerated by Shadow's own `bootstrap.env/loaded-ref`, so globally
  ;; evaluated bootstrap files see the already-compiled dependency graph.
  ;; Loaded namespaces land on globalThis, which is what
  ;; cljs.core/find-ns-obj needs (`js/eval("cljs")` resolves
  ;; globally). That sidesteps the "TypeError: Cannot read
  ;; properties of null (reading 'findInternedVar')" mode the prior
  ;; in-pod-eval investigation got stuck on.
  ;;
  ;; Keep :entries minimal — every namespace pulls a transitive
  ;; subtree into the bundle. cljs.core is the must-have. Add more
  ;; per agent vocabulary growth (clojure.string, clojure.set, …)
  ;; once measured.
  ;;
  ;; :macros [cljs.core] is NOT optional. cljs.core's runtime ns
  ;; doesn't (:require-macros cljs.core), so without an explicit
  ;; listing the bootstrap target ships cljs.core but not
  ;; cljs.core$macros — the macro namespace lives in a separate
  ;; file because macros are CLJ code that runs at compile time.
  ;; Without it, find-ns-obj finds cljs.core, then findInternedVar
  ;; throws on the first macro the analyzer expands (`let`, `defn`,
  ;; `+`). This is the failure the POC at
  ;; ../docs/research/scratch/seon-style-poc/ bottomed out.
  ;;
  ;; cljs.js (the in-runtime compiler itself) is NOT in this
  ;; bundle — it gets pulled into the main :client bundle via
  ;; (:require [cljs.js :as cljs]) in seon.client / seon.eval and
  ;; ships there. The bootstrap bundle only provides the
  ;; analysis-cache cljs.js consumes at eval time.
  ;; CLJS test runner — shadow's :node-test target. A full run compiles every
  ;; namespace matching `-test$`; bin/test-cljs supplies Shadow's explicit
  ;; :namespaces vector for a focused run. Both produce one JavaScript artifact at
  ;; out/test/test.js under one compile+run lock.
  ;;
  ;; The V0 CLJS tests use plain `cljs.test/deftest`, so they're
  ;; compatible with `:node-test` without modification. Tests that
  ;; need a live pod (seon.test.runner-based) are excluded by living
  ;; in a non-`-test$` ns or being preloaded only on `:client`.
  ;;
  ;; Build + run: `bin/test-cljs`
  :test
  {:target    :node-test
   :output-to "out/test/test.js"
   :ns-regexp "-test$"
   :seon.dev.test-artifact/publish? true
   :build-hooks [[seon.dev.test-artifact/publish!]]
   :devtools  {:preloads [seon.test.node-preload]}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs            ["externs/node_fs.js"]}}

  ;; Isolated runner for the lora-data-audit (repl-autosuggest lane) — the
  ;; audit must NOT share a process with the suite's instrument/uninstrument
  ;; fixtures (stale instrumented? flags make instrument-from-db! skip vars).
  ;; ns lives at src-needle/audit/seon/needle_lora_audit_test.cljs.
  :lora-audit
  {:target    :node-test
   :output-to "out/lora-audit/test.js"
   :ns-regexp "needle-lora-audit-test$"
   :devtools  {:preloads [seon.test.node-preload]}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs            ["externs/node_fs.js"]}}

  ;; Build: `clj -M:cljs compile bootstrap`   (or release)
  ;; Output: out/bootstrap/  — index.transit.json + per-ns .js
  :bootstrap
  {:target     :bootstrap
   :output-dir "out/bootstrap"
   ;; Expanded for the agent vocabulary needed by the spec's
   ;; eval-batch / confidence-run path. Each new entry pulls its
   ;; transitive subtree into the bootstrap output (analyzer caches +
   ;; per-ns JS), so the agent can `(require ...)` these from inside
   ;; cljs.js eval and have the analyzer resolve their vars.
   ;;
   ;; What each adds:
   ;; - cljs.core           — runtime + the must-have foundation
   ;; - cljs.test           — deftest / is / run-tests — required for
   ;;                         confidence-run pattern in the WASM pod
   ;; - clojure.set         — set ops the agent reaches for often
   ;; - clojure.string      — string ops; also pulled by cljs.test
   ;; - clojure.walk        — postwalk / prewalk for AST manipulation
   ;; - seon.schema         — Phase A item 5. Agent-eval'd
   ;;                         (schema/register!) writes to *schemas;
   ;;                         eval-batch! detect-and-tee reads via
   ;;                         (schema/current-keys) for atom-diff.
   ;; - malli.core          — Phase A item 5. Agent code defines fns
   ;;                         with :malli/schema metadata; the
   ;;                         analyzer needs to see malli.core's vars
   ;;                         at eval time, not error :undeclared-var.
   ;; - malli.registry      — Phase A item 5. Backs the global
   ;;                         registry; seon.schema layers atop.
   ;; - cljs.analyzer.api   — Phase A item 5. Agent + Platform read
   ;;                         analyzer state for detect-and-tee
   ;;                         (`all-ns`, `ns-defs`, `find-ns`).
   :entries    [cljs.core
                cljs.test
                clojure.set
                clojure.string
                clojure.walk
                seon.schema
                malli.core
                malli.registry
                cljs.analyzer.api]
   ;; cljs.test ships macros (deftest / is / are / testing) — must be
   ;; listed alongside cljs.core for the same reason cljs.core itself
   ;; needs it (the macro ns is a separate file).
   :macros     [cljs.core cljs.test]
   :exclude    #{}
   ;; `:redef false` suppresses 4 upstream warnings inside cljs.core$macros
   ;; (refer-global / require-global each have both a def AND a defmacro
   ;; of the same name — intentional in ClojureScript). Not our code.
   :compiler-options {:warnings-as-errors false
                      :warnings           {:redef false}}}

  ;; B2-EXPERIMENTAL (docs/prds/sci-execution-runtime, stage B2). A sci-engined
  ;; execution-child ARTIFACT VARIANT: identical to :execution except the
  ;; compiled-function map routes eval-batch! through a sci engine
  ;; (seon.execution.sci-runtime, source under tmp/sci-probe/exec-src — a
  ;; harness path, not src/). NO operator flavor selects this build; it is
  ;; compiled one-off in a separate Shadow cache (SHADOW_CLJS cache-root
  ;; override) and driven only by the B2 measurement driver below. Delete both
  ;; blocks when the PRD's decision gate lands.
  :execution-sci
  {:target           :node-script
   :output-to        "out-b2/execution-sci/main.js"
   :main             seon.execution.sci-runtime/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; B2-EXPERIMENTAL measurement driver: spawns the production execution host
  ;; against an explicit execution artifact (normal or sci) on a BRANCH
  ;; database and drives real turns through seon.agent.turn/run-turn! with a
  ;; scripted llm-fn, sampling vmmap per phase. Mirrors the maintained
  ;; :execution-integration-client pattern; never a production entrypoint.
  :b2-driver
  {:target           :node-script
   :output-to        "out-b2/driver/main.js"
   :main             seon.execution.b2-driver/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; U1.5-EXPERIMENTAL real-turn drive (docs/prds/sci-execution-runtime).
  ;; Drives the PRODUCTION pod dispatch (tier-as-data → JVM seon.host over
  ;; Transit-UDS) with real turns on a branch database, including the host
  ;; kill drill. Compiled one-off in the same separate Shadow cache as the
  ;; B2 blocks; no operator flavor selects it. Delete with the B2 blocks
  ;; when the PRD's decision gate lands.
  :u15-driver
  {:target           :node-script
   :output-to        "out-b2/u15-driver/main.js"
   :main             seon.execution.u15-driver/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations      :simple
                      :externs           ["externs/node_fs.js"]}}}}
