;; CLJS build config — lives at seon root.
;; Builds pull from the :cljs alias in deps.edn for CLJS deps.
;;
;; nREPL pinned to :7889 so editor + bin/mcp-server-cljs can find it
;; without port discovery. JVM nREPL stays on :7888 (separate process,
;; seon.runner).
{:deps  {:aliases [:cljs]}

 :nrepl {:port 7889}

 ;; When a runtime connects (e.g. the pod's websocket client after
 ;; `bin/seon restart pod`), make it the default REPL target. Without
 ;; this, shadow keeps the first-ever runtime's id as :default-runtime-id
 ;; and a restarted pod isn't auto-routable — MCP eval fails with
 ;; "No available JS runtime" until the session is manually recreated.
 ;; Per worker/impl.clj:787-788 in /Users/sean/src/shadow-cljs.
 :repl  {:runtime-select :latest}

 ;; Top-level :source-paths is the only place shadow-cljs accepts
 ;; the directive (per-build :source-paths errors with "only valid
 ;; globally"). `test/` is included so platform-track CLJS tests
 ;; (`.cljs` / `.cljc` files under `test/seon/...`) are discoverable
 ;; from the shadow nREPL. Tests run via
 ;; `(seon.test.runner/run-vars {::vars [...]})` over MCP. Each
 ;; build only compiles what's transitively required from its
 ;; `:main` — test namespaces are unreachable from `:client`,
 ;; `:smoke`, and `:eval-smoke`, so they don't bloat release output
 ;; or break smoke targets.
 ;; Adds the sidecar-poc guest-cljs tree so the :sidecar-agent build below
 ;; can compile `sidecar-poc.agent` + `sidecar-poc.datahike` +
 ;; `sidecar-poc.wit` without those files needing to move into src/.
 ;; The overlay path is listed FIRST so the sidecar-agent build picks up
 ;; `pod-host/sidecar-poc/guest-cljs/src-overlay/seon/db.cljs` (the
 ;; sidecar-flavored shim) AHEAD of the real V0 `src/seon/db.cljs`.
 ;; CAVEAT: other CLJS builds in this file (:client, :smoke, :eval-smoke)
 ;; will ALSO see the overlay if they transitively require `seon.db`.
 ;; :client / :smoke / :eval-smoke do NOT touch seon.db today
 ;; (smoke=datahike-cljs inlined; client=V0 pod which has its own seon.db
 ;; via direct datahike.api use — but client.cljs requires seon.client
 ;; which transitively requires seon.db). DO NOT build :client with the
 ;; overlay path present; revert this change first.
 :source-paths ["pod-host/sidecar-poc/guest-cljs/src-overlay"
                "src" "test" "pod-host/sidecar-poc/guest-cljs/src"]

 :builds
 {;; The V0 pod entry. One long-running Node process; stays alive via
  ;; the agent loop's pending operations (or, in this skeleton, a
  ;; heartbeat setInterval). `:devtools {:enabled true}` is the default
  ;; for :node-script — listed here for visibility.
  ;;
  ;; Stays on :target :node-script (NOT :esm). A previous push toward
  ;; ESM ran into pain: shadow.cljs.bootstrap.node does `(:require ["fs"])`
  ;; and environ.core (transitive via datahike) does `(js/require "fs")`
  ;; at namespace-load time; both work cleanly under :node-script and
  ;; require ESM-glue (createRequire polyfill, __dirname shim, externs
  ;; for closure-renamed fs.existsSync under :advanced) under :esm.
  ;; Downstream consumers that need an ESM entry can wrap this CJS
  ;; bundle in a one-line `.mjs` shim — cheap at the boundary, no cost
  ;; here.
  :client
  {:target           :node-script
   :output-to        "out/client/main.js"
   :main             seon.client/-main
   ;; `:preloads` pulls dev-only namespaces (notably test code under
   ;; `test/`) into the build without affecting `:main` or release
   ;; output. `seon.dev.test-preload` requires every CLJS test ns that
   ;; needs to be runnable via `(seon.test.runner/run! {::ns 'foo})`
   ;; against the live `:client` pod. See:
   ;; docs/prds/agent-runtime/research/cljs-testing-infrastructure-2026-05-25.md §6 Phase 1.
   :devtools         {:enabled  true
                      :preloads [seon.dev.test-preload]}
   ;; externs/node_fs.js declares `fs.existsSync` etc. so Closure's
   ;; :advanced pass doesn't rename them to `fs.g_(...)` and crash
   ;; environ.core's load-time `.lein-env` probe. Originally shipped
   ;; in datahike's tree but its deps.cljs points at the wrong path
   ;; (`datahike/externs.js` vs the real `externs/node_fs.js`), so we
   ;; vendor the file directly here. Only matters under :release.
   :compiler-options {:warnings-as-errors false
                      :externs           ["externs/node_fs.js"]}}

  ;; Milestone-1 WASM smoke build. Minimal CLJS bundle that exposes
  ;; `datahike-smoke-test!` (inlined) on globalThis.seonSmoke for the
  ;; wasm-rquickjs ESM shim. Deliberately doesn't require seon.client
  ;; (no agent loop, no web server, no deepseek) — narrow the surface
  ;; so a smoke failure points at cljs.js or datahike-cljs.
  ;;
  ;; Build: `clj -M:cljs release smoke`
  ;; Output: out/smoke/main.js (CJS, :node-script target)
  :smoke
  {:target           :node-script
   :output-to        "out/smoke/main.js"
   :main             seon.wasm-smoke/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :externs           ["externs/node_fs.js"]}}

  ;; Milestone-2 WASM eval-smoke build. Sibling of :smoke but pulls in
  ;; cljs.js + shadow.cljs.bootstrap.node so the bundle can compile
  ;; arbitrary CLJS forms at runtime via the bootstrap-loaded analysis
  ;; cache.
  ;;
  ;; Designed to be invoked inside wasmtime with `out/bootstrap/`
  ;; mounted as a WASI preopen (e.g. `--dir out/bootstrap::bootstrap`).
  ;; The bundle sets globalThis.seonEvalInitBootstrap and
  ;; globalThis.seonEvalForm; the WIT host wraps both.
  ;;
  ;; Build: `clj -M:cljs release eval-smoke`
  ;; Output: out/eval-smoke/main.js (CJS, :node-script target)
  :eval-smoke
  {:target           :node-script
   :output-to        "out/eval-smoke/main.js"
   :main             seon.wasm-eval-smoke/-main
   :devtools         {:enabled false}
   ;; `:optimizations :simple` (NOT :advanced) is load-bearing here.
   ;; shadow.cljs.bootstrap.node calls `(js/goog.globalEval js)` at
   ;; runtime, and the JS text it evals references `cljs.core.X` /
   ;; `goog.provide(...)` directly. :advanced would rename everything;
   ;; :simple preserves the names. (Heller's bootstrap blog + the
   ;; shadow-cljs user guide both call this out — `:simple` is the
   ;; canonical host-build setting.)
   ;;
   ;; NOTE: shadow-cljs wraps both `:node-script` and `:node-library`
   ;; targets in an IIFE / UMD factory regardless of `:output-wrapper`
   ;; (that flag only affects Closure's own wrapper, not shadow's
   ;; per-target wrapper). The hoist in seon.wasm-eval-smoke
   ;; (`(js* "globalThis.goog = goog")` etc.) bridges out of the IIFE
   ;; so the bootstrap-loaded JS — which runs in GLOBAL scope via
   ;; `goog.globalEval = (0,eval)(s)` — can find them by name.
   :compiler-options {:warnings-as-errors false
                      :optimizations     :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; Bootstrap-CLJS bundle (spec-02 §6.1). The :target :bootstrap
  ;; output is the analysis-cache + per-namespace compiled JS for
  ;; each namespace in :entries, suitable for runtime loading via
  ;; `shadow.cljs.bootstrap.node/init`. The loader uses
  ;; goog.globalEval, which is indirect eval, which runs in global
  ;; scope — so the namespaces land on globalThis, which is what
  ;; cljs.core/find-ns-obj needs (`js/eval("cljs")` resolves
  ;; globally). That sidesteps the "TypeError: Cannot read
  ;; properties of null (reading 'findInternedVar')" mode the prior
  ;; in-pod-eval investigation got stuck on.
  ;;
  ;; Keep :entries minimal — every namespace pulls a transitive
  ;; subtree into the bundle. cljs.core is the must-have. Add more
  ;; per agent vocabulary growth (clojure.string, clojure.set, …)
  ;; once measured.
  ;;
  ;; :macros [cljs.core] is NOT optional. cljs.core's runtime ns
  ;; doesn't (:require-macros cljs.core), so without an explicit
  ;; listing the bootstrap target ships cljs.core but not
  ;; cljs.core$macros — the macro namespace lives in a separate
  ;; file because macros are CLJ code that runs at compile time.
  ;; Without it, find-ns-obj finds cljs.core, then findInternedVar
  ;; throws on the first macro the analyzer expands (`let`, `defn`,
  ;; `+`). This is the failure the POC at
  ;; ../docs/research/scratch/seon-style-poc/ bottomed out.
  ;;
  ;; cljs.js (the in-runtime compiler itself) is NOT in this
  ;; bundle — it gets pulled into the main :client bundle via
  ;; (:require [cljs.js :as cljs]) in seon.client / seon.eval and
  ;; ships there. The bootstrap bundle only provides the
  ;; analysis-cache cljs.js consumes at eval time.
  ;;
  ;; Phase D sidecar agent bundle. Compiles the synthetic agent at
  ;; pod-host/sidecar-poc/guest-cljs/src/sidecar_poc/agent.cljs together with
  ;; the wit + datahike overlay. The output is loaded by the ESM shim at
  ;; pod-host/sidecar-poc/guest/sidecar-agent.mjs, wrapped into a
  ;; wasm32-wasip2 component via wasm-rquickjs, and instantiated 3x by the
  ;; Rust host for the multi-agent smoke.
  ;;
  ;; Build: `clj -M:cljs release sidecar-agent`
  ;; Output: out/sidecar-agent/main.js (CJS, :node-script target)
  :sidecar-agent
  {:target           :node-script
   :output-to        "out/sidecar-agent/main.js"
   :main             sidecar-poc.agent/-main
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations     :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; V0-port probe build. Pulls in V0 substrate namespaces through the
  ;; sidecar overlay (seon.db is the sidecar shim from src-overlay) so
  ;; we can measure how much V0 code compiles unchanged inside the
  ;; sidecar guest. Each successful require demonstrates one more layer
  ;; of V0 working in wasm.
  ;;
  ;; Build: `clj -M:cljs:cljs-sidecar release v0-probe`
  ;;        (cljs-sidecar alias adds src-overlay to extra-paths so the
  ;;        overlay seon.db is reachable on the classpath)
  ;; Output: out/v0-probe/main.js
  :v0-probe
  {:target           :node-script
   :output-to        "out/v0-probe/main.js"
   :main             sidecar-poc.seon-bootstrap/probe-info
   :devtools         {:enabled false}
   :compiler-options {:warnings-as-errors false
                      :optimizations     :simple
                      :externs           ["externs/node_fs.js"]}}

  ;; Build: `clj -M:cljs compile bootstrap`   (or release)
  ;; Output: out/bootstrap/  — index.transit.json + per-ns .js
  :bootstrap
  {:target     :bootstrap
   :output-dir "out/bootstrap"
   ;; Expanded for the agent vocabulary needed by the spec's
   ;; eval-batch / confidence-run path. Each new entry pulls its
   ;; transitive subtree into the bootstrap output (analyzer caches +
   ;; per-ns JS), so the agent can `(require ...)` these from inside
   ;; cljs.js eval and have the analyzer resolve their vars.
   ;;
   ;; What each adds:
   ;; - cljs.core           — runtime + the must-have foundation
   ;; - cljs.test           — deftest / is / run-tests — required for
   ;;                         confidence-run pattern in the WASM pod
   ;; - clojure.set         — set ops the agent reaches for often
   ;; - clojure.string      — string ops; also pulled by cljs.test
   ;; - clojure.walk        — postwalk / prewalk for AST manipulation
   ;; - seon.schema         — Phase A item 5. Agent-eval'd
   ;;                         (schema/register!) writes to *schemas;
   ;;                         eval-batch! detect-and-tee reads via
   ;;                         (schema/current-keys) for atom-diff.
   ;; - malli.core          — Phase A item 5. Agent code defines fns
   ;;                         with :malli/schema metadata; the
   ;;                         analyzer needs to see malli.core's vars
   ;;                         at eval time, not error :undeclared-var.
   ;; - malli.registry      — Phase A item 5. Backs the global
   ;;                         registry; seon.schema layers atop.
   ;; - cljs.analyzer.api   — Phase A item 5. Agent + Platform read
   ;;                         analyzer state for detect-and-tee
   ;;                         (`all-ns`, `ns-defs`, `find-ns`).
   :entries    [cljs.core
                cljs.test
                clojure.set
                clojure.string
                clojure.walk
                seon.schema
                malli.core
                malli.registry
                cljs.analyzer.api]
   ;; cljs.test ships macros (deftest / is / are / testing) — must be
   ;; listed alongside cljs.core for the same reason cljs.core itself
   ;; needs it (the macro ns is a separate file).
   :macros     [cljs.core cljs.test]
   :exclude    #{}
   ;; `:redef false` suppresses 4 upstream warnings inside cljs.core$macros
   ;; (refer-global / require-global each have both a def AND a defmacro
   ;; of the same name — intentional in ClojureScript). Not our code.
   :compiler-options {:warnings-as-errors false
                      :warnings           {:redef false}}}}}
